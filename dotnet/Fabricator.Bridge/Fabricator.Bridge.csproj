<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Fabricator.Bridge</RootNamespace>
    <AssemblyName>Fabricator.Bridge</AssemblyName>
    <Description>
      Reusable Arrow interop bridge loaded in-process by the native DuckDB
      extension via CoreCLR hosting. Exposes a C ABI vtable (filled by
      Bootstrap.Initialize) and streams Apache Arrow record batches to/from the
      C++ host over the Arrow C Stream Interface.
    </Description>
    <!-- Generate the runtimeconfig.json even though this is a library, so the
         native host can initialize the runtime against it. -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Delta provider was carved out of THIS assembly on 2026-08-18 and is one logical unit with it,
         split for dependency reasons (it is what dragged the engineered-wood submodule + AWSSDK.S3 into
         Bridge, and therefore what kept tier 0 from referencing Bridge at all). It is NOT an API boundary,
         so the ~20 host types it uses — HostFs, BoundInput, HostBatchFilter, ParquetTuning, the ambients —
         stay `internal` rather than being made public just to cross a project file.
         Deliberately NARROW: this grants exactly one assembly, and only in this direction. Bridge does not
         reference Fabricator.Delta and must not — BackendRegistry discovers the provider by assembly name.
         (It departs from the DeltaFunctions precedent, which was made `public` for Fabricator.DeltaRs; that
         was ONE type crossing to an opt-in provider, where widening the surface was cheaper than a grant.) -->
    <InternalsVisibleTo Include="Fabricator.Delta" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Apache.Arrow" Version="23.0.0" />
    <!-- .NET logging: trace the native Delta reader (per-file queries, applied static/dynamic filters, pruned
         files, snapshot version). Off by default (NullLoggerFactory); env-driven file sink via FABRICATOR_LOG_LEVEL
         + FABRICATOR_LOG_FILE. The ILoggerFactory is pluggable (FabricatorLog.Factory), so a DuckDB-forwarding
         provider can be attached later. -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <!-- The stable contract surface (interfaces + Arrow-typed POCOs), split out so plugins can reference a
         minimal shared assembly. Same Fabricator.Bridge namespace — assembly split only. -->
    <ProjectReference Include="..\Fabricator.Abstractions\Fabricator.Abstractions.csproj" />
    <!-- The reusable middle (Arrow value reading, the stream adapters, the aggregate session, the
         fixed-schema function bases). The direction is load-bearing and one-way: Common references
         Abstractions and NOTHING else, so a reference back from Common to here would be a project cycle —
         which is exactly what makes "does it need the running host?" the membership rule rather than a
         matter of taste. docs/plugin-services.md §7.4a. -->
    <ProjectReference Include="..\Fabricator.Common\Fabricator.Common.csproj" />
    <!-- The plugin installer's archive-path guard. Referenced for ArchivePath alone: it is the zip-slip
         validation the single-file distribution's extractor already uses, and a security guard is the last
         thing that should exist twice in one codebase with two chances to drift. Cheap to take — this
         assembly is BCL-only and AOT-compatible by construction, so it adds no package and no constraint. -->
    <ProjectReference Include="..\Fabricator.Installer.Core\Fabricator.Installer.Core.csproj" />
    <!-- Fabric REST API: list OneLake lakehouse tables (TablesClient.ListTables) so the Delta folder-as-catalog
         can ATTACH a OneLake root — DuckDB's azure glob can't enumerate a OneLake _delta_log tree (PR #174), so
         OneLake table discovery uses the Fabric API instead of a glob (local/S3/ADLS keep the glob). Auth via the
         ATTACH'd azure SP secret (ClientSecretCredential, Azure.Identity). -->
    <PackageReference Include="Microsoft.Fabric.Api" Version="2.18.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <!-- OneLake table discovery + DROP go through the ADLS Gen2 / OneLake DFS endpoint directly (the Azure SDK,
         NOT DuckDB's azure extension): GetPaths enumerates Tables/<table> (flat) or Tables/<schema>/<table>
         (schema-enabled) — immune to the duckdb-azure mid-path glob bug (PR #174) and the Fabric ListTables 400
         on schema-enabled lakehouses, and free of SQL-endpoint sync lag — and DeleteDirectory(recursive) powers
         DROP TABLE (DuckDB's azure FileSystem has no RemoveDirectory). The Fabric API is kept only for the
         schema-enabled flag (GetLakehouse.DefaultSchema) + name->GUID resolution. Same SP credential throughout. -->
    <PackageReference Include="Azure.Storage.Files.DataLake" Version="12.21.0" />
    <!-- ⚠ Microsoft.Data.SqlClient + Microsoft.Data.SqlClient.Extensions.Azure were declared HERE until
         2026-08-18 and used by NOTHING in this assembly. The only two matches in Bridge source are a comment
         in Bootstrap.cs saying it duck-types the provider error number "rather than reference
         Microsoft.Data.SqlClient", and FabricApi/FabricSqlEndpointHost.cs saying it hand-parses a connection
         string "to stay BCL-only". The justification the removed comment carried — "the SQL Server backend
         + the DAX SQL-endpoint path" — was stale in both halves: Fabricator.SqlServer declares BOTH packages
         itself (that is what puts them in the published payload), and Fabricator.AnalysisServices does not
         use SqlClient at all. Do not re-add them here; add them to the assembly that calls them. -->
  </ItemGroup>


</Project>
