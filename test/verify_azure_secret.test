# name: test/verify_azure_secret.test
# description: a foreign `azure` secret reused for SQL Server Entra auth (docs/provider-extensibility.md §2).
#   Error paths only (deterministic, no real Azure); the service-principal happy path (azure SP -> Entra ->
#   Azure SQL / Fabric) is validated manually against a live Fabric Warehouse.
# group: [fabricator]

require fabricator

require azure

# A credential_chain azure secret has no SQL-usable credential (its token is storage-scoped + fetched lazily),
# so reusing it for SQL errors with a pointer to authentication='Active Directory Default'.
statement ok
CREATE SECRET az_cc (TYPE azure, PROVIDER credential_chain);

statement error
ATTACH 'Server=nohost.invalid;Database=db;Encrypt=true;TrustServerCertificate=true' AS dcc (TYPE fabricator, SECRET az_cc);
----
Active Directory Default

# A service-principal azure secret supplies only auth (client id/secret), not the SQL target. Used without an
# ATTACH target (here via fabricator_query) it errors clearly.
statement ok
CREATE SECRET az_sp (TYPE azure, PROVIDER service_principal, TENANT_ID 't', CLIENT_ID 'cid',
  CLIENT_SECRET 'csec', ACCOUNT_NAME 'acct');

statement error
SELECT * FROM fabricator_query('az_sp', 'SELECT 1 AS x');
----
supplies only auth

statement ok
DROP SECRET az_cc;

statement ok
DROP SECRET az_sp;
