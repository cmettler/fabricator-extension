# name: test/verify_collation_pushdown.test
# description: under Fabric's BIN2_UTF8 collation, text maps to VARCHAR (UTF-8) and string ORDER BY+LIMIT pushes (warehouse-support §3/§4/§6.6)
# group: [mssql_net]
#
# Fixture (Fabric Warehouse's actual default collation — binary + UTF-8: byte-order string sort matching
# DuckDB, and VARCHAR holds full Unicode):
#   CREATE DATABASE BinCollTest COLLATE Latin1_General_100_BIN2_UTF8;
#   CREATE TABLE dbo.names (id INT NOT NULL PRIMARY KEY, name VARCHAR(50) NOT NULL);
#   INSERT INTO dbo.names VALUES (1,'banana'),(2,'Apple'),(3,'cherry'),(4,'apple'),(5,'Banana');
# Point MSSQL_BINCOLL_DSN at it (Database=BinCollTest). Env-gated, like the Fabric checks.

require mssql_net

require-env MSSQL_BINCOLL_DSN

statement ok
ATTACH '${MSSQL_BINCOLL_DSN}' AS bdb (TYPE mssql_net);

# Binary collation -> string ORDER BY pushdown enabled; UTF-8 collation -> text maps to VARCHAR.
query T
SELECT value FROM mssql_server_info('bdb') WHERE property = 'is_binary_collation';
----
true

query T
SELECT value FROM mssql_server_info('bdb') WHERE property = 'is_utf8_collation';
----
true

# A UTF-8 collation makes VARCHAR hold full Unicode, so a created text column maps to VARCHAR (not
# NVARCHAR) — driven by the collation, not the edition (this box engine HAS nvarchar). §4 principled rule.
statement ok
DROP TABLE IF EXISTS bdb.dbo.coll_ctas;

statement ok
CREATE TABLE bdb.dbo.coll_ctas AS SELECT 'x' AS s;

query T
SELECT DATA_TYPE FROM mssql_net_query('bdb',
  'SELECT CAST(DATA_TYPE AS VARCHAR(32)) AS DATA_TYPE FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = ''coll_ctas'' AND COLUMN_NAME = ''s''');
----
varchar

statement ok
DROP TABLE bdb.dbo.coll_ctas;

# A binary collation sorts by byte value (uppercase before lowercase), identical to DuckDB's bytewise
# string comparison, so the pushed SQL TOP+ORDER BY produces the same top-n DuckDB would.
query T
SELECT name FROM bdb.dbo.names ORDER BY name LIMIT 2;
----
Apple
Banana

# Proof: TOP (n) + ORDER BY [name] (a STRING key) reached SQL Server — the relaxation a non-binary
# collation would suppress.
query I
SELECT pushed FROM mssql_net_query('bdb',
  'SELECT CAST(CASE WHEN EXISTS (
     SELECT 1 FROM sys.dm_exec_query_stats qs
     CROSS APPLY sys.dm_exec_sql_text(qs.sql_handle) st
     WHERE CHARINDEX(''FROM [dbo].[names]'', st.text) > 0
       AND CHARINDEX(''ORDER BY [name]'', st.text) > 0
       AND CHARINDEX(''TOP ('', st.text) > 0
       AND CHARINDEX(''dm_exec'', st.text) = 0
   ) THEN 1 ELSE 0 END AS INT) AS pushed');
----
1

# String-FILTER ordering also pushes under a binary collation (the relaxation gated on string_order_pushable):
# byte-order '>' matches DuckDB exactly. Fixture: banana, Apple, cherry, apple, Banana (uppercase < lowercase).
query IT
SELECT id, name FROM bdb.dbo.names WHERE name > 'banana' ORDER BY id;
----
3	cherry

# String BETWEEN pushes too (-> [name] >= @ AND [name] <= @): byte order excludes the lowercase variants.
query I
SELECT id FROM bdb.dbo.names WHERE name BETWEEN 'Apple' AND 'Banana' ORDER BY id;
----
2
5

# Proof a string ordering comparison reached SQL Server (WHERE [name] > @p) — suppressed under a non-binary collation.
query I
SELECT pushed FROM mssql_net_query('bdb',
  'SELECT CAST(CASE WHEN EXISTS (
     SELECT 1 FROM sys.dm_exec_query_stats qs
     CROSS APPLY sys.dm_exec_sql_text(qs.sql_handle) st
     WHERE CHARINDEX(''FROM [dbo].[names]'', st.text) > 0
       AND CHARINDEX(''[name] >'', st.text) > 0
       AND CHARINDEX(''dm_exec'', st.text) = 0
   ) THEN 1 ELSE 0 END AS INT) AS pushed');
----
1

statement ok
DETACH bdb;
