# name: test/verify_delta_rename.test
# description: The Delta provider's primary name is `engineeredwooddelta` (engineered-wood-backed), with `delta`
#              and `deltalake` kept as aliases so existing ATTACHes keep working. All three resolve to the same
#              backend. Set ARROWNET_DELTA_WRITE_DIR to a WRITABLE base path. Local FS.
# group: [mssql_net]

require mssql_net

require-env ARROWNET_DELTA_WRITE_DIR

# Primary name.
statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/rn_primary' AS la (TYPE arrownet, PROVIDER 'engineeredwooddelta');

statement ok
CREATE TABLE la.main.t AS SELECT 1 AS id;

query I
SELECT id FROM la.main.t;
----
1

statement ok
DETACH la;

# Legacy alias `delta`.
statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/rn_delta' AS lb (TYPE arrownet, PROVIDER 'delta');

statement ok
CREATE TABLE lb.main.t AS SELECT 2 AS id;

query I
SELECT id FROM lb.main.t;
----
2

statement ok
DETACH lb;

# Alias `deltalake`.
statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/rn_deltalake' AS lc (TYPE arrownet, PROVIDER 'deltalake');

statement ok
CREATE TABLE lc.main.t AS SELECT 3 AS id;

query I
SELECT id FROM lc.main.t;
----
3

statement ok
DETACH lc;
