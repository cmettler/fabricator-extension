# name: test/verify_delta_rename.test
# description: The Delta provider's primary name is `engineeredwooddelta` (engineered-wood-backed), with `delta`
#              kept as its ONE alias; both resolve to the same backend. The redundant second alias `deltalake`
#              was REMOVED 2026-07-29 (a breaking removal, deliberately — one alias is enough, and the two
#              names are about to mean different DEFAULTS rather than being interchangeable). Note `deltalake`
#              survives in a DIFFERENT namespace that this does not touch: `WITH table_type='DELTALAKE'`, the
#              Iceberg-style DDL option value (DeltaWithOptions), which is a table_type, not a PROVIDER.
#              Set FABRICATOR_DELTA_WRITE_DIR to a WRITABLE base path. Local FS.
# group: [fabricator]

require fabricator

require-env FABRICATOR_DELTA_WRITE_DIR

# Primary name.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/rn_primary' AS la (TYPE fabricator, PROVIDER 'engineeredwooddelta');

statement ok
CREATE TABLE la.main.t AS SELECT 1 AS id;

query I
SELECT id FROM la.main.t;
----
1

statement ok
DETACH la;

# Legacy alias `delta`.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/rn_delta' AS lb (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE lb.main.t AS SELECT 2 AS id;

query I
SELECT id FROM lb.main.t;
----
2

statement ok
DETACH lb;

# The removed alias is now an UNKNOWN provider — pinned so the removal cannot regress into a silent
# resolution (BackendRegistry matches Name + Aliases case-insensitively, so a stray re-add would be invisible
# without this).
statement error
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/rn_deltalake' AS lc (TYPE fabricator, PROVIDER 'deltalake');
----
deltalake

# ...and no catalog was left behind by the failed ATTACH.
statement error
DETACH lc;
----
lc
