# name: test/verify_delta_txn_version.test
# description: Idempotent appends via Delta APPLICATION TRANSACTIONS (the `txn` action; duckdb-delta /
#              Spark txnAppId parity). fabricator_delta_set_transaction_version(catalog, 'schema.table',
#              app_id, version [, expected_previous]) PARKS the version on the current explicit
#              transaction; at COMMIT it is compared-and-swapped against the latest snapshot and the txn
#              action commits ATOMICALLY with the transaction's fused commit — a retried batch whose first
#              attempt landed fails the CAS instead of duplicating data.
#              fabricator_delta_get_transaction_version reads the committed high-water mark.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/txnver' AS lake (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE lake.main.t (id INTEGER);

# ----------------------------------------------------------------------------
# 1. get before any set: NULL high-water mark
# ----------------------------------------------------------------------------

query TI
SELECT * FROM fabricator_delta_get_transaction_version('lake', 't', 'loader');
----
loader	NULL

# ----------------------------------------------------------------------------
# 2. the setter requires an explicit transaction (the CAS is atomic with the COMMIT)
# ----------------------------------------------------------------------------

statement error
CALL fabricator_delta_set_transaction_version('lake', 't', 'loader', 1);
----
requires an explicit transaction

# ----------------------------------------------------------------------------
# 3. batch 1 (expected omitted = must-not-exist) commits atomically with the data
# ----------------------------------------------------------------------------

statement ok
BEGIN;

query TI
CALL fabricator_delta_set_transaction_version('lake', 't', 'loader', 1);
----
loader	1

statement ok
INSERT INTO lake.main.t VALUES (1), (2);

statement ok
COMMIT;

query TI
SELECT * FROM fabricator_delta_get_transaction_version('lake', 't', 'loader');
----
loader	1

query I
SELECT count(*) FROM lake.main.t;
----
2

# ----------------------------------------------------------------------------
# 4. a blind RETRY of batch 1 fails the CAS at COMMIT — no duplicate data
# ----------------------------------------------------------------------------

statement ok
BEGIN;

statement ok
CALL fabricator_delta_set_transaction_version('lake', 't', 'loader', 1);

statement ok
INSERT INTO lake.main.t VALUES (1), (2);

statement error
COMMIT;
----
transaction version conflict

query I
SELECT count(*) FROM lake.main.t;
----
2

# ----------------------------------------------------------------------------
# 5. the next batch with the correct expected_previous succeeds
# ----------------------------------------------------------------------------

statement ok
BEGIN;

statement ok
CALL fabricator_delta_set_transaction_version('lake', 't', 'loader', 2, 1);

statement ok
INSERT INTO lake.main.t VALUES (3);

statement ok
COMMIT;

query TI
SELECT * FROM fabricator_delta_get_transaction_version('lake', 't', 'loader');
----
loader	2

query II
SELECT count(*), sum(id) FROM lake.main.t;
----
3	6

# a wrong expected_previous fails
statement ok
BEGIN;

statement ok
CALL fabricator_delta_set_transaction_version('lake', 't', 'loader', 5, 3);

statement error
COMMIT;
----
transaction version conflict

# ----------------------------------------------------------------------------
# 6. concurrent producers racing the SAME batch: exactly one wins
# ----------------------------------------------------------------------------

statement ok con1
BEGIN;

statement ok con1
CALL fabricator_delta_set_transaction_version('lake', 't', 'job2', 1);

statement ok con1
INSERT INTO lake.main.t VALUES (100);

# the racer commits the same (app, version) first
statement ok con2
BEGIN;

statement ok con2
CALL fabricator_delta_set_transaction_version('lake', 't', 'job2', 1);

statement ok con2
INSERT INTO lake.main.t VALUES (100);

statement ok con2
COMMIT;

statement error con1
COMMIT;
----
transaction version conflict

# exactly one 100 landed
query I
SELECT count(*) FROM lake.main.t WHERE id = 100;
----
1

# distinct app ids are independent
query TI
SELECT * FROM fabricator_delta_get_transaction_version('lake', 't', 'job2');
----
job2	1

query TI
SELECT * FROM fabricator_delta_get_transaction_version('lake', 't', 'loader');
----
loader	2

# ----------------------------------------------------------------------------
# 7. ROLLBACK discards the parked version (no txn action committed)
# ----------------------------------------------------------------------------

statement ok
BEGIN;

statement ok
CALL fabricator_delta_set_transaction_version('lake', 't', 'loader', 3, 2);

statement ok
ROLLBACK;

query TI
SELECT * FROM fabricator_delta_get_transaction_version('lake', 't', 'loader');
----
loader	2

# ----------------------------------------------------------------------------
# 8. durability: the high-water mark survives re-attach (it lives in the Delta log)
# ----------------------------------------------------------------------------

statement ok
DETACH lake;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/txnver' AS lake2 (TYPE fabricator, PROVIDER 'delta');

query TI
SELECT * FROM fabricator_delta_get_transaction_version('lake2', 't', 'loader');
----
loader	2

# ----------------------------------------------------------------------------
# 9. A REFUSED flush takes back the deletion vector it wrote (EW #46 + #49)
#
# StageRowDeletesAsync writes the vector at STAGING time, so it is on storage
# before the app-transaction precondition is judged. Until the flush's
# transaction became `await using`, a refused commit left it behind forever —
# MEASURED: the same shape produced a stray deletion_vector_*.bin.
#
# Scoped deliberately to what EW's OWN writers produced. Our eagerly-written
# DATA files are written before that transaction exists and EW's provenance
# rule never collects a host-written file, so "rollback leaves invisible
# orphans for VACUUM" still describes them — §5's ROLLBACK above is unchanged.
#
# The delete must exceed the 1 KB roaring-bitmap inline threshold or the vector
# rides INSIDE the commit json and there is no file to leak — a smaller delete
# passes this section while testing nothing.
# ----------------------------------------------------------------------------

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/txnorph' AS orph (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE orph.main.t (id INTEGER) WITH (deletion_vectors=true);

statement ok
INSERT INTO orph.main.t SELECT * FROM range(20000);

statement ok
BEGIN;

statement ok
CALL fabricator_delta_set_transaction_version('orph', 't', 'loader', 5);

statement ok
INSERT INTO orph.main.t VALUES (999999);

statement ok
COMMIT;

# positive control: no vector on disk yet, so a later 0 means "collected", not
# "never written".
query I
SELECT count(*) FROM glob('${FABRICATOR_DELTA_WRITE_DIR}/txnorph/t/deletion_vector_*.bin');
----
0

statement ok
BEGIN;

statement ok
DELETE FROM orph.main.t WHERE id % 3 = 0;

# the SAME version again, with the Absent precondition — refused at commit
statement ok
CALL fabricator_delta_set_transaction_version('orph', 't', 'loader', 5);

statement error
COMMIT;
----
transaction version conflict

# the vector staged by the refused flush is GONE
query I
SELECT count(*) FROM glob('${FABRICATOR_DELTA_WRITE_DIR}/txnorph/t/deletion_vector_*.bin');
----
0

# and the DELETE did not land
query I
SELECT count(*) FROM orph.main.t;
----
20001
