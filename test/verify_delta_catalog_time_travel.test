# name: test/verify_delta_catalog_time_travel.test
# description: Delta folder-as-catalog TIME TRAVEL. `FROM t AT (VERSION => n)` reads the table as of commit n;
#              `AT (TIMESTAMP => ts)` reads as of that instant (resolved to a version). Filter pushdown still
#              applies under time travel. Read-only (a past snapshot is never written). Set FABRICATOR_DELTA_WRITE_DIR
#              to a WRITABLE base path. Local FS.
# group: [fabricator]

require fabricator

require-env FABRICATOR_DELTA_WRITE_DIR

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogtt' AS lake (TYPE fabricator, PROVIDER 'delta');

# Build a version history: v0 = empty (CREATE), v1/v2/v3 = one INSERT each.
statement ok
CREATE TABLE lake.main.t (id INTEGER, val VARCHAR);

statement ok
INSERT INTO lake.main.t VALUES (1, 'a');

statement ok
INSERT INTO lake.main.t VALUES (2, 'b');

statement ok
INSERT INTO lake.main.t VALUES (3, 'c');

# Latest = all three rows.
query IT
SELECT id, val FROM lake.main.t ORDER BY id;
----
1	a
2	b
3	c

# AT (VERSION => 1) — only the first insert.
query IT
SELECT id, val FROM lake.main.t AT (VERSION => 1) ORDER BY id;
----
1	a

# AT (VERSION => 2) — first two.
query IT
SELECT id, val FROM lake.main.t AT (VERSION => 2) ORDER BY id;
----
1	a
2	b

# AT (VERSION => 0) — the empty CREATE commit.
query I
SELECT count(*) FROM lake.main.t AT (VERSION => 0);
----
0

# Filter pushdown still applies under time travel (superset-safe; DuckDB re-applies).
query IT
SELECT id, val FROM lake.main.t AT (VERSION => 3) WHERE id >= 2 ORDER BY id;
----
2	b
3	c

# Time travel coexists with the live (latest) scan in one query (the count(*)-via-rowid optimization on the
# same table at several versions — exercises the version-aware rowid stream).
query III
SELECT (SELECT count(*) FROM lake.main.t),
       (SELECT count(*) FROM lake.main.t AT (VERSION => 1)),
       (SELECT count(*) FROM lake.main.t AT (VERSION => 0));
----
3	1	0

# Version comparison in one query — a FULL JOIN of two versions (v1 has id 1; v3 adds 2,3).
query II
SELECT v1.id, v3.id
FROM (SELECT id FROM lake.main.t AT (VERSION => 1)) v1
FULL JOIN (SELECT id FROM lake.main.t AT (VERSION => 3)) v3 USING (id)
ORDER BY v3.id;
----
1	1
NULL	2
NULL	3

# Versions also compose under UNION ALL (1 row + 2 rows).
query I
SELECT count(*) FROM (SELECT id FROM lake.main.t AT (VERSION => 1)
                      UNION ALL SELECT id FROM lake.main.t AT (VERSION => 2));
----
3

# AT (TIMESTAMP => ...) resolves via the commit timestamp. Every commit carries a timestamp from the always-on
# commitInfo (the in_commit_timestamps feature adds the in-protocol monotonic inCommitTimestamp for Spark/Fabric
# interop, but is NOT required for local timestamp travel). A far-future instant resolves to the latest version.
query I
SELECT count(*) FROM lake.main.t AT (TIMESTAMP => '2999-01-01 00:00:00');
----
3

# An instant BEFORE the first commit has no version at/before it → a clean error.
statement error
SELECT count(*) FROM lake.main.t AT (TIMESTAMP => '1999-01-01 00:00:00');
----
No commit found

# Time travel survives detach/re-attach (reads the log, not in-memory state).
statement ok
DETACH lake;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogtt' AS lake (TYPE fabricator, PROVIDER 'delta');

query IT
SELECT id, val FROM lake.main.t AT (VERSION => 2) ORDER BY id;
----
1	a
2	b

statement ok
DETACH lake;

# With the `in_commit_timestamps true` ATTACH option, tables created here enable the Delta inCommitTimestamps
# WRITER feature (the writer records a per-commit timestamp), so AT (TIMESTAMP => ...) RESOLVES (vs the error
# above). Validated: delta-rs/delta-kernel (DuckDB's official delta_scan) reads such a table, and OneLake/Fabric
# accepts it (it's a writer-only feature — readers read normally).
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogtt_ict' AS ict (TYPE fabricator, PROVIDER 'delta', in_commit_timestamps true);

statement ok
CREATE TABLE ict.main.t (id INTEGER);

statement ok
INSERT INTO ict.main.t VALUES (1);

statement ok
INSERT INTO ict.main.t VALUES (2);

# A far-future timestamp resolves to the latest version (the inCommitTimestamp on each commit is honored).
query I
SELECT count(*) FROM ict.main.t AT (TIMESTAMP => '2999-01-01 00:00:00');
----
2

# VERSION travel still works alongside.
query I
SELECT count(*) FROM ict.main.t AT (VERSION => 1);
----
1

statement ok
DETACH ict;
