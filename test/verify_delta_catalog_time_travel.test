# name: test/verify_delta_catalog_time_travel.test
# description: Delta folder-as-catalog TIME TRAVEL. `FROM t AT (VERSION => n)` reads the table as of commit n;
#              `AT (TIMESTAMP => ts)` reads as of that instant (resolved to a version). Filter pushdown still
#              applies under time travel. Read-only (a past snapshot is never written). Set FABRICATOR_DELTA_WRITE_DIR
#              to a WRITABLE base path. Local FS.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogtt' AS lake (TYPE fabricator, PROVIDER 'delta');

# Build a version history: v0 = empty (CREATE), v1/v2/v3 = one INSERT each.
statement ok
CREATE TABLE lake.main.t (id INTEGER, val VARCHAR);

statement ok
INSERT INTO lake.main.t VALUES (1, 'a');

statement ok
INSERT INTO lake.main.t VALUES (2, 'b');

statement ok
INSERT INTO lake.main.t VALUES (3, 'c');

# Latest = all three rows.
query IT
SELECT id, val FROM lake.main.t ORDER BY id;
----
1	a
2	b
3	c

# AT (VERSION => 1) — only the first insert.
query IT
SELECT id, val FROM lake.main.t AT (VERSION => 1) ORDER BY id;
----
1	a

# AT (VERSION => 2) — first two.
query IT
SELECT id, val FROM lake.main.t AT (VERSION => 2) ORDER BY id;
----
1	a
2	b

# AT (VERSION => 0) — the empty CREATE commit.
query I
SELECT count(*) FROM lake.main.t AT (VERSION => 0);
----
0

# Filter pushdown still applies under time travel (superset-safe; DuckDB re-applies).
query IT
SELECT id, val FROM lake.main.t AT (VERSION => 3) WHERE id >= 2 ORDER BY id;
----
2	b
3	c

# Time travel coexists with the live (latest) scan in one query (the count(*)-via-rowid optimization on the
# same table at several versions — exercises the version-aware rowid stream).
query III
SELECT (SELECT count(*) FROM lake.main.t),
       (SELECT count(*) FROM lake.main.t AT (VERSION => 1)),
       (SELECT count(*) FROM lake.main.t AT (VERSION => 0));
----
3	1	0

# Version comparison in one query — a FULL JOIN of two versions (v1 has id 1; v3 adds 2,3).
query II
SELECT v1.id, v3.id
FROM (SELECT id FROM lake.main.t AT (VERSION => 1)) v1
FULL JOIN (SELECT id FROM lake.main.t AT (VERSION => 3)) v3 USING (id)
ORDER BY v3.id;
----
1	1
NULL	2
NULL	3

# Versions also compose under UNION ALL (1 row + 2 rows).
query I
SELECT count(*) FROM (SELECT id FROM lake.main.t AT (VERSION => 1)
                      UNION ALL SELECT id FROM lake.main.t AT (VERSION => 2));
----
3

# AT (TIMESTAMP => ...) resolves via the commit timestamp. Every commit carries a timestamp from the always-on
# commitInfo (the in_commit_timestamps feature adds the in-protocol monotonic inCommitTimestamp for Spark/Fabric
# interop, but is NOT required for local timestamp travel). A far-future instant resolves to the latest version.
query I
SELECT count(*) FROM lake.main.t AT (TIMESTAMP => '2999-01-01 00:00:00');
----
3

# An instant BEFORE the first commit has no version at/before it → a clean error.
statement error
SELECT count(*) FROM lake.main.t AT (TIMESTAMP => '1999-01-01 00:00:00');
----
No commit found

# A VERSION PAST THE END OF THE LOG is an error, not the latest snapshot wearing the requested label.
# Pinned because the old behaviour was to return the newest version SILENTLY — a caller asking for v99 of a
# 3-version table got 3 rows and no indication it had not been given what it asked for, which is the shape a
# stale pin or an off-by-one produces. Now the message names the first version it could not cover.
statement error
SELECT count(*) FROM lake.main.t AT (VERSION => 99);
----
Delta log is incomplete

# Time travel survives detach/re-attach (reads the log, not in-memory state).
statement ok
DETACH lake;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogtt' AS lake (TYPE fabricator, PROVIDER 'delta');

query IT
SELECT id, val FROM lake.main.t AT (VERSION => 2) ORDER BY id;
----
1	a
2	b

statement ok
DETACH lake;

# With the `in_commit_timestamps true` ATTACH option, tables created here enable the Delta inCommitTimestamps
# WRITER feature (the writer records a per-commit timestamp), so AT (TIMESTAMP => ...) RESOLVES (vs the error
# above). Validated: delta-rs/delta-kernel (DuckDB's official delta_scan) reads such a table, and OneLake/Fabric
# accepts it (it's a writer-only feature — readers read normally).
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogtt_ict' AS ict (TYPE fabricator, PROVIDER 'delta', in_commit_timestamps true);

statement ok
CREATE TABLE ict.main.t (id INTEGER);

statement ok
INSERT INTO ict.main.t VALUES (1);

statement ok
INSERT INTO ict.main.t VALUES (2);

# A far-future timestamp resolves to the latest version (the inCommitTimestamp on each commit is honored).
query I
SELECT count(*) FROM ict.main.t AT (TIMESTAMP => '2999-01-01 00:00:00');
----
2

# VERSION travel still works alongside.
query I
SELECT count(*) FROM ict.main.t AT (VERSION => 1);
----
1

statement ok
DETACH ict;

# ---------------------------------------------------------------------------------------------------------
# TIME TRAVEL ACROSS A SCHEMA CHANGE. Every other section builds its history from INSERTs alone, so all
# versions share ONE schema — which is why this suite passed for months while `AT (VERSION => n)` over an
# ALTERed table was broken, and why the ADD COLUMN below is the whole point of this section.
#
# It took TWO layers, and fixing only the first made things WORSE (docs/known-limitations.md §1.x):
#   1. the bind-time schema PROBE sent a hardcoded `{"schema_only":true}` carrying no AT, and was built
#      before the clause was recorded at all -> the plan was typed at LATEST;
#   2. `SELECT *` expands from the CATALOG ENTRY, whose ColumnList also came from latest. With only (1)
#      fixed, a 3-column expansion met a 2-column scan and DuckDB raised
#      "INTERNAL Error: Vector::Reference used on vector of different type", which INVALIDATES THE DATABASE.
#
# ⚠ PLACED LAST ON PURPOSE: a regression here is fatal to the connection, so every later assertion in the
# file would die with "FATAL Error: database has been invalidated" rather than reporting its own result.
# ---------------------------------------------------------------------------------------------------------
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogtt_evo' AS evo (TYPE fabricator, PROVIDER 'delta', READ_ONLY false);

statement ok
CREATE TABLE evo.main.t AS SELECT i AS id, i * 2 AS v FROM range(3) r(i);

# v1 = the CREATE's data. Adding a column AFTER it makes v1's schema NARROWER than latest.
statement ok
ALTER TABLE evo.main.t ADD COLUMN extra INTEGER;

# LATEST: three columns; no file carries `extra`, so it reads NULL.
query III
SELECT id, v, extra FROM evo.main.t ORDER BY id;
----
0	0	NULL
1	2	NULL
2	4	NULL

# AS OF v1: `SELECT *` must expand to the TWO columns that existed then. This is the assertion both layers
# exist for — with (2) missing it is not a wrong answer but a fatal internal error.
query II
SELECT * FROM evo.main.t AT (VERSION => 1) ORDER BY id;
----
0	0
1	2
2	4

# An explicit column list as of v1 — the shape layer (1) alone already fixed. Kept as the control that
# distinguishes "both layers work" from "only the probe was fixed".
query II
SELECT id, v FROM evo.main.t AT (VERSION => 1) ORDER BY id;
----
0	0
1	2
2	4

# Naming the post-ALTER column AS OF v1 is a clean binder error: the entry now describes v1, where it does
# not exist. Asserts the as-of column set is really NARROWER rather than latest-with-NULLs.
statement error
SELECT extra FROM evo.main.t AT (VERSION => 1);
----

# ⚠ THE AT ENTRY MUST NOT LEAK INTO THE CATALOG LISTING. Time travel is a property of a table REFERENCE, not
# of the catalog, so enumeration keeps showing ONE `t` at the LATEST schema however many versions were
# queried above. The context-free Scan() overload walks the entry map directly, which is exactly why AT
# entries live in their own map — without that separation this reports two rows.
query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'evo' AND table_name = 't';
----
1

query I
SELECT count(*) FROM duckdb_columns() WHERE database_name = 'evo' AND table_name = 't';
----
3

# ⚠ A RENAME, NOT JUST AN ADD — and this section exists because the ADD COLUMN case above CANNOT SEE
# layer (1). ADD COLUMN appends, so v1's schema is a PREFIX of latest and the two agree positionally on the
# columns that matter; mutation-testing showed a build with the probe's AT clause REMOVED passing everything
# above. A RENAME makes the as-of schema disagree by NAME rather than by length, which is what the probe is
# for: with it disabled the scan asks the v1 parquet for the NEW name and fails with
#     Binder Error: Referenced column "renamed" not found in FROM clause
# So this section pins layer (1); the ADD COLUMN one above pins layer (2).
statement ok
CREATE TABLE evo.main.r AS SELECT i AS id, i * 2 AS v FROM range(3) tbl(i);

statement ok
ALTER TABLE evo.main.r RENAME COLUMN v TO renamed;

query II
SELECT id, renamed FROM evo.main.r ORDER BY id;
----
0	0
1	2
2	4

# AS OF v1 the column is still `v` — the as-of schema differs from latest by NAME, not by length.
query II
SELECT * FROM evo.main.r AT (VERSION => 1) ORDER BY id;
----
0	0
1	2
2	4

query II
SELECT id, v FROM evo.main.r AT (VERSION => 1) ORDER BY id;
----
0	0
1	2
2	4

# And the NEW name must not resolve as of a version that predates the rename.
statement error
SELECT renamed FROM evo.main.r AT (VERSION => 1);
----

statement ok
DETACH evo;
