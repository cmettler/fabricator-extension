# name: test/verify_pushdown_edges_mssql.test
# description: SQL edge cases mined from substrait-java's semantics tests, each run with remote_pushdown
#              and compared with what DuckDB itself answers over the same SQL Server rows. GENERATED by
#              scripts/pushdown_edge_cases.py --emit — edit that, not this file. Found NOT EXISTS dropping
#              NULL-key rows and ROLLUP / CUBE losing the grand total on an empty input (2026-10-31).
# group: [fabricator]

require fabricator

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS rp (TYPE fabricator, remote_pushdown 'true');

statement ok
SELECT fabricator_exec('rp', 'DROP TABLE IF EXISTS dbo.ed_t; DROP TABLE IF EXISTS dbo.ed_u; CREATE TABLE dbo.ed_t (id INT PRIMARY KEY, i INT NULL, j INT NULL, b BIGINT NULL, ti TINYINT NULL, si SMALLINT NULL,   d DECIMAL(10,2) NULL, d1 DECIMAL(1,1) NULL, f FLOAT NULL, s NVARCHAR(40) NULL, v VARCHAR(40) NULL,   c NCHAR(10) NULL, flag BIT NULL, dt DATE NULL, ts DATETIME2(6) NULL, g INT NULL); INSERT INTO dbo.ed_t VALUES  (1, 7, 2, 9000000000, 5, 300, 2.50, 0.5, 2.5, N''Abc'', ''Abc'', N''ab'', 1, ''2024-01-31'', ''2024-01-31 10:00:00'', 1),  (2, -7, 2, -1, 0, -300, -2.50, -0.5, -2.5, N''abc'', ''abc'', N''ab  '', 0, ''2024-02-29'', ''2024-02-29 23:59:59.999999'', 1),  (3, 5, 0, 2147483647, 255, 32767, 0.00, 0.0, 0.0, N''abc  '', ''abc  '', N''AB'', NULL, ''2023-12-31'', ''1970-01-01 00:00:00'', 2),  (4, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, 2),  (5, 2147483647, 1, 2147483647, 1, 1, 1.49, 0.1, -0.0, N''École'', ''Ecole'', N''x'', 1, ''2024-03-15'', ''2024-03-15 12:30:45.5'', 3),  (6, 3, -2, 7, 2, 2, 3.555, 0.9, 1e308, N'''', '''', N'''', 0, ''0001-01-01'', ''0001-01-01 00:00:00'', 3),  (7, 3, 3, 7, 2, 2, 1.005, 0.3, 0.1, N''a%b'', ''a_b'', N''a'', 1, ''9999-12-31'', ''9999-12-31 23:59:59'', NULL); CREATE TABLE dbo.ed_u (id INT PRIMARY KEY, i INT NULL, s NVARCHAR(40) NULL); INSERT INTO dbo.ed_u VALUES (1, 7, N''Abc''), (2, 7, N''abc''), (3, NULL, N''x''), (4, 5, NULL), (5, 3, N''abc  '');', refresh_cache := true);

