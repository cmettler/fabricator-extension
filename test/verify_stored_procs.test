# name: test/verify_stored_procs.test
# description: Stored procs callable as SELECT * FROM db.schema.proc(name := val) over Arrow (named/optional params)
# group: [mssql]

require fabricator

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS spdb (TYPE fabricator);

# A proc with a determinable first result set + a required input parameter.
statement ok
SELECT fabricator_exec('spdb', 'CREATE OR ALTER PROCEDURE dbo.usp_sc(@minSalary INT) AS BEGIN SET NOCOUNT ON; SELECT v.id, v.name, v.salary FROM (VALUES(1,''Alice'',100),(2,''Bob'',200),(3,''Carol'',300)) v(id,name,salary) WHERE v.salary >= @minSalary ORDER BY v.id; END');

# A proc with an OPTIONAL parameter (SQL default) to exercise omission -> default fallback.
statement ok
SELECT fabricator_exec('spdb', 'CREATE OR ALTER PROCEDURE dbo.usp_opt(@base INT, @bonus INT = 50) AS BEGIN SET NOCOUNT ON; SELECT @base + @bonus AS total; END');

# A proc with OUTPUT params (+ an integer RETURN value) and no meaningful result set.
statement ok
SELECT fabricator_exec('spdb', 'CREATE OR ALTER PROCEDURE dbo.usp_outp(@a INT, @b INT, @sum INT OUTPUT, @diff INT OUTPUT) AS BEGIN SET NOCOUNT ON; SET @sum=@a+@b; SET @diff=@a-@b; RETURN 42; END');

# New routines are picked up on a cache refresh (DDL via fabricator_exec does not auto-invalidate).
statement ok
SELECT fabricator_refresh_cache('spdb');

# Proc parameters are DuckDB named parameters (mirrors EXEC @name=val): name := value.
# Output schema via sp_describe_first_result_set; executed via EXEC dbo.usp_sc @minSalary=@p0.
query ITI
SELECT id, name, salary FROM spdb.dbo.usp_sc(minSalary := 200) ORDER BY id;
----
2	Bob	200
3	Carol	300

# Projection + filter are applied locally by DuckDB (a proc's EXEC is not inline-wrappable,
# so there is no pushdown) — the result is still correct.
query T
SELECT name FROM spdb.dbo.usp_sc(minSalary := 100) WHERE salary > 200 ORDER BY name;
----
Carol

# Aggregation over the proc's result set.
query II
SELECT count(*), sum(salary) FROM spdb.dbo.usp_sc(minSalary := 100);
----
3	600

# Optional parameter OMITTED -> the proc's own DEFAULT (@bonus = 50) is used: 10 + 50.
query I
SELECT total FROM spdb.dbo.usp_opt(base := 10);
----
60

# Optional parameter SUPPLIED -> overrides the default: 10 + 5.
query I
SELECT total FROM spdb.dbo.usp_opt(base := 10, bonus := 5);
----
15

# OUTPUT params are returned as flat columns (no struct nesting) plus the integer RETURN
# value; the proc's own result set, if any, is ignored. Inputs are still named.
query III
SELECT sum, diff, return_value FROM spdb.dbo.usp_outp(a := 10, b := 3);
----
13	7	42

# A non-output column projects locally (no pushdown for procs).
query I
SELECT diff FROM spdb.dbo.usp_outp(a := 20, b := 5);
----
15

statement ok
SELECT fabricator_exec('spdb', 'DROP PROCEDURE IF EXISTS dbo.usp_sc');

statement ok
SELECT fabricator_exec('spdb', 'DROP PROCEDURE IF EXISTS dbo.usp_opt');

statement ok
SELECT fabricator_exec('spdb', 'DROP PROCEDURE IF EXISTS dbo.usp_outp');

statement ok
DETACH spdb;
