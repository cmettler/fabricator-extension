# name: test/verify_delta_catalog.test
# description: The Delta folder-as-catalog provider — ATTACH a Delta root (TYPE fabricator, PROVIDER 'delta'),
#              discover tables (subdirs with _delta_log/) under a flat `main` schema, and SELECT them (filter
#              pushdown + cross-table joins). Read-only slice. Writes the tables first via fabricator_delta_write,
#              then attaches the folder. Set FABRICATOR_DELTA_WRITE_DIR to a WRITABLE base path. See
#              docs/delta-catalog.md. (NOTE: table auto-discovery needs a working directory-recursion glob —
#              OneLake/ADLS currently can't, a DuckDB azure-extension limitation; this runs on a local FS.)
# group: [fabricator]

require fabricator

require-env FABRICATOR_DELTA_WRITE_DIR

# Create two Delta tables under <dir>/catalog/ via the write collector.
query I
SELECT rows_written FROM fabricator_delta_write(
  (SELECT i AS id, 'a' || i AS name FROM range(1, 6) t(i)),
  path := '${FABRICATOR_DELTA_WRITE_DIR}/catalog/orders');
----
5

query I
SELECT rows_written FROM fabricator_delta_write(
  (SELECT i AS k, i * 10 AS v FROM range(1, 4) t(i)),
  path := '${FABRICATOR_DELTA_WRITE_DIR}/catalog/items');
----
3

# ATTACH the folder as a Delta catalog — the tables are discovered under the flat `main` schema.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalog' AS lake (TYPE fabricator, PROVIDER 'delta');

query T
SELECT table_name FROM duckdb_tables() WHERE database_name = 'lake' ORDER BY table_name;
----
items
orders

# Scan with filter pushdown.
query IT
SELECT id, name FROM lake.main.orders WHERE id >= 4 ORDER BY id;
----
4	a4
5	a5

# Aggregate + cross-table join across two Delta tables in the catalog.
query I
SELECT sum(v) FROM lake.main.items;
----
60

query ITI
SELECT o.id, o.name, i.v FROM lake.main.orders o JOIN lake.main.items i ON o.id = i.k
WHERE o.id >= 2 ORDER BY o.id;
----
2	a2	20
3	a3	30

statement ok
DETACH lake;
