# name: test/verify_delta_catalog_s3.test
# description: The engineered-wood Delta folder-catalog on S3-COMPATIBLE storage (MinIO): all IO through
#              DuckDB's FileSystem (httpfs) + an s3 secret — discovery (host-FS glob), CREATE/CTAS/INSERT,
#              filter pushdown, DV DELETE + merge-on-read UPDATE (no dir-ops), snapshots, explicit
#              transactions, re-ATTACH durability, and the native_write/native_read variant (COPY +
#              read_parquet over s3://). Uses the docker/docker-compose.yml MinIO (bucket `fabricator`,
#              test-only creds; HTTPS via the self-signed cert — httpfs does not pin the CA).
#              Re-runnable against a persistent bucket: every table is CREATE OR REPLACE'd (DROP TABLE
#              is exercised mid-suite — httpfs implements s3 file deletion for the recursive dir-remove),
#              and the suite OPTIMIZE+VACUUMs what it leaves so the rig stops degrading run over run.
#              ⚠ That bounds the DATA files only — engineered-wood never deletes a superseded COMMIT file,
#              so the log still grows and periodically emptying the bucket remains the maintenance step.
#              See the teardown section at the bottom for the measurements.
# group: [fabricator]

require fabricator

require httpfs

require parquet

require-env FABRICATOR_S3_ENDPOINT

# ENGINE-PARAMETERIZED: this suite runs TWICE, once per Delta engine. Object storage is where the two
# engines' file handling has diverged most in this project's history — the phantom-commit ExistsAsync
# glob, the s3 RemoveDirectory scheme-prefix failure, the zero-byte snappy payload that broke every
# read crossing a checkpoint — so the codec path over s3:// needs its own coverage rather than
# inheriting the local suites'. ${DELTA_PROVIDER} is 'delta' (DuckDB moves the parquet bytes) on one
# leg and 'engineeredwooddelta' (pure EW codec) on the other; scripts/run-suites.sh drives both. The
# one ATTACH that pins native_read/native_write explicitly is NOT parameterized — that section is
# about the native path and stays on it in both legs.
#
# Both legs share the bucket prefixes ON PURPOSE: every table here is CREATE OR REPLACE'd (the suite's
# own re-runnability contract), so the second leg also exercises replacing a table the OTHER engine
# wrote — a real scenario for anyone who flips the flag on an existing catalog.
require-env DELTA_PROVIDER

# The test rig's MinIO serves a SELF-SIGNED cert (SQL Server trusts it via its CA mount; DuckDB's
# curl-based httpfs verifies against the system store) — disable verification GLOBALLY (the transaction
# flush runs on its own connection, which must inherit it).
# (Production alternative: SET ca_cert_file = '<path to docker/certs/public.crt>'.)
statement ok
SET GLOBAL enable_curl_server_cert_verification = false;

statement ok
CREATE SECRET minio_s3 (TYPE s3, KEY_ID 'miniouser', SECRET 'miniosecret123',
                        ENDPOINT '${FABRICATOR_S3_ENDPOINT}', URL_STYLE 'path', REGION 'us-east-1',
                        USE_SSL true);

# ---- ATTACH an s3:// Delta catalog root (READ_ONLY false: DuckDB auto-bumps remote ATTACHes) ----
statement ok
ATTACH 's3://fabricator/lake' AS s3lake (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}', READ_ONLY false);

# ---- CREATE + INSERT + read back ----
statement ok
CREATE OR REPLACE TABLE s3lake.main.t AS
SELECT i AS id, 'name' || i AS name, i * 1.5 AS score FROM range(1, 6) r(i);

query ITR
SELECT id, name, score FROM s3lake.main.t ORDER BY id;
----
1	name1	1.5
2	name2	3.0
3	name3	4.5
4	name4	6.0
5	name5	7.5

statement ok
INSERT INTO s3lake.main.t VALUES (6, 'name6', 9.0);

query I
SELECT count(*) FROM s3lake.main.t;
----
6

# Filter pushdown (engineered-wood file/row-group pruning is superset-safe; DuckDB re-applies).
query IT
SELECT id, name FROM s3lake.main.t WHERE id >= 5 ORDER BY id;
----
5	name5
6	name6

query I
SELECT sum(id) FROM s3lake.main.t WHERE score > 4.0;
----
18

# ---- DV DELETE (metadata-only — no dir ops) + merge-on-read UPDATE ----
statement ok
DELETE FROM s3lake.main.t WHERE id IN (2, 4);

query I
SELECT count(*) FROM s3lake.main.t;
----
4

statement ok
UPDATE s3lake.main.t SET name = 'updated' WHERE id = 3;

query T
SELECT name FROM s3lake.main.t WHERE id = 3;
----
updated

# ---- snapshots/history over S3 ----
# CREATE OR REPLACE = v0 CREATE + v1 WRITE on a fresh table (a re-run adds versions — assert shape only).
query I
SELECT count(*) >= 4 FROM fabricator_delta_snapshots('s3lake', 't');
----
true

query T
SELECT operation FROM fabricator_delta_snapshots('s3lake', 't') ORDER BY version DESC LIMIT 1;
----
UPDATE

# ---- explicit transaction on S3: fused commit + rollback ----
statement ok
BEGIN;

statement ok
INSERT INTO s3lake.main.t VALUES (10, 'txn', 0.0);

statement ok
DELETE FROM s3lake.main.t WHERE id = 5;

query I
SELECT count(*) FROM s3lake.main.t;
----
4

statement ok
COMMIT;

query I
SELECT count(*) FROM s3lake.main.t;
----
4

statement ok
BEGIN;

statement ok
INSERT INTO s3lake.main.t VALUES (99, 'doomed', 0.0);

statement ok
ROLLBACK;

# ROLLBACK of a table CREATED in the transaction, ON AN OBJECT STORE (hoist slice 5). The create is
# immediate now, so the rollback performs a real recursive delete — and on s3 that means httpfs'
# RemoveDirectory FAILS its own per-file remove ("URL needs to start with s3://") and the provider-side
# per-file fallback is what actually removes the objects. That fallback is reachable only from a real
# object store, so this is the one place the remote half of the rollback drop can be observed at all:
# the hermetic tier exercises a local root, where RemoveDirectory simply works.
statement ok
BEGIN;

statement ok
CREATE TABLE s3lake.main.rbdrop AS SELECT i AS id FROM range(1, 51) r(i);

# POSITIVE CONTROL: the table really is on the store mid-transaction, so the 0 below measures a deletion
# rather than a prefix that never existed (a glob on a missing prefix also returns 0).
query I
SELECT count(*) > 0 FROM glob('s3://fabricator/lake/rbdrop/**');
----
true

statement ok
ROLLBACK;

statement error
SELECT id FROM s3lake.main.rbdrop;
----

query I
SELECT count(*) FROM glob('s3://fabricator/lake/rbdrop/**');
----
0

query I
SELECT count(*) FROM s3lake.main.t;
----
4

# ---- re-ATTACH durability (rediscovery from the s3 _delta_log glob) ----
statement ok
DETACH s3lake;

statement ok
ATTACH 's3://fabricator/lake' AS s3lake2 (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}', READ_ONLY false);

query I
SELECT count(*) FROM s3lake2.main.t;
----
4

query IT
SELECT id, name FROM s3lake2.main.t WHERE id IN (3, 10) ORDER BY id;
----
3	updated
10	txn

statement ok
DETACH s3lake2;

# ---- native_write + native_read catalog on S3: DuckDB's COPY writes, read_parquet reads ----
statement ok
ATTACH 's3://fabricator/lake' AS s3n (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}', READ_ONLY false,
                                    native_write true, native_read true);

statement ok
CREATE OR REPLACE TABLE s3n.main.nt AS SELECT i AS id, i % 3 AS grp FROM range(1, 1001) r(i);

query I
SELECT count(*) FROM s3n.main.nt;
----
1000

query I
SELECT count(*) FROM s3n.main.nt WHERE grp = 0;
----
333

statement ok
DELETE FROM s3n.main.nt WHERE id <= 10;

query II
SELECT count(*), min(id) FROM s3n.main.nt;
----
990	11

statement ok
UPDATE s3n.main.nt SET grp = 99 WHERE id = 11;

query I
SELECT grp FROM s3n.main.nt WHERE id = 11;
----
99

statement ok
DETACH s3n;

# ---- Delta IDENTITY on S3 (the v53 generated-column marker): engine-assigned values, high-water
# continuation across re-attach, and DROP TABLE (per-file fallback — httpfs has no S3 RemoveDirectory) ----
statement ok
ATTACH 's3://fabricator/lake' AS s3id (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}', READ_ONLY false);

statement ok
DROP TABLE IF EXISTS s3id.main.idt;

statement ok
CREATE TABLE s3id.main.idt (id BIGINT AS (0), name VARCHAR);

statement ok
INSERT INTO s3id.main.idt (name) VALUES ('a'), ('b'), ('c');

query IT
SELECT id, name FROM s3id.main.idt ORDER BY id;
----
1	a
2	b
3	c

statement ok
DETACH s3id;

statement ok
ATTACH 's3://fabricator/lake' AS s3id2 (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}', READ_ONLY false);

statement ok
INSERT INTO s3id2.main.idt (name) VALUES ('d');

query IT
SELECT id, name FROM s3id2.main.idt WHERE id >= 3 ORDER BY id;
----
3	c
4	d

statement ok
DROP TABLE s3id2.main.idt;

statement ok
DETACH s3id2;

statement ok
ATTACH 's3://fabricator/lake' AS s3id3 (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}', READ_ONLY false);

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 's3id3' AND table_name = 'idt';
----
0

statement ok
DETACH s3id3;

# ---- Change Data Feed on S3: change files write to + read from the bucket (CoW capture path) ----
statement ok
ATTACH 's3://fabricator/lake-cdf' AS s3cdf (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}', READ_ONLY false,
                                          change_data_feed true, deletion_vectors false, column_mapping 'none');

statement ok
DROP TABLE IF EXISTS s3cdf.main.f;

statement ok
CREATE TABLE s3cdf.main.f (id INTEGER, name VARCHAR);

statement ok
INSERT INTO s3cdf.main.f VALUES (1, 'a'), (2, 'b'), (3, 'c');

statement ok
DELETE FROM s3cdf.main.f WHERE id = 2;

statement ok
UPDATE s3cdf.main.f SET name = 'upd' WHERE id = 3;

query TIIT
SELECT _change_type, _commit_version, id, name
FROM fabricator_delta_changes('s3cdf', 'f', 0) ORDER BY _commit_version, _change_type, id;
----
insert	1	1	a
insert	1	2	b
insert	1	3	c
delete	2	2	b
update_postimage	3	3	upd
update_preimage	3	3	c

statement ok
DROP TABLE s3cdf.main.f;

statement ok
DETACH s3cdf;

# ----------------------------------------------------------------------------
# 10. COPY … (FORMAT delta) — path-targeted Delta write straight to s3://, NO ATTACH
#     (transient catalog; same CREATE/append/REPLACE/SCHEMA_MODE/PARTITION_OVERWRITE features).
#     Re-runnable: the plain default COPY overwrites (create-or-replace semantics).
# ----------------------------------------------------------------------------

statement ok
COPY (SELECT i::INT AS id, 'v' || i AS val FROM range(1,5) t(i))
  TO 's3://fabricator/copyfmt/t1' (FORMAT delta);

query II
SELECT count(*), sum(id) FROM fabricator_delta_scan('s3://fabricator/copyfmt/t1');
----
4	10

# append (parked by the provider, flushed by the COPY's own transient-catalog commit)
statement ok
COPY (SELECT 5::INT AS id, 'v5' AS val)
  TO 's3://fabricator/copyfmt/t1' (FORMAT delta, CREATE_TABLE false);

query II
SELECT count(*), sum(id) FROM fabricator_delta_scan('s3://fabricator/copyfmt/t1');
----
5	15

# partitioned create + dynamic partition overwrite, all over s3://
statement ok
COPY (SELECT i::INT AS id, CASE WHEN i%2=0 THEN 'EU' ELSE 'US' END AS region FROM range(1,7) t(i))
  TO 's3://fabricator/copyfmt/pt' (FORMAT delta, PARTITION_COLUMNS 'region');

statement ok
COPY (SELECT 100::INT AS id, 'US' AS region)
  TO 's3://fabricator/copyfmt/pt' (FORMAT delta, CREATE_TABLE false, PARTITION_OVERWRITE true);

query III
SELECT region, count(*), sum(id) FROM fabricator_delta_scan('s3://fabricator/copyfmt/pt')
GROUP BY region ORDER BY region;
----
EU	3	12
US	1	100

# the written table ATTACHes as a normal Delta catalog table
statement ok
ATTACH 's3://fabricator/copyfmt' AS s3cf (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}');

query I
SELECT count(*) FROM s3cf.main.t1;
----
5

statement ok
DETACH s3cf;

# ============================================================================
# 9. Slice D: multi-writer commit safety — ATTACH with an s3 SECRET routes the
#    COMMIT rename through a REAL conditional PUT (AWS SDK, If-None-Match:"*")
#    instead of httpfs's unguarded exclusive-create. Live-validated: 4 racing
#    processes x 10 commits each -> 40/40 landed (800/800 rows), zero errors,
#    across checkpoint boundaries; a WRONG-key marker secret fails the commit
#    with the SDK signature error (proving the SDK is in the loop).
# ============================================================================

statement ok
ATTACH 's3://fabricator/condsuite' AS ccs (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}', SECRET minio_s3, READ_ONLY false);

statement ok
CREATE OR REPLACE TABLE ccs.main.t AS SELECT i AS id, 'v' || i AS v FROM range(1, 101) r(i);

statement ok
INSERT INTO ccs.main.t VALUES (500, 'x');

statement ok
BEGIN;

statement ok
INSERT INTO ccs.main.t VALUES (501, 'y');

statement ok
DELETE FROM ccs.main.t WHERE id = 5;

statement ok
UPDATE ccs.main.t SET v = 'upd' WHERE id = 10;

query I
SELECT count(*) FROM ccs.main.t;
----
101

statement ok
COMMIT;

query I
SELECT count(*) FROM ccs.main.t;
----
101

query T
SELECT v FROM ccs.main.t WHERE id = 10;
----
upd

# persistent bucket, re-runnable suite: assert growth, not an absolute count
query I
SELECT count(*) >= 3 FROM fabricator_delta_snapshots('ccs', 't');
----
true

statement ok
DETACH ccs;

# ============================================================================
# 10. Committed-table RENAME TABLE on S3 — SECRET-routed attach only: the SDK
#     renames the whole folder SERVER-SIDE (list -> CopyObject per key ->
#     batched delete; no data through the client). httpfs has no MoveFile, so
#     a secretless attach still rejects RENAME cleanly. Re-runnable: the
#     rename target is dropped up front.
# ============================================================================

statement ok
ATTACH 's3://fabricator/condsuite' AS rns (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}', SECRET minio_s3, READ_ONLY false);

statement ok
DROP TABLE IF EXISTS rns.main.rn_dst;

statement ok
CREATE OR REPLACE TABLE rns.main.rn_src AS SELECT i AS id, 'v' || i AS v FROM range(1, 51) r(i);

# a DELETE first so the folder carries a DV commit too (multiple _delta_log entries move)
statement ok
DELETE FROM rns.main.rn_src WHERE id = 7;

statement ok
ALTER TABLE rns.main.rn_src RENAME TO rn_dst;

query II
SELECT count(*), sum(id) FROM rns.main.rn_dst;
----
49	1268

query T
SELECT v FROM rns.main.rn_dst WHERE id = 10;
----
v10

# the old name is gone (folder moved, catalog re-keyed)
query I
SELECT count(*) FROM (SELECT * FROM information_schema.tables WHERE table_catalog = 'rns' AND table_name = 'rn_src');
----
0

# durable: re-attach re-discovers only the new name
statement ok
DETACH rns;

statement ok
ATTACH 's3://fabricator/condsuite' AS rns (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}', SECRET minio_s3, READ_ONLY false);

query I
SELECT count(*) FROM rns.main.rn_dst;
----
49

query I
SELECT count(*) FROM (SELECT * FROM information_schema.tables WHERE table_catalog = 'rns' AND table_name = 'rn_src');
----
0

# rename works again post-re-attach (round-trip back, leaves the bucket re-runnable)
statement ok
ALTER TABLE rns.main.rn_dst RENAME TO rn_src2;

query I
SELECT count(*) FROM rns.main.rn_src2;
----
49

statement ok
DROP TABLE rns.main.rn_src2;

statement ok
DETACH rns;

# ----------------------------------------------------------------------------
# 11. ATTACH-TIME WARNING: s3:// opened READ_WRITE with NO NAMED SECRET
#
# That configuration loses concurrent commits SILENTLY — MEASURED at 6 writers
# x 8 commits: 8 of 48 landed, 40 lost, zero errors; the same shape with the
# secret NAMED landed 48/48 (docs/delta-transactions.md §8.3). It is worth a
# warning precisely because nothing about it looks wrong: httpfs uses the
# ambient secret for DATA IO, so it authenticates, writes, reads and passes
# every single-writer test — only the COMMIT guard is missing, because the
# credential marker rides on the secret the ATTACH NAMES.
#
# Gated on READ_WRITE and not on "not read-only" ON PURPOSE, and the third
# attach below is why that is not merely conservative: DuckDB BUMPS a remote
# s3:// attach to read-only under AUTOMATIC (measured — a CREATE against it
# fails with "attached in read-only mode"), so an AUTOMATIC catalog can never
# reach the unguarded commit path and warning about it would train the warning
# away for nothing.
# ----------------------------------------------------------------------------

statement ok
CALL enable_logging(level := 'debug', storage := 'memory');

statement ok
ATTACH 's3://fabricator/warnprobe' AS wunguarded (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}', READ_ONLY false);

# the NAMED-secret attach is the control: same root shape, guard present, silent
statement ok
ATTACH 's3://fabricator/warnprobe' AS wguarded (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}', SECRET minio_s3, READ_ONLY false);

# AUTOMATIC (no READ_ONLY clause) — DuckDB makes it read-only, so no warning is owed
statement ok
ATTACH 's3://fabricator/warnprobe' AS wauto (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}');

# exactly ONE warning, naming the remedy
query I
SELECT count(*) FROM duckdb_logs
WHERE message LIKE '%s3 root attached READ_WRITE with no named SECRET%'
  AND message LIKE '%Add SECRET <name> to the ATTACH%';
----
1

# and it named the UNGUARDED root, not one of the other two
query I
SELECT count(*) FROM duckdb_logs
WHERE message LIKE '%delta attach s3://fabricator/warnprobe%no named SECRET%';
----
1

# the AUTOMATIC attach really is read-only — the reason it is exempt
statement error
CREATE TABLE wauto.main.nope (id INTEGER);
----
read-only mode

statement ok
DETACH wunguarded;

statement ok
DETACH wguarded;

statement ok
DETACH wauto;

# ============================================================================
# TEARDOWN — OPTIMIZE + VACUUM the tables this suite leaves behind, so the rig stops degrading.
#
# WHY (measured 2026-08-07): the suite is re-runnable against a PERSISTENT bucket, so every run adds
# to what the last one left. After ~125 runs `lake/t` held 148 commit files and a heap of orphaned data
# files, and a `count(*)` on that 4-ROW table cost 2.61 s warm against a 1.18 s fresh copy. The suite runs
# ~180 assertions twice, so that overhead is minutes per tier run — which is what made the service tier
# look hung.
#
# ⚠ WHAT THIS BOUNDS, AND WHAT IT DOES NOT — do not read it as "the rig is now self-maintaining":
#   • DATA files: BOUNDED. `CREATE OR REPLACE` orphans the previous version's files and nothing reclaimed
#     them. VACUUM does, and it is the bigger half — measured 3.54 s -> 2.06 s on `lake/t`.
#   • LOG files: NOT bounded, and this makes them grow FASTER. engineered-wood writes a checkpoint every
#     10 versions and NEVER deletes a commit the checkpoint subsumes — there is no log cleanup in it at
#     all (`delta.logRetentionDuration` appears only in doc comments and is never read). OPTIMIZE and
#     VACUUM each ADD a commit, so this trades ~10 extra commits per run for the reclaimed data.
#     Measured directly: `lake/t` went 148 -> 151 log files across one OPTIMIZE + VACUUM.
#   ⇒ periodically emptying the bucket is STILL the maintenance step (see CLAUDE.md); this only stops the
#     larger, faster-growing half.
#
# ⚠ WHY NOT `DROP TABLE`, which would bound both: the two ENGINE LEGS deliberately SHARE these prefixes so
# the second leg replaces a table the OTHER engine wrote — a real scenario for anyone flipping the flag on
# an existing catalog, and stated as intentional in this file's header. A per-leg drop would delete that
# coverage. Cleanup that bounds the log has to live OUTSIDE the suite, after both legs.
#
# ⚠ `RETAIN 0 HOURS` is a TEST-RIG setting. It ignores the retention horizon that protects a concurrent
# reader holding an older snapshot; on a real table use the default (7 days) or a considered value.
# ============================================================================

statement ok
ATTACH 's3://fabricator/lake' AS clean1 (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}',
                                         SECRET minio_s3, READ_ONLY false);

statement ok
SELECT fabricator_exec('clean1', 'OPTIMIZE main.t');

statement ok
SELECT fabricator_exec('clean1', 'VACUUM main.t RETAIN 0 HOURS');

statement ok
SELECT fabricator_exec('clean1', 'OPTIMIZE main.nt');

statement ok
SELECT fabricator_exec('clean1', 'VACUUM main.nt RETAIN 0 HOURS');

# The tables are still READABLE and INTACT afterwards — the assertion that makes this teardown safe rather
# than merely quiet. A VACUUM that removed a live file would surface here, not in some later run.
query II
SELECT count(*), sum(id) FROM clean1.main.t;
----
4	20

query I
SELECT count(*) FROM clean1.main.nt;
----
990

statement ok
DETACH clean1;

statement ok
ATTACH 's3://fabricator/condsuite' AS clean2 (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}',
                                              SECRET minio_s3, READ_ONLY false);

statement ok
SELECT fabricator_exec('clean2', 'OPTIMIZE main.t');

statement ok
SELECT fabricator_exec('clean2', 'VACUUM main.t RETAIN 0 HOURS');

statement ok
DETACH clean2;

# ⚠ copyfmt is attached READ-ONLY above (an s3 ATTACH with no READ_ONLY clause is auto-bumped by DuckDB),
# so the teardown needs its own writable attach — OPTIMIZE and VACUUM both COMMIT.
statement ok
ATTACH 's3://fabricator/copyfmt' AS clean3 (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}',
                                            SECRET minio_s3, READ_ONLY false);

statement ok
SELECT fabricator_exec('clean3', 'OPTIMIZE main.t1');

statement ok
SELECT fabricator_exec('clean3', 'VACUUM main.t1 RETAIN 0 HOURS');

statement ok
SELECT fabricator_exec('clean3', 'OPTIMIZE main.pt');

statement ok
SELECT fabricator_exec('clean3', 'VACUUM main.pt RETAIN 0 HOURS');

statement ok
DETACH clean3;
