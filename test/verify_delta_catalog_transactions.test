BEGIN;

statement ok
INSERT INTO mt.main.m SELECT i, 'v' || i FROM range(10, 210) r(i);

# eagerly on storage, log unmoved
query I
SELECT count(*) FROM glob('${ARROWNET_DELTA_WRITE_DIR}/txn_mat/m/*.parquet');
----
2

query I
SELECT count(*) FROM glob('${ARROWNET_DELTA_WRITE_DIR}/txn_mat/m/_delta_log/*.json');
----
2

query I
SELECT count(*) FROM mt.main.m;
----
201

statement ok
COMMIT;

query I
SELECT count(*) FROM mt.main.m;
----
201

statement ok
DETACH mt;

# --- identity: values generated at STATEMENT time from the pinned/chained HWM ---
statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/txn_ident' AS idl (TYPE arrownet, PROVIDER 'delta');

statement ok
CREATE TABLE idl.main.t (id BIGINT AS (0), v VARCHAR);

statement ok
INSERT INTO idl.main.t (v) VALUES ('a'), ('b');

statement ok
BEGIN;

statement ok
INSERT INTO idl.main.t (v) VALUES ('c'), ('d');

# eager file on storage, log unmoved
query I
SELECT count(*) FROM glob('${ARROWNET_DELTA_WRITE_DIR}/txn_ident/t/*.parquet');
----
2

query I
SELECT count(*) FROM glob('${ARROWNET_DELTA_WRITE_DIR}/txn_ident/t/_delta_log/*.json');
----
2

# read-your-writes shows the REAL generated ids (the batch park showed NULLs)
query I
SELECT count(DISTINCT id) FROM idl.main.t;
----
4

query I
SELECT count(*) FROM idl.main.t WHERE id IS NULL;
----
0

# a second statement CHAINS the pending high-water mark — no duplicate ids
statement ok
INSERT INTO idl.main.t (v) VALUES ('e'), ('f');

query I
SELECT count(DISTINCT id) FROM idl.main.t;
----
6

statement ok
COMMIT;

# committed: 6 distinct engine-assigned values, one fused commit (create=0, seed=1, txn=2)
query I
SELECT count(DISTINCT id) FROM idl.main.t;
----
6

query I
SELECT count(*) FROM arrownet_delta_snapshots('idl', 't');
----
3

# the committed HWM continues in a later autocommit insert (no reuse of txn-consumed ids)
statement ok
INSERT INTO idl.main.t (v) VALUES ('g');

query I
SELECT count(DISTINCT id) FROM idl.main.t;
----
7

# ROLLBACK discards baked values; the next transaction regenerates from the COMMITTED mark
statement ok
BEGIN;

statement ok
INSERT INTO idl.main.t (v) VALUES ('doomed');

statement ok
ROLLBACK;

statement ok
INSERT INTO idl.main.t (v) VALUES ('h');

query I
SELECT count(DISTINCT id) FROM idl.main.t;
----
8

statement ok
DETACH idl;

# ============================================================================
# 35. Materialize_row_tracking UPDATE in a transaction: post-images bake the
#     ORIGINAL stable row ids into the declared __delta_row_id column
# ============================================================================

# column_mapping 'none': the pins below read the RAW parquet files by logical column name.
statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/txn_mat' AS mu (TYPE arrownet, PROVIDER 'delta', row_tracking true, materialize_row_tracking true, column_mapping 'none');

statement ok
CREATE TABLE mu.main.u (id INTEGER, v VARCHAR);

statement ok
INSERT INTO mu.main.u VALUES (1, 'a'), (2, 'b'), (3, 'c');

statement ok
BEGIN;

statement ok
UPDATE mu.main.u SET v = 'B' WHERE id = 2;

query T
SELECT v FROM mu.main.u WHERE id = 2;
----
B

statement ok
COMMIT;

query IT
SELECT id, v FROM mu.main.u ORDER BY id;
----
1	a
2	B
3	c

# both files carry the materialized column (the autocommit codec seed materializes via EW's
# committing writer; the post-image bakes the ORIGINAL ids)
query I
SELECT count(DISTINCT file_name) FROM parquet_schema('${ARROWNET_DELTA_WRITE_DIR}/txn_mat/u/*.parquet') WHERE name = '__delta_row_id';
----
2

# the baked id is the ORIGINAL stable id of row 2 (seed file baseRowId=0 -> position 1)
query I
SELECT "__delta_row_id" FROM read_parquet('${ARROWNET_DELTA_WRITE_DIR}/txn_mat/u/*.parquet', union_by_name=true) WHERE v = 'B';
----
1

statement ok
DETACH mu;

# ============================================================================
# 36. Version-pinned read-back: an UPDATE's post-image content is read AT the
#     transaction's pinned version — concurrent appends (which can shift the
#     path-sort ordinals) can never make it read the wrong rows
# ============================================================================

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/txn_codec' AS vr (TYPE arrownet, PROVIDER 'delta');

statement ok
CREATE TABLE vr.main.vrt (id INTEGER, v VARCHAR);

statement ok
INSERT INTO vr.main.vrt VALUES (1, 'one'), (2, 'two'), (3, 'three');

statement ok con1
BEGIN;

# pin the transaction's snapshot with a scan
query I con1
SELECT count(*) FROM vr.main.vrt;
----
3

# a second connection lands several appends between the pin and the UPDATE —
# each new file can sort anywhere in the ordinal ordering
statement ok con2
INSERT INTO vr.main.vrt VALUES (100, 'x');

statement ok con2
INSERT INTO vr.main.vrt VALUES (101, 'y');

statement ok con2
INSERT INTO vr.main.vrt VALUES (102, 'z');

# the UPDATE's read-back resolves ordinals against the PINNED snapshot: it must
# capture 'two' (the correct pre-image), regardless of where the new files sorted
statement ok con1
UPDATE vr.main.vrt SET v = 'TWO' WHERE id = 2;

query T con1
SELECT v FROM vr.main.vrt WHERE id = 2;
----
TWO

# the flush rebases over the commuting appends and commits
statement ok con1
COMMIT;

# both sides landed: the racer's rows AND the correct update
query IT
SELECT id, v FROM vr.main.vrt ORDER BY id;
----
1	one
2	TWO
3	three
100	x
101	y
102	z

statement ok
DETACH vr;

# ============================================================================
# 37. Same-transaction DML lift (C3): DELETE of rows inserted in THIS
#     transaction — the pending file's add is born with an inline DV
# ============================================================================

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/txn_selfdml' AS sd (TYPE arrownet, PROVIDER 'delta');

statement ok
CREATE TABLE sd.main.t (id INTEGER, v VARCHAR);

statement ok
INSERT INTO sd.main.t VALUES (1, 'committed1'), (2, 'committed2');

statement ok
BEGIN;

statement ok
INSERT INTO sd.main.t SELECT i, 'pending' || i FROM range(10, 20) AS r(i);

query I
SELECT count(*) FROM sd.main.t;
----
12

# delete SOME of the rows inserted in this very transaction
statement ok
DELETE FROM sd.main.t WHERE id IN (12, 14, 16);

query I
SELECT count(*) FROM sd.main.t;
----
9

# and a MIXED delete: one committed row + one pending row in the same statement
statement ok
DELETE FROM sd.main.t WHERE id IN (2, 18);

query I
SELECT count(*) FROM sd.main.t;
----
7

query I
SELECT min(id) FROM sd.main.t WHERE id >= 10;
----
10

statement ok
COMMIT;

# ONE fused commit; the deleted pending rows never reached any committed version
query IT
SELECT id, v FROM sd.main.t ORDER BY id;
----
1	committed1
10	pending10
11	pending11
13	pending13
15	pending15
17	pending17
19	pending19

query I
SELECT count(*) FROM arrownet_delta_snapshots('sd', 't');
----
3

# rollback: pending inserts AND their same-txn deletes discard together
statement ok
BEGIN;

statement ok
INSERT INTO sd.main.t VALUES (100, 'x'), (101, 'y');

statement ok
DELETE FROM sd.main.t WHERE id = 100;

query I
SELECT count(*) FROM sd.main.t;
----
8

statement ok
ROLLBACK;

query I
SELECT count(*) FROM sd.main.t;
----
7

# UPDATE of same-txn rows stays guarded
statement ok
BEGIN;

statement ok
INSERT INTO sd.main.t VALUES (200, 'p');

statement error
UPDATE sd.main.t SET v = 'q' WHERE id = 200;
----
COMMIT the inserts first

statement ok
ROLLBACK;

statement ok
DETACH sd;

# same-txn DELETE on a native_write catalog (streamed pending file)
statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/txn_selfdml_n' AS sdn (TYPE arrownet, PROVIDER 'delta', native_write true);

statement ok
CREATE TABLE sdn.main.t (id INTEGER, v VARCHAR);

statement ok
INSERT INTO sdn.main.t VALUES (1, 'seed');

statement ok
BEGIN;

statement ok
INSERT INTO sdn.main.t SELECT i, 'p' || i FROM range(10, 1010) AS r(i);

statement ok
DELETE FROM sdn.main.t WHERE id % 2 = 0 AND id >= 10;

query I
SELECT count(*) FROM sdn.main.t;
----
501

statement ok
COMMIT;

query I
SELECT count(*) FROM sdn.main.t;
----
501

query I
SELECT count(*) FROM sdn.main.t WHERE id % 2 = 0 AND id >= 10;
----
0

statement ok
DETACH sdn;

# CDF tables: same-txn DELETE rejected (the insert-cdc already captured the row)
statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/txn_cdf2' AS sdc (TYPE arrownet, PROVIDER 'delta', change_data_feed true);

statement ok
BEGIN;

statement ok
INSERT INTO sdc.main.t VALUES (500, 'cdcpend');

statement error
DELETE FROM sdc.main.t WHERE id = 500;
----
COMMIT the inserts first

statement ok
ROLLBACK;

statement ok
DETACH sdc;
