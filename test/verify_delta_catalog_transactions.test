# The committed DATA reads under the new name (the rename-map overlay — not NULL-backfilled!).
query IT
SELECT id, title FROM elake.main.r ORDER BY id;
----
1	a
2	b

statement ok
INSERT INTO elake.main.r VALUES (3, 'c');

# Filter on the renamed column reaches committed data.
statement ok
DELETE FROM elake.main.r WHERE title = 'a';

query IT
SELECT id, title FROM elake.main.r ORDER BY id;
----
2	b
3	c

statement ok
COMMIT;

query IT
SELECT id, title FROM elake.main.r ORDER BY id;
