# ============================================================================
# 33. Slice C2: full CDF capture in explicit transactions — the fused commit's
#     feed is exact (cdc-only rule: inserts, deletes, update pre/post images)
# ============================================================================

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/txn_cdf2' AS cf (TYPE arrownet, PROVIDER 'delta', change_data_feed true);

statement ok
CREATE TABLE cf.main.t (id INTEGER, v VARCHAR);

statement ok
INSERT INTO cf.main.t VALUES (1, 'a'), (2, 'b'), (3, 'c');

statement ok
BEGIN;

statement ok
INSERT INTO cf.main.t VALUES (4, 'd'), (5, 'e');

statement ok
DELETE FROM cf.main.t WHERE id = 2;

statement ok
UPDATE cf.main.t SET v = 'A' WHERE id = 1;

# read-your-writes across all three
query IT
SELECT id, v FROM cf.main.t ORDER BY id;
----
1	A
3	c
4	d
5	e

statement ok
COMMIT;

query IT
SELECT id, v FROM cf.main.t ORDER BY id;
----
1	A
3	c
4	d
5	e

# ONE fused commit (create=0, seed=1, txn=2)
query I
SELECT count(*) FROM arrownet_delta_snapshots('cf', 't');
----
3

# the fused version's feed: 2 inserts + 1 delete + update pre/post — exact, nothing inferred
query TII
SELECT _change_type, count(*), min(id)
FROM arrownet_delta_changes('cf', 't', 2, 2)
GROUP BY _change_type ORDER BY _change_type;
----
delete	1	2
insert	2	4
update_postimage	1	1
update_preimage	1	1

# update images carry the right values
query T
SELECT v FROM arrownet_delta_changes('cf', 't', 2, 2) WHERE _change_type = 'update_preimage';
----
a

query T
SELECT v FROM arrownet_delta_changes('cf', 't', 2, 2) WHERE _change_type = 'update_postimage';
----
A

# the seed autocommit insert stays inference-based and intact
query TI
SELECT _change_type, count(*) FROM arrownet_delta_changes('cf', 't', 1, 1) GROUP BY _change_type;
----
insert	3

