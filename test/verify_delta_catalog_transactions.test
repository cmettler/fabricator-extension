# name: test/verify_delta_catalog_transactions.test
# description: Explicit DuckDB transactions on the Delta provider — slice 1 (append buffering) + slice 2
#              (buffered DELETE/UPDATE = snapshot isolation). Appends buffer per DuckDB transaction; DELETE/
#              UPDATE inside an explicit BEGIN buffer as deletion-vector positions (+ post-image rows) against
#              the transaction's pinned base version. COMMIT flushes everything as ONE atomic Delta commit per
#              table, with Spark-style LOGICAL REBASE on concurrent writers (WriteSerializable: blind appends
#              commute and the COMMIT rebases on top of them; a real conflict — metadata/protocol change or
#              delete/delete on the same file — conflict-ABORTS); ROLLBACK discards (uncommitted parquet =
#              invisible orphans, vacuum's job). Reads
#              inside the transaction overlay all pending changes (read-your-writes); explicit AT time travel
#              excludes them. Autocommit is UNCHANGED (per-statement commits, direct DML paths incl. CDF +
#              copy-on-write). Guards: DDL/maintenance/non-append writes with pending changes; DML on rows
#              inserted in the same transaction; DV-off / CDF tables inside explicit transactions.
# group: [mssql_net]

require mssql_net

require-env ARROWNET_DELTA_WRITE_DIR

# ============================================================================
# 1. Codec catalog: atomic multi-INSERT + rollback (slice 1)
# ============================================================================

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/txn_codec' AS lake (TYPE arrownet, PROVIDER 'delta');

statement ok
CREATE TABLE lake.main.t (id INTEGER, name VARCHAR);

statement ok
INSERT INTO lake.main.t VALUES (1, 'pre');

# Baseline: v0 CREATE + v1 WRITE.
query I
SELECT count(*) FROM arrownet_delta_snapshots('lake', 't');
----
2

statement ok
BEGIN;

statement ok
INSERT INTO lake.main.t VALUES (2, 'a');

statement ok
INSERT INTO lake.main.t SELECT i, 'b' || i FROM range(3, 5) AS r(i);

# Read-your-writes: the buffered rows are visible mid-transaction.
query I
SELECT count(*) FROM lake.main.t;
----
4

query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
1	pre
2	a
3	b3
4	b4

query I
SELECT sum(id) FROM lake.main.t WHERE id >= 2;
----
9

statement ok
INSERT INTO lake.main.t VALUES (5, 'c');

statement ok
COMMIT;

query I
SELECT count(*) FROM lake.main.t;
----
5

# ...as ONE new Delta commit (2 snapshots before, exactly 3 after — not 5).
query I
SELECT count(*) FROM arrownet_delta_snapshots('lake', 't');
----
3

statement ok
BEGIN;

statement ok
INSERT INTO lake.main.t VALUES (100, 'doomed');

query I
SELECT count(*) FROM lake.main.t;
----
6

statement ok
ROLLBACK;

query I
SELECT count(*) FROM lake.main.t;
----
5

query I
SELECT count(*) FROM arrownet_delta_snapshots('lake', 't');
----
3

# ============================================================================
# 2. Buffered DELETE (slice 2): visible mid-txn, one commit, rollback undoes
# ============================================================================

statement ok
BEGIN;

statement ok
DELETE FROM lake.main.t WHERE id IN (2, 4);

# The deleted rows disappear mid-transaction (read-your-writes over the pending deletion vector)...
query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
1	pre
3	b3
5	c

# ...aggregates and filters compose over the exclusion...
query I
SELECT count(*) FROM lake.main.t WHERE id >= 1;
----
3

statement ok
ROLLBACK;

# ...and ROLLBACK brings them back (nothing was committed).
query I
SELECT count(*) FROM lake.main.t;
----
5

query I
SELECT count(*) FROM arrownet_delta_snapshots('lake', 't');
----
3

# Now the committing case: DELETE + a second DELETE in the same transaction compose.
statement ok
BEGIN;

statement ok
DELETE FROM lake.main.t WHERE id = 2;

statement ok
DELETE FROM lake.main.t WHERE id = 4;

query I
SELECT count(*) FROM lake.main.t;
----
3

statement ok
COMMIT;

query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
1	pre
3	b3
5	c

# Exactly ONE new Delta commit for both DELETEs, with operation DELETE.
query I
SELECT count(*) FROM arrownet_delta_snapshots('lake', 't');
----
4

query T
SELECT operation FROM arrownet_delta_snapshots('lake', 't') ORDER BY version DESC LIMIT 1;
----
DELETE

# ============================================================================
# 3. Buffered UPDATE (slice 2): post-image visible mid-txn, one UPDATE commit
# ============================================================================

statement ok
BEGIN;

statement ok
UPDATE lake.main.t SET name = 'updated' WHERE id = 3;

# The post-image is visible mid-transaction; the old row is gone.
query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
1	pre
3	updated
5	c

# Expression UPDATE composes on top (of a committed row).
statement ok
UPDATE lake.main.t SET id = id + 100 WHERE id = 5;

query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
1	pre
3	updated
105	c

statement ok
COMMIT;

query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
1	pre
3	updated
105	c

# One commit for both UPDATEs, operation UPDATE.
query I
SELECT count(*) FROM arrownet_delta_snapshots('lake', 't');
----
5

query T
SELECT operation FROM arrownet_delta_snapshots('lake', 't') ORDER BY version DESC LIMIT 1;
----
UPDATE

# UPDATE + ROLLBACK restores the pre-image.
statement ok
BEGIN;

statement ok
UPDATE lake.main.t SET name = 'doomed' WHERE id = 1;

query T
SELECT name FROM lake.main.t WHERE id = 1;
----
doomed

statement ok
ROLLBACK;

query T
SELECT name FROM lake.main.t WHERE id = 1;
----
pre

# ============================================================================
# 4. Mixed INSERT + DELETE + UPDATE in ONE transaction = ONE fused commit
# ============================================================================

query I
SELECT count(*) FROM arrownet_delta_snapshots('lake', 't');
----
5

statement ok
BEGIN;

statement ok
INSERT INTO lake.main.t VALUES (7, 'ins');

statement ok
DELETE FROM lake.main.t WHERE id = 105;

statement ok
UPDATE lake.main.t SET name = 'mix' WHERE id = 3;

# Composition mid-transaction: insert visible, delete applied, update applied.
query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
1	pre
3	mix
7	ins

statement ok
COMMIT;

query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
1	pre
3	mix
7	ins

# ONE commit for all three statements, operation TRANSACTION (mixed kinds).
query I
SELECT count(*) FROM arrownet_delta_snapshots('lake', 't');
----
6

query T
SELECT operation FROM arrownet_delta_snapshots('lake', 't') ORDER BY version DESC LIMIT 1;
----
TRANSACTION

# ============================================================================
# 5. Guards: DDL/maintenance with pending changes; DML on same-txn inserts
# ============================================================================

statement ok
BEGIN;

statement ok
INSERT INTO lake.main.t VALUES (8, 'pending');

statement error
ALTER TABLE lake.main.t ADD COLUMN extra INTEGER;
----
after buffered data changes

statement ok
ROLLBACK;

statement ok
BEGIN;

statement ok
DELETE FROM lake.main.t WHERE id = 7;

statement error
DROP TABLE lake.main.t;
----
uncommitted buffered changes

statement ok
ROLLBACK;

# DELETE of a row inserted in the SAME transaction now WORKS (C3 lift — the pending file's add is
# born with an inline DV; full coverage in section 37).
statement ok
BEGIN;

statement ok
INSERT INTO lake.main.t VALUES (9, 'fresh');

statement ok
DELETE FROM lake.main.t WHERE id = 9;

query I
SELECT count(*) FROM lake.main.t WHERE id = 9;
----
0

statement ok
ROLLBACK;

# UPDATE of a row updated in the SAME transaction (its post-image is a pending row) is rejected too.
statement ok
BEGIN;

statement ok
UPDATE lake.main.t SET name = 'first' WHERE id = 1;

statement error
UPDATE lake.main.t SET name = 'second' WHERE id = 1;
----
inserted in the same transaction

statement ok
ROLLBACK;

query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
1	pre
3	mix
7	ins

# ============================================================================
# 6. Concurrent writers: Spark-style LOGICAL REBASE (WriteSerializable) — a concurrent commit only
#    aborts the transaction when it ACTUALLY conflicts. Blind appends commute (the COMMIT rebases on
#    top of them); a delete/delete on the same file or a concurrent metadata change conflict-aborts.
# ============================================================================

# --- 6a. a concurrent APPEND does NOT abort — the COMMIT rebases and both changes land ---

statement ok con1
BEGIN;

statement ok con1
DELETE FROM lake.main.t WHERE id = 3;

# A second connection commits between con1's pin and its COMMIT (autocommit append).
statement ok con2
INSERT INTO lake.main.t VALUES (50, 'racer');

# con1's COMMIT succeeds: the append commutes with the buffered delete (the DV positions were resolved
# against the PINNED snapshot; the touched file is unchanged in the newer one).
statement ok con1
COMMIT;

# BOTH changes are in: the racer's row present AND con1's delete applied.
query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
1	pre
7	ins
50	racer

# --- 6b. delete/delete on the SAME file is a REAL conflict ---

statement ok con1
BEGIN;

statement ok con1
DELETE FROM lake.main.t WHERE id = 50;

# The racer deletes the SAME row (autocommit DV commit) — the file's deletion vector changes under con1.
statement ok con2
DELETE FROM lake.main.t WHERE id = 50;

statement error con1
COMMIT;
----
transaction conflict

# con2's delete won (first committer); con1 was rolled back.
query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
1	pre
7	ins

statement ok
INSERT INTO lake.main.t VALUES (50, 'racer');

# --- 6c. a concurrent METADATA change (ALTER) is a REAL conflict ---

statement ok con1
BEGIN;

statement ok con1
DELETE FROM lake.main.t WHERE id = 7;

statement ok con2
ALTER TABLE lake.main.t ADD COLUMN extra INTEGER;

statement error con1
COMMIT;
----
transaction conflict

# con1's delete was rolled back; the concurrent column is there.
query I
SELECT count(*) FROM lake.main.t WHERE id = 7;
----
1

statement ok con2
ALTER TABLE lake.main.t DROP COLUMN extra;

# --- 6d. isolation_level 'serializable': a concurrent blind append MATCHING the transaction's read
#     predicate is a REAL conflict (commit order = logical order — the DELETE's WHERE would have seen the
#     appended row). Under the default write_serializable the same append passes (6a). ---

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/txn_codec' AS serlake (TYPE arrownet, PROVIDER 'delta', isolation_level 'serializable');

statement ok con1
BEGIN;

# the DELETE's scan records read predicate id = 1
statement ok con1
DELETE FROM serlake.main.t WHERE id = 1;

# a blind append whose rows MATCH the read predicate (file stats: min=max=1)
statement ok con2
INSERT INTO lake.main.t VALUES (1, 'dup');

statement error con1
COMMIT;
----
transaction conflict

# con1's delete rolled back; the concurrent duplicate landed
query I
SELECT count(*) FROM lake.main.t WHERE id = 1;
----
2

statement ok
DELETE FROM lake.main.t WHERE name = 'dup';

# … and a blind append NOT matching the read predicate rebases fine even under serializable
statement ok con1
BEGIN;

statement ok con1
DELETE FROM serlake.main.t WHERE id = 7;

statement ok con2
INSERT INTO lake.main.t VALUES (900, 'far');

statement ok con1
COMMIT;

query I
SELECT count(*) FROM lake.main.t WHERE id IN (7, 900);
----
1

statement ok
DELETE FROM lake.main.t WHERE id = 900;

statement ok
INSERT INTO lake.main.t VALUES (7, 'ins');

statement ok
DETACH serlake;

# --- 6e. concurrentDeleteRead (both isolation levels): a concurrent delete of a file the transaction
#     READ — here a whole-table read (unpushable predicate) — conflicts even though the transaction
#     modifies a DIFFERENT file. ---

statement ok con1
BEGIN;

# `id % 100 = 50` is not pushable → the scan records a WHOLE-TABLE read; it deletes id=50 only
statement ok con1
DELETE FROM lake.main.t WHERE id % 100 = 50;

# the racer deletes id=1 — a DIFFERENT file, but one con1's whole-table read consumed
statement ok con2
DELETE FROM lake.main.t WHERE id = 1;

statement error con1
COMMIT;
----
transaction conflict

# con1 rolled back (id 50 intact); con2's delete won
query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
7	ins
50	racer

# restore the section-entry state for the sections below
statement ok
INSERT INTO lake.main.t VALUES (1, 'pre');

statement ok
INSERT INTO lake.main.t VALUES (3, 'mix');

query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
1	pre
3	mix
7	ins
50	racer

# --- 6f. SNAPSHOT READS by default: inside an explicit transaction, reads pin to the version resolved
#     at the transaction's FIRST scan (one instant per txn, mapped to a version per table) — a concurrent
#     commit is INVISIBLE mid-transaction, on the codec path too (the native path always pinned). ---

statement ok con1
BEGIN;

# first scan pins the transaction's snapshot
query I con1
SELECT count(*) FROM lake.main.t;
----
4

statement ok con2
INSERT INTO lake.main.t VALUES (600, 'invisible');

# repeatable read: the concurrent insert is NOT visible (was: reads floated to latest)
query I con1
SELECT count(*) FROM lake.main.t;
----
4

query I con1
SELECT count(*) FROM lake.main.t WHERE id = 600;
----
0

statement ok con1
COMMIT;

# after COMMIT a fresh statement sees it
query I
SELECT count(*) FROM lake.main.t WHERE id = 600;
----
1

statement ok
DELETE FROM lake.main.t WHERE id = 600;

# ============================================================================
# 7. Guards: DV-off and CDF tables reject buffered DML (autocommit works)
# ============================================================================

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/txn_cow' AS cowlake (TYPE arrownet, PROVIDER 'delta', deletion_vectors false);

statement ok
CREATE TABLE cowlake.main.c AS SELECT 1 AS i UNION ALL SELECT 2;

statement ok
BEGIN;

statement error
DELETE FROM cowlake.main.c WHERE i = 1;
----
requires deletion vectors

statement ok
ROLLBACK;

# Autocommit DELETE on the same table works (direct copy-on-write path, unchanged).
statement ok
DELETE FROM cowlake.main.c WHERE i = 1;

query I
SELECT count(*) FROM cowlake.main.c;
----
1

statement ok
DETACH cowlake;

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/txn_cdf' AS cdflake (TYPE arrownet, PROVIDER 'delta', change_data_feed true);

statement ok
CREATE TABLE cdflake.main.f AS SELECT 1 AS i UNION ALL SELECT 2;

# slice C2: buffered DML on a CDF table now WORKS — the _change_data file is written eagerly at
# statement time and its cdc action fuses into the transaction's one commit.
statement ok
BEGIN;

statement ok
DELETE FROM cdflake.main.f WHERE i = 1;

# the cdc file is on storage before COMMIT, the log unmoved
query I
SELECT count(*) FROM glob('${ARROWNET_DELTA_WRITE_DIR}/txn_cdf/f/_change_data/*.parquet');
----
1

query I
SELECT count(*) FROM glob('${ARROWNET_DELTA_WRITE_DIR}/txn_cdf/f/_delta_log/*.json');
----
2

statement ok
ROLLBACK;

# rollback: the cdc file stays as an invisible orphan; the feed is untouched
query I
SELECT count(*) FROM cdflake.main.f;
----
2

query I
SELECT count(*) FROM glob('${ARROWNET_DELTA_WRITE_DIR}/txn_cdf/f/_delta_log/*.json');
----
2

# Autocommit DELETE keeps full CDF capture (direct path).
statement ok
DELETE FROM cdflake.main.f WHERE i = 1;

query I
SELECT count(*) FROM cdflake.main.f;
----
1

statement ok
DETACH cdflake;

# ============================================================================
# 8. Multi-table transaction = one commit PER TABLE (appends)
# ============================================================================

statement ok
CREATE TABLE lake.main.u (v INTEGER);

statement ok
BEGIN;

statement ok
INSERT INTO lake.main.t VALUES (60, 'multi');

statement ok
INSERT INTO lake.main.u VALUES (10), (20);

query I
SELECT (SELECT count(*) FROM lake.main.t) + (SELECT count(*) FROM lake.main.u);
----
7

statement ok
COMMIT;

query I
SELECT count(*) FROM lake.main.t;
----
5

query I
SELECT sum(v) FROM lake.main.u;
----
30

# ============================================================================
# 9. Explicit AT time travel excludes pending; re-attach durability
# ============================================================================

statement ok
BEGIN;

statement ok
INSERT INTO lake.main.u VALUES (30);

query I
SELECT count(*) FROM lake.main.u;
----
3

query I
SELECT count(*) FROM lake.main.u AT (VERSION => 1);
----
2

statement ok
ROLLBACK;

statement ok
DETACH lake;

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/txn_codec' AS lake (TYPE arrownet, PROVIDER 'delta');

query I
SELECT count(*) FROM lake.main.u;
----
2

query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
1	pre
3	mix
7	ins
50	racer
60	multi

statement ok
DETACH lake;

# ============================================================================
# 10. native_write catalog: streamed files + buffered DML fuse at COMMIT
# ============================================================================

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/txn_native' AS nlake (TYPE arrownet, PROVIDER 'delta', native_write true);

statement ok
CREATE TABLE nlake.main.nt (id INTEGER, grp VARCHAR);

statement ok
INSERT INTO nlake.main.nt SELECT i, 'g' || (i % 3) FROM range(1, 11) AS r(i);

statement ok
BEGIN;

statement ok
INSERT INTO nlake.main.nt SELECT i, 'h' || (i % 3) FROM range(100, 1100) AS r(i);

statement ok
DELETE FROM nlake.main.nt WHERE id <= 3;

query I
SELECT count(*) FROM nlake.main.nt;
----
1007

query I
SELECT min(id) FROM nlake.main.nt;
----
4

statement ok
UPDATE nlake.main.nt SET grp = 'upd' WHERE id = 5;

query T
SELECT grp FROM nlake.main.nt WHERE id = 5;
----
upd

statement ok
COMMIT;

query I
SELECT count(*) FROM nlake.main.nt;
----
1007

query T
SELECT grp FROM nlake.main.nt WHERE id = 5;
----
upd

# CREATE (v0) + seed INSERT (v1) + ONE fused transaction commit (v2).
query I
SELECT count(*) FROM arrownet_delta_snapshots('nlake', 'nt');
----
3

# ROLLBACK on the streamed path: files written but never committed.
statement ok
BEGIN;

statement ok
INSERT INTO nlake.main.nt VALUES (9999, 'doomed');

statement ok
DELETE FROM nlake.main.nt WHERE id = 4;

query I
SELECT count(*) FROM nlake.main.nt;
----
1007

statement ok
ROLLBACK;

query I
SELECT count(*) FROM nlake.main.nt;
----
1007

query I
SELECT min(id) FROM nlake.main.nt;
----
4

statement ok
DETACH nlake;

# ============================================================================
# 11. native_read catalog: buffered DML read-your-writes on the native scan
# ============================================================================

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/txn_nread' AS rlake (TYPE arrownet, PROVIDER 'delta', native_write true, native_read true);

statement ok
CREATE TABLE rlake.main.rt (id INTEGER, name VARCHAR);

statement ok
INSERT INTO rlake.main.rt VALUES (1, 'a'), (2, 'b'), (3, 'c');

statement ok
BEGIN;

statement ok
INSERT INTO rlake.main.rt VALUES (4, 'pending');

statement ok
DELETE FROM rlake.main.rt WHERE id = 2;

# Native per-file scan: pending file included, pending-deleted row excluded.
query IT
SELECT id, name FROM rlake.main.rt ORDER BY id;
----
1	a
3	c
4	pending

statement ok
UPDATE rlake.main.rt SET name = 'upd' WHERE id = 3;

query IT
SELECT id, name FROM rlake.main.rt ORDER BY id;
----
1	a
3	upd
4	pending

statement ok
COMMIT;

query IT
SELECT id, name FROM rlake.main.rt ORDER BY id;
----
1	a
3	upd
4	pending

# CREATE + seed + one fused commit.
query I
SELECT count(*) FROM arrownet_delta_snapshots('rlake', 'rt');
----
3

statement ok
DETACH rlake;

# ============================================================================
# 12. Autocommit is unchanged: one statement = one commit, direct DML paths
# ============================================================================

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/txn_codec' AS alake (TYPE arrownet, PROVIDER 'delta');

query I
SELECT count(*) FROM arrownet_delta_snapshots('alake', 'u');
----
2

statement ok
INSERT INTO alake.main.u VALUES (40);

query I
SELECT count(*) FROM arrownet_delta_snapshots('alake', 'u');
----
3

# Autocommit DELETE goes through the direct deletion-vector path — one DELETE version.
statement ok
DELETE FROM alake.main.u WHERE v = 10;

query I
SELECT count(*) FROM arrownet_delta_snapshots('alake', 'u');
----
4

query T
SELECT operation FROM arrownet_delta_snapshots('alake', 'u') ORDER BY version DESC LIMIT 1;
----
DELETE

query I
SELECT sum(v) FROM alake.main.u;
----
60

statement ok
DETACH alake;

# ============================================================================
# 13. Buffered ALTER ADD COLUMN (slice 3): ALTER + DML in ONE atomic commit
# ============================================================================

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/txn_codec' AS dlake (TYPE arrownet, PROVIDER 'delta');

statement ok
CREATE TABLE dlake.main.a (id INTEGER, name VARCHAR);

statement ok
INSERT INTO dlake.main.a VALUES (1, 'x'), (2, 'y');

query I
SELECT count(*) FROM arrownet_delta_snapshots('dlake', 'a');
----
2

statement ok
BEGIN;

statement ok
ALTER TABLE dlake.main.a ADD COLUMN extra INTEGER;

# The pending column is visible mid-transaction — existing rows read NULL.
query I
SELECT count(*) FROM dlake.main.a WHERE extra IS NULL;
----
2

statement ok
INSERT INTO dlake.main.a VALUES (3, 'z', 42);

query ITI
SELECT id, name, extra FROM dlake.main.a ORDER BY id;
----
1	x	NULL
2	y	NULL
3	z	42

# DML composes on top of the pending schema change.
statement ok
DELETE FROM dlake.main.a WHERE id = 1;

query ITI
SELECT id, name, extra FROM dlake.main.a ORDER BY id;
----
2	y	NULL
3	z	42

statement ok
COMMIT;

query ITI
SELECT id, name, extra FROM dlake.main.a ORDER BY id;
----
2	y	NULL
3	z	42

# ALTER + INSERT + DELETE all landed as ONE Delta commit (metaData + add + DV actions).
query I
SELECT count(*) FROM arrownet_delta_snapshots('dlake', 'a');
----
3

query T
SELECT operation FROM arrownet_delta_snapshots('dlake', 'a') ORDER BY version DESC LIMIT 1;
----
TRANSACTION

# ============================================================================
# 14. ROLLBACK undoes the buffered ALTER (column + data gone, no version)
# ============================================================================

statement ok
BEGIN;

statement ok
ALTER TABLE dlake.main.a ADD COLUMN doomed VARCHAR;

statement ok
INSERT INTO dlake.main.a VALUES (4, 'w', 7, 'gone');

query I
SELECT count(*) FROM dlake.main.a WHERE doomed IS NOT NULL;
----
1

statement ok
ROLLBACK;

# The column no longer exists...
statement error
SELECT doomed FROM dlake.main.a;
----
doomed

# ...the row is gone, and no Delta version was written.
query I
SELECT count(*) FROM dlake.main.a;
----
2

query I
SELECT count(*) FROM arrownet_delta_snapshots('dlake', 'a');
----
3

# ============================================================================
# 15. Chained ADD COLUMNs (the dbt append_new_columns shape) + UPDATE on the new column
# ============================================================================

statement ok
BEGIN;

statement ok
ALTER TABLE dlake.main.a ADD COLUMN c1 INTEGER;

statement ok
ALTER TABLE dlake.main.a ADD COLUMN c2 VARCHAR;

statement ok
INSERT INTO dlake.main.a (id, name, c1, c2) VALUES (5, 'v', 1, 'one');

# UPDATE can SET a column added in the SAME transaction (on a committed row).
statement ok
UPDATE dlake.main.a SET c1 = 99 WHERE id = 2;

query IIT
SELECT id, c1, c2 FROM dlake.main.a ORDER BY id;
----
2	99	NULL
3	NULL	NULL
5	1	one

statement ok
COMMIT;

query IIT
SELECT id, c1, c2 FROM dlake.main.a ORDER BY id;
----
2	99	NULL
3	NULL	NULL
5	1	one

# Still ONE commit for both ALTERs + INSERT + UPDATE.
query I
SELECT count(*) FROM arrownet_delta_snapshots('dlake', 'a');
----
4

# ============================================================================
# 16. Guards + status quo: ALTER after data changes; other kinds stay immediate
# ============================================================================

statement ok
BEGIN;

statement ok
INSERT INTO dlake.main.a VALUES (6, 'u', NULL, NULL, NULL);

statement error
ALTER TABLE dlake.main.a ADD COLUMN late INTEGER;
----
after buffered data changes

statement ok
ROLLBACK;

# RENAME COLUMN is transactional too (3b): ROLLBACK undoes it.
statement ok
BEGIN;

statement ok
ALTER TABLE dlake.main.a RENAME COLUMN name TO label;

query T
SELECT label FROM dlake.main.a WHERE id = 2;
----
y

statement ok
ROLLBACK;

statement error
SELECT label FROM dlake.main.a;
----
label

query T
SELECT name FROM dlake.main.a WHERE id = 2;
----
y

# Autocommit ALTER is unchanged (immediate commit).
statement ok
ALTER TABLE dlake.main.a ADD COLUMN auto1 INTEGER;

query I
SELECT count(*) FROM dlake.main.a WHERE auto1 IS NULL;
----
3

statement ok
DETACH dlake;

# ============================================================================
# 17. Buffered ALTER on the native paths (native_write collect + native_read scan)
# ============================================================================

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/txn_nread' AS xlake (TYPE arrownet, PROVIDER 'delta', native_write true, native_read true);

statement ok
