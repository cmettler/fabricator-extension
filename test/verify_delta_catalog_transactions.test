# ============================================================================
# 31. Eager-write slice B (native_write): CTAS-in-transaction STREAMS its data
#     to storage at statement time — no _delta_log until COMMIT
# ============================================================================

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/txn_native' AS eb (TYPE arrownet, PROVIDER 'delta', native_write true);

statement ok
BEGIN;

