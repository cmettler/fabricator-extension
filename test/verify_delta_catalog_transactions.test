SELECT count(*) FROM arrownet_delta_snapshots('elake', 'r');
----
3

query T
SELECT operation FROM arrownet_delta_snapshots('elake', 'r') ORDER BY version DESC LIMIT 1;
----
TRANSACTION

# ROLLBACK undoes a buffered rename.
statement ok
BEGIN;

statement ok
