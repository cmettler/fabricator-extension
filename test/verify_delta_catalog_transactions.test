# 21. Buffered NESTED field ALTERs (3c): ADD/DROP FIELD + INSERT in one commit
# ============================================================================

statement ok
CREATE TABLE elake.main.n (id INTEGER, s STRUCT(a INTEGER, b VARCHAR));

statement ok
INSERT INTO elake.main.n VALUES (1, {'a': 10, 'b': 'x'});

statement ok
BEGIN;

statement ok
