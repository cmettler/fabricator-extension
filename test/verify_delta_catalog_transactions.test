DETACH xlake;

# ============================================================================
# 18. Buffered RENAME COLUMN (3b): data reads under the new name mid-txn
# ============================================================================

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/txn_codec' AS elake (TYPE arrownet, PROVIDER 'delta');

statement ok
CREATE TABLE elake.main.r (id INTEGER, val VARCHAR);

statement ok
INSERT INTO elake.main.r VALUES (1, 'a'), (2, 'b');

statement ok
BEGIN;

statement ok
