# name: test/verify_plugin.test
# description: Third-party plugin SPI (no ALC isolation) — a plugin assembly dropped into an FABRICATOR_PLUGIN_DIR
#              folder is discovered at load, its IBackend registered, and its connection-free GLOBAL functions
#              surfaced as bare fn(...) with NO ATTACH. Demo plugin: Fabricator.SamplePlugin's plug_greet.
#              Set FABRICATOR_PLUGIN_DIR to the folder the sample plugin was built into. See docs/plugin-system.md.
# group: [fabricator]

require fabricator

require-env FABRICATOR_PLUGIN_DIR

# The plugin's global scalar resolves on a bare loaded extension — no ATTACH, no first-party involvement.
query I
SELECT plug_greet('world');
----
Hello, world (from plugin)

# Vectorized over a batch, incl. a NULL (the plugin's Invoke sees it).
query I
SELECT plug_greet(n) AS r FROM (VALUES ('Ann'), ('Bob'), (NULL)) v(n) ORDER BY r;
----
Hello, Ann (from plugin)
Hello, Bob (from plugin)
Hello, stranger (from plugin)

# A built-in global function still works alongside the plugin's (both in the same registry, no conflict).
query I
SELECT fabricator_render('Hi {{ name }}', {'name':'plugin'});
----
Hi plugin

# ---- plugin-declared MACROs (docs/macros-and-sqlgen-functions.md §1) ----
# A plugin ships SQL templates the same way it ships functions: declare CREATE MACRO statements, the host
# parses + registers them at load. No bridge or ABI involvement.

query I
SELECT plug_double(21);
----
42

query II
SELECT DISTINCT function_name, function_type FROM duckdb_functions() WHERE function_name = 'plug_double';
----
plug_double	macro

# The plugin ALSO declares a deliberately MALFORMED macro (plug_bad_macro): it is skipped with a warning at
# load and blocks nothing — its sibling macro above and the plugin's scalar below both work. (The warning
# itself only reaches duckdb_logs when logging was enabled BEFORE the extension loaded — i.e. the LOAD
# path, not this statically-linked binary; verify it there.)
query I
SELECT count(*) FROM duckdb_functions() WHERE function_name = 'plug_bad_macro';
----
0

query I
SELECT plug_greet('after');
----
Hello, after (from plugin)

# ---- fabricator_plugins(): the scan is no longer silent ----
# Every candidate the scan looked at gets a row with a STATUS and a REASON. This is the gate on the property
# the plugin system most needed and did not have: ScanPluginDirectories ends each candidate in a catch, so a
# plugin built against a different Apache.Arrow major, or missing a private dependency, used to be skipped
# with NO signal — indistinguishable from "it loaded and registered nothing". That distinction is what an
# installer makes load-bearing, because "install succeeded, nothing happened" becomes the normal failure.

# The configured root was searched, and it reports how many candidates it saw.
query I
SELECT count(*) FROM fabricator_plugins() WHERE status = 'root';
----
1

# ⚠ THE LOAD-BEARING ASSERTION: the sample plugin is reported as LOADED, with the provider it registered.
# Its scalar working (above) proves the plugin loaded; only this proves the SCAN can SAY SO — a report that
# silently recorded nothing would leave every assertion above it passing.
query II
SELECT status, provider FROM fabricator_plugins() WHERE provider = 'sampleplugin';
----
loaded	sampleplugin

# Every row carries a non-empty reason. A status with no detail is the failure this table exists to prevent
# — it would answer "what happened" and not "why".
query I
SELECT count(*) FROM fabricator_plugins() WHERE detail = '';
----
0

# Only known statuses. Pins the vocabulary (PluginScanStatus) so a new state cannot appear unnamed.
query I
SELECT count(*) FROM fabricator_plugins()
WHERE status NOT IN ('root', 'root_missing', 'loaded', 'no_backend', 'shared', 'rejected');
----
0

# Internal consistency: every candidate's path sits UNDER the root it was attributed to. Absoluteness itself
# is pinned offline (PluginPathsTests.Override_paths_are_absolute) — asserting it again through LIKE patterns
# would be a fragile restatement; this instead pins something only the live scan can get wrong, namely
# attributing a file to the wrong root once several roots are configured.
query I
SELECT count(*) FROM fabricator_plugins() WHERE path <> '' AND position(root in path) <> 1;
----
0

# The shared set is REPORTED, not hidden: the bridge's own assemblies sitting in a plugin folder are skipped
# deliberately (reflecting a plugin-dir copy of Fabricator.Bridge would re-register its StubBackend), and a
# deliberate skip must be visible or it reads as a plugin that failed. 0 is legitimate here — the sample
# plugin folder need not contain any — so this asserts the SHAPE holds whenever such rows exist.
query I
SELECT count(*) FROM fabricator_plugins() WHERE status = 'shared' AND (path = '' OR detail = '');
----
0

# ============================================================================
# plug_sleep — the plugin's TEST INSTRUMENT, not a feature. It blocks its worker thread once PER ROW, which
# is what lets a test make a query's cost a number the test chose (docs/scan-concurrency.md §6 uses it to
# turn effective parallelism into arithmetic: rows x millis / wall clock).
# ============================================================================

# The trivial contract: it returns what it slept, and a NULL row sleeps not at all.
query II
SELECT plug_sleep(0), plug_sleep(NULL);
----
0	NULL

# ⚠ A NEGATIVE IS REFUSED, and this is the load-bearing assertion of the section. Thread.Sleep(-1) is
# Timeout.Infinite, so the alternative to refusing is a suite that HANGS — the one failure mode worse than a
# wrong answer here. Clamping to zero would be worse still: it would hide the caller's arithmetic bug.
statement error
SELECT plug_sleep(-1);
----
millis must be >= 0

# ⚠ THE SIDE EFFECT REALLY HAPPENS PER ROW, which is the property the whole instrument rests on: a scalar
# declared CONSISTENT would be FOLDED to a literal at plan time over a constant argument, sleep ONCE during
# binding, and every parallelism number built on it would be confidently wrong while looking healthy.
# Asserted as a LOWER BOUND on elapsed time (20 rows x 60 ms = 1.2 s of work, single-threaded), because a
# lower bound can only be broken by the sleep NOT happening — a loaded machine makes it more true, not less.
statement ok
SET threads=1;

statement ok
CREATE TEMP TABLE plug_sleep_t0 AS SELECT epoch_ms(now()) AS ms;

# ⚠ sum(), not count(): DuckDB PRUNES a projected column no aggregate consumes, so `count(*)` over this would
# evaluate plug_sleep ZERO times and the section would pass with the instrument entirely broken.
query I
SELECT sum(plug_sleep(60)) FROM range(20);
----
1200

query I
SELECT (epoch_ms(now()) - (SELECT ms FROM plug_sleep_t0)) >= 1000;
----
true

statement ok
RESET threads;
