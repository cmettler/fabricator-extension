# name: test/verify_plugin.test
# description: Third-party plugin SPI (no ALC isolation) — a plugin assembly dropped into an FABRICATOR_PLUGIN_DIR
#              folder is discovered at load, its IProvider registered, and its connection-free GLOBAL functions
#              surfaced as bare fn(...) with NO ATTACH. Demo plugin: Fabricator.SamplePlugin's plug_greet.
#              Set FABRICATOR_PLUGIN_DIR to the folder the sample plugin was built into. See docs/plugin-system.md.
# group: [fabricator]

require fabricator

# ⚠ For the parallel-write section at the end, which writes a real Delta table: the data files are written by
# DuckDB's own COPY, and the sqllogictest runner does NOT auto-load a statically linked extension the way the
# shell does — so without this the write fails with "Copy Function with name \"parquet\" is not in the
# catalog". Measured, not anticipated: that is exactly how this suite failed the first time.
require parquet

require-env FABRICATOR_PLUGIN_DIR

require-env FABRICATOR_DELTA_WRITE_DIR

# The plugin's global scalar resolves on a bare loaded extension — no ATTACH, no first-party involvement.
query I
SELECT plug_greet('world');
----
Hello, world (from plugin)

# Vectorized over a batch, incl. a NULL (the plugin's Invoke sees it).
query I
SELECT plug_greet(n) AS r FROM (VALUES ('Ann'), ('Bob'), (NULL)) v(n) ORDER BY r;
----
Hello, Ann (from plugin)
Hello, Bob (from plugin)
Hello, stranger (from plugin)

# A built-in global function still works alongside the plugin's (both in the same registry, no conflict).
# ⚠ It used to be fluid_render here, which stopped meaning anything the day render itself became a
# plugin: the assertion is that a FIRST-PARTY global coexists with a plugin's, so it needs a first-party one.
query I
SELECT fabricator_va_concat('-', 'a', 'b');
----
a-b

# ---- plugin-declared MACROs (docs/macros-and-sqlgen-functions.md §1) ----
# A plugin ships SQL templates the same way it ships functions: declare CREATE MACRO statements, the host
# parses + registers them at load. No bridge or ABI involvement.

query I
SELECT plug_double(21);
----
42

query II
SELECT DISTINCT function_name, function_type FROM duckdb_functions() WHERE function_name = 'plug_double';
----
plug_double	macro

# The plugin ALSO declares a deliberately MALFORMED macro (plug_bad_macro): it is skipped with a warning at
# load and blocks nothing — its sibling macro above and the plugin's scalar below both work. (The warning
# itself only reaches duckdb_logs when logging was enabled BEFORE the extension loaded — i.e. the LOAD
# path, not this statically-linked binary; verify it there.)
query I
SELECT count(*) FROM duckdb_functions() WHERE function_name = 'plug_bad_macro';
----
0

query I
SELECT plug_greet('after');
----
Hello, after (from plugin)

# ---- fabricator_plugins(): the scan is no longer silent ----
# Every candidate the scan looked at gets a row with a STATUS and a REASON. This is the gate on the property
# the plugin system most needed and did not have: ScanPluginDirectories ends each candidate in a catch, so a
# plugin built against a different Apache.Arrow major, or missing a private dependency, used to be skipped
# with NO signal — indistinguishable from "it loaded and registered nothing". That distinction is what an
# installer makes load-bearing, because "install succeeded, nothing happened" becomes the normal failure.

# The configured root was searched, and it reports how many candidates it saw.
query I
SELECT count(*) FROM fabricator_plugins() WHERE status = 'root';
----
1

# ⚠ THE LOAD-BEARING ASSERTION: the sample plugin is reported as LOADED, with the provider it registered.
# Its scalar working (above) proves the plugin loaded; only this proves the SCAN can SAY SO — a report that
# silently recorded nothing would leave every assertion above it passing.
query II
SELECT status, provider FROM fabricator_plugins() WHERE provider = 'sampleplugin';
----
loaded	sampleplugin

# Every row carries a non-empty reason. A status with no detail is the failure this table exists to prevent
# — it would answer "what happened" and not "why".
query I
SELECT count(*) FROM fabricator_plugins() WHERE detail = '';
----
0

# Only known statuses. Pins the vocabulary (PluginScanStatus) so a new state cannot appear unnamed.
query I
SELECT count(*) FROM fabricator_plugins()
WHERE status NOT IN ('root', 'root_missing', 'loaded', 'no_backend', 'shared', 'rejected');
----
0

# Internal consistency: every candidate's path sits UNDER the root it was attributed to. Absoluteness itself
# is pinned offline (PluginPathsTests.Override_paths_are_absolute) — asserting it again through LIKE patterns
# would be a fragile restatement; this instead pins something only the live scan can get wrong, namely
# attributing a file to the wrong root once several roots are configured.
query I
SELECT count(*) FROM fabricator_plugins() WHERE path <> '' AND position(root in path) <> 1;
----
0

# The shared set is REPORTED, not hidden: the bridge's own assemblies sitting in a plugin folder are skipped
# deliberately (reflecting a plugin-dir copy of Fabricator.Bridge would re-register its StubBackend), and a
# deliberate skip must be visible or it reads as a plugin that failed. 0 is legitimate here — the sample
# plugin folder need not contain any — so this asserts the SHAPE holds whenever such rows exist.
query I
SELECT count(*) FROM fabricator_plugins() WHERE status = 'shared' AND (path = '' OR detail = '');
----
0

# ============================================================================
# plug_sleep — the plugin's TEST INSTRUMENT, not a feature. It blocks its worker thread once PER ROW, which
# is what lets a test make a query's cost a number the test chose (docs/scan-concurrency.md §6 uses it to
# turn effective parallelism into arithmetic: rows x millis / wall clock).
# ============================================================================

# The trivial contract: it returns what it slept, and a NULL row sleeps not at all.
query II
SELECT plug_sleep(0), plug_sleep(NULL);
----
0	NULL

# ⚠ A NEGATIVE IS REFUSED, and this is the load-bearing assertion of the section. Thread.Sleep(-1) is
# Timeout.Infinite, so the alternative to refusing is a suite that HANGS — the one failure mode worse than a
# wrong answer here. Clamping to zero would be worse still: it would hide the caller's arithmetic bug.
statement error
SELECT plug_sleep(-1);
----
millis must be >= 0

# ⚠ THE SIDE EFFECT REALLY HAPPENS PER ROW, which is the property the whole instrument rests on: a scalar
# declared CONSISTENT would be FOLDED to a literal at plan time over a constant argument, sleep ONCE during
# binding, and every parallelism number built on it would be confidently wrong while looking healthy.
# Asserted as a LOWER BOUND on elapsed time (20 rows x 60 ms = 1.2 s of work, single-threaded), because a
# lower bound can only be broken by the sleep NOT happening — a loaded machine makes it more true, not less.
statement ok
SET threads=1;

statement ok
CREATE TEMP TABLE plug_sleep_t0 AS SELECT epoch_ms(now()) AS ms;

# ⚠ sum(), not count(): DuckDB PRUNES a projected column no aggregate consumes, so `count(*)` over this would
# evaluate plug_sleep ZERO times and the section would pass with the instrument entirely broken.
query I
SELECT sum(plug_sleep(60)) FROM range(20);
----
1200

query I
SELECT (epoch_ms(now()) - (SELECT ms FROM plug_sleep_t0)) >= 1000;
----
true

statement ok
RESET threads;

# ============================================================================
# plug_slow_range(rows, millis) — the SOURCE-side twin of plug_sleep. It yields 2048-row batches and sleeps
# per BATCH, so its cost lands inside get_next, on the other side of the scan boundary. The pair is what
# makes docs/scan-concurrency.md §1 measurable: cost in the projection scales with threads, cost in the
# source does NOT, because the host pulls every batch under one mutex. Also the first TABLE function a
# plugin contributes here, so it pins that a plugin reaches ITableFunction and not just IScalarFunction.
# ============================================================================

query I
SELECT function_type FROM duckdb_functions() WHERE function_name = 'plug_slow_range';
----
table

query III
SELECT count(*), min(id), max(id) FROM plug_slow_range(8, 0);
----
8	0	7

# ⚠ MORE THAN ONE BATCH, deliberately: the yield loop is per 2048 rows, so a single-batch test would not
# distinguish a working loop from one that emits its first batch and stops. 5000 crosses two boundaries.
query III
SELECT count(*), count(DISTINCT id), sum(id) FROM plug_slow_range(5000, 0);
----
5000	5000	12497500

query I
SELECT count(*) FROM plug_slow_range(0, 0);
----
0

# Refused, not clamped — same reasoning as plug_sleep's negative: Thread.Sleep(-1) never returns.
statement error
SELECT count(*) FROM plug_slow_range(-1, 0);
----
must both be >= 0

statement error
SELECT count(*) FROM plug_slow_range(8, -5);
----
must both be >= 0

# The sleep really happens in the source: 4096 rows = 2 batches x 300 ms. A LOWER BOUND again, so a loaded
# machine can only make it more true; only the sleep NOT happening can break it.
statement ok
CREATE TEMP TABLE plug_range_t0 AS SELECT epoch_ms(now()) AS ms;

query I
SELECT count(*) FROM plug_slow_range(4096, 300);
----
4096

query I
SELECT (epoch_ms(now()) - (SELECT ms FROM plug_range_t0)) >= 500;
----
true

# ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# THE UNION OVERLAPS — a scan whose PULL blocks no longer occupies every worker.
# docs/scan-concurrency.md §5f. This is the gate for the PRODUCTION path (ArrowStreamScan, which every
# fabricator scan on every provider goes through); `verify_wait`'s async_wait section gates the mechanism
# hermetically, in pure C++, with no managed code in it at all.
#
# ⚠ THE A/B LEVER IS DuckDB's OWN DEBUG SETTING, and that is what makes this a same-binary comparison rather
# than a remembered number: under SYNCHRONOUS a table function may not return BLOCKED (PhysicalTableScan's
# ValidateAsyncStrategyResult throws on it), so our scan falls back to parking on the pull lock — i.e. exactly
# the pre-fix code path. Measured on the box this was written on, three runs each, +/- 0.01: 2.06 s vs 1.03 s.
#
# ⚠ TWO different functions on purpose. `plug_slow_range ∪ plug_slow_range2` is what refuted the intermediate
# reading that "two calls of the SAME function serialize" (§5c) — with one function it would still be true and
# would prove less.

statement ok
SET threads=4;

statement ok
CREATE TEMP TABLE plug_u0 AS SELECT epoch_ms(now()) AS ms;

# 4096 rows = 2 batches x 500 ms = 1000 ms per branch, all of it INSIDE the pull.
statement ok
SET debug_physical_table_scan_execution_strategy='SYNCHRONOUS';

query I
SELECT sum(id) FROM (SELECT * FROM plug_slow_range(4096, 500) UNION ALL SELECT * FROM plug_slow_range2(4096, 500));
----
16773120

statement ok
CREATE TEMP TABLE plug_u1 AS SELECT epoch_ms(now()) AS ms;

statement ok
SET debug_physical_table_scan_execution_strategy='DEFAULT';

query I
SELECT sum(id) FROM (SELECT * FROM plug_slow_range(4096, 500) UNION ALL SELECT * FROM plug_slow_range2(4096, 500));
----
16773120

statement ok
CREATE TEMP TABLE plug_u2 AS SELECT epoch_ms(now()) AS ms;

# POSITIVE CONTROL, load-bearing: the serial leg really slept. Without it the ratio below would pass equally
# on a build where the sleeps had stopped happening.
query I
SELECT ((SELECT ms FROM plug_u1) - (SELECT ms FROM plug_u0)) >= 1500;
----
true

# THE CLAIM: the branches overlap, so the union costs about ONE of them. True ratio ~0.50, asserted at 0.80.
query I
SELECT ((SELECT ms FROM plug_u2) - (SELECT ms FROM plug_u1))
     < ((SELECT ms FROM plug_u1) - (SELECT ms FROM plug_u0)) * 0.8;
----
true

statement ok
RESET threads;

# ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# A WRITE INTO A FABRICATOR TABLE SCALES WITH `SET threads`. docs/scan-concurrency.md §7c.
#
# Until the write sinks declared ParallelSink() true, `Pipeline::ScheduleParallel` fell through to
# ScheduleSequentialTask before it ever looked at the source or MaxThreads(), so the ENTIRE pipeline — scan,
# projection, sink — ran on one task and a write was flat in `SET threads` (measured: 2919/2952 ms at 1 vs 4
# threads, against 2730 -> 1227 ms for the same work streaming to the client).
#
# ⚠ `SET threads=1` IS THE PRE-CHANGE LEG, and that is what makes this a same-binary A/B rather than a
# remembered number: FabricatorParallelWrite returns false at one thread, so leg A takes exactly the old code
# path. There is no debug setting for a sink the way there is for a scan (§5f), so this is the only lever.
#
# ⚠ THE COST MUST SIT IN THE PROJECTION, ONCE PER MORSEL, AND THE SOURCE MUST BE A FABRICATOR TABLE. A per-ROW
# sleep is impractical (a morsel is 2048 rows) and `range()` is a single-threaded source (§6), which would cap
# the pipeline at one task whatever the sink declares — either mistake makes the section measure nothing while
# passing.

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/plugpw' AS pw (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE pw.main.pw_src AS SELECT i AS id FROM range(8192) t(i);

statement ok
SET threads=1;

statement ok
CREATE TEMP TABLE pw_t0 AS SELECT epoch_ms(now()) AS ms;

# 8192 rows = 4 morsels, one 400 ms sleep each => 1600 ms serial, ~400 ms across four tasks.
statement ok
CREATE OR REPLACE TABLE pw.main.pw_a AS
  SELECT id, plug_sleep(CASE WHEN id % 2048 = 0 THEN 400 ELSE 0 END) AS w FROM pw.main.pw_src;

statement ok
CREATE TEMP TABLE pw_t1 AS SELECT epoch_ms(now()) AS ms;

statement ok
SET threads=4;

statement ok
CREATE OR REPLACE TABLE pw.main.pw_b AS
  SELECT id, plug_sleep(CASE WHEN id % 2048 = 0 THEN 400 ELSE 0 END) AS w FROM pw.main.pw_src;

statement ok
CREATE TEMP TABLE pw_t2 AS SELECT epoch_ms(now()) AS ms;

# POSITIVE CONTROL, load-bearing: the serial leg really slept its four morsels. Without it the ratio below
# would pass equally on a build where plug_sleep had stopped sleeping, or the projection had been pruned away.
query I
SELECT ((SELECT ms FROM pw_t1) - (SELECT ms FROM pw_t0)) >= 1200;
----
true

# THE CLAIM: the four morsels are written by four tasks, so the statement costs about one of them. True ratio
# ~0.3; asserted at 0.7 so only a sink that has stopped being parallel can fail it.
query I
SELECT ((SELECT ms FROM pw_t2) - (SELECT ms FROM pw_t1))
     < ((SELECT ms FROM pw_t1) - (SELECT ms FROM pw_t0)) * 0.7;
----
true

# Both legs wrote every row: the speed claim is worthless if the fast leg dropped a batch.
query IIII
SELECT (SELECT count(*) FROM pw.main.pw_a), (SELECT sum(id) FROM pw.main.pw_a),
       (SELECT count(*) FROM pw.main.pw_b), (SELECT sum(id) FROM pw.main.pw_b);
----
8192	33550336	8192	33550336

# ── and the same for a rowid DELETE, which is a DIFFERENT sink class with its own flag. Worth its own leg
# because the ratio is the LARGEST of the write paths (measured 3.22 -> 1.36 s on 2 M rows): a DELETE's whole
# cost is the scan, the filter and the rowid append, so almost all of it is what the flag unblocks — the
# provider does its work once at Finalize either way.

statement ok
CREATE TABLE pw.main.pw_d1 AS SELECT * FROM pw.main.pw_src;

statement ok
CREATE TABLE pw.main.pw_d2 AS SELECT * FROM pw.main.pw_src;

statement ok
SET threads=1;

statement ok
CREATE TEMP TABLE pw_t3 AS SELECT epoch_ms(now()) AS ms;

# The sleep is in the PREDICATE, once per morsel, and it selects the four rows it slept on.
statement ok
DELETE FROM pw.main.pw_d1 WHERE plug_sleep(CASE WHEN id % 2048 = 0 THEN 400 ELSE 0 END) > 100;

statement ok
CREATE TEMP TABLE pw_t4 AS SELECT epoch_ms(now()) AS ms;

statement ok
SET threads=4;

statement ok
DELETE FROM pw.main.pw_d2 WHERE plug_sleep(CASE WHEN id % 2048 = 0 THEN 400 ELSE 0 END) > 100;

statement ok
CREATE TEMP TABLE pw_t5 AS SELECT epoch_ms(now()) AS ms;

query I
SELECT ((SELECT ms FROM pw_t4) - (SELECT ms FROM pw_t3)) >= 1200;
----
true

query I
SELECT ((SELECT ms FROM pw_t5) - (SELECT ms FROM pw_t4))
     < ((SELECT ms FROM pw_t4) - (SELECT ms FROM pw_t3)) * 0.7;
----
true

# Both legs deleted exactly the four rows they slept on — the same reason the CTAS legs assert their counts.
query II
SELECT (SELECT count(*) FROM pw.main.pw_d1), (SELECT count(*) FROM pw.main.pw_d2);
----
8188	8188

statement ok
RESET threads;

statement ok
DETACH pw;

# ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# A PLUGIN-AUTHORED CORRELATED LATERAL FUNCTION, and the only place the batching win is MEASURED rather than
# argued. docs/lateral_unnest_analysis.md §8.
#
# Two things at once. (1) A plugin can declare one: it references Fabricator.Abstractions and nothing else, so
# `ILateralFunction` must cost it no more than a scalar does — and this is the audience the kind is FOR,
# since a plugin's callee is typically a REST or model call. (2) `plug_lat_slow(n, millis)` sleeps ONCE PER
# CALL, which is the only cost batching can amortise, so N distinct outer rows cost N sleeps on DuckDB's
# row-by-row driver and about ONE on the batched operator.
#
# ⚠ threads=1 is required: the correlated plan feeds the operator from a DISTINCT aggregate that emits one
# chunk per radix partition, so with several threads the 8 rows arrive as several chunks and the ratio moves.
# ⚠ millis=100 because the Windows sleep floor is the timer tick (~15 ms) — a small value is a lie by 15x.
# ─────────────────────────────────────────────────────────────────────────────────────────────────────────────

statement ok
SET threads=1;

statement ok
CREATE TEMP TABLE lat_in AS SELECT CAST(i AS INTEGER) AS n FROM range(8) tt(i);

statement ok
CREATE TEMP TABLE lat_t0 AS SELECT epoch_ms(now()) AS ms;

statement ok
SET fabricator_batched_lateral = false;

# The SERIAL leg first, so its own duration is the baseline. `batch_rows = 1` is the mechanism assertion: this
# leg really did get one input row per call.
query III
SELECT count(*), sum(s.squared), max(s.batch_rows) FROM lat_in d, plug_lat_slow(d.n, 100) s;
----
8	140	1

statement ok
CREATE TEMP TABLE lat_t1 AS SELECT epoch_ms(now()) AS ms;

statement ok
SET fabricator_batched_lateral = true;

# Same answers, and all 8 rows in ONE call.
query III
SELECT count(*), sum(s.squared), max(s.batch_rows) FROM lat_in d, plug_lat_slow(d.n, 100) s;
----
8	140	8

statement ok
CREATE TEMP TABLE lat_t2 AS SELECT epoch_ms(now()) AS ms;

# POSITIVE CONTROL, load-bearing: the row-by-row leg really slept eight times. Without it the ratio below
# would pass equally on a build where the sleeps had stopped happening.
query I
SELECT ((SELECT ms FROM lat_t1) - (SELECT ms FROM lat_t0)) >= 700;
----
true

# THE CLAIM: one call instead of eight, so the statement costs about ONE sleep. Measured 0.154 s against
# 0.870 s (5.6x); asserted at 0.5 to leave room for a loaded machine.
query I
SELECT ((SELECT ms FROM lat_t2) - (SELECT ms FROM lat_t1))
     < ((SELECT ms FROM lat_t1) - (SELECT ms FROM lat_t0)) * 0.5;
----
true

# The plugin's declaration is advertised like any other function's.
query II
SELECT function_type, parameter_types FROM duckdb_functions() WHERE function_name = 'plug_lat_slow';
----
table	[INTEGER, INTEGER]

statement ok
RESET threads;

# ============================================================================
# The HOST SERVICE LOCATOR — a plugin resolving a capability that needs the
# RUNNING HOST (docs/plugin-services.md §7).
# ============================================================================
#
# ⚠⚠ THIS SECTION GATES TWO THINGS AT ONCE AND NEITHER HAD A GATE BEFORE IT.
#   (1) FabricatorServices: a plugin resolving IHostFileSystem with an
#       Fabricator.Abstractions reference alone — no Fabricator.Bridge.
#   (2) The ABI v82 AMBIENT. A global scalar is the crossing that had NO
#       ClientContext at all until v82, and every fs_* host callback
#       dereferences one — an earlier host-filesystem seam died with an ACCESS
#       VIOLATION on its first call for exactly that reason
#       (docs/fluid-templating.md §10.2). So "a plugin reads a file" is not
#       plumbing, it is the claim.
#
# ⚠ It reads through DuckDB's FileSystem, not System.IO — which is the point:
#   the same call reaches s3:// or abfss:// with the calling session's secrets.
#   That half is not assertable here (no remote in the hermetic fixtures), so
#   the suite says so rather than implying it.

# PER_THREAD_OUTPUT on this first COPY is what CREATES the directory: a plain
# COPY to a file path does not create its parent, and the runner's scratch dir
# need not exist from DuckDB's point of view.
statement ok
COPY (SELECT 1 AS c) TO '${FABRICATOR_DELTA_WRITE_DIR}/svc' (FORMAT csv, PER_THREAD_OUTPUT true, HEADER false);

statement ok
COPY (SELECT 'hello from storage' AS c) TO '${FABRICATOR_DELTA_WRITE_DIR}/svc/a.txt' (FORMAT csv, HEADER false, QUOTE '');

statement ok
COPY (SELECT 'second' AS c) TO '${FABRICATOR_DELTA_WRITE_DIR}/svc/b.txt' (FORMAT csv, HEADER false, QUOTE '');

# THE LOAD-BEARING ASSERTION: the plugin resolved IHostFileSystem and read a
# real file through the host. ⚠ rtrim(x, chr(10)) and NOT trim(x) — DuckDB's
# one-argument trim removes SPACES and leaves the newline COPY appends.
query I
SELECT rtrim(plug_read_file('${FABRICATOR_DELTA_WRITE_DIR}/svc/a.txt'), chr(10));
----
hello from storage

# Vectorized over a batch, and NULL means "no path" rather than "empty file".
query II
SELECT p IS NULL, rtrim(coalesce(plug_read_file(p), 'NULLPATH'), chr(10)) AS r
FROM (VALUES ('${FABRICATOR_DELTA_WRITE_DIR}/svc/b.txt'), (NULL)) v(p) ORDER BY r;
----
true	NULLPATH
false	second

# The other member of the interface. A count is the one glob answer that is
# assertable without knowing the runner's scratch path.
query I
SELECT plug_glob_count('${FABRICATOR_DELTA_WRITE_DIR}/svc/*.txt');
----
2

# ZERO MATCHES IS AN ANSWER, NOT A FAILURE — and it is the negative control for
# the 2 above, which would otherwise pass on a build where glob returned
# everything it was handed.
query I
SELECT plug_glob_count('${FABRICATOR_DELTA_WRITE_DIR}/svc/*.nosuchext');
----
0

# A missing file THROWS, where a glob answers zero. The two are different
# questions and the surface keeps them different: absence of a named file is an
# error, absence of matches is a count. (The message is the host filesystem's,
# so only the prefix is asserted.)
statement error
SELECT plug_read_file('${FABRICATOR_DELTA_WRITE_DIR}/svc/does_not_exist.txt');
----
IO Error

# The plugin's two service-backed scalars are advertised like any other.
query II
SELECT function_name, return_type FROM duckdb_functions()
WHERE function_name IN ('plug_read_file', 'plug_glob_count') ORDER BY function_name;
----
plug_glob_count	BIGINT
plug_read_file	VARCHAR

# ============================================================================
# A PLUGIN'S PRIVATE DEPENDENCY — the closure ships beside it and is reachable
#
# ⚠ WHAT THIS GUARDS IS MEASURED, NOT IMAGINED: a LIBRARY does not copy its dependency
# closure to the output directory unless CopyLocalLockFileAssemblies is set. When
# Fabricator.FluidPlugin was created its first build produced ONE assembly and nothing
# else — it loaded fine and died at the first render with a FileNotFoundException naming
# an assembly that was never copied.
#
# ⚠ Fluid was the ONLY in-tree plugin with a private dependency, and it became a built-in
# provider assembly on 2026-09-02 — so without this fixture that coverage went to zero.
# pack-distribution's "a bundled plugin must have more than one assembly" assertion went
# with the bundling, too.
#
# ⚠ The marker comes from a METHOD in Fabricator.SamplePlugin.Support, not a const: C#
# bakes a const into the CALLER's IL, so this would answer correctly with the support
# assembly ABSENT and the assertion would prove nothing.
# ============================================================================

query I
SELECT plug_support();
----
sample support present

# ⚠ AND THE HOST SAW IT AS A CANDIDATE THAT DECLARES NO PROVIDER, which is what tells a
# shipped dependency apart from a broken one: `no_backend` is the ORDINARY state of a
# plugin's own dependency, where a closure that failed to resolve reports `rejected` with
# the exception. Both halves matter — the row proves it was there, the value above proves
# it was USED.
query I
SELECT count(*) FROM fabricator_plugins()
WHERE status = 'no_backend' AND path LIKE '%Fabricator.SamplePlugin.Support.dll';
----
1

# ... and it was not REJECTED, which is the state a dependency present but unloadable would
# report. ⚠ SCOPED TO THIS ASSEMBLY on purpose: a blanket "nothing was rejected" asserts a
# property of whatever else happens to be in the plugin directory, and a stale `publish/`
# subdirectory holding a second copy of the plugin legitimately produces a rejected row
# (a provider-name collision, correctly refused). That would make this assertion fail for
# a reason it is not about.
query I
SELECT count(*) FROM fabricator_plugins()
WHERE status = 'rejected' AND path LIKE '%Fabricator.SamplePlugin.Support.dll';
----
0

# ============================================================================
# IHostLog — a PLUGIN reaching DuckDB's own log (docs/plugin-services.md §10)
#
# The only in-tree proof that a plugin can log anywhere a user can see. A plugin
# cannot reference FabricatorLog — its whole public surface is
# Microsoft.Extensions.Logging, which would land in every plugin's compile
# closure — and the route into duckdb_logs runs through the host_log reverse
# callback, so without this service a plugin's options are its own file or
# silence.
#
# ⚠ THREE INDEPENDENT THINGS ARE ASSERTED and none implies another:
#   - the BOOLEAN is IsEnabled, so a build answering it wrongly shows up there;
#   - `log_level` is the level MAPPING (HostLogLevel → MEL LogLevel → the host's
#     int code), which no "did the message arrive" assertion can see;
#   - `type` is the CATEGORY, so a plugin's output is attributable to the plugin
#     rather than to the host.
# ============================================================================

# ⚠ REPRODUCING THIS IN THE SHELL NEEDS ONE MORE SETTING THAN IT NEEDS HERE:
# `SET logging_storage = 'memory'`. The default storage is stdout, so duckdb.exe
# PRINTS every event — which looks like success — while
# `SELECT count(*) FROM duckdb_logs` answers 0. unittest needs no such setting
# (verify_catalog_init has queried duckdb_logs with just these two since it was
# written). Two environments, two answers; a probe in the wrong one reads as "the
# service does not work".
statement ok
SET enable_logging = true;

statement ok
SET logging_level = 'DEBUG';

# The service resolves and Warning is enabled.
query I
SELECT plug_log('warn', 'plug_log warning probe');
----
true

# ... and it reached DuckDB's own log, not merely a file sink.
query I
SELECT count(*) FROM duckdb_logs WHERE message = 'plug_log warning probe';
----
1

# ⚠⚠ THE TWO LOAD-BEARING COLUMNS, asserted together because they answer
# different questions. `log_level` is the level after two hops (our enum → MEL →
# the host's int), so a mapping that slipped by one still delivers the message
# and only this can see it. `type` is the CATEGORY the plugin chose, which is
# what makes its output distinguishable from the host's own (QueryLog,
# Fabricator.Bridge, …) rather than an anonymous line.
# ⚠ MEASURED spelling: DuckDB renders the level as 'WARNING', not 'WARN'.
query II
SELECT log_level, type FROM duckdb_logs WHERE message = 'plug_log warning probe';
----
WARNING	Fabricator.SamplePlugin

# A SECOND and THIRD level, because one cannot distinguish "mapped correctly"
# from "everything maps to WARNING".
query I
SELECT plug_log('info', 'plug_log info probe');
----
true

query I
SELECT plug_log('debug', 'plug_log debug probe');
----
true

query II
SELECT log_level, count(*) FROM duckdb_logs
WHERE message IN ('plug_log info probe', 'plug_log debug probe')
GROUP BY 1 ORDER BY 1;
----
DEBUG	1
INFO	1

# ⚠⚠ THE ASSERTION THAT MAKES THE BOOLEAN MEAN ANYTHING: Trace is NOT enabled,
# so IsEnabled is a real answer rather than a constant true. The reason is
# mechanical — with the host forwarding wired, FabricatorLog promotes a
# NullLoggerFactory to one whose minimum level is Debug, so Trace falls below it
# while Debug does not.
# ⚠ IT DEPENDS ON FABRICATOR_LOG_LEVEL BEING UNSET (or above Trace), which is
# the default and what both CI tiers do: with FABRICATOR_LOG_LEVEL=trace exported
# the factory is built at Trace instead and this answers true. That is the one
# assertion here a developer's own environment can move.
query I
SELECT plug_log('trace', 'plug_log trace probe');
----
false

# ... and nothing was recorded for it, which is the other half of the same claim:
# the function logs ONLY when enabled, which is the discipline the interface
# documents rather than an optimisation of this one caller.
query I
SELECT count(*) FROM duckdb_logs WHERE message = 'plug_log trace probe';
----
0

# NEGATIVE CONTROL. Without it every count above is equally satisfied by a
# duckdb_logs that matches anything.
query I
SELECT count(*) FROM duckdb_logs WHERE message = 'plug_log probe never logged';
----
0

# ⚠⚠ THE MESSAGE IS TAKEN VERBATIM. Braces are the normal case for this plugin's
# neighbours (a rendered Fluid template, a JSON fragment), so this is worth
# knowing — but it is a CHARACTERIZATION TEST and the suite says so: it pins
# Microsoft.Extensions.Logging's behaviour, not ours. MEL builds a format parser
# only when the argument array is non-empty, so our zero-argument call returns
# the string untouched. The defensive version (message as an ARGUMENT to a fixed
# "{Message}" template) shipped for an hour on the theory that braces would
# otherwise be mangled, and the mutant removing it SURVIVES this whole gate —
# which is what showed the theory was wrong and the indirection unnecessary.
query I
SELECT plug_log('warn', 'plug_log braces {Not} {0} {{x}} probe');
----
true

query I
SELECT count(*) FROM duckdb_logs WHERE message = 'plug_log braces {Not} {0} {{x}} probe';
----
1

# An unknown level is refused BY NAME rather than defaulted — silently logging a
# typo as Information would put it in the output looking plausible.
statement error
SELECT plug_log('shout', 'never');
----
unknown level

# NULL in either argument yields NULL and records nothing.
query I
SELECT plug_log(NULL, 'x') IS NULL AND plug_log('warn', NULL) IS NULL;
----
true

# The service-backed scalars are advertised like any other.
query II
SELECT function_name, return_type FROM duckdb_functions()
WHERE function_name = 'plug_log';
----
plug_log	BOOLEAN
