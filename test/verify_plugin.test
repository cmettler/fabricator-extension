# name: test/verify_plugin.test
# description: Third-party plugin SPI (no ALC isolation) — a plugin assembly dropped into an FABRICATOR_PLUGIN_DIR
#              folder is discovered at load, its IBackend registered, and its connection-free GLOBAL functions
#              surfaced as bare fn(...) with NO ATTACH. Demo plugin: Fabricator.SamplePlugin's plug_greet.
#              Set FABRICATOR_PLUGIN_DIR to the folder the sample plugin was built into. See docs/plugin-system.md.
# group: [fabricator]

require fabricator

# ⚠ For the parallel-write section at the end, which writes a real Delta table: the data files are written by
# DuckDB's own COPY, and the sqllogictest runner does NOT auto-load a statically linked extension the way the
# shell does — so without this the write fails with "Copy Function with name \"parquet\" is not in the
# catalog". Measured, not anticipated: that is exactly how this suite failed the first time.
require parquet

require-env FABRICATOR_PLUGIN_DIR

require-env FABRICATOR_DELTA_WRITE_DIR

# The plugin's global scalar resolves on a bare loaded extension — no ATTACH, no first-party involvement.
query I
SELECT plug_greet('world');
----
Hello, world (from plugin)

# Vectorized over a batch, incl. a NULL (the plugin's Invoke sees it).
query I
SELECT plug_greet(n) AS r FROM (VALUES ('Ann'), ('Bob'), (NULL)) v(n) ORDER BY r;
----
Hello, Ann (from plugin)
Hello, Bob (from plugin)
Hello, stranger (from plugin)

# A built-in global function still works alongside the plugin's (both in the same registry, no conflict).
query I
SELECT fabricator_render('Hi {{ name }}', {'name':'plugin'});
----
Hi plugin

# ---- plugin-declared MACROs (docs/macros-and-sqlgen-functions.md §1) ----
# A plugin ships SQL templates the same way it ships functions: declare CREATE MACRO statements, the host
# parses + registers them at load. No bridge or ABI involvement.

query I
SELECT plug_double(21);
----
42

query II
SELECT DISTINCT function_name, function_type FROM duckdb_functions() WHERE function_name = 'plug_double';
----
plug_double	macro

# The plugin ALSO declares a deliberately MALFORMED macro (plug_bad_macro): it is skipped with a warning at
# load and blocks nothing — its sibling macro above and the plugin's scalar below both work. (The warning
# itself only reaches duckdb_logs when logging was enabled BEFORE the extension loaded — i.e. the LOAD
# path, not this statically-linked binary; verify it there.)
query I
SELECT count(*) FROM duckdb_functions() WHERE function_name = 'plug_bad_macro';
----
0

query I
SELECT plug_greet('after');
----
Hello, after (from plugin)

# ---- fabricator_plugins(): the scan is no longer silent ----
# Every candidate the scan looked at gets a row with a STATUS and a REASON. This is the gate on the property
# the plugin system most needed and did not have: ScanPluginDirectories ends each candidate in a catch, so a
# plugin built against a different Apache.Arrow major, or missing a private dependency, used to be skipped
# with NO signal — indistinguishable from "it loaded and registered nothing". That distinction is what an
# installer makes load-bearing, because "install succeeded, nothing happened" becomes the normal failure.

# The configured root was searched, and it reports how many candidates it saw.
query I
SELECT count(*) FROM fabricator_plugins() WHERE status = 'root';
----
1

# ⚠ THE LOAD-BEARING ASSERTION: the sample plugin is reported as LOADED, with the provider it registered.
# Its scalar working (above) proves the plugin loaded; only this proves the SCAN can SAY SO — a report that
# silently recorded nothing would leave every assertion above it passing.
query II
SELECT status, provider FROM fabricator_plugins() WHERE provider = 'sampleplugin';
----
loaded	sampleplugin

# Every row carries a non-empty reason. A status with no detail is the failure this table exists to prevent
# — it would answer "what happened" and not "why".
query I
SELECT count(*) FROM fabricator_plugins() WHERE detail = '';
----
0

# Only known statuses. Pins the vocabulary (PluginScanStatus) so a new state cannot appear unnamed.
query I
SELECT count(*) FROM fabricator_plugins()
WHERE status NOT IN ('root', 'root_missing', 'loaded', 'no_backend', 'shared', 'rejected');
----
0

# Internal consistency: every candidate's path sits UNDER the root it was attributed to. Absoluteness itself
# is pinned offline (PluginPathsTests.Override_paths_are_absolute) — asserting it again through LIKE patterns
# would be a fragile restatement; this instead pins something only the live scan can get wrong, namely
# attributing a file to the wrong root once several roots are configured.
query I
SELECT count(*) FROM fabricator_plugins() WHERE path <> '' AND position(root in path) <> 1;
----
0

# The shared set is REPORTED, not hidden: the bridge's own assemblies sitting in a plugin folder are skipped
# deliberately (reflecting a plugin-dir copy of Fabricator.Bridge would re-register its StubBackend), and a
# deliberate skip must be visible or it reads as a plugin that failed. 0 is legitimate here — the sample
# plugin folder need not contain any — so this asserts the SHAPE holds whenever such rows exist.
query I
SELECT count(*) FROM fabricator_plugins() WHERE status = 'shared' AND (path = '' OR detail = '');
----
0

# ============================================================================
# plug_sleep — the plugin's TEST INSTRUMENT, not a feature. It blocks its worker thread once PER ROW, which
# is what lets a test make a query's cost a number the test chose (docs/scan-concurrency.md §6 uses it to
# turn effective parallelism into arithmetic: rows x millis / wall clock).
# ============================================================================

# The trivial contract: it returns what it slept, and a NULL row sleeps not at all.
query II
SELECT plug_sleep(0), plug_sleep(NULL);
----
0	NULL

# ⚠ A NEGATIVE IS REFUSED, and this is the load-bearing assertion of the section. Thread.Sleep(-1) is
# Timeout.Infinite, so the alternative to refusing is a suite that HANGS — the one failure mode worse than a
# wrong answer here. Clamping to zero would be worse still: it would hide the caller's arithmetic bug.
statement error
SELECT plug_sleep(-1);
----
millis must be >= 0

# ⚠ THE SIDE EFFECT REALLY HAPPENS PER ROW, which is the property the whole instrument rests on: a scalar
# declared CONSISTENT would be FOLDED to a literal at plan time over a constant argument, sleep ONCE during
# binding, and every parallelism number built on it would be confidently wrong while looking healthy.
# Asserted as a LOWER BOUND on elapsed time (20 rows x 60 ms = 1.2 s of work, single-threaded), because a
# lower bound can only be broken by the sleep NOT happening — a loaded machine makes it more true, not less.
statement ok
SET threads=1;

statement ok
CREATE TEMP TABLE plug_sleep_t0 AS SELECT epoch_ms(now()) AS ms;

# ⚠ sum(), not count(): DuckDB PRUNES a projected column no aggregate consumes, so `count(*)` over this would
# evaluate plug_sleep ZERO times and the section would pass with the instrument entirely broken.
query I
SELECT sum(plug_sleep(60)) FROM range(20);
----
1200

query I
SELECT (epoch_ms(now()) - (SELECT ms FROM plug_sleep_t0)) >= 1000;
----
true

statement ok
RESET threads;

# ============================================================================
# plug_slow_range(rows, millis) — the SOURCE-side twin of plug_sleep. It yields 2048-row batches and sleeps
# per BATCH, so its cost lands inside get_next, on the other side of the scan boundary. The pair is what
# makes docs/scan-concurrency.md §1 measurable: cost in the projection scales with threads, cost in the
# source does NOT, because the host pulls every batch under one mutex. Also the first TABLE function a
# plugin contributes here, so it pins that a plugin reaches ITableFunction and not just IScalarFunction.
# ============================================================================

query I
SELECT function_type FROM duckdb_functions() WHERE function_name = 'plug_slow_range';
----
table

query III
SELECT count(*), min(id), max(id) FROM plug_slow_range(8, 0);
----
8	0	7

# ⚠ MORE THAN ONE BATCH, deliberately: the yield loop is per 2048 rows, so a single-batch test would not
# distinguish a working loop from one that emits its first batch and stops. 5000 crosses two boundaries.
query III
SELECT count(*), count(DISTINCT id), sum(id) FROM plug_slow_range(5000, 0);
----
5000	5000	12497500

query I
SELECT count(*) FROM plug_slow_range(0, 0);
----
0

# Refused, not clamped — same reasoning as plug_sleep's negative: Thread.Sleep(-1) never returns.
statement error
SELECT count(*) FROM plug_slow_range(-1, 0);
----
must both be >= 0

statement error
SELECT count(*) FROM plug_slow_range(8, -5);
----
must both be >= 0

# The sleep really happens in the source: 4096 rows = 2 batches x 300 ms. A LOWER BOUND again, so a loaded
# machine can only make it more true; only the sleep NOT happening can break it.
statement ok
CREATE TEMP TABLE plug_range_t0 AS SELECT epoch_ms(now()) AS ms;

query I
SELECT count(*) FROM plug_slow_range(4096, 300);
----
4096

query I
SELECT (epoch_ms(now()) - (SELECT ms FROM plug_range_t0)) >= 500;
----
true

# ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# THE UNION OVERLAPS — a scan whose PULL blocks no longer occupies every worker.
# docs/scan-concurrency.md §5f. This is the gate for the PRODUCTION path (ArrowStreamScan, which every
# fabricator scan on every provider goes through); `verify_wait`'s async_wait section gates the mechanism
# hermetically, in pure C++, with no managed code in it at all.
#
# ⚠ THE A/B LEVER IS DuckDB's OWN DEBUG SETTING, and that is what makes this a same-binary comparison rather
# than a remembered number: under SYNCHRONOUS a table function may not return BLOCKED (PhysicalTableScan's
# ValidateAsyncStrategyResult throws on it), so our scan falls back to parking on the pull lock — i.e. exactly
# the pre-fix code path. Measured on the box this was written on, three runs each, +/- 0.01: 2.06 s vs 1.03 s.
#
# ⚠ TWO different functions on purpose. `plug_slow_range ∪ plug_slow_range2` is what refuted the intermediate
# reading that "two calls of the SAME function serialize" (§5c) — with one function it would still be true and
# would prove less.

statement ok
SET threads=4;

statement ok
CREATE TEMP TABLE plug_u0 AS SELECT epoch_ms(now()) AS ms;

# 4096 rows = 2 batches x 500 ms = 1000 ms per branch, all of it INSIDE the pull.
statement ok
SET debug_physical_table_scan_execution_strategy='SYNCHRONOUS';

query I
SELECT sum(id) FROM (SELECT * FROM plug_slow_range(4096, 500) UNION ALL SELECT * FROM plug_slow_range2(4096, 500));
----
16773120

statement ok
CREATE TEMP TABLE plug_u1 AS SELECT epoch_ms(now()) AS ms;

statement ok
SET debug_physical_table_scan_execution_strategy='DEFAULT';

query I
SELECT sum(id) FROM (SELECT * FROM plug_slow_range(4096, 500) UNION ALL SELECT * FROM plug_slow_range2(4096, 500));
----
16773120

statement ok
CREATE TEMP TABLE plug_u2 AS SELECT epoch_ms(now()) AS ms;

# POSITIVE CONTROL, load-bearing: the serial leg really slept. Without it the ratio below would pass equally
# on a build where the sleeps had stopped happening.
query I
SELECT ((SELECT ms FROM plug_u1) - (SELECT ms FROM plug_u0)) >= 1500;
----
true

# THE CLAIM: the branches overlap, so the union costs about ONE of them. True ratio ~0.50, asserted at 0.80.
query I
SELECT ((SELECT ms FROM plug_u2) - (SELECT ms FROM plug_u1))
     < ((SELECT ms FROM plug_u1) - (SELECT ms FROM plug_u0)) * 0.8;
----
true

statement ok
RESET threads;

# ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# A WRITE INTO A FABRICATOR TABLE SCALES WITH `SET threads`. docs/scan-concurrency.md §7c.
#
# Until the write sinks declared ParallelSink() true, `Pipeline::ScheduleParallel` fell through to
# ScheduleSequentialTask before it ever looked at the source or MaxThreads(), so the ENTIRE pipeline — scan,
# projection, sink — ran on one task and a write was flat in `SET threads` (measured: 2919/2952 ms at 1 vs 4
# threads, against 2730 -> 1227 ms for the same work streaming to the client).
#
# ⚠ `SET threads=1` IS THE PRE-CHANGE LEG, and that is what makes this a same-binary A/B rather than a
# remembered number: FabricatorParallelWrite returns false at one thread, so leg A takes exactly the old code
# path. There is no debug setting for a sink the way there is for a scan (§5f), so this is the only lever.
#
# ⚠ THE COST MUST SIT IN THE PROJECTION, ONCE PER MORSEL, AND THE SOURCE MUST BE A FABRICATOR TABLE. A per-ROW
# sleep is impractical (a morsel is 2048 rows) and `range()` is a single-threaded source (§6), which would cap
# the pipeline at one task whatever the sink declares — either mistake makes the section measure nothing while
# passing.

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/plugpw' AS pw (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE pw.main.pw_src AS SELECT i AS id FROM range(8192) t(i);

statement ok
SET threads=1;

statement ok
CREATE TEMP TABLE pw_t0 AS SELECT epoch_ms(now()) AS ms;

# 8192 rows = 4 morsels, one 400 ms sleep each => 1600 ms serial, ~400 ms across four tasks.
statement ok
CREATE OR REPLACE TABLE pw.main.pw_a AS
  SELECT id, plug_sleep(CASE WHEN id % 2048 = 0 THEN 400 ELSE 0 END) AS w FROM pw.main.pw_src;

statement ok
CREATE TEMP TABLE pw_t1 AS SELECT epoch_ms(now()) AS ms;

statement ok
SET threads=4;

statement ok
CREATE OR REPLACE TABLE pw.main.pw_b AS
  SELECT id, plug_sleep(CASE WHEN id % 2048 = 0 THEN 400 ELSE 0 END) AS w FROM pw.main.pw_src;

statement ok
CREATE TEMP TABLE pw_t2 AS SELECT epoch_ms(now()) AS ms;

# POSITIVE CONTROL, load-bearing: the serial leg really slept its four morsels. Without it the ratio below
# would pass equally on a build where plug_sleep had stopped sleeping, or the projection had been pruned away.
query I
SELECT ((SELECT ms FROM pw_t1) - (SELECT ms FROM pw_t0)) >= 1200;
----
true

# THE CLAIM: the four morsels are written by four tasks, so the statement costs about one of them. True ratio
# ~0.3; asserted at 0.7 so only a sink that has stopped being parallel can fail it.
query I
SELECT ((SELECT ms FROM pw_t2) - (SELECT ms FROM pw_t1))
     < ((SELECT ms FROM pw_t1) - (SELECT ms FROM pw_t0)) * 0.7;
----
true

# Both legs wrote every row: the speed claim is worthless if the fast leg dropped a batch.
query IIII
SELECT (SELECT count(*) FROM pw.main.pw_a), (SELECT sum(id) FROM pw.main.pw_a),
       (SELECT count(*) FROM pw.main.pw_b), (SELECT sum(id) FROM pw.main.pw_b);
----
8192	33550336	8192	33550336

# ── and the same for a rowid DELETE, which is a DIFFERENT sink class with its own flag. Worth its own leg
# because the ratio is the LARGEST of the write paths (measured 3.22 -> 1.36 s on 2 M rows): a DELETE's whole
# cost is the scan, the filter and the rowid append, so almost all of it is what the flag unblocks — the
# provider does its work once at Finalize either way.

statement ok
CREATE TABLE pw.main.pw_d1 AS SELECT * FROM pw.main.pw_src;

statement ok
CREATE TABLE pw.main.pw_d2 AS SELECT * FROM pw.main.pw_src;

statement ok
SET threads=1;

statement ok
CREATE TEMP TABLE pw_t3 AS SELECT epoch_ms(now()) AS ms;

# The sleep is in the PREDICATE, once per morsel, and it selects the four rows it slept on.
statement ok
DELETE FROM pw.main.pw_d1 WHERE plug_sleep(CASE WHEN id % 2048 = 0 THEN 400 ELSE 0 END) > 100;

statement ok
CREATE TEMP TABLE pw_t4 AS SELECT epoch_ms(now()) AS ms;

statement ok
SET threads=4;

statement ok
DELETE FROM pw.main.pw_d2 WHERE plug_sleep(CASE WHEN id % 2048 = 0 THEN 400 ELSE 0 END) > 100;

statement ok
CREATE TEMP TABLE pw_t5 AS SELECT epoch_ms(now()) AS ms;

query I
SELECT ((SELECT ms FROM pw_t4) - (SELECT ms FROM pw_t3)) >= 1200;
----
true

query I
SELECT ((SELECT ms FROM pw_t5) - (SELECT ms FROM pw_t4))
     < ((SELECT ms FROM pw_t4) - (SELECT ms FROM pw_t3)) * 0.7;
----
true

# Both legs deleted exactly the four rows they slept on — the same reason the CTAS legs assert their counts.
query II
SELECT (SELECT count(*) FROM pw.main.pw_d1), (SELECT count(*) FROM pw.main.pw_d2);
----
8188	8188

statement ok
RESET threads;

statement ok
DETACH pw;
