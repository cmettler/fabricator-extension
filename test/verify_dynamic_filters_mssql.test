# name: test/verify_dynamic_filters_mssql.test
# description: Dynamic join filters for SQL Server scans (docs/duckdb-2.0-remote-execution.md §5). The catalog declares
#              `superset_filter_pushdown`, so its scans take table filters (filter_pushdown=true) — a hash join's runtime
#              filter on the build side's keys among them — render them into the WHERE as a superset, and RE-APPLY them
#              to every chunk. A small local table joined with a large remote one then reads the matching rows, not all.
#              ⚠ The rig's database is case-insensitive and pads strings, so the server's WHERE matches more than DuckDB
#              does; the local re-application is what keeps the answers exact — §2 and §3 are the cases that show it.
# group: [fabricator]

require fabricator

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS rp (TYPE fabricator);

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS sc (TYPE fabricator, remote_pushdown 'false');

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS off (TYPE fabricator, remote_pushdown 'false', dynamic_filters 'false');

# df_big: 6000 rows; region cycles 'R1' 'r1' 'R1 ' 'R2' 'R3' 'R4' (case and a trailing space the server folds together)
statement ok
SELECT fabricator_exec('rp', 'DROP TABLE IF EXISTS dbo.df_big; CREATE TABLE dbo.df_big (id INT PRIMARY KEY, region VARCHAR(10) NOT NULL, v INT NOT NULL);
INSERT INTO dbo.df_big SELECT value, CHOOSE(value % 6 + 1, ''R1'', ''r1'', ''R1 '', ''R2'', ''R3'', ''R4''), value % 100 FROM GENERATE_SERIES(1, 6000);
CREATE INDEX ix_df_big_region ON dbo.df_big (region);', refresh_cache := true);

statement ok
CREATE TABLE loc AS SELECT * FROM (VALUES ('r1', 1), ('R2', 2)) t(region, w);

statement ok
CALL enable_logging(['Fabricator.Sql'], storage := 'memory', level := 'debug');

# ═══ §1  The join's keys reach the server's WHERE ═══════════════════════════════════════════════════════════

query II
SELECT count(*), sum(b.v) FROM loc l JOIN sc.dbo.df_big b ON b.region = l.region;
----
2000	100000

query I
SELECT count(*) > 0 FROM duckdb_logs WHERE type = 'Fabricator.Sql'
  AND message LIKE '%FROM [dbo].[df_big]%WHERE [region] IN (%';
----
true

statement ok
CALL truncate_duckdb_logs();

# without the capability the scan reads every row
query II
SELECT count(*), sum(b.v) FROM loc l JOIN off.dbo.df_big b ON b.region = l.region;
----
2000	100000

query I
SELECT count(*) FROM duckdb_logs WHERE type = 'Fabricator.Sql' AND message LIKE '%FROM [dbo].[df_big]%WHERE [region]%';
----
0

statement ok
CALL truncate_duckdb_logs();

# ═══ §2  Exact although the server's WHERE is a superset (case-insensitive, padded) ═════════════════════════
# The server's `region IN ('r1', 'R2')` also returns 'R1' and 'R1 '; the scan drops them.

query I
SELECT (SELECT count(*) FROM ((SELECT b.id, l.w FROM loc l JOIN sc.dbo.df_big b ON b.region = l.region)
        EXCEPT ALL (SELECT b.id, l.w FROM loc l JOIN off.dbo.df_big b ON b.region = l.region)))
     + (SELECT count(*) FROM ((SELECT b.id, l.w FROM loc l JOIN off.dbo.df_big b ON b.region = l.region)
        EXCEPT ALL (SELECT b.id, l.w FROM loc l JOIN sc.dbo.df_big b ON b.region = l.region)));
----
0

query T
SELECT DISTINCT b.region FROM loc l JOIN sc.dbo.df_big b ON b.region = l.region ORDER BY 1;
----
R2
r1

# a static filter on the scan path, re-applied the same way
query I
SELECT count(*) FROM sc.dbo.df_big WHERE region = 'r1';
----
1000

query I
SELECT count(*) FROM sc.dbo.df_big WHERE region IN ('R1 ', 'R4');
----
2000

# ═══ §3  TOP and a filter the scan re-applies ═══════════════════════════════════════════════════════════════
# With a mandatory filter TOP stays local: TOP 3 on the server's superset, re-filtered here, would keep fewer.

query I
SELECT id FROM sc.dbo.df_big WHERE region = 'r1' ORDER BY id LIMIT 3;
----
1
7
13

# ⚠ the case the guard exists for: `region > 'R3'` is a table filter of the scan that the server's case-insensitive
# collation cannot order as DuckDB does, so it is not rendered and nothing narrows the server's rows — a TOP 3 there
# would return ids 1, 2, 3, re-filtered to one
query I
SELECT id FROM sc.dbo.df_big WHERE region > 'R3' ORDER BY id LIMIT 3;
----
1
5
7

# without a filter the TOP + ORDER BY still reaches the server (a TopN's moving bound is no reason to keep it)
statement ok
CALL truncate_duckdb_logs();

query I
SELECT id FROM sc.dbo.df_big ORDER BY id LIMIT 2;
----
1
2

query I
SELECT count(*) > 0 FROM duckdb_logs WHERE type = 'Fabricator.Sql'
  AND message LIKE '%TOP%FROM [dbo].[df_big]%ORDER BY [id]%';
----
true

statement ok
SELECT fabricator_exec('rp', 'DROP TABLE dbo.df_big');
