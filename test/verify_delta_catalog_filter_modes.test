# name: test/verify_delta_catalog_filter_modes.test
# description: The `pushdown_filters` ATTACH option (duckdb-delta parity: 'none'|'static'|'dynamic'|'all')
#              on the Delta catalog. none = no pushdown (pure fallback); static = best-effort
#              file/row-group/bloom pruning (codec default; DuckDB re-applies); dynamic/all: the scan
#              declares filter_pushdown=true, DuckDB ERASES the pushed static filters from the plan and
#              delivers hash-join DYNAMIC filters. Under native_read the host-rendered TableFilterSet SQL is
#              applied EXACTLY inside read_parquet; on the CODEC path the catalog declares
#              superset_filter_pushdown and the host re-applies every filter to the scan's chunks (since
#              2026-11-09; it was a per-batch host query, HostBatchFilter). Correctness across modes is the
#              safety net: with the filter erased, a dropped one would return surplus rows.
#              Set FABRICATOR_DELTA_WRITE_DIR to a WRITABLE base path. Local FS.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

# One data root, read through catalogs with different modes.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/fmodes' AS w (TYPE fabricator, PROVIDER 'delta', column_mapping 'none');

statement ok
CREATE TABLE w.main.t AS
SELECT i AS id, 'name' || (i % 7) AS name, (i % 5) * 1.5 AS amt,
       CASE WHEN i % 11 = 0 THEN NULL ELSE 'g' || (i % 3) END AS grp
FROM range(1, 501) AS r(i);

statement ok
CREATE TABLE w.main.dim AS SELECT * FROM (VALUES (10), (250), (499)) d(id);

# ---- EXACT mode ('all') on the CODEC path: erased statics must be applied by the scan ----
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/fmodes' AS f_all (TYPE fabricator, PROVIDER 'delta', column_mapping 'none', pushdown_filters 'all');

query I
SELECT count(*) FROM f_all.main.t WHERE id = 250;
----
1

query IT
SELECT id, name FROM f_all.main.t WHERE id > 495 ORDER BY id;
----
496	name6
497	name0
498	name1
499	name2
500	name3

query I
SELECT count(*) FROM f_all.main.t WHERE grp IS NULL;
----
45

query I
SELECT count(*) FROM f_all.main.t WHERE name IN ('name0', 'name3') AND amt > 1.0;
----
114

query I
SELECT count(*) FROM f_all.main.t WHERE id BETWEEN 100 AND 199 AND (grp = 'g1' OR grp IS NULL);
----
40

# hash-join dynamic filters flow to the scan and the join result is exact
query I
SELECT count(*) FROM f_all.main.t b JOIN f_all.main.dim d ON b.id = d.id;
----
3

# ---- 'dynamic' is an accepted alias of 'all' on this provider ----
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/fmodes' AS f_dyn (TYPE fabricator, PROVIDER 'delta', column_mapping 'none', pushdown_filters 'dynamic');

query I
SELECT count(*) FROM f_dyn.main.t WHERE id = 250 OR id = 10;
----
2

# ---- 'static' (the codec default) and 'none' (pure fallback) agree with exact mode ----
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/fmodes' AS f_static (TYPE fabricator, PROVIDER 'delta', column_mapping 'none', pushdown_filters 'static');

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/fmodes' AS f_none (TYPE fabricator, PROVIDER 'delta', column_mapping 'none', pushdown_filters 'none');

query III
SELECT (SELECT count(*) FROM f_all.main.t   WHERE id % 2 = 0 AND grp = 'g1'),
       (SELECT count(*) FROM f_static.main.t WHERE id % 2 = 0 AND grp = 'g1'),
       (SELECT count(*) FROM f_none.main.t   WHERE id % 2 = 0 AND grp = 'g1');
----
75	75	75

# ---- exact mode composes with the rowid (DML) scans: the WHERE filters the target rows exactly ----
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/fmodes2' AS m (TYPE fabricator, PROVIDER 'delta', column_mapping 'none', pushdown_filters 'all');

statement ok
CREATE TABLE m.main.d AS SELECT i AS id, 'v' || i AS v FROM range(1, 11) AS r(i);

statement ok
DELETE FROM m.main.d WHERE id > 8;

statement ok
UPDATE m.main.d SET v = 'changed' WHERE id = 3;

query IT
SELECT id, v FROM m.main.d WHERE v = 'changed' OR id >= 7 ORDER BY id;
----
3	changed
7	v7
8	v8

# ---- native_read keeps its exact default; 'static' downgrades it cleanly ----
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/fmodes' AS n_static (TYPE fabricator, PROVIDER 'delta', column_mapping 'none', native_read true, pushdown_filters 'static');

query I
SELECT count(*) FROM n_static.main.t WHERE id = 250;
----
1

# ============================================================================================
# The CODEC engine under 'all' (superset_filter_pushdown since 2026-11-09): the filter is ERASED from
# the plan, engineered-wood prunes with it, and the host re-applies it to every chunk the scan returns.
# ============================================================================================

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/fmodes' AS codec_x (TYPE fabricator, PROVIDER 'engineeredwooddelta', column_mapping 'none', pushdown_filters 'all');

# ⚠⚠ POSITIVE CONTROL, and the row counts below are worthless without it: DuckDB ERASES the filter
# from the plan — there is NO `FILTER` operator, the predicate sits on the scan — so it will NOT
# re-apply above it, and the only thing left that applies it is the scan's own re-application. A
# `static` catalog plans the same query with a FILTER above the scan instead.
# ⚠ EXPLAIN cannot be a subquery source, hence the <REGEX>: form on the physical_plan row.
# ⚠ DuckDB 2.0 RE-RENDERS EXPLAIN: operator titles are title-cased (`SEQ_SCAN` -> `Seq Scan`,
# `PROJECTION` -> `Projection`) and a filter is spaced (`g=3` -> `g = 3`). The PLAN is unchanged; only
# its text is. A plan that stopped being pushed down would still fail this.
query II
EXPLAIN SELECT count(*) FROM codec_x.main.t WHERE id > 495;
----
physical_plan	<REGEX>:.*FABRICATOR_SCAN.*Filters: id > 495.*

# ...and the answer is exact, so it really did run.
query IT
SELECT id, name FROM codec_x.main.t WHERE id > 495 ORDER BY id;
----
496	name6
497	name0
498	name1
499	name2
500	name3

query I
SELECT count(*) FROM codec_x.main.t WHERE grp IS NULL;
----
45

query II
SELECT count(*), sum(id) FROM codec_x.main.t WHERE name IN ('name0', 'name3') AND amt > 1.0;
----
114	28500

# ⚠⚠ BOUND ARROW INPUTS MUST LEAVE NOTHING BEHIND. A host query binds a named Arrow input as a view
# (the native reader's file list and deletion vectors — read above, after m's DELETE — HostBatchFilter's
# `__fabricator_scan_batch` for a native read's buffered rows, the sort input, …). Until 2026-09-03 that
# was duckdb_arrow_scan, which ends in CreateView(name, replace, temporary: FALSE) — an ordinary CATALOG
# view: MEASURED then, three filtered codec SELECTs (the per-batch host query, gone since 2026-11-09)
# left THREE views in the user's own `memory.main`, and reading one afterwards SEGFAULTED, because the
# stream it points at was released when its query finished. They are TEMPORARY views now, dying with
# the fresh connection. Broad on purpose — `__fab%` covers every bound-input prefix in the tree, so it
# also catches a future path that registers one and forgets to clean up.
query I
SELECT count(*) FROM duckdb_views() WHERE starts_with(view_name, '__fab');
----
0

# ---- unknown mode is a clean error ----
statement error
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/fmodes' AS bad (TYPE fabricator, PROVIDER 'delta', pushdown_filters 'sometimes');
----
pushdown_filters: unknown mode
