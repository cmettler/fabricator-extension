# name: test/verify_delta_clustered_optimize.test
# description: CLUSTERED OPTIMIZE — on a clustering-declared table (the delta.clustering domain a SORTED BY
#              create writes, else the fabricator.sortedBy property) OPTIMIZE RECLUSTERS instead of
#              bin-packing: ONE host query reads every active file (DV rows excluded), globally re-orders
#              (hilbert_index over ntile range-buckets for 2+ keys — Spark's range_partition_id shape — or a
#              plain ORDER BY for one key) and COPYs the clustered output; ONE dataChange=false commit swaps
#              the active set, tagging add.clusteringProvider = "liquid" (the OSS Spark value). Row-tracking
#              stable ids are preserved (materialized into the clustered file). Requires native_write;
#              partitioned / identity / variant / nested-mapped tables keep the bin-pack fallback.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

# ============================================================================
# 1. two-key hilbert recluster (default name mapping, native_write + native_read)
# ============================================================================

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/clustopt' AS lake (TYPE fabricator, PROVIDER 'delta', native_read true, native_write true);

# GLOBALLY UNIQUE values in both cluster keys ((r*91)%15000 over r in [0,15000) is a bijection —
# gcd(91,15000)=1) so the hilbert-order pin below can recompute the ntile buckets deterministically
# (tied values would make the ntile assignment order-dependent).
statement ok
CREATE TABLE lake.main.c1 SORTED BY (grp, id) AS
SELECT r AS grp, (r * 91) % 15000 AS id, 'v' || r AS v FROM range(5000) t(r);

statement ok
INSERT INTO lake.main.c1 SELECT r, (r * 91) % 15000, 'v' || r FROM range(5000, 10000) t(r);

statement ok
INSERT INTO lake.main.c1 SELECT r, (r * 91) % 15000, 'v' || r FROM range(10000, 15000) t(r);

# three files (CTAS + 2 appends), each individually sorted but globally interleaved
query I
SELECT count(DISTINCT rowid >> 40) FROM lake.main.c1;
----
3

# a DV delete before the recluster — the deleted rows must NOT resurrect
statement ok
DELETE FROM lake.main.c1 WHERE grp % 100 = 7;

query I
SELECT count(*) FROM lake.main.c1;
----
14850

# capture a known row's stable id pre-recluster (grp is unique => one row)
query I
SELECT __delta_row_id FROM lake.main.c1 WHERE grp = 4242;
----
4242

# ----------------------------------------------------------------------------
# RECLUSTER
# ----------------------------------------------------------------------------

query I
SELECT fabricator_exec('lake', 'OPTIMIZE main.c1');
----
0

# data exact, deleted rows still absent
query II
SELECT count(*), count(*) FILTER (WHERE grp % 100 = 7) FROM lake.main.c1;
----
14850	0

# ONE active file now
query I
SELECT count(DISTINCT rowid >> 40) FROM lake.main.c1;
----
1

# the stable row id survived the rewrite (materialized into the clustered file)
query I
SELECT __delta_row_id FROM lake.main.c1 WHERE grp = 4242;
----
4242

# the commit is a REWRITE: operation OPTIMIZE, dataChange=false on removes AND adds, clusteringProvider
# tagged on the add (the OSS Spark "liquid" value)
query I
SELECT count(*) FROM fabricator_delta_snapshots('lake', 'main.c1') WHERE operation = 'OPTIMIZE';
----
1

query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/clustopt/c1/_delta_log/*.json')
WHERE content LIKE '%"clusteringProvider":"liquid"%'
  AND content LIKE '%"dataChange":false%';
----
1

# no OTHER commit carries a clusteringProvider (only the recluster tags)
query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/clustopt/c1/_delta_log/*.json')
WHERE content LIKE '%"clusteringProvider"%';
----
1

# HILBERT ORDER inside the clustered file: recompute the same ntile(2^15) range-buckets over the same
# (unique-keyed) rows — the file's row order (rowid = position) must be nondecreasing in hilbert_index.
query I
WITH h AS (
    SELECT rowid AS rid,
           hilbert_index([ntile(32768) OVER (ORDER BY grp) - 1,
                          ntile(32768) OVER (ORDER BY id) - 1], 15) AS hv
    FROM lake.main.c1
)
SELECT count(*) FROM (SELECT hv, lag(hv) OVER (ORDER BY rid) AS ph FROM h) WHERE ph IS NOT NULL AND ph > hv;
----
0

# re-OPTIMIZE on the single DV-less clustered file is a NO-OP (no new commit — Spark parity):
# the OPTIMIZE commit stays the LATEST version and stays the only one
query I
SELECT fabricator_exec('lake', 'OPTIMIZE main.c1');
----
0

query II
SELECT count(*) FILTER (WHERE operation = 'OPTIMIZE'),
       count(*) FILTER (WHERE operation = 'OPTIMIZE' AND version = (SELECT max(version) FROM fabricator_delta_snapshots('lake', 'main.c1')))
FROM fabricator_delta_snapshots('lake', 'main.c1');
----
1	1

# the old files are tombstones — VACUUM sweeps them, exactly one data file remains on disk
# (a non-dry-run VACUUM also writes the VACUUM START/END history commits)
query I
SELECT fabricator_exec('lake', 'VACUUM main.c1 RETAIN 0 HOURS');
----
3

query I
SELECT count(*) FROM glob('${FABRICATOR_DELTA_WRITE_DIR}/clustopt/c1/*.parquet');
----
1

# ============================================================================
# 2. single-key recluster = strict lexicographic order
# ============================================================================

statement ok
CREATE TABLE lake.main.c2 SORTED BY (id) AS
SELECT (r * 91) % 3000 AS id, r AS payload FROM range(3000) t(r);

statement ok
INSERT INTO lake.main.c2 SELECT (r * 17) % 3000, r FROM range(3000, 6000) t(r);

query I
SELECT fabricator_exec('lake', 'OPTIMIZE main.c2');
----
0

query I
SELECT count(DISTINCT rowid >> 40) FROM lake.main.c2;
----
1

# strictly nondecreasing on id in file order (tie-tolerant)
query I
WITH o AS (SELECT id, lag(id) OVER (ORDER BY rowid) AS p FROM lake.main.c2)
SELECT count(*) FROM o WHERE p IS NOT NULL AND p > id;
----
0

query I
SELECT count(*) FROM lake.main.c2;
----
6000

# ============================================================================
# 3. fabricator.sortedBy WITHOUT the domain (older tables) also drives the recluster
# ============================================================================

statement ok
CREATE TABLE lake.main.c3 AS SELECT (r * 7) % 500 AS k, r AS payload FROM range(2000) t(r);

statement ok
INSERT INTO lake.main.c3 SELECT (r * 13) % 500, r FROM range(2000, 4000) t(r);

statement ok
SELECT * FROM fabricator_delta_set_tblproperties('lake', 'main.c3', '{"fabricator.sortedBy":"[\"k\"]"}');

query I
SELECT fabricator_exec('lake', 'OPTIMIZE main.c3');
----
0

query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/clustopt/c3/_delta_log/*.json')
WHERE content LIKE '%"clusteringProvider":"liquid"%';
----
1

query I
WITH o AS (SELECT k, lag(k) OVER (ORDER BY rowid) AS p FROM lake.main.c3)
SELECT count(*) FROM o WHERE p IS NOT NULL AND p > k;
----
0

# ============================================================================
# 4. PARTITIONED tables: SORTED BY + PARTITIONED BY compose — the create declares NO
#    delta.clustering (liquid clustering is unpartitioned by definition; declaring
#    both crashed Spark's clustering-info paths), and OPTIMIZE reclusters PER
#    PARTITION (the Databricks ZORDER-on-partitioned analog): each partition's files
#    rewrite into ordered file(s) in that partition's Hive dir, values exact, NO
#    clusteringProvider tag. This section runs under native_read + native_write,
#    so it also pins the once-crashing reader-seam path — and the partition-value
#    exactness pins the (fixed) all-rows-read-one-partition corruption.
# ============================================================================

statement ok
CREATE TABLE lake.main.p1 PARTITIONED BY (region) SORTED BY (id) AS
SELECT ['US','EU','APAC'][(r % 3) + 1] AS region, (r * 91) % 600 AS id FROM range(600) t(r);

statement ok
INSERT INTO lake.main.p1 SELECT ['US','EU','APAC'][(r % 3) + 1], (r * 17) % 600 FROM range(600, 1200) t(r);

# the partitioned create declares NEITHER the clustering domain NOR the feature
query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/clustopt/p1/_delta_log/00000000000000000000.json')
WHERE content LIKE '%delta.clustering%' OR content LIKE '%"clustering"%';
----
0

query TI
SELECT region, count(*) FROM lake.main.p1 GROUP BY region ORDER BY region;
----
APAC	400
EU	400
US	400

query I
SELECT fabricator_exec('lake', 'OPTIMIZE main.p1');
----
0

# partition values EXACT after the recluster (the corruption pin) + one file per partition
query TI
SELECT region, count(*) FROM lake.main.p1 GROUP BY region ORDER BY region;
----
APAC	400
EU	400
US	400

query II
SELECT count(DISTINCT rowid >> 40), count(DISTINCT region) FROM lake.main.p1;
----
3	3

# each partition's file is ORDERED on the cluster key (the recluster, not just bin-pack)
query I
WITH o AS (SELECT id, lag(id) OVER (PARTITION BY rowid >> 40 ORDER BY rowid) AS p FROM lake.main.p1)
SELECT count(*) FROM o WHERE p IS NOT NULL AND p > id;
----
0

# the rewrite commit: OPTIMIZE operation, dataChange=false — but NO clusteringProvider
# (no liquid declaration exists for partitioned tables)
query I
SELECT count(*) FROM fabricator_delta_snapshots('lake', 'main.p1') WHERE operation = 'OPTIMIZE';
----
1

query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/clustopt/p1/_delta_log/*.json')
WHERE content LIKE '%"clusteringProvider"%';
----
0

# PARTIAL recluster: a fresh insert fragments ONE partition only ('US'); re-OPTIMIZE rewrites
# just that partition — the other partitions' files stay ACTIVE (their paths keep their ordinals)
statement ok
INSERT INTO lake.main.p1 SELECT 'US', (r * 7) % 600 FROM range(1200, 1500) t(r);

query I
SELECT fabricator_exec('lake', 'OPTIMIZE main.p1');
----
0

# the second OPTIMIZE commit removed exactly the US partition's 2 files and added 1
query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/clustopt/p1/_delta_log/*.json')
WHERE content LIKE '%"operation":"OPTIMIZE"%'
  AND (length(content) - length(replace(content, '"remove":', ''))) / length('"remove":') = 2
  AND (length(content) - length(replace(content, '"add":', ''))) / length('"add":') = 1;
----
1

query TI
SELECT region, count(*) FROM lake.main.p1 GROUP BY region ORDER BY region;
----
APAC	400
EU	400
US	700

query I
WITH o AS (SELECT id, lag(id) OVER (PARTITION BY rowid >> 40 ORDER BY rowid) AS p FROM lake.main.p1)
SELECT count(*) FROM o WHERE p IS NOT NULL AND p > id;
----
0

# ============================================================================
# 5. MULTI-FILE recluster: delta.targetFileSize splits the clustered output into
#    contiguous cluster ranges — sequential per-file COPYs cut at batch boundaries
#    (DuckDB's own FILE_SIZE_BYTES rotation does NOT preserve order — parallel sink)
# ============================================================================

statement ok
CREATE TABLE lake.main.m1 SORTED BY (id) AS
SELECT (r * 91) % 40000 AS id, 'x' || r AS v FROM range(40000) t(r);

statement ok
INSERT INTO lake.main.m1 SELECT (r * 17) % 40000, 'y' || r FROM range(40000, 80000) t(r);

statement ok
SELECT * FROM fabricator_delta_set_tblproperties('lake', 'main.m1', '{"delta.targetFileSize":"100kb"}');

query I
SELECT fabricator_exec('lake', 'OPTIMIZE main.m1');
----
0

query II
SELECT count(*), count(DISTINCT rowid >> 40) > 1 FROM lake.main.m1;
----
80000	true

# EVERY output file carries the clusteringProvider tag (adds in the OPTIMIZE commit == active files)
query I
SELECT (length(content) - length(replace(content, '"clusteringProvider"', ''))) / length('"clusteringProvider"')
       = (SELECT count(DISTINCT rowid >> 40) FROM lake.main.m1)
FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/clustopt/m1/_delta_log/*.json')
WHERE content LIKE '%"clusteringProvider"%';
----
true

# per-file order is nondecreasing (tie-tolerant)
query I
WITH o AS (SELECT id, lag(id) OVER (PARTITION BY rowid >> 40 ORDER BY rowid) AS p FROM lake.main.m1)
SELECT count(*) FROM o WHERE p IS NOT NULL AND p > id;
----
0

# the files are CONTIGUOUS cluster ranges: no two files' [min,max] strictly interleave
# (a shared boundary value from a tie is a touch, not an overlap)
query I
WITH r AS (SELECT rowid >> 40 AS f, min(id) AS mn, max(id) AS mx FROM lake.main.m1 GROUP BY 1)
SELECT count(*) FROM r a JOIN r b ON a.f < b.f AND a.mn < b.mx AND b.mn < a.mx;
----
0

# ============================================================================
# 6. ZCUBE INCREMENTAL recluster: clustered outputs carry tags[ZCUBE_ID] (+ the
#    keys in ZCUBE_ZORDER_BY); a STABLE cube (>= fabricator.targetCubeSize,
#    clustered by the current keys) is never rewritten — OPTIMIZE cost tracks NEW
#    data. OPTIMIZE <t> FULL ignores cubes; changing the cluster keys invalidates
#    old cubes (their files re-enter as candidates).
# ============================================================================

statement ok
CREATE TABLE lake.main.z1 SORTED BY (id) AS
SELECT (r * 91) % 9000 AS id, r AS payload FROM range(3000) t(r);

statement ok
INSERT INTO lake.main.z1 SELECT (r * 91) % 9000, r FROM range(3000, 6000) t(r);

statement ok
INSERT INTO lake.main.z1 SELECT (r * 91) % 9000, r FROM range(6000, 9000) t(r);

# a tiny cube threshold so a one-file cube counts STABLE (observable incremental exclusion)
statement ok
SELECT * FROM fabricator_delta_set_tblproperties('lake', 'main.z1', '{"fabricator.targetCubeSize":"1kb"}');

query I
SELECT fabricator_exec('lake', 'OPTIMIZE main.z1');
----
0

# one clustered file = cube A; the commit tags it
query II
SELECT count(*), count(DISTINCT rowid >> 40) FROM lake.main.z1;
----
9000	1

query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/clustopt/z1/_delta_log/*.json')
WHERE content LIKE '%"operation":"OPTIMIZE"%' AND content LIKE '%ZCUBE_ID%';
----
1

# fresh appends fragment; the INCREMENTAL rewrite touches ONLY them — cube A stays active
statement ok
INSERT INTO lake.main.z1 SELECT (r * 91) % 9000, r FROM range(9000, 12000) t(r);

statement ok
INSERT INTO lake.main.z1 SELECT (r * 91) % 9000, r FROM range(12000, 15000) t(r);

query I
SELECT fabricator_exec('lake', 'OPTIMIZE main.z1');
----
0

# TWO active files now: cube A (untouched) + cube B (the merged new data) — a FULL recluster
# would have produced one
query II
SELECT count(*), count(DISTINCT rowid >> 40) FROM lake.main.z1;
----
15000	2

query I
SELECT count(*) FROM fabricator_delta_snapshots('lake', 'main.z1') WHERE operation = 'OPTIMIZE';
----
2

# both cubes are internally ordered on the cluster key
query I
WITH o AS (SELECT id, lag(id) OVER (PARTITION BY rowid >> 40 ORDER BY rowid) AS p FROM lake.main.z1)
SELECT count(*) FROM o WHERE p IS NOT NULL AND p > id;
----
0

# all cubes stable + nothing new => NO-OP (no third OPTIMIZE commit)
query I
SELECT fabricator_exec('lake', 'OPTIMIZE main.z1');
----
0

query I
SELECT count(*) FROM fabricator_delta_snapshots('lake', 'main.z1') WHERE operation = 'OPTIMIZE';
----
2

# OPTIMIZE FULL ignores cube identities: everything reclusters into ONE file
query I
SELECT fabricator_exec('lake', 'OPTIMIZE main.z1 FULL');
----
0

query II
SELECT count(*), count(DISTINCT rowid >> 40) FROM lake.main.z1;
----
15000	1

query I
SELECT count(*) FROM fabricator_delta_snapshots('lake', 'main.z1') WHERE operation = 'OPTIMIZE';
----
3

# NOTE: on a SORTED BY-created table the delta.clustering DOMAIN is the authoritative key source —
# changing fabricator.sortedBy does NOT change its cluster keys (Spark parity: the domain is altered
# by CLUSTER BY DDL, not a property). Key-change invalidation is therefore pinned on a PROPERTY-ONLY
# table (no domain): changing the keys makes old cubes STALE (ZCUBE_ZORDER_BY mismatch) — with new
# data present their files re-enter as candidates and the rewrite orders by the NEW key.
statement ok
CREATE TABLE lake.main.z2 AS SELECT (r * 91) % 4000 AS id, r AS payload FROM range(4000) t(r);

statement ok
INSERT INTO lake.main.z2 SELECT (r * 91) % 4000, r FROM range(4000, 8000) t(r);

statement ok
SELECT * FROM fabricator_delta_set_tblproperties('lake', 'main.z2', '{"fabricator.sortedBy":"[\"id\"]","fabricator.targetCubeSize":"1kb"}');

query I
SELECT fabricator_exec('lake', 'OPTIMIZE main.z2');
----
0

query II
SELECT count(*), count(DISTINCT rowid >> 40) FROM lake.main.z2;
----
8000	1

statement ok
SELECT * FROM fabricator_delta_set_tblproperties('lake', 'main.z2', '{"fabricator.sortedBy":"[\"payload\"]"}');

statement ok
INSERT INTO lake.main.z2 SELECT (r * 91) % 4000, r FROM range(8000, 9000) t(r);

query I
SELECT fabricator_exec('lake', 'OPTIMIZE main.z2');
----
0

query II
SELECT count(*), count(DISTINCT rowid >> 40) FROM lake.main.z2;
----
9000	1

query I
WITH o AS (SELECT payload, lag(payload) OVER (PARTITION BY rowid >> 40 ORDER BY rowid) AS p FROM lake.main.z2)
SELECT count(*) FROM o WHERE p IS NOT NULL AND p > payload;
----
0

# ============================================================================
# 7. ALTER TABLE SET/RESET SORTED BY — the domain re-key DDL (ALTER CLUSTER BY
#    analog): ONE commit updates fabricator.sortedBy AND (unpartitioned) the
#    delta.clustering domain, with the WRITER-ONLY protocol upgrade when needed.
#    Re-keying a DOMAIN table now works (the earlier property-only limitation);
#    old cubes go stale (ZCUBE_ZORDER_BY mismatch) and recluster incrementally.
# ============================================================================

statement ok
CREATE TABLE lake.main.a1 AS SELECT (r * 91) % 4000 AS id, r AS payload FROM range(4000) t(r);

statement ok
INSERT INTO lake.main.a1 SELECT (r * 91) % 4000, r FROM range(4000, 8000) t(r);

# declare clustering by DDL on a plain table — property + domain + writer-only protocol upgrade
statement ok
ALTER TABLE lake.main.a1 SET SORTED BY (id);

query T
SELECT value FROM fabricator_delta_tblproperties('lake', 'main.a1') WHERE property = 'fabricator.sortedBy';
----
["id"]

query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/clustopt/a1/_delta_log/*.json')
WHERE content LIKE '%delta.clustering%' AND content LIKE '%"operation":"SET SORTED BY"%';
----
1

statement ok
SELECT * FROM fabricator_delta_set_tblproperties('lake', 'main.a1', '{"fabricator.targetCubeSize":"1kb"}');

query I
SELECT fabricator_exec('lake', 'OPTIMIZE main.a1');
----
0

query II
SELECT count(*), count(DISTINCT rowid >> 40) FROM lake.main.a1;
----
8000	1

# an INSERT now re-applies the DDL-declared order to its file
statement ok
INSERT INTO lake.main.a1 SELECT (r * 17) % 4000, r FROM range(8000, 9000) t(r);

query I
WITH o AS (SELECT id, lag(id) OVER (PARTITION BY rowid >> 40 ORDER BY rowid) AS p FROM lake.main.a1)
SELECT count(*) FROM o WHERE p IS NOT NULL AND p > id;
----
0

# RE-KEY the DOMAIN table by DDL (the case fabricator.sortedBy alone could not change): the old cube
# goes stale and the next OPTIMIZE reorders EVERYTHING by the new key
statement ok
ALTER TABLE lake.main.a1 SET SORTED BY (payload);

query I
SELECT fabricator_exec('lake', 'OPTIMIZE main.a1');
----
0

query II
SELECT count(*), count(DISTINCT rowid >> 40) FROM lake.main.a1;
----
9000	1

query I
WITH o AS (SELECT payload, lag(payload) OVER (PARTITION BY rowid >> 40 ORDER BY rowid) AS p FROM lake.main.a1)
SELECT count(*) FROM o WHERE p IS NOT NULL AND p > payload;
----
0

# RESET SORTED BY: property + domain removed (one commit); the table is plain again
statement ok
ALTER TABLE lake.main.a1 RESET SORTED BY;

query I
SELECT count(*) FROM fabricator_delta_tblproperties('lake', 'main.a1') WHERE property = 'fabricator.sortedBy';
----
0

query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/clustopt/a1/_delta_log/*.json')
WHERE content LIKE '%"operation":"RESET SORTED BY"%' AND content LIKE '%"removed":true%';
----
1

# guards: unknown column; DESC (clustering has no direction); SET PARTITIONED BY (needs a full rewrite)
statement error
ALTER TABLE lake.main.a1 SET SORTED BY (nope);
----

statement error
ALTER TABLE lake.main.a1 SET SORTED BY (id DESC);
----

statement error
ALTER TABLE lake.main.a1 SET PARTITIONED BY (id);
----

# partitioned table: SET SORTED BY takes the PROPERTY only (ordered writes) — never the domain
statement ok
ALTER TABLE lake.main.p1 SET SORTED BY (id);

query T
SELECT value FROM fabricator_delta_tblproperties('lake', 'main.p1') WHERE property = 'fabricator.sortedBy';
----
["id"]

query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/clustopt/p1/_delta_log/*.json')
WHERE content LIKE '%delta.clustering%';
----
0

# ============================================================================
# 8. a plain (non-clustered) table still bin-packs as before
# ============================================================================

statement ok
CREATE TABLE lake.main.n1 AS SELECT r AS id FROM range(1000) t(r);

statement ok
INSERT INTO lake.main.n1 SELECT r FROM range(1000, 2000) t(r);

query I
SELECT fabricator_exec('lake', 'OPTIMIZE main.n1');
----
0

query I
SELECT count(*) FROM lake.main.n1;
----
2000

query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/clustopt/n1/_delta_log/*.json')
WHERE content LIKE '%"clusteringProvider"%';
----
0

statement ok
DETACH lake;

# ---------------------------------------------------------------------------------------------------------
# §8. A clustering-declared table on a catalog WITHOUT the native writer bin-packs — and now SAYS SO.
#     The recluster is one host query whose global ORDER BY relies on DuckDB's spilling sort (engineered-wood
#     has no external sort), so it cannot be served by the codec writer. That fallback was SILENT: the user
#     asked for clustering via SORTED BY and got bin-packing with no diagnostic. It matters more now that the
#     PROVIDER spelling alone can decide whether the native writer is on.
# ---------------------------------------------------------------------------------------------------------
# native_write false EXPLICITLY rather than by provider name: what this section observes is the WRITER being
# absent, so it should keep testing that even if the name -> profile mapping changes.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/clustopt_codec' AS clake
  (TYPE fabricator, PROVIDER 'delta', native_read false, native_write false);

# SORTED BY persists fabricator.sortedBy (and, unpartitioned, declares the delta.clustering domain), so this
# table DOES declare clustering even though the catalog cannot recluster it.
statement ok
CREATE TABLE clake.main.cw SORTED BY (grp, id) AS
  SELECT (i % 4) AS grp, i AS id FROM range(200) tbl(i);

statement ok
INSERT INTO clake.main.cw SELECT (i % 4), i + 1000 FROM range(200) tbl(i);

statement ok
CALL enable_logging(level := 'debug', storage := 'memory');

# `fabricator_exec` is a SCALAR function — `CALL` fails with "Table Function ... does not exist".
query I
SELECT fabricator_exec('clake', 'OPTIMIZE main.cw');
----
0

# the warning names the declared columns AND the requirement, rather than failing silently
query I
SELECT count(*) FROM duckdb_logs
WHERE message LIKE 'delta optimize %declares clustering by [grp,id]%REQUIRES native_write%';
----
1

# it still compacted (bin-pack), and did NOT tag the adds as clustered — the fallback is real, not cosmetic
query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/clustopt_codec/cw/_delta_log/*.json')
WHERE content LIKE '%"clusteringProvider"%';
----
0

query I
SELECT count(*) FROM clake.main.cw;
----
400

statement ok
DETACH clake;
