# name: test/verify_delta_catalog_dynamic_filter.test
# description: Delta folder-catalog `native_read true` — runtime filter pushdown into the native read_parquet
#              scan (docs/multifile-delta.md §"Batch 2 slice 2"). filter_pushdown=true (via the catalog's
#              exact_filter_pushdown capability) makes DuckDB (a) deliver hash-join DYNAMIC filters to the
#              scan and (b) stop re-applying the pushed static filters — both applied EXACTLY as a
#              read_parquet WHERE (target is DuckDB, so 1:1). This asserts correctness; the actual pushed
#              WHERE is proven via duckdb_logs (the C# native reader logs each per-file read_parquet SQL).
#              Set FABRICATOR_DELTA_WRITE_DIR (writable). Local FS.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catdynfilter' AS lake (TYPE fabricator, PROVIDER 'delta', native_read true);

statement ok
CREATE TABLE lake.main.big AS SELECT i AS id, 'v' || i AS name FROM range(1, 1001) AS r(i);

statement ok
CREATE TABLE lake.main.dim AS SELECT * FROM (VALUES (3), (7), (42)) AS d(id);

# ---- static filter: under filter_pushdown=true the WHERE is erased from the plan and applied EXACTLY by the
#      scan. Includes a string <> (now pushed exactly since the read_parquet target is DuckDB). ----
query IT
SELECT id, name FROM lake.main.big WHERE id > 997 AND name <> 'v999' ORDER BY id;
----
998	v998
1000	v1000

# equality + IN + range, exact
query I
SELECT id FROM lake.main.big WHERE id IN (10, 20, 30) AND id >= 20 ORDER BY id;
----
20
30

# ---- dynamic (hash-join) filter: DuckDB pushes the build-side key set/range into big's native scan ----
query IT
SELECT b.id, b.name FROM lake.main.big b JOIN lake.main.dim d ON b.id = d.id ORDER BY b.id;
----
3	v3
7	v7
42	v42

# join result is correct under aggregation too
query I
SELECT count(*) FROM lake.main.big b JOIN lake.main.dim d ON b.id = d.id;
----
3

# ---- prove the filters actually reached read_parquet (not just re-applied above the scan) ----
statement ok
CALL enable_logging(level := 'debug', storage := 'memory');

# re-run the join so its per-file read_parquet SQL is logged
query I
SELECT count(*) FROM lake.main.big b JOIN lake.main.dim d ON b.id = d.id;
----
3

# the dynamic join bound (an IN-list and/or a min/max range on id) was spliced into the read_parquet WHERE
query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type = 'Fabricator.Delta.Native' AND message LIKE '%read_parquet%WHERE%"id"%';
----
true

# and NO leaked "optional:" prefix (OptionalFilter children are unwrapped)
query I
SELECT count(*) FROM duckdb_logs
WHERE type = 'Fabricator.Delta.Native' AND message LIKE '%optional:%';
----
0

# ---- A BUILD SIDE PAST dynamic_or_filter_threshold (50 keys). DuckDB then passes the probe scan only a
#      prefix-range filter (a bitmap, no SQL form). The scan used to DROP it, so every larger join (all of TPC-H)
#      read the whole table into the plan; now the inner read_parquet query evaluates it through
#      fabricator_join_filter(<id>, col). 2026-11-08. ----

statement ok
CREATE TABLE lake.main.big2 AS SELECT CASE WHEN i % 1000 = 0 THEN NULL ELSE i END AS id, i % 7 AS g
FROM range(1, 400001) AS r(i);

statement ok
CREATE TABLE lake.main.dim2 AS SELECT i * 199 AS id FROM range(1, 2001) AS r(i);

statement ok
CALL truncate_duckdb_logs();

# one data file: the per-file SQL. 2000 keys (multiples of 199); the two that are also multiples of 1000 are NULL
# in big2 and must not match. Expected values computed by plain DuckDB over the same rows.
query III
SELECT count(*), sum(b.id), sum(b.g) FROM lake.main.big2 b JOIN lake.main.dim2 d ON b.id = d.id;
----
1998	397602000	5997

query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type = 'Fabricator.Delta.Native' AND message LIKE '%read_parquet%fabricator_join_filter(%"id"%';
----
true

# ...and beside the call the build side's key range as a plain condition: the function hides the key set from the
# parquet reader, the range lets it skip whole row groups by their statistics (the build keys span 199..398000)
query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type = 'Fabricator.Delta.Native' AND message LIKE '%("id" >= 199) AND ("id" <= 398000)) AND fabricator_join_filter(%';
----
true

# a second file: the batched form carries it too
statement ok
INSERT INTO lake.main.big2 SELECT i AS id, i % 7 AS g FROM range(390001, 390401) AS r(i);

statement ok
CALL truncate_duckdb_logs();

query II
SELECT count(*), sum(b.id) FROM lake.main.big2 b JOIN lake.main.dim2 d ON b.id = d.id;
----
2000	398382279

query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type = 'Fabricator.Delta.Native' AND message LIKE '%read_parquet%fabricator_join_filter(%"id"%';
----
true

# ...and it FILTERS: the rows big2's scan hands to the join, from the query profile. Without the filter the scan
# passes all 400400 rows up (the answer is the same either way, which is why this needs its own assertion); with
# it about the 2000 that match. dim2's scan is the other FABRICATOR_SCAN (2000 rows).
statement ok
PRAGMA enable_profiling = 'json';

statement ok
PRAGMA profiling_output = '${FABRICATOR_DELTA_WRITE_DIR}/join_filter_profile.json';

statement ok
SELECT count(*) FROM lake.main.big2 b JOIN lake.main.dim2 d ON b.id = d.id;

statement ok
PRAGMA disable_profiling;

query II
SELECT count(*), max(CAST(r AS BIGINT)) < 10000
FROM (SELECT unnest(regexp_extract_all(content, '(?s)"Function": "FABRICATOR_SCAN".*?"intermediate_rows": (\d+)', 1)) AS r
      FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/join_filter_profile.json'));
----
2	true

# the preserved side of an outer join must keep every row: big2 LEFT JOIN dim2 returns all 400400 rows
query I
SELECT count(*) FROM lake.main.big2 b LEFT JOIN lake.main.dim2 d ON b.id = d.id;
----
400400

# and a semi join (IN) through the same filter
query I
SELECT count(*) FROM lake.main.big2 WHERE id IN (SELECT id FROM lake.main.dim2);
----
2000

# the switch turns it off (and with it the key lists SQL Server receives): no call in the inner query, same answer
statement ok
SET fabricator_join_key_lists = false;

statement ok
CALL truncate_duckdb_logs();

query II
SELECT count(*), sum(b.id) FROM lake.main.big2 b JOIN lake.main.dim2 d ON b.id = d.id;
----
2000	398382279

query I
SELECT count(*) FROM duckdb_logs
WHERE type = 'Fabricator.Delta.Native' AND message LIKE '%fabricator_join_filter(%';
----
0

statement ok
RESET fabricator_join_key_lists;

# ---- A key the prefix-range filter does not cover (random strings, a DOUBLE, ...): DuckDB hands the scan a BLOOM
#      filter instead. It has no SQL form either; the inner query evaluates it through the same
#      fabricator_join_filter(<id>, col), hashing the keys as DuckDB's own lookup does. Expected values computed by
#      plain DuckDB over the same rows. 2026-11-08. ----

statement ok
CREATE TABLE lake.main.big3 AS SELECT CASE WHEN i % 1000 = 0 THEN NULL ELSE md5(i::VARCHAR) END AS h, i % 7 AS g,
(i::DOUBLE / 4)::FLOAT AS f FROM range(1, 400001) AS r(i);

statement ok
CREATE TABLE lake.main.dim3 AS SELECT md5((i * 199)::VARCHAR) AS h, (i * 199)::DOUBLE / 4 AS f
FROM range(1, 2001) AS r(i) UNION ALL SELECT NULL, NULL;

statement ok
CALL truncate_duckdb_logs();

query II
SELECT count(*), sum(b.g) FROM lake.main.big3 b JOIN lake.main.dim3 d ON b.h = d.h;
----
1998	5997

query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type = 'Fabricator.Delta.Native' AND message LIKE '%read_parquet%fabricator_join_filter(%"h"%';
----
true

# it filters: the rows big3's scan hands to the join (about 2000 plus false positives, not 400000)
statement ok
PRAGMA enable_profiling = 'json';

statement ok
PRAGMA profiling_output = '${FABRICATOR_DELTA_WRITE_DIR}/bloom_profile.json';

statement ok
SELECT count(*) FROM lake.main.big3 b JOIN lake.main.dim3 d ON b.h = d.h;

statement ok
PRAGMA disable_profiling;

query II
SELECT count(*), max(CAST(r AS BIGINT)) < 10000
FROM (SELECT unnest(regexp_extract_all(content, '(?s)"Function": "FABRICATOR_SCAN".*?"intermediate_rows": (\d+)', 1)) AS r
      FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/bloom_profile.json'));
----
2	true

# NULL keys: a NULL-safe join matches them (400 NULLs x 1 NULL on the build side)
query II
SELECT count(*), sum(b.g) FROM lake.main.big3 b JOIN lake.main.dim3 d ON b.h IS NOT DISTINCT FROM d.h;
----
2398	7200

# the preserved side of an outer join keeps every row
query II
SELECT count(*), count(d.h) FROM lake.main.big3 b LEFT JOIN lake.main.dim3 d ON b.h = d.h;
----
400000	1998

query I
SELECT count(*) FROM lake.main.big3 WHERE h IN (SELECT h FROM lake.main.dim3);
----
1998

query I
SELECT count(*) FROM lake.main.big3 WHERE h NOT IN (SELECT h FROM lake.main.dim3 WHERE h IS NOT NULL);
----
397602

# a FLOAT column joined to DOUBLE keys: the join hashes the CAST value, which the scan does not reproduce, so no
# bloom is sent for it (a wrongly hashed key would drop rows); the answer is the join's
query II
SELECT count(*), sum(b.g) FROM lake.main.big3 b JOIN lake.main.dim3 d ON b.f = d.f;
----
2000	6002

statement ok
DETACH lake;

# ---- The CODEC engine on the same tables, with pushdown_filters 'all': the catalog declares superset_filter_pushdown,
#      so the scan takes DuckDB's filters (a hash join's runtime filter among them), engineered-wood prunes with
#      what it can use, and the HOST re-applies every filter to each chunk, natively on every scan thread (as for
#      SQL Server and ADBC). It used to run the rendered SQL per batch through a host query (62.2 s against 43.0 s
#      on TPC-H SF10 on MinIO). 2026-11-09. ----

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catdynfilter' AS cod (TYPE fabricator, PROVIDER 'engineeredwooddelta',
pushdown_filters 'all', READ_ONLY true);

query II
SELECT property, value FROM fabricator_server_info('cod') WHERE property LIKE '%filter_pushdown' ORDER BY property;
----
exact_filter_pushdown	false
superset_filter_pushdown	true

# an integer key (prefix-range filter): the same answer as the native engine
query III
SELECT count(*), sum(b.id), sum(b.g) FROM cod.main.big2 b JOIN cod.main.dim2 d ON b.id = d.id;
----
2000	398382279	6000

# ...and big2's scan hands the join about the 2000 rows that can join, not the 400400 it read: the re-applied join
# filter. Without it the answer is the same, which is why this needs the profile (dim2's scan is the other one).
statement ok
PRAGMA enable_profiling = 'json';

statement ok
PRAGMA profiling_output = '${FABRICATOR_DELTA_WRITE_DIR}/codec_profile.json';

statement ok
SELECT count(*) FROM cod.main.big2 b JOIN cod.main.dim2 d ON b.id = d.id;

statement ok
PRAGMA disable_profiling;

query II
SELECT count(*), max(CAST(r AS BIGINT)) < 10000
FROM (SELECT unnest(regexp_extract_all(content, '(?s)"Function": "FABRICATOR_SCAN".*?"intermediate_rows": (\d+)', 1)) AS r
      FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/codec_profile.json'));
----
2	true

# a random-string key (bloom filter)
query II
SELECT count(*), sum(b.g) FROM cod.main.big3 b JOIN cod.main.dim3 d ON b.h = d.h;
----
1998	5997

# ...filtered in the scan too
statement ok
PRAGMA enable_profiling = 'json';

statement ok
PRAGMA profiling_output = '${FABRICATOR_DELTA_WRITE_DIR}/codec_bloom_profile.json';

statement ok
SELECT count(*) FROM cod.main.big3 b JOIN cod.main.dim3 d ON b.h = d.h;

statement ok
PRAGMA disable_profiling;

query II
SELECT count(*), max(CAST(r AS BIGINT)) < 10000
FROM (SELECT unnest(regexp_extract_all(content, '(?s)"Function": "FABRICATOR_SCAN".*?"intermediate_rows": (\d+)', 1)) AS r
      FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/codec_bloom_profile.json'));
----
2	true

# a static filter: erased from the plan, so the scan's re-application is the only thing applying it
query II
SELECT count(*), sum(id) FROM cod.main.big2 WHERE id > 399000 AND g <> 1;
----
856	341972286

# NULL keys, outer, semi and anti joins through the same filter
query II
SELECT count(*), sum(b.g) FROM cod.main.big3 b JOIN cod.main.dim3 d ON b.h IS NOT DISTINCT FROM d.h;
----
2398	7200

query II
SELECT count(*), count(d.h) FROM cod.main.big3 b LEFT JOIN cod.main.dim3 d ON b.h = d.h;
----
400000	1998

query I
SELECT count(*) FROM cod.main.big3 WHERE h IN (SELECT h FROM cod.main.dim3);
----
1998

query I
SELECT count(*) FROM cod.main.big3 WHERE h NOT IN (SELECT h FROM cod.main.dim3 WHERE h IS NOT NULL);
----
397602

statement ok
DETACH cod;
