# name: test/verify_delta_catalog_native_write_streaming.test
# description: native_write STREAMING bulk write (bounded memory — for RAM-limited Fabric notebooks). INSERT/CTAS/
#              append stream straight into DuckDB's parquet COPY (the input is never fully collected in C#), then
#              commit the single add via engineered-wood's commit-only CommitDataFilesAsync. PROOF the streaming
#              path ran (not the collect+native path): the collect path injects a physical __delta_row_id column
#              into the parquet for a row-tracking table, but the streaming path does NOT (row tracking rides on
#              the commit's baseRowId; DuckDB COPY writes only the user columns). Partitioned tables fall back to
#              the collect path (still correct). Set ARROWNET_DELTA_WRITE_DIR. Local FS.
# group: [mssql_net]

require mssql_net

require parquet

require-env ARROWNET_DELTA_WRITE_DIR

# DV-default is on → row tracking is enabled, so the collect+native path WOULD inject __delta_row_id.
statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/nwstream' AS lake (TYPE arrownet, PROVIDER 'delta', column_mapping 'none', native_write true);

# CTAS (Overwrite) — streams to one parquet file.
statement ok
CREATE TABLE lake.main.t AS SELECT i AS id, 'v' || (i % 7) AS v FROM range(1, 5001) AS r(i);

query IT
SELECT count(*), sum(id) FROM lake.main.t;
----
5000	12502500

# STREAMING PROOF: the data file has NO physical __delta_row_id column (the collect+native path would inject it
# for this row-tracking table). Row tracking still works via the commit's baseRowId — no physical column needed.
query I
SELECT count(*) FROM parquet_schema('${ARROWNET_DELTA_WRITE_DIR}/nwstream/t/*.parquet') WHERE name = '__delta_row_id';
----
0

# The DuckDB native-writer bloom signature is present on the dict-encoded `v` (7 distinct) — confirming DuckDB
# (not engineered-wood) wrote the streamed parquet.
query I
SELECT max(CASE WHEN path_in_schema = 'v' AND bloom_filter_offset IS NOT NULL THEN 1 ELSE 0 END)
FROM parquet_metadata('${ARROWNET_DELTA_WRITE_DIR}/nwstream/t/*.parquet');
----
1

# DATA-SKIPPING STATS: the streamed file's Delta `add` carries FULL min/max/nullCount (built from DuckDB's
# RETURN_STATS.column_statistics, typed by the write schema) — not just numRecords. The stats string is embedded
# in the add action with inner quotes escaped as " (System.Text.Json default), so we un-escape with
# replace(content, chr(92)||'u0022', '"') and match with normal quotes. Exactly ONE commit (the CTAS, id 1..5000)
# has minValues.id=1 + maxValues.id=5000, emitted as JSON NUMBERS (integer stats are exact).
query I
WITH j AS (SELECT replace(content, chr(92)||'u0022', '"') AS c
           FROM read_text('${ARROWNET_DELTA_WRITE_DIR}/nwstream/t/_delta_log/*.json'))
SELECT count(*) FROM j
WHERE c LIKE '%"minValues":{"id":1,%' AND c LIKE '%"maxValues":{"id":5000,%' AND c LIKE '%"nullCount"%';
----
1

# The string column `v` gets string min/max ('v0'..'v6'); `id`/`v` have no nulls (nullCount 0).
query I
WITH j AS (SELECT replace(content, chr(92)||'u0022', '"') AS c
           FROM read_text('${ARROWNET_DELTA_WRITE_DIR}/nwstream/t/_delta_log/*.json'))
SELECT count(*) FROM j
WHERE c LIKE '%"v":"v0"%' AND c LIKE '%"v":"v6"%' AND c LIKE '%"nullCount":{"id":0,"v":0}%';
----
1

# Append (INSERT) also streams — still no injected row-id column, data complete.
statement ok
INSERT INTO lake.main.t SELECT i, 'v' || (i % 7) FROM range(5001, 8001) AS r(i);

query I
SELECT count(*) FROM lake.main.t;
----
8000

query I
SELECT count(*) FROM parquet_schema('${ARROWNET_DELTA_WRITE_DIR}/nwstream/t/*.parquet') WHERE name = '__delta_row_id';
----
0

# Durability across re-attach.
statement ok
DETACH lake;

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/nwstream' AS lake2 (TYPE arrownet, PROVIDER 'delta', column_mapping 'none', native_write true);

query I
SELECT count(*) FROM lake2.main.t;
----
8000

statement ok
DETACH lake2;

# ---- Partitioned native_write STREAMS too (DuckDB COPY PARTITION_BY, one pass, bounded memory) — no collect
#      fallback. Data lands in the Hive layout; each partition file excludes the partition column + has no
#      injected __delta_row_id (streaming signal); the commit carries per-file partitionValues + stats. ----
statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/nwstreampart' AS lp (TYPE arrownet, PROVIDER 'delta', column_mapping 'none', native_write true);

statement ok
CREATE TABLE lp.main.p PARTITIONED BY (region) AS
  SELECT i AS id, ['US','EU','APAC'][(i % 3) + 1] AS region FROM range(1, 301) AS r(i);

# Append into the existing partitioned table also streams (partitioning read from the table metadata).
statement ok
INSERT INTO lp.main.p SELECT i, ['US','EU','APAC'][(i % 3) + 1] FROM range(301, 601) AS r(i);

query I
SELECT count(*) FROM lp.main.p;
----
600

query TI
SELECT region, count(*) FROM lp.main.p GROUP BY region ORDER BY region;
----
APAC	200
EU	200
US	200

# Hive layout: parquet files under three partition directories (glob lists files, not bare dirs).
query I
SELECT count(DISTINCT regexp_extract(file, 'region=[^/\\]+'))
FROM glob('${ARROWNET_DELTA_WRITE_DIR}/nwstreampart/p/region=*/*.parquet');
----
3

# Partition files EXCLUDE the partition column `region` (Delta convention) and carry NO injected __delta_row_id
# (proves the native streaming COPY wrote them, not engineered-wood's collect+row-id path).
query I
SELECT count(*) FROM parquet_schema('${ARROWNET_DELTA_WRITE_DIR}/nwstreampart/p/region=US/*.parquet')
WHERE name IN ('region', '__delta_row_id');
----
0

# The commit carries per-file partitionValues (region=US) + data-skipping stats (id min/max) for the streamed
# partition files.
query I
WITH j AS (SELECT replace(content, chr(92)||'u0022', '"') AS c
           FROM read_text('${ARROWNET_DELTA_WRITE_DIR}/nwstreampart/p/_delta_log/*.json'))
SELECT count(*) FROM j
WHERE c LIKE '%"partitionValues":{"region":"US"}%' AND c LIKE '%minValues%' AND c LIKE '%"id":%';
----
2

statement ok
DETACH lp;
