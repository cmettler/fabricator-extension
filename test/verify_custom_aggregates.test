# name: test/verify_custom_aggregates.test
# description: Provider-authored custom C# aggregate functions (UDAF) — db.schema.fn(args) in GROUP BY / parallel / OVER
# group: [mssql]

require fabricator

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS adb (TYPE fabricator);

# dbo.cf_product / dbo.cf_bit_or are custom C# aggregates (IArrowAggregateFunction baked into the provider),
# NOT SQL Server objects — surfaced into the attached catalog and registered as DuckDB aggregate functions.
query TTT
SELECT schema_name, name, kind FROM fabricator_functions('adb') WHERE name IN ('cf_product', 'cf_bit_or') ORDER BY name;
----
dbo	cf_bit_or	aggregate
dbo	cf_product	aggregate

# ...yet there is NO such object in SQL Server — proving they are the C#-authored custom aggregates.
query I
SELECT cnt FROM fabricator_query('adb', 'SELECT COUNT(*) AS cnt FROM sys.objects WHERE name IN (''cf_product'',''cf_bit_or'')');
----
0

# Ungrouped reduction (the simple_update fast path): product of 1..5 = 120.
query I
SELECT adb.dbo.cf_product(x) FROM range(1, 6) t(x);
----
120

# An INTEGER argument implicitly widens to the aggregate's BIGINT parameter.
query I
SELECT adb.dbo.cf_product(x::INTEGER) FROM range(1, 5) t(x);
----
24

# NULL inputs are skipped (standard aggregate semantics): 2 * 5 = 10.
query I
SELECT adb.dbo.cf_product(x) FROM (VALUES (2::BIGINT), (NULL::BIGINT), (5::BIGINT)) t(x);
----
10

# Empty input (no rows survive the filter) => the empty-group value, NULL.
query I
SELECT adb.dbo.cf_product(x) FROM range(1, 6) t(x) WHERE x > 100;
----
NULL

# All-NULL input => NULL.
query I
SELECT adb.dbo.cf_product(x) FROM (VALUES (NULL::BIGINT), (NULL::BIGINT)) t(x);
----
NULL

# GROUP BY (the grouped update + combine + finalize path): g=1 -> 2*3=6, g=2 -> 4*5*6=120.
query II
SELECT g, adb.dbo.cf_product(x) AS p
FROM (VALUES (1, 2::BIGINT), (1, 3::BIGINT), (2, 4::BIGINT), (2, 5::BIGINT), (2, 6::BIGINT)) t(g, x)
GROUP BY g ORDER BY g;
----
1	6
2	120

# GROUP BY with a NULL-only group: g=1 -> {2,NULL}=2 (NULL skipped); g=2 -> {NULL} => NULL.
query II
SELECT g, adb.dbo.cf_product(x) AS p
FROM (VALUES (1, 2::BIGINT), (1, NULL::BIGINT), (2, NULL::BIGINT)) t(g, x)
GROUP BY g ORDER BY g;
----
1	2
2	NULL

# bit_or fold (associative + commutative). OR of 0..999 sets bits 0..9 => 1023.
query I
SELECT adb.dbo.cf_bit_or(x) FROM range(0, 1000) t(x);
----
1023

# ---- Parallel aggregation: force multiple threads so combine() merges thread-local partial states. ----
statement ok
SET threads = 4;

# Cross-check the custom aggregate against DuckDB's built-in bit_or over 1000 rows (ungrouped, parallel):
# equality proves the parallel combine path is coherent.
query I
SELECT adb.dbo.cf_bit_or(x) = bit_or(x) FROM range(0, 1000) t(x);
----
true

# Grouped + parallel: cross-check cf_product against DuckDB's product() per group (200 rows, 7 groups).
query I
SELECT bool_and(cf_p = duck_p) FROM (
    SELECT g, adb.dbo.cf_product(x) AS cf_p, product(x)::BIGINT AS duck_p
    FROM (SELECT x % 7 AS g, ((x % 4) + 1)::BIGINT AS x FROM range(0, 200) t(x)) s
    GROUP BY g
);
----
true

# ---- Window (OVER): no custom `window` callback — DuckDB drives windowing through update/combine/finalize. ----
# Running product over an ordered frame.
query II
SELECT x, adb.dbo.cf_product(x) OVER (ORDER BY x ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running
FROM range(1, 5) t(x) ORDER BY x;
----
1	1
2	2
3	6
4	24

# Cross-check a windowed cf_bit_or against DuckDB's bit_or window (running frame) — proves the segment-tree
# window path uses our callbacks correctly.
query I
SELECT bool_and(cf_w = duck_w) FROM (
    SELECT adb.dbo.cf_bit_or(x) OVER (ORDER BY x ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cf_w,
           bit_or(x) OVER (ORDER BY x ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS duck_w
    FROM range(0, 50) t(x)
);
----
true

# Windowed with PARTITION BY (3 partitions) — cross-checked against the built-in.
query I
SELECT bool_and(cf_w = duck_w) FROM (
    SELECT adb.dbo.cf_bit_or(x) OVER (PARTITION BY x % 3 ORDER BY x) AS cf_w,
           bit_or(x) OVER (PARTITION BY x % 3 ORDER BY x) AS duck_w
    FROM range(0, 60) t(x)
);
----
true

# ---- Spillable aggregate (opt-in SupportsSpill): dbo.cf_sum_spill serializes its state into DuckDB's blob
# so external GROUP BY can spill it to disk. The bytes-in-blob round-trip runs on every update/combine/finalize
# — these cases exercise that path and cross-check the result against the built-in SUM. ----

# Discovered with kind='aggregate_spill' (vs 'aggregate' for the fast in-memory ones).
query TTT
SELECT schema_name, name, kind FROM fabricator_functions('adb') WHERE name = 'cf_sum_spill';
----
dbo	cf_sum_spill	aggregate_spill

# Ungrouped (simple_update spill path): sum of 1..5 = 15.
query I
SELECT adb.dbo.cf_sum_spill(x) FROM range(1, 6) t(x);
----
15

# NULL-skip and empty/all-NULL => NULL.
query I
SELECT adb.dbo.cf_sum_spill(x) FROM (VALUES (10::BIGINT), (NULL::BIGINT), (5::BIGINT)) t(x);
----
15

query I
SELECT adb.dbo.cf_sum_spill(x) FROM range(1, 6) t(x) WHERE x > 100;
----
NULL

# GROUP BY (spill update + combine + finalize): g=1 -> 2+3=5, g=2 -> 4+5+6=15.
query II
SELECT g, adb.dbo.cf_sum_spill(x) AS s
FROM (VALUES (1, 2::BIGINT), (1, 3::BIGINT), (2, 4::BIGINT), (2, 5::BIGINT), (2, 6::BIGINT)) t(g, x)
GROUP BY g ORDER BY g;
----
1	5
2	15

# High-cardinality grouped + parallel (threads=4, set above): 50k rows over 1000 groups heavily exercises the
# bytes-in-blob update/combine/finalize round-trip; cross-checked against the built-in SUM per group.
query I
SELECT bool_and(cf = duck) FROM (
    SELECT g, adb.dbo.cf_sum_spill(x) AS cf, sum(x)::BIGINT AS duck
    FROM (SELECT x % 1000 AS g, x AS x FROM range(0, 50000) t(x)) s
    GROUP BY g
);
----
true

# Under a tighter memory limit the same query must still be correct (the spillable state is what DuckDB
# spills); cross-checked against the built-in.
statement ok
SET memory_limit = '120MB';

query I
SELECT bool_and(cf = duck) FROM (
    SELECT g, adb.dbo.cf_sum_spill(x) AS cf, sum(x)::BIGINT AS duck
    FROM (SELECT x % 4000 AS g, x AS x FROM range(0, 80000) t(x)) s
    GROUP BY g
);
----
true

statement ok
RESET memory_limit;

# Window (segment-tree drives the spill update/combine/finalize): running sum cross-checked against built-in.
query I
SELECT bool_and(cf_w = duck_w) FROM (
    SELECT adb.dbo.cf_sum_spill(x) OVER (ORDER BY x ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cf_w,
           sum(x) OVER (ORDER BY x ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS duck_w
    FROM range(0, 50) t(x)
);
----
true

# ---- Non-additive (holistic) aggregate: dbo.cf_median. Its state IS the full collection of values — Update
# collects, Combine MERGES the collections (concatenation, not arithmetic), Finalize sorts + picks the median.
# Order-independent, so it stays correct under parallel partial-state merging. Runs in the fast (default) mode. ----

# Holistic => fast mode: discovered as 'aggregate' (not 'aggregate_spill' — an unbounded collection can't spill).
query TTT
SELECT schema_name, name, kind FROM fabricator_functions('adb') WHERE name = 'cf_median';
----
dbo	cf_median	aggregate

# Odd count: median of 1..5 = 3 (exact middle).
query I
SELECT adb.dbo.cf_median(x)::INTEGER FROM range(1, 6) t(x);
----
3

# Even count: median of 1..4 = 2.5 (average of the two middles).
query I
SELECT adb.dbo.cf_median(x) = 2.5 FROM range(1, 5) t(x);
----
true

# NULLs skipped: median of {1,3,5} = 3.
query I
SELECT adb.dbo.cf_median(x)::INTEGER FROM (VALUES (1.0::DOUBLE), (NULL::DOUBLE), (3.0::DOUBLE), (5.0::DOUBLE)) t(x);
----
3

# Empty input => NULL.
query I
SELECT adb.dbo.cf_median(x) FROM range(1, 6) t(x) WHERE x > 100;
----
NULL

# GROUP BY + parallel (threads=4, set above): 5000 rows over 50 groups — Combine merges many partial
# collections per group; cross-checked against DuckDB's built-in median() (tolerance for the last-ULP of the
# interpolation formula). This is the proof that combine-as-merge is correct under parallel aggregation.
query I
SELECT bool_and(abs(cf - duck) < 1e-9) FROM (
    SELECT g, adb.dbo.cf_median(x) AS cf, median(x) AS duck
    FROM (SELECT x % 50 AS g, ((x * 7) % 101)::DOUBLE AS x FROM range(0, 5000) t(x)) s
    GROUP BY g
);
----
true
