# name: test/verify_delta_catalog_changes.test
# description: Delta folder-as-catalog Change Data Feed (CDF). ATTACH option `change_data_feed true` enables the
#              changeDataFeed feature on tables CREATEd in that catalog; INSERT/DELETE/UPDATE capture CDC change
#              files; fabricator_delta_changes('<catalog>', '<schema.>table', from[, to]) reads the row-level change
#              feed between two versions (insert / delete / update_preimage / update_postimage), with the
#              _change_type / _commit_version / _commit_timestamp metadata columns. ending_version omitted =>
#              latest. TIMESTAMP bounds: starting_timestamp = the FIRST version committed at-or-after that
#              instant (Delta's startingTimestamp), ending_timestamp = the LAST at-or-before; a bound past the
#              applicable end of the history yields an EMPTY feed, never an error.
#              Capture for the rowid copy-on-write DELETE/UPDATE strips the transient virtual rowid so every change
#              batch shares the user-column schema. Set FABRICATOR_DELTA_WRITE_DIR to a WRITABLE base path. Local FS.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogcdf' AS lake (TYPE fabricator, PROVIDER 'delta', change_data_feed true);

statement ok
CREATE TABLE lake.main.t (id INTEGER, val VARCHAR);

statement ok
INSERT INTO lake.main.t VALUES (1,'a'),(2,'b'),(3,'c');

statement ok
DELETE FROM lake.main.t WHERE id=2;

statement ok
UPDATE lake.main.t SET val='B' WHERE id=3;

# Final table state: id=2 deleted, id=3 updated.
query IT
SELECT * FROM lake.main.t ORDER BY id;
----
1	a
3	B

# The full change feed across all versions: 3 inserts (v1), 1 delete (v2), update pre+post (v3).
query I
SELECT count(*) FROM lake.delta.changes('main.t', starting_version := 0, ending_version := 99);
----
6

# Change-type breakdown.
query TI
SELECT _change_type, count(*) FROM lake.delta.changes('main.t', starting_version := 0, ending_version := 99)
GROUP BY _change_type ORDER BY _change_type;
----
delete	1
insert	3
update_postimage	1
update_preimage	1

# The 3 inserts are at commit version 1, with the inserted values.
query IT
SELECT id, val FROM lake.delta.changes('main.t', starting_version := 0, ending_version := 99)
WHERE _change_type='insert' ORDER BY id;
----
1	a
2	b
3	c

# The delete change carries the deleted row's pre-delete values.
query IT
SELECT id, val FROM lake.delta.changes('main.t', starting_version := 0, ending_version := 99) WHERE _change_type='delete';
----
2	b

# Update pre/post images carry the old and new values for the same key.
query IT
SELECT _change_type, val FROM lake.delta.changes('main.t', starting_version := 0, ending_version := 99)
WHERE id=3 AND _change_type LIKE 'update_%' ORDER BY _change_type;
----
update_postimage	B
update_preimage	c

# _commit_timestamp is populated (epoch ms) on every change from the always-on commitInfo timestamp.
query I
SELECT count(*) FROM lake.delta.changes('main.t', starting_version := 0, ending_version := 99) WHERE _commit_timestamp IS NOT NULL;
----
6

# Commit versions: inserts at v1, delete at v2, update images at v3.
query TI
SELECT _change_type, _commit_version FROM lake.delta.changes('main.t', starting_version := 0, ending_version := 99)
WHERE _change_type IN ('delete','update_preimage') ORDER BY _change_type;
----
delete	2
update_preimage	3

# A bounded range: only the inserts (version 1).
query I
SELECT count(*) FROM lake.delta.changes('main.t', starting_version := 1, ending_version := 1);
----
3

# Range starting after the inserts: delete + update images (versions 2..3).
query I
SELECT count(*) FROM lake.delta.changes('main.t', starting_version := 2, ending_version := 99);
----
3

# The 3-arg overload (no `to`) reads through to the latest version.
query I
SELECT count(*) FROM lake.delta.changes('main.t', starting_version := 0);
----
6

# A bare table name resolves to "main" on a flat catalog.
query I
SELECT count(*) FROM lake.delta.changes('t', starting_version := 0, ending_version := 99);
----
6

statement ok
DETACH lake;

# CDF + deletion vectors: a rowTracking table's data files carry the physical __delta_row_id, which the inferred
# insert path (blind append, no cdc file) must strip so every change batch shares the user-column schema (a 6-vs-5
# mismatch otherwise SIGSEGVs the Arrow C-stream boundary). DELETE is a DV commit; UPDATE is copy-on-write.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogcdfdv' AS dv (TYPE fabricator, PROVIDER 'delta', change_data_feed true, deletion_vectors true);

statement ok
CREATE TABLE dv.main.t (id INTEGER, val VARCHAR);

statement ok
INSERT INTO dv.main.t VALUES (1,'a'),(2,'b'),(3,'c'),(4,'d');

statement ok
DELETE FROM dv.main.t WHERE id=2;

statement ok
UPDATE dv.main.t SET val='C' WHERE id=3;

# Final state.
query IT
SELECT * FROM dv.main.t ORDER BY id;
----
1	a
3	C
4	d

# Full feed: 4 inserts (v1), 1 delete (v2), update pre+post (v3) — the inferred inserts carry no row-id column.
query TI
SELECT _change_type, count(*) FROM dv.delta.changes('main.t', starting_version := 0, ending_version := 99)
GROUP BY _change_type ORDER BY _change_type;
----
delete	1
insert	4
update_postimage	1
update_preimage	1

# The inferred inserts are exactly the four original rows (no extra rowid column leaking through).
query IT
SELECT id, val FROM dv.delta.changes('main.t', starting_version := 0, ending_version := 99) WHERE _change_type='insert' ORDER BY id;
----
1	a
2	b
3	c
4	d

statement ok
DETACH dv;

# A table created WITHOUT change_data_feed has no change feed (CDF not enabled).
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogcdf_off' AS plain (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE plain.main.t (id INTEGER);

statement ok
INSERT INTO plain.main.t VALUES (1),(2);

statement error
SELECT * FROM plain.delta.changes('main.t', starting_version := 0, ending_version := 99);
----

statement ok
DETACH plain;

# ---- TIMESTAMP bounds (starting_timestamp / ending_timestamp) --------------------------------------------------
# Pinned per the timestamp-bounds design note: a timestamp bound must return the SAME rows as the equivalent
# version bound (the off-by-one there is invisible in a small test without the equivalence), and the two
# out-of-history directions are EMPTY feeds, not errors.

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogcdf_ts' AS tsf (TYPE fabricator, PROVIDER 'delta', change_data_feed true);

statement ok
CREATE TABLE tsf.main.t (id INTEGER);

statement ok
INSERT INTO tsf.main.t VALUES (1),(2);

statement ok
DELETE FROM tsf.main.t WHERE id = 1;

# The epoch is at-or-before every commit, so starting_timestamp resolves to v0 — identical to starting_version 0.
query TI
SELECT _change_type, count(*) FROM tsf.delta.changes('main.t', starting_timestamp := TIMESTAMP '1970-01-01 00:00:00')
GROUP BY _change_type ORDER BY _change_type;
----
delete	1
insert	2

query I
SELECT (SELECT count(*) FROM tsf.delta.changes('main.t', starting_timestamp := TIMESTAMP '1970-01-01 00:00:00'))
     = (SELECT count(*) FROM tsf.delta.changes('main.t', starting_version := 0));
----
true

# ending_timestamp far in the future = the latest version — identical to no ending bound at all.
query I
SELECT (SELECT count(*) FROM tsf.delta.changes('main.t', starting_version := 0, ending_timestamp := TIMESTAMP '2100-01-01 00:00:00'))
     = (SELECT count(*) FROM tsf.delta.changes('main.t', starting_version := 0));
----
true

# starting_timestamp AFTER the last commit: nothing happened at-or-after it — an EMPTY feed, not an error.
query I
SELECT count(*) FROM tsf.delta.changes('main.t', starting_timestamp := TIMESTAMP '2100-01-01 00:00:00');
----
0

# ending_timestamp BEFORE the first commit: nothing existed at-or-before it — an EMPTY feed, not an error.
query I
SELECT count(*) FROM tsf.delta.changes('main.t', starting_version := 0, ending_timestamp := TIMESTAMP '1970-01-01 00:00:00');
----
0

# The bounds are mutually exclusive per axis, and a starting bound is required — each refused with a message
# naming both spellings (never silently preferring one, the dual-typing hazard the named parameters exist to avoid).
statement error
SELECT * FROM tsf.delta.changes('main.t', starting_version := 0, starting_timestamp := TIMESTAMP '2100-01-01 00:00:00');
----

statement error
SELECT * FROM tsf.delta.changes('main.t');
----

statement error
SELECT * FROM tsf.delta.changes('main.t', starting_version := 0, ending_version := 9, ending_timestamp := TIMESTAMP '2100-01-01 00:00:00');
----

statement ok
DETACH tsf;
