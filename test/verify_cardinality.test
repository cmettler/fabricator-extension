# name: test/verify_cardinality.test
# description: Verify the scan reports a row-count cardinality estimate to the optimizer
# group: [mssql_net]

require mssql_net

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS db (TYPE mssql_net);

# Binding the table fetches its approximate row count for the optimizer.
statement ok
SELECT * FROM db.dbo.TestSimplePK LIMIT 1;

# The partition-stats row-count query reached SQL Server.
query I
SELECT hit FROM mssql_net_query('db',
  'SELECT CAST(CASE WHEN EXISTS (
     SELECT 1 FROM sys.dm_exec_query_stats qs
     CROSS APPLY sys.dm_exec_sql_text(qs.sql_handle) st
     WHERE CHARINDEX(''dm_db_partition_stats'', st.text) > 0
       AND CHARINDEX(''dm_exec'', st.text) = 0
   ) THEN 1 ELSE 0 END AS INT) AS hit');
----
1

statement ok
DETACH db;
