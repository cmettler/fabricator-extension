# name: test/verify_tpch_mssql.test
# description: TPCH at SF 0.01 with its tables split between local DuckDB and SQL Server in
#              several placements (all remote, the facts remote, the dimensions remote, a fixed random split);
#              every query must return what the all-local run returns. GENERATED by scripts/gen_tpc_suites.py
#              — edit that, not this file. The expected results are the local answers (rowsort; numeric
#              values compare approximately).
# group: [fabricator]

require fabricator

require tpch

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS rp (TYPE fabricator, remote_pushdown 'true');

statement ok
CREATE SCHEMA memory.tpch

statement ok
CALL dbgen(sf = 0.01, catalog = 'memory', schema = 'tpch');

statement ok
SELECT fabricator_exec('rp', 'IF SCHEMA_ID(''tpch_t'') IS NULL EXEC(''CREATE SCHEMA tpch_t'')', refresh_cache := true);

statement ok
CREATE OR REPLACE TABLE rp.tpch_t.customer AS SELECT * FROM memory.tpch.customer;

statement ok
CREATE OR REPLACE TABLE rp.tpch_t.lineitem AS SELECT * FROM memory.tpch.lineitem;

statement ok
CREATE OR REPLACE TABLE rp.tpch_t.nation AS SELECT * FROM memory.tpch.nation;

statement ok
CREATE OR REPLACE TABLE rp.tpch_t.orders AS SELECT * FROM memory.tpch.orders;

statement ok
CREATE OR REPLACE TABLE rp.tpch_t.part AS SELECT * FROM memory.tpch.part;

statement ok
CREATE OR REPLACE TABLE rp.tpch_t.partsupp AS SELECT * FROM memory.tpch.partsupp;

statement ok
CREATE OR REPLACE TABLE rp.tpch_t.region AS SELECT * FROM memory.tpch.region;

statement ok
CREATE OR REPLACE TABLE rp.tpch_t.supplier AS SELECT * FROM memory.tpch.supplier;

statement ok
CREATE SCHEMA memory.mix_remote

statement ok
CREATE VIEW memory.mix_remote.customer AS SELECT * FROM rp.tpch_t.customer

statement ok
CREATE VIEW memory.mix_remote.lineitem AS SELECT * FROM rp.tpch_t.lineitem

statement ok
CREATE VIEW memory.mix_remote.nation AS SELECT * FROM rp.tpch_t.nation

statement ok
CREATE VIEW memory.mix_remote.orders AS SELECT * FROM rp.tpch_t.orders

statement ok
CREATE VIEW memory.mix_remote.part AS SELECT * FROM rp.tpch_t.part

statement ok
CREATE VIEW memory.mix_remote.partsupp AS SELECT * FROM rp.tpch_t.partsupp

statement ok
CREATE VIEW memory.mix_remote.region AS SELECT * FROM rp.tpch_t.region

statement ok
CREATE VIEW memory.mix_remote.supplier AS SELECT * FROM rp.tpch_t.supplier

statement ok
CREATE SCHEMA memory.mix_facts

statement ok
CREATE VIEW memory.mix_facts.customer AS SELECT * FROM memory.tpch.customer

statement ok
CREATE VIEW memory.mix_facts.lineitem AS SELECT * FROM rp.tpch_t.lineitem

statement ok
CREATE VIEW memory.mix_facts.nation AS SELECT * FROM memory.tpch.nation

statement ok
CREATE VIEW memory.mix_facts.orders AS SELECT * FROM rp.tpch_t.orders

statement ok
CREATE VIEW memory.mix_facts.part AS SELECT * FROM memory.tpch.part

statement ok
CREATE VIEW memory.mix_facts.partsupp AS SELECT * FROM rp.tpch_t.partsupp

statement ok
CREATE VIEW memory.mix_facts.region AS SELECT * FROM memory.tpch.region

statement ok
CREATE VIEW memory.mix_facts.supplier AS SELECT * FROM memory.tpch.supplier

statement ok
CREATE SCHEMA memory.mix_dims

statement ok
CREATE VIEW memory.mix_dims.customer AS SELECT * FROM rp.tpch_t.customer

statement ok
CREATE VIEW memory.mix_dims.lineitem AS SELECT * FROM memory.tpch.lineitem

statement ok
CREATE VIEW memory.mix_dims.nation AS SELECT * FROM rp.tpch_t.nation

statement ok
CREATE VIEW memory.mix_dims.orders AS SELECT * FROM memory.tpch.orders

statement ok
CREATE VIEW memory.mix_dims.part AS SELECT * FROM rp.tpch_t.part

statement ok
CREATE VIEW memory.mix_dims.partsupp AS SELECT * FROM memory.tpch.partsupp

statement ok
CREATE VIEW memory.mix_dims.region AS SELECT * FROM rp.tpch_t.region

statement ok
CREATE VIEW memory.mix_dims.supplier AS SELECT * FROM rp.tpch_t.supplier

statement ok
CREATE SCHEMA memory.mix_mixed

statement ok
CREATE VIEW memory.mix_mixed.customer AS SELECT * FROM memory.tpch.customer

statement ok
CREATE VIEW memory.mix_mixed.lineitem AS SELECT * FROM memory.tpch.lineitem

statement ok
CREATE VIEW memory.mix_mixed.nation AS SELECT * FROM memory.tpch.nation

statement ok
CREATE VIEW memory.mix_mixed.orders AS SELECT * FROM memory.tpch.orders

statement ok
CREATE VIEW memory.mix_mixed.part AS SELECT * FROM rp.tpch_t.part

statement ok
CREATE VIEW memory.mix_mixed.partsupp AS SELECT * FROM memory.tpch.partsupp

statement ok
CREATE VIEW memory.mix_mixed.region AS SELECT * FROM memory.tpch.region

statement ok
CREATE VIEW memory.mix_mixed.supplier AS SELECT * FROM rp.tpch_t.supplier

# placements: remote = customer, lineitem, nation, orders, part, partsupp, region, supplier; facts = lineitem, orders, partsupp; dims = customer, nation, part, region, supplier; mixed = part, supplier
foreach placement remote facts dims mixed

statement ok
USE memory.mix_${placement}

