# name: test/verify_delta_nested_schemas.test
# description: Delta folder-as-catalog with the `nested_schemas true` ATTACH option — the directory tree UNDER the
#              root IS the schema tree, to any depth (DuckDB 2.0 nested schemas), so <root>/sales/eu/deep resolves
#              as cat.sales.eu.deep. READS and WRITES both nest since ABI v92; §7 re-reads the deep table through a
#              sub-root attached FLAT, which is what proves a nested write landed in the right directory rather than
#              one level too shallow. Set FABRICATOR_DELTA_WRITE_DIR to a WRITABLE base. Local FS.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

# ── §1 setup. The tree is built with ORDINARY two-level attaches at successively deeper SUB-ROOTS, because a
#    nested `CREATE SCHEMA a.b` is one of the statements this slice refuses — the layout has to come from the
#    storage, which is exactly the shape the feature is for.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/nl' AS lvl1 (TYPE fabricator, PROVIDER 'delta', schemas true);

statement ok
CREATE SCHEMA lvl1.sales;

statement ok
CREATE TABLE lvl1.sales.orders AS SELECT 1 AS id, 'eu' AS region;

statement ok
CREATE TABLE lvl1.main.flat AS SELECT 7 AS v;

statement ok
DETACH lvl1;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/nl/sales' AS lvl2 (TYPE fabricator, PROVIDER 'delta', schemas true);

statement ok
CREATE SCHEMA lvl2.eu;

statement ok
CREATE TABLE lvl2.eu.deep AS SELECT 42 AS v;

statement ok
DETACH lvl2;

# ── §2 the TWO-LEVEL CONTROL: the identical tree WITHOUT the option behaves exactly as it always has.
#    Without it this suite could not tell "nesting works" from "the layout changed for everyone".
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/nl' AS flatlk (TYPE fabricator, PROVIDER 'delta', schemas true);

query II
SELECT id, region FROM flatlk.sales.orders;
----
1	eu

# `eu` is a folder under sales/, and WITHOUT nesting it is not a schema at all.
statement error
SELECT * FROM flatlk.sales.eu.deep;
----
does not exist

# The capability is OFF, so a dotted schema argument stays a LITERAL name rather than a path.
statement error
SELECT * FROM flatlk."sales.eu".deep;
----
does not exist

statement ok
DETACH flatlk;

# ── §3 the nested attach: discovery reports the TREE, intermediate levels included.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/nl' AS lk (TYPE fabricator, PROVIDER 'delta', nested_schemas true);

query I
SELECT schema_name FROM duckdb_schemas() WHERE database_name='lk' ORDER BY 1;
----
delta
eu
main
sales

query II
SELECT schema_name, table_name FROM duckdb_tables() WHERE database_name='lk' ORDER BY 1,2;
----
eu	deep
main	flat
sales	orders

# ── §4 resolution. Depth 1, 2 and 3 all answer.
query I
SELECT v FROM lk.main.flat;
----
7

query II
SELECT id, region FROM lk.sales.orders;
----
1	eu

query I
SELECT v FROM lk.sales.eu.deep;
----
42

# ⚠ THE ASSERTION THAT PROVES IT IS REAL NESTING: the LEAF alone must NOT resolve. If `eu` had been
# registered as another TOP-LEVEL schema — which is what a flattening bug produces, and what duckdb_schemas()
# above cannot tell apart, since it prints a child by its own name — this would succeed.
statement error
SELECT v FROM lk.eu.deep;
----
schema "eu" does not exist

# ── §5 WRITES INTO A NESTED SCHEMA (ABI v92). Every one of these was REFUSED by name in slice 2b, when
#    only table_open carried a path; the eight write crossings carry one now. The assertion that matters is
#    not that they succeed but that they land in the RIGHT directory, which §7 checks from the outside.
statement ok
INSERT INTO lk.sales.eu.deep VALUES (99);

query I
SELECT count(*) FROM lk.sales.eu.deep;
----
2

statement ok
UPDATE lk.sales.eu.deep SET v = 100 WHERE v = 99;

query I
SELECT v FROM lk.sales.eu.deep ORDER BY v;
----
42
100

statement ok
DELETE FROM lk.sales.eu.deep WHERE v = 100;

query I
SELECT v FROM lk.sales.eu.deep;
----
42

statement ok
CREATE TABLE lk.sales.eu.born AS SELECT 'x' AS c;

query I
SELECT c FROM lk.sales.eu.born;
----
x

statement ok
ALTER TABLE lk.sales.eu.born ADD COLUMN z INTEGER;

query I
SELECT count(*) FROM duckdb_columns() WHERE database_name='lk' AND table_name='born';
----
2

statement ok
DROP TABLE lk.sales.eu.born;

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name='lk' AND table_name='born';
----
0

# A NESTED CREATE SCHEMA makes the directory, and a table lands inside it.
statement ok
CREATE SCHEMA lk.sales.west;

statement ok
CREATE TABLE lk.sales.west.t AS SELECT 5 AS q;

query I
SELECT q FROM lk.sales.west.t;
----
5

statement ok
DROP SCHEMA lk.sales.west CASCADE;

query I
SELECT count(*) FROM duckdb_schemas() WHERE database_name='lk' AND schema_name='west';
----
0

# ⚠ COMMENT ON is the ONE statement that still cannot reach a nested table, and the layer that stops it is
#    DuckDB's PARSER, not us: it caps the statement at three qualifications. Pinned as the parser's error
#    rather than ours — the day upstream lifts the cap, this row fails and sends the reader here.
statement error
COMMENT ON TABLE lk.sales.eu.deep IS 'hi';
----
Too many qualifications found

# ── §6 THE DEPTH-1 CONTROL. Everything above must still work one level up — without this, a build that
#    had broken writing altogether would look identical.
statement ok
INSERT INTO lk.sales.orders VALUES (2, 'us');

query I
SELECT count(*) FROM lk.sales.orders;
----
2

statement ok
ALTER TABLE lk.sales.orders ADD COLUMN note VARCHAR;

statement ok
CREATE TABLE lk.sales.born AS SELECT 5 AS x;

statement ok
DROP TABLE lk.sales.born;

statement ok
CREATE SCHEMA lk.west;

statement ok
DROP SCHEMA lk.west;

# ── §7 the data really is where the PATH says, checked from OUTSIDE the nested attach: the deep table is
#    re-read through a sub-root attached FLAT at <root>/sales, where it is an ordinary two-level table. If a
#    nested write had landed one level too shallow, this is the row that would miss it — the nested catalog
#    would happily read back whatever it had written to the wrong place.
query I
SELECT v FROM lk.sales.eu.deep;
----
42

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/nl/sales' AS sub (TYPE fabricator, PROVIDER 'delta', schemas true);

query I
SELECT v FROM sub.eu.deep;
----
42

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name='sub' AND table_name='born';
----
0

statement ok
DETACH sub;

statement ok
DETACH lk;

# ── §8 re-attach: the tree is storage, not session state.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/nl' AS lk2 (TYPE fabricator, PROVIDER 'delta', nested_schemas true);

query I
SELECT v FROM lk2.sales.eu.deep;
----
42

query I
SELECT count(*) FROM lk2.sales.orders;
----
2

statement ok
DETACH lk2;

# ── §9 a ROOT-LEVEL Delta table is NOT discovered under nested_schemas (every level is a real directory, so a
#    table needs at least one). It is skipped with a WARNING rather than refused; `schemas true` does not
#    discover one either, so this is not a regression — it is the behaviour being pinned.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/rootonly' AS r1 (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE r1.main.loose AS SELECT 3 AS v;

statement ok
DETACH r1;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/rootonly' AS r2 (TYPE fabricator, PROVIDER 'delta', nested_schemas true);

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name='r2';
----
0

statement ok
DETACH r2;

# The SAME root attached FLAT still sees it — the control proving the table exists and §9 measured a layout
# rule rather than a broken write.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/rootonly' AS r3 (TYPE fabricator, PROVIDER 'delta');

query I
SELECT v FROM r3.main.loose;
----
3

statement ok
DETACH r3;

# ── §10 "main" is an ORDINARY directory under nested_schemas, not the synthetic schema of root-level tables.
#    That is the whole reason §9 skips rather than synthesizes: `CREATE TABLE cat.main.t` under `schemas true`
#    makes a REAL <root>/main/ folder, so a synthetic "main" would have collided with the commonest layout.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/nl' AS lk3 (TYPE fabricator, PROVIDER 'delta', nested_schemas true);

query I
SELECT v FROM lk3.main.flat;
----
7

statement ok
DETACH lk3;
