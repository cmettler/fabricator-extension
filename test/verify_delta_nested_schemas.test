# name: test/verify_delta_nested_schemas.test
# description: Delta folder-as-catalog with the `schemas 'nested'` ATTACH option — the directory tree UNDER the
#              root IS the schema tree, to any depth (DuckDB 2.0 nested schemas), so <root>/sales/eu/deep resolves
#              as cat.sales.eu.deep. READS and WRITES both nest since ABI v92, and since v97 so do the declared
#              functions, macros and views (§12); §7 re-reads the deep table through a
#              sub-root attached FLAT, which is what proves a nested write landed in the right directory rather than
#              one level too shallow. Set FABRICATOR_DELTA_WRITE_DIR to a WRITABLE base. Local FS.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

# ── §1 setup. The tree is built with ORDINARY two-level attaches at successively deeper SUB-ROOTS, because a
#    nested `CREATE SCHEMA a.b` is one of the statements this slice refuses — the layout has to come from the
#    storage, which is exactly the shape the feature is for.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/nl' AS lvl1 (TYPE fabricator, PROVIDER 'delta', schemas true);

statement ok
CREATE SCHEMA lvl1.sales;

statement ok
CREATE TABLE lvl1.sales.orders AS SELECT 1 AS id, 'eu' AS region;

statement ok
CREATE TABLE lvl1.main.flat AS SELECT 7 AS v;

statement ok
DETACH lvl1;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/nl/sales' AS lvl2 (TYPE fabricator, PROVIDER 'delta', schemas true);

statement ok
CREATE SCHEMA lvl2.eu;

statement ok
CREATE TABLE lvl2.eu.deep AS SELECT 42 AS v;

statement ok
DETACH lvl2;

# ── §2 the TWO-LEVEL CONTROL: the identical tree WITHOUT the option behaves exactly as it always has.
#    Without it this suite could not tell "nesting works" from "the layout changed for everyone".
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/nl' AS flatlk (TYPE fabricator, PROVIDER 'delta', schemas true);

query II
SELECT id, region FROM flatlk.sales.orders;
----
1	eu

# `eu` is a folder under sales/, and WITHOUT nesting it is not a schema at all.
statement error
SELECT * FROM flatlk.sales.eu.deep;
----
does not exist

# The capability is OFF, so a dotted schema argument stays a LITERAL name rather than a path.
statement error
SELECT * FROM flatlk."sales.eu".deep;
----
does not exist

statement ok
DETACH flatlk;

# ── §3 the nested attach: discovery reports the TREE, intermediate levels included.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/nl' AS lk (TYPE fabricator, PROVIDER 'delta', schemas 'nested');

query I
SELECT schema_name FROM duckdb_schemas() WHERE database_name='lk' ORDER BY 1;
----
delta
eu
main
sales

query II
SELECT schema_name, table_name FROM duckdb_tables() WHERE database_name='lk' ORDER BY 1,2;
----
eu	deep
main	flat
sales	orders

# ── §4 resolution. Depth 1, 2 and 3 all answer.
query I
SELECT v FROM lk.main.flat;
----
7

query II
SELECT id, region FROM lk.sales.orders;
----
1	eu

query I
SELECT v FROM lk.sales.eu.deep;
----
42

# ⚠ THE ASSERTION THAT PROVES IT IS REAL NESTING: the LEAF alone must NOT resolve. If `eu` had been
# registered as another TOP-LEVEL schema — which is what a flattening bug produces, and what duckdb_schemas()
# above cannot tell apart, since it prints a child by its own name — this would succeed.
statement error
SELECT v FROM lk.eu.deep;
----
schema "eu" does not exist

# ── §5 WRITES INTO A NESTED SCHEMA (ABI v92). Every one of these was REFUSED by name in slice 2b, when
#    only table_open carried a path; the eight write crossings carry one now. The assertion that matters is
#    not that they succeed but that they land in the RIGHT directory, which §7 checks from the outside.
statement ok
INSERT INTO lk.sales.eu.deep VALUES (99);

query I
SELECT count(*) FROM lk.sales.eu.deep;
----
2

statement ok
UPDATE lk.sales.eu.deep SET v = 100 WHERE v = 99;

query I
SELECT v FROM lk.sales.eu.deep ORDER BY v;
----
42
100

statement ok
DELETE FROM lk.sales.eu.deep WHERE v = 100;

query I
SELECT v FROM lk.sales.eu.deep;
----
42

statement ok
CREATE TABLE lk.sales.eu.born AS SELECT 'x' AS c;

query I
SELECT c FROM lk.sales.eu.born;
----
x

statement ok
ALTER TABLE lk.sales.eu.born ADD COLUMN z INTEGER;

query I
SELECT count(*) FROM duckdb_columns() WHERE database_name='lk' AND table_name='born';
----
2

statement ok
DROP TABLE lk.sales.eu.born;

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name='lk' AND table_name='born';
----
0

# A NESTED CREATE SCHEMA makes the directory, and a table lands inside it.
statement ok
CREATE SCHEMA lk.sales.west;

statement ok
CREATE TABLE lk.sales.west.t AS SELECT 5 AS q;

query I
SELECT q FROM lk.sales.west.t;
----
5

statement ok
DROP SCHEMA lk.sales.west CASCADE;

query I
SELECT count(*) FROM duckdb_schemas() WHERE database_name='lk' AND schema_name='west';
----
0

# ⚠ COMMENT ON is the ONE statement that still cannot reach a nested table, and the layer that stops it is
#    DuckDB's PARSER, not us: it caps the statement at three qualifications. Pinned as the parser's error
#    rather than ours — the day upstream lifts the cap, this row fails and sends the reader here.
statement error
COMMENT ON TABLE lk.sales.eu.deep IS 'hi';
----
Too many qualifications found

# ── §6 THE DEPTH-1 CONTROL. Everything above must still work one level up — without this, a build that
#    had broken writing altogether would look identical.
statement ok
INSERT INTO lk.sales.orders VALUES (2, 'us');

query I
SELECT count(*) FROM lk.sales.orders;
----
2

statement ok
ALTER TABLE lk.sales.orders ADD COLUMN note VARCHAR;

statement ok
CREATE TABLE lk.sales.born AS SELECT 5 AS x;

statement ok
DROP TABLE lk.sales.born;

statement ok
CREATE SCHEMA lk.west;

statement ok
DROP SCHEMA lk.west;

# ── §7 the data really is where the PATH says, checked from OUTSIDE the nested attach: the deep table is
#    re-read through a sub-root attached FLAT at <root>/sales, where it is an ordinary two-level table. If a
#    nested write had landed one level too shallow, this is the row that would miss it — the nested catalog
#    would happily read back whatever it had written to the wrong place.
query I
SELECT v FROM lk.sales.eu.deep;
----
42

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/nl/sales' AS sub (TYPE fabricator, PROVIDER 'delta', schemas true);

query I
SELECT v FROM sub.eu.deep;
----
42

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name='sub' AND table_name='born';
----
0

statement ok
DETACH sub;

statement ok
DETACH lk;

# ── §8 re-attach: the tree is storage, not session state.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/nl' AS lk2 (TYPE fabricator, PROVIDER 'delta', schemas 'nested');

query I
SELECT v FROM lk2.sales.eu.deep;
----
42

query I
SELECT count(*) FROM lk2.sales.orders;
----
2

statement ok
DETACH lk2;

# ── §9 a ROOT-LEVEL Delta table is NOT discovered under schemas 'nested' (every level is a real directory, so a
#    table needs at least one). It is skipped with a WARNING rather than refused; `schemas true` does not
#    discover one either, so this is not a regression — it is the behaviour being pinned.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/rootonly' AS r1 (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE r1.main.loose AS SELECT 3 AS v;

statement ok
DETACH r1;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/rootonly' AS r2 (TYPE fabricator, PROVIDER 'delta', schemas 'nested');

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name='r2';
----
0

statement ok
DETACH r2;

# The SAME root attached FLAT still sees it — the control proving the table exists and §9 measured a layout
# rule rather than a broken write.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/rootonly' AS r3 (TYPE fabricator, PROVIDER 'delta');

query I
SELECT v FROM r3.main.loose;
----
3

statement ok
DETACH r3;

# ── §10 "main" is an ORDINARY directory under schemas 'nested', not the synthetic schema of root-level tables.
#    That is the whole reason §9 skips rather than synthesizes: `CREATE TABLE cat.main.t` under `schemas true`
#    makes a REAL <root>/main/ folder, so a synthetic "main" would have collided with the commonest layout.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/nl' AS lk3 (TYPE fabricator, PROVIDER 'delta', schemas 'nested');

query I
SELECT v FROM lk3.main.flat;
----
7

statement ok
DETACH lk3;

# ── §11 the `schemas` VALUES. One option, three states — 'none' | 'onelevel' | 'nested' — with true/false as
#    PERMANENT spellings of 'onelevel'/'none' (§1 and §2 use `schemas true`). It replaced two booleans,
#    `schemas` and `nested_schemas`, whose four combinations meant three things.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/nl' AS v1 (TYPE fabricator, PROVIDER 'delta', schemas 'onelevel');

# 'onelevel' sees the two-level table (with §6's write in it) and NOT the depth-2 one.
# ⚠ Under the old boolean read this value was silently FALSE (anything but "true" was), so this row is also
#   the one that fails if the option ever stops being parsed as a three-way value.
query II
SELECT id, region FROM v1.sales.orders ORDER BY id;
----
1	eu
2	us

statement error
SELECT * FROM v1.sales.eu.deep;
----
does not exist

statement ok
DETACH v1;

# 'none' and `false` are the FLAT layout — the root-level table §9 planted, in "main".
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/rootonly' AS v2 (TYPE fabricator, PROVIDER 'delta', schemas 'none');

query I
SELECT v FROM v2.main.loose;
----
3

statement ok
DETACH v2;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/rootonly' AS v3 (TYPE fabricator, PROVIDER 'delta', schemas false);

query I
SELECT v FROM v3.main.loose;
----
3

statement ok
DETACH v3;

# An unknown value is REFUSED and names the three — never read as "off", which is what the boolean did.
statement error
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/nl' AS bad1 (TYPE fabricator, PROVIDER 'delta', schemas 'deep');
----
expected 'none', 'onelevel' or 'nested'

# ⚠⚠ The retired key is REFUSED BY NAME, not ignored. ATTACH options are free-form, so a leftover
#    `nested_schemas true` would otherwise attach FLAT and every nested table would simply be missing.
statement error
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/nl' AS bad2 (TYPE fabricator, PROVIDER 'delta', nested_schemas true);
----
use schemas 'nested'

# ── §12 EVERY CATALOG OBJECT NESTS, not only tables (ABI v97). The functions, macros and views a provider
#    declares are registered at their schema PATH, so `cat.sales.eu.fab_pct()` resolves. The fixture puts a
#    top-level `eu` BESIDE `sales.eu` on purpose: under nesting the leaf is exactly what is NOT unique, and two
#    of the assertions below are only discriminating because the leaf names a different schema.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/fx' AS fx1 (TYPE fabricator, PROVIDER 'delta', schemas true);

statement ok
CREATE SCHEMA fx1.sales;

statement ok
CREATE SCHEMA fx1.eu;

statement ok
CREATE TABLE fx1.eu.fab_view_source AS SELECT 'top eu' AS who;

statement ok
DETACH fx1;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/fx/sales' AS fx2 (TYPE fabricator, PROVIDER 'delta', schemas true);

statement ok
CREATE SCHEMA fx2.eu;

statement ok
CREATE TABLE fx2.eu.fab_view_source AS SELECT 'nested sales.eu' AS who;

statement ok
DETACH fx2;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/fx' AS fx (TYPE fabricator, PROVIDER 'delta', schemas 'nested');

# The discovery wire carries the PATH: one declaration per level, the depth-2 one included.
query II
SELECT schema_path, kind FROM fabricator_functions('fx') WHERE name = 'fab_delta_info' ORDER BY ALL;
----
[eu]	table
[main]	table
[sales]	table
[sales, eu]	table

# A catalog function, a scalar macro, a defaulted-parameter macro and a table macro, all at depth 2.
query I
SELECT count(*) FROM fx.sales.eu.fab_delta_info();
----
5

query RI
SELECT fx.sales.eu.fab_pct(1, 4), fx.sales.eu.fab_clamp(500);
----
25.0	100

query I
SELECT count(*) FROM fx.sales.eu.fab_numbers(5);
----
5

query II
SELECT * FROM fx.sales.eu.fab_view_info;
----
fabricator	delta

query I
SELECT count(*) FROM fx.sales.eu.fab_view_numbers;
----
10

# ⚠⚠ THE VIEW BODY BINDS AGAINST THE VIEW'S OWN PATH. fab_view_probe reads an UNQUALIFIED fab_view_source.
#    DuckDB 2.0 anchors a view body on ParentSchema().name — the LEAF — so without the host's rewrite this read
#    `top eu`: a different schema's rows, with no error (measured on native DuckDB too;
#    docs/duckdb-upstream-issues.md). The top-level read is the control that the fixture can tell them apart.
query I
SELECT who FROM fx.sales.eu.fab_view_probe;
----
nested sales.eu

query I
SELECT who FROM fx.eu.fab_view_probe;
----
top eu

# ⚠⚠ A CTAS INTO A NESTED SCHEMA KEEPS ITS ROWS when the leaf names an existing table elsewhere. DuckDB 2.0's
#    planner asks whether `<leaf>.<name>` exists, finds `eu.fab_view_source` at the top level, and plans a bare
#    CREATE with the query DROPPED — the nested table came out EMPTY and the statement succeeded.
statement ok
CREATE TABLE fx.eu.collide AS SELECT 'top' AS w;

statement ok
CREATE TABLE fx.sales.eu.collide AS SELECT 'nested' AS w;

query T
SELECT w FROM fx.sales.eu.collide;
----
nested

query T
SELECT w FROM fx.eu.collide;
----
top

# The planner's other two branches survive the path-checked replacement: REPLACE rewrites, IF NOT EXISTS keeps.
statement ok
CREATE OR REPLACE TABLE fx.sales.eu.collide AS SELECT 'replaced' AS w;

statement ok
CREATE TABLE IF NOT EXISTS fx.sales.eu.collide AS SELECT 'ignored' AS w;

query T
SELECT w FROM fx.sales.eu.collide;
----
replaced

statement error
CREATE TABLE fx.sales.eu.collide AS SELECT 'dup' AS w;
----
already exists

# ── scoped invalidation. A pattern is tried against the bare name AND the qualified `a.b.name`, so it can
#    name one branch of the tree. Both `collide` tables are materialized, then widened behind the catalog's
#    back through flat attaches; only what the pattern names may pick the new column up.
query I
SELECT count(*) FROM (DESCRIBE fx.sales.eu.collide);
----
1

query I
SELECT count(*) FROM (DESCRIBE fx.eu.collide);
----
1

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/fx' AS fxa (TYPE fabricator, PROVIDER 'delta', schemas true);

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested/fx/sales' AS fxb (TYPE fabricator, PROVIDER 'delta', schemas true);

statement ok
ALTER TABLE fxa.eu.collide ADD COLUMN extra INTEGER;

statement ok
ALTER TABLE fxb.eu.collide ADD COLUMN extra INTEGER;

query I
SELECT fabricator_invalidate_cache('fx', 'sales\.eu\.collide');
----
true

query I
SELECT count(*) FROM (DESCRIBE fx.sales.eu.collide);
----
2

query I
SELECT count(*) FROM (DESCRIBE fx.eu.collide);
----
1

# The bare name still reaches every branch, which is the pre-v97 meaning unchanged.
query I
SELECT fabricator_invalidate_cache('fx', 'collide');
----
true

query I
SELECT count(*) FROM (DESCRIBE fx.eu.collide);
----
2

statement ok
DETACH fxa;

statement ok
DETACH fxb;

statement ok
DETACH fx;
