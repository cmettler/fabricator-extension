# name: test/verify_delta_catalog_alter.test
# description: Delta folder-as-catalog SCHEMA EVOLUTION. ADD COLUMN (metadata-only commit appending a nullable
#              column — no file rewrite; old rows read NULL, backfilled), RENAME COLUMN and DROP COLUMN
#              (metadata-only on a column-mapping table — the default — the field keeps / retires its
#              columnMapping.id + physicalName; readers reconcile old files) are supported. ALTER COLUMN TYPE
#              raises a clean "not supported" error. Set FABRICATOR_DELTA_WRITE_DIR to a WRITABLE base path. Local FS.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogalter' AS lake (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE lake.main.t (id INTEGER, name VARCHAR);

statement ok
INSERT INTO lake.main.t SELECT i, 'a' || i FROM range(1, 4) AS r(i);

# ADD COLUMN — metadata-only; existing rows read back NULL for the new column.
statement ok
ALTER TABLE lake.main.t ADD COLUMN score INTEGER;

query ITI
SELECT id, name, score FROM lake.main.t ORDER BY id;
----
1	a1	NULL
2	a2	NULL
3	a3	NULL

# A row written AFTER the ADD carries the new column's value; old rows still NULL.
statement ok
INSERT INTO lake.main.t VALUES (4, 'a4', 40);

query ITI
SELECT id, name, score FROM lake.main.t ORDER BY id;
----
1	a1	NULL
2	a2	NULL
3	a3	NULL
4	a4	40

# A predicate / projection on the new column works (DuckDB applies it above the scan).
query IT
SELECT id, name FROM lake.main.t WHERE score IS NULL ORDER BY id;
----
1	a1
2	a2
3	a3

query I
SELECT score FROM lake.main.t WHERE score = 40;
----
40

# Add a second column of a different type (VARCHAR) — backfills NULL on all prior rows.
statement ok
ALTER TABLE lake.main.t ADD COLUMN tag VARCHAR;

statement ok
INSERT INTO lake.main.t VALUES (5, 'a5', 50, 'hot');

query ITIT
SELECT id, name, score, tag FROM lake.main.t ORDER BY id;
----
1	a1	NULL	NULL
2	a2	NULL	NULL
3	a3	NULL	NULL
4	a4	40	NULL
5	a5	50	hot

# Durability: detach + re-attach re-reads the evolved schema.
statement ok
DETACH lake;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogalter' AS lake2 (TYPE fabricator, PROVIDER 'delta');

query ITIT
SELECT id, name, score, tag FROM lake2.main.t ORDER BY id;
----
1	a1	NULL	NULL
2	a2	NULL	NULL
3	a3	NULL	NULL
4	a4	40	NULL
5	a5	50	hot

# RENAME COLUMN is a metadata-only commit on a column-mapping table (the default) — the field keeps its
# columnMapping.id + physicalName, so existing data files read unchanged under the new logical name.
statement ok
ALTER TABLE lake2.main.t RENAME COLUMN name TO label;

query ITIT
SELECT id, label, score, tag FROM lake2.main.t ORDER BY id;
----
1	a1	NULL	NULL
2	a2	NULL	NULL
3	a3	NULL	NULL
4	a4	40	NULL
5	a5	50	hot

# DROP COLUMN is also metadata-only under column mapping — old files keep the physical column, readers
# reconcile it away against the current schema.
statement ok
ALTER TABLE lake2.main.t DROP COLUMN tag;

query ITI
SELECT id, label, score FROM lake2.main.t ORDER BY id;
----
1	a1	NULL
2	a2	NULL
3	a3	NULL
4	a4	40
5	a5	50

# ALTER COLUMN TYPE is still cleanly unsupported on Delta.
statement error
ALTER TABLE lake2.main.t ALTER COLUMN score TYPE BIGINT;
----
not supported

statement ok
DETACH lake2;

# ============================================================================
# ALTER carriers that are IDENTIFIERS: they must survive whatever a quoted DuckDB name contains.
#
# ⚠ This is REGRESSION protection created by ABI v74, not a pre-existing property. Before it, a column
# name crossed as a RAW C string (alter_table's arg1/arg2) where no escaping question arose; now it rides
# a JSON doc, so every identifier the host sends is escaped by the renderer and un-escaped by the parser.
# Getting that wrong would be silent for ordinary names and wrong for exactly these — a tab is a control
# character (invalid raw inside a JSON string), and quote/backslash are the two the doc's own delimiters
# are made of. The sibling carriers are pinned where they live: `columns` in verify_delta_sorted_by,
# `path` in verify_delta_catalog_nested_alter.
# ============================================================================

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/alterescape' AS esc (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE esc.main.t (id INTEGER);

# ADD COLUMN: the name crosses in the doc AND on the type channel's Arrow field — both must agree, or the
# column is added under one spelling and addressed by the other.
statement ok
ALTER TABLE esc.main.t ADD COLUMN "a	b" INTEGER;

statement ok
ALTER TABLE esc.main.t ADD COLUMN "q""uote" INTEGER;

statement ok
INSERT INTO esc.main.t VALUES (1, 10, 100);

query III
SELECT id, "a	b", "q""uote" FROM esc.main.t;
----
1	10	100

# RENAME COLUMN carries the awkward name on BOTH sides of the doc (column + new_name).
statement ok
ALTER TABLE esc.main.t RENAME COLUMN "a	b" TO "back\slash";

query II
SELECT id, "back\slash" FROM esc.main.t;
----
1	10

# …and the old spelling is genuinely gone, so the rename addressed the column it named rather than
# silently creating a second one.
statement error
SELECT "a	b" FROM esc.main.t;
----
not found

statement ok
ALTER TABLE esc.main.t DROP COLUMN "q""uote";

query II
SELECT id, "back\slash" FROM esc.main.t;
----
1	10

statement ok
DETACH esc;
