# name: test/verify_plugin_fluid.test
# description: The Fluid/Liquid template engine as a PLUGIN — fabricator_render(template, params), moved out
#              of Fabricator.SqlServer into Fabricator.FluidPlugin. Two things are gated here: the render
#              behaviour itself (moved verbatim from verify_global_functions, where it used to run against
#              the first-party build), and the property that makes this plugin worth having in-tree — a
#              plugin carrying its OWN NuGet closure. See docs/plugin-system.md.
# group: [fabricator]

require fabricator

# ⚠ THE SUITE RUNNER POINTS THIS AT build/plugins/fluid AND NOTHING ELSE. It must NOT be the tier's normal
# plugin root: that root holds Fabricator.SamplePlugin, and a second loaded plugin would make the "exactly one
# provider" assertion below say nothing. Build the fixture with:
#   dotnet build dotnet/Fabricator.FluidPlugin -c Release
require-env FABRICATOR_PLUGIN_DIR

# ⚠ A per-suite scratch DIRECTORY, used only by the slice-4 section at the foot of this file: it writes a
# small template library with COPY and points fluid_template_root at it. The name says delta because that
# is what the runner has always called its scratch dir; nothing Delta is involved.
require-env FABRICATOR_DELTA_WRITE_DIR

# ============================================================================================
# THE PLUGIN LOADED — and this is the assertion the whole file rests on, because every render below is
# vacuous if the function came from somewhere else.
# ============================================================================================

query TT
SELECT status, provider FROM fabricator_plugins() WHERE status = 'loaded';
----
loaded	fluid

# ⚠ NOTHING was rejected. A plugin whose private dependency failed to resolve reports `rejected` with the
# exception, NOT a missing function — so without this a broken closure would surface further down as a
# confusing render failure rather than as what it is.
query I
SELECT count(*) FROM fabricator_plugins() WHERE status = 'rejected';
----
0

# ============================================================================================
# THE PRIVATE NuGet CLOSURE — the property Fabricator.SamplePlugin cannot test
#
# ⚠ Fabricator.SamplePlugin is pure IL with no third-party package, so until this plugin existed NOTHING
# exercised BackendRegistry.InstallPluginResolver actually loading a plugin's own dependencies out of the
# plugin folder. Fluid.Core 3.0.0-beta.7 pulls SIX assemblies (Fluid, Parlot, TimeZoneConverter,
# System.Linq.Async and two Microsoft.Extensions.*), and since the move they are NOT in the bridge payload —
# so any successful render below IS the closure resolving. That is why the first render is stated as a
# property, not just a value.
#
# ⚠ The pin is a PRERELEASE (v3.0 has no stable package yet), so a bump here is a code-compatibility
# question rather than a routine one — this suite is what answers it. Moving 2.31.0 -> 3.0.0-beta.7 already
# changed one annotation under us; see the NULL-value section below.
# ============================================================================================

# Basic render: Liquid substitution from a JSON params bag. Reaching Fluid at all proves the resolver worked.
query I
SELECT fabricator_render('Hello {{ name }}, you have {{ n }} messages', '{"name":"world","n":3}');
----
Hello world, you have 3 messages

# params as a DuckDB STRUCT (type-safe, no quoting) — the SQLNULL->ANY sentinel lets the same fn accept it.
query I
SELECT fabricator_render('Hello {{ name }}, you have {{ n }} messages', {'name':'world','n':3});
----
Hello world, you have 3 messages

# STRUCT params vectorized over rows (each row's struct supplies that row's variables).
query I
SELECT fabricator_render('id={{ id }}', {'id': i}) AS r FROM range(3) t(i) ORDER BY r;
----
id=0
id=1
id=2

# Vectorized over a batch (the template is a per-row column; params empty object).
query I
SELECT fabricator_render('row ' || i::VARCHAR, '{}') AS r FROM range(3) t(i) ORDER BY i;
----
row 0
row 1
row 2

# Liquid control flow (if/else) — proves it's a real template engine, not just substitution.
query I
SELECT fabricator_render('{% if x > 1 %}big{% else %}small{% endif %}', '{"x":5}');
----
big

# Liquid loop over a JSON array param.
query I
SELECT fabricator_render('{% for i in items %}{{ i }};{% endfor %}', '{"items":[1,2,3]}');
----
1;2;3;

# A NULL template yields NULL (SPECIAL_HANDLING — the function sees NULL args).
query I
SELECT fabricator_render(NULL, '{"a":1}');
----
NULL

# An unreferenced/empty params object renders the literal text.
query I
SELECT fabricator_render('static text', '{}');
----
static text

# Composes with a normal query (no catalog dependency): a per-row JSON params string.
query I
SELECT fabricator_render('id={{ id }}', '{"id":' || i::VARCHAR || '}') AS r FROM range(2) t(i) ORDER BY i;
----
id=0
id=1

# ⚠ AN UNTYPED NULL IN AN *ANY-DECLARED* POSITION. This was BROKEN BEFORE the ABI v80 bind session existed and
# no suite covered it: DuckDB exports an Arrow null-typed array with null_count = 0 and Apache.Arrow refuses
# it ("Length must equal null count"), so this call failed at execute. The one NULL the suites did carry (the
# NULL-template case above) sits in a VARCHAR-declared position, which DuckDB CASTS — which is exactly why the
# ANY position stayed untested. It has to work on BOTH crossings: at bind the literal is still SQLNULL
# (argument casts run after the bind callback), and at execute it still is, because an ANY parameter is never
# cast. ⚠ verify_global_functions keeps a VARARGS-tail twin of this assertion, so the crossing stays covered
# in the hermetic tier where no plugin is loaded.
query I
SELECT fabricator_render('x{{ a }}', NULL);
----
x

# ---- NULL VALUES in the params bag (as opposed to a NULL bag) ----
#
# ⚠⚠ THESE EXIST BECAUSE A COMPILER WARNING FOUND THE GAP, not because anyone predicted it. Moving the pin to
# Fluid 3.0.0-beta.7 produced CS8604 on SetValue: v3 annotates its `object` overload as NON-nullable. Reading
# Fluid's source showed the body maps null to NilValue.Instance anyway, so the behaviour was never at risk —
# but the suite had no assertion either way, and a NULL is ORDINARY here: a STRUCT field can be NULL and JSON
# has `null`. The plugin now routes null to the FluidValue overload itself rather than leaning on a
# PRERELEASE's internal null-handling branch, and these pin what that must produce.
#
# The brackets are load-bearing: an empty render and a NULL result are both "nothing" in a bare query.

query I
SELECT '[' || fabricator_render('{{ a }}', {'a': NULL::VARCHAR}) || ']';
----
[]

query I
SELECT '[' || fabricator_render('{{ a }}', '{"a":null}') || ']';
----
[]

# nil is FALSY, not merely empty — the property a template branching on an optional value depends on.
query I
SELECT fabricator_render('{% if a %}set{% else %}nil{% endif %}', {'a': NULL::BIGINT});
----
nil

# ============================================================================================
# THE PLUGIN IS THE ONLY SOURCE OF THIS FUNCTION
#
# ⚠ This is the assertion that pins the MOVE rather than the behaviour. fabricator_render used to be a
# first-party global registered by Fabricator.SqlServer; a build that had merely ADDED the plugin while
# leaving the original in place would pass every render above. Exactly one registration, and the plugin is
# the only thing loaded (asserted at the top), so this one is it.
# ============================================================================================

query I
SELECT count(*) FROM duckdb_functions() WHERE function_name = 'fabricator_render';
----
1

# A malformed template is refused with the function's own message, not a render of the broken text.
statement error
SELECT fabricator_render('{% if %}', '{}');
----
<REGEX>:.*template parse error.*

# ============================================================================================
# fluid_query — the template IS the SQL (slice 1)
#
# A SQL-GENERATING table function (ISqlTableFunction): at BIND time DuckDB hands the generator the call's
# constant arguments and SUBSTITUTES the returned SELECT for the call. So the output schema is arg-dependent
# for free, nothing streams through C# at execution, and the generated SQL's own scans keep their pushdown.
# See docs/macros-and-sqlgen-functions.md §2 and docs/fluid-templating.md.
# ============================================================================================

query II
SELECT DISTINCT function_name, function_type FROM duckdb_functions() WHERE function_name = 'fluid_query';
----
fluid_query	table

# `params` is NAMED and OPTIONAL, so a template with no variables needs no bag at all.
query II
SELECT * FROM fluid_query('SELECT 1 AS a, ''x'' AS b');
----
1	x

query I
SELECT * FROM fluid_query('SELECT {{ n }} AS n', params := {'n': 7});
----
7

query I
SELECT * FROM fluid_query('SELECT {% if big %}999{% else %}1{% endif %} AS v', params := '{"big":true}');
----
999

# An explicit NULL bag is the same as none — the ANY-declared slot carries an untyped NULL (see the
# fabricator_render assertion above for why that crossing is worth pinning).
query I
SELECT * FROM fluid_query('SELECT 1 AS v', params := NULL);
----
1

# ---- THE SHAPE sqlgen EXISTS FOR: the SQL TEXT, not just the values, depends on the argument ----
#
# The COLUMN LIST comes from the argument, so the same call with a different bag has a different output
# schema. A macro cannot express this; a marshaled table function would have to declare one schema up front.

query II
SELECT * FROM fluid_query(
  'SELECT {% for c in cols %}{{ c | sql_ident }}{% unless forloop.last %}, {% endunless %}{% endfor %} FROM (SELECT 1 AS a, 2 AS b, 3 AS c)',
  params := {'cols': ['a','c']});
----
1	3

query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM fluid_query(
  'SELECT {% for c in cols %}{{ c | sql_ident }}{% unless forloop.last %}, {% endunless %}{% endfor %} FROM (SELECT 1 AS a, 2 AS b, 3 AS c)',
  params := {'cols': ['a','b','c']}));
----
3

# ============================================================================================
# ⚠⚠ COMPARISON AND ARITHMETIC — THE ASSERTIONS THIS WHOLE FILE TURNS ON
#
# Fluid 3.0.0-beta.7 understands System.Text.Json's JsonNode natively, and that support RENDERS CORRECTLY
# WHILE COMPUTING WRONG: bound with no value converter, `{{ d.i }}` prints 3 and `{% if d.i > 1 %}` takes the
# ELSE branch, `{{ d.money | plus: 1 }}` with 19.99 gives 1, and `{% if d.s == 'x' %}` with s = "x" is FALSE.
# Leaves arrive as opaque nodes: they format faithfully and compare as nothing.
#
# ⇒ EVERY RENDER ASSERTION IN THIS FILE PASSES ON A BUILD WITH NO CONVERTER. These do not. And because
# fluid_query's rendered text IS the statement, a wrong {% if %} branch there is a wrong SQL statement — the
# silent-wrong-answer class, not a formatting nit. See FluidValueModel's header for the full measurement.
# ============================================================================================

query I
SELECT * FROM fluid_query('SELECT {% if n > 5 %}''big''{% else %}''small''{% endif %} AS c', params := '{"n":7}');
----
big

query I
SELECT * FROM fluid_query('SELECT {{ n | plus: 1 }} AS v', params := '{"n":41}');
----
42

query III
SELECT fabricator_render('{% if n > 1 %}big{% else %}small{% endif %}', '{"n":3}') AS cmp,
       fabricator_render('{{ n | plus: 1 }}', '{"n":19.99}')                       AS arith,
       fabricator_render('{% if s == "x" %}y{% else %}n{% endif %}', '{"s":"x"}')  AS streq;
----
big	20.99	y

# The same three through an Arrow STRUCT rather than JSON — a different code path to the same value model.
query III
SELECT fabricator_render('{% if n > 1 %}big{% else %}small{% endif %}', {'n': 3}) AS cmp,
       fabricator_render('{{ n | plus: 1 }}', {'n': 19.99::DECIMAL(10,2)})        AS arith,
       fabricator_render('{% if s == "x" %}y{% else %}n{% endif %}', {'s': 'x'})  AS streq;
----
big	20.99	y

# Comparison THROUGH a nested Arrow struct — the nested reader must produce a real number too, not a string.
query I
SELECT fabricator_render('{% if o.deep > 40 %}y{% else %}n{% endif %}', {'o': {'deep': 42}});
----
y

# ============================================================================================
# THE NUMBER LADDER: int64 -> decimal -> refuse
#
# ⚠ A SHIPPED BUG THIS FIXED, and it is this repo's own recorded trap in a new place. JsonToClr read
#   `e.TryGetInt64(out var l) ? l : e.GetDouble()`
# whose branches C# unifies to DOUBLE (long converts to double implicitly, not the reverse) — so the int64
# branch had NEVER had any effect and every JSON integer went through a double. Fluid then builds its
# NumberValue with Convert.ToDecimal, which keeps 15 significant digits. Invisible for small integers, which
# is why nothing caught it. Same shape as ReadTimestamp's documented (object) casts, one method away.
# ============================================================================================

query IIII
SELECT fabricator_render('{{ n }}', '{"n":9007199254740993}')             AS json_bigint,
       fabricator_render('{{ n }}', {'n': 9007199254740993::BIGINT})      AS struct_bigint,
       fabricator_render('{{ n }}', '{"n":19.99}')                        AS money,
       fabricator_render('{{ n }}', '{"n":0}')                            AS zero;
----
9007199254740993	9007199254740993	19.99	0

# ⚠ A CONSEQUENCE OF THE LADDER, pinned so it is a decision rather than a surprise: taking the decimal rung
# preserves a JSON number's written form, so `3.0` renders `3.0` where a double rendered `3`. In a function
# whose output is SQL that is the better answer (the literal keeps its type), but it IS a change.
query I
SELECT fabricator_render('{{ n }}', '{"n":3.0}');
----
3.0

# ⚠ REFUSED rather than rendered as 0 or failing mid-render inside Fluid. Fluid's number model is DECIMAL, so
# a magnitude outside it cannot be represented at all: without this, 1e100 raises Fluid's own
# "Value was either too large or too small for a Decimal" naming neither the parameter nor the value, and
# 1e-30 renders as `0` — a silently wrong number spliced into a SQL statement. The `zero` column asserted
# just above is the POSITIVE CONTROL: a real 0 must still render, or this check would be refusing everything.

statement error
SELECT fabricator_render('{{ n }}', '{"n":1e100}');
----
<REGEX>:.*cannot be represented in a template.*

statement error
SELECT fabricator_render('{{ n }}', '{"n":1e-30}');
----
<REGEX>:.*cannot be represented in a template.*

# The same refusal on the ARROW path, so a DuckDB DOUBLE cannot smuggle it past the JSON check.
statement error
SELECT fabricator_render('{{ n }}', {'n': 1e100::DOUBLE});
----
<REGEX>:.*cannot be represented in a template.*

# ============================================================================================
# WHAT IS AND IS NOT QUOTED — {{ }} is RAW by design; `sql` / `sql_ident` are the opt-in
#
# Raw interpolation is the entire point of generating SQL from a template: a template must be able to emit
# object names, predicates and whole fragments. So values that are DATA get an explicit filter, and both are
# ALLOW-LISTS (the fabricator_va_values precedent) — a value with no provably safe rendering is refused by
# name rather than interpolated.
# ============================================================================================

query I
SELECT * FROM fluid_query('SELECT {{ v | sql }} AS v', params := {'v': 'O''Brien'});
----
O'Brien

# A quote in an IDENTIFIER, likewise doubled rather than breaking the statement.
query I
SELECT column_name FROM (DESCRIBE SELECT * FROM fluid_query('SELECT 1 AS {{ n | sql_ident }}', params := {'n': 'we"ird'}));
----
we"ird

# nil renders as SQL NULL, not as the empty string (which would be a syntax error, or worse, '').
query I
SELECT * FROM fluid_query('SELECT {{ v | sql }} AS v', params := {'v': NULL::VARCHAR});
----
NULL

statement error
SELECT * FROM fluid_query('SELECT {{ v | sql }}', params := {'v': [1,2]});
----
<REGEX>:.*cannot render a.*as a SQL literal.*

# ============================================================================================
# THE PLAN: the call is GONE, and the generated SQL's own scans keep their pushdown
#
# This is the property that separates sqlgen from a marshaled table function, and no row assertion can see
# it — the same rows come back either way.
# ============================================================================================

statement ok
CREATE TABLE fq_t AS SELECT i AS id, i%7 AS g, 'v'||i AS v FROM range(1000) s(i);

# Projection AND filter reach the base table; `fluid_query` appears nowhere.
query II
EXPLAIN SELECT id FROM fluid_query('SELECT * FROM fq_t WHERE g = {{ g }}', params := {'g': 3});
----
physical_plan	<REGEX>:.*SEQ_SCAN.*fq_t.*Projections: id.*Filters: g=3.*

query I
SELECT count(*) FROM fluid_query('SELECT * FROM fq_t WHERE g = {{ g }}', params := {'g': 3});
----
143

# A VIEW over it re-binds on every use — the generator's contract is "deterministic and side-effect free,
# because binds repeat and happen without execution".
statement ok
CREATE VIEW fq_v AS SELECT * FROM fluid_query('SELECT id FROM fq_t WHERE g = {{ g }}', params := {'g': 5});

query I
SELECT count(*) FROM fq_v;
----
143

query I
SELECT count(*) FROM fq_v;
----
143

# ============================================================================================
# THE PARAMS BAG: STRUCT, MAP or JSON, meaning the same thing in each
#
# ⚠ One value model serves both functions deliberately: two mappings would let the same bag render
# differently depending on which function received it.
# ============================================================================================

query I
SELECT fabricator_render('{{ a }}-{{ b }}', MAP {'a': 'one', 'b': 'two'});
----
one-two

# Nested struct, nested list, list indexing and .size, all from one Arrow bag.
query I
SELECT fabricator_render('{{ o.deep }}|{% for t in tags %}{{ t }};{% endfor %}|{{ tags[1] }}|{{ tags.size }}',
                         {'o': {'deep': 42}, 'tags': ['a','b','c']});
----
42|a;b;c;|b|3

# ⚠ ORDINAL access, for a row whose members have no usable names. MEASURED: Fluid resolves `p[0]` by asking
# the indexable for the KEY "0", so an int-parse fallback IS index access — it is not a second mechanism. A
# member genuinely NAMED "0" therefore wins, which is the right precedence.
query I
SELECT fabricator_render('{{ p[0] }}/{{ p[1] }}', {'p': {'x': 1, 'y': 2}});
----
1/2

statement error
SELECT fabricator_render('{{ n }}', 'not json');
----
<REGEX>:.*params is not valid JSON.*

statement error
SELECT fabricator_render('{{ n }}', '[1,2]');
----
<REGEX>:.*params JSON must be an OBJECT.*

# A template that renders to nothing is refused by the shared sqlgen plumbing, naming the function.
statement error
SELECT * FROM fluid_query('   ');
----
<REGEX>:.*generated no SQL.*

# ============================================================================================
# DRIVING THE TEMPLATE FROM SQL — a prepared parameter, and a session variable
#
# A sqlgen generator sees constant VALUES, never expressions, so "where does the bag come from" is a real
# question for anyone building a pipeline on this. Both routes work, and the second is the one that reads a
# bag out of a table without a client.
# ============================================================================================

statement ok
PREPARE fq_p AS SELECT * FROM fluid_query('SELECT {{ n }} AS n', params := ?);

query I
EXECUTE fq_p({'n': 1});
----
1

# The SAME prepared statement, a different bag: DuckDB re-binds every EXECUTE, so the generator runs again
# and the substituted SQL differs.
query I
EXECUTE fq_p({'n': 2});
----
2

# ⚠ AND THE OUTPUT SCHEMA MAY DIFFER BETWEEN TWO EXECUTES OF ONE PREPARED STATEMENT — measured, and worth
# pinning because it is surprising: a prepared statement is normally a fixed plan with a fixed result shape.
# Here the re-bind re-renders the template, so the column LIST is whatever this EXECUTE's bag says.
statement ok
PREPARE fq_pc AS SELECT * FROM fluid_query(
  'SELECT {% for c in cols %}{{ c | sql_ident }}{% unless forloop.last %}, {% endunless %}{% endfor %} FROM (SELECT 1 AS a, 2 AS b, 3 AS c)',
  params := ?);

query I
EXECUTE fq_pc({'cols': ['a']});
----
1

query III
EXECUTE fq_pc({'cols': ['a','b','c']});
----
1	2	3

# A session variable is the pure-SQL way to feed the bag — the same idiom the CDC reader documents for
# carrying a cursor, and it means a template-driven pipeline needs no client and no spliced literal.
statement ok
SET VARIABLE fq_cols = ['a','c'];

query II
SELECT * FROM fluid_query(
  'SELECT {% for c in cols %}{{ c | sql_ident }}{% unless forloop.last %}, {% endunless %}{% endfor %} FROM (SELECT 1 AS a, 2 AS b, 3 AS c)',
  params := {'cols': getvariable('fq_cols')});
----
1	3

# ============================================================================================
# TEMPORAL AND BINARY VALUES
#
# ⚠⚠ A DATE USED TO RENDER THE PREVIOUS DAY. `Date32Array.GetDateTime` returns a DateTime with
# `Kind = Unspecified`, which Fluid resolves against the machine's LOCAL zone, so on a UTC+2 box
# `DATE '2026-09-01'` rendered as `2026-08-31 22:00:00Z` — and fluid_query would have spliced that wrong
# date into a statement. The fix is the KIND (`DateTime.SpecifyKind(..., Utc)`).
#
# ⚠ `TemplateOptions.TimeZone` is NOT the fix and setting it changes nothing — MEASURED, an Unspecified
# midnight renders identically under TimeZoneInfo.Utc and under the local zone. `DateOnly` is not the fix
# either: Fluid has no support for it and degrades it to a culture-dependent string (`09/01/2026`).
#
# ⚠ THIS SUITE CANNOT PROVE THE TIMEZONE HALF ON ITS OWN. The assertions below are correct on a UTC box
# whether or not the fix is present; what makes them discriminating is running where local time is not UTC,
# which is where the bug was found. Said plainly rather than implied.
# ============================================================================================

query I
SELECT fabricator_render('{{ d }}', {'d': DATE '2026-09-01'});
----
2026-09-01 00:00:00Z

# A wall-clock TIMESTAMP is not shifted either — it was already right (ReadTimestamp stamps it UTC), and
# this is the CONTROL that says the date fix did not achieve its result by shifting everything else.
query I
SELECT fabricator_render('{{ t }}', {'t': TIMESTAMP '2026-09-01 12:34:56'});
----
2026-09-01 12:34:56Z

query I
SELECT fabricator_render('{{ t }}', {'t': TIMESTAMPTZ '2026-09-01 12:34:56+00'});
----
2026-09-01 12:34:56Z

# ⚠⚠ FLUID DOES NOT ORDER TEMPORAL VALUES AT ALL, and this assertion pins that rather than wishing it away.
# MEASURED with controls: `>` and `<` are BOTH false for two different dates (as DateTime and as
# DateTimeOffset alike), while `==`/`!=` behave; numbers and strings compare correctly with the same
# operators, so it is specific to temporals. A template branching on `{% if d > cutoff %}` therefore takes
# the ELSE branch silently — the same failure class as §the value-model header, but this one is Fluid's and
# not something the value model can fix without making a date stop being a date.
query I
SELECT fabricator_render('{% if a > b %}later{% else %}earlier{% endif %}',
                         {'a': DATE '2026-09-02', 'b': DATE '2026-09-01'});
----
earlier

# THE WORKAROUND, gated beside it so the docs are not the only place it exists: format to ISO first and
# compare the strings. ISO-8601 sorts lexicographically, verified across a year boundary.
query I
SELECT fabricator_render(
  '{% assign x = a | date: "%Y-%m-%d" %}{% assign y = b | date: "%Y-%m-%d" %}{% if x > y %}later{% else %}earlier{% endif %}',
  {'a': DATE '2027-01-01', 'b': DATE '2026-12-31'});
----
later

# ⚠ EVERY temporal renders as a TIMESTAMPTZ literal through `| sql`, whatever it started as: Fluid's date
# model is one DateTimeOffset, so by the time the filter sees it a DATE, a TIMESTAMP and a TIMESTAMPTZ are
# indistinguishable. The INSTANT survives, the TYPE does not. Pinned as a documented limitation, with the
# cast that works around it.
# ⚠ Asserted by TYPE and by INSTANT rather than by rendered text: a TIMESTAMPTZ's display form depends on
# the session timezone, so pinning the string would make this suite report the runner's locale.
query I
SELECT typeof(raw) FROM fluid_query('SELECT {{ d | sql }} AS raw', params := {'d': DATE '2026-09-01'});
----
TIMESTAMP WITH TIME ZONE

query I
SELECT raw = TIMESTAMPTZ '2026-09-01 00:00:00+00'
FROM fluid_query('SELECT {{ d | sql }} AS raw', params := {'d': DATE '2026-09-01'});
----
true

# ⚠⚠ GETTING A DATE BACK OUT IS A TIMEZONE TRAP, AND IT IS SILENT IN EVERY DIRECTION.
#
# ANYTHING that reads a TIMESTAMPTZ without NAMING a timezone reads it in the SESSION's timezone — the
# direct cast included — so in any session west of UTC it yields the PREVIOUS DAY with no error. That is
# DuckDB behaving correctly; it is our TIMESTAMPTZ representation (forced by Fluid collapsing DATE /
# TIMESTAMP / TIMESTAMPTZ into one DateTimeOffset) that turns it into a trap. MEASURED on the literal
# `| sql` produces for DATE '2026-09-01':
#
#   route                                        UTC          America/New_York   Australia/Sydney
#   ------------------------------------------   ----------   ----------------   ----------------
#   ::DATE                                       2026-09-01   2026-08-31         2026-09-01
#   ::TIMESTAMP::DATE                            2026-09-01   2026-08-31         .
#   date_trunc('day', …)                         2026-09-01   2026-08-31         .
#   strftime(…, '%Y-%m-%d')                      2026-09-01   2026-08-31         .
#   extract('day' FROM …) / date_part('day', …)   1           31                 .
#   (… AT TIME ZONE 'UTC')::DATE                 2026-09-01   2026-09-01         ok
#   {{ d | date: '%Y-%m-%d' | sql }}::DATE       2026-09-01   2026-09-01         ok
#
# ⚠⚠ AN EARLIER VERSION OF THIS SECTION ASSERTED THAT `::DATE` DID NOT EXIST ("Conversion Error:
# Unimplemented type for cast"), AND THAT WAS AN ARTIFACT OF THIS SUITE, NOT A FACT ABOUT DuckDB. The cast
# needs ICU, unittest does not auto-load extensions, and the suite had no `require icu` — so a missing
# REQUIRE presented as a missing FEATURE. The repo already records the opposite direction (requiring
# something not compiled in SKIPS silently); this is the same hazard the other way round, and it is worse,
# because it reads as a definite negative result about the engine.
#
# ⚠⚠ AND EVERY TEMPORAL ASSERTION IN THIS FILE IS A FLUID-PIN GATE. The pin is a PRERELEASE and there is
# TIMEZONE WORK ON FLUID'S MAIN BRANCH that 3.0.0-beta.7 does not carry (reported by the user, not verified
# here). So these are the assertions most likely to move at the next bump -- which is the point: they pin
# TODAY's behaviour exactly, so a change arrives as a failed assertion naming the value rather than as a
# silently different rendering. If they move, re-derive §7.4a of docs/fluid-templating.md rather than
# editing the expected values to match.
#
# ⚠⚠ WHAT THIS COSTS IN PRACTICE DEPENDS ON THE SESSION, AND THE EXPECTED DEPLOYMENT IS SAFE.
# DuckDB's TimeZone defaults to the SYSTEM zone once ICU is loaded (measured: `Europe/Berlin` on this box) --
# NOT to UTC. But a fabricator deployment is expected to run at `SET TimeZone = 'UTC'`, because that is what
# the Delta protocol stores and accepts, and there every route above agrees. So this is a trap for a session
# that DEVIATES from the expected configuration, not a defect the normal path walks into. It is gated
# because "the normal path is safe" is exactly the reasoning under which a trap survives unrecorded.
#
# ⚠ AND NOTE THE OTHER TIMEZONE: the DATE-renders-previous-day bug fixed above is the .NET side reading
# `TimeZoneInfo.Local`, i.e. the OS zone of the machine running the extension. Setting DuckDB's TimeZone to
# UTC does NOT affect it. Two different clocks, two different fixes; only this section's is neutralised by
# running at UTC.
#
# ⚠ THE SESSION TIMEZONE IS SET EXPLICITLY BELOW AND THAT IS THE WHOLE POINT: with no ICU loaded there is no
# `TimeZone` SETTING AT ALL (measured: "Setting with name timezone is not in the catalog") and a TIMESTAMPTZ
# degenerates to UTC, so every route agrees and this section would pass while saying nothing. That is also
# the whole of the original confusion -- no ICU meant no timezone AND no TIMESTAMPTZ -> DATE cast, one cause
# presenting as two unrelated facts.

require icu

statement ok
SET TimeZone = 'America/New_York';

# ⚠ THE SILENT WRONG DAY, asserted as the value it actually produces. Pinning the truth is what makes this
# a warning to a reader rather than a wish, and it is where a future DuckDB change would surface.
query I
SELECT * FROM fluid_query('SELECT {{ d | sql }}::DATE AS d', params := {'d': DATE '2026-09-01'});
----
2026-08-31

query I
SELECT * FROM fluid_query('SELECT strftime({{ d | sql }}, ''%Y-%m-%d'') AS d', params := {'d': DATE '2026-09-01'});
----
2026-08-31

# ---- SAFE ROUTE 1: name the timezone. Works for a genuine TIMESTAMP too, and preserves the instant. ----

query I
SELECT * FROM fluid_query('SELECT ({{ d | sql }} AT TIME ZONE ''UTC'')::DATE AS d',
                          params := {'d': DATE '2026-09-01'});
----
2026-09-01

# ---- SAFE ROUTE 2: never build a TIMESTAMPTZ. Format to ISO in the template, quote THAT, then cast. ----
#
# The form the README teaches for a DATE, because no timezone is in play at any step — and, unlike route 1,
# it needs no ICU.

query I
SELECT typeof(d) FROM fluid_query('SELECT {{ d | date: "%Y-%m-%d" | sql }}::DATE AS d',
                                  params := {'d': DATE '2026-09-01'});
----
DATE

query I
SELECT * FROM fluid_query('SELECT {{ d | date: "%Y-%m-%d" | sql }}::DATE AS d',
                          params := {'d': DATE '2026-09-01'});
----
2026-09-01

# ⚠ THE POSITIVE CONTROL for both safe routes: they are not passing merely because this session agrees with
# UTC. It does not — the two wrong-day assertions above prove the session is genuinely offset, and these
# still answer 2026-09-01.

statement ok
SET TimeZone = 'UTC';

# ⚠ A BLOB arrives as a LOWERCASE HEX STRING. It used to arrive as a byte[], which Fluid renders as the
# concatenated decimal bytes — `'ab'::BLOB` came out as `9798`, which looks like a number and is useless.
# Hex is lossless, readable, and compares as a string.
query I
SELECT fabricator_render('{{ b }}', {'b': 'ab'::BLOB});
----
6162

# ============================================================================================
# SLICE 3 — the Fluid `query(sql)` function, running SQL on the hosting DuckDB through the
# HostQueryTransport seam. See docs/fluid-templating.md §9.
#
# ⚠⚠ `require json` IS LOAD-BEARING, NOT HYGIENE. The SELECT-only refusal below classifies with
# `json_serialize_sql`, i.e. DuckDB's own parser. `unittest` does NOT auto-load extensions (unlike the
# shell), so without this every query() call would be REFUSED — the check fails closed — and the whole
# section would read as a broken feature rather than a missing REQUIRE. That is this repo's own recorded
# trap in both directions: a missing require presenting as a missing feature, and a require for something
# not compiled in SKIPPING silently.
require json

statement ok
CREATE TABLE fq_people AS SELECT * FROM (VALUES (1,'ada'),(2,'bob'),(3,'cy')) v(id,nm);

# ---- the basic shape: rows addressed by NAME, by ORDINAL, and counted --------------------------------
# ⚠ Name and ordinal go through ONE lookup rule (docs/fluid-templating.md §6 settled that in slice 1):
# Fluid resolves `r[1]` by asking for the KEY "1", so an int-parse fallback IS index access.
query I
SELECT fabricator_render('{% assign rs = query("SELECT id, nm FROM fq_people ORDER BY id") %}{% for r in rs %}[{{ r.id }}:{{ r.nm }}:{{ r[1] }}]{% endfor %} n={{ rs.size }}', NULL);
----
[1:ada:ada][2:bob:bob][3:cy:cy] n=3

# An empty result is an empty array, not an error or a nil.
query I
SELECT fabricator_render('{% assign rs = query("SELECT id FROM fq_people WHERE id > 99") %}n={{ rs.size }}', NULL);
----
n=0

# A NULL cell renders empty and is FALSY, the same as everywhere else in this plugin.
query I
SELECT fabricator_render('{% assign rs = query("SELECT NULL AS v") %}{% for r in rs %}[{{ r.v }}]{% if r.v %}T{% else %}F{% endif %}{% endfor %}', NULL);
----
[]F

# ⚠ An unknown column returns FALSE from TryGetValue rather than a nil value, which is what lets Fluid
# answer `.size` itself — the rule ArrowStruct documents and EagerRow had to keep.
query I
SELECT fabricator_render('{% assign rs = query("SELECT 1 AS a") %}{% for r in rs %}[{{ r.nosuch }}][{{ r.size }}]{% endfor %}', NULL);
----
[][1]

# The value model is the SAME one slice 1 built, so arithmetic and comparison work on query results too —
# which is the property §7.1 showed a render-only assertion cannot see.
query I
SELECT fabricator_render('{% assign rs = query("SELECT 19.99::DECIMAL(9,2) AS m, 3 AS i") %}{% for r in rs %}{{ r.m | plus: 1 }}|{% if r.i > 1 %}GT{% else %}LE{% endif %}{% endfor %}', NULL);
----
20.99|GT

# ============================================================================================
# THE POINT OF THE SLICE: a template asks the DATABASE what SQL to generate, at BIND time.
#
# This is the shape §3 worried about and §8 measured safe — a host query executed inside `bind_replace`,
# during the binder's own walk. The output SCHEMA of the statement is decided by rows read at bind.
# ============================================================================================

statement ok
CREATE TABLE fq_cols AS SELECT * FROM (VALUES ('alpha',1),('beta',2)) v(nm,ord);

query II
SELECT * FROM fluid_query('SELECT {% assign rs = query("SELECT nm FROM fq_cols ORDER BY ord") %}{% for r in rs %}{{ r.nm | sql }} AS {{ r.nm | sql_ident }}{% unless forloop.last %}, {% endunless %}{% endfor %}');
----
alpha	beta

# ⚠ The COLUMN NAMES are the assertion, not the values: they can only have come from the bind-time read.
query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM fluid_query('SELECT {% assign rs = query("SELECT nm FROM fq_cols ORDER BY ord") %}{% for r in rs %}1 AS {{ r.nm | sql_ident }}{% unless forloop.last %}, {% endunless %}{% endfor %}')) ORDER BY column_name;
----
alpha	INTEGER
beta	INTEGER

# ============================================================================================
# ⚠⚠ THE REFUSAL, AND ITS POSITIVE CONTROL — the pair is the gate, neither half alone.
#
# §8.3 MEASURED that a bind-time write fires on EXPLAIN of a statement that never executes. So the refusal
# has to hold exactly there. But "the write did not happen" is ALSO true of a build where bind-time query()
# had stopped working altogether — the vacuous-pass shape — so the control below establishes that binds
# really do fire here before the refusal is asserted.
# ============================================================================================

statement ok
CREATE TABLE fq_audit AS SELECT 1 AS n;

# POSITIVE CONTROL: EXPLAIN of a NEVER-EXECUTED statement still binds, and the bind's query() really runs —
# proven by the plan carrying column names that exist only in fq_cols.
# ⚠ The `<REGEX>:` form on the physical_plan row, because EXPLAIN cannot be a subquery source
# (Parser Error) — the convention this suite already uses a few sections up.
query II
EXPLAIN SELECT * FROM fluid_query('SELECT {% assign rs = query("SELECT nm FROM fq_cols ORDER BY ord") %}{% for r in rs %}1 AS {{ r.nm | sql_ident }}{% unless forloop.last %}, {% endunless %}{% endfor %}');
----
physical_plan	<REGEX>:.*alpha.*beta.*

# ...and in that same position a WRITE is refused.
statement error
EXPLAIN SELECT * FROM fluid_query('SELECT 1 AS x {% assign r = query("INSERT INTO fq_audit VALUES (99)") %}');
----
runs SELECT statements only

# NOTHING WAS WRITTEN. Read together with the control above, this says the refusal fired rather than the
# mechanism being absent.
query I
SELECT count(*) FROM fq_audit;
----
1

# ============================================================================================
# EVERY REFUSAL CLASS, and each one is a shape a cheaper classifier gets wrong.
# ⚠ The classifier is `json_serialize_sql` — DuckDB's OWN parser — with the SQL crossing as a BOUND
# PARAMETER. Two cheaper mechanisms were measured and both are broken; see FluidHostQuery.cs.
# ============================================================================================

# A plain write.
statement error
SELECT fabricator_render('{% assign r = query("INSERT INTO fq_audit VALUES (99)") %}x', NULL);
----
runs SELECT statements only

# ⚠ A write that BEGINS WITH `WITH` — the shape a prefix check ("starts with SELECT or WITH") waves through.
statement error
SELECT fabricator_render('{% assign r = query("WITH x AS (SELECT 99) INSERT INTO fq_audit SELECT * FROM x") %}x', NULL);
----
runs SELECT statements only

# ⚠⚠ THE INJECTION ESCAPE that defeats a `SELECT * FROM (<sql>)` wrap. MEASURED against that wrap, this
# exact string performed the INSERT; a DROP TABLE variant dropped the table. String concatenation has an
# escape by construction, which is why the classifier takes the SQL as a VALUE instead.
statement error
SELECT fabricator_render('{% assign r = query("SELECT 1) ; INSERT INTO fq_audit VALUES (99); SELECT * FROM (SELECT 2") %}x', NULL);
----
runs SELECT statements only

# Multi-statement input, which the serializer refuses as a whole.
statement error
SELECT fabricator_render('{% assign r = query("SELECT 1; INSERT INTO fq_audit VALUES (99)") %}x', NULL);
----
runs SELECT statements only

statement error
SELECT fabricator_render('{% assign r = query("DROP TABLE fq_audit") %}x', NULL);
----
runs SELECT statements only

statement error
SELECT fabricator_render('{% assign r = query("COPY fq_audit TO ''/tmp/fq_should_not_exist.csv''") %}x', NULL);
----
runs SELECT statements only

# ⚠ A SYNTAX error surfaces the ENGINE'S OWN message rather than "not a SELECT" — the two causes are
# different and reporting the wrong one sends the author looking in the wrong place.
statement error
SELECT fabricator_render('{% assign r = query("SELEC 1") %}x', NULL);
----
syntax error

# ⚠ MEASURED: json_serialize_sql('') reports NO error, because an empty string parses to zero statements —
# so the classifier alone would wave it through. It is refused before reaching the classifier.
statement error
SELECT fabricator_render('{% assign r = query("") %}x', NULL);
----
empty statement

# NOT ONE of the statements above ran.
query I
SELECT count(*) FROM fq_audit;
----
1

statement ok
DROP TABLE IF EXISTS fq_audit;

# ============================================================================================
# WHAT IS ADMITTED, AND WHAT IS REFUSED THOUGH READ-ONLY — the cost stated rather than hidden.
# ============================================================================================

# The SELECT family, including DuckDB's own shorthands.
query I
SELECT fabricator_render('{% assign a = query("VALUES (1),(2)") %}{% assign b = query("TABLE fq_people") %}{% assign c = query("FROM fq_people") %}{% assign d = query("WITH x AS (SELECT 1 AS v) SELECT * FROM x") %}{% assign e = query("SELECT 1 UNION ALL SELECT 2") %}{{ a.size }}{{ b.size }}{{ c.size }}{{ d.size }}{{ e.size }}', NULL);
----
23312

# ⚠ THE COST: PIVOT is READ-ONLY and is REFUSED, because json_serialize_sql cannot serialize it — and that
# holds even wrapped in a subquery, where it would otherwise execute. Being conservative in this direction
# is the correct trade, since the alternative admits writes. Pinned so the cost is visible rather than
# discovered.
statement error
SELECT fabricator_render('{% assign r = query("PIVOT fq_people ON nm USING sum(id)") %}x', NULL);
----
runs SELECT statements only

# SUMMARIZE and DESCRIBE, by contrast, ARE serializable and pass — so the refusal is not "anything unusual".
query I
SELECT fabricator_render('{% assign r = query("DESCRIBE SELECT 1 AS a") %}{{ r.size }}', NULL);
----
1

# ============================================================================================
# ⚠ TRANSACTION VISIBILITY — §8.2, and it is a property of opening a separate connection rather than
# anything bind introduces. A template cannot observe the writes of the transaction running it.
# ============================================================================================

statement ok
CREATE TABLE fq_txn AS SELECT 1 AS n;

statement ok
BEGIN;

statement ok
INSERT INTO fq_txn VALUES (2);

# The statement's OWN scan sees the uncommitted row...
query I
SELECT count(*) FROM fq_txn;
----
2

# ...and query(), on its own connection, does not.
query I
SELECT fabricator_render('{% assign r = query("SELECT n FROM fq_txn") %}{{ r.size }}', NULL);
----
1

statement ok
COMMIT;

# After COMMIT it does — which is what makes the row above a visibility result rather than a broken read.
query I
SELECT fabricator_render('{% assign r = query("SELECT n FROM fq_txn") %}{{ r.size }}', NULL);
----
2

# ============================================================================================
# NAMED PARAMETER BINDING — `sql | query: name: value`, binding $name. See docs/fluid-templating.md §9.10.
#
# ⚠⚠ IT IS A FILTER, NOT A SECOND ARGUMENT TO THE FUNCTION, and Fluid's GRAMMAR is what decides that:
# MEASURED, `query('s', a: 5)` is a PARSE error ("End of tag was expected") while `'s' | query: a: 5`
# parses and arrives with its names populated. Fluid has no dictionary literal either ({'a':1} and {a:1}
# both fail), so the filter is the ONLY spelling in this Fluid that can carry named parameters — and it
# needs nothing added to Fluid.
# ============================================================================================

statement ok
CREATE TABLE fq_orders AS SELECT * FROM (VALUES ('eu',10,1),('us',25,2),('eu',5,3)) v(region,amt,id);

# Two parameters, of different types, bound by NAME.
query I
SELECT fabricator_render('{% assign rs = "SELECT id FROM fq_orders WHERE region = $region AND amt > $min ORDER BY id" | query: region: "eu", min: 6 %}{% for r in rs %}[{{ r.id }}]{% endfor %} n={{ rs.size }}', NULL);
----
[1] n=1

# ⚠ The DISCRIMINATING row: the same statement with a different bound value returns a different set. Without
# it, the assertion above would pass equally on a build that ignored the parameters and got lucky.
query I
SELECT fabricator_render('{% assign rs = "SELECT id FROM fq_orders WHERE region = $region AND amt > $min ORDER BY id" | query: region: "eu", min: 1 %}{% for r in rs %}[{{ r.id }}]{% endfor %}', NULL);
----
[1][3]

# Parameter values may come from template variables, not only literals.
query I
SELECT fabricator_render('{% assign g = "us" %}{% assign rs = "SELECT id FROM fq_orders WHERE region = $r" | query: r: g %}{% for r in rs %}{{ r.id }}{% endfor %}', NULL);
----
2

# ============================================================================================
# ⚠⚠ THE PROPERTY THAT JUSTIFIES PARAMETERS EXISTING: A VALUE CANNOT BECOME SQL.
#
# The payload is a classic injection string. Bound, it is ONE VARCHAR that matches no region, so the answer
# is 0. Spliced into the SQL it would have matched every row and answered 3. The two outcomes differ, which
# is what makes this an assertion rather than a demonstration.
# ============================================================================================

query I
SELECT fabricator_render('{% assign rs = "SELECT count(*) AS n FROM fq_orders WHERE region = $r" | query: r: "eu'' OR 1=1 --" %}{% for x in rs %}{{ x.n }}{% endfor %}', NULL);
----
0

# THE CONTROL: the identical statement with a value that DOES match. Without it, "0" would be equally true
# of a build where the parameter never reached the statement at all.
query I
SELECT fabricator_render('{% assign rs = "SELECT count(*) AS n FROM fq_orders WHERE region = $r" | query: r: "eu" %}{% for x in rs %}{{ x.n }}{% endfor %}', NULL);
----
2

# ============================================================================================
# TYPES — the allow-list, and what each one becomes.
# ⚠ Fluid's number model IS decimal (§7.3), so every number arrives as one; an INTEGRAL value is narrowed
# back to BIGINT so the common spelling behaves like the literal it replaced, and a fractional one keeps its
# own scale as DECIMAL(38, s) rather than being widened or rounded.
# ============================================================================================

query I
SELECT fabricator_render('{% assign rs = "SELECT $i AS i, $d::VARCHAR AS d, $s AS s, $b AS b, ($n IS NULL) AS n" | query: i: 42, d: 19.99, s: "hi", b: true, n: nil %}{% for r in rs %}{{ r.i }}|{{ r.d }}|{{ r.s }}|{{ r.b }}|{{ r.n }}{% endfor %}', NULL);
----
42|19.99|hi|true|true

# The bound integer really is an INTEGER-family value, not text: it arithmetics on the server.
query I
SELECT fabricator_render('{% assign rs = "SELECT $i + 1 AS v" | query: i: 41 %}{% for r in rs %}{{ r.v }}{% endfor %}', NULL);
----
42

# ============================================================================================
# REFUSALS — each is a shape that would otherwise be a silently wrong statement.
# ============================================================================================

# ⚠ A POSITIONAL argument is REFUSED rather than ignored. Fluid lets a filter take both, and a positional
# value could only mean `?` / `$1`, which cannot coexist with the by-name binding a named batch selects.
# Dropping it silently would run the statement with a parameter the author believed they had supplied.
statement error
SELECT fabricator_render('{% assign rs = "SELECT $1" | query: 5 %}x', NULL);
----
NAMED parameters only

statement error
SELECT fabricator_render('{% assign rs = "SELECT $a" | query: 5, a: 1 %}x', NULL);
----
positional argument

# A LIST has no SQL parameter form and is refused BY NAME rather than rendered into the statement.
statement error
SELECT fabricator_render('{% assign L = (1..3) %}{% assign rs = "SELECT $a" | query: a: L %}x', NULL);
----
has no SQL parameter form

# ⚠ A MISSING parameter is DuckDB's own error and it NAMES the parameter — better than anything we could
# invent, and the reason nothing here tries to pre-validate the placeholder set.
statement error
SELECT fabricator_render('{% assign rs = "SELECT $a, $b" | query: a: 1 %}x', NULL);
----
parameters: b

# ⚠ THE SELECT-ONLY REFUSAL APPLIES TO THE FILTER FORM TOO — the parameters do not buy an exemption. A
# parameterised write is still a write, and still fires at bind.
statement error
SELECT fabricator_render('{% assign rs = "DELETE FROM fq_orders WHERE id = $i" | query: i: 1 %}x', NULL);
----
runs SELECT statements only

query I
SELECT count(*) FROM fq_orders;
----
3

# ============================================================================================
# BOTH SPELLINGS COEXIST, and the no-parameter cases are unchanged.
# ⚠ The FUNCTION and the FILTER share the name `query`. The function is registered per context; the filter
# ONCE in the shared TemplateOptions, with the caller travelling in AmbientValues — registering it per
# render would mutate that shared object on every call and report another render's function name.
# ============================================================================================

query I
SELECT fabricator_render('{% assign a = query("SELECT 1 AS v") %}{% assign b = "SELECT 2 AS v" | query %}{% for r in a %}{{ r.v }}{% endfor %}{% for r in b %}{{ r.v }}{% endfor %}', NULL);
----
12

# The filter form works at BIND inside fluid_query, exactly as the function form does — with its parameter
# deciding the generated SQL.
query I
SELECT * FROM fluid_query('SELECT {% assign rs = "SELECT amt FROM fq_orders WHERE id = $i" | query: i: 2 %}{% for r in rs %}{{ r.amt }}{% endfor %} AS a');
----
25


# ============================================================================================
# SLICE 4 — {% include %} / {% render %} READ THROUGH DuckDB'S OWN FILESYSTEM
# (docs/fluid-templating.md §10)
#
# A template library lives on whatever storage the host can reach. HostTemplateFileProvider resolves an
# include against `fluid_template_root` and reads it with read_blob over slice 3's HostQueryTransport, so
# s3://, abfss:// and onelake:// work with the persistent secrets already in scope. Only the LOCAL leg is
# gated: the mechanism is the transport, and a remote root would be exercising DuckDB's filesystem rather
# than anything of ours.
#
# ⚠⚠ IT DOES NOT USE A FILESYSTEM SEAM, and the reason is the finding of this slice: a GLOBAL function has
# no ambient opener, so every fs_* host callback would receive a null ClientContext — measured, an access
# violation inside HostFs.OpenRead. The same missing ambient is why the root must be SET GLOBAL.
#
# ⚠ NOT GATED, and said here rather than implied: the per-render read CACHE (it changes how many times a
# file is read and changes no answer, and nothing in SQL can observe a read count), and the MULTI-MATCH
# refusal inside the reader (a mutant survives it — Resolve refuses glob metacharacters in the subpath
# first, so nothing a template can write reaches it; only a ROOT containing one could, and that is the
# user's own string).
# ============================================================================================

# ⚠ THE SETTING IS REGISTERED AT ALL, and it is the first thing a PLUGIN has ever declared besides
# functions. Every assertion below is vacuous without it, and a plugin whose Settings never reached the host
# would surface further down as a mysterious refusal rather than as what it is.
query I
SELECT count(*) FROM duckdb_settings() WHERE name = 'fluid_template_root';
----
1

# ⚠⚠ A RELATIVE INCLUDE WITH NO ROOT IS REFUSED, and this has to come before any SET. Fail-closed: the
# alternative is resolving against the process working directory, i.e. reading a file the author never
# named.
statement error
SELECT fabricator_render('{% include ''hello'' %}', NULL);
----
no root is set

# --- the library, written by DuckDB itself -------------------------------------------------
# ⚠ PER_THREAD_OUTPUT on this first COPY is what CREATES the directory. A plain COPY to a file path does
# NOT create its parent, and the scratch directory the runner exports need not exist from DuckDB's point of
# view. (It leaves a data_0.csv in the root, which is harmless: nothing enumerates a template root.)
statement ok
COPY (SELECT 1 AS c) TO '${FABRICATOR_DELTA_WRITE_DIR}/tpl' (FORMAT csv, PER_THREAD_OUTPUT true, HEADER false);

statement ok
COPY (SELECT 'hi {{ who }}' AS c) TO '${FABRICATOR_DELTA_WRITE_DIR}/tpl/hello.liquid' (FORMAT csv, HEADER false, QUOTE '');

statement ok
COPY (SELECT 'outer[{% include ''hello'' %}]' AS c) TO '${FABRICATOR_DELTA_WRITE_DIR}/tpl/outer.liquid' (FORMAT csv, HEADER false, QUOTE '');

statement ok
COPY (SELECT 'SELECT {{ n }} AS n' AS c) TO '${FABRICATOR_DELTA_WRITE_DIR}/tpl/frag.liquid' (FORMAT csv, HEADER false, QUOTE '');

statement ok
COPY (SELECT 'BARE' AS c) TO '${FABRICATOR_DELTA_WRITE_DIR}/tpl/both' (FORMAT csv, HEADER false, QUOTE '');

statement ok
COPY (SELECT 'WITHEXT' AS c) TO '${FABRICATOR_DELTA_WRITE_DIR}/tpl/both.liquid' (FORMAT csv, HEADER false, QUOTE '');

statement ok
COPY (SELECT chr(65279) || 'BOMMED' AS c) TO '${FABRICATOR_DELTA_WRITE_DIR}/tpl/bom.liquid' (FORMAT csv, HEADER false, QUOTE '');

# ⚠⚠ AN ABSOLUTE INCLUDE NEEDS NO ROOT — asserted HERE, with none set, which is the only position where
# it discriminates. Placed after the SET GLOBAL below it passes on a build that ignores the absolute form
# entirely: MEASURED on Windows, joining a drive-lettered path onto a root still opens the file, so the
# join accidentally succeeds and a mutant survives. With no root, a build that does not recognise an
# absolute path has nothing to join and refuses.
query I
SELECT rtrim(fabricator_render('{% include ''${FABRICATOR_DELTA_WRITE_DIR}/tpl/hello.liquid'' %}', {'who': 'abs'}), chr(10));
----
hi abs

# ⚠⚠ A PLAIN SESSION `SET` — and pinning that spelling is the point, because it did NOT work when slice 4
# shipped and the docs told users to write SET GLOBAL instead. A global scalar's crossing carried no
# settings session, so a session-scoped write landed in a layer the plugin could not read; ABI v82 hands
# scalarfn_bind/_execute the caller's context (and RESTORES it), which closed that gap for every plugin.
# The regression this guards is the whole feature silently reverting to needing SET GLOBAL.
statement ok
SET fluid_template_root = '${FABRICATOR_DELTA_WRITE_DIR}/tpl';

# --- it resolves, and the outer scope reaches inside ---------------------------------------
# ⚠ rtrim(x, chr(10)) throughout, NOT trim(x): DuckDB's one-argument trim removes SPACES and leaves a
# newline exactly where the fixtures have one, since COPY appends it. That trailing byte is part of the
# file and therefore part of the include, which is exactly what the nested case below shows.
query I
SELECT rtrim(fabricator_render('{% include ''hello'' %}', {'who': 'world'}), chr(10));
----
hi world

# ⚠ AND `SET GLOBAL` STILL WORKS — the two spellings differ in SCOPE, not in whether the plugin can see
# them. Kept beside the session one so a change that fixed only the layer this suite happens to write
# cannot pass.
statement ok
SET GLOBAL fluid_template_root = '${FABRICATOR_DELTA_WRITE_DIR}/tpl';

query I
SELECT rtrim(fabricator_render('{% include ''hello'' %}', {'who': 'global'}), chr(10));
----
hi global

statement ok
RESET GLOBAL fluid_template_root;

# ⚠ NAMING THE EXTENSION IS THE SPELLING TO PREFER. MEASURED on Fluid 3.0.0-beta.7: an include asks for the
# bare subpath FIRST and only then for `<subpath>.liquid`, so omitting it costs TWO host reads where naming
# it costs one — on remote storage, two round trips.
query I
SELECT rtrim(fabricator_render('{% include ''hello.liquid'' %}', {'who': 'again'}), chr(10));
----
hi again

# ⚠⚠ AND THE BARE PROBE WINS WHEN BOTH FILES EXIST — the discriminating pair. A library holding `both` and
# `both.liquid` resolves `{% include 'both' %}` to the one WITHOUT the extension, which is the opposite of
# what an author following a `.liquid` convention would guess.
query I
SELECT rtrim(fabricator_render('{% include ''both'' %}', NULL), chr(10));
----
BARE

query I
SELECT rtrim(fabricator_render('{% include ''both.liquid'' %}', NULL), chr(10));
----
WITHEXT

# NESTED — a partial that includes another. The inner file's own trailing newline lands INSIDE the outer
# text, which is why this renders the line break rather than trimming it away.
query I
SELECT replace(rtrim(fabricator_render('{% include ''outer'' %}', {'who': 'x'}), chr(10)), chr(10), '~');
----
outer[hi x~]

# {% render %} goes through the same provider.
query I
SELECT rtrim(fabricator_render('{% render ''hello'' %}', {'who': 'rendered'}), chr(10));
----
hi rendered

# --- a BOM does not survive an include -----------------------------------------------------
# ⚠⚠ AND IT IS FLUID DOING IT, NOT US — which is why this is asserted rather than assumed. A file provider
# hands Fluid a STREAM and Fluid reads it with a StreamReader, which detects and strips a UTF-8 byte-order
# mark. We wrote a BOM-stripping branch first and a mutant proved it INERT; it was deleted. ⚠ Fluid does NOT
# strip a BOM from a template passed as a STRING (measured), so fabricator_render on a BOM-prefixed literal
# keeps it — that is the caller's own text. The ord() is the assertion: 66 is 'B', 65279 is the BOM, and
# neither rtrim nor trim removes it.
query IT
SELECT ord(rtrim(fabricator_render('{% include ''bom'' %}', NULL), chr(10))[1]),
       rtrim(fabricator_render('{% include ''bom'' %}', NULL), chr(10));
----
66	BOMMED

# --- what a failure says -------------------------------------------------------------------
# ⚠⚠ A MISSING INCLUDE NAMES THE PATHS IT ASKED FOR, not just the include's argument. Fluid's own
# FileNotFoundException carries only `nope`, which tells an author whose ROOT is wrong nothing at all — so
# the provider records each resolved path and FluidEngine appends them. Both probes appear, which is also
# how the two-read cost of an extension-less include is visible from SQL.
#
# ⚠ Claiming ABSENCE here is legitimate, unlike most of this repo: read_blob returns ZERO ROWS for a file
# that is not there and THROWS for anything else, so a credential or transport failure never reaches this
# message — it arrives as its own error. The engine establishes absence; we do not infer it.
statement error
SELECT fabricator_render('{% include ''nope'' %}', NULL);
----
tried

# ⚠ A SUBDIRECTORY JOINS AS WRITTEN. There is no fixture under sub/ — creating a directory from SQL is
# awkward — so what this pins is the RESOLUTION, which is the half that could silently be wrong; the read
# failing afterwards is expected, and the message naming the JOINED path is the assertion.
statement error
SELECT fabricator_render('{% include ''sub/x'' %}', NULL);
----
tpl/sub/x.liquid

# --- what the root is, and what it is not --------------------------------------------------
# ⚠⚠ THE ROOT IS ERGONOMICS, NOT A SANDBOX, and the suite says so rather than letting these refusals imply
# otherwise. A template that can {% include %} is being rendered by someone who can already run SQL here,
# and slice 3's query() lets that same template read any path the host can open — so confining an include
# would protect nothing. The absolute form is asserted ABOVE, before any root exists.
# ⚠ `..` is refused for PREDICTABILITY rather than safety: it resolves against a root the template's author
# may never see, and the absolute form above says the same thing unambiguously.
statement error
SELECT fabricator_render('{% include ''../escape'' %}', NULL);
----
cannot walk out of fluid_template_root

# ⚠⚠ A GLOB METACHARACTER IS REFUSED, and this one IS load-bearing: read_blob GLOBS, so `he*` would match
# hello.liquid today and something else the day a file is added — an include silently rendering a different
# partial on a directory change is very hard to see. Refused at the path rather than by taking the first
# row, because taking a row is what makes it silent.
statement error
SELECT fabricator_render('{% include ''he*'' %}', NULL);
----
would treat this as a glob

# --- the size ceiling ----------------------------------------------------------------------
statement ok
COPY (SELECT repeat('x', 1100000) AS c) TO '${FABRICATOR_DELTA_WRITE_DIR}/tpl/big.liquid' (FORMAT csv, HEADER false, QUOTE '');

# ⚠ Refused on the file's REPORTED SIZE, before a byte is allocated, so a root pointed at a directory of
# parquet cannot turn a typo into a multi-gigabyte read. This assertion is also what proves the enrichment
# above carries the REAL reason: without it the message would read "was not found" for a file that is
# plainly there.
statement error
SELECT fabricator_render('{% include ''big'' %}', NULL);
----
above the 1048576-byte ceiling

# --- the payoff ----------------------------------------------------------------------------
# ⚠⚠ THIS IS WHAT SLICE 4 EXISTS FOR: a SQL fragment lives in a file and any number of statements share it.
# The include resolves at RENDER, which for fluid_query is inside BIND — so the generated SQL, and with it
# the output SCHEMA, comes out of a file on storage.
query I
SELECT n FROM fluid_query('{% include ''frag'' %}', params := {'n': 41});
----
41

# ⚠ And the same fragment with a different parameter, so the assertion above cannot pass on a build that
# ignored the bag and hard-coded a constant.
query I
SELECT n FROM fluid_query('{% include ''frag'' %}', params := {'n': 7});
----
7

# ============================================================================================
# THE CALLER'S SESSION REACHES query() — ABI v83 (docs/host-query.md §OPEN item A, now closed)
#
# A template's query() runs on a connection of its own, and until v83 that connection had DuckDB's DEFAULTS:
# a statement could SET TimeZone and the template it rendered would still read the machine's zone, and an
# unqualified name would not resolve at all. The seam now passes the ambient ClientContext as the caller's
# session, so the fresh connection inherits its TimeZone and catalog search path.
#
# ⚠ It is NOT transaction inheritance, and the section below the fixtures still asserts that: query() reads
# COMMITTED state. What is inherited is name and time RESOLUTION.
# ============================================================================================

statement ok
SET TimeZone='UTC';

query I
SELECT fabricator_render('{% assign r = query("SELECT current_setting(''TimeZone'') AS tz") %}{% for x in r %}{{ x.tz }}{% endfor %}', NULL);
----
UTC

# ⚠ The DISCRIMINATOR, without which the row above would pass on a build that ignores the session entirely
# and happens to run where the machine zone IS UTC: a second, deliberately unusual zone. A build that
# inherits nothing reports the runner's zone for both, so the two rows cannot both be right by accident.
statement ok
SET TimeZone='Asia/Kolkata';

query I
SELECT fabricator_render('{% assign r = query("SELECT current_setting(''TimeZone'') AS tz") %}{% for x in r %}{{ x.tz }}{% endfor %}', NULL);
----
Asia/Kolkata

statement ok
RESET TimeZone;

# And the search path, which is the sharper half — a wrong timezone is a silently wrong VALUE, an
# unresolvable name is an outright failure for a table the caller can see unqualified.
statement ok
CREATE SCHEMA fq_sess;

statement ok
CREATE TABLE fq_sess.t AS SELECT 7 AS v;

statement ok
SET search_path='fq_sess';

query I
SELECT fabricator_render('{% assign r = query("SELECT v FROM t") %}{% for x in r %}{{ x.v }}{% endfor %}', NULL);
----
7

# ⚠ And it reaches the BIND-TIME surface too, which is the one that decides a statement's output SCHEMA:
# fluid_query renders while DuckDB is binding, so an unqualified name there resolves the caller's way.
query I
SELECT v FROM fluid_query('{% assign r = query("SELECT v FROM t") %}SELECT {% for x in r %}{{ x.v }}{% endfor %} AS v');
----
7

statement ok
RESET search_path;

# ============================================================================
# exec() -- the WRITE-side twin of query() (docs/fluid-templating.md 11)
# ============================================================================
#
# The two functions are deliberate mirror images through ONE mechanism
# (DuckDB's own parser, via json_serialize_sql): query() refuses everything
# that is not a SELECT, exec() refuses everything that is.
#
# exec() is available on BOTH surfaces (user decision, 2026-09-02). In
# fabricator_render it runs at EXECUTE time; in fluid_query it runs during
# bind_replace -- while DuckDB is BINDING -- and a bind REPEATS and happens
# WITHOUT execution. The section below therefore PINS that multiplication as
# known behaviour rather than refusing it, which is a stronger record than
# prose: if it ever stops multiplying, or starts multiplying differently, an
# assertion says so.

statement ok
CREATE TABLE ex_aud(id INTEGER);

statement ok
CREATE TABLE ex_t(id INTEGER, g VARCHAR);

statement ok
INSERT INTO ex_t VALUES (1, 'eu'), (2, 'eu'), (3, 'us');

# --- it works where it is permitted, and reports the affected-row count ---
query I
SELECT fabricator_render('rows={{ exec("INSERT INTO ex_aud VALUES (1), (2), (3)") }}', NULL);
----
rows=3

query I
SELECT count(*) FROM ex_aud;
----
3

# --- it works in fluid_query too, and THIS IS WHERE THE COST LIVES ---
# ⚠⚠ THE POINT OF THIS BLOCK: a write inside a fluid_query template happens at
# BIND, and binds repeat. Each step below is asserted against a FRESH counter so
# the multiplication is visible as three separate facts rather than one total.

statement ok
CREATE TABLE ex_bind(id INTEGER);

# STEP 1 -- EXPLAIN of a statement that EXECUTES NOTHING still performs the write.
statement ok
EXPLAIN SELECT * FROM fluid_query('SELECT {{ exec("INSERT INTO ex_bind VALUES (1)") }} AS n');

query I
SELECT count(*) FROM ex_bind;
----
1

# STEP 2 -- merely DEFINING a view over it performs it again. Nothing has been
# selected from the view at this point.
statement ok
CREATE VIEW ex_v AS SELECT * FROM fluid_query('SELECT {{ exec("INSERT INTO ex_bind VALUES (2)") }} AS n');

query I
SELECT count(*) FROM ex_bind;
----
2

# STEP 3 -- and EVERY USE of that view performs it again. This is the one that
# bites in practice: a writing template behind a view works in testing, where
# the statement runs once.
statement ok
SELECT count(*) FROM ex_v;

query I
SELECT count(*) FROM ex_bind;
----
3

statement ok
SELECT count(*) FROM ex_v;

query I
SELECT count(*) FROM ex_bind;
----
4

statement ok
DROP VIEW ex_v;

# --- ⚠⚠ AND THE STATEMENT CANNOT SEE THE WRITE ITS OWN TEMPLATE MADE ---
# This is the limitation that matters for the pattern anyone tries first --
# "let the template PREPARE what the generated SQL then reads". It does not
# work, and it fails in the least obvious way: the write really happens, and the
# statement that triggered it observes the OLD state, because exec() runs on its
# own connection and the outer statement's snapshot predates the commit.
#
# It is the exact mirror of query()'s documented rule (a template cannot observe
# the writes of the transaction running it) in the other direction.

statement ok
CREATE TABLE ex_prep(c INTEGER);

statement ok
INSERT INTO ex_prep VALUES (1);

# THE PAIR IS THE POINT. The first value shows the generated SQL read the OLD
# state; the second shows the write was real. Either alone is misleading -- a 1
# by itself would look like exec() had not run.
query I
SELECT c FROM fluid_query('{% assign _ = exec("UPDATE ex_prep SET c = 42") %}SELECT c FROM ex_prep');
----
1

query I
SELECT c FROM ex_prep;
----
42

# ⇒ AND THEREFORE a template CANNOT create a table the same statement selects
# from: the CREATE commits, but the table does not exist for that statement.
# ⚠ Note the error names the table as absent even though it now exists, which is
# what makes this worth pinning rather than describing.
statement error
SELECT * FROM fluid_query('{% assign _ = exec("CREATE OR REPLACE TABLE ex_late AS SELECT 1 AS c") %}SELECT c FROM ex_late');
----
does not exist

# ... and it really was created, which is what makes the refusal above a
# VISIBILITY result rather than a failed CREATE.
query I
SELECT count(*) FROM ex_late;
----
1

# ⚠ The usable shape is therefore a SEPARATE statement: exec() in one, the read
# in the next. Pinned so the workaround is not folklore.
query I
SELECT c FROM fluid_query('SELECT c FROM ex_prep');
----
42

# ⚠ POSITIVE CONTROL for the whole block: query() still works in fluid_query, so
# the counts above are exec() firing rather than the template surface behaving
# oddly in some other way.
query I
SELECT n FROM fluid_query('SELECT {{ query("SELECT 41 + 1 AS v")[0].v }} AS n');
----
42

# ⚠ And the earlier ex_aud count is UNCHANGED by all of the above, which is what
# shows the bind-time writes went where they were addressed and nowhere else.
query I
SELECT count(*) FROM ex_aud;
----
3

# --- EXPLAIN of a fabricator_render exec does NOT write ---
# ⚠ THE VOLATILITY MEASUREMENT. fabricator_render is VOLATILE (the
# IScalarFunction default), so DuckDB does not constant-fold it over constant
# arguments at PLAN time. Dropping that would make EXPLAIN of a statement that
# executes nothing perform the write -- which is exactly what was measured for
# fabricator_host_exec's scalar form.
# ⚠ EXPLAIN cannot be a subquery source, so the plan row is matched by regex;
# what the assertion below is really for is the COUNT that follows it.
query II
EXPLAIN SELECT fabricator_render('{{ exec("INSERT INTO ex_aud VALUES (99)") }}', NULL);
----
physical_plan	<REGEX>:.*fabricator_render.*

query I
SELECT count(*) FROM ex_aud;
----
3

# --- a SELECT is refused BY NAME, and the reason is a wrong NUMBER ---
# The managed count is INFERRED from the result's first column when that column
# is an Int64 -- the C++ surface can ask DuckDB for CHANGED_ROWS and this one
# cannot. Refusing sends the author to query() instead of handing them a number
# that looks right.
statement error
SELECT fabricator_render('{{ exec("SELECT 42") }}', NULL);
----
runs WRITES only

# ⚠ THE SHAPE THAT ACTUALLY MISREPORTS, and it is the one a user would write.
# MEASURED with the refusal removed: this renders 99, as though 99 rows had been
# affected. (`SELECT 42` renders 0 -- an INT32 literal fails the Int64 test -- so
# asserting only that one would motivate the refusal with a case that is harmless.)
statement error
SELECT fabricator_render('{{ exec("SELECT count(*) FROM range(99)") }}', NULL);
----
runs WRITES only

# A statement DuckDB cannot parse is reported as such, not run. The classifier
# distinguishes this from a non-SELECT, and conflating them would send the
# author looking in the wrong place.
statement error
SELECT fabricator_render('{{ exec("INSER INTO ex_aud VALUES (1)") }}', NULL);
----
cannot parse

# --- the count rule, pinned as the DISCRIMINATING TRIPLE it is ---
# ⚠⚠ MEASURED, and it CORRECTS what this repo previously recorded: pure DDL is
# 0, but a CTAS reports the rows it CREATED (7), where the SQL-surface
# fabricator_host_exec answers 0 for the same statement. The managed path infers
# the count from the result shape; only C++ can ask DuckDB's CHANGED_ROWS. The
# divergence is asserted here rather than left latent.
query I
SELECT fabricator_render('{{ exec("CREATE TABLE ex_z(a INTEGER)") }}', NULL);
----
0

query I
SELECT fabricator_render('{{ exec("CREATE TABLE ex_c AS SELECT * FROM range(7)") }}', NULL);
----
7

query I
SELECT fabricator_host_exec('CREATE TABLE ex_c3 AS SELECT * FROM range(7)');
----
0

# --- SEVERAL STATEMENTS in one call: what the no-parameter path buys ---
# The parameterised path cannot do this (the host prepares it, and Prepare takes
# one statement), which is why exec has two paths at all. The count is the LAST
# statement's.
query I
SELECT fabricator_render('{{ exec("CREATE TABLE ex_m AS SELECT 1 AS c; INSERT INTO ex_m VALUES (2)") }}', NULL);
----
1

query I
SELECT count(*) FROM ex_m;
----
2

# --- the FILTER form: NAMED parameters bound as VALUES ---
query I
SELECT fabricator_render('deleted={{ "DELETE FROM ex_t WHERE g = $g" | exec: g: "eu" }}', NULL);
----
deleted=2

query I
SELECT count(*) FROM ex_t;
----
1

# ⚠⚠ INJECTION, with its control. The value must arrive as a VALUE, never as SQL
# text: splicing would delete the remaining row. 0 alone would be equally true of
# a build where the parameter never arrived, which is what the pair above pins.
query I
SELECT fabricator_render('{{ "DELETE FROM ex_t WHERE g = $g" | exec: g: "us'' OR 1=1 --" }}', NULL);
----
0

query I
SELECT count(*) FROM ex_t;
----
1

# --- the TWO COUNT PATHS MUST AGREE ---
# ⚠ exec reads its count in two places: IHostQuery.ExecuteNonQuery for the bare
# form, and a local read of Query()'s result for the parameterised one (which
# cannot use ExecuteNonQuery -- it has no parameter overload). A rule written
# twice can drift, so the same statement is put through both.
query II
SELECT fabricator_render('{{ exec("INSERT INTO ex_aud VALUES (9), (9)") }}', NULL) AS no_params,
       fabricator_render('{{ "INSERT INTO ex_aud VALUES ($a), ($a)" | exec: a: 9 }}', NULL) AS with_params;
----
2	2

# --- PER-ROW EVALUATION IS REAL, and nothing prevents it ---
# fabricator_render is a scalar, so three rows perform three writes. Volatility
# keeps it out of PLAN time; it does not make it run once. Pinned because it is
# surprising and because a caller doing DDL needs to know.
statement ok
DELETE FROM ex_aud;

query I
SELECT count(fabricator_render('{{ exec("INSERT INTO ex_aud VALUES (1)") }}', NULL)) FROM range(3);
----
3

query I
SELECT count(*) FROM ex_aud;
----
3

# --- an empty statement is refused BEFORE the classifier ---
# ⚠ Load-bearing ordering: an empty string reports NO error from
# json_serialize_sql (it parses to zero statements), so the classifier alone
# would wave it through.
statement error
SELECT fabricator_render('{{ exec("") }}', NULL);
----
empty statement

# --- both are advertised, and exec resolves as a function AND a filter ---
query I
SELECT fabricator_render('{{ exec("INSERT INTO ex_aud VALUES (5)") }}|{{ "INSERT INTO ex_aud VALUES ($x)" | exec: x: 6 }}', NULL);
----
1|1
