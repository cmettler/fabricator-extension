# name: test/verify_limit_pushdown.test
# description: Verify a bare LIMIT pushes down as SELECT TOP (n) to SQL Server
# group: [fabricator]

require fabricator

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS db (TYPE fabricator);

# A bare LIMIT returns the right number of rows.
query I
SELECT count(*) FROM (SELECT id FROM db.dbo.TestSimplePK LIMIT 2);
----
2

# ...and reached SQL Server as TOP (2).
query I
SELECT pushed FROM fabricator_query('db',
  'SELECT CAST(CASE WHEN EXISTS (
     SELECT 1 FROM sys.dm_exec_query_stats qs
     CROSS APPLY sys.dm_exec_sql_text(qs.sql_handle) st
     WHERE CHARINDEX(''FROM [dbo].[TestSimplePK]'', st.text) > 0
       AND CHARINDEX(''TOP (2)'', st.text) > 0
       AND CHARINDEX(''dm_exec'', st.text) = 0
   ) THEN 1 ELSE 0 END AS INT) AS pushed');
----
1

statement ok
DETACH db;
