# name: test/verify_delta_rs.test
# description: The delta-rs provider (PROVIDER 'deltars') — Delta Lake via the delta-dotnet binding (delta-rs +
#              delta-kernel-rs FFI), an opt-in alternative to the pure-C# engineered-wood provider. v1 scope:
#              read (scan), CREATE/CTAS/INSERT (append), metadata (schemas/tables/columns), time travel
#              (VERSION), snapshots (commit history), re-attach durability. UPDATE/DELETE/ALTER are deferred
#              (delta-rs predicate DML doesn't map to DuckDB's rowid model — see docs/delta-rs-provider.md).
#              Requires the delta-rs native libs published (publish-managed.ps1 -IncludeDeltaRs). Local FS.
# group: [fabricator]

require fabricator

require-env FABRICATOR_DELTA_WRITE_DIR

require-env FABRICATOR_DELTARS

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/dr' AS lake (TYPE fabricator, PROVIDER 'deltars');

# CTAS (v0 = empty CREATE, v1 = the 3 rows).
statement ok
CREATE TABLE lake.main.t AS SELECT * FROM (VALUES (1,'alpha'),(2,'beta'),(3,'gamma')) v(id,name);

query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
1	alpha
2	beta
3	gamma

# Filter + aggregate (DuckDB applies above the scan — superset-correct).
query I
SELECT count(*) FROM lake.main.t WHERE id > 1;
----
2

# INSERT (append; v2).
statement ok
INSERT INTO lake.main.t VALUES (4,'delta');

query I
SELECT count(*) FROM lake.main.t;
----
4

# Time travel — AS OF v1 = the 3 CTAS rows (before the v2 insert). Read via QueryAsync (DataFusion reads the
# loaded snapshot; the kernel-only ReadAsArrowTableAsync can't). delta-rs supports VERSION and TIMESTAMP.
query IT
SELECT id, name FROM lake.main.t AT (VERSION => 1) ORDER BY id;
----
1	alpha
2	beta
3	gamma

# Snapshots / commit history (fabricator_delta_snapshots), oldest first (before the DML commits).
query IT
SELECT version, operation FROM lake.delta.snapshots('main.t') ORDER BY version;
----
0	CREATE TABLE
1	WRITE
2	WRITE

# DELETE — the rowid (all columns) is mapped to a record-batch MERGE matching the scanned rows on every
# column (NULL-safe) WHEN MATCHED THEN DELETE. DuckDB never hands the provider the WHERE, so this is the
# rowid route onto delta-rs's MERGE.
statement ok
DELETE FROM lake.main.t WHERE id = 2;

query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
1	alpha
3	gamma
4	delta

# UPDATE — MERGE matching the pre-image row (all columns) WHEN MATCHED THEN UPDATE SET the changed column.
statement ok
UPDATE lake.main.t SET name = 'GAMMA' WHERE id = 3;

query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
1	alpha
3	GAMMA
4	delta

# UPDATE an expression + DELETE composition.
statement ok
UPDATE lake.main.t SET id = id + 10 WHERE name = 'alpha';

query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
3	GAMMA
4	delta
11	alpha

# Durability: re-attach and re-read the post-DML state.
statement ok
DETACH lake;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/dr' AS lake (TYPE fabricator, PROVIDER 'deltars');

query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
3	GAMMA
4	delta
11	alpha

# The alias 'delta-rs' resolves to the same provider.
statement ok
DETACH lake;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/dr' AS lake2 (TYPE fabricator, PROVIDER 'delta-rs');

query I
SELECT count(*) FROM lake2.main.t;
----
3

statement ok
DETACH lake2;
