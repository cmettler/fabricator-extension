# name: test/verify_mars_dynamic.test
# description: `mssql_mars` is resolved PER CONNECTION, at open time, from the setting session — not once per
#              catalog at its first connect (change B, on top of ABI v69's session-scoped settings).
#
#              ⚠ WHAT THIS REPLACED, and why it was worse than a missing feature. The mode used to be
#              finalized in EnsureProfile and cached for the catalog's life, so a `SET mssql_mars` after the
#              ATTACH was a SILENT no-op — the README had to tell users to set it FIRST, and there was no
#              way to observe that they had failed to (fabricator_server_info's `mars_enabled` row is new,
#              added for exactly this). Worse, a catalog is DATABASE-level: one SqlServerCatalog is shared by
#              every DuckDB connection, so even a correctly-ordered SET applied to all of them. That made the
#              motivating case — configuring ONE dbt model with a pre-hook — impossible twice over.
#
#              ⚠ THE PROFILE IS STILL CACHED, deliberately: `supports_mars` describes the SERVER, so it is
#              detected once. Only the CHOICE moved. Both are asserted together throughout, because
#              `supports_mars` staying true is what shows the difference is the setting rather than the
#              engine.
# group: [fabricator]

require fabricator

require-env MSSQL_TESTDB_DSN

# ═════════════════════════════════════════════════════════════════════════════════════════════════
# §1  A `SET` AFTER THE ATTACH TAKES EFFECT — the silent no-op this change removes.
# ═════════════════════════════════════════════════════════════════════════════════════════════════

statement ok con_a
ATTACH '${MSSQL_TESTDB_DSN}' AS d (TYPE fabricator);

# Force the catalog to CONNECT and cache its profile before the SET, so this cannot pass by the resolution
# merely having been deferred — under the old code the mode was fixed by exactly this statement.
query I con_a
SELECT count(*) FROM fabricator_server_info('d') WHERE property = 'supports_mars';
----
1

query TT con_a
SELECT property, value FROM fabricator_server_info('d')
WHERE property IN ('supports_mars', 'mars_enabled') ORDER BY property;
----
mars_enabled	true
supports_mars	true

statement ok con_a
SET mssql_mars = 'false';

# THE HEADLINE: the already-connected catalog now reports the new mode.
query TT con_a
SELECT property, value FROM fabricator_server_info('d')
WHERE property IN ('supports_mars', 'mars_enabled') ORDER BY property;
----
mars_enabled	false
supports_mars	true

# ═════════════════════════════════════════════════════════════════════════════════════════════════
# §2  TWO SESSIONS, ONE CATALOG, DIFFERENT MODES — impossible before, and the point of the change.
# ═════════════════════════════════════════════════════════════════════════════════════════════════
#
# con_b shares the SAME attached catalog (an ATTACH is database-level, so there is exactly one
# SqlServerCatalog object behind both) and has set nothing, so it must still see the engine default. If the
# mode were still catalog-state, con_a's SET above would have changed this answer too.

query TT con_b
SELECT property, value FROM fabricator_server_info('d')
WHERE property IN ('supports_mars', 'mars_enabled') ORDER BY property;
----
mars_enabled	true
supports_mars	true

# …and back the other way, to show the two are independent rather than con_b merely being "first".
statement ok con_b
SET mssql_mars = 'false';

query T con_b
SELECT value FROM fabricator_server_info('d') WHERE property = 'mars_enabled';
----
false

statement ok con_a
RESET mssql_mars;

# ⚠ RESET at session scope LATCHES "unset" rather than falling back to the global layer (DuckDB's own
# behaviour for extension settings — see verify_setting_scope §6), and unset means `auto`, which is what the
# engine supports. So con_a returns to MARS-on while con_b keeps its own explicit false.
query T con_a
SELECT value FROM fabricator_server_info('d') WHERE property = 'mars_enabled';
----
true

query T con_b
SELECT value FROM fabricator_server_info('d') WHERE property = 'mars_enabled';
----
false

# ═════════════════════════════════════════════════════════════════════════════════════════════════
# §3  THE MODE STILL DRIVES REAL ROUTING, not just the diagnostic row.
# ═════════════════════════════════════════════════════════════════════════════════════════════════
#
# ⚠ Without this the suite would pin a REPORTING string and nothing else — `mars_enabled` could be read
# straight from the setting and every assertion above would still pass while connections kept using the
# cached mode.
#
# ⚠ THIS SECTION USED A DIFFERENT OBSERVABLE UNTIL 2026-08-11, AND THAT ONE IS NOW DEAD. It ran a
# same-catalog self-insert and read 400 vs 200, which worked only because `mssql_materialize` FOLLOWED
# MARS: the MARS-off leg streamed pooled at SNAPSHOT and saw committed state. With materialize back to a
# flat `true` BOTH legs drain and pin, so both answer 400 and the A/B no longer varies with MARS at all.
# §3b below pins that new uniformity rather than deleting the measurement.
#
# The live observable is an ORDINARY read — a plain SELECT, not a scan feeding a write — of a table THIS
# transaction has already written. It is the right one precisely because `materialize` cannot reach it:
# that setting routes MARKED scans only, so this asks about MARS and nothing else.
#   • MARS on  ⇒ the read reuses the transaction's pinned connection ⇒ it succeeds and sees the
#     uncommitted row;
#   • MARS off ⇒ it would have to run pooled, where it would wait forever on locks only this transaction
#     can release, so EnsureScanCannotSelfBlock REFUSES it up front.
# Two sessions, ONE attached catalog, byte-identical statements, differing only in `mssql_mars`. Under the
# old catalog-wide mode these two could not differ at all.
#
# ⚠ The refusal is an ASSERTION OF ABSENCE and is only meaningful beside the success — which is why both
# legs are here rather than just the interesting one.
#
# ⚠ MUTATION-TESTED TWICE, AND THE SECOND RESULT IS A CAVEAT RATHER THAN A CLEAN KILL — say it that way.
# Making the MARS resolver session-blind dies immediately at §1, so it proves nothing about §3. The
# §3-specific mutant is one where `mars_enabled` REPORTING stays correct and only the ROUTING ignores MARS
# (`TxnMars() => true`), which is exactly the hazard this section exists for — and it does NOT produce a
# failure. It HANGS: forcing the routing to believe MARS is available sends the read to a pooled
# connection that waits forever on locks only this transaction can release, which is limitation 1.15's
# unbounded wait and precisely what the refusal prevents. So the section is discriminating, but its
# mutant is a hang, and no assertion here can catch a hang. Do not record it as "mutation-tested, killed".

statement ok con_a
CREATE OR REPLACE TABLE d.dbo.mdyn_ryw AS SELECT i AS a FROM range(10) t(i);

statement ok con_a
BEGIN;

statement ok con_a
INSERT INTO d.dbo.mdyn_ryw VALUES (99);

# con_a: MARS on (nothing set) ⇒ the read joins the transaction and sees its uncommitted row.
query I con_a
SELECT count(*) FROM d.dbo.mdyn_ryw;
----
11

statement ok con_a
COMMIT;

statement ok con_b
SET mssql_mars = 'false';

statement ok con_b
CREATE OR REPLACE TABLE d.dbo.mdyn_ryw_b AS SELECT i AS a FROM range(10) t(i);

statement ok con_b
BEGIN;

statement ok con_b
INSERT INTO d.dbo.mdyn_ryw_b VALUES (99);

# con_b: MARS off ON THE SAME CATALOG ⇒ the identical read is refused rather than deadlocking.
statement error con_b
SELECT count(*) FROM d.dbo.mdyn_ryw_b;
----
mssql_mars is off

statement ok con_b
ROLLBACK;

statement ok con_a
DROP TABLE d.dbo.mdyn_ryw;

statement ok con_b
DROP TABLE d.dbo.mdyn_ryw_b;

# §3b — MARS NO LONGER CHANGES A MARKED SCAN'S ANSWER, and that is the point rather than a gap.
# `materialize` defaults to true on every engine, so a same-catalog self-insert is drained and pinned
# whether or not MARS is available — the bulk deferral is what makes that safe without MARS. Both legs
# therefore see their own uncommitted rows. Asserted on BOTH sessions so a regression that quietly
# restored the MARS-dependent routing would show up as one leg answering 200.

statement ok con_a
CREATE OR REPLACE TABLE d.dbo.mdyn_a_src AS SELECT i AS a, ('v' || i::VARCHAR) AS b FROM range(200) t(i);

statement ok con_a
CREATE OR REPLACE TABLE d.dbo.mdyn_a_dst AS SELECT * FROM d.dbo.mdyn_a_src WHERE 1 = 0;

statement ok con_a
BEGIN;

statement ok con_a
INSERT INTO d.dbo.mdyn_a_dst SELECT * FROM d.dbo.mdyn_a_src;

statement ok con_a
INSERT INTO d.dbo.mdyn_a_dst SELECT * FROM d.dbo.mdyn_a_dst;

statement ok con_a
COMMIT;

# con_a: MARS on (nothing set) ⇒ the self-insert's scan sees this transaction's own uncommitted rows.
query I con_a
SELECT count(*) FROM d.dbo.mdyn_a_dst;
----
400

statement ok con_b
SET mssql_mars = 'false';

statement ok con_b
CREATE OR REPLACE TABLE d.dbo.mdyn_b_src AS SELECT i AS a, ('v' || i::VARCHAR) AS b FROM range(200) t(i);

statement ok con_b
CREATE OR REPLACE TABLE d.dbo.mdyn_b_dst AS SELECT * FROM d.dbo.mdyn_b_src WHERE 1 = 0;

statement ok con_b
BEGIN;

statement ok con_b
INSERT INTO d.dbo.mdyn_b_dst SELECT * FROM d.dbo.mdyn_b_src;

statement ok con_b
INSERT INTO d.dbo.mdyn_b_dst SELECT * FROM d.dbo.mdyn_b_dst;

statement ok con_b
COMMIT;

# con_b: MARS off ON THE SAME CATALOG ⇒ the SAME 400. It read 200 until 2026-08-11, when `materialize`
# followed MARS and this scan therefore streamed from a committed snapshot.
query I con_b
SELECT count(*) FROM d.dbo.mdyn_b_dst;
----
400

statement ok con_a
DROP TABLE d.dbo.mdyn_a_dst;

statement ok con_a
DROP TABLE d.dbo.mdyn_a_src;

statement ok con_b
DROP TABLE d.dbo.mdyn_b_dst;

statement ok con_b
DROP TABLE d.dbo.mdyn_b_src;

statement ok con_b
RESET mssql_mars;

# ═════════════════════════════════════════════════════════════════════════════════════════════════
# §4  AN INVALID VALUE IS STILL REFUSED — and now at the STATEMENT that uses it.
# ═════════════════════════════════════════════════════════════════════════════════════════════════
#
# The value is validated where it is resolved, which used to be the catalog's first connect. Resolving per
# connection moves the error to the first statement that opens one; it must still be refused, not silently
# treated as `auto`.

statement ok con_a
SET mssql_mars = 'bogus';

statement error con_a
SELECT value FROM fabricator_server_info('d') WHERE property = 'mars_enabled';
----
invalid mssql_mars

statement ok con_a
RESET mssql_mars;

query T con_a
SELECT value FROM fabricator_server_info('d') WHERE property = 'mars_enabled';
----
true
