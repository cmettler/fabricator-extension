# name: test/verify_dax.test
# description: DAX / Analysis Services provider (slices 1-3) — ATTACH a live semantic model, scan +
#              projection + filter pushdown. A live model is not a portable fixture (it's a running
#              Power BI Desktop / SSAS / Fabric instance), so this is gated by require-env and asserts
#              MODEL-AGNOSTIC invariants (no hardcoded counts) — it passes against ANY tabular model you
#              point it at. Set:
#                FABRICATOR_DAX_DSN   e.g. 'pbidesktop://' (local PBI Desktop autodetect) or
#                                   'Data Source=localhost:<port>' / a Fabric/SSAS XMLA connstr
#                FABRICATOR_DAX_TABLE  a fully-qualified, quoted table reference, e.g. pbi."Model"."Customer"
#                FABRICATOR_DAX_COL    a quoted column of that table that has some NULLs, e.g. "Country"
#                FABRICATOR_DAX_SCHEMA the catalog.schema prefix the model lives under, e.g. pbi."Model"
#                                    (daxeval registers under the model schema, whose name varies)
# group: [fabricator]

require fabricator

require-env FABRICATOR_DAX_DSN

require-env FABRICATOR_DAX_TABLE

require-env FABRICATOR_DAX_COL

require-env FABRICATOR_DAX_SCHEMA

statement ok
ATTACH '${FABRICATOR_DAX_DSN}' AS pbi (TYPE fabricator, PROVIDER 'dax');

# A model table is reachable and non-empty (EVALUATE scan streams rows).
query I
SELECT count(*) > 0 FROM ${FABRICATOR_DAX_TABLE};
----
true

# Projection preserves the row count (the SELECTCOLUMNS scan path).
query I
SELECT (SELECT count(*) FROM ${FABRICATOR_DAX_TABLE})
     = (SELECT count(*) FROM (SELECT ${FABRICATOR_DAX_COL} FROM ${FABRICATOR_DAX_TABLE}) s);
----
true

# Filter pushdown is superset-safe / complete: IS NULL + IS NOT NULL partition all rows. This pushes
# FILTER('T', ISBLANK(c)) and FILTER('T', NOT(ISBLANK(c))); DuckDB re-applies, so the only way the two
# parts sum to the total is if the pushed FILTER drops/duplicates nothing.
query I
SELECT (SELECT count(*) FROM ${FABRICATOR_DAX_TABLE})
     = (SELECT count(*) FROM ${FABRICATOR_DAX_TABLE} WHERE ${FABRICATOR_DAX_COL} IS NULL)
     + (SELECT count(*) FROM ${FABRICATOR_DAX_TABLE} WHERE ${FABRICATOR_DAX_COL} IS NOT NULL);
----
true

# IS NOT NULL pushdown returns exactly the non-null rows (must equal count(col), which ignores NULLs).
query I
SELECT (SELECT count(*) FROM ${FABRICATOR_DAX_TABLE} WHERE ${FABRICATOR_DAX_COL} IS NOT NULL)
     = (SELECT count(${FABRICATOR_DAX_COL}) FROM ${FABRICATOR_DAX_TABLE});
----
true

# A contradictory predicate returns no rows.
query I
SELECT count(*) FROM ${FABRICATOR_DAX_TABLE}
WHERE ${FABRICATOR_DAX_COL} IS NULL AND ${FABRICATOR_DAX_COL} IS NOT NULL;
----
0

# The "system" schema exposes curated $SYSTEM DMVs as tables (bare SELECT * FROM $SYSTEM.<dmv>; no pushdown).
# These DMV names exist in every tabular model, so these assertions are model-agnostic.
query I
SELECT count(*) > 0 FROM pbi.system."TMSCHEMA_TABLES";
----
true

# A wider DMV scans without error (exercises the multi-batch DMV streaming path).
query I
SELECT count(*) >= 0 FROM pbi.system."DBSCHEMA_COLUMNS";
----
true

# daxeval(expression := …): evaluate an arbitrary DAX query as a table function. Output schema is resolved
# at bind (the DAX result's columns). Args are NAMED (daxeval registers as a 'proc'), so `expression :=`.
# These DAX expressions reference no model data, so they're model-agnostic.
query I
SELECT n FROM ${FABRICATOR_DAX_SCHEMA}.daxeval(expression := 'EVALUATE ROW("n", 42)');
----
42

# Multi-row result via a DAX table constructor (3 rows).
query I
SELECT count(*) FROM ${FABRICATOR_DAX_SCHEMA}.daxeval(expression := 'EVALUATE {1, 2, 3}');
----
3

# Parameter binding: daxeval(expression, params := '{json}') binds each JSON entry as an ADOMD @parameter
# the DAX references as @<name> (40 + 2 = 42). Mixed-type params + the no-param call both stay model-agnostic.
query I
SELECT result::BIGINT FROM ${FABRICATOR_DAX_SCHEMA}.daxeval(
  expression := 'EVALUATE ROW("result", @a + @b)', params := '{"a": 40, "b": 2}');
----
42

# A string parameter flows through (DAX string concat).
query I
SELECT greeting FROM ${FABRICATOR_DAX_SCHEMA}.daxeval(
  expression := 'EVALUATE ROW("greeting", @who)', params := '{"who": "world"}');
----
world

# params also accepts a DuckDB STRUCT (type-safe, no JSON quoting): {'a': 40, 'b': 2} -> @a, @b.
query I
SELECT result::BIGINT FROM ${FABRICATOR_DAX_SCHEMA}.daxeval(
  expression := 'EVALUATE ROW("result", @a + @b)', params := {'a': 40, 'b': 2});
----
42

# A STRUCT string field.
query I
SELECT greeting FROM ${FABRICATOR_DAX_SCHEMA}.daxeval(
  expression := 'EVALUATE ROW("greeting", @who)', params := {'who': 'world'});
----
world

# daxevaltable(<input>, expression := …): inject a DuckDB-side table into DAX as _input and evaluate once.
# Model-agnostic (the injected table is a VALUES list; the DAX references only _input).
query II
SELECT id, name FROM ${FABRICATOR_DAX_SCHEMA}.daxevaltable(
  (SELECT * FROM (VALUES (1, 'a'), (2, 'b')) v(id, name)), expression := 'EVALUATE _input') ORDER BY id;
----
1	a
2	b

# A whole-table DAX computation over the injected table (10+20+30 = 60).
query I
SELECT total FROM ${FABRICATOR_DAX_SCHEMA}.daxevaltable(
  (SELECT * FROM (VALUES (10), (20), (30)) v(x)), expression := 'EVALUATE ROW("total", SUMX(_input, _input[x]))');
----
60

# daxevaltable is a COLLECTOR (pipeline breaker), so the injected input may span MANY chunks — the earlier
# streaming form capped it at a single 2048-row batch. 5000 rows: sum(0..4999) = 12497500 (whole-table SUMX).
query I
SELECT total FROM ${FABRICATOR_DAX_SCHEMA}.daxevaltable(
  (SELECT i::INTEGER AS x FROM range(5000) t(i)), expression := 'EVALUATE ROW("total", SUMX(_input, _input[x]))');
----
12497500

# The whole 5000-row input is echoed back (every row collected before evaluation).
query I
SELECT count(*) FROM ${FABRICATOR_DAX_SCHEMA}.daxevaltable(
  (SELECT i::INTEGER AS x FROM range(5000) t(i)), expression := 'EVALUATE _input');
----
5000

# daxeach(<input>, expression := …): run the DAX once per input row, binding each input column as @<col>.
# Output = the DAX result per row. Model-agnostic (VALUES + @params; no model data).
query II
SELECT n, sq FROM ${FABRICATOR_DAX_SCHEMA}.daxeach(
  (SELECT * FROM (VALUES (3), (4), (5)) v(n)), expression := 'EVALUATE ROW("n", @n, "sq", @n * @n)') ORDER BY n;
----
3	9
4	16
5	25

# A row may yield multiple result rows (2 input rows x 3 = 6) — per-row, unbounded-input streaming.
query I
SELECT count(*) FROM ${FABRICATOR_DAX_SCHEMA}.daxeach(
  (SELECT * FROM (VALUES (1), (2)) v(k)), expression := 'EVALUATE { @k, @k + 10, @k + 20 }');
----
6

# ═══ Raw DAX through fabricator_query, and the SHARED parameter bag (ABI v88) ═════════════════════════
# ✅ VERIFIED against a live Power BI Desktop model 2026-09-06. These rows were AUTHORED BLIND (no model was
# available at the time) and every one of them held — including the 2^53+1 row, which is the whole point of
# unifying the decoder.
# fabricator_query used to answer a DAX catalog with "raw query not supported yet (slice 1)". It runs the
# statement now, so the generic function means the same thing on every provider.
#
# ⚠ There is NO describe on this provider (ADOMD cannot report a shape without evaluating), so the host's
# DescribedArrowStream executes to learn the schema and keeps that stream for the rows — ONE execution, the
# documented fallback. daxeval remains the richer surface: it resolves its schema at BIND, so DuckDB can plan
# around it.

query I
SELECT n FROM fabricator_query('pbi', 'EVALUATE ROW("n", 42)');
----
42

# The bag is the SAME one fabricator_query takes everywhere; each key becomes an ADOMD @parameter.
query I
SELECT result::BIGINT FROM fabricator_query('pbi', 'EVALUATE ROW("result", @a + @b)', params := {'a': 40, 'b': 2});
----
42

query I
SELECT result::BIGINT FROM fabricator_query('pbi', 'EVALUATE ROW("result", @a + @b)', params := '{"a": 40, "b": 2}');
----
42

# ⚠⚠ THE ROW THIS SLICE EXISTS FOR. daxeval's bag used to decode JSON numbers with
# `e.TryGetInt64(out var l) ? l : e.GetDouble()`, whose branches C# unifies to DOUBLE — so every JSON integer
# went through a double and lost exactness above 2^53. MEASURED on the pattern in isolation: 9007199254740993
# arrived as a Double valued …992. It is the same defect this repo shipped once in JsonToClr, and it is
# invisible for every integer a test happens to use.
#
# Both surfaces now decode through the host's ProviderParameters, so the ladder exists ONCE — which is also
# how this bag acquired a gate it could never have on its own: verify_dax needs Power BI Desktop and is
# manual, while the shared rule is pinned by verify_raw_query §9 on the service tier.

query I
SELECT n::BIGINT FROM ${FABRICATOR_DAX_SCHEMA}.daxeval(
  expression := 'EVALUATE ROW("n", @n)', params := '{"n": 9007199254740993}');
----
9007199254740993

query I
SELECT n::BIGINT FROM fabricator_query('pbi', 'EVALUATE ROW("n", @n)', params := '{"n": 9007199254740993}');
----
9007199254740993

# ⚠ THREE REFUSALS INHERITED FROM THE SHARED DECODER, all replacing behaviour that was worse. A nested JSON
# value used to be passed as its RAW JSON TEXT — a value the caller never wrote, arriving as a
# plausible-looking string; a duplicate name used to be collapsed silently; and a MAP died inside
# ArrowValueReader as "unsupported filter value type Map", naming a subsystem the caller never touched.

statement error
SELECT n FROM ${FABRICATOR_DAX_SCHEMA}.daxeval(
  expression := 'EVALUATE ROW("n", @a)', params := '{"a": {"b": 1}}');
----
is a JSON object; a parameter must be a scalar

statement error
SELECT n FROM ${FABRICATOR_DAX_SCHEMA}.daxeval(
  expression := 'EVALUATE ROW("n", @a)', params := '{"a": 1, "A": 2}');
----
declares 'A' more than once

statement error
SELECT n FROM ${FABRICATOR_DAX_SCHEMA}.daxeval(
  expression := 'EVALUATE ROW("n", @a)', params := MAP{'a': 1});
----
'params' is a map; it must be a DuckDB STRUCT

# ⚠ A WRITE names the right reason. The contract's default would say "does not support statement parameters",
# which blames the bag; this provider is READ-ONLY, and that is what a caller needs to hear.
statement error
SELECT fabricator_exec('pbi', 'EVALUATE ROW("n", 1)', {'a': 1});
----
dax provider is read-only

# ═══ STRUCT vs JSON: the bag's type fidelity, MEASURED where it is visible in the RESULT ══════════════
# ⚠⚠ The two bag spellings are NOT equally faithful, and on DAX the difference SHOWS IN THE OUTPUT TYPE
# rather than only in what was sent: a STRUCT's fields keep their DuckDB type all the way to the ADOMD
# parameter, while JSON has four scalar kinds and can only carry BIGINT / DOUBLE / VARCHAR / BOOLEAN.
#
# This is the reason the docs say to PREFER THE STRUCT FORM, and it is asserted here rather than described
# because it is the one place the cost of the JSON path is directly observable.
#
# ⚠ Model-agnostic: no model data is referenced, only DAX's own type system.

query T
SELECT typeof(v) FROM ${FABRICATOR_DAX_SCHEMA}.daxeval(
  expression := 'EVALUATE ROW("v", @d)', params := {'d': 19.99::DECIMAL(9,2)});
----
DECIMAL(19,4)

# …the SAME digits through JSON arrive as a floating value. DAX's Currency type is what a real DECIMAL
# parameter reaches; a JSON number cannot.
query T
SELECT typeof(v) FROM ${FABRICATOR_DAX_SCHEMA}.daxeval(
  expression := 'EVALUATE ROW("v", @d)', params := '{"d": 19.99}');
----
DOUBLE

# A typed temporal survives the STRUCT path as a DAX DateTime. JSON has no date kind at all, so there is no
# JSON spelling of this row — which is the point.
query T
SELECT typeof(v) FROM ${FABRICATOR_DAX_SCHEMA}.daxeval(
  expression := 'EVALUATE ROW("v", @t)', params := {'t': DATE '2024-03-05'});
----
TIMESTAMP_MS

query I
SELECT v FROM ${FABRICATOR_DAX_SCHEMA}.daxeval(
  expression := 'EVALUATE ROW("v", @t)', params := {'t': DATE '2024-03-05'});
----
2024-03-05 00:00:00

# A boolean reaches DAX as one (IF() accepts it without a cast).
query I
SELECT v FROM ${FABRICATOR_DAX_SCHEMA}.daxeval(
  expression := 'EVALUATE ROW("v", IF(@b, 1, 0))', params := {'b': true});
----
1

# ⚠ fabricator_query reaches the $SYSTEM DMVs as well as DAX — the provider's ExecuteQuery hands the text
# straight to the same StreamCommand the model scans use, so a DMV SELECT and an EVALUATE are one path.
query I
SELECT count(*) > 0 FROM fabricator_query('pbi', 'SELECT [Name] FROM $SYSTEM.TMSCHEMA_TABLES');
----
true

# ═══ Full ENUMERATION, and the two regressions a live model was needed to find (2026-09-06) ══════════
# ⚠⚠ BOTH were invisible to CI because this tier is MANUAL, and both broke everything EXCEPT targeted access
# — the same shape as the SQL Server discovery defect this project already recorded.

# (1) THE {TABLE} INPUT MUST BE DECLARED. Under the unified parameter protocol a field's STYLE rides in its
# Arrow metadata and an unflagged field is POSITIONAL, so daxevaltable/daxeach — which returned a bare
# `expression` VARCHAR and were never migrated — registered as `f(VARCHAR)`: no {TABLE} parameter at all.
# DuckDB then bound the input RELATION as a scalar subquery ("Subquery returns 2 columns - expected 1").
#
# ⚠ Omitting the style does not FAIL, it registers a DIFFERENT FUNCTION — which is why the signature is
# pinned here rather than only the behaviour above.
# ⚠ daxeval is the control: it is kind 'proc', whose arguments the host makes named by construction, so it
# needs no styles and must keep reporting two NAMED parameters.

query TTT
SELECT function_name, parameters, parameter_types
FROM duckdb_functions()
WHERE function_name IN ('daxeval', 'daxevaltable', 'daxeach')
ORDER BY function_name;
----
daxeach	[col0, expression]	[TABLE, VARCHAR]
daxeval	[expression, params]	[VARCHAR, ANY]
daxevaltable	[col0, expression]	[TABLE, VARCHAR]

# (2) ONE MISSING DMV BROKE FULL ENUMERATION. The curated $SYSTEM list is what we know how to surface, not
# what every server HAS — and a listed-but-absent DMV is materialized during enumeration, whose schema fetch
# then throws. MEASURED on Power BI Desktop: `TMSCHEMA_PARTITION_SOURCES` is the one of eighteen it does not
# recognise, and duckdb_tables() / duckdb_columns() / information_schema.tables ALL failed with "The
# 'TMSCHEMA_PARTITION_SOURCES' request type was not recognized by the server" while targeted access worked.
#
# The list is now narrowed by DISCOVER_SCHEMA_ROWSETS — the SERVER's own answer, one round trip per catalog.
#
# ⚠ MODEL-AGNOSTIC by construction: which DMVs a given server declares varies, so what is asserted is that
# enumeration SUCCEEDS and that every system table it lists can be described. Before the fix the first of
# these queries did not return a number at all — it threw.

query I
SELECT count(*) > 0 FROM duckdb_tables() WHERE database_name = 'pbi' AND schema_name = 'system';
----
true

# ⚠ THE DISCRIMINATING ROW: duckdb_columns() MATERIALIZES every listed table, so a system table the server
# cannot describe fails here. Equal counts mean the enumeration lists exactly the tables it can describe.
query I
SELECT (SELECT count(DISTINCT table_name) FROM duckdb_columns() WHERE database_name = 'pbi' AND schema_name = 'system')
     = (SELECT count(*) FROM duckdb_tables() WHERE database_name = 'pbi' AND schema_name = 'system');
----
true

# …and the whole catalog enumerates, which is what dbt and every BI tool do before they read anything.
query I
SELECT count(*) = (SELECT count(*) FROM duckdb_tables() WHERE database_name = 'pbi')
FROM information_schema.tables WHERE table_catalog = 'pbi';
----
true

# ⚠ A DMV the server does not declare is ABSENT from enumeration rather than present-and-broken. Asserted as
# a SUBSET rather than by naming one: every system table listed must be one we curate, and on a server that
# has them all nothing is dropped. (Naming TMSCHEMA_PARTITION_SOURCES would pin THIS server's gap.)
query I
SELECT count(*) FROM duckdb_tables()
WHERE database_name = 'pbi' AND schema_name = 'system'
  AND table_name NOT IN (
    'TMSCHEMA_MODEL','TMSCHEMA_TABLES','TMSCHEMA_COLUMNS','TMSCHEMA_MEASURES','TMSCHEMA_RELATIONSHIPS',
    'TMSCHEMA_PARTITIONS','TMSCHEMA_HIERARCHIES','TMSCHEMA_EXPRESSIONS','TMSCHEMA_DATA_SOURCES',
    'TMSCHEMA_PARTITION_SOURCES','DBSCHEMA_CATALOGS','DBSCHEMA_TABLES','DBSCHEMA_COLUMNS',
    'DISCOVER_STORAGE_TABLES','DISCOVER_STORAGE_TABLE_COLUMNS','DISCOVER_STORAGE_TABLE_COLUMN_SEGMENTS',
    'DISCOVER_CALC_DEPENDENCY','DISCOVER_OBJECT_MEMORY_USAGE');
----
0

statement ok
DETACH pbi;
