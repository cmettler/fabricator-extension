# name: test/verify_generic_names.test
# description: Provider-agnostic name aliases — arrownet_query/_exec + ATTACH (TYPE arrownet) work alongside
#              the legacy mssql_net_* names (additive; the breaking removal of mssql_net_* is separate).
# group: [mssql_net]

require mssql_net

require-env MSSQL_TESTDB_DSN

# ATTACH with the generic TYPE keyword (aliases TYPE mssql_net).
statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS gdb (TYPE arrownet);

# Generic raw-query alias.
query I
SELECT x FROM arrownet_query('gdb', 'SELECT 42 AS x');
----
42

# Generic exec alias (returns affected rows; >= 0).
query I
SELECT arrownet_exec('gdb', 'SELECT 1') >= 0;
----
true

# Legacy names still resolve (additive — no breakage).
query I
SELECT y FROM mssql_net_query('gdb', 'SELECT 7 AS y');
----
7

statement ok
DETACH gdb;
