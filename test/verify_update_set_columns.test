# name: test/verify_update_set_columns.test
# description: An UPDATE must hand the provider the columns it ASSIGNS — not the whole row. DuckDB's base
#              TableCatalogEntry::BindUpdateConstraints turns an update that assigns a LIST / ARRAY / MAP /
#              UNION / VARIANT / GEOMETRY column (or a STRUCT containing one) into a delete+insert and
#              therefore projects EVERY physical column; that rule is about DuckDB's own row-group storage
#              and is meaningless for a remote table updated by column NAME. FabricatorTableEntry overrides
#              the method, keeping every other base rule. Set FABRICATOR_DELTA_WRITE_DIR. Local FS.
# group: [fabricator]

require fabricator

# The Delta catalog's default engine is native_write, so DuckDB's own COPY writes the data files.
require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/setcols' AS w (TYPE fabricator, PROVIDER 'delta', column_mapping 'none');

# Every type that trips the base rule has a column here, plus scalars to be expanded INTO — the expansion
# is invisible on a one-column table, so the width is load-bearing.
statement ok
CREATE OR REPLACE TABLE w.main.t AS
SELECT i AS id, 'n' || i AS label, ['a', 'b'] AS tags, MAP{'k': i} AS m,
       {'a': i, 'b': 'x'} AS st, {'a': i, 'l': ['p']} AS stl, i * 2 AS extra, 'z' AS pad
FROM range(3) r(i);

# ==============================================================================================
# HOW THESE ASSERTIONS WORK — read this before adding one.
# ==============================================================================================
# ⚠⚠ THE SET-COLUMN COUNT IS NOT OBSERVABLE FROM SQL. It crosses the ABI as `execute_update`'s setCount
# and changes no ANSWER: the expanded columns are assigned their OWN values, so the row ends up identical.
# What the expansion DOES change is the PLAN, and the scan's own `Projections` is the cleanest handle on
# it — an expanded UPDATE has to read every column it is about to write back, so the scan widens with it.
#
# ⚠ EXPLAIN cannot be a subquery source (nor a COPY source), hence the <REGEX>: form on the physical_plan
# row. `(FORMAT json)` is used rather than the ASCII tree because the JSON renders the projection as ONE
# exact string — `"Projections": "id"` cannot match `"Projections": "id label tags …"`, where the ASCII
# box would need a regex over column padding.
#
# ⚠ §2's second row asserts the PROJECTION's own expressions instead, from the ASCII tree, because that is
# the thing being fixed rather than a consequence of it. `[^#]*` is what discriminates: an expanded plan
# puts `#1 #2 #3 …` bound references between the assigned value and the rowid.

# ==============================================================================================
# §1  BASELINE — a scalar SET was never expanded. This is the shape every section below must match.
# ==============================================================================================

query II
EXPLAIN (FORMAT json) UPDATE w.main.t SET label = 'X' WHERE id = 1;
----
physical_plan	<REGEX>:.*"Projections": "id".*

# ==============================================================================================
# §2  LIST — the case the override exists for
# ==============================================================================================

query II
EXPLAIN (FORMAT json) UPDATE w.main.t SET tags = ['q'] WHERE id = 1;
----
physical_plan	<REGEX>:.*"Projections": "id".*

# The SET expressions themselves: the assigned value, then the rowid, with nothing in between.
query II
EXPLAIN UPDATE w.main.t SET tags = ['q'] WHERE id = 1;
----
physical_plan	<REGEX>:.*PROJECTION.*\['q'\][^#]*rowid.*

# ==============================================================================================
# §3  THE OTHER TRIGGERING TYPES — MAP, and a STRUCT that CONTAINS a list
# ==============================================================================================
# ⚠ These are not padding. `SupportsRegularUpdate()` is false for six type ids and recurses into STRUCT
# children, so a build that special-cased LIST alone would pass §2 and fail here.

query II
EXPLAIN (FORMAT json) UPDATE w.main.t SET m = MAP{'z': 9} WHERE id = 1;
----
physical_plan	<REGEX>:.*"Projections": "id".*

query II
EXPLAIN (FORMAT json) UPDATE w.main.t SET stl = {'a': 9, 'l': ['z']} WHERE id = 1;
----
physical_plan	<REGEX>:.*"Projections": "id".*

# ==============================================================================================
# §4  WHERE THE LINE FALLS — a STRUCT of SCALARS never triggered it
# ==============================================================================================
# ⚠ A CHARACTERIZATION of DuckDB's rule, not of ours: `SupportsRegularUpdate()` returns TRUE for a struct
# whose children all support it, so this row reads the same before and after the override. It is here so
# that the sections above cannot be mistaken for "nested types are special to us" — the split is the
# base's, and this is the half we never had to touch.

query II
EXPLAIN (FORMAT json) UPDATE w.main.t SET st = {'a': 9, 'b': 'y'} WHERE id = 1;
----
physical_plan	<REGEX>:.*"Projections": "id".*

# ==============================================================================================
# §5  MERGE — the same binding, and it has to be asserted separately
# ==============================================================================================
# ⚠ `WHEN MATCHED THEN UPDATE` is lowered to the same LogicalUpdate and reads its SET values through the
# same FabricatorFillUpdateSetColumns, so it goes through this override too — but MERGE shares ONE
# projection across its actions, so a change to how many columns get bound lands here differently than in
# a plain UPDATE. ⚠ Two scans in this plan (target and source); the target's is the one asserted.

query II
EXPLAIN (FORMAT json) MERGE INTO w.main.t USING (SELECT 1 AS k) s ON t.id = s.k
  WHEN MATCHED THEN UPDATE SET tags = ['m'];
----
physical_plan	<REGEX>:.*"Projections": "id".*

# ==============================================================================================
# §6  BEHAVIOUR PRESERVATION — the override drops a branch, so what it must NOT change is the answer
# ==============================================================================================

statement ok
UPDATE w.main.t SET label = 'X', extra = 99 WHERE id = 1;

query ITI
SELECT id, label, extra FROM w.main.t ORDER BY id;
----
0	n0	0
1	X	99
2	n2	4

# A struct SET still lands correctly (the §4 path, which the override leaves alone).
statement ok
UPDATE w.main.t SET st = {'a': 9, 'b': 'y'} WHERE id = 2;

query IT
SELECT id, st.b FROM w.main.t WHERE id = 2;
----
2	y

# ==============================================================================================
# §7  A NESTED SET VALUE IS WRITTEN, ON BOTH UPDATE PATHS
# ==============================================================================================
# ⚠⚠ THIS SECTION REPLACES ONE THAT ASSERTED THE REFUSAL, and falsifying it is the change announcing
# itself. Until 2026-09-15 `UPDATE … SET <a list>` died with "unsupported filter value type List" — a
# message naming a FILTER although it was the SET value — because both UPDATE paths round-tripped every SET
# value through CLR boxes and neither ladder had a list case. They now hand a matching Arrow array through.
#
# ⚠⚠ BOTH PATHS ARE ASSERTED AND THAT IS NOT PADDING. Autocommit rebuilds the SET column; an explicit
# transaction goes through BufferUpdateRows, which MERGES the new values with the untouched rows row by row
# — a different mechanism (concatenate + take, versus a straight passthrough). Fixing one and not the other
# would make the same statement work outside a transaction and fail inside one, which this repo records as
# harder to notice than a feature that never works at all.

statement ok
UPDATE w.main.t SET tags = ['q', 'r'] WHERE id = 0;

statement ok
UPDATE w.main.t SET m = MAP{'z': 9} WHERE id = 0;

# A STRUCT containing a list — the recursive case, which also exercises the nullability walk below.
statement ok
UPDATE w.main.t SET stl = {'a': 9, 'l': ['z']} WHERE id = 0;

# The buffered path.
statement ok
BEGIN;

statement ok
UPDATE w.main.t SET tags = ['x', 'y', 'z'] WHERE id = 2;

statement ok
COMMIT;

# ⚠ The UNTOUCHED rows and columns are the control: the buffered merge picks per row between the new value
# and the existing one, so a broken index would corrupt exactly these rather than the updated cells.
query ITTT
SELECT id, tags::VARCHAR, m::VARCHAR, stl::VARCHAR FROM w.main.t ORDER BY id;
----
0	[q, r]	{z=9}	{'a': 9, 'l': [z]}
1	[a, b]	{k=1}	{'a': 1, 'l': [p]}
2	[x, y, z]	{k=2}	{'a': 2, 'l': [p]}

# ==============================================================================================
# §8  NOT NULL IS STILL ENFORCED — the control for the nullability path this touched
# ==============================================================================================
# ⚠⚠ THE FIX CHANGED HOW THAT CHECK READS ITS VALUE. It used to box every SET value to hand it to
# DeltaNullability; it now boxes only for a STRUCT (the one shape whose CONTENTS are inspected) and asks the
# Arrow array directly otherwise. So the check is on a new code path for every scalar column, and this is
# what proves it still fires — a silently-dropped NOT NULL would be a wrong answer, not an error.

statement ok
CREATE OR REPLACE TABLE w.main.nn (id BIGINT, req VARCHAR NOT NULL);

statement ok
INSERT INTO w.main.nn VALUES (1, 'a');

statement error
UPDATE w.main.nn SET req = NULL WHERE id = 1;
----
NOT NULL

# …and a legitimate value still lands, so the row above is the constraint firing rather than UPDATE failing.
statement ok
UPDATE w.main.nn SET req = 'b' WHERE id = 1;

query IT
SELECT id, req FROM w.main.nn;
----
1	b
