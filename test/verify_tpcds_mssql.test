# name: test/verify_tpcds_mssql.test
# description: TPCDS at SF 0.01 with its tables split between local DuckDB and SQL Server in
#              several placements (all remote, the facts remote, the dimensions remote, a fixed random split);
#              every query must return what the all-local run returns. GENERATED by scripts/gen_tpc_suites.py
#              — edit that, not this file. The expected results are the local answers (rowsort; numeric
#              values compare approximately).
# group: [fabricator]

require fabricator

require tpcds

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS rp (TYPE fabricator, remote_pushdown 'true');

statement ok
CREATE SCHEMA memory.tpcds

statement ok
CALL dsdgen(sf = 0.01, catalog = 'memory', schema = 'tpcds');

statement ok
SELECT fabricator_exec('rp', 'IF SCHEMA_ID(''tpcds_t'') IS NULL EXEC(''CREATE SCHEMA tpcds_t'')', refresh_cache := true);

