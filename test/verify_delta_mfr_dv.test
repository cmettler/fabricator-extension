# name: test/verify_delta_mfr_dv.test
# description: fabricator_delta_mfr_scan over a DELETION-VECTOR Delta table (multifile-delta Phase A slice 1b).
#              engineered-wood resolves each file's DV to the deleted row positions (delta_list_files JSON "dv"),
#              and the C++ FabricatorDeltaMultiFileReader attaches a per-file DeleteFilter so DuckDB's native read
#              EXCLUDES the deleted rows — matching the C# reader. Creates a `deletion_vectors true` catalog,
#              deletes rows, then reads the table folder via the MultiFileReader. Set FABRICATOR_DELTA_WRITE_DIR
#              (writable). Local FS.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/mfrdv' AS lake (TYPE fabricator, PROVIDER 'delta', column_mapping 'none', deletion_vectors true);

statement ok
CREATE TABLE lake.main.t AS SELECT i AS id, 'v' || i AS name FROM range(1, 8) AS r(i);

statement ok
DELETE FROM lake.main.t WHERE id IN (2, 4, 6);

# The C# reader honors the DV (baseline).
query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
1	v1
3	v3
5	v5
7	v7

# The native MultiFileReader scan must ALSO exclude the DV-deleted rows (a column scan applies the DeleteFilter).
query IT
SELECT id, name FROM fabricator_delta_mfr_scan('${FABRICATOR_DELTA_WRITE_DIR}/mfrdv/t') ORDER BY id;
----
1	v1
3	v3
5	v5
7	v7

# Aggregates over a scanned column reflect the DV (deleted rows excluded).
query II
SELECT count(id), sum(id) FROM fabricator_delta_mfr_scan('${FABRICATOR_DELTA_WRITE_DIR}/mfrdv/t');
----
4	16

# A predicate scan also excludes deleted rows.
query I
SELECT count(id) FROM fabricator_delta_mfr_scan('${FABRICATOR_DELTA_WRITE_DIR}/mfrdv/t') WHERE id < 5;
----
2

# NOTE: a BARE count(*) (empty projection) uses DuckDB's parquet row-group metadata path and does NOT apply the
# DeleteFilter, so it OVER-COUNTS on a DV table (reports the physical row count). Use count(<col>) or any column
# scan for a DV-correct count. (A later slice can disable that metadata-count optimization for the delta reader.)
query I
SELECT count(*) FROM fabricator_delta_mfr_scan('${FABRICATOR_DELTA_WRITE_DIR}/mfrdv/t');
----
7
