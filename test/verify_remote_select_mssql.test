# IGNORE NULLS with offset 1 and no default agrees with DuckDB (SQL Server 2022+)
query I
SELECT count(*) FROM (
  (SELECT uid, lag(w IGNORE NULLS) OVER (ORDER BY uid) AS l, lead(w IGNORE NULLS) OVER (PARTITION BY uid % 2 ORDER BY uid) AS ld,
          first_value(w IGNORE NULLS) OVER (ORDER BY uid DESC) AS f FROM rp.dbo.rs_u ORDER BY uid LIMIT 100)
  EXCEPT ALL
  (SELECT uid, lag(w IGNORE NULLS) OVER (ORDER BY uid), lead(w IGNORE NULLS) OVER (PARTITION BY uid % 2 ORDER BY uid),
          first_value(w IGNORE NULLS) OVER (ORDER BY uid DESC) FROM db.dbo.rs_u));
----
0

# ═══ §14  Functions SQL Server computes differently — measured, so they run locally ═════════════════════
# Each was a WRONG ANSWER before it was declined (docs/duckdb-2.0-remote-execution.md §3.12). The rows below pin
# the routing; the answer is then DuckDB's own.

statement ok
SELECT fabricator_exec('db', 'DROP TABLE IF EXISTS dbo.rs_x;');

statement ok
SELECT fabricator_exec('db', 'CREATE TABLE dbo.rs_x (id INT, n NVARCHAR(40) NULL, vb VARBINARY(8) NULL);
INSERT INTO dbo.rs_x VALUES (1, N''abc'', 0x01), (2, N''𝄞x𝄞'', 0x0100), (3, N''é'' + NCHAR(769), 0x02), (4, N''aAaA'', NULL);');

statement ok
SELECT fabricator_refresh_cache('rp');

statement ok
SELECT fabricator_refresh_cache('db');

# lower / upper are PUSHED — the one accepted divergence (298 / 308 rare BMP code points map differently; ß, µ,
# Greek symbol forms). Latin letters, umlauts and accents agree, which this data checks
query II
EXPLAIN SELECT lower(n), count(*) FROM rp.dbo.rs_x GROUP BY 1;
----
