# name: test/verify_remote_select_mssql.test
# description: DuckDB 2.0's remote pushdown optimizer, SELECT only, on SQL Server: with the `remote_pushdown`
#              ATTACH option a single-table aggregate / GROUP BY whose every part renders EXACTLY runs as ONE
#              T-SQL statement through fabricator_query, and everything else runs locally as before
#              (src/catalog/fabricator_remote_select.cpp; docs/duckdb-2.0-remote-execution.md §4.1).
#              Needs MSSQL_TESTDB_DSN.
#
#              ⚠⚠ THE LOAD-BEARING SECTION IS §3, A DIFFERENTIAL. Nothing re-checks what the server returns, so
#              every query runs on two attaches of the SAME database — `rp` (pushdown) and `db` (the existing
#              path, the oracle) — and the symmetric difference of their results must be empty. §4 does the same
#              for the result TYPES and NAMES, which an EXCEPT would coerce away: T-SQL's COUNT is INT and an
#              integer SUM keeps the column's type, so the pushed path casts back to DuckDB's own types.
#
#              ⚠ §1's routing rows keep §3 from passing VACUOUSLY: a build that never pushes agrees with the
#              oracle perfectly. §2 pins what must NOT be pushed, each with its reason.
# group: [fabricator]

require fabricator

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS db (TYPE fabricator);

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS rp (TYPE fabricator, remote_pushdown 'true');

# ═══ §0  Setup ═════════════════════════════════════════════════════════════════════════════════════════
# One table, created SERVER-SIDE so its types are SQL Server's own. 300 rows. k NULL when id % 11 = 0; amount
# NULL when id % 13 = 0; d NULL when id % 17 = 0; b reaches 9e18, so its SUM exceeds BIGINT; rows 299 and 300
# carry ids 2147483646 and 2147483647, so the INTEGER sum exceeds INT.

# ⚠ DROP in its own batch: SQL Server compiles a whole batch against the table as it exists, so a leftover
# rs_t with other columns would fail the INSERT below with 213.
statement ok
SELECT fabricator_exec('db', 'DROP TABLE IF EXISTS dbo.rs_t;');

statement ok
SELECT fabricator_exec('db', 'CREATE TABLE dbo.rs_t (id INT, k SMALLINT NULL, t TINYINT, b BIGINT, amount DECIMAL(10,2) NULL, big DECIMAL(38,10),
  d DATE NULL, s VARCHAR(20), f FLOAT);
INSERT INTO dbo.rs_t SELECT CASE WHEN value = 300 THEN 2147483647 WHEN value = 299 THEN 2147483646 ELSE value - 150 END,
  CASE WHEN value % 11 = 0 THEN NULL ELSE value % 7 END, value % 200, CAST(value AS BIGINT) * 30000000000000000,
  CASE WHEN value % 13 = 0 THEN NULL ELSE value * 1.25 END, value * 1.0000000001,
  CASE WHEN value % 17 = 0 THEN NULL ELSE DATEADD(day, value % 50, ''2026-01-01'') END,
  ''s'' + CAST(value % 4 AS VARCHAR), value / 3.0 FROM GENERATE_SERIES(1, 300);');

# rs_u is the join partner: k 1..9 once, plus k 1 and 2 a second time (multiplicity) and one NULL k; k 7..9
# have no partner in rs_t (LEFT joins); w is NULL for every fourth row.
statement ok
SELECT fabricator_exec('db', 'DROP TABLE IF EXISTS dbo.rs_u;');

statement ok
SELECT fabricator_exec('db', 'CREATE TABLE dbo.rs_u (uid INT, k SMALLINT NULL, label VARCHAR(10), w INT NULL);
INSERT INTO dbo.rs_u SELECT value, CASE WHEN value = 10 THEN NULL WHEN value > 10 THEN value - 10 ELSE value END,
  ''u'' + CAST(value AS VARCHAR), CASE WHEN value % 4 = 0 THEN NULL ELSE value * 10 END FROM GENERATE_SERIES(1, 12);');

statement ok
SELECT fabricator_refresh_cache('db');

statement ok
SELECT fabricator_refresh_cache('rp');

# ═══ §1  Routing — pushed ═════════════════════════════════════════════════════════════════════════════

query II
EXPLAIN SELECT count(*), sum(id), min(d), max(amount), sum(amount), count(amount) FROM rp.dbo.rs_t;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query II
EXPLAIN SELECT k, count(*), sum(b) FROM rp.dbo.rs_t WHERE id > 0 AND (d IS NOT NULL OR NOT (k = 2)) GROUP BY k;
----
physical_plan	<REGEX>:.*Fabricator Query.*

# A constant that converts LOSSLESSLY to the column type: 2.250 is DECIMAL(4,3), the column DECIMAL(10,2).
query II
EXPLAIN SELECT count(*) FROM rp.dbo.rs_t WHERE amount = 2.250;
----
physical_plan	<REGEX>:.*Fabricator Query.*

# A set operation whose branches name different catalogs pushes its remote branch ON ITS OWN — which is what
# makes §3's EXCEPT ALL differentials compare the two paths rather than the existing path with itself.
query II
EXPLAIN SELECT count(*), sum(id) FROM rp.dbo.rs_t EXCEPT ALL SELECT count(*), sum(id) FROM db.dbo.rs_t;
----
physical_plan	<REGEX>:.*Fabricator Query.*

# ⚠ BUT NOT A JOIN CHILD: DuckDB's optimizer pushes a node only when the WHOLE node is remote, and it has no
# partial pushdown for one side of a join (unlike a set operation's branches). So a remote aggregate joined to
# a local table runs locally today. This row pins upstream's behaviour and fails the day it changes.
statement ok
CREATE TEMP TABLE kn AS SELECT i::SMALLINT AS k, 'k' || i AS name FROM range(7) r(i);

query II
EXPLAIN SELECT kn.name, s.c FROM kn JOIN (SELECT k, count(*) AS c FROM rp.dbo.rs_t GROUP BY k) s ON kn.k = s.k;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

# ═══ §2  Routing — NOT pushed, each for its own reason ═════════════════════════════════════════════════

# a string column: collation, and T-SQL ignores trailing spaces in '='
query II
EXPLAIN SELECT max(s) FROM rp.dbo.rs_t;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

query II
EXPLAIN SELECT count(*) FROM rp.dbo.rs_t WHERE s = 's1';
----
physical_plan	<!REGEX>:.*Fabricator Query.*

# a float: summation order and NaN
query II
EXPLAIN SELECT sum(f) FROM rp.dbo.rs_t;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

# avg is not admitted (T-SQL's AVG of an INT is integer division)
query II
EXPLAIN SELECT avg(id) FROM rp.dbo.rs_t;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

# ⚠ a constant that does NOT convert exactly: `id > 1.5` must not become `[id] > 2`. This exact shape was
# a WRONG ANSWER in the first build (a "strict" DECIMAL -> INTEGER cast rounds).
query II
EXPLAIN SELECT count(*) FROM rp.dbo.rs_t WHERE id > 1.5;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

query II
EXPLAIN SELECT count(*) FROM rp.dbo.rs_t WHERE t < 300;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

# an expression, a plain projection over ONE table (the scan already pushes its filter)
query II
EXPLAIN SELECT sum(id + 1) FROM rp.dbo.rs_t;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

query II
EXPLAIN SELECT id FROM rp.dbo.rs_t WHERE id > 5;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

# a string sort key (collation), DISTINCT
query II
EXPLAIN SELECT s, count(*) FROM rp.dbo.rs_t GROUP BY s ORDER BY s;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

query II
EXPLAIN SELECT DISTINCT a.k FROM rp.dbo.rs_t a JOIN rp.dbo.rs_u b ON a.k = b.k;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

# a FULL join, a USING join, a string join key
query II
EXPLAIN SELECT count(*) FROM rp.dbo.rs_t a FULL JOIN rp.dbo.rs_u b ON a.k = b.k;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

query II
EXPLAIN SELECT count(*) FROM rp.dbo.rs_t JOIN rp.dbo.rs_u USING (k);
----
physical_plan	<!REGEX>:.*Fabricator Query.*

query II
EXPLAIN SELECT count(*) FROM rp.dbo.rs_t a JOIN rp.dbo.rs_u b ON a.s = b.label;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

# an UNQUALIFIED name both tables have is ambiguous: declined, so DuckDB reports it rather than the server
# picking one
statement error
SELECT k, count(*) FROM rp.dbo.rs_t a JOIN rp.dbo.rs_u b ON a.k = b.k GROUP BY k;
----
<REGEX>:.*mbiguous.*

# ═══ §3  The differential: pushed (rp) and existing (db) agree, row for row ═══════════════════════════

query I
SELECT count(*) FROM (
  (SELECT count(*), count(amount), count(d), sum(id), sum(t), sum(b), sum(amount), sum(big), min(id), max(id),
          min(d), max(d), min(amount), max(amount), min(big), max(big), min(t), max(t) FROM rp.dbo.rs_t
   EXCEPT ALL
   SELECT count(*), count(amount), count(d), sum(id), sum(t), sum(b), sum(amount), sum(big), min(id), max(id),
          min(d), max(d), min(amount), max(amount), min(big), max(big), min(t), max(t) FROM db.dbo.rs_t)
  UNION ALL
  (SELECT count(*), count(amount), count(d), sum(id), sum(t), sum(b), sum(amount), sum(big), min(id), max(id),
          min(d), max(d), min(amount), max(amount), min(big), max(big), min(t), max(t) FROM db.dbo.rs_t
   EXCEPT ALL
   SELECT count(*), count(amount), count(d), sum(id), sum(t), sum(b), sum(amount), sum(big), min(id), max(id),
          min(d), max(d), min(amount), max(amount), min(big), max(big), min(t), max(t) FROM rp.dbo.rs_t));
----
0

# the numbers themselves, so a differential of two identically wrong paths cannot pass: sum(b) exceeds BIGINT
# and sum(id) exceeds INT, which T-SQL's own SUM would overflow on
query IIII
SELECT count(*), sum(id), sum(b), count(amount) FROM rp.dbo.rs_t;
----
300	4294967144	1354500000000000000000	277

query I
SELECT count(*) FROM (
  (SELECT k, count(*), sum(id), sum(b), min(d), max(amount), count(d) FROM rp.dbo.rs_t GROUP BY k
   EXCEPT ALL SELECT k, count(*), sum(id), sum(b), min(d), max(amount), count(d) FROM db.dbo.rs_t GROUP BY k)
  UNION ALL
  (SELECT k, count(*), sum(id), sum(b), min(d), max(amount), count(d) FROM db.dbo.rs_t GROUP BY k
   EXCEPT ALL SELECT k, count(*), sum(id), sum(b), min(d), max(amount), count(d) FROM rp.dbo.rs_t GROUP BY k));
----
0

# eight groups: k 0..6 and the NULL group
query I
SELECT count(*) FROM (SELECT k, count(*) FROM rp.dbo.rs_t GROUP BY k);
----
8

query I
SELECT count(*) FROM (
  (SELECT d, k, count(*), sum(amount) FROM rp.dbo.rs_t WHERE id >= -20 AND id < 100 GROUP BY d, k
   EXCEPT ALL SELECT d, k, count(*), sum(amount) FROM db.dbo.rs_t WHERE id >= -20 AND id < 100 GROUP BY d, k)
  UNION ALL
  (SELECT d, k, count(*), sum(amount) FROM db.dbo.rs_t WHERE id >= -20 AND id < 100 GROUP BY d, k
   EXCEPT ALL SELECT d, k, count(*), sum(amount) FROM rp.dbo.rs_t WHERE id >= -20 AND id < 100 GROUP BY d, k));
----
0

# NULL semantics: `<>` keeps no NULL row, NOT keeps no NULL row, IS NULL finds them
query II
SELECT count(*), count(k) FROM rp.dbo.rs_t WHERE k <> 3;
----
234	234

query II
SELECT count(*), count(k) FROM db.dbo.rs_t WHERE k <> 3;
----
234	234

query I
SELECT count(*) FROM rp.dbo.rs_t WHERE NOT (k = 3) OR k IS NULL;
----
261

query I
SELECT count(*) FROM db.dbo.rs_t WHERE NOT (k = 3) OR k IS NULL;
----
261

query II
SELECT count(*), sum(b) FROM rp.dbo.rs_t WHERE d >= DATE '2026-02-01' AND amount IS NOT NULL;
----
99	483750000000000000000

query II
SELECT count(*), sum(b) FROM db.dbo.rs_t WHERE d >= DATE '2026-02-01' AND amount IS NOT NULL;
----
99	483750000000000000000

# an empty input: ungrouped gives one row (0, NULL), grouped gives none
query III
SELECT count(*), sum(id), max(d) FROM rp.dbo.rs_t WHERE id < -1000;
----
0	NULL	NULL

query I
SELECT count(*) FROM (SELECT k, count(*) FROM rp.dbo.rs_t WHERE id < -1000 GROUP BY k);
----
0

# the local join (not pushed, see §1) still answers like the existing path
query I
SELECT count(*) FROM (
  (SELECT kn.name, s.c FROM kn JOIN (SELECT k, count(*) AS c FROM rp.dbo.rs_t GROUP BY k) s ON kn.k = s.k
   EXCEPT ALL SELECT kn.name, s.c FROM kn JOIN (SELECT k, count(*) AS c FROM db.dbo.rs_t GROUP BY k) s ON kn.k = s.k)
  UNION ALL
  (SELECT kn.name, s.c FROM kn JOIN (SELECT k, count(*) AS c FROM db.dbo.rs_t GROUP BY k) s ON kn.k = s.k
   EXCEPT ALL SELECT kn.name, s.c FROM kn JOIN (SELECT k, count(*) AS c FROM rp.dbo.rs_t GROUP BY k) s ON kn.k = s.k));
----
0

# a declined shape still answers correctly (it runs locally, re-qualified)
query I
SELECT count(*) FROM rp.dbo.rs_t WHERE id > 1.5;
----
149

query I
SELECT count(*) FROM db.dbo.rs_t WHERE id > 1.5;
----
149

# ═══ §4  Result types and names are DuckDB's, not T-SQL's ═════════════════════════════════════════════
# ⚠ Through a CTAS, NOT `DESCRIBE`: a query inside `FROM (DESCRIBE …)` is never seen by the remote optimizer,
# so a DESCRIBE comparison describes the LOCAL path on both sides and passes vacuously — measured: a mutant
# that dropped the cast back to DuckDB's types survived it. A CTAS's query IS pushed on its own.

query II
EXPLAIN CREATE TEMP TABLE ty_rp AS SELECT k, count(*), sum(id) FROM rp.dbo.rs_t GROUP BY k;
----
physical_plan	<REGEX>:.*Fabricator Query.*

statement ok
CREATE TEMP TABLE ty_rp AS SELECT k, count(*), count(d), sum(id), sum(t), sum(b), sum(amount), sum(big), min(id),
  max(d), max(amount), min(t), max(big) AS mb FROM rp.dbo.rs_t GROUP BY k;

statement ok
CREATE TEMP TABLE ty_db AS SELECT k, count(*), count(d), sum(id), sum(t), sum(b), sum(amount), sum(big), min(id),
  max(d), max(amount), min(t), max(big) AS mb FROM db.dbo.rs_t GROUP BY k;

query I
SELECT count(*) FROM (
  (SELECT column_name, column_type FROM (DESCRIBE ty_rp) EXCEPT ALL SELECT column_name, column_type FROM (DESCRIBE ty_db))
  UNION ALL
  (SELECT column_name, column_type FROM (DESCRIBE ty_db) EXCEPT ALL SELECT column_name, column_type FROM (DESCRIBE ty_rp)));
----
0

query TT
SELECT column_name, column_type FROM (DESCRIBE ty_rp) WHERE column_name IN ('count_star()', 'sum(id)', 'sum(amount)', 'mb')
ORDER BY column_name;
----
count_star()	BIGINT
mb	DECIMAL(38,10)
sum(amount)	DECIMAL(38,2)
sum(id)	HUGEINT

# ═══ §5  Transactions: a pushed SELECT sees the transaction's own writes ═══════════════════════════════

statement ok
BEGIN;

statement ok
INSERT INTO rp.dbo.rs_t (id, k, t, b, big, s, f) VALUES (100000, 6, 1, 1, 1, 'x', 1);

query II
EXPLAIN SELECT count(*) FROM rp.dbo.rs_t WHERE id = 100000;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query I
SELECT count(*) FROM rp.dbo.rs_t WHERE id = 100000;
----
1

statement ok
ROLLBACK;

query I
SELECT count(*) FROM rp.dbo.rs_t WHERE id = 100000;
----
0

# ═══ §7  ORDER BY / LIMIT ════════════════════════════════════════════════════════════════════════════
# The server applies the order and the limit (only LIMIT rows travel); the wrapper sorts again, because a
# subquery carries no ordering guarantee. Every ordered result is asserted on BOTH catalogs in order.
#
# ⚠ THE NULL CASES ARE THE LOAD-BEARING ONES, and they use LIMIT on purpose: T-SQL puts NULLs FIRST for ASC
# and has no NULLS FIRST/LAST, while DuckDB's default is NULLS LAST. Without the explicit NULL rank the server
# would pick a different SET of rows — the local re-sort cannot repair a row that never arrived.

query II
EXPLAIN SELECT k, count(*) AS c FROM rp.dbo.rs_t GROUP BY k ORDER BY c DESC, k LIMIT 3;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query II
SELECT k, count(*) AS c FROM rp.dbo.rs_t GROUP BY k ORDER BY c DESC, k LIMIT 3;
----
0	39
1	39
2	39

query II
SELECT k, count(*) AS c FROM db.dbo.rs_t GROUP BY k ORDER BY c DESC, k LIMIT 3;
----
0	39
1	39
2	39

# ASC: NULL group last (DuckDB's default) — the NULL group must NOT be among the three
query II
SELECT k, count(*) FROM rp.dbo.rs_t GROUP BY k ORDER BY k LIMIT 3;
----
0	39
1	39
2	39

query II
SELECT k, count(*) FROM db.dbo.rs_t GROUP BY k ORDER BY k LIMIT 3;
----
0	39
1	39
2	39

# DESC: NULLs still last under DuckDB's default; T-SQL would put them last for DESC anyway
query II
SELECT k, count(*) FROM rp.dbo.rs_t GROUP BY k ORDER BY k DESC LIMIT 3;
----
6	39
5	39
4	39

query II
SELECT k, count(*) FROM rp.dbo.rs_t GROUP BY k ORDER BY k NULLS FIRST LIMIT 3;
----
NULL	27
0	39
1	39

query II
SELECT k, count(*) FROM db.dbo.rs_t GROUP BY k ORDER BY k NULLS FIRST LIMIT 3;
----
NULL	27
0	39
1	39

# OFFSET, an ORDER BY position, and a key that is not in the select list
query II
SELECT k, count(*) FROM rp.dbo.rs_t GROUP BY k ORDER BY k LIMIT 2 OFFSET 3;
----
3	39
4	39

query III
SELECT k, count(*), max(d) FROM rp.dbo.rs_t GROUP BY k ORDER BY 3 DESC, 1 LIMIT 4;
----
0	39	2026-02-19
2	39	2026-02-19
3	39	2026-02-19
4	39	2026-02-19

query I
SELECT k FROM rp.dbo.rs_t GROUP BY k ORDER BY sum(id) DESC LIMIT 2;
----
5
6

query I
SELECT k FROM db.dbo.rs_t GROUP BY k ORDER BY sum(id) DESC LIMIT 2;
----
5
6

# ⚠ An ALIAS wins over a column of the same name: `k` here is count(*), `id` is the k column.
query II
SELECT k AS id, count(*) AS k FROM rp.dbo.rs_t WHERE id < 100 GROUP BY k ORDER BY k, id LIMIT 3;
----
NULL	22
0	32
4	32

query II
SELECT k AS id, count(*) AS k FROM db.dbo.rs_t WHERE id < 100 GROUP BY k ORDER BY k, id LIMIT 3;
----
NULL	22
0	32
4	32

# the session's default NULL order is honoured, not assumed
statement ok
SET default_null_order = 'nulls_first';

query II
SELECT k, count(*) FROM rp.dbo.rs_t GROUP BY k ORDER BY k LIMIT 2;
----
NULL	27
0	39

statement ok
RESET default_null_order;

# a LIMIT without ORDER BY (TOP): which groups is arbitrary on both engines, so only the count is asserted
query I
SELECT count(*) FROM (SELECT k, count(*) FROM rp.dbo.rs_t GROUP BY k LIMIT 5);
----
5

# ═══ §8  HAVING ══════════════════════════════════════════════════════════════════════════════════════

query II
EXPLAIN SELECT k, count(*) FROM rp.dbo.rs_t GROUP BY k HAVING count(*) > 30;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query I
SELECT count(*) FROM (
  (SELECT k, count(*), sum(id) FROM rp.dbo.rs_t GROUP BY k HAVING count(*) > 30 AND sum(id) > 0
   EXCEPT ALL SELECT k, count(*), sum(id) FROM db.dbo.rs_t GROUP BY k HAVING count(*) > 30 AND sum(id) > 0)
  UNION ALL
  (SELECT k, count(*), sum(id) FROM db.dbo.rs_t GROUP BY k HAVING count(*) > 30 AND sum(id) > 0
   EXCEPT ALL SELECT k, count(*), sum(id) FROM rp.dbo.rs_t GROUP BY k HAVING count(*) > 30 AND sum(id) > 0));
----
0

# an aggregate only in HAVING, a group column in HAVING, and a HUGEINT sum compared past INT
query I
SELECT count(*) FROM (
  (SELECT k FROM rp.dbo.rs_t GROUP BY k HAVING (k > 2 OR k IS NULL) AND max(d) IS NOT NULL AND sum(id) < 3000000000
   EXCEPT ALL SELECT k FROM db.dbo.rs_t GROUP BY k HAVING (k > 2 OR k IS NULL) AND max(d) IS NOT NULL AND sum(id) < 3000000000)
  UNION ALL
  (SELECT k FROM db.dbo.rs_t GROUP BY k HAVING (k > 2 OR k IS NULL) AND max(d) IS NOT NULL AND sum(id) < 3000000000
   EXCEPT ALL SELECT k FROM rp.dbo.rs_t GROUP BY k HAVING (k > 2 OR k IS NULL) AND max(d) IS NOT NULL AND sum(id) < 3000000000));
----
0

# a HAVING constant that does not convert exactly to the aggregate's type stays local
query II
EXPLAIN SELECT k FROM rp.dbo.rs_t GROUP BY k HAVING count(*) > 38.5;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

query I
SELECT count(*) FROM (SELECT k FROM rp.dbo.rs_t GROUP BY k HAVING count(*) > 38.5);
----
7

# ═══ §9  Joins within the catalog ════════════════════════════════════════════════════════════════════

query II
EXPLAIN SELECT u.k, count(*), sum(t.id) FROM rp.dbo.rs_t t JOIN rp.dbo.rs_u u ON t.k = u.k GROUP BY u.k;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query II
EXPLAIN SELECT count(*) FROM rp.dbo.rs_t a JOIN rp.dbo.rs_t b ON a.id = b.id;
----
physical_plan	<REGEX>:.*Fabricator Query.*

# a plain projection is worth pushing once there is a join
query II
EXPLAIN SELECT u.label, t.id FROM rp.dbo.rs_t t JOIN rp.dbo.rs_u u ON t.k = u.k WHERE t.id >= 0 AND t.id <= 3;
----
physical_plan	<REGEX>:.*Fabricator Query.*

# INNER, grouped by the right side: duplicates on the right multiply, a NULL key matches nothing
query I
SELECT count(*) FROM (
  (SELECT u.k, count(*), sum(t.id), count(u.w) FROM rp.dbo.rs_t t JOIN rp.dbo.rs_u u ON t.k = u.k GROUP BY u.k
   EXCEPT ALL SELECT u.k, count(*), sum(t.id), count(u.w) FROM db.dbo.rs_t t JOIN db.dbo.rs_u u ON t.k = u.k GROUP BY u.k)
  UNION ALL
  (SELECT u.k, count(*), sum(t.id), count(u.w) FROM db.dbo.rs_t t JOIN db.dbo.rs_u u ON t.k = u.k GROUP BY u.k
   EXCEPT ALL SELECT u.k, count(*), sum(t.id), count(u.w) FROM rp.dbo.rs_t t JOIN rp.dbo.rs_u u ON t.k = u.k GROUP BY u.k));
----
0

# 39 rows per k in rs_t; k 1 and 2 twice in rs_u, k 3..6 once, k 0 and NULL nowhere: 2*78 + 4*39
query I
SELECT sum(c) FROM (SELECT count(*) AS c FROM rp.dbo.rs_t t JOIN rp.dbo.rs_u u ON t.k = u.k GROUP BY u.k);
----
312

# LEFT, with a constant in ON (it filters the RIGHT side, not the result) and WHERE on the left
query II
SELECT u.uid, count(t.id) FROM rp.dbo.rs_u u LEFT JOIN rp.dbo.rs_t t ON u.k = t.k AND t.id < 0 GROUP BY u.uid ORDER BY u.uid;
----
1	20
2	20
3	19
4	19
5	19
6	19
7	0
8	0
9	0
10	0
11	20
12	20

query II
SELECT u.uid, count(t.id) FROM db.dbo.rs_u u LEFT JOIN db.dbo.rs_t t ON u.k = t.k AND t.id < 0 GROUP BY u.uid ORDER BY u.uid;
----
1	20
2	20
3	19
4	19
5	19
6	19
7	0
8	0
9	0
10	0
11	20
12	20

# a pushed projection (VARCHAR passes through), ordered
query TI
SELECT u.label, t.id FROM rp.dbo.rs_t t JOIN rp.dbo.rs_u u ON t.k = u.k WHERE t.id >= 0 AND t.id <= 3 ORDER BY t.id, u.uid;
----
u3	0
u4	1
u5	2
u6	3

query TI
SELECT u.label, t.id FROM db.dbo.rs_t t JOIN db.dbo.rs_u u ON t.k = u.k WHERE t.id >= 0 AND t.id <= 3 ORDER BY t.id, u.uid;
----
u3	0
u4	1
u5	2
u6	3

# three tables, WHERE across them, a self-join, and an unqualified name only one table has
query I
SELECT count(*) FROM (
  (SELECT a.k, count(*) FROM rp.dbo.rs_t a JOIN rp.dbo.rs_u b ON a.k = b.k JOIN rp.dbo.rs_t c ON c.id = a.id
     WHERE uid > 3 AND (b.w IS NULL OR c.amount > 10) GROUP BY a.k
   EXCEPT ALL SELECT a.k, count(*) FROM db.dbo.rs_t a JOIN db.dbo.rs_u b ON a.k = b.k JOIN db.dbo.rs_t c ON c.id = a.id
     WHERE uid > 3 AND (b.w IS NULL OR c.amount > 10) GROUP BY a.k)
  UNION ALL
  (SELECT a.k, count(*) FROM db.dbo.rs_t a JOIN db.dbo.rs_u b ON a.k = b.k JOIN db.dbo.rs_t c ON c.id = a.id
     WHERE uid > 3 AND (b.w IS NULL OR c.amount > 10) GROUP BY a.k
   EXCEPT ALL SELECT a.k, count(*) FROM rp.dbo.rs_t a JOIN rp.dbo.rs_u b ON a.k = b.k JOIN rp.dbo.rs_t c ON c.id = a.id
     WHERE uid > 3 AND (b.w IS NULL OR c.amount > 10) GROUP BY a.k));
----
0

query II
EXPLAIN SELECT a.k, count(*) FROM rp.dbo.rs_t a JOIN rp.dbo.rs_u b ON a.k = b.k JOIN rp.dbo.rs_t c ON c.id = a.id
  WHERE uid > 3 AND (b.w IS NULL OR c.amount > 10) GROUP BY a.k;
