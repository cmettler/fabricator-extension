query I
SELECT count(*) FROM (((SELECT id, lower(n), upper(n) FROM rp.dbo.rs_x ORDER BY id LIMIT 100) EXCEPT ALL (SELECT id, lower(n), upper(n) FROM db.dbo.rs_x ORDER BY id LIMIT 100))
  UNION ALL ((SELECT id, lower(n), upper(n) FROM db.dbo.rs_x ORDER BY id LIMIT 100) EXCEPT ALL (SELECT id, lower(n), upper(n) FROM rp.dbo.rs_x ORDER BY id LIMIT 100)));
----
0

# positions and lengths count code points: under the binary collation SQL Server counts UTF-16 code units
# (length(N'𝄞x𝄞') 5, not 3), so length / substring / strpos / lpad / rpad count and cut under a supplementary-
# character collation
query II
EXPLAIN SELECT length(n), count(*) FROM rp.dbo.rs_x GROUP BY 1;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query I
SELECT count(*) FROM (((SELECT id, length(n), substring(n, 2, 2), substring(n, 2), strpos(n, 'x'), lpad(n, 5, 'xy'), rpad(n, 2, '·') FROM rp.dbo.rs_x ORDER BY id LIMIT 100) EXCEPT ALL (SELECT id, length(n), substring(n, 2, 2), substring(n, 2), strpos(n, 'x'), lpad(n, 5, 'xy'), rpad(n, 2, '·') FROM db.dbo.rs_x ORDER BY id LIMIT 100))
  UNION ALL ((SELECT id, length(n), substring(n, 2, 2), substring(n, 2), strpos(n, 'x'), lpad(n, 5, 'xy'), rpad(n, 2, '·') FROM db.dbo.rs_x ORDER BY id LIMIT 100) EXCEPT ALL (SELECT id, length(n), substring(n, 2, 2), substring(n, 2), strpos(n, 'x'), lpad(n, 5, 'xy'), rpad(n, 2, '·') FROM rp.dbo.rs_x ORDER BY id LIMIT 100)));
----
0

