  UNION ALL ((SELECT id, date_diff('year', a, b), date_diff('quarter', a, b), date_diff('month', a, b), date_diff('week', a, b), date_diff('day', a, b), date_diff('hour', a, b), date_diff('minute', a, b), date_diff('second', a, b), date_diff('millisecond', a, b), date_diff('microsecond', a, b) FROM db.dbo.rs_dd ORDER BY id LIMIT 1000) EXCEPT ALL (SELECT id, date_diff('year', a, b), date_diff('quarter', a, b), date_diff('month', a, b), date_diff('week', a, b), date_diff('day', a, b), date_diff('hour', a, b), date_diff('minute', a, b), date_diff('second', a, b), date_diff('millisecond', a, b), date_diff('microsecond', a, b) FROM rp.dbo.rs_dd ORDER BY id LIMIT 1000)));
