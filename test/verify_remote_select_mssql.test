  UNION ALL ((SELECT id, date_trunc('year', d), date_trunc('quarter', d), date_trunc('month', d), date_trunc('week', d), date_trunc('day', d) FROM db.dbo.rs_t ORDER BY id LIMIT 1000) EXCEPT ALL (SELECT id, date_trunc('year', d), date_trunc('quarter', d), date_trunc('month', d), date_trunc('week', d), date_trunc('day', d) FROM rp.dbo.rs_t ORDER BY id LIMIT 1000)));
