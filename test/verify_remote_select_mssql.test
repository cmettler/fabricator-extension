         percent_rank() OVER (PARTITION BY t % 3 ORDER BY id) AS pr, ntile(7) OVER (ORDER BY id) AS n7,
         sum(amount) OVER (PARTITION BY k ORDER BY id) AS run, sum(id) OVER (ORDER BY k) AS peers,
         sum(id) OVER (ORDER BY id ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS frame,
         avg(id) OVER (PARTITION BY k) AS a, sum(b) OVER (PARTITION BY k) AS hs,
