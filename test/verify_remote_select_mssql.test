# ═══ §7  Server types that take no COLLATE ═══════════════════════════════════════════════════════════
# json, text and ntext surface as DuckDB strings, and the emitter gives every string its collation — which
# SQL Server refuses for these types (Msg 447 / 4189). They are converted to nvarchar(max) first, which is
# the text the scan returns. xml and sql_variant have no such conversion (the server writes <b/> where the
# scan writes <b />), so a query that USES one runs locally; one that does not still goes to the server.
# The catalog learns the types at refresh, like other metadata.

statement ok
SELECT fabricator_exec('db', 'IF OBJECT_ID(''dbo.rs_ty'') IS NOT NULL DROP TABLE dbo.rs_ty;
  CREATE TABLE dbo.rs_ty (id int, x xml, j json, t text, n ntext, v sql_variant)');

statement ok
SELECT fabricator_exec('db', 'INSERT dbo.rs_ty (id, x, j, t, n, v) VALUES (1, ''<a>1</a>'', ''{"a":1}'', ''abc'', N''äbc'', CAST(42 AS sql_variant)),
  (2, NULL, NULL, NULL, NULL, NULL), (3, ''<b/>'', ''[1,2]'', ''abc '', N''x'', CAST(''v'' AS sql_variant))');

statement ok
SELECT fabricator_refresh_cache('db');

statement ok
SELECT fabricator_refresh_cache('rp');

# (a plain filtered scan stays a table scan by design, so these use shapes the server answers)
query II
EXPLAIN SELECT count(*) FROM rp.dbo.rs_ty WHERE j IS NOT NULL AND n IS NOT NULL;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query I
SELECT count(*) FROM rp.dbo.rs_ty WHERE j IS NOT NULL AND n IS NOT NULL;
----
2

# exact: 'abc ' is not 'abc' in DuckDB, though SQL Server's padding rules call them equal
query I
SELECT count(*) FROM rp.dbo.rs_ty WHERE t = 'abc';
----
1

