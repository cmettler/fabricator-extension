  UNION ALL ((SELECT j, t, n, count(*) AS c FROM db.dbo.rs_ty GROUP BY ALL) EXCEPT ALL (SELECT j, t, n, count(*) AS c FROM rp.dbo.rs_ty GROUP BY ALL)));
----
0

