# ═══ §8  A transaction that holds a connection without MARS ══════════════════════════════════════════
# The pushed query runs as a pooled read; beside this transaction's own uncommitted writes it would wait
# for their locks forever (a whole service tier once hung in verify_mars_dynamic). So it runs locally, where
# the scan routes or refuses it.

statement ok
SET mssql_mars = 'false';

statement ok
BEGIN;

statement ok
INSERT INTO rp.dbo.rs_ty (id) VALUES (4);

query II
EXPLAIN SELECT count(*) FROM rp.dbo.rs_ty;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

statement ok
ROLLBACK;

# outside the transaction the same query is pushed again
query II
EXPLAIN SELECT count(*) FROM rp.dbo.rs_ty;
----
physical_plan	<REGEX>:.*Fabricator Query.*

statement ok
RESET mssql_mars;

statement ok
SELECT fabricator_exec('db', 'DROP TABLE dbo.rs_ty');
