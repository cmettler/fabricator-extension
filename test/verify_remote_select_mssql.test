  UNION ALL ((SELECT id, CAST(f * 1.5 AS INTEGER), CAST(-f * 1.5 AS BIGINT), CAST(CAST(f * 1.5 AS REAL) AS SMALLINT), CAST(f AS INTEGER) FROM db.dbo.rs_t ORDER BY id LIMIT 1000) EXCEPT ALL (SELECT id, CAST(f * 1.5 AS INTEGER), CAST(-f * 1.5 AS BIGINT), CAST(CAST(f * 1.5 AS REAL) AS SMALLINT), CAST(f AS INTEGER) FROM rp.dbo.rs_t ORDER BY id LIMIT 1000)));
