# ═══ §13  Window functions (Substrait, docs/duckdb-2.0-remote-execution.md §3.11) ════════════════════════
# Ranks with NULLs in the order, running sums over peers (RANGE), ROWS frames, exact avg / HUGEINT sums over a
# window, lag / lead with an offset and a default, first / last value, exact string partitions, a window after
# GROUP BY, QUALIFY, and specs that alternate (the output keeps DuckDB's column order).

query II
EXPLAIN SELECT id, rank() OVER (ORDER BY k) FROM rp.dbo.rs_t;
----
physical_plan	<REGEX>:.*Fabricator Query.*

# ⚠ written out, not as a table macro: a macro expands at BIND, after the remote optimizer, so a macro over
# `rp` would never be pushed and this differential would compare local with local
query I
SELECT count(*) FROM ((SELECT id, rank() OVER (ORDER BY k) AS r, dense_rank() OVER (ORDER BY k DESC) AS dr,
         percent_rank() OVER (PARTITION BY t % 3 ORDER BY id) AS pr, ntile(7) OVER (ORDER BY id) AS n7,
         sum(amount) OVER (PARTITION BY k ORDER BY id) AS run, sum(id) OVER (ORDER BY k) AS peers,
         sum(id) OVER (ORDER BY id ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS frame,
         avg(id) OVER (PARTITION BY k) AS a, sum(b) OVER (PARTITION BY k) AS hs,
         lag(id) OVER (ORDER BY id) AS lg, lead(amount, 2, -1) OVER (PARTITION BY k ORDER BY id) AS ld,
         first_value(amount) OVER (PARTITION BY k ORDER BY id) AS fv,
         last_value(amount) OVER (PARTITION BY k ORDER BY id ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS lv,
         row_number() OVER (ORDER BY id DESC) AS rn
  FROM rp.dbo.rs_t ORDER BY id LIMIT 1000)
  EXCEPT ALL (SELECT id, rank() OVER (ORDER BY k) AS r, dense_rank() OVER (ORDER BY k DESC) AS dr,
         percent_rank() OVER (PARTITION BY t % 3 ORDER BY id) AS pr, ntile(7) OVER (ORDER BY id) AS n7,
         sum(amount) OVER (PARTITION BY k ORDER BY id) AS run, sum(id) OVER (ORDER BY k) AS peers,
         sum(id) OVER (ORDER BY id ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS frame,
         avg(id) OVER (PARTITION BY k) AS a, sum(b) OVER (PARTITION BY k) AS hs,
         lag(id) OVER (ORDER BY id) AS lg, lead(amount, 2, -1) OVER (PARTITION BY k ORDER BY id) AS ld,
         first_value(amount) OVER (PARTITION BY k ORDER BY id) AS fv,
         last_value(amount) OVER (PARTITION BY k ORDER BY id ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS lv,
         row_number() OVER (ORDER BY id DESC) AS rn
  FROM db.dbo.rs_t ORDER BY id LIMIT 1000));
----
0

