# date_diff counts unit boundaries like DATEDIFF_BIG, except the WEEK, which DuckDB counts as whole days / 7;
# last_day is EOMONTH, make_date DATEFROMPARTS (our own extension: Substrait has none of them). 300 timestamp pairs
# spread over three years, both directions, with microseconds.
statement ok
SELECT fabricator_exec('db', 'DROP TABLE IF EXISTS dbo.rs_dd;');

statement ok
SELECT fabricator_exec('db', 'CREATE TABLE dbo.rs_dd (id INT, a DATETIME2(6), b DATETIME2(6), da DATE, db DATE);
INSERT dbo.rs_dd SELECT value,
  DATEADD(microsecond, (value * 7919) % 1000000, DATEADD(minute, (value * 104729) % 2000000, CAST(''2024-01-01'' AS DATETIME2(6)))),
  DATEADD(microsecond, (value * 4243) % 1000000, DATEADD(minute, (value * 130363) % 2000000, CAST(''2024-01-01'' AS DATETIME2(6)))),
  NULL, NULL FROM GENERATE_SERIES(1, 300);
UPDATE dbo.rs_dd SET da = CAST(a AS DATE), db = CAST(b AS DATE);');

statement ok
SELECT fabricator_refresh_cache('rp');

statement ok
SELECT fabricator_refresh_cache('db');

query II
EXPLAIN SELECT date_diff('week', a, b), count(*) FROM rp.dbo.rs_dd GROUP BY 1;
----
physical_plan	<REGEX>:.*Fabricator Query.*

