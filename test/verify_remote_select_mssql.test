# name: test/verify_remote_select_mssql.test
# description: DuckDB 2.0's remote pushdown optimizer, SELECT only, on SQL Server: with the `remote_pushdown`
#              ATTACH option a single-table aggregate / GROUP BY whose every part renders EXACTLY runs as ONE
#              T-SQL statement through fabricator_query, and everything else runs locally as before
#              (src/catalog/fabricator_remote_select.cpp; docs/duckdb-2.0-remote-execution.md §4.1).
#              Needs MSSQL_TESTDB_DSN.
#
#              ⚠⚠ THE LOAD-BEARING SECTION IS §3, A DIFFERENTIAL. Nothing re-checks what the server returns, so
#              every query runs on two attaches of the SAME database — `rp` (pushdown) and `db` (the existing
#              path, the oracle) — and the symmetric difference of their results must be empty. §4 does the same
#              for the result TYPES and NAMES, which an EXCEPT would coerce away: T-SQL's COUNT is INT and an
#              integer SUM keeps the column's type, so the pushed path casts back to DuckDB's own types.
#
#              ⚠ §1's routing rows keep §3 from passing VACUOUSLY: a build that never pushes agrees with the
#              oracle perfectly. §2 pins what must NOT be pushed, each with its reason.
# group: [fabricator]

require fabricator

require json

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS db (TYPE fabricator, remote_pushdown 'false');

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS rp (TYPE fabricator, remote_pushdown 'true');

# ═══ §0  Setup ═════════════════════════════════════════════════════════════════════════════════════════
# One table, created SERVER-SIDE so its types are SQL Server's own. 300 rows. k NULL when id % 11 = 0; amount
# NULL when id % 13 = 0; d NULL when id % 17 = 0; b reaches 9e18, so its SUM exceeds BIGINT; rows 299 and 300
# carry ids 2147483646 and 2147483647, so the INTEGER sum exceeds INT.

# ⚠ DROP in its own batch: SQL Server compiles a whole batch against the table as it exists, so a leftover
# rs_t with other columns would fail the INSERT below with 213.
statement ok
SELECT fabricator_exec('db', 'DROP TABLE IF EXISTS dbo.rs_t;');

statement ok
SELECT fabricator_exec('db', 'CREATE TABLE dbo.rs_t (id INT, k SMALLINT NULL, t TINYINT, b BIGINT, amount DECIMAL(10,2) NULL, big DECIMAL(38,10),
  d DATE NULL, s VARCHAR(20), f FLOAT);
INSERT INTO dbo.rs_t SELECT CASE WHEN value = 300 THEN 2147483647 WHEN value = 299 THEN 2147483646 ELSE value - 150 END,
  CASE WHEN value % 11 = 0 THEN NULL ELSE value % 7 END, value % 200, CAST(value AS BIGINT) * 30000000000000000,
  CASE WHEN value % 13 = 0 THEN NULL ELSE value * 1.25 END, value * 1.0000000001,
  CASE WHEN value % 17 = 0 THEN NULL ELSE DATEADD(day, value % 50, ''2026-01-01'') END,
  ''s'' + CAST(value % 4 AS VARCHAR), value / 3.0 FROM GENERATE_SERIES(1, 300);');

# rs_u is the join partner: k 1..9 once, plus k 1 and 2 a second time (multiplicity) and one NULL k; k 7..9
# have no partner in rs_t (LEFT joins); w is NULL for every fourth row.
statement ok
SELECT fabricator_exec('db', 'DROP TABLE IF EXISTS dbo.rs_u;');

statement ok
SELECT fabricator_exec('db', 'CREATE TABLE dbo.rs_u (uid INT, k SMALLINT NULL, label VARCHAR(10), w INT NULL);
INSERT INTO dbo.rs_u SELECT value, CASE WHEN value = 10 THEN NULL WHEN value > 10 THEN value - 10 ELSE value END,
  ''u'' + CAST(value AS VARCHAR), CASE WHEN value % 4 = 0 THEN NULL ELSE value * 10 END FROM GENERATE_SERIES(1, 12);');

# rs_s holds strings chosen to break every shortcut: case ('a'/'A'), trailing spaces ('a '), a control
# character after a prefix ('a' + CHAR(1)), an accent, a NULL, a non-BMP character, and VARCHAR beside
# NVARCHAR. The database collation is case-insensitive, so the server's OWN `s = 'a'` matches 5 rows where
# DuckDB matches 2 — a rendering that leaned on the server's comparison could not pass §10.
statement ok
SELECT fabricator_exec('db', 'DROP TABLE IF EXISTS dbo.rs_s;');

statement ok
SELECT fabricator_exec('db', 'CREATE TABLE dbo.rs_s (id INT, s VARCHAR(20) NULL, n NVARCHAR(20) NULL);
INSERT INTO dbo.rs_s VALUES (1, ''a'', N''a''), (2, ''A'', N''A''), (3, ''a '', N''a ''), (4, ''a'' + CHAR(1), N''b''),
  (5, ''e'', N''é''), (6, NULL, NULL), (7, ''a'', N''a''), (8, ''b'', N''𝄞''), (9, ''A '', N''a'');');

statement ok
SELECT fabricator_refresh_cache('db');

statement ok
SELECT fabricator_refresh_cache('rp');

query I
SELECT * FROM fabricator_query('db', 'SELECT COUNT(*) AS c FROM dbo.rs_s WHERE s = ''a''');
----
5

# ═══ §1  Routing — pushed ═════════════════════════════════════════════════════════════════════════════

query II
EXPLAIN SELECT count(*), sum(id), min(d), max(amount), sum(amount), count(amount) FROM rp.dbo.rs_t;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query II
EXPLAIN SELECT k, count(*), sum(b) FROM rp.dbo.rs_t WHERE id > 0 AND (d IS NOT NULL OR NOT (k = 2)) GROUP BY k;
----
physical_plan	<REGEX>:.*Fabricator Query.*

# The DEFAULT is on (since 2026-10-27): an attach naming no option pushes the same query, `db` opts out above,
# and a misspelled value is refused rather than read as either one.
statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS dflt (TYPE fabricator);

query II
EXPLAIN SELECT count(*), sum(id) FROM dflt.dbo.rs_t;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query II
EXPLAIN SELECT count(*), sum(id) FROM db.dbo.rs_t;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

statement ok
DETACH dflt;

statement error
ATTACH '${MSSQL_TESTDB_DSN}' AS bad (TYPE fabricator, remote_pushdown 'flase');
----
remote_pushdown must be 'true' or 'false'

# A constant that converts LOSSLESSLY to the column type: 2.250 is DECIMAL(4,3), the column DECIMAL(10,2).
query II
EXPLAIN SELECT count(*) FROM rp.dbo.rs_t WHERE amount = 2.250;
----
physical_plan	<REGEX>:.*Fabricator Query.*

# A set operation whose branches name different catalogs pushes its remote branch ON ITS OWN — which is what
# makes §3's EXCEPT ALL differentials compare the two paths rather than the existing path with itself.
query II
EXPLAIN SELECT count(*), sum(id) FROM rp.dbo.rs_t EXCEPT ALL SELECT count(*), sum(id) FROM db.dbo.rs_t;
----
physical_plan	<REGEX>:.*Fabricator Query.*

# ⚠ BUT NOT A JOIN CHILD: DuckDB's optimizer pushes a node only when the WHOLE node is remote, and it has no
# partial pushdown for one side of a join (unlike a set operation's branches). So a remote aggregate joined to
# a local table runs locally today. This row pins upstream's behaviour and fails the day it changes.
statement ok
CREATE TEMP TABLE kn AS SELECT i::SMALLINT AS k, 'k' || i AS name FROM range(7) r(i);

query II
EXPLAIN SELECT kn.name, s.c FROM kn JOIN (SELECT k, count(*) AS c FROM rp.dbo.rs_t GROUP BY k) s ON kn.k = s.k;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

# ═══ §2  Routing — NOT pushed, each for its own reason ═════════════════════════════════════════════════

# a plain scan (scans, filters, projections, a sort) gains nothing: the table scan already pushes its filter
# and projection and keeps the catalog's statistics
query II
EXPLAIN SELECT id FROM rp.dbo.rs_t WHERE id > 5;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

query II
EXPLAIN SELECT id, s FROM rp.dbo.rs_t WHERE id > 5 ORDER BY s;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

# two result columns of one name: DuckDB re-wraps a pushed node as `SELECT * FROM <ref>`, which would rename the
# second one (id_1) where DuckDB answers id, id
query II
EXPLAIN SELECT a.id, b.uid AS id FROM rp.dbo.rs_t a JOIN rp.dbo.rs_u b ON a.k = b.k;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

query II
SELECT a.id, b.uid AS id FROM rp.dbo.rs_t a JOIN rp.dbo.rs_u b ON a.k = b.k ORDER BY 1, 2 LIMIT 1;
----
-149	1

# window shapes SQL Server computes differently (docs/duckdb-2.0-remote-execution.md §3.11): GROUPS frames,
# RANGE offsets, EXCLUDE, FILTER, DISTINCT, nth_value — and IGNORE NULLS with an offset other than 1 or a default
query II
EXPLAIN SELECT id, sum(id) OVER (ORDER BY k GROUPS BETWEEN 1 PRECEDING AND CURRENT ROW) FROM rp.dbo.rs_t;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

query II
EXPLAIN SELECT id, sum(id) OVER (ORDER BY id RANGE BETWEEN 5 PRECEDING AND CURRENT ROW) FROM rp.dbo.rs_t;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

query II
EXPLAIN SELECT id, count(*) FILTER (WHERE amount > 100) OVER (PARTITION BY k) FROM rp.dbo.rs_t;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

query II
EXPLAIN SELECT uid, lead(w, 2 IGNORE NULLS) OVER (ORDER BY uid) FROM rp.dbo.rs_u;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

query II
EXPLAIN SELECT uid, lead(w, 1, -2 IGNORE NULLS) OVER (ORDER BY uid) FROM rp.dbo.rs_u;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

# a row's order that DuckDB leaves arbitrary: ROWS frame without ORDER BY
query II
EXPLAIN SELECT id, sum(id) OVER (ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) FROM rp.dbo.rs_t;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

# ═══ §2b  Pushed through Substrait — every one of these stayed local under the hand-written renderer ═════
# Each routing row is followed by its own differential against `db`.

# string min / max and string order: by the exact key (§3.6 of the doc), never by the collation
query II
EXPLAIN SELECT max(s) FROM rp.dbo.rs_t;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query I
SELECT count(*) FROM (((SELECT max(s) AS m FROM rp.dbo.rs_t) EXCEPT ALL (SELECT max(s) AS m FROM db.dbo.rs_t))
  UNION ALL ((SELECT max(s) AS m FROM db.dbo.rs_t) EXCEPT ALL (SELECT max(s) AS m FROM rp.dbo.rs_t)));
----
0

query II
EXPLAIN SELECT count(*) FROM rp.dbo.rs_t WHERE s > 's1';
----
physical_plan	<REGEX>:.*Fabricator Query.*

query I
SELECT count(*) FROM (((SELECT count(*) AS n FROM rp.dbo.rs_t WHERE s > 's1') EXCEPT ALL (SELECT count(*) AS n FROM db.dbo.rs_t WHERE s > 's1'))
  UNION ALL ((SELECT count(*) AS n FROM db.dbo.rs_t WHERE s > 's1') EXCEPT ALL (SELECT count(*) AS n FROM rp.dbo.rs_t WHERE s > 's1')));
----
0

query II
EXPLAIN SELECT s, count(*) FROM rp.dbo.rs_t GROUP BY s ORDER BY s;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query I
SELECT count(*) FROM (((SELECT s, count(*) AS n, rank() OVER (ORDER BY s) AS r FROM rp.dbo.rs_t GROUP BY s) EXCEPT ALL (SELECT s, count(*) AS n, rank() OVER (ORDER BY s) AS r FROM db.dbo.rs_t GROUP BY s))
  UNION ALL ((SELECT s, count(*) AS n, rank() OVER (ORDER BY s) AS r FROM db.dbo.rs_t GROUP BY s) EXCEPT ALL (SELECT s, count(*) AS n, rank() OVER (ORDER BY s) AS r FROM rp.dbo.rs_t GROUP BY s)));
----
0

# a float sum and avg: an integer avg divides an EXACT sum (decimal(38,0)) by the count, in float
query II
EXPLAIN SELECT sum(f), avg(id), sum(id / 2) FROM rp.dbo.rs_t;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query I
SELECT count(*) FROM ((SELECT sum(f), avg(id), sum(id / 2), avg(amount) FROM rp.dbo.rs_t)
  EXCEPT ALL (SELECT sum(f), avg(id), sum(id / 2), avg(amount) FROM db.dbo.rs_t));
----
0

# ⚠ a constant that does NOT convert exactly: `id > 1.5` must not become `[id] > 2` (a WRONG ANSWER in the first
# hand-written build); and a constant out of the column's range
query II
EXPLAIN SELECT count(*) FROM rp.dbo.rs_t WHERE id > 1.5;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query I
SELECT count(*) FROM (((SELECT count(*) FILTER (WHERE id > 1.5) AS a, count(*) FILTER (WHERE t < 300) AS b FROM rp.dbo.rs_t) EXCEPT ALL (SELECT count(*) FILTER (WHERE id > 1.5) AS a, count(*) FILTER (WHERE t < 300) AS b FROM db.dbo.rs_t))
  UNION ALL ((SELECT count(*) FILTER (WHERE id > 1.5) AS a, count(*) FILTER (WHERE t < 300) AS b FROM db.dbo.rs_t) EXCEPT ALL (SELECT count(*) FILTER (WHERE id > 1.5) AS a, count(*) FILTER (WHERE t < 300) AS b FROM rp.dbo.rs_t)));
----
0

# DISTINCT ON, FULL and USING joins
query II
EXPLAIN SELECT DISTINCT ON (k) k FROM rp.dbo.rs_t;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query I
SELECT count(*) FROM ((SELECT DISTINCT ON (k) k FROM rp.dbo.rs_t) EXCEPT ALL (SELECT DISTINCT ON (k) k FROM db.dbo.rs_t));
----
0

query II
EXPLAIN SELECT count(*) FROM rp.dbo.rs_t a FULL JOIN rp.dbo.rs_u b ON a.k = b.k;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query I
SELECT count(*) FROM (((SELECT a.id, b.uid FROM rp.dbo.rs_t a FULL JOIN rp.dbo.rs_u b ON a.k = b.k) EXCEPT ALL (SELECT a.id, b.uid FROM db.dbo.rs_t a FULL JOIN db.dbo.rs_u b ON a.k = b.k))
  UNION ALL ((SELECT a.id, b.uid FROM db.dbo.rs_t a FULL JOIN db.dbo.rs_u b ON a.k = b.k) EXCEPT ALL (SELECT a.id, b.uid FROM rp.dbo.rs_t a FULL JOIN rp.dbo.rs_u b ON a.k = b.k)));
----
0

query I
SELECT count(*) FROM (((SELECT a.id, b.uid FROM rp.dbo.rs_t a JOIN rp.dbo.rs_u b USING (k)) EXCEPT ALL (SELECT a.id, b.uid FROM db.dbo.rs_t a JOIN db.dbo.rs_u b USING (k)))
  UNION ALL ((SELECT a.id, b.uid FROM db.dbo.rs_t a JOIN db.dbo.rs_u b USING (k)) EXCEPT ALL (SELECT a.id, b.uid FROM rp.dbo.rs_t a JOIN rp.dbo.rs_u b USING (k))));
