# name: test/verify_server_profile.test
# description: fabricator_server_info() surfaces the detected ServerProfile (warehouse-support slices 1+2)
# group: [fabricator]

require fabricator

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS db (TYPE fabricator);

# One (property, value) row per profile field, plus `mars_enabled` — which is NOT a profile field but the
# value this CATALOG resolved (capability ∧ the mssql_mars setting/ATTACH option). The pair is the point:
# `supports_mars` alone cannot show that a `SET mssql_mars='false'` reached the catalog, which is what let
# verify_mars_off_same_catalog pass vacuously.
query I
SELECT count(*) FROM fabricator_server_info('db');
----
16

# Detected raw values for the test SQL Server 2025 (box, Developer edition).
query I
SELECT CAST(value AS INTEGER) FROM fabricator_server_info('db') WHERE property = 'engine_edition';
----
3

query I
SELECT CAST(value AS INTEGER) FROM fabricator_server_info('db') WHERE property = 'product_major_version';
----
17

# Box SQL Server: MARS present, not a warehouse.
query T
SELECT value FROM fabricator_server_info('db') WHERE property = 'supports_mars';
----
true

query T
SELECT value FROM fabricator_server_info('db') WHERE property = 'is_warehouse';
----
false

# CDC exists on this engine. ⚠ It is derived from the profile and never probed: on a warehouse engine a
# statement that errors inside an explicit transaction ABORTS it, so a "is CDC here?" probe would reproduce
# the dbt 15225 defect (docs/warehouse-support.md §6.5). This row is also the ONLY thing a user on such an
# engine can read about CDC, because the db.cdc.* functions are not registered there at all.
query T
SELECT value FROM fabricator_server_info('db') WHERE property = 'supports_cdc';
----
true

# Full type system: NVARCHAR + DATETIMEOFFSET present, datetime2 scale 7.
query T
SELECT value FROM fabricator_server_info('db') WHERE property = 'has_nvarchar';
----
true

query T
SELECT value FROM fabricator_server_info('db') WHERE property = 'has_datetimeoffset';
----
true

query I
SELECT CAST(value AS INTEGER) FROM fabricator_server_info('db') WHERE property = 'max_datetime2_scale';
----
7

# SQL Server 2025 (major 17) has the native json type.
query T
SELECT value FROM fabricator_server_info('db') WHERE property = 'has_native_json';
----
true

# Collation SQL_Latin1_General_CP1_CI_AS -> not UTF-8, not binary, case-insensitive.
query T
SELECT value FROM fabricator_server_info('db') WHERE property = 'is_utf8_collation';
----
false

query T
SELECT value FROM fabricator_server_info('db') WHERE property = 'is_binary_collation';
----
false

query T
SELECT value FROM fabricator_server_info('db') WHERE property = 'is_case_sensitive';
----
false

# Box SQL Server: the pinned write transaction uses the connection/server default isolation.
query T
SELECT value FROM fabricator_server_info('db') WHERE property = 'default_write_isolation';
----
(default)

statement ok
DETACH db;
