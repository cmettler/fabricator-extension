# name: test/verify_delta_catalog_dv_default.test
# description: Deletion vectors are the DEFAULT DML mode for the Delta catalog (the modern Delta standard). A
#              plain `PROVIDER 'delta'` DELETE marks rows in a DV (no file rewrite) — proven by the on-disk
#              parquet file count staying at 1 after a DELETE. `deletion_vectors false` opts OUT to plain
#              copy-on-write (max-compat, minReader 1) — which rewrites the file, leaving a second parquet on
#              disk. Set FABRICATOR_DELTA_WRITE_DIR to a WRITABLE base path. Local FS.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

# ---- DEFAULT (no option) => deletion vectors: DELETE does NOT rewrite the data file ----
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/dvdef' AS lake (TYPE fabricator, PROVIDER 'delta', column_mapping 'none');

statement ok
CREATE TABLE lake.main.t AS SELECT i AS id, 'v' || i AS name FROM range(1, 7) AS r(i);

# One data file after the create.
query I
SELECT count(*) FROM glob('${FABRICATOR_DELTA_WRITE_DIR}/dvdef/t/*.parquet');
----
1

statement ok
DELETE FROM lake.main.t WHERE id = 2;

query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
1	v1
3	v3
4	v4
5	v5
6	v6

# STILL one data file — the DELETE wrote a deletion vector, not a rewritten file (DV is the default).
query I
SELECT count(*) FROM glob('${FABRICATOR_DELTA_WRITE_DIR}/dvdef/t/*.parquet');
----
1

statement ok
DETACH lake;

# ---- OPT-OUT (deletion_vectors false) => copy-on-write: DELETE rewrites the file (a 2nd parquet on disk) ----
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/cowout' AS cow (TYPE fabricator, PROVIDER 'delta', column_mapping 'none', deletion_vectors false);

statement ok
CREATE TABLE cow.main.t AS SELECT i AS id, 'v' || i AS name FROM range(1, 7) AS r(i);

query I
SELECT count(*) FROM glob('${FABRICATOR_DELTA_WRITE_DIR}/cowout/t/*.parquet');
----
1

statement ok
DELETE FROM cow.main.t WHERE id = 2;

query IT
SELECT id, name FROM cow.main.t ORDER BY id;
----
1	v1
3	v3
4	v4
5	v5
6	v6

# TWO data files — the copy-on-write DELETE rewrote the survivors into a new file (the old one lingers on disk).
query I
SELECT count(*) FROM glob('${FABRICATOR_DELTA_WRITE_DIR}/cowout/t/*.parquet');
----
2

statement ok
DETACH cow;

# ---- MERGE-ON-READ UPDATE (DV default): UPDATE DV-deletes the old rows and APPENDS only the post-image rows
#      (a small file) instead of rewriting the whole file ----
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/mor' AS mor (TYPE fabricator, PROVIDER 'delta', column_mapping 'none');

statement ok
CREATE TABLE mor.main.t AS SELECT i AS id, 'v' || i AS name FROM range(1, 11) AS r(i);

statement ok
UPDATE mor.main.t SET name = 'X' WHERE id IN (3, 7);

query IT
SELECT id, name FROM mor.main.t ORDER BY id;
----
1	v1
2	v2
3	X
4	v4
5	v5
6	v6
7	X
8	v8
9	v9
10	v10

# The original 10-row file PERSISTS (DV marks the 2 updated rows) and a SMALL 2-row post-image file is appended
# — merge-on-read, NOT a full-file copy-on-write rewrite (which would produce a second 10-row file).
query I
SELECT min(num_rows) FROM parquet_file_metadata('${FABRICATOR_DELTA_WRITE_DIR}/mor/t/*.parquet');
----
2

query I
SELECT max(num_rows) FROM parquet_file_metadata('${FABRICATOR_DELTA_WRITE_DIR}/mor/t/*.parquet');
----
10

statement ok
DETACH mor;

# ==============================================================================================
# LARGE DELETION VECTORS — the read path must not inline positions as SQL literals.
#
# A deletion vector used to be rendered into the generated read_parquet SQL as
# `file_row_number NOT IN (<one integer literal per deleted row>)`. MEASURED on a 200k-row table,
# scanning after deleting N rows: N=10k took 5s/85MB, 100k took 42s/196MB, 199k took 68s/301MB —
# ~0.4ms and ~1.2KB PER DELETED ROW. The control was decisive: the SAME 100k rows deleted
# copy-on-write (no DV at all) scanned in 1s/66MB, so the predicate and not the deletion was 42x the
# cost. It is paid by EVERY read until an OPTIMIZE rewrites the files, so an incrementally-merged
# table got slower every run. Above a small threshold the vector is now bound as an Arrow input and
# excluded with NOT EXISTS, which DuckDB hash-builds once (measured 1.1s/93MB at 199k — flat, and
# indistinguishable from the no-DV control).
#
# ⚠ WHY THIS SECTION EXISTS AT ALL: every other deletion-vector assertion in this repo deletes a
# handful of rows, i.e. stays BELOW the inline threshold, so the bound-input path is invisible to
# them — they pass whether or not it works. These deletes are deliberately large enough to cross it.
# The danger is silent: an exclusion that contributes nothing RESURRECTS deleted rows, so every
# expectation below is arithmetic over the survivors rather than a smoke check.
# ==============================================================================================

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/bigdv' AS bigdv (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE bigdv.main.t AS SELECT i::BIGINT AS id, (i*10)::BIGINT AS v FROM range(1, 20001) r(i);

# CONTIGUOUS vector well above the threshold.
statement ok
DELETE FROM bigdv.main.t WHERE id <= 5000;

query III
SELECT count(*), min(id), max(id) FROM bigdv.main.t;
----
15000	5001	20000

# Sum over the survivors: a wrong exclusion set changes this even when the COUNT happens to match.
query I
SELECT sum(v) FROM bigdv.main.t;
----
1875075000

# A pushed filter and a large vector in the same scan — both are applied by the one inner query, so
# this pins that they compose.
query III
SELECT count(*), min(id), max(id) FROM bigdv.main.t WHERE id > 10000 AND id <= 15000;
----
5000	10001	15000

# rowid-addressed DML THROUGH a large vector, then read back: the exclusion coexists with a rowid
# condition rather than replacing it.
statement ok
UPDATE bigdv.main.t SET v = -1 WHERE id = 12345;

query I
SELECT v FROM bigdv.main.t WHERE id = 12345;
----
-1

statement ok
DELETE FROM bigdv.main.t WHERE id = 12346;

query II
SELECT count(*), sum(CASE WHEN id = 12346 THEN 1 ELSE 0 END) FROM bigdv.main.t;
----
14999	0

# SCATTERED positions — the shape no range-collapse could serve, so it exercises the anti-join itself
# rather than a contiguous special case.
statement ok
CREATE TABLE bigdv.main.scat AS SELECT i::BIGINT AS id FROM range(1, 20001) r(i);

statement ok
DELETE FROM bigdv.main.scat WHERE id % 3 = 0;

query II
SELECT count(*), sum(CASE WHEN id % 3 = 0 THEN 1 ELSE 0 END) FROM bigdv.main.scat;
----
13334	0

statement ok
DETACH bigdv;

# ----------------------------------------------------------------------------------------------
# SEVERAL FILES, EACH CARRYING A LARGE DELETION VECTOR — and this shape is the point.
#
# The streaming scan issues ONE query per data file, each binding its OWN single-use Arrow input, so
# every vector is scanned exactly once. A regression that bound ONE SHARED input across files would be
# INVISIBLE on a single-file table (the shape of every other assertion here, since a CTAS writes one
# file): the first file would consume the stream and every later file would silently contribute NO
# exclusions, resurrecting its deleted rows. Hence three separate INSERTs — three files — with one
# DELETE spanning all of them, and totals that can only hold if all three vectors applied.
# ----------------------------------------------------------------------------------------------

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/mfdv' AS mfdv (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE mfdv.main.t (id BIGINT);

statement ok
INSERT INTO mfdv.main.t SELECT i::BIGINT FROM range(1, 10001) r(i);

statement ok
INSERT INTO mfdv.main.t SELECT i::BIGINT FROM range(10001, 20001) r(i);

statement ok
INSERT INTO mfdv.main.t SELECT i::BIGINT FROM range(20001, 30001) r(i);

# Three data files, one per INSERT — the precondition for everything below. Asserted rather than
# assumed: if the writer ever coalesced these into one file the section would still pass while having
# stopped testing the multi-file case.
query I
SELECT count(*) FROM glob('${FABRICATOR_DELTA_WRITE_DIR}/mfdv/t/*.parquet');
----
3

# One DELETE spanning all three files => each gets its own vector of 5000 positions, all above the
# inline threshold, all bound as separate inputs.
statement ok
DELETE FROM mfdv.main.t WHERE id % 2 = 0;

query II
SELECT count(*), sum(CASE WHEN id % 2 = 0 THEN 1 ELSE 0 END) FROM mfdv.main.t;
----
15000	0

# The SUM is the load-bearing assertion: a count could survive one file's exclusions going missing if
# another over-excluded, but the sum of the odd numbers 1..29999 pins the exact surviving SET.
query I
SELECT sum(id) FROM mfdv.main.t;
----
225000000

# Per-file totals: 5000 survivors in EACH file's id range, so no single file's vector was skipped.
query III
SELECT count(*) FILTER (WHERE id <= 10000), count(*) FILTER (WHERE id > 10000 AND id <= 20000),
       count(*) FILTER (WHERE id > 20000) FROM mfdv.main.t;
----
5000	5000	5000

statement ok
DETACH mfdv;

# ----------------------------------------------------------------------------------------------
# FULLY-DELETED FILE — a merge-on-read UPDATE of a WHOLE file DV-deletes every one of its rows and
# appends the post-images beside it, so the original becomes dead weight that the scan used to open
# and then exclude row by row. It is now skipped from the listing when the add's stats give a row
# count and the vector covers all of it.
#
# The skip itself is not observable from SQL, so what is pinned here is the thing that would break if
# it were WRONG: skipping a file that still has live rows loses them silently. Hence a full-table
# UPDATE (which produces exactly this shape) followed by assertions over every surviving row.
# ----------------------------------------------------------------------------------------------

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/deadfile' AS deadfile (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE deadfile.main.t AS SELECT i::BIGINT AS id, (i*10)::BIGINT AS v FROM range(1, 20001) r(i);

statement ok
UPDATE deadfile.main.t SET v = v + 1;

# Every row present and every value updated: a wrongly-skipped file shows up as missing rows, and a
# wrongly-KEPT dead file would show up as duplicates.
query III
SELECT count(*), sum(CASE WHEN v = id*10+1 THEN 0 ELSE 1 END), count(DISTINCT id) FROM deadfile.main.t;
----
20000	0	20000

# A second full-table UPDATE stacks the shape — the previous post-image files become dead in turn.
statement ok
UPDATE deadfile.main.t SET v = v + 1;

query III
SELECT count(*), sum(CASE WHEN v = id*10+2 THEN 0 ELSE 1 END), count(DISTINCT id) FROM deadfile.main.t;
----
20000	0	20000

statement ok
DETACH deadfile;
