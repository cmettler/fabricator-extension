# name: test/verify_delta_catalog_delete.test
# description: Delta folder-as-catalog DELETE — rowid-based, COPY-ON-WRITE (mirrors the SQL Server backend's
#              rowid DML). The rowid is the TRANSIENT LOCATOR (fileOrdinal << 40) | file_row_number, minted at
#              scan time and valid for one snapshot: a physical address, NOT an identity, surfaced as a VIRTUAL
#              column (not in the user schema). DELETE FROM lake.t WHERE ... plans rowid-based, DuckDB applies
#              the WHERE during its scan, and each affected file is REWRITTEN without the deleted rows.
#              These ATTACHes pin `deletion_vectors false` deliberately — that is what keeps this suite on the
#              copy-on-write path; the DV path is covered by verify_delta_catalog_dv / _dv_default.
#              (The header used to describe the abandoned 2026-06-29 design — a STABLE row-tracking
#              _metadata.row_id plus deletion vectors — which Fabric's OneLake converter could not read. See
#              docs/rowid-concepts.md for why the transient locator still carries the spec's stable-id name.)
#              Set FABRICATOR_DELTA_WRITE_DIR to a WRITABLE base path. Local FS.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

# ENGINE-PARAMETERIZED: this suite runs TWICE, once per Delta engine, because its subject — write /
# transaction / update / delete semantics — must be IDENTICAL whichever engine moves the bytes.
# ${DELTA_PROVIDER} is 'delta' (DuckDB reads+writes the parquet, EW owns the log) on one leg and
# 'engineeredwooddelta' (pure EW codec) on the other; scripts/run-suites.sh drives both. ATTACHes that
# pin native_read/native_write explicitly are NOT parameterized — those sections are about the native
# path specifically and stay on it in both legs.
require-env DELTA_PROVIDER

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogdel' AS lake (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}', deletion_vectors false);

statement ok
CREATE TABLE lake.main.t (id INTEGER, name VARCHAR);

statement ok
INSERT INTO lake.main.t SELECT i, 'a' || i FROM range(1, 6) AS r(i);

query I
SELECT count(*) FROM lake.main.t;
----
5

# DELETE a single row by equality predicate (DuckDB scans -> rowid -> deletion vector).
statement ok
DELETE FROM lake.main.t WHERE id = 2;

query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
1	a1
3	a3
4	a4
5	a5

# DELETE a range — removes 4 and 5.
statement ok
DELETE FROM lake.main.t WHERE id >= 4;

query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
1	a1
3	a3

# The surviving rows keep their identity across deletes (a second DELETE targets the right rows).
statement ok
DELETE FROM lake.main.t WHERE name = 'a1';

query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
3	a3

# Durability: detach + re-attach re-reads the _delta_log (deletion vectors applied).
statement ok
DETACH lake;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogdel' AS lake2 (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}', deletion_vectors false);

query IT
SELECT id, name FROM lake2.main.t ORDER BY id;
----
3	a3

# DELETE all remaining (no WHERE) empties the table.
statement ok
DELETE FROM lake2.main.t;

query I
SELECT count(*) FROM lake2.main.t;
----
0

statement ok
DETACH lake2;
