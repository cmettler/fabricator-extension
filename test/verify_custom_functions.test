# name: test/verify_custom_functions.test
# description: Provider-authored custom C# scalar + table functions are callable as db.schema.fn(args) at attach time
# group: [mssql]

require fabricator

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS cdb (TYPE fabricator);

# dbo.cf_add is a custom C# function (an ArrowScalarFunction baked into the provider), NOT a
# SQL Server object — surfaced into the attached catalog like a discovered function.
query I
SELECT cdb.dbo.cf_add(2, 3);
----
5

# Vectorized over a batch (cast to the registered INTEGER signature).
query II
SELECT i, cdb.dbo.cf_add(i::INTEGER, 100) AS r FROM range(1, 4) t(i) ORDER BY i;
----
1	101
2	102
3	103

# The C# Invoke sees NULL argument rows (registered VOLATILE + SPECIAL_HANDLING).
query I
SELECT cdb.dbo.cf_add(NULL::INTEGER, 5);
----
NULL

# dbo.cf_host_answer reuses the HOST DuckDB engine from inside a C# function: it calls Host.Query (the
# host_query reverse callback), which runs 'SELECT 40+2' on a FRESH host connection and returns Arrow.
# This is the full round-trip DuckDB -> C# scalar -> host_query -> fresh host connection -> Arrow -> back,
# and it is reentrancy-safe (the nested run is a fresh connection, never the in-flight context). host-query.md.
query I
SELECT cdb.dbo.cf_host_answer(0);
----
42

# Vectorized: the host query runs once per Invoke; the answer is returned for every input row.
query I
SELECT count(*) FILTER (WHERE a = 42) FROM (SELECT cdb.dbo.cf_host_answer(i) AS a FROM range(3) t(i));
----
3

# dbo.cf_host_sum pushes a C#-built Arrow table [1,2,3,4] INTO a host query (data-in): Host.Query registers
# it as the connection-scoped TEMPORARY view `in0` and runs SELECT sum(v) FROM in0 on the host engine.
# Proves C#-provided Arrow streaming into the host. 1+2+3+4 = 10. host-query.md.
query I
SELECT cdb.dbo.cf_host_sum(0);
----
10

# ⚠⚠ ...AND IT LEAVES NOTHING BEHIND. Until 2026-09-03 the input was registered by duckdb_arrow_scan, which
# ends in CreateView(name, replace, temporary: FALSE) — so this very call left an `in0` CATALOG view in the
# caller's own memory.main, pointing at a stream that was released when its query finished. MEASURED then:
# `SELECT * FROM in0` right here SEGFAULTED the process (exit 139). They are TEMPORARY views now.
#
# ⚠ The 10 above is this assertion's positive control and is load-bearing: a 0 here is equally true of a
# build where the input was never registered at all, which is why the two must be read together.
query I
SELECT count(*) FROM duckdb_views() WHERE view_name = 'in0';
----
0

# dbo.cf_host_param binds a 1-row Arrow params batch [40, 2] POSITIONALLY into a host query
# (SELECT (?::BIGINT)+(?::BIGINT)) via a prepared statement on a fresh host connection -> 42. host-query.md.
#
# ⚠⚠ IT IS ALSO THE GUARD ON POSITIONAL BINDING, and it is the only one. When host_query grew NAMED
# parameter binding (2026-09-01, docs/fluid-templating.md §9.10) the first rule tried was "every column has
# a non-empty Arrow name ⇒ bind by name" — and an Arrow field practically always HAS a name, so that
# silently switched this call, whose columns are p0/p1 against `?` placeholders, to name-binding:
# "Values were not provided for the following prepared statement parameters: 1, 2". THIS ASSERTION CAUGHT
# IT; review had passed it. The rule now matches the batch's names against the statement's own
# named_param_map, which a `?` statement fills with "1", "2", … so p0/p1 cannot match.
query I
SELECT cdb.dbo.cf_host_param(0);
----
42

# It is discovered like any catalog function...
query TTT
SELECT schema_name, name, kind FROM fabricator_functions('cdb') WHERE name = 'cf_add';
----
dbo	cf_add	scalar

# ...yet there is NO such object in SQL Server — proving it is the C#-authored custom function.
query I
SELECT cnt FROM fabricator_query('cdb', 'SELECT COUNT(*) AS cnt FROM sys.objects WHERE name = ''cf_add''');
----
0

# A custom C# TABLE function (IArrowTableFunction): dbo.cf_range(n) generates (value, squared) rows in C#.
query II
SELECT value, squared FROM cdb.dbo.cf_range(3) ORDER BY value;
----
1	1
2	4
3	9

# Projection (squared only) + filter (value > 1) are applied by DuckDB above the scan (custom functions
# get no SQL-level pushdown); arrow_ingest selects the projected column by name from the full result.
query I
SELECT squared FROM cdb.dbo.cf_range(4) WHERE value > 1 ORDER BY squared;
----
4
9
16

# Aggregation over the custom table function.
query II
SELECT count(*), sum(value) FROM cdb.dbo.cf_range(5);
----
5	15

# Discovered as a table function — again with no backing SQL Server object.
query TT
SELECT name, kind FROM fabricator_functions('cdb') WHERE name = 'cf_range';
----
cf_range	table

# A custom C# TABLE-IN-OUT function (IArrowInOutFunction, via the StaticInOutFunction base): cf_tag(<table of
# n>) -> (n, n*n) per input row, yielded in DoExchange. Pure C#, no SQL object. Output = the declared schema.
query II
SELECT n, sq FROM cdb.dbo.cf_tag((SELECT v.n FROM (VALUES(2),(3),(4)) v(n))) ORDER BY n;
----
2	4
3	9
4	16

# A STATEFUL table-in-out: cf_running_sum keeps a cumulative sum across the input stream (state held
# across Process calls). Multi-chunk input (4999 rows, INT) exercises state accumulated across many
# Process calls. The cumulative value is order-dependent, but max(running) == total is order-independent
# (the last row processed always holds the full sum): count=4999, max(running)=sum(1..4999)=12497500.
query II
SELECT count(*), max(running) FROM cdb.dbo.cf_running_sum((SELECT t.n::INTEGER FROM range(1, 5000) t(n)));
----
4999	12497500

# State is per-session (fresh instance each open): a second call starts its running sum from zero.
query II
SELECT count(*), max(running) FROM cdb.dbo.cf_running_sum((SELECT v.n FROM (VALUES(10),(20),(30)) v(n)));
----
3	60

# Discovered with kind 'inout', and (like the others) no backing SQL Server object.
query TT
SELECT name, kind FROM fabricator_functions('cdb') WHERE name IN ('cf_tag', 'cf_running_sum') ORDER BY name;
----
cf_running_sum	inout
cf_tag	inout

query I
SELECT cnt FROM fabricator_query('cdb', 'SELECT COUNT(*) AS cnt FROM sys.objects WHERE name IN (''cf_tag'', ''cf_running_sum'')');
----
0

# A custom table function whose OUTPUT SCHEMA depends on the constant argument — only expressible because
# IArrowTableFunction.Bind sees the args. dbo.cf_columns(n) returns one row of n INT columns c1..cn.
query III
SELECT * FROM cdb.dbo.cf_columns(3);
----
1	2	3

# A different argument yields a DIFFERENT schema (2 columns here vs 3 above): the binding resolved it from n.
query II
SELECT * FROM cdb.dbo.cf_columns(2);
----
1	2

# The columns are named c1..cn (resolved at bind) — selecting a specific one works.
query I
SELECT c4 FROM cdb.dbo.cf_columns(5);
----
4

# --- Phase 6 streaming exchange: the gate under parallel UNION ALL input ---
# cf_tag runs on the gate-based exchange operator. A UNION ALL input is several branch pipelines feeding
# ONE session; the C++ gate serializes them and the single injected OperatorFinalize is the EOF signal.
# The FULL result must come back whether the branches run in parallel (threads=4) OR sequentially
# (threads=1 — the schedule a premature-finish bug would silently drop the later branch's rows on).
statement ok
SET threads=4;

query II
SELECT n, sq FROM cdb.dbo.cf_tag((
    SELECT v.n FROM (VALUES(1),(2)) v(n)
    UNION ALL SELECT v.n FROM (VALUES(3),(4),(5)) v(n)
)) ORDER BY n;
----
1	1
2	4
3	9
4	16
5	25

statement ok
SET threads=1;

query II
SELECT n, sq FROM cdb.dbo.cf_tag((
    SELECT v.n FROM (VALUES(1),(2)) v(n)
    UNION ALL SELECT v.n FROM (VALUES(3),(4),(5)) v(n)
)) ORDER BY n;
----
1	1
2	4
3	9
4	16
5	25

# Larger parallel union (two multi-chunk range branches): aggregate the tagged output. count = 200 rows,
# sum(sq) = sum(n*n, n=1..200) = 200*201*401/6 = 2686700 — exercises the gate across many chunks + branches.
statement ok
SET threads=4;

query II
SELECT count(*), sum(sq) FROM cdb.dbo.cf_tag((
    SELECT t.n::INTEGER FROM range(1, 101) t(n)
    UNION ALL SELECT t.n::INTEGER FROM range(101, 201) t(n)
));
----
200	2686700

# --- A FREE-FORM DoExchange custom in-out (IArrowInOutFunction) ---
# cf_exchange tags each input row with a 1-based rownum maintained in a LOCAL across the whole input stream:
# the author drives the streaming loop in DoExchange and yields the per-input sentinel itself (vs the per-chunk
# Process shape of cf_tag/cf_running_sum). Single-chunk input arrives in order, so rownum follows n.
statement ok
SET threads=1;

query II
SELECT n, rownum FROM cdb.dbo.cf_exchange((SELECT v.n FROM (VALUES(10),(20),(30)) v(n))) ORDER BY n;
----
10	1
20	2
30	3

# Multi-chunk input: rownum is a GLOBAL 1-based index held in the binding's local across chunks, so
# max(rownum) == count over the whole 4999-row stream — proving the local survives chunk boundaries.
query II
SELECT count(*), max(rownum) FROM cdb.dbo.cf_exchange((SELECT t.n::INTEGER FROM range(1, 5000) t(n)));
----
4999	4999

# Discovered as kind 'inout' (same as the per-chunk custom in-out), with no backing SQL Server object.
query TT
SELECT name, kind FROM fabricator_functions('cdb') WHERE name = 'cf_exchange';
----
cf_exchange	inout

query I
SELECT cnt FROM fabricator_query('cdb', 'SELECT COUNT(*) AS cnt FROM sys.objects WHERE name = ''cf_exchange''');
----
0

# ---- VARIADIC parameters on a CATALOG-BOUND function (Params.VarArgs) ----
#
# The global demos (fabricator_va_concat / _va_args / _va_values, gated in verify_global_functions and
# verify_sqlgen) exercise the LOAD-TIME registration path. This is the ATTACH-TIME one — a different site
# (GetOrCreateScalarFunction), and a declaration form that ships only global LOOKS covered while it is
# untested.
#
# ⚠ The signature is the load-bearing assertion, not the sums: an implementation reading its args batch
# positionally would answer identically for a fixed-arity declaration. `parameter_types = []` is a MINIMUM
# arity of ZERO and `varargs` is what says the function is variadic at all.
query TTTT
SELECT parameters, parameter_types, varargs, return_type
FROM duckdb_functions() WHERE function_name = 'cf_va_sum';
----
[]	[]	BIGINT	BIGINT

query III
SELECT cdb.dbo.cf_va_sum(1, 2, 3), cdb.dbo.cf_va_sum(10), cdb.dbo.cf_va_sum();
----
6	10	0

# A CONCRETE tail applies DuckDB's ordinary implicit-cast rules per argument, so three integral widths
# arrive as one type…
query I
SELECT cdb.dbo.cf_va_sum(1, 2::SMALLINT, 3::TINYINT);
----
6

# …and a cast DuckDB will NOT make implicitly is refused at BIND, exactly as for a declared parameter. This
# is the assertion that keeps "a concrete tail" from being read as "anything, coerced" — the ANY tail is
# what accepts anything, and the two are different declarations.
statement error
SELECT cdb.dbo.cf_va_sum(1, 3.0);
----
<REGEX>:.*cf_va_sum\(\[BIGINT\.\.\.\]\).*

# A tail argument may be a column, evaluated per row.
query I
SELECT cdb.dbo.cf_va_sum(r, r * 2) FROM range(3) t(r) ORDER BY 1;
----
0
3
6

# ---- VARIADIC tails on the ATTACH-TIME (catalog-bound) registration sites ----
#
# cf_va_sum above covers the catalog SCALAR path. These cover TABLE, SQLGEN and LATERAL. They add no
# capability — each mirrors a load-time global that is already gated — and exist because each catalog path
# has its OWN plumbing to fetch parameter styles and hand the tail's position to its marshal, so each is an
# independent chance to have made the mistake the sqlgen path actually made (its info stored a FILTERED
# declaration, so the varargs index did not correspond to the names it indexed, and it surfaced three layers
# away as `ArgumentNullException: 'fields'`). A static audit cannot see that class of error.
#
# ⚠⚠ THE CATALOG TABLE-IN-OUT SECTION BELOW IS A REGRESSION GATE ON A PRE-EXISTING DEFECT THIS WORK FOUND.
# CatalogFunctionSet.ParamSchema omitted in-out and collector, so the host's param-schema fetch yielded
# nothing, GetOrCreateCustomInOutFunction caught the failure and fell back to the bare {TABLE} signature —
# SILENTLY dropping the whole declaration. A [TableInput][Positional][VarArgs] in-out registered as `[TABLE]`,
# losing its positional AND its tail, with NO error anywhere: the failed-crossing log was empty because
# nothing failed, the fetch simply returned one parameter. The site's own comment had recorded the omission as
# "right for every in-out shipped today" — accurate then, and a trap for the first one to declare a cost arg.
# ⚠ The fix is behaviour-neutral for every other in-tree in-out/collector (they declare only their table
# input, so the declaration produces exactly the `[TABLE]` the fallback produced), which is what made it safe.

# TABLE: the registration carries the prefix and the tail separately...
query TTT
SELECT parameter_types, varargs, function_type
FROM duckdb_functions() WHERE function_name = 'cf_va_rows';
----
[VARCHAR]	ANY	table

# ...and the tail arrives with its own types preserved (an ANY tail inserts no cast).
query TT
SELECT name, value FROM cdb.dbo.cf_va_rows('L', 42, 'hi') ORDER BY name;
----
arg_0	42
arg_1	hi

query I
SELECT count(*) FROM cdb.dbo.cf_va_rows('L');
----
0

# SQLGEN: minimum arity zero (the tail is the only parameter), and the generated SQL's COLUMN COUNT is the
# argument count — the shape a fixed signature cannot express.
query TTT
SELECT parameter_types, varargs, function_type
FROM duckdb_functions() WHERE function_name = 'cf_va_select';
----
[]	BIGINT	table

query III
SELECT * FROM cdb.dbo.cf_va_select(1, 2, 3);
----
1	2	3

query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM cdb.dbo.cf_va_select(4, 5));
----
2

# LATERAL: here the tail is per-row WIRE data, not bind-time arguments — so the assertion that matters is the
# tail supplied from COLUMNS in the correlated shape.
query TT
SELECT parameter_types, varargs FROM duckdb_functions() WHERE function_name = 'cf_va_span';
----
[BIGINT]	BIGINT

statement ok
CREATE TABLE cat_va_t(n BIGINT);

statement ok
INSERT INTO cat_va_t VALUES (3), (4);

query II
SELECT t.n, f.tail_sum FROM cat_va_t t, cdb.dbo.cf_va_span(t.n, t.n * 10, t.n * 100) f ORDER BY 1;
----
3	330
4	440

# No tail arguments at all is a legal call on the same declaration.
query II
SELECT t.n, f.tail_sum FROM cat_va_t t, cdb.dbo.cf_va_span(t.n) f ORDER BY 1;
----
3	0
4	0

statement ok
DROP TABLE cat_va_t;

# TABLE-IN-OUT: the registration must carry the {TABLE} slot, the positional prefix AND the tail. `[TABLE]`
# alone is the defect's own signature, so this row is the regression gate.
query TT
SELECT parameter_types, varargs FROM duckdb_functions() WHERE function_name = 'cf_va_tag';
----
[TABLE, VARCHAR]	ANY

# The tail is BIND-TIME data here — it widens the args batch, not the input stream — so the load-bearing
# assertion is the row count: three input rows in, three out, with the tail changing only the tag.
query IT
SELECT count(*), min(tag) FROM cdb.dbo.cf_va_tag((SELECT * FROM range(3) t(n)), 'L', 1, 2);
----
3	L:1+2

query T
SELECT DISTINCT tag FROM cdb.dbo.cf_va_tag((SELECT * FROM range(2) t(n)), 'base');
----
base

statement ok
DETACH cdb;
