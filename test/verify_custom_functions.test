# name: test/verify_custom_functions.test
# description: Provider-authored custom C# scalar + table functions are callable as db.schema.fn(args) at attach time
# group: [mssql]

require mssql_net

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS cdb (TYPE mssql_net);

# dbo.cf_add is a custom C# function (an ArrowScalarFunction baked into the provider), NOT a
# SQL Server object — surfaced into the attached catalog like a discovered function.
query I
SELECT cdb.dbo.cf_add(2, 3);
----
5

# Vectorized over a batch (cast to the registered INTEGER signature).
query II
SELECT i, cdb.dbo.cf_add(i::INTEGER, 100) AS r FROM range(1, 4) t(i) ORDER BY i;
----
1	101
2	102
3	103

# The C# Invoke sees NULL argument rows (registered VOLATILE + SPECIAL_HANDLING).
query I
SELECT cdb.dbo.cf_add(NULL::INTEGER, 5);
----
NULL

# It is discovered like any catalog function...
query TTT
SELECT schema_name, name, kind FROM mssql_net_functions('cdb') WHERE name = 'cf_add';
----
dbo	cf_add	scalar

# ...yet there is NO such object in SQL Server — proving it is the C#-authored custom function.
query I
SELECT cnt FROM mssql_net_query('cdb', 'SELECT COUNT(*) AS cnt FROM sys.objects WHERE name = ''cf_add''');
----
0

# A custom C# TABLE function (IArrowTableFunction): dbo.cf_range(n) generates (value, squared) rows in C#.
query II
SELECT value, squared FROM cdb.dbo.cf_range(3) ORDER BY value;
----
1	1
2	4
3	9

# Projection (squared only) + filter (value > 1) are applied by DuckDB above the scan (custom functions
# get no SQL-level pushdown); arrow_ingest selects the projected column by name from the full result.
query I
SELECT squared FROM cdb.dbo.cf_range(4) WHERE value > 1 ORDER BY squared;
----
4
9
16

# Aggregation over the custom table function.
query II
SELECT count(*), sum(value) FROM cdb.dbo.cf_range(5);
----
5	15

# Discovered as a table function — again with no backing SQL Server object.
query TT
SELECT name, kind FROM mssql_net_functions('cdb') WHERE name = 'cf_range';
----
cf_range	table

statement ok
DETACH cdb;
