# name: test/verify_delta_catalog_native_write.test
# description: The Delta catalog `native_write true` path — INSERT / CTAS / append data files are produced by
#              DuckDB's OWN native parquet writer (COPY … TO … FORMAT parquet) instead of engineered-wood's
#              codec, while engineered-wood keeps the _delta_log commit (docs/native-delta-write.md P1). Opt-in;
#              the default (EW-codec) path is unchanged and covered by verify_delta_catalog_write.test. The
#              native-write signature is a bloom filter on a dict-encoded column (the EW default writes none).
#              Set ARROWNET_DELTA_WRITE_DIR to a WRITABLE base path. Local FS.
# group: [mssql_net]

require mssql_net

require parquet

require-env ARROWNET_DELTA_WRITE_DIR

# ATTACH a fresh (empty) Delta catalog root with native writes on.
statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/nwcatalog' AS lake (TYPE arrownet, PROVIDER 'delta', native_write true);

# CTAS — createTable => Overwrite; DuckDB writes the parquet, EW commits the add. Decimals + dates are the
# types EW's codec historically mangled — they must round-trip exactly through DuckDB's writer.
statement ok
CREATE TABLE lake.main.t AS
SELECT i AS id, 'v' || i AS name, (i * 1.5)::DECIMAL(10,2) AS amt, DATE '2024-01-01' + i::INT AS d
FROM range(1, 6) AS r(i);

query ITTT
SELECT id, name, amt, d FROM lake.main.t ORDER BY id;
----
1	v1	1.50	2024-01-02
2	v2	3.00	2024-01-03
3	v3	4.50	2024-01-04
4	v4	6.00	2024-01-05
5	v5	7.50	2024-01-06

# INSERT appends a second native-written file (a distinct commit).
statement ok
INSERT INTO lake.main.t VALUES (99, 'x', 100.25, DATE '2030-01-01');

query IR
SELECT count(*), sum(amt) FROM lake.main.t;
----
6	122.75

# Aggregation over the two native files.
query R
SELECT sum(amt) FROM lake.main.t WHERE id < 99;
----
22.50

# ---- native-write signature: DuckDB auto-writes bloom filters on dict-encoded columns ----
# A larger, low-cardinality column (grp: 5 distinct) is dictionary-encoded → DuckDB writes a bloom filter.
# The engineered-wood default writer emits NO bloom, so has_bloom=true proves the native path ran.
statement ok
CREATE TABLE lake.main.big AS SELECT i AS id, 'cat' || (i % 5) AS grp FROM range(1, 5001) AS r(i);

query I
SELECT count(*) FROM lake.main.big;
----
5000

# grp (dict-encoded) has a bloom filter; id (all-distinct → not dict-encoded) does not.
query TI
SELECT grp_bloom, id_bloom FROM (
  SELECT
    max(CASE WHEN path_in_schema = 'grp' AND bloom_filter_offset IS NOT NULL THEN 1 ELSE 0 END) AS grp_bloom,
    max(CASE WHEN path_in_schema = 'id' AND bloom_filter_offset IS NOT NULL THEN 1 ELSE 0 END) AS id_bloom
  FROM parquet_metadata('${ARROWNET_DELTA_WRITE_DIR}/nwcatalog/big/*.parquet')
);
----
1	0

# ---- durability: detach + re-attach re-discovers the native-written tables from the _delta_log ----
statement ok
DETACH lake;

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/nwcatalog' AS lake2 (TYPE arrownet, PROVIDER 'delta');

query IR
SELECT count(*), sum(amt) FROM lake2.main.t;
----
6	122.75

query I
SELECT count(*) FROM lake2.main.big;
----
5000

statement ok
DETACH lake2;
