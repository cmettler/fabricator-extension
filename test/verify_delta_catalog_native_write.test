# name: test/verify_delta_catalog_native_write.test
# description: The Delta catalog `native_write true` path — INSERT / CTAS / append data files are produced by
#              DuckDB's OWN native parquet writer (COPY … TO … FORMAT parquet) instead of engineered-wood's
#              codec, while engineered-wood keeps the _delta_log commit (docs/native-delta-write.md P1). Opt-in;
#              the default (EW-codec) path is unchanged and covered by verify_delta_catalog_write.test. The
#              native-write signature is a bloom filter on a dict-encoded column (the EW default writes none).
#              Set ARROWNET_DELTA_WRITE_DIR to a WRITABLE base path. Local FS.
# group: [mssql_net]

require mssql_net

require parquet

require-env ARROWNET_DELTA_WRITE_DIR

# ATTACH a fresh (empty) Delta catalog root with native writes on.
statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/nwcatalog' AS lake (TYPE arrownet, PROVIDER 'delta', native_write true, deletion_vectors false);

# CTAS — createTable => Overwrite; DuckDB writes the parquet, EW commits the add. Decimals + dates are the
# types EW's codec historically mangled — they must round-trip exactly through DuckDB's writer.
statement ok
CREATE TABLE lake.main.t AS
SELECT i AS id, 'v' || i AS name, (i * 1.5)::DECIMAL(10,2) AS amt, DATE '2024-01-01' + i::INT AS d
FROM range(1, 6) AS r(i);

query ITTT
SELECT id, name, amt, d FROM lake.main.t ORDER BY id;
----
1	v1	1.50	2024-01-02
2	v2	3.00	2024-01-03
3	v3	4.50	2024-01-04
4	v4	6.00	2024-01-05
5	v5	7.50	2024-01-06

# INSERT appends a second native-written file (a distinct commit).
statement ok
INSERT INTO lake.main.t VALUES (99, 'x', 100.25, DATE '2030-01-01');

query IR
SELECT count(*), sum(amt) FROM lake.main.t;
----
6	122.75

# Aggregation over the two native files.
query R
SELECT sum(amt) FROM lake.main.t WHERE id < 99;
----
22.50

# ---- native-write signature: DuckDB auto-writes bloom filters on dict-encoded columns ----
# A larger, low-cardinality column (grp: 5 distinct) is dictionary-encoded → DuckDB writes a bloom filter.
# The engineered-wood default writer emits NO bloom, so has_bloom=true proves the native path ran.
statement ok
CREATE TABLE lake.main.big AS SELECT i AS id, 'cat' || (i % 5) AS grp FROM range(1, 5001) AS r(i);

query I
SELECT count(*) FROM lake.main.big;
----
5000

# grp (dict-encoded) has a bloom filter; id (all-distinct → not dict-encoded) does not.
query TI
SELECT grp_bloom, id_bloom FROM (
  SELECT
    max(CASE WHEN path_in_schema = 'grp' AND bloom_filter_offset IS NOT NULL THEN 1 ELSE 0 END) AS grp_bloom,
    max(CASE WHEN path_in_schema = 'id' AND bloom_filter_offset IS NOT NULL THEN 1 ELSE 0 END) AS id_bloom
  FROM parquet_metadata('${ARROWNET_DELTA_WRITE_DIR}/nwcatalog/big/*.parquet')
);
----
1	0

# ---- DELETE (copy-on-write): the survivor file is rewritten by DuckDB's native writer ----
statement ok
CREATE TABLE lake.main.d AS SELECT i AS id, (i * 1.5)::DECIMAL(10,2) AS amt FROM range(1, 11) AS r(i);

statement ok
DELETE FROM lake.main.d WHERE id % 2 = 0;

# 5 survivors (1,3,5,7,9); decimals preserved through the native rewrite.
query IR
SELECT count(*), sum(amt) FROM lake.main.d;
----
5	37.50

query I
SELECT id FROM lake.main.d ORDER BY id;
----
1
3
5
7
9

# A second DELETE composes (rewrites again, still standard parquet).
statement ok
DELETE FROM lake.main.d WHERE id = 9;

query I
SELECT count(*) FROM lake.main.d;
----
4

# ---- UPDATE (copy-on-write): the rewritten file is produced by DuckDB's native writer ----
statement ok
CREATE TABLE lake.main.u AS SELECT i AS id, (i * 1.5)::DECIMAL(10,2) AS amt, 'v' || i AS name FROM range(1, 6) AS r(i);

# Single-row update (constant + string), then an expression update over odd ids.
statement ok
UPDATE lake.main.u SET amt = amt + 100, name = 'upd' WHERE id = 3;

statement ok
UPDATE lake.main.u SET amt = amt * 2 WHERE id % 2 = 1;

query IRT
SELECT id, amt, name FROM lake.main.u ORDER BY id;
----
1	3.00	v1
2	3.00	v2
3	209.00	upd
4	6.00	v4
5	15.00	v5

# UPDATE composes with DELETE on the same native table.
statement ok
DELETE FROM lake.main.u WHERE id = 2;

query I
SELECT count(*) FROM lake.main.u;
----
4

# ---- partitioned native write: DuckDB writes one file per Hive partition subdir (the writer creates the
#      <col>=<value>/ parent dir, which a single-file COPY does not do on its own) ----
statement ok
CREATE TABLE lake.main.p PARTITIONED BY (region) AS
  SELECT * FROM (VALUES (1, 'US', 10), (2, 'US', 20), (3, 'EU', 30), (4, 'EU', 40), (5, 'APAC', 50))
  AS t(id, region, amt);

query TII
SELECT region, count(*), sum(amt) FROM lake.main.p GROUP BY region ORDER BY region;
----
APAC	1	50
EU	2	70
US	2	30

# Filter on the partition column reads only the matching partition's file.
query II
SELECT id, amt FROM lake.main.p WHERE region = 'EU' ORDER BY id;
----
3	30
4	40

# ---- durability: detach + re-attach re-discovers the native-written tables from the _delta_log ----
statement ok
DETACH lake;

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/nwcatalog' AS lake2 (TYPE arrownet, PROVIDER 'delta', deletion_vectors false);

query IR
SELECT count(*), sum(amt) FROM lake2.main.t;
----
6	122.75

query I
SELECT count(*) FROM lake2.main.big;
----
5000

query I
SELECT count(*) FROM lake2.main.d;
----
4

query TI
SELECT region, count(*) FROM lake2.main.p GROUP BY region ORDER BY region;
----
APAC	1
EU	2
US	2

statement ok
DETACH lake2;

# ---- row tracking composes with native_write (P5 append: baseRowId/defaultRowCommitVersion on the add,
#      EW-assigned; the materialized row-id column rides in physicalBatch → DuckDB's writer emits it for free) ----
statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/nwrt' AS rt (TYPE arrownet, PROVIDER 'delta', native_write true, row_tracking true);

statement ok
CREATE TABLE rt.main.t AS SELECT i AS id, 'v' || i AS name FROM range(1, 6) AS r(i);

statement ok
INSERT INTO rt.main.t VALUES (99, 'x');

query I
SELECT count(*) FROM rt.main.t;
----
6

statement ok
DETACH rt;

# Re-attach (writer-v7 rowTracking table) re-discovers + reads back — proves the native-written row-tracking
# table is a valid, standard Delta table (delta_scan/delta-kernel reads it; verified out-of-band).
statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/nwrt' AS rt2 (TYPE arrownet, PROVIDER 'delta');

query IT
SELECT id, name FROM rt2.main.t ORDER BY id;
----
1	v1
2	v2
3	v3
4	v4
5	v5
99	x

statement ok
DETACH rt2;

# ---- DV table + native_write: DELETE uses deletion vectors (no data rewrite); a subsequent UPDATE is
#      copy-on-write and the native rewriter must EXCLUDE the file's DV positions (passed as excludePositions)
#      so only live rows are rewritten. ----
statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/nwdv' AS dv (TYPE arrownet, PROVIDER 'delta', native_write true, deletion_vectors true);

statement ok
CREATE TABLE dv.main.t AS SELECT i AS id, (i * 1.0)::DECIMAL(10,2) AS amt FROM range(1, 11) AS r(i);

# DV delete rows 2,4,6 (no file rewrite — a fresh DV + remove/add).
statement ok
DELETE FROM dv.main.t WHERE id IN (2, 4, 6);

# UPDATE a live row: copy-on-write rewrite that must skip the DV-deleted physical positions.
statement ok
UPDATE dv.main.t SET amt = 999.00 WHERE id = 5;

query IR
SELECT id, amt FROM dv.main.t ORDER BY id;
----
1	1.00
3	3.00
5	999.00
7	7.00
8	8.00
9	9.00
10	10.00

query I
SELECT count(*) FROM dv.main.t;
----
7

statement ok
DETACH dv;

# ---- schema evolution + native_write: a column ADDed after a file was written is absent from that file's
#      parquet; an UPDATE that rewrites the OLD file must backfill the new column as NULL (the rewriter probes
#      the file's columns and emits a typed NULL for the missing one). ----
statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/nwse' AS se (TYPE arrownet, PROVIDER 'delta', native_write true, deletion_vectors false);

statement ok
CREATE TABLE se.main.t AS SELECT i AS id, 'v' || i AS name FROM range(1, 6) AS r(i);

statement ok
ALTER TABLE se.main.t ADD COLUMN extra INTEGER;

# UPDATE a row in the OLD file (which has no `extra` column) — the rewrite backfills extra=NULL for survivors.
statement ok
UPDATE se.main.t SET name = 'upd' WHERE id = 2;

query ITI
SELECT id, name, extra FROM se.main.t ORDER BY id;
----
1	v1	NULL
2	upd	NULL
3	v3	NULL
4	v4	NULL
5	v5	NULL

statement ok
DETACH se;
