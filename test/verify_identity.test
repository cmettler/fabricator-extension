# name: test/verify_identity.test
# description: IDENTITY columns for the SQL Server provider. DuckDB has no IDENTITY concept, so two mechanisms:
#              (1) a DuckDB GENERATED column (`col BIGINT AS (0)`) is used as an IDENTITY MARKER — the host
#              detects col.Generated(), passes the name via the ABI v53 identity_columns arg, and the provider
#              emits it as IDENTITY (box IDENTITY(1,1) / Fabric bare BIGINT IDENTITY); (2) the add_identity ATTACH
#              option / mssql_add_identity SET auto-appends a BIGINT IDENTITY surrogate key (<table>_id) to created
#              tables (CREATE + CTAS), skipped when a column is explicitly marked or the name already exists. The
#              engine assigns identity values on INSERT (the column is absent from the source, so SqlBulkCopy's
#              name-based mapping skips it). Runs on box SQL Server (IDENTITY(1,1), sequential from 1).
# group: [mssql_net]

require mssql_net

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS db (TYPE mssql_net);

statement ok
DROP TABLE IF EXISTS db.dbo.arrownet_idt1;

# --- (1) generated-column marker → IDENTITY ---
statement ok
CREATE TABLE db.dbo.arrownet_idt1 (OrderID BIGINT AS (0), CustomerID INTEGER);

statement ok
INSERT INTO db.dbo.arrownet_idt1 (CustomerID) VALUES (100),(200),(300);

# OrderID is engine-assigned (box IDENTITY(1,1) → 1,2,3 in insert order).
query II
SELECT OrderID, CustomerID FROM db.dbo.arrownet_idt1 ORDER BY CustomerID;
----
1	100
2	200
3	300

# It is a real IDENTITY column in SQL Server metadata.
query I
SELECT * FROM mssql_net_query('${MSSQL_TESTDB_DSN}',
  'SELECT COLUMNPROPERTY(OBJECT_ID(''dbo.arrownet_idt1''),''OrderID'',''IsIdentity'')');
----
1

# --- (2) add_identity via SET → auto <table>_id column ---
statement ok
SET mssql_add_identity=true;

statement ok
DROP TABLE IF EXISTS db.dbo.arrownet_idt2;

statement ok
CREATE TABLE db.dbo.arrownet_idt2 (a INTEGER, b INTEGER);

statement ok
INSERT INTO db.dbo.arrownet_idt2 (a,b) VALUES (1,2),(3,4);

# The auto column arrownet_idt2_id is present + engine-assigned.
query III
SELECT * FROM mssql_net_query('${MSSQL_TESTDB_DSN}',
  'SELECT arrownet_idt2_id, a, b FROM dbo.arrownet_idt2 ORDER BY a');
----
1	1	2
2	3	4

# --- (3) CTAS + add_identity ---
statement ok
DROP TABLE IF EXISTS db.dbo.arrownet_idt3;

statement ok
CREATE TABLE db.dbo.arrownet_idt3 AS SELECT * FROM (VALUES (10),(20),(30)) AS t(v);

query II
SELECT * FROM mssql_net_query('${MSSQL_TESTDB_DSN}',
  'SELECT arrownet_idt3_id, v FROM dbo.arrownet_idt3 ORDER BY v');
----
1	10
2	20
3	30

# --- add_identity is skipped when the target name already exists (no double column) ---
statement ok
DROP TABLE IF EXISTS db.dbo.arrownet_idt4;

statement ok
CREATE TABLE db.dbo.arrownet_idt4 (arrownet_idt4_id INTEGER, x INTEGER);

statement ok
INSERT INTO db.dbo.arrownet_idt4 (arrownet_idt4_id, x) VALUES (99, 7);

# The user's own arrownet_idt4_id is kept as a normal INT (not overwritten by an auto identity).
query II
SELECT arrownet_idt4_id, x FROM db.dbo.arrownet_idt4;
----
99	7

statement ok
SET mssql_add_identity=false;

# --- with add_identity OFF, no auto column is added (a plain table) ---
statement ok
DROP TABLE IF EXISTS db.dbo.arrownet_idt5;

statement ok
CREATE TABLE db.dbo.arrownet_idt5 (a INTEGER);

statement ok
INSERT INTO db.dbo.arrownet_idt5 VALUES (1);

# Exactly one column (no surrogate key).
query I
SELECT count(*) FROM mssql_net_query('${MSSQL_TESTDB_DSN}',
  'SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME=''arrownet_idt5''');
----
1

statement ok
DROP TABLE db.dbo.arrownet_idt1;

statement ok
DROP TABLE db.dbo.arrownet_idt2;

statement ok
DROP TABLE db.dbo.arrownet_idt3;

statement ok
DROP TABLE db.dbo.arrownet_idt4;

statement ok
DROP TABLE db.dbo.arrownet_idt5;

statement ok
DETACH db;
