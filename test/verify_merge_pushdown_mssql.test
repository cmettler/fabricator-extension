# the three agree, row for row, both ways
query T
SELECT string_agg(id || ':' || coalesce(v::VARCHAR, 'null') || ':' || s, ' ' ORDER BY id) FROM loc;
----
2:7:B 3:30:orphan 5:50:orphan 6:14:f 8:777:g 10:100:h 11:0:neg

query IIII
SELECT (SELECT count(*) FROM ((SELECT * FROM db.dbo.mgp_on) EXCEPT ALL (SELECT * FROM loc))),
       (SELECT count(*) FROM ((SELECT * FROM loc) EXCEPT ALL (SELECT * FROM db.dbo.mgp_on))),
       (SELECT count(*) FROM ((SELECT * FROM db.dbo.mgp_off) EXCEPT ALL (SELECT * FROM loc))),
       (SELECT count(*) FROM ((SELECT * FROM loc) EXCEPT ALL (SELECT * FROM db.dbo.mgp_off)));
----
0	0	0	0

# ═══ §3  Transactions: on the transaction's connection ═════════════════════════════════════════════════

statement ok
BEGIN;

query I
MERGE INTO db.dbo.mgp_tx AS t USING (SELECT 1 AS id, 99 AS v UNION ALL SELECT 3, 30) AS src ON t.id = src.id WHEN MATCHED THEN UPDATE SET v = src.v WHEN NOT MATCHED THEN INSERT VALUES (src.id, src.v, 'n') WHEN NOT MATCHED BY SOURCE THEN DELETE;
----
3

query T
SELECT string_agg(id || ':' || v, ' ' ORDER BY id) FROM db.dbo.mgp_tx;
----
1:99 3:30

statement ok
ROLLBACK;

query T
SELECT string_agg(id || ':' || v, ' ' ORDER BY id) FROM db.dbo.mgp_tx;
----
1:10 2:20

# ═══ §4  Cleanup ═══════════════════════════════════════════════════════════════════════════════════════

statement ok
SELECT fabricator_exec('db', 'DROP TABLE IF EXISTS dbo.mgp_on; DROP TABLE IF EXISTS dbo.mgp_off; DROP TABLE IF EXISTS dbo.mgp_src; DROP TABLE IF EXISTS dbo.mgp_r; DROP TABLE IF EXISTS dbo.mgp_rs; DROP TABLE IF EXISTS dbo.mgp_trg; DROP TABLE IF EXISTS dbo.mgp_id; DROP TABLE IF EXISTS dbo.mgp_isrc; DROP TABLE IF EXISTS dbo.mgp_tx;');
