query I
MERGE INTO loc AS t USING (SELECT id, v, s FROM loc_src WHERE step = 6) AS src ON t.id = src.id WHEN MATCHED THEN DO NOTHING WHEN NOT MATCHED AND src.v < 0 THEN INSERT VALUES (src.id, 0, 'neg') WHEN NOT MATCHED THEN INSERT VALUES (src.id, src.v, src.s);
