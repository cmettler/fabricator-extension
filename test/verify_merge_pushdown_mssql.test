statement ok
SET fabricator_dml_pushdown = true;

query I
MERGE INTO loc AS t USING (SELECT id, v, s FROM loc_src WHERE step = 1) AS src ON t.id = src.id WHEN MATCHED THEN UPDATE SET v = src.v, s = src.s WHEN NOT MATCHED THEN INSERT VALUES (src.id, src.v, src.s);
----
2

query I
MERGE INTO loc AS t USING (SELECT id, v, s FROM loc_src WHERE step = 2) AS src ON t.id = src.id WHEN MATCHED AND src.v > 100 THEN DELETE WHEN MATCHED AND src.v > 50 THEN UPDATE SET v = src.v WHEN MATCHED THEN UPDATE SET s = 'small';
----
3

query I
MERGE INTO loc AS t USING (SELECT id, v, s FROM loc_src WHERE step = 3) AS src ON t.id = src.id WHEN MATCHED THEN UPDATE SET v = src.v WHEN NOT MATCHED BY SOURCE AND t.v IS NULL THEN DELETE WHEN NOT MATCHED BY SOURCE THEN UPDATE SET s = 'orphan';
----
5

query I
MERGE INTO loc AS t USING (SELECT id, v, s FROM loc_src WHERE step = 4) AS src ON t.id = src.id WHEN MATCHED AND src.v > t.v THEN UPDATE SET v = src.v * 1.5 WHEN MATCHED THEN DO NOTHING WHEN NOT MATCHED AND src.v IS NOT NULL THEN INSERT (id, v, s) VALUES (src.id, src.v * 1.5, src.s);
----
2

query I
MERGE INTO loc AS t USING (SELECT id, v, s FROM loc_src WHERE step = 5) AS src ON t.s = src.s WHEN MATCHED THEN UPDATE SET v = 777;
