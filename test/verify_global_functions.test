# name: test/verify_global_functions.test
# description: Load-time GLOBAL (connection-free) functions — a bare fn(...) registered at extension load,
#              usable with NO ATTACH and no SQL Server / DAX connection. Demo: fabricator_render (the Fluid /
#              Liquid template engine). Proves the global-function path end-to-end (list_global_functions +
#              the handle-0 scalar dispatch). See docs/global-functions.md.
# group: [fabricator]

require fabricator

# NOTE: no ATTACH, no require-env — a global function resolves on a bare loaded extension.

# Basic render: Liquid substitution from a JSON params bag.
query I
SELECT fabricator_render('Hello {{ name }}, you have {{ n }} messages', '{"name":"world","n":3}');
----
Hello world, you have 3 messages

# params as a DuckDB STRUCT (type-safe, no quoting) — the SQLNULL->ANY sentinel lets the same fn accept it.
query I
SELECT fabricator_render('Hello {{ name }}, you have {{ n }} messages', {'name':'world','n':3});
----
Hello world, you have 3 messages

# STRUCT params vectorized over rows (each row's struct supplies that row's variables).
query I
SELECT fabricator_render('id={{ id }}', {'id': i}) AS r FROM range(3) t(i) ORDER BY r;
----
id=0
id=1
id=2

# Vectorized over a batch (the template is a per-row column; params empty object).
query I
SELECT fabricator_render('row ' || i::VARCHAR, '{}') AS r FROM range(3) t(i) ORDER BY i;
----
row 0
row 1
row 2

# Liquid control flow (if/else) — proves it's a real template engine, not just substitution.
query I
SELECT fabricator_render('{% if x > 1 %}big{% else %}small{% endif %}', '{"x":5}');
----
big

# Liquid loop over a JSON array param.
query I
SELECT fabricator_render('{% for i in items %}{{ i }};{% endfor %}', '{"items":[1,2,3]}');
----
1;2;3;

# A NULL template yields NULL (SPECIAL_HANDLING — the function sees NULL args).
query I
SELECT fabricator_render(NULL, '{"a":1}');
----
NULL

# An unreferenced/empty params object renders the literal text.
query I
SELECT fabricator_render('static text', '{}');
----
static text

# Still resolves AFTER an ATTACH is in play elsewhere is not needed — but confirm it composes with a normal
# query (no catalog dependency): used inside a CTE over generated rows.
query I
SELECT fabricator_render('id={{ id }}', '{"id":' || i::VARCHAR || '}') AS r FROM range(2) t(i) ORDER BY i;
----
id=0
id=1

# ---- global TABLE-IN-OUT (streaming exchange) — bare fn(<input>), no ATTACH ----
# fabricator_tag applies n -> (n, n*n) per input row on the streaming-exchange operator (handle-0 binding).
query II
SELECT n, sq FROM fabricator_tag((SELECT * FROM (VALUES (2),(3),(4)) v(n))) ORDER BY n;
----
2	4
3	9
4	16

# ---- global COLLECTOR (pipeline breaker) — bare fn(<input>), no ATTACH ----
# fabricator_collect_sum emits every input row with the GLOBAL sum (only knowable after all input is seen).
query II
SELECT n, total FROM fabricator_collect_sum((SELECT i::INTEGER AS n FROM range(5) t(i))) ORDER BY n;
----
0	10
1	10
2	10
3	10
4	10

# The collector buffers ALL input (no single-chunk cap): 5000 rows, sum(0..4999) = 12497500.
query II
SELECT count(*), max(total)
FROM fabricator_collect_sum((SELECT i::INTEGER AS n FROM range(5000) t(i)));
----
5000	12497500

# ---- global TABLE functions — bare fn(args), no ATTACH (the v29 table session at handle 0) ----
# Fixed output schema: fabricator_seq(n) -> (value, squared) for value = 1..n.
query II
SELECT value, squared FROM fabricator_seq(4) ORDER BY value;
----
1	1
2	4
3	9
4	16

# DuckDB projects + filters above the scan (the binding reports no pushdown).
query I
SELECT squared FROM fabricator_seq(5) WHERE value > 3 ORDER BY squared;
----
16
25

# MIXED positional + NAMED parameters. `start` is optional, which on a table function means a DuckDB NAMED
# parameter (positional table arguments have no defaults), and the two kinds must work TOGETHER — a global
# function's signature is built from one declared schema split on the `fabricator.named` tag.
#
# The mixed case is the one that can break silently: the host marshals EVERY declared parameter, substituting
# a typed NULL for an omitted named one, so an off-by-one there would corrupt the POSITIONAL value too (the
# rows below would start at the wrong number rather than erroring).
query II
SELECT value, squared FROM fabricator_seq(3, start := 10) ORDER BY value;
----
10	100
11	121
12	144

# Omitting it falls back to the function's own default, and the positional argument still lands correctly.
query I
SELECT min(value) FROM fabricator_seq(3);
----
1

# `=>` is the other DuckDB named-argument spelling.
query I
SELECT min(value) FROM fabricator_seq(2, start => 7);
----
7

# The named parameter is not positionally callable — it is not in the positional signature.
statement error
SELECT * FROM fabricator_seq(3, 10);
----
<REGEX>:.*

# ARG-DEPENDENT output schema: fabricator_columns(n) returns n columns c1..cn, resolved at bind from the arg.
query III
SELECT c1, c2, c3 FROM fabricator_columns(3);
----
1	2	3

# A different arg => a different column set (proves the schema is bound per-call, not fixed).
query I
SELECT c5 FROM fabricator_columns(5);
----
5

# ---- global AGGREGATE (UDAF) — bare fn(args), no ATTACH (GROUP BY / parallel / OVER) ----
# Ungrouped product: 2 * 3 * 4 = 24.
query I
SELECT fabricator_product(x) FROM (VALUES (2),(3),(4)) v(x);
----
24

# GROUP BY: per-group product.
query II
SELECT g, fabricator_product(x) FROM (VALUES (1,2),(1,5),(2,3),(2,7)) v(g,x) GROUP BY g ORDER BY g;
----
1	10
2	21

# Parallel (threads=4) cross-checked against the built-in product() — exercises multi-thread combine.
statement ok
SET threads=4;

query I
SELECT fabricator_product(i + 1) = product(i + 1)::BIGINT FROM range(12) t(i);
----
true

statement ok
RESET threads;

# Window OVER — running product 1,2,6,24 (proves the segment-tree path drives our callbacks).
query II
SELECT i, fabricator_product(i + 1) OVER (ORDER BY i ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
FROM range(4) t(i) ORDER BY i;
----
0	1
1	2
2	6
3	24

# Empty / all-NULL group => NULL (SUM-like empty value).
query I
SELECT fabricator_product(x::BIGINT) FROM (VALUES (NULL),(NULL)) v(x);
----
NULL

# ── ZERO-ARGUMENT SCALAR ─────────────────────────────────────────────────────────────────────────
# fabricator_batch_seq() takes NO arguments. This was long recorded as impossible, on the reasoning
# that "a scalar's arg batch is also how the row COUNT crosses" — which is wrong: a 0-column Arrow
# array carries its length perfectly well, and exporting one works. The real obstacle is narrower and
# purely a library limit: Apache.Arrow 23 cannot represent a zero-FIELD SCHEMA across the C interface
# in EITHER direction. The host therefore marshals one throwaway column (BuildFabricatorScalarFunction);
# the managed side reads only its declared parameters — none — and answers per ROW.
#
# Registered with a genuinely empty signature (not a one-arg function called with a default).
query II
SELECT function_name, parameters FROM duckdb_functions() WHERE function_name = 'fabricator_batch_seq';
----
fabricator_batch_seq	[]

# The load-bearing assertion: invoked ONCE PER ROW with the right count. A constant-valued zero-arg
# function would prove the count crossed (the host fills N result rows) but NOT per-row invocation, so
# this one returns the row's position and the DISTINCT count is what pins it. 5 rows => 5 distinct, 1..5.
query IIII
SELECT count(*), count(DISTINCT fabricator_batch_seq()), min(fabricator_batch_seq()), max(fabricator_batch_seq())
FROM range(5);
----
5	5	1	5

# Single row — the degenerate case (a 1-row batch with zero columns).
query I
SELECT fabricator_batch_seq();
----
1

# It is VOLATILE (the default for a declared-impure function), so it is not folded to one literal
# across rows — which is precisely what the DISTINCT assertion above would fail on.
query I
SELECT count(DISTINCT fabricator_batch_seq()) FROM range(3);
----
3

# ── DECLARED SIGNATURE of an in-out / collector ──────────────────────────────────────────────────
# The advertised signature must be the TABLE argument plus the function's DECLARED named cost args —
# and nothing else.
#
# WHY THIS IS PINNED. Making the input table a declared parameter (the unified param protocol) while
# the host still treated EVERY declared parameter as a named cost arg leaked the table-input field
# into the signature as `input := STRUCT(n INTEGER)`, next to the real TABLE argument. BOTH TIERS
# STAYED GREEN: an extra OPTIONAL named parameter breaks no existing call, so nothing executable
# changed — only what the function claims to accept. No behavioural assertion can catch that; it has
# to be read off duckdb_functions() directly.
#
# fabricator_tag / fabricator_collect_sum take NO cost args => the TABLE argument alone.
# fabricator_delta_write takes one, and it must appear as NAMED (`path := '…'`), not positional:
# before the protocol a collector's Parameters meant "named cost args" by convention, so an
# unflagged field silently became POSITIONAL and `path := '…'` stopped binding.
query III
SELECT function_name, parameters::VARCHAR, parameter_types::VARCHAR FROM duckdb_functions()
WHERE function_name IN ('fabricator_tag', 'fabricator_collect_sum', 'fabricator_delta_write')
ORDER BY function_name;
----
fabricator_collect_sum	[col0]	[TABLE]
fabricator_delta_write	[col0, path]	[TABLE, VARCHAR]
fabricator_tag	[col0]	[TABLE]

# ── MIXED SIGNATURE: table input + POSITIONAL + NAMED ────────────────────────────────────────────
# fabricator_mix(<input>, factor, bias := k) -> n * factor + bias. The arithmetic is incidental; the
# point is that all three parameter styles coexist in ONE declaration and all three ARRIVE.
#
# Positional constant args on an in-out were previously impossible BY OMISSION: the bind marshalled
# only named parameters, so DuckDB would happily accept `f((SELECT …), 3)` and the 3 would be
# dropped before reaching C#. A signature that accepts an argument the implementation never receives
# is worse than one that rejects it, and nothing in the behavioural suites could see the difference.
query II
SELECT parameters::VARCHAR, parameter_types::VARCHAR FROM duckdb_functions()
WHERE function_name = 'fabricator_mix';
----
[col0, col1, bias]	[TABLE, INTEGER, INTEGER]

# Both supplied: the POSITIONAL factor and the NAMED bias each reach the binding.
query II
SELECT n, value FROM fabricator_mix((SELECT * FROM (VALUES (1),(2),(5)) v(n)), 3, bias := 10) ORDER BY n;
----
1	13
2	16
5	25

# Named omitted => a typed NULL arrives and the author's default applies; the POSITIONAL one must be
# unaffected, which is the case that breaks if the omitted-named substitution shifts positions.
query II
SELECT n, value FROM fabricator_mix((SELECT * FROM (VALUES (1),(2)) v(n)), 3) ORDER BY n;
----
1	3
2	6
