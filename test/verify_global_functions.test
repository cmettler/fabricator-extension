# name: test/verify_global_functions.test
# description: Load-time GLOBAL (connection-free) functions — a bare fn(...) registered at extension load,
#              usable with NO ATTACH and no SQL Server / DAX connection. Proves the global-function path
#              end-to-end (list_global_functions + the handle-0 scalar dispatch). ⚠ The former headline demo,
#              fluid_render, is now a plugin — see verify_plugin_fluid.test. See docs/global-functions.md.
# group: [fabricator]

require fabricator

# NOTE: no ATTACH, no require-env — a global function resolves on a bare loaded extension.

# ⚠ THE OPENING SCALAR DEMO MOVED OUT. fluid_render (the Fluid/Liquid template engine) used to lead
# this file and was its simplest end-to-end proof of the global SCALAR path. It is now a PLUGIN
# (dotnet/Fabricator.FluidPlugin), so it is NOT registered on a bare extension and cannot be asserted here:
# the hermetic tier points FABRICATOR_PLUGIN_DIR at an empty directory on purpose. Its nine assertions moved
# verbatim to verify_plugin_fluid.test.
#
# ⚠ Nothing is uncovered by the move. The global scalar path is still gated below by FIRST-PARTY scalars —
# hilbert_index, bucket, fabricator_batch_seq (zero-argument), fabricator_va_concat (variadic) and
# fabricator_parse (bind-resolved return type) — and the one thing only render used to carry, an untyped
# NULL in an ANY-declared position, was re-homed onto the varargs tail further down rather than dropped.

# ---- global TABLE-IN-OUT (streaming exchange) — bare fn(<input>), no ATTACH ----
# fabricator_tag applies n -> (n, n*n) per input row on the streaming-exchange operator (handle-0 binding).
query II
SELECT n, sq FROM fabricator_tag((SELECT * FROM (VALUES (2),(3),(4)) v(n))) ORDER BY n;
----
2	4
3	9
4	16

# ---- global COLLECTOR (pipeline breaker) — bare fn(<input>), no ATTACH ----
# fabricator_collect_sum emits every input row with the GLOBAL sum (only knowable after all input is seen).
query II
SELECT n, total FROM fabricator_collect_sum((SELECT i::INTEGER AS n FROM range(5) t(i))) ORDER BY n;
----
0	10
1	10
2	10
3	10
4	10

# The collector buffers ALL input (no single-chunk cap): 5000 rows, sum(0..4999) = 12497500.
query II
SELECT count(*), max(total)
FROM fabricator_collect_sum((SELECT i::INTEGER AS n FROM range(5000) t(i)));
----
5000	12497500

# ---- global TABLE functions — bare fn(args), no ATTACH (the v29 table session at handle 0) ----
# Fixed output schema: fabricator_seq(n) -> (value, squared) for value = 1..n.
query II
SELECT value, squared FROM fabricator_seq(4) ORDER BY value;
----
1	1
2	4
3	9
4	16

# DuckDB projects + filters above the scan (the binding reports no pushdown).
query I
SELECT squared FROM fabricator_seq(5) WHERE value > 3 ORDER BY squared;
----
16
25

# MIXED positional + NAMED parameters. `start` is optional, which on a table function means a DuckDB NAMED
# parameter (positional table arguments have no defaults), and the two kinds must work TOGETHER — a global
# function's signature is built from one declared schema split on the `fabricator.named` tag.
#
# The mixed case is the one that can break silently: the host marshals EVERY declared parameter, substituting
# a typed NULL for an omitted named one, so an off-by-one there would corrupt the POSITIONAL value too (the
# rows below would start at the wrong number rather than erroring).
query II
SELECT value, squared FROM fabricator_seq(3, start := 10) ORDER BY value;
----
10	100
11	121
12	144

# Omitting it falls back to the function's own default, and the positional argument still lands correctly.
query I
SELECT min(value) FROM fabricator_seq(3);
----
1

# `=>` is the other DuckDB named-argument spelling.
query I
SELECT min(value) FROM fabricator_seq(2, start => 7);
----
7

# The named parameter is not positionally callable — it is not in the positional signature.
statement error
SELECT * FROM fabricator_seq(3, 10);
----
<REGEX>:.*

# ARG-DEPENDENT output schema: fabricator_columns(n) returns n columns c1..cn, resolved at bind from the arg.
query III
SELECT c1, c2, c3 FROM fabricator_columns(3);
----
1	2	3

# A different arg => a different column set (proves the schema is bound per-call, not fixed).
query I
SELECT c5 FROM fabricator_columns(5);
----
5

# ---- global AGGREGATE (UDAF) — bare fn(args), no ATTACH (GROUP BY / parallel / OVER) ----
# Ungrouped product: 2 * 3 * 4 = 24.
query I
SELECT fabricator_product(x) FROM (VALUES (2),(3),(4)) v(x);
----
24

# GROUP BY: per-group product.
query II
SELECT g, fabricator_product(x) FROM (VALUES (1,2),(1,5),(2,3),(2,7)) v(g,x) GROUP BY g ORDER BY g;
----
1	10
2	21

# Parallel (threads=4) cross-checked against the built-in product() — exercises multi-thread combine.
statement ok
SET threads=4;

query I
SELECT fabricator_product(i + 1) = product(i + 1)::BIGINT FROM range(12) t(i);
----
true

statement ok
RESET threads;

# Window OVER — running product 1,2,6,24 (proves the segment-tree path drives our callbacks).
query II
SELECT i, fabricator_product(i + 1) OVER (ORDER BY i ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
FROM range(4) t(i) ORDER BY i;
----
0	1
1	2
2	6
3	24

# Empty / all-NULL group => NULL (SUM-like empty value).
query I
SELECT fabricator_product(x::BIGINT) FROM (VALUES (NULL),(NULL)) v(x);
----
NULL

# ── ZERO-ARGUMENT SCALAR ─────────────────────────────────────────────────────────────────────────
# fabricator_batch_seq() takes NO arguments. This was long recorded as impossible, on the reasoning
# that "a scalar's arg batch is also how the row COUNT crosses" — which is wrong: a 0-column Arrow
# array carries its length perfectly well, and exporting one works. The real obstacle is narrower and
# purely a library limit: Apache.Arrow 23 cannot represent a zero-FIELD SCHEMA across the C interface
# in EITHER direction. The host therefore marshals one throwaway column (BuildFabricatorScalarFunction);
# the managed side reads only its declared parameters — none — and answers per ROW.
#
# Registered with a genuinely empty signature (not a one-arg function called with a default).
query II
SELECT function_name, parameters FROM duckdb_functions() WHERE function_name = 'fabricator_batch_seq';
----
fabricator_batch_seq	[]

# The load-bearing assertion: invoked ONCE PER ROW with the right count. A constant-valued zero-arg
# function would prove the count crossed (the host fills N result rows) but NOT per-row invocation, so
# this one returns the row's position and the DISTINCT count is what pins it. 5 rows => 5 distinct, 1..5.
query IIII
SELECT count(*), count(DISTINCT fabricator_batch_seq()), min(fabricator_batch_seq()), max(fabricator_batch_seq())
FROM range(5);
----
5	5	1	5

# Single row — the degenerate case (a 1-row batch with zero columns).
query I
SELECT fabricator_batch_seq();
----
1

# It is VOLATILE (the default for a declared-impure function), so it is not folded to one literal
# across rows — which is precisely what the DISTINCT assertion above would fail on.
query I
SELECT count(DISTINCT fabricator_batch_seq()) FROM range(3);
----
3

# ── DECLARED SIGNATURE of an in-out / collector ──────────────────────────────────────────────────
# The advertised signature must be the TABLE argument plus the function's DECLARED named cost args —
# and nothing else.
#
# WHY THIS IS PINNED. Making the input table a declared parameter (the unified param protocol) while
# the host still treated EVERY declared parameter as a named cost arg leaked the table-input field
# into the signature as `input := STRUCT(n INTEGER)`, next to the real TABLE argument. BOTH TIERS
# STAYED GREEN: an extra OPTIONAL named parameter breaks no existing call, so nothing executable
# changed — only what the function claims to accept. No behavioural assertion can catch that; it has
# to be read off duckdb_functions() directly.
#
# fabricator_tag / fabricator_collect_sum take NO cost args => the TABLE argument alone.
# fabricator_delta_write takes one, and it must appear as NAMED (`path := '…'`), not positional:
# before the protocol a collector's Parameters meant "named cost args" by convention, so an
# unflagged field silently became POSITIONAL and `path := '…'` stopped binding.
query III
SELECT function_name, parameters::VARCHAR, parameter_types::VARCHAR FROM duckdb_functions()
WHERE function_name IN ('fabricator_tag', 'fabricator_collect_sum', 'fabricator_delta_write')
ORDER BY function_name;
----
fabricator_collect_sum	[col0]	[TABLE]
fabricator_delta_write	[col0, path]	[TABLE, VARCHAR]
fabricator_tag	[col0]	[TABLE]

# ── MIXED SIGNATURE: table input + POSITIONAL + NAMED ────────────────────────────────────────────
# fabricator_mix(<input>, factor, bias := k) -> n * factor + bias. The arithmetic is incidental; the
# point is that all three parameter styles coexist in ONE declaration and all three ARRIVE.
#
# Positional constant args on an in-out were previously impossible BY OMISSION: the bind marshalled
# only named parameters, so DuckDB would happily accept `f((SELECT …), 3)` and the 3 would be
# dropped before reaching C#. A signature that accepts an argument the implementation never receives
# is worse than one that rejects it, and nothing in the behavioural suites could see the difference.
query II
SELECT parameters::VARCHAR, parameter_types::VARCHAR FROM duckdb_functions()
WHERE function_name = 'fabricator_mix';
----
[col0, col1, bias]	[TABLE, INTEGER, INTEGER]

# Both supplied: the POSITIONAL factor and the NAMED bias each reach the binding.
query II
SELECT n, value FROM fabricator_mix((SELECT * FROM (VALUES (1),(2),(5)) v(n)), 3, bias := 10) ORDER BY n;
----
1	13
2	16
5	25

# Named omitted => a typed NULL arrives and the author's default applies; the POSITIONAL one must be
# unaffected, which is the case that breaks if the omitted-named substitution shifts positions.
query II
SELECT n, value FROM fabricator_mix((SELECT * FROM (VALUES (1),(2)) v(n)), 3) ORDER BY n;
----
1	3
2	6

# ============================================================================================
# ABI v80 — A SCALAR'S RETURN TYPE RESOLVED AT BIND (docs/abi-history.md §v80)
#
# `fabricator_parse(text, type_name)` declares NO fixed return type and resolves one per CALL SITE from
# the constant `type_name`. ONE registered function, so the pair of typeof() assertions below is the whole
# feature: a build that fixes the return type at registration CANNOT make them differ, whatever it reports.
#
# ⚠ The POSITIVE CONTROL is the fixed-return assertions ABOVE (hilbert_index, bucket, fabricator_va_concat
# — fluid_render used to be named here and is now a plugin). Without them
# "two calls report two types" would pass equally on a build where the declared path had stopped working
# and everything resolved at bind — and the declared path is what every other scalar in the product uses.
# ============================================================================================

# The defining property: the same function, two constant type names, two DuckDB types.
query II
SELECT typeof(fabricator_parse('42', 'bigint')), typeof(fabricator_parse('42', 'double'));
----
BIGINT	DOUBLE

# VARCHAR too, and it must NOT be the accidental answer — see the arithmetic assertions below, which a
# string result cannot satisfy.
query I
SELECT typeof(fabricator_parse('42', 'varchar'));
----
VARCHAR

# ⚠ THE TYPE IS REAL, NOT COSMETIC. typeof() alone would pass if the value were still a string carrying a
# mislabelled type; arithmetic is what proves DuckDB got a genuine BIGINT/DOUBLE it can compute on.
query II
SELECT fabricator_parse('42', 'bigint') + 1, fabricator_parse('1.5', 'double') * 2;
----
43	3.0

# Vectorised over real rows, with the constant argument repeated in every row of the batch (which is the
# documented execute-side contract: column i always means parameter i, constant or not).
query I
SELECT sum(fabricator_parse(s, 'bigint')) FROM (VALUES ('1'),('2'),('39')) v(s);
----
42

# An unparseable value is NULL, not an error — the binding decides the TYPE, the rows decide the values.
query I
SELECT fabricator_parse('not a number', 'bigint') IS NULL;
----
true

# The type argument must be CONSTANT: the result type is part of the PLAN, so it cannot depend on row data.
# This is the ScalarBindArgs.IsConstant guard, and the error must name the constraint rather than surfacing
# as a placeholder being read as data.
statement error
SELECT fabricator_parse(s, s) FROM (VALUES ('bigint')) v(s);
----
must be a constant

# An unknown type name is refused AT BIND, naming what it got.
statement error
SELECT fabricator_parse('42', 'nosuchtype');
----
unsupported type_name

# A constant NULL type name is refused too — and this is the case that separates "the slot is constant" from
# "the slot has a usable value": IsConstant is TRUE here (an explicit NULL literal IS a folded constant), so
# the binding has to reject the value itself rather than relying on the mask.
statement error
SELECT fabricator_parse('42', NULL);
----
must not be NULL

# ⚠ AN UNTYPED NULL IN AN *ANY-DECLARED* POSITION. This was BROKEN BEFORE the bind session existed and no
# suite covered it: DuckDB exports an Arrow null-typed array with null_count = 0 and Apache.Arrow refuses it
# ("Length must equal null count"), so an ANY-declared slot handed a bare NULL failed at execute. Every other
# NULL the suites carry sits in a CONCRETELY-declared position, which DuckDB CASTS — which is exactly why the
# ANY position stayed untested. It has to work on BOTH crossings: at bind the literal is still SQLNULL
# (argument casts run after the bind callback), and at execute it still is, because an ANY parameter is never
# cast.
#
# ⚠⚠ THE CARRIER IS A VARARGS TAIL, AND THAT IS A DELIBERATE SUBSTITUTION. The original carrier was
# `fluid_render('tpl', NULL)`, whose `params` was the ONLY ANY-declared non-varargs global scalar
# parameter in the tree — and it left with the Fluid plugin. An ANY *tail* registers as the same
# LogicalType::ANY and is likewise never cast, so it crosses identically; MEASURED before the substitution
# was made, not assumed. The render spelling is still gated, in verify_plugin_fluid.test.
query I
SELECT fabricator_va_concat('-', 1, NULL, 'x');
----
1-NULL-x

# duckdb_functions() reports the UNRESOLVED declaration as ANY — the honest answer for a function whose
# return type does not exist until a call site does.
query I
SELECT return_type FROM duckdb_functions() WHERE function_name = 'fabricator_parse';
----
ANY

# ⚠ PREPARED STATEMENTS — the ParameterNotResolvedException path, which is a REQUIREMENT and not defensive.
# A parameter is untyped and unfoldable at PREPARE time, so a bind that resolves its result type from a
# constant cannot answer yet; throwing that exception is how DuckDB is told to defer. Two shapes:
#
#   (a) the VALUE is a parameter, the type name is constant => binds at PREPARE. The `+ 1` is the real
#       assertion: arithmetic only type-checks if the result really is BIGINT.
statement ok
PREPARE p80a AS SELECT fabricator_parse(?, 'bigint') + 1;

query I
EXECUTE p80a('41');
----
42

#   (b) the TYPE NAME itself is a parameter => it cannot be known at PREPARE, and is a folded constant at
#       EXECUTE. Without the deferral the parameter would arrive UNKNOWN-typed, be reported as a RUNTIME slot,
#       and the bind would refuse it as "not a constant" — a wrong answer for a value that is knowable by the
#       time it matters. `typeof` is what proves the type was resolved from the parameter's VALUE.
statement ok
PREPARE p80b AS SELECT typeof(fabricator_parse('42', ?));

query I
EXECUTE p80b('double');
----
DOUBLE

query I
EXECUTE p80b('bigint');
----
BIGINT

# ---- VARIADIC parameters (Params.VarArgs) — a scalar and a table function with a variable-arity tail ----
#
# DuckDB carries variadics as ONE type on SimpleFunction::varargs: the declared parameters are the MINIMUM
# arity and every argument past them must implicitly cast to that type. `Params.VarArgs(name[, type])`
# declares the tail; the host strips it from the signature's argument list and assigns it to `varargs`.
#
# ⚠ THE ASSERTION THAT PINS THE MECHANISM IS THE SIGNATURE, not any answer: an implementation reading its
# args batch positionally would produce the same rows for a FIXED 3-parameter declaration. Only
# duckdb_functions() distinguishes "registered as variadic" from "registered with N arguments".
query III
SELECT parameter_types, varargs, return_type
FROM duckdb_functions() WHERE function_name = 'fabricator_va_concat';
----
[VARCHAR]	ANY	VARCHAR

# The declared prefix is the MINIMUM arity: below it DuckDB refuses at bind, and its candidate rendering
# spells the tail — which is the other half of "the registration really is variadic".
statement error
SELECT fabricator_va_concat();
----
<REGEX>:.*fabricator_va_concat\(VARCHAR, \[ANY\.\.\.\]\).*

# Zero tail arguments is a legal call (the minimum is satisfied) and yields the empty join.
query I
SELECT fabricator_va_concat('|');
----
(empty)

# The tail is HETEROGENEOUS, which is the whole reason it is not a LIST parameter: a LIST forces one element
# type, and these five arguments have five. ⚠ The rendering is INVARIANT-culture on purpose (VaRender) —
# object.ToString() would format the DATE per the machine's locale and this assertion would be machine-
# dependent.
query I
SELECT fabricator_va_concat('-', 1, 'x', DATE '2020-01-01', 4.5, NULL);
----
1-x-01/01/2020 00:00:00-4.5-NULL

# Arity varies per CALL SITE, not per function: two calls in one statement, two widths.
query II
SELECT fabricator_va_concat(':', 1, 2), fabricator_va_concat(':', 1, 2, 3, 4);
----
1:2	1:2:3:4

# A tail argument may be a COLUMN — it is an ordinary argument expression, evaluated per row. (The bind-time
# constant channel is a different feature; a tail is a runtime value.)
query I
SELECT fabricator_va_concat(':', r, r * 2) FROM range(3) t(r) ORDER BY 1;
----
0:0
1:2
2:4

# TABLE functions take a tail too, and this is what proves the args batch reaches the bind WIDENED: one
# output row per tail argument, each carrying the column NAME the host generated (`<tail>_<k>`) and the
# Arrow TYPE it arrived as. int32/utf8/bool side by side is the no-cast property of an ANY tail — a
# concrete tail type would have coerced all three.
query IIII
SELECT ordinal, name, type, value FROM fabricator_va_args('demo', 42, 'hi', TRUE) ORDER BY ordinal;
----
0	arg_0	int32	42
1	arg_1	utf8	hi
2	arg_2	bool	True

# A call supplying NO tail arguments is legal — the minimum arity is the prefix alone.
query I
SELECT count(*) FROM fabricator_va_args('empty');
----
0

query III
SELECT parameter_types, varargs, function_type
FROM duckdb_functions() WHERE function_name = 'fabricator_va_args';
----
[VARCHAR, VARCHAR]	ANY	table

# ---- a VARIADIC TAIL on a TABLE-IN-OUT function: it widens the ARGS BATCH, not the input stream ----
#
# ⚠ THIS IS THE ASSERTION THE FEATURE TURNS ON, and it is about WHICH SIDE the tail lands on. An in-out's
# per-row input is its {TABLE} argument ALONE; its positional and named parameters are CONSTANTS resolved at
# bind and marshaled into the 1-row args batch the author reads in `Bind`. So the tail is bind-time data —
# the same mechanism as a scalar/table/sqlgen tail — and the input STREAM is untouched. (A LATERAL tail is
# the other mechanism entirely: there the positional slots ARE the per-row input columns, so its tail widens
# the wire. Same declaration, opposite half of the call.)
#
# The registration shows the {TABLE} slot and the constant prefix as the arguments, with the tail separate.
query TT
SELECT parameter_types, varargs FROM duckdb_functions() WHERE function_name = 'fabricator_inout_va';
----
[TABLE, VARCHAR, VARCHAR]	ANY

# No tail arguments: the minimum arity is the declared prefix (the table + `label`).
query IT
SELECT n, tag FROM fabricator_inout_va((SELECT * FROM range(2) t(n)), 'base') ORDER BY n;
----
0	base
1	base

# A HETEROGENEOUS tail reaches Bind — 7 / 'x' / TRUE keep their own types, which is the no-cast property of
# an ANY tail — while the input stream still yields both of its rows.
query IT
SELECT n, tag FROM fabricator_inout_va((SELECT * FROM range(2) t(n)), 'base', 7, 'x', TRUE) ORDER BY n;
----
0	base:7+x+True
1	base:7+x+True

# THE LOAD-BEARING ONE: three input rows in, three out. The tail changed the TAG and nothing else — if a tail
# argument had been pumped into the input stream the row count would move, which is the failure this pins.
query IT
SELECT count(*), min(tag) FROM fabricator_inout_va((SELECT * FROM range(3) t(n)), 'L', 1, 2);
----
3	L:1+2

# Arity varies per CALL SITE, not per function — two widths in one statement.
query TT
SELECT (SELECT min(tag) FROM fabricator_inout_va((SELECT 1 AS n), 'a', 9)),
       (SELECT min(tag) FROM fabricator_inout_va((SELECT 1 AS n), 'a', 9, 8, 7));
----
a:9	a:9+8+7

# Below the declared prefix DuckDB refuses at bind.
statement error
SELECT * FROM fabricator_inout_va((SELECT 1 AS n));
----
<REGEX>:.*(No function matches|Binder Error).*

# ---- a NAMED parameter AFTER the tail: legal, and the one combination the marshals had never been asked
#      for. The rule is "the tail is the last POSITIONAL parameter"; named parameters are a separate
#      namespace, so they may follow. What has to be right is the INTERLEAVING: the tail consumes every
#      remaining POSITIONAL value and the named one is matched BY NAME, not by the position it would
#      otherwise have occupied. Both marshals do this in the same loop, which is why it was worth measuring
#      rather than assuming — `positional_index` is set to the input width by the tail branch, and a named
#      lookup that depended on it would read the wrong slot or none.
#
# TABLE function: the named value reaches Bind (it is appended to `label`) and is NOT mistaken for a tail
# argument — the tail is exactly the two positional values.
query IT
SELECT ordinal, name FROM fabricator_va_args('demo', 42, 'hi', note := 'N') ORDER BY ordinal;
----
0	arg_0
1	arg_1

query T
SELECT DISTINCT label FROM fabricator_va_args('demo', 42, note := 'N');
----
demo/N

# Omitting it is the documented "omitted == explicit NULL", so the label is unchanged…
query T
SELECT DISTINCT label FROM fabricator_va_args('demo', 42);
----
demo

# …and a call with NO named argument is byte-identical to what it was before the parameter existed, which is
# the control: the tail must not have shifted.
query IIT
SELECT ordinal, name, value FROM fabricator_va_args('demo', 42, 'hi', TRUE) ORDER BY ordinal;
----
0	arg_0	42
1	arg_1	hi
2	arg_2	True

# TABLE-IN-OUT: the other marshal, same question. Tail and named together, then each alone.
query T
SELECT DISTINCT tag FROM fabricator_inout_va((SELECT * FROM range(2) t(n)), 'base', 7, 'x', note := 'N');
----
base:7+x/N

query T
SELECT DISTINCT tag FROM fabricator_inout_va((SELECT * FROM range(2) t(n)), 'base', 7, 'x');
----
base:7+x

# A named argument with NO tail arguments at all — the case where the tail branch consumes nothing and the
# named lookup must still find its value.
query T
SELECT DISTINCT tag FROM fabricator_inout_va((SELECT 1 AS n), 'base', note := 'only_named');
----
base/only_named
