# name: test/verify_delta_catalog_optimize.test
# description: Delta catalog maintenance — OPTIMIZE (bin-pack compaction) + VACUUM via
#              fabricator_exec('<catalog>', 'OPTIMIZE|VACUUM <schema.table> …'). Under DV-default, deletion
#              vectors + merge-on-read append small files accumulate, so OPTIMIZE consolidates them. CRITICAL:
#              compaction must EXCLUDE deletion-vector-deleted rows (not resurrect them). Set
#              FABRICATOR_DELTA_WRITE_DIR to a WRITABLE base path. Local FS.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optcat' AS lake (TYPE fabricator, PROVIDER 'delta', column_mapping 'none');

# Several small files (one per INSERT) — compaction candidates.
statement ok
CREATE TABLE lake.main.t AS SELECT 1 AS id, 'a' AS v;

statement ok
INSERT INTO lake.main.t VALUES (2, 'b');

statement ok
INSERT INTO lake.main.t VALUES (3, 'c');

statement ok
INSERT INTO lake.main.t VALUES (4, 'd');

# DV-delete two rows (deletion vectors are the default) — no file rewrite.
statement ok
DELETE FROM lake.main.t WHERE id IN (2, 4);

query IT
SELECT id, v FROM lake.main.t ORDER BY id;
----
1	a
3	c

# Four small data files before compaction.
query I
SELECT count(*) FROM glob('${FABRICATOR_DELTA_WRITE_DIR}/optcat/t/*.parquet');
----
4

# OPTIMIZE: bin-pack the small files, EXCLUDING the DV-deleted rows. Returns 0 (not row-affecting).
query I
SELECT fabricator_exec('lake', 'OPTIMIZE main.t');
----
0

# The DV-deleted rows must NOT be resurrected by compaction — still exactly {1,3}.
query IT
SELECT id, v FROM lake.main.t ORDER BY id;
----
1	a
3	c

# Compaction added a consolidated file (the old small files linger on disk until VACUUM).
query I
SELECT count(*) > 4 FROM glob('${FABRICATOR_DELTA_WRITE_DIR}/optcat/t/*.parquet');
----
true

# VACUUM DRY RUN reports without deleting (RETAIN 0 HOURS so the just-superseded files are eligible).
statement ok
SELECT fabricator_exec('lake', 'VACUUM main.t RETAIN 0 HOURS DRY RUN');

# Real VACUUM removes the unreferenced small files; the data is unchanged.
statement ok
SELECT fabricator_exec('lake', 'VACUUM main.t RETAIN 0 HOURS');

query IT
SELECT id, v FROM lake.main.t ORDER BY id;
----
1	a
3	c

# Durability: detach + re-attach reads the compacted (+ vacuumed) table correctly.
statement ok
DETACH lake;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optcat' AS lake2 (TYPE fabricator, PROVIDER 'delta', column_mapping 'none');

query IT
SELECT id, v FROM lake2.main.t ORDER BY id;
----
1	a
3	c

statement ok
DETACH lake2;

# ---- native_write: OPTIMIZE writes the compacted files with DuckDB's native writer (bloom/stats), not the
#      engineered-wood codec — so an OPTIMIZE keeps the native-write quality. ----
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optnw' AS nw (TYPE fabricator, PROVIDER 'delta', column_mapping 'none', native_write true);

statement ok
CREATE TABLE nw.main.t AS SELECT i AS id, 'cat' || (i % 5) AS grp FROM range(1, 1001) AS r(i);

statement ok
INSERT INTO nw.main.t SELECT i, 'cat' || (i % 5) FROM range(1001, 2001) AS r(i);

statement ok
INSERT INTO nw.main.t SELECT i, 'cat' || (i % 5) FROM range(2001, 3001) AS r(i);

# Compact the 3 files, then VACUUM the originals away so ONLY the compacted file remains.
statement ok
SELECT fabricator_exec('nw', 'OPTIMIZE main.t');

statement ok
SELECT fabricator_exec('nw', 'VACUUM main.t RETAIN 0 HOURS');

query I
SELECT count(*) FROM nw.main.t;
----
3000

# The remaining compacted file carries the DuckDB native-writer signature: a bloom filter on the dict-encoded
# `grp` (5 distinct) but NOT on the all-distinct `id`. The engineered-wood codec writes no bloom, so this proves
# the native writer produced the compacted file.
query II
SELECT
  max(CASE WHEN path_in_schema = 'grp' AND bloom_filter_offset IS NOT NULL THEN 1 ELSE 0 END) AS grp_bloom,
  max(CASE WHEN path_in_schema = 'id' AND bloom_filter_offset IS NOT NULL THEN 1 ELSE 0 END) AS id_bloom
FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optnw/t/*.parquet');
----
1	0

statement ok
DETACH nw;

# ============================================================================
# VACUUM ON A PARTITIONED TABLE — it used to reclaim NOTHING below the table root
# ============================================================================
#
# ⚠ THE BUG THIS PINS, measured: our ITableFileSystem.ListAsync globbed <root>/<prefix>* — ONE LEVEL — and
# VacuumExecutor lists the whole table ROOT to find files no version references. So VACUUM only ever
# collected orphans sitting at the root, and on a PARTITIONED table it collected nothing at all: storage
# under every `col=value/` directory grew forever. engineered-wood's own LocalTableFileSystem enumerates
# with SearchOption.AllDirectories, so recursion is the contract its consumers are written against — this
# was our implementation silently narrowing an interface, and the flat `_delta_log` (the only other caller)
# never exercised the difference.
#
# ⚠ THE ASSERTION MUST BE ON A FILE INSIDE A PARTITION DIRECTORY. A VACUUM test on an unpartitioned table
# passes with the bug fully present — the whole point is that the root was always swept correctly.
#
# ⚠ The glob is `*=a/`, not `p=a/`: column mapping is ON by default, so the partition directory is named
# with the PHYSICAL column name (`col-e62009…=a`). Writing the logical name matches nothing and the section
# fails at its own positive control — which is how this was found.

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optpart' AS pv (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE pv.main.t (id BIGINT, p VARCHAR) PARTITIONED BY (p);

# Several writes into ONE partition ⇒ several small files inside `p=a/`, which OPTIMIZE then supersedes.
statement ok
INSERT INTO pv.main.t VALUES (1, 'a');

statement ok
INSERT INTO pv.main.t VALUES (2, 'a');

statement ok
INSERT INTO pv.main.t VALUES (3, 'a');

statement ok
SELECT fabricator_exec('pv', 'OPTIMIZE main.t');

# POSITIVE CONTROL: the compaction really did leave superseded files inside the partition directory, so a
# later "they are gone" assertion means VACUUM collected them rather than them never having existed.
query I
SELECT count(*) > 1 FROM glob('${FABRICATOR_DELTA_WRITE_DIR}/optpart/t/*=a/*.parquet');
----
true

statement ok
SELECT fabricator_exec('pv', 'VACUUM main.t RETAIN 0 HOURS');

# THE REGRESSION ASSERTION: exactly the compacted file survives inside the partition.
query I
SELECT count(*) FROM glob('${FABRICATOR_DELTA_WRITE_DIR}/optpart/t/*=a/*.parquet');
----
1

query II
SELECT id, p FROM pv.main.t ORDER BY id;
----
1	a
2	a
3	a

statement ok
DETACH pv;
