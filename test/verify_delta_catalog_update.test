# name: test/verify_delta_catalog_update.test
# description: Delta folder-as-catalog UPDATE — rowid-based copy-on-write (the transient (file,position) rowid +
#              full-table overwrite via the proven write path, so the result is plain Delta + standard-readable).
#              UPDATE SET on matched rows, single + multi-row + expression updates. Set FABRICATOR_DELTA_WRITE_DIR
#              to a WRITABLE base path. Local FS.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

# ENGINE-PARAMETERIZED: this suite runs TWICE, once per Delta engine, because its subject — write /
# transaction / update / delete semantics — must be IDENTICAL whichever engine moves the bytes.
# ${DELTA_PROVIDER} is 'delta' (DuckDB reads+writes the parquet, EW owns the log) on one leg and
# 'engineeredwooddelta' (pure EW codec) on the other; scripts/run-suites.sh drives both. ATTACHes that
# pin native_read/native_write explicitly are NOT parameterized — those sections are about the native
# path specifically and stay on it in both legs.
require-env DELTA_PROVIDER

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogupd' AS lake (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}');

statement ok
CREATE TABLE lake.main.t (id INTEGER, name VARCHAR, amt INTEGER);

statement ok
INSERT INTO lake.main.t SELECT i, 'a' || i, i * 10 FROM range(1, 6) AS r(i);

# UPDATE a single row (constant SET values).
statement ok
UPDATE lake.main.t SET name = 'X', amt = 999 WHERE id = 2;

query ITI
SELECT id, name, amt FROM lake.main.t ORDER BY id;
----
1	a1	10
2	X	999
3	a3	30
4	a4	40
5	a5	50

# UPDATE several rows with an expression referencing the existing value.
statement ok
UPDATE lake.main.t SET amt = amt + 1 WHERE id >= 4;

query ITI
SELECT id, name, amt FROM lake.main.t ORDER BY id;
----
1	a1	10
2	X	999
3	a3	30
4	a4	41
5	a5	51

# UPDATE then DELETE compose (rowids re-resolve each statement).
statement ok
DELETE FROM lake.main.t WHERE amt > 100;

query ITI
SELECT id, name, amt FROM lake.main.t ORDER BY id;
----
1	a1	10
3	a3	30
4	a4	41
5	a5	51

# Durability across re-attach.
statement ok
DETACH lake;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogupd' AS lake2 (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}');

query ITI
SELECT id, name, amt FROM lake2.main.t ORDER BY id;
----
1	a1	10
3	a3	30
4	a4	41
5	a5	51

statement ok
DETACH lake2;
