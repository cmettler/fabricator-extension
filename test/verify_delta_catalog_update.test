# name: test/verify_delta_catalog_update.test
# description: Delta folder-as-catalog UPDATE — rowid-based copy-on-write (the transient (file,position) rowid +
#              full-table overwrite via the proven write path, so the result is plain Delta + standard-readable).
#              UPDATE SET on matched rows, single + multi-row + expression updates. Set FABRICATOR_DELTA_WRITE_DIR
#              to a WRITABLE base path. Local FS.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

# ENGINE-PARAMETERIZED: this suite runs TWICE, once per Delta engine, because its subject — write /
# transaction / update / delete semantics — must be IDENTICAL whichever engine moves the bytes.
# ${DELTA_PROVIDER} is 'delta' (DuckDB reads+writes the parquet, EW owns the log) on one leg and
# 'engineeredwooddelta' (pure EW codec) on the other; scripts/run-suites.sh drives both. ATTACHes that
# pin native_read/native_write explicitly are NOT parameterized — those sections are about the native
# path specifically and stay on it in both legs.
require-env DELTA_PROVIDER

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogupd' AS lake (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}');

statement ok
CREATE TABLE lake.main.t (id INTEGER, name VARCHAR, amt INTEGER);

statement ok
INSERT INTO lake.main.t SELECT i, 'a' || i, i * 10 FROM range(1, 6) AS r(i);

# UPDATE a single row (constant SET values).
statement ok
UPDATE lake.main.t SET name = 'X', amt = 999 WHERE id = 2;

query ITI
SELECT id, name, amt FROM lake.main.t ORDER BY id;
----
1	a1	10
2	X	999
3	a3	30
4	a4	40
5	a5	50

# UPDATE several rows with an expression referencing the existing value.
statement ok
UPDATE lake.main.t SET amt = amt + 1 WHERE id >= 4;

query ITI
SELECT id, name, amt FROM lake.main.t ORDER BY id;
----
1	a1	10
2	X	999
3	a3	30
4	a4	41
5	a5	51

# UPDATE then DELETE compose (rowids re-resolve each statement).
statement ok
DELETE FROM lake.main.t WHERE amt > 100;

query ITI
SELECT id, name, amt FROM lake.main.t ORDER BY id;
----
1	a1	10
3	a3	30
4	a4	41
5	a5	51

# Durability across re-attach.
statement ok
DETACH lake;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogupd' AS lake2 (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}');

query ITI
SELECT id, name, amt FROM lake2.main.t ORDER BY id;
----
1	a1	10
3	a3	30
4	a4	41
5	a5	51

# ==============================================================================================
# SET <col> = DEFAULT is REFUSED — and this is a regression gate for silent data corruption, not a
# note about a missing feature. The operator reads each SET value out of the child chunk at the
# position the bound expression names; a DEFAULT contributes NO column to the binder's projection, so
# reading positions 0..n-1 instead (which is what this used to do) shifts every SET value after the
# DEFAULT by one. Measured before the fix, on the very shape below but with all-BIGINT columns: the
# statement SUCCEEDED and committed a = 5, b = <rowid> where the correct answer is a = 99, b = 5.
# Where the shifted types happen to differ it was an INTERNAL error that fatally invalidated the
# database instead. Either way nothing said the update was wrong.
statement ok
CREATE TABLE lake2.main.defcol (a BIGINT DEFAULT 99, b BIGINT, c INTEGER);

statement ok
INSERT INTO lake2.main.defcol VALUES (1, 2, 3);

statement error
UPDATE lake2.main.defcol SET a = DEFAULT, b = 5;
----
SET a = DEFAULT is not supported

# The refused statement changed nothing.
query III
SELECT a, b, c FROM lake2.main.defcol;
----
1	2	3

# An ordinary multi-column UPDATE on the same table still works — this is the positive control that
# says the check above rejects the DEFAULT specifically and not every multi-assignment update.
statement ok
UPDATE lake2.main.defcol SET a = 99, b = 5;

query III
SELECT a, b, c FROM lake2.main.defcol;
----
99	5	3

statement ok
DETACH lake2;

# ---- A ROWID MATCHED MORE THAN ONCE: the UPDATE seam DEDUPLICATES, last write wins ----
# `UPDATE … FROM src` whose join matches one target row several times sends that row's rowid down the
# seam once per match. The seam keeps ONE value per rowid — which is why the rows are not duplicated and
# why the reported count is the number of distinct rows, not of matches.
# ⚠ This had NO coverage, and it is precisely what the Arrow-native parse had to preserve: the old shape
# deduplicated implicitly through a dictionary assignment, the new one appends every match and compacts to
# each rowid's LAST ordinal. Break that and the failure is either a DUPLICATED ROW or a lost update, both
# silent.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/updup' AS lake3 (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}');

statement ok
CREATE TABLE lake3.main.t AS SELECT i AS id, 0 AS a FROM range(1, 4) AS r(i);

statement ok
CREATE TEMP TABLE src (id BIGINT, v BIGINT);

# id 1 and id 3 match TWICE, id 2 once.
statement ok
INSERT INTO src VALUES (1, 10), (1, 20), (2, 30), (3, 40), (3, 50);

statement ok
UPDATE lake3.main.t SET a = src.v FROM src WHERE lake3.main.t.id = src.id;

# THE LOAD-BEARING ASSERTION: still three rows, one per id. A seam that stopped deduplicating would
# produce five, or five post-images against three deleted rows.
query II
SELECT count(*), count(DISTINCT id) FROM lake3.main.t;
----
3	3

# Each row took ONE of the values offered for its id — asserted as membership rather than as a specific
# value, because which match arrives last is the join's business and not a guarantee we should pin.
query I
SELECT count(*) FROM lake3.main.t
WHERE (id = 1 AND a IN (10, 20)) OR (id = 2 AND a = 30) OR (id = 3 AND a IN (40, 50));
----
3

# And no row kept its pre-update value: every matched row was actually written.
query I
SELECT count(*) FROM lake3.main.t WHERE a = 0;
----
0

statement ok
DROP TABLE src;

statement ok
DETACH lake3;
