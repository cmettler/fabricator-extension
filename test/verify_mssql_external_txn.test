# name: test/verify_mssql_external_txn.test
# description: INSERT and DELETE on a SQL Server EXTERNAL TABLE over Delta on S3 inside an explicit DuckDB
#              transaction. An INSERT writes its data files at statement time and a DELETE buffers its rows; the
#              Delta commit waits for COMMIT (one per table, the deletes staged copy-on-write so the table keeps
#              no deletion vector), and a ROLLBACK discards everything. Before, both were refused ("autocommit
#              only").
#
#              ⚠ What it does NOT give: SQL Server reads committed storage, so the transaction's own writes are
#              invisible through the external table until COMMIT (§1, §4 pin that). For the same reason a DELETE
#              whose rows come from SQL Server's read (an identity-keyed one) is refused once the transaction has
#              written to that table (§5). Still refused: deleting a row inserted in the same transaction (no
#              deletion vectors), an UPDATE (every external UPDATE is identity-keyed, and the Delta layer does not
#              buffer an UPDATE on an identity table), and an INSERT into a parquet external table (a file is
#              visible the moment it exists). Needs the docker SQL Server + MinIO (service tier).
# group: [fabricator]

require fabricator

require httpfs

require parquet

require-env MSSQL_TESTDB_DSN

require-env FABRICATOR_S3_ENDPOINT

require-env FABRICATOR_S3_SQL_ENDPOINT

statement ok
SET GLOBAL enable_curl_server_cert_verification = false;

statement ok
CREATE SECRET minio_s3 (TYPE s3, KEY_ID 'miniouser', SECRET 'miniosecret123',
                        ENDPOINT '${FABRICATOR_S3_ENDPOINT}', URL_STYLE 'path', REGION 'us-east-1',
                        USE_SSL true);

statement ok
ATTACH 's3://fabricator/exttxn' AS xt (TYPE fabricator, PROVIDER 'delta', READ_ONLY false,
                                       deletion_vectors false, column_mapping 'none', SECRET minio_s3);

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS sqldb (TYPE fabricator);

statement ok
SELECT fabricator_exec('sqldb',
  'IF NOT EXISTS (SELECT 1 FROM sys.symmetric_keys WHERE name = ''##MS_DatabaseMasterKey##'')
     CREATE MASTER KEY ENCRYPTION BY PASSWORD = ''Arrow_Net_123!MK''');

statement ok
SELECT fabricator_exec('sqldb',
  'IF NOT EXISTS (SELECT 1 FROM sys.database_scoped_credentials WHERE name = ''s3_dc'')
     CREATE DATABASE SCOPED CREDENTIAL s3_dc WITH IDENTITY = ''S3 Access Key'',
       SECRET = ''miniouser:miniosecret123''');

statement ok
SELECT fabricator_exec('sqldb',
  'IF NOT EXISTS (SELECT 1 FROM sys.external_data_sources WHERE name = ''s3_ds'')
     CREATE EXTERNAL DATA SOURCE s3_ds WITH (LOCATION = ''s3://${FABRICATOR_S3_SQL_ENDPOINT}/'',
       CREDENTIAL = s3_dc)');

statement ok
SELECT fabricator_exec('sqldb',
  'IF NOT EXISTS (SELECT 1 FROM sys.external_file_formats WHERE name = ''DeltaFileFormat'')
     CREATE EXTERNAL FILE FORMAT DeltaFileFormat WITH (FORMAT_TYPE = DELTA)');

# ═══ §0  Two Delta tables under ONE root (one transient catalog serves both), three rows each, plus an identity
#         table for the identity-keyed DELETE (§5) ════════════════════════════════════════════════════════════

statement ok
DROP TABLE IF EXISTS xt.main.e1;

statement ok
DROP TABLE IF EXISTS xt.main.e2;

statement ok
CREATE TABLE xt.main.e1 AS SELECT i::BIGINT AS id, 'v' || i AS v FROM range(1, 4) t(i);

statement ok
CREATE TABLE xt.main.e2 AS SELECT i::BIGINT AS id, 'w' || i AS v FROM range(1, 4) t(i);

statement ok
DROP TABLE IF EXISTS xt.main.e3;

statement ok
CREATE TABLE xt.main.e3 (id BIGINT AS (0), v VARCHAR);

statement ok
INSERT INTO xt.main.e3 (v) VALUES ('z1'), ('z2'), ('z3'), ('z4');

statement ok
SELECT fabricator_exec('sqldb', 'IF OBJECT_ID(''dbo.s3_exttxn1'') IS NOT NULL DROP EXTERNAL TABLE dbo.s3_exttxn1');

statement ok
SELECT fabricator_exec('sqldb', 'IF OBJECT_ID(''dbo.s3_exttxn2'') IS NOT NULL DROP EXTERNAL TABLE dbo.s3_exttxn2');

statement ok
SELECT fabricator_exec('sqldb', 'CREATE EXTERNAL TABLE dbo.s3_exttxn1 (id BIGINT, v VARCHAR(20))
  WITH (LOCATION = ''/fabricator/exttxn/e1'', DATA_SOURCE = s3_ds, FILE_FORMAT = DeltaFileFormat)');

statement ok
SELECT fabricator_exec('sqldb', 'CREATE EXTERNAL TABLE dbo.s3_exttxn2 (id BIGINT, v VARCHAR(20))
  WITH (LOCATION = ''/fabricator/exttxn/e2'', DATA_SOURCE = s3_ds, FILE_FORMAT = DeltaFileFormat)');

statement ok
SELECT fabricator_exec('sqldb', 'IF OBJECT_ID(''dbo.s3_exttxn3'') IS NOT NULL DROP EXTERNAL TABLE dbo.s3_exttxn3');

statement ok
SELECT fabricator_exec('sqldb', 'CREATE EXTERNAL TABLE dbo.s3_exttxn3 (id BIGINT, v VARCHAR(20))
  WITH (LOCATION = ''/fabricator/exttxn/e3'', DATA_SOURCE = s3_ds, FILE_FORMAT = DeltaFileFormat)');

statement ok
SELECT fabricator_exec('sqldb', 'IF OBJECT_ID(''dbo.exttxn_side'') IS NOT NULL DROP TABLE dbo.exttxn_side;
  CREATE TABLE dbo.exttxn_side (id INT)');

statement ok
SELECT fabricator_refresh_cache('sqldb');

query I
SELECT count(*) FROM sqldb.dbo.s3_exttxn1;
----
3

# ═══ §1  COMMIT: two INSERTs into one table + one into another — each table gets ONE Delta commit ═════════

statement ok
CREATE TABLE log_before AS SELECT count(*) AS n FROM glob('s3://fabricator/exttxn/e1/_delta_log/*.json');

statement ok
BEGIN;

statement ok
INSERT INTO sqldb.dbo.s3_exttxn1 VALUES (10, 'x10'), (11, 'x11');

statement ok
INSERT INTO sqldb.dbo.s3_exttxn1 VALUES (12, 'x12');

statement ok
INSERT INTO sqldb.dbo.s3_exttxn2 VALUES (20, 'y20');

# No read-your-writes: SQL Server reads committed storage, and nothing is committed yet.
query I
SELECT count(*) FROM sqldb.dbo.s3_exttxn1;
----
3

# ...and nothing reached the Delta log either: the data files exist, the commit does not.
query I
SELECT count(*) - (SELECT n FROM log_before) FROM glob('s3://fabricator/exttxn/e1/_delta_log/*.json');
----
0

statement ok
COMMIT;

query I
SELECT count(*) FROM sqldb.dbo.s3_exttxn1;
----
6

query I
SELECT string_agg(v, ',' ORDER BY id) FROM sqldb.dbo.s3_exttxn1 WHERE id >= 10;
----
x10,x11,x12

query I
SELECT count(*) FROM sqldb.dbo.s3_exttxn2;
----
4

# ONE commit for the two INSERTs into e1 (per-statement commits would have made it two).
query I
SELECT count(*) - (SELECT n FROM log_before) FROM glob('s3://fabricator/exttxn/e1/_delta_log/*.json');
----
1

# SQL Server's own reader agrees, not only the external table.
query I
SELECT * FROM fabricator_query('sqldb',
  'SELECT COUNT(*) FROM OPENROWSET(BULK ''/fabricator/exttxn/e1'', FORMAT = ''DELTA'', DATA_SOURCE = ''s3_ds'') AS r');
----
6

# ═══ §2  ROLLBACK: nothing committed, and the data files written for the INSERT are deleted again ═══════

statement ok
CREATE TABLE files_before AS SELECT count(*) AS n FROM glob('s3://fabricator/exttxn/e1/*.parquet');

statement ok
BEGIN;

statement ok
INSERT INTO sqldb.dbo.s3_exttxn1 VALUES (30, 'x30'), (31, 'x31');

# Positive control: the INSERT really wrote a data file before the ROLLBACK, or "deleted again" proves nothing.
query I
SELECT (SELECT count(*) FROM glob('s3://fabricator/exttxn/e1/*.parquet')) > (SELECT n FROM files_before);
----
true

statement ok
ROLLBACK;

query I
SELECT count(*) FROM sqldb.dbo.s3_exttxn1;
----
6

query I
SELECT count(*) - (SELECT n FROM log_before) FROM glob('s3://fabricator/exttxn/e1/_delta_log/*.json');
----
1

query I
SELECT (SELECT count(*) FROM glob('s3://fabricator/exttxn/e1/*.parquet')) = (SELECT n FROM files_before);
----
true

# ═══ §3  With SQL Server's own changes: both roll back together; both commit (Delta first, then SQL Server) ═

statement ok
BEGIN;

statement ok
INSERT INTO sqldb.dbo.exttxn_side VALUES (1);

statement ok
INSERT INTO sqldb.dbo.s3_exttxn1 VALUES (40, 'x40');

statement ok
ROLLBACK;

query II
SELECT (SELECT count(*) FROM sqldb.dbo.exttxn_side), (SELECT count(*) FROM sqldb.dbo.s3_exttxn1);
----
0	6

statement ok
BEGIN;

statement ok
INSERT INTO sqldb.dbo.exttxn_side VALUES (1);

statement ok
INSERT INTO sqldb.dbo.s3_exttxn1 VALUES (40, 'x40');

statement ok
COMMIT;

query II
SELECT (SELECT count(*) FROM sqldb.dbo.exttxn_side), (SELECT count(*) FROM sqldb.dbo.s3_exttxn1);
----
1	7

# ═══ §4  DELETE by a predicate: buffered, deleted at COMMIT, copy-on-write ═════════════════════════════════
# e1 holds 1,2,3,10,11,12,40. Its predicates render exactly, so the DELETE reads through the transaction's Delta
# session: it sees the transaction's own writes, which SQL Server's read would not.

statement ok
CREATE TABLE log4 AS SELECT count(*) AS n FROM glob('s3://fabricator/exttxn/e1/_delta_log/*.json');

statement ok
BEGIN;

query I
DELETE FROM sqldb.dbo.s3_exttxn1 WHERE id = 40;
----
1

# No read-your-writes, and no commit yet.
query I
SELECT count(*) FROM sqldb.dbo.s3_exttxn1;
----
7

query I
SELECT count(*) - (SELECT n FROM log4) FROM glob('s3://fabricator/exttxn/e1/_delta_log/*.json');
----
0

statement ok
ROLLBACK;

query I
SELECT count(*) FROM sqldb.dbo.s3_exttxn1 WHERE id = 40;
----
1

query I
SELECT count(*) - (SELECT n FROM log4) FROM glob('s3://fabricator/exttxn/e1/_delta_log/*.json');
----
0

# An INSERT and two DELETEs on one table: ONE Delta commit at COMMIT.
statement ok
BEGIN;

statement ok
INSERT INTO sqldb.dbo.s3_exttxn1 VALUES (41, 'x41');

query I
DELETE FROM sqldb.dbo.s3_exttxn1 WHERE id = 10;
----
1

query I
DELETE FROM sqldb.dbo.s3_exttxn1 WHERE id = 11;
----
1

statement ok
COMMIT;

query T
SELECT string_agg(id::VARCHAR, ',' ORDER BY id) FROM sqldb.dbo.s3_exttxn1;
----
1,2,3,12,40,41

query I
SELECT count(*) - (SELECT n FROM log4) FROM glob('s3://fabricator/exttxn/e1/_delta_log/*.json');
----
1

# Copy-on-write: not one action carries a deletion vector, so SQL Server's Delta reader still reads the table.
query I
SELECT count(*) FROM read_text('s3://fabricator/exttxn/e1/_delta_log/*.json') WHERE content LIKE '%deletionVector%';
----
0

query I
SELECT * FROM fabricator_query('sqldb',
  'SELECT COUNT(*) FROM OPENROWSET(BULK ''/fabricator/exttxn/e1'', FORMAT = ''DELTA'', DATA_SOURCE = ''s3_ds'') AS r');
----
6

# A row inserted in the same transaction cannot be deleted: hiding it needs a deletion vector.
statement ok
BEGIN;

statement ok
INSERT INTO sqldb.dbo.s3_exttxn1 VALUES (42, 'x42');

statement error
DELETE FROM sqldb.dbo.s3_exttxn1 WHERE id = 42;
----
needs deletion vectors

statement ok
ROLLBACK;

query I
SELECT count(*) FROM sqldb.dbo.s3_exttxn1;
----
6

# ═══ §5  DELETE keyed by the identity column: allowed until the transaction has written to the table ════════
# lower() does not render exactly, so these DELETEs take the rowid path: SQL Server's scan supplies the identity
# values, and SQL Server reads the COMMITTED table.

statement ok
BEGIN;

query I
DELETE FROM sqldb.dbo.s3_exttxn3 WHERE lower(v) = 'z2';
----
1

query I
SELECT count(*) FROM sqldb.dbo.s3_exttxn3;
----
4

statement ok
ROLLBACK;

query I
SELECT count(*) FROM sqldb.dbo.s3_exttxn3;
----
4

# After an INSERT, SQL Server's scan cannot offer the new row's id, so an identity-keyed DELETE would silently
# miss it: refused.
statement ok
BEGIN;

statement ok
INSERT INTO sqldb.dbo.s3_exttxn3 (v) VALUES ('z9');

statement error
DELETE FROM sqldb.dbo.s3_exttxn3 WHERE lower(v) LIKE 'z%';
----
already wrote to it

statement ok
ROLLBACK;

query T
SELECT string_agg(v, ',' ORDER BY id) FROM sqldb.dbo.s3_exttxn3;
----
z1,z2,z3,z4

# After an identity-keyed DELETE, a predicate DELETE is fine: it reads through the session, not SQL Server.
statement ok
BEGIN;

query I
DELETE FROM sqldb.dbo.s3_exttxn3 WHERE lower(v) = 'z2';
----
1

query I
DELETE FROM sqldb.dbo.s3_exttxn3 WHERE id = 3;
----
1

statement ok
COMMIT;

query IT
SELECT id, v FROM sqldb.dbo.s3_exttxn3 ORDER BY id;
----
1	z1
4	z4

# UPDATE stays refused inside a transaction: every external UPDATE is identity-keyed, and the Delta layer does not
# buffer an UPDATE on an identity table.
statement ok
BEGIN;

statement error
UPDATE sqldb.dbo.s3_exttxn3 SET v = 'u1' WHERE id = 1;
----
identity/IcebergCompat

statement ok
ROLLBACK;

query IT
SELECT id, v FROM sqldb.dbo.s3_exttxn3 ORDER BY id;
----
1	z1
4	z4

# ═══ §6  Autocommit INSERT is unchanged: one statement, one commit ════════════════════════════════════════

statement ok
INSERT INTO sqldb.dbo.s3_exttxn1 VALUES (50, 'x50');

query I
SELECT count(*) - (SELECT n FROM log4) FROM glob('s3://fabricator/exttxn/e1/_delta_log/*.json');
----
2

query I
SELECT count(*) FROM sqldb.dbo.s3_exttxn1;
----
7

# ═══ teardown: the external tables and the side table are catalog objects on the shared TestDB ═══════════

statement ok
SELECT fabricator_exec('sqldb', 'DROP EXTERNAL TABLE dbo.s3_exttxn1');

statement ok
SELECT fabricator_exec('sqldb', 'DROP EXTERNAL TABLE dbo.s3_exttxn2');

statement ok
SELECT fabricator_exec('sqldb', 'DROP EXTERNAL TABLE dbo.s3_exttxn3');

statement ok
SELECT fabricator_exec('sqldb', 'DROP TABLE dbo.exttxn_side');
