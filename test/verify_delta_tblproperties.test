# name: test/verify_delta_tblproperties.test
# description: Generic Delta table-property functions (fabricator_delta_tblproperties / _set_tblproperties) +
#              honoring delta.isolationLevel per-table (the TABLE property overrides the catalog default).
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

# ---- Slice 1: SET / READ / UNSET round-trip (metaData commit; kernel-valid) ----

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/tp' AS lake (TYPE fabricator, PROVIDER 'delta', deletion_vectors false, column_mapping 'none');

statement ok
CREATE TABLE lake.main.t AS SELECT i AS id FROM range(3) t(i);

# a fresh plain table has no delta.* properties
query I
SELECT count(*) FROM fabricator_delta_tblproperties('lake', 'main.t');
----
0

# SET two properties -> one metaData commit; the applied rows are echoed
query TT
SELECT property, value FROM fabricator_delta_set_tblproperties('lake', 'main.t', '{"delta.isolationLevel":"Serializable","custom.owner":"cm"}') ORDER BY 1;
----
custom.owner	cm
delta.isolationLevel	Serializable

# read back
query TT
SELECT property, value FROM fabricator_delta_tblproperties('lake', 'main.t') ORDER BY 1;
----
custom.owner	cm
delta.isolationLevel	Serializable

# UNSET (null value) removes the key
statement ok
SELECT * FROM fabricator_delta_set_tblproperties('lake', 'main.t', '{"custom.owner":null}');

query T
SELECT value FROM fabricator_delta_tblproperties('lake', 'main.t') WHERE property = 'delta.isolationLevel';
----
Serializable

query I
SELECT count(*) FROM fabricator_delta_tblproperties('lake', 'main.t') WHERE property = 'custom.owner';
----
0

# feature-enabling keys are rejected (need a protocol upgrade at CREATE)
statement error
SELECT * FROM fabricator_delta_set_tblproperties('lake', 'main.t', '{"delta.enableChangeDataFeed":"true"}');
----
enables a table FEATURE

# survives re-attach (it's a real metaData commit)
statement ok
DETACH lake;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/tp' AS lake2 (TYPE fabricator, PROVIDER 'delta');

query T
SELECT value FROM fabricator_delta_tblproperties('lake2', 'main.t') WHERE property = 'delta.isolationLevel';
----
Serializable

statement ok
DETACH lake2;

# ---- Slice 2: the TABLE's delta.isolationLevel OVERRIDES the catalog default ----
# With the table property = Serializable, a concurrent blind append matching the transaction's read
# predicate is a REAL conflict — proving our writer honors the TABLE property, not the catalog-wide level.

# This slice proves the TABLE property overrides the CATALOG default, so the catalog must be the level the
# property is NOT: explicitly write_serializable (the catalog default became 'serializable' on 2026-08-01).
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/iso' AS db (TYPE fabricator, PROVIDER 'delta', isolation_level 'write_serializable');

statement ok
CREATE TABLE db.main.t AS SELECT i AS id, 'x' AS name FROM range(10) t(i);

# make the table Serializable via the generic setter (the catalog stays write_serializable default)
statement ok
SELECT * FROM fabricator_delta_set_tblproperties('db', 'main.t', '{"delta.isolationLevel":"Serializable"}');

statement ok con1
BEGIN;

# the DELETE's scan records read predicate id = 1
statement ok con1
DELETE FROM db.main.t WHERE id = 1;

# a concurrent blind append MATCHING that predicate (autocommit on the same path)
statement ok con2
INSERT INTO db.main.t VALUES (1, 'dup');

# under Serializable (the TABLE property, overriding the write_serializable catalog default) this CONFLICTS
statement error con1
COMMIT;
----
transaction conflict

# con1 rolled back; the concurrent duplicate landed
query I
SELECT count(*) FROM db.main.t WHERE id = 1;
----
2

# Now UNSET the property -> the table falls back to the catalog default (write_serializable): the same
# matching concurrent append COMMUTES (the commit rebases on top of it), no conflict.
statement ok
SELECT * FROM fabricator_delta_set_tblproperties('db', 'main.t', '{"delta.isolationLevel":null}');

statement ok con1
BEGIN;

statement ok con1
DELETE FROM db.main.t WHERE id = 3;

statement ok con2
INSERT INTO db.main.t VALUES (3, 'dup2');

# write_serializable: commutes -> COMMIT succeeds. con1's DELETE of the original id=3 applies AND con2's
# appended (3,'dup2') is kept -> exactly one id=3 row remains (the dup), proving the commit landed.
statement ok con1
COMMIT;

query I
SELECT count(*) FROM db.main.t WHERE id = 3;
----
1

statement ok
DETACH db;

# ---- CREATE never stamps delta.isolationLevel automatically (changed 2026-08-01) ----
# A CREATE used to bake the catalog's ATTACH isolation_level into the table. That conflated a per-catalog
# BEHAVIOUR knob with a durable per-table DECLARATION, and because the property WINS over any catalog
# (slice 2 above), the stamp made an attach-time choice permanent AND silently overrode a different
# catalog's explicit setting on the same table later — which is precisely the composition slice 2 and
# verify_delta_row_level_concurrency §6 depend on. Neither level stamps now; declaring a level is an
# explicit, per-table act (WITH (...) at CREATE, or fabricator_delta_set_tblproperties).
# docs/delta-transactions.md §10.6a.

# the DEFAULT catalog (serializable) stamps NOTHING
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/serc' AS sc (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE sc.main.t AS SELECT i AS id FROM range(3) t(i);

query I
SELECT count(*) FROM fabricator_delta_tblproperties('sc', 'main.t') WHERE property = 'delta.isolationLevel';
----
0

statement ok
DETACH sc;

# and NEITHER does an explicit write_serializable catalog — the ATTACH option stays a catalog behaviour
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/defc' AS dc (TYPE fabricator, PROVIDER 'delta', isolation_level 'write_serializable');

statement ok
CREATE TABLE dc.main.t AS SELECT i AS id FROM range(3) t(i);

query I
SELECT count(*) FROM fabricator_delta_tblproperties('dc', 'main.t') WHERE property = 'delta.isolationLevel';
----
0

# declaring it is EXPLICIT, and lands in commit-0 of that table (per-table, opt-in). This is the spelling
# to use when another engine must honor the weaker level: Fabric Spark REFUSES to set WriteSerializable via
# its own DDL but HONORS it when it is already on the table (both measured 2026-07-31).
statement ok
CREATE TABLE dc.main.ws WITH ("delta.isolationLevel"='WriteSerializable') AS SELECT 1 AS id;

query T
SELECT value FROM fabricator_delta_tblproperties('dc', 'main.ws') WHERE property = 'delta.isolationLevel';
----
WriteSerializable

query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/defc/ws/_delta_log/00000000000000000000.json')
WHERE content LIKE '%WriteSerializable%';
----
1

statement ok
DETACH dc;

# ---- The CATALOG DEFAULT is serializable (changed 2026-08-01) ----
# Pinned directly, because everything above now states its level EXPLICITLY — without this, a regression in
# the default would not fail any test. The shape is slice 2's, minus the property and minus the ATTACH
# option: a concurrent blind append MATCHING the transaction's read predicate must CONFLICT, which is the
# serializable behaviour. Under the old write_serializable default the same shape committed.

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/defiso' AS dflt (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE dflt.main.t AS SELECT i AS id, 'x' AS name FROM range(10) t(i);

# no property was stamped, so the level really does come from the catalog default
query I
SELECT count(*) FROM fabricator_delta_tblproperties('dflt', 'main.t') WHERE property = 'delta.isolationLevel';
----
0

statement ok con1
BEGIN;

statement ok con1
DELETE FROM dflt.main.t WHERE id = 1;

statement ok con2
INSERT INTO dflt.main.t VALUES (1, 'dup');

statement error con1
COMMIT;
----
transaction conflict

# and the looser level is still reachable per-table, overriding that default
statement ok
SELECT * FROM fabricator_delta_set_tblproperties('dflt', 'main.t', '{"delta.isolationLevel":"WriteSerializable"}');

statement ok con1
BEGIN;

statement ok con1
DELETE FROM dflt.main.t WHERE id = 3;

statement ok con2
INSERT INTO dflt.main.t VALUES (3, 'dup2');

statement ok con1
COMMIT;

statement ok
DETACH dflt;
