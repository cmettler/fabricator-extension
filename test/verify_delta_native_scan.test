# name: test/verify_delta_native_scan.test
# description: fabricator_delta_native_scan(path) — the native-read path (docs/multifile-delta.md Phase A pre-spike):
#              engineered-wood lists the EXACT active data files + schema, and DuckDB's NATIVE parquet reader reads
#              them via read_parquet run on the host engine (host_query). Must match the C# reader
#              (fabricator_delta_scan) row-for-row. Plain tables (no DV/partition). Fixture: test/fixtures/delta_simple
#              (a delta-rs-written table, 10 rows id/name/amount). Set FABRICATOR_DELTA_DIR to its absolute path.
# group: [fabricator]

require fabricator

# read_parquet must be loaded instance-wide so the host_query fresh connection sees it (the native path runs
# read_parquet on the host engine). The shell/python wheel ship parquet; the test binary links it statically
# (extension_config.cmake) and `require` loads it into the DatabaseInstance.
require parquet

require-env FABRICATOR_DELTA_DIR

# Native read returns the full table, correct rows/types (schema resolved at bind from engineered-wood).
query III
SELECT id, name, amount FROM fabricator_delta_native_scan('${FABRICATOR_DELTA_DIR}') ORDER BY id;
----
1	row_1	1.5
2	row_2	3.0
3	row_3	4.5
4	row_4	6.0
5	row_5	7.5
6	row_6	9.0
7	row_7	10.5
8	row_8	12.0
9	row_9	13.5
10	row_10	15.0

# The native path and the C# reader agree exactly (count + sum).
query II
SELECT count(*), sum(id) FROM fabricator_delta_native_scan('${FABRICATOR_DELTA_DIR}');
----
10	55

query II
SELECT count(*), sum(id) FROM fabricator_delta_scan('${FABRICATOR_DELTA_DIR}');
----
10	55

# Projection + filter are applied by DuckDB above the read_parquet scan (the binding advertises no pushdown).
query I
SELECT count(*) FROM fabricator_delta_native_scan('${FABRICATOR_DELTA_DIR}') WHERE id > 7;
----
3

query I
SELECT sum(amount) FROM fabricator_delta_native_scan('${FABRICATOR_DELTA_DIR}') WHERE name = 'row_2';
----
3.0

# ---- Deletion vectors, partitions, column mapping: it must AGREE with the other two readers ----
#
# ⚠ THIS SECTION EXISTS BECAUSE THE FUNCTION SERVED DELETED ROWS. Until 2026-08-13 it ran
# `SELECT * FROM read_parquet([<active files>])` over a file list resolved at bind, which reads a plain
# table correctly and nothing else: a deletion vector records the deletion in the LOG and leaves the parquet
# untouched. MEASURED before the fix — 10 rows, a DV delete of 3, and this returned all ten (ids 1..10,
# sum 55) while the catalog and fabricator_delta_scan both returned 7 / 49. Silent, no error.
#
# ⚠ THE FIXTURE ABOVE CANNOT CATCH THIS and that is why it did not: delta_simple is a plain table with no
# DV, so every assertion before this point passes with the bug fully present. The shapes have to be BUILT.
#
# ⚠ THE THREE-WAY COMPARISON IS THE POINT, not the literal counts: the catalog read and fabricator_delta_scan
# are independent readers of the same table, so "all three agree" cannot be satisfied by a reader that has
# simply stopped returning rows. Each section asserts the literal too, so a common-mode failure is caught.

require-env FABRICATOR_DELTA_WRITE_DIR

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/ns' AS ns (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE ns.main.dv AS SELECT i AS id, i * 10 AS v FROM range(1, 11) t(i);

statement ok
DELETE FROM ns.main.dv WHERE id <= 3;

# POSITIVE CONTROL: the delete really wrote a deletion vector rather than rewriting the file. Without this
# the section could pass for the wrong reason — a copy-on-write rewrite leaves no DV to ignore.
query I
SELECT count(*) > 0 FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/ns/dv/_delta_log/*.json')
WHERE content LIKE '%deletionVector%';
----
true

query II
SELECT count(*), sum(id) FROM ns.main.dv;
----
7	49

query II
SELECT count(*), sum(id) FROM fabricator_delta_scan('${FABRICATOR_DELTA_WRITE_DIR}/ns/dv');
----
7	49

# The regression assertion. Before the fix: 10 / 55.
query II
SELECT count(*), sum(id) FROM fabricator_delta_native_scan('${FABRICATOR_DELTA_WRITE_DIR}/ns/dv');
----
7	49

# ...and the surviving ids, so a wrong count is attributable to the deleted rows rather than to a miscount.
query I
SELECT list(id ORDER BY id) FROM fabricator_delta_native_scan('${FABRICATOR_DELTA_WRITE_DIR}/ns/dv');
----
[4, 5, 6, 7, 8, 9, 10]

# A PARTITIONED table. ⚠ This one WORKED before the fix, by accident: the spike passed no hive_partitioning
# flag, so DuckDB auto-detected the `part=a/` directory layout and reconstructed the column from the path.
# It is asserted now because the fix changes HOW the value is produced — DeltaNativeReader takes partition
# values from the log and turns hive auto-detection OFF deliberately (an `x=y` directory anywhere in a
# table's path would otherwise inject a phantom column).
statement ok
SET delta_write_options='{"partition_by":["part"]}';

statement ok
CREATE TABLE ns.main.pt AS SELECT i AS id, CASE WHEN i % 2 = 0 THEN 'a' ELSE 'b' END AS part FROM range(1, 7) t(i);

statement ok
RESET delta_write_options;

query III
SELECT count(*), count(DISTINCT part), sum(id) FROM ns.main.pt;
----
6	2	21

query III
SELECT count(*), count(DISTINCT part), sum(id) FROM fabricator_delta_native_scan('${FABRICATOR_DELTA_WRITE_DIR}/ns/pt');
----
6	2	21

# Column mapping is ON by default, so the data files store PHYSICAL names (col-<uuid>). A reader that goes
# straight to the parquet without consulting the log would surface those, or nothing.
query II
SELECT count(*), sum(v) FROM fabricator_delta_native_scan('${FABRICATOR_DELTA_WRITE_DIR}/ns/dv');
----
7	490

statement ok
DETACH ns;

# ---- Projection pushdown: the batches must match the DECLARED schema, and the rows must not change ----
#
# Both path-based readers prune columns as of 2026-08-13. The risk this section covers is NOT "too many
# columns read" (invisible from SQL, and only a performance question) but the declaration going out of step
# with what is emitted: BindingBoundTable declares the stream's schema and arrow_ingest trusts it, so a
# mismatch reads past the end of the batch — SIGSEGV, not an error message.
#
# ⚠ THE REVERSE-ORDER CASE IS THE LOAD-BEARING ONE. Wrapper and binding resolve the column list through the
# SAME ProjectionPlan, which orders by the DECLARED schema rather than by the request. Ordering by the
# request instead would agree with the declaration for almost every query — and disagree exactly when DuckDB
# asks out of schema order, which is what this asks for.

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/proj' AS pj (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE pj.main.t AS SELECT i AS id, i * 2 AS v, 'n' || i AS name FROM range(1, 6) t(i);

# A deletion vector, so every assertion below also proves the projection did not cost the DV.
statement ok
DELETE FROM pj.main.t WHERE id = 2;

# ONE column, and the narrowest kind of read there is.
query I
SELECT sum(id) FROM fabricator_delta_native_scan('${FABRICATOR_DELTA_WRITE_DIR}/proj/t');
----
13

query I
SELECT sum(v) FROM fabricator_delta_scan('${FABRICATOR_DELTA_WRITE_DIR}/proj/t');
----
26

# REVERSE of the declared order (schema is id, v, name).
query III
SELECT name, v, id FROM fabricator_delta_native_scan('${FABRICATOR_DELTA_WRITE_DIR}/proj/t') ORDER BY id LIMIT 1;
----
n1	2	1

query III
SELECT name, v, id FROM fabricator_delta_scan('${FABRICATOR_DELTA_WRITE_DIR}/proj/t') ORDER BY id LIMIT 1;
----
n1	2	1

# A middle column alone — neither first nor last, so an off-by-one in the resolver shows up as wrong VALUES
# rather than as a missing column.
query I
SELECT list(v ORDER BY v) FROM fabricator_delta_native_scan('${FABRICATOR_DELTA_WRITE_DIR}/proj/t');
----
[2, 6, 8, 10]

query I
SELECT list(v ORDER BY v) FROM fabricator_delta_scan('${FABRICATOR_DELTA_WRITE_DIR}/proj/t');
----
[2, 6, 8, 10]

# Projection AND filter together: the filter is pushed for skipping but NOT claimed, so DuckDB re-applies —
# the answer must be exact even though the reader may hand back a superset.
query II
SELECT count(*), sum(id) FROM fabricator_delta_native_scan('${FABRICATOR_DELTA_WRITE_DIR}/proj/t') WHERE id > 3;
----
2	9

query II
SELECT count(*), sum(id) FROM fabricator_delta_scan('${FABRICATOR_DELTA_WRITE_DIR}/proj/t') WHERE id > 3;
----
2	9

# SELECT * must still deliver every column, in declaration order.
query III
SELECT * FROM fabricator_delta_native_scan('${FABRICATOR_DELTA_WRITE_DIR}/proj/t') ORDER BY id;
----
1	2	n1
3	6	n3
4	8	n4
5	10	n5

statement ok
DETACH pj;
