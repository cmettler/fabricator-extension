# name: test/verify_table_inout.test
# description: A discovered TVF called with a column argument — `FROM t, db.s.tvf(t.a)` — applies it once per
#              input row: the lateral session sends each chunk of distinct argument tuples as ONE statement,
#              `(VALUES …) CROSS APPLY [s].[tvf](…)`, and the row number in VALUES says which input row each
#              output row belongs to. Until 2026-10-30 this was the `<tvf>_each(<input table>)` in-out form,
#              which is gone; a literal call (`db.s.tvf(1)`) keeps its scan with pushdown.
# group: [mssql]

require fabricator

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS iodb (TYPE fabricator);

# A 1-arg inline TVF returning rows 1..n; a 2-arg TVF (multi-column input); a TVF that errors for n=0.
statement ok
SELECT fabricator_exec('iodb', 'CREATE OR ALTER FUNCTION dbo.tf_io(@n INT) RETURNS TABLE AS RETURN (SELECT TOP (@n) CAST(ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS INT) AS m FROM sys.all_objects)');

statement ok
SELECT fabricator_exec('iodb', 'CREATE OR ALTER FUNCTION dbo.tf_kv(@id INT, @label VARCHAR(20)) RETURNS TABLE AS RETURN (SELECT @id*10 AS v, @label AS lbl)');

statement ok
SELECT fabricator_exec('iodb', 'CREATE OR ALTER FUNCTION dbo.tf_div(@n INT) RETURNS TABLE AS RETURN (SELECT 100/@n AS q)');

statement ok
SELECT fabricator_exec('iodb', 'CREATE OR ALTER FUNCTION dbo.tf_wide(@a INT, @b INT, @c INT, @d INT, @e INT, @f INT, @g INT, @h INT) RETURNS TABLE AS RETURN (SELECT @a * 10 AS v, @a + @b + @c + @d + @e + @f + @g + @h AS s)');

statement ok
SELECT fabricator_refresh_cache('iodb');

# The literal form is the scan (4c), with its pushdown; the correlated form is the lateral session.
query I
SELECT m FROM iodb.dbo.tf_io(2) ORDER BY m;
----
1
2

# The `_each` in-out form is gone.
statement error
SELECT * FROM iodb.dbo.tf_io_each((SELECT 1 AS n));
----
does not exist

# Basic: apply tf_io once per input row.
query II
SELECT v.n, f.m FROM (VALUES(1),(2),(3)) v(n), iodb.dbo.tf_io(v.n) f ORDER BY 1, 2;
----
1	1
2	1
2	2
3	1
3	2
3	3

# It goes through the batched operator, one call per chunk of input rows.
query II
EXPLAIN SELECT v.n, f.m FROM (VALUES(1),(2),(3)) v(n), iodb.dbo.tf_io(v.n) f;
----
physical_plan	<REGEX>:.*Fabricator Lateral Batched.*

# Input from a UNION ALL (parallel branches).
query II
SELECT s.n, f.m FROM (SELECT 2 AS n UNION ALL SELECT 3) s, iodb.dbo.tf_io(s.n) f ORDER BY 1, 2;
----
2	1
2	2
3	1
3	2
3	3

# Duplicate input rows: DuckDB calls the function once per DISTINCT argument and stamps every outer row.
query II
SELECT v.n, f.m FROM (VALUES(2),(2)) v(n), iodb.dbo.tf_io(v.n) f ORDER BY 1, 2;
----
2	1
2	1
2	2
2	2

# WHERE on the output (applied by DuckDB above the operator).
query II
SELECT v.n, f.m FROM (VALUES(2),(3)) v(n), iodb.dbo.tf_io(v.n) f WHERE f.m > 1 ORDER BY 1, 2;
----
2	2
3	2
3	3

# ORDER BY + LIMIT on the output.
query II
SELECT v.n, f.m FROM (VALUES(1),(2),(3)) v(n), iodb.dbo.tf_io(v.n) f ORDER BY 1, 2 LIMIT 3;
----
1	1
2	1
2	2

# Aggregate over the output.
query II
SELECT count(*), sum(f.m) FROM (VALUES(1),(2),(3)) v(n), iodb.dbo.tf_io(v.n) f;
----
6	10

# Empty input -> no output, no hang.
query I
SELECT count(*) FROM (SELECT v.n FROM (VALUES(1)) v(n) WHERE 1=0) s, iodb.dbo.tf_io(s.n) f;
----
0

# LEFT JOIN LATERAL keeps an input row the function returns nothing for (n = 0: TOP (0)).
query II
SELECT v.n, f.m FROM (VALUES(0),(1)) v(n) LEFT JOIN LATERAL iodb.dbo.tf_io(v.n) f ON true ORDER BY 1, 2;
----
0	NULL
1	1

# A NULL argument reaches the function as NULL.
query IIT
SELECT v.id, f.v, f.lbl FROM (VALUES(NULL::INT, 'n'), (3, NULL)) v(id, label), iodb.dbo.tf_kv(v.id, v.label) f ORDER BY 1 NULLS LAST;
----
3	30	NULL
NULL	NULL	n

# Two parameters, a string among them.
query ITIT
SELECT v.id, v.label, f.v, f.lbl FROM (VALUES(1,'a'),(2,'b')) v(id,label), iodb.dbo.tf_kv(v.id, v.label) f ORDER BY 1;
----
1	a	10	a
2	b	20	b

# 3000 distinct rows of two parameters, a string among them; the last column counts output rows stamped onto the wrong
# input row. A BIGINT does not narrow to the INT parameter by itself: cast it.
query IIII
SELECT count(*), sum(f.v), count(DISTINCT f.lbl), count(*) FILTER (WHERE f.v <> t.i * 10 OR f.lbl <> 'x' || (t.i % 7)::VARCHAR)
FROM range(1, 3001) t(i), iodb.dbo.tf_kv(t.i::INT, 'x' || (t.i % 7)::VARCHAR) f;
----
3000	45015000	7	0

# Eight parameters: at most 250 rows per statement. DuckDB hands over the distinct arguments in chunks of one radix
# partition each (measured ~1200 rows at 20 000, but only ~200 at 3 000, where nothing would split), so each chunk
# becomes several statements and the provenance must carry the offset of each — the last column counts output rows
# stamped onto the wrong input row.
query III
SELECT count(*), sum(f.s), count(*) FILTER (WHERE f.v <> t.i * 10) FROM range(1, 20001) t(i), iodb.dbo.tf_wide(t.i::INT, 1, 2, 3, 4, 5, 6, 7) f;
----
20000	200570000	0

# Row-by-row (the batched operator switched off) answers the same.
statement ok
SET fabricator_batched_lateral = false;

query IIII
SELECT count(*), sum(f.v), count(DISTINCT f.lbl), count(*) FILTER (WHERE f.v <> t.i * 10 OR f.lbl <> 'x' || (t.i % 7)::VARCHAR)
FROM range(1, 3001) t(i), iodb.dbo.tf_kv(t.i::INT, 'x' || (t.i % 7)::VARCHAR) f;
----
3000	45015000	7	0

statement ok
SET fabricator_batched_lateral = true;

# An error from the function surfaces as a query failure.
statement error
SELECT f.q FROM (VALUES(1),(0)) v(n), iodb.dbo.tf_div(v.n) f;
----
Divide by zero

# After the error the catalog is healthy.
query II
SELECT v.n, f.m FROM (VALUES(2)) v(n), iodb.dbo.tf_io(v.n) f ORDER BY 1, 2;
----
2	1
2	2

# ── Inside a transaction that wrote: the call reads on the transaction's own connection ──────────────────────
# A session of its own would neither see the transaction's writes nor get past their locks: under locking READ
# COMMITTED it waited 30 s for them and failed with "Execution Timeout Expired" (docs/duckdb-2.0-remote-execution.md
# §4.18 F6). Each call takes the transaction's gate, so parallel sessions share the connection, MARS or not.

statement ok
SELECT fabricator_exec('iodb', 'DROP FUNCTION IF EXISTS dbo.tf_rows; DROP TABLE IF EXISTS dbo.tf_src;
CREATE TABLE dbo.tf_src (k INT PRIMARY KEY, grp INT); INSERT INTO dbo.tf_src SELECT value, value % 50 FROM GENERATE_SERIES(1, 1000);');

statement ok
SELECT fabricator_exec('iodb', 'CREATE FUNCTION dbo.tf_rows(@g INT) RETURNS TABLE AS RETURN (SELECT k FROM dbo.tf_src WHERE grp = @g)', refresh_cache := true);

statement ok
BEGIN;

statement ok
INSERT INTO iodb.dbo.tf_src VALUES (5001, 7), (5002, 49);

query III
SELECT count(*), sum(f.k), max(f.k) FROM range(0, 50) g(i), iodb.dbo.tf_rows(g.i::INT) f;
----
1002	510503	5002

statement ok
ROLLBACK;

statement ok
SET mssql_mars = false;

statement ok
BEGIN;

statement ok
INSERT INTO iodb.dbo.tf_src VALUES (5001, 7), (5002, 49);

query III
SELECT count(*), sum(f.k), max(f.k) FROM range(0, 50) g(i), iodb.dbo.tf_rows(g.i::INT) f;
----
1002	510503	5002

statement ok
ROLLBACK;

statement ok
RESET mssql_mars;

# outside the transaction the inserted rows are gone again
query I
SELECT count(*) FROM range(0, 50) g(i), iodb.dbo.tf_rows(g.i::INT) f;
----
1000

statement ok
SELECT fabricator_exec('iodb', 'DROP FUNCTION IF EXISTS dbo.tf_rows; DROP TABLE IF EXISTS dbo.tf_src');

statement ok
SELECT fabricator_exec('iodb', 'DROP FUNCTION IF EXISTS dbo.tf_io');

statement ok
SELECT fabricator_exec('iodb', 'DROP FUNCTION IF EXISTS dbo.tf_kv');

statement ok
SELECT fabricator_exec('iodb', 'DROP FUNCTION IF EXISTS dbo.tf_div');

statement ok
SELECT fabricator_exec('iodb', 'DROP FUNCTION IF EXISTS dbo.tf_wide');

statement ok
DETACH iodb;
