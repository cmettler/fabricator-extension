# name: test/verify_delta_catalog_variant.test
# description: VARIANT columns on the Delta catalog (docs/variant-support.md). VARIANT crosses the C++<->C#
#              Arrow boundary as the fabricator.variant single-blob transport (metadata||value) via the Arrow
#              type extension registered at load; EW (clast master) models variant as the canonical
#              arrow.parquet.variant internally and converts at its host boundary (VariantTransport, selected
#              by DeltaTableOptions.VariantTransportBlob). BOTH byte paths work: the native seams (DuckDB's
#              parquet writer/reader, annotated + shredding) AND the pure EW codec — incl. codec REWRITES
#              (UPDATE / OPTIMIZE), which the fork gated. The _delta_log declares the variantType
#              reader+writer feature (reader v3 / writer v7); delta-kernel reads the result (validated).
#              Set FABRICATOR_DELTA_WRITE_DIR to a WRITABLE base path. Local FS.
# group: [fabricator]

require fabricator

require parquet

require json

require-env FABRICATOR_DELTA_WRITE_DIR

# ---- catalog with the native paths on: variant is fully supported ----
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/varcatalog' AS lake (TYPE fabricator, PROVIDER 'delta', column_mapping 'none', native_read true, native_write true);

statement ok
CREATE TABLE lake.main.vt (id INTEGER, v VARIANT);

# INSERT: object, NULL, array, string, number — the full shape range crosses the boundary.
statement ok
INSERT INTO lake.main.vt VALUES
  (1, {'a': 1, 'b': 'x'}::VARIANT),
  (2, NULL),
  (3, [1, 2, 3]::VARIANT),
  (4, 'plain text'::VARIANT),
  (5, 42::VARIANT);

# The column comes back as a real VARIANT (bind schema from the tagged transport field).
query I
SELECT DISTINCT typeof(v) FROM lake.main.vt WHERE v IS NOT NULL;
----
VARIANT

query IT
SELECT id, v::VARCHAR FROM lake.main.vt ORDER BY id;
----
1	{'a': 1, 'b': x}
2	NULL
3	[1, 2, 3]
4	plain text
5	42

# NULL semantics survive the crossing exactly (a NULL variant is a NULL row, not an empty value).
query I
SELECT id FROM lake.main.vt WHERE v IS NULL;
----
2

# variant member access works above the scan (struct-style dot access on VARIANT).
query I
SELECT (v).a::INTEGER FROM lake.main.vt WHERE id = 1;
----
1

# CTAS with a variant column (schema adopted from the SELECT).
statement ok
CREATE TABLE lake.main.vt2 AS SELECT id, v FROM lake.main.vt WHERE id IN (1, 3);

query IT
SELECT id, v::VARCHAR FROM lake.main.vt2 ORDER BY id;
----
1	{'a': 1, 'b': x}
3	[1, 2, 3]

# Appending INSERT into the existing variant table (second data file).
statement ok
INSERT INTO lake.main.vt VALUES (6, {'nested': {'deep': [1, 2]}}::VARIANT);

query T
SELECT v::VARCHAR FROM lake.main.vt WHERE id = 6;
----
{'nested': {'deep': [1, 2]}}

# ---- feature declaration: the variantType reader+writer feature rides commit 0 ----
query I
SELECT count(*) FROM fabricator_delta_snapshots('lake', 'vt');
----
3

# ---- DML: with BOTH native seams (read_parquet decodes + COPY encodes) the full DML surface works ----
statement ok
DELETE FROM lake.main.vt WHERE id = 5;

query IT
SELECT id, v::VARCHAR FROM lake.main.vt ORDER BY id;
----
1	{'a': 1, 'b': x}
2	NULL
3	[1, 2, 3]
4	plain text
6	{'nested': {'deep': [1, 2]}}

# UPDATE of a NON-variant column on a variant table: the variant column passes through the rewrite
# (merge-on-read post-image under the DV default) with its annotation intact.
statement ok
UPDATE lake.main.vt SET id = 9 WHERE id = 1;

query IT
SELECT id, v::VARCHAR FROM lake.main.vt WHERE id = 9;
----
9	{'a': 1, 'b': x}

# UPDATE of the variant VALUE itself (the SET value crosses as the transport blob and is substituted).
statement ok
UPDATE lake.main.vt SET v = {'replaced': true}::VARIANT WHERE id = 4;

query IT
SELECT id, v::VARCHAR FROM lake.main.vt WHERE id = 4;
----
4	{'replaced': true}

# UPDATE variant to NULL and back.
statement ok
UPDATE lake.main.vt SET v = NULL WHERE id = 3;

query I
SELECT count(*) FROM lake.main.vt WHERE v IS NULL;
----
2

# OPTIMIZE (compaction): the read half decodes through read_parquet, the write half through COPY —
# the annotation survives the bin-pack; deleted/updated state is preserved.
statement ok
SELECT fabricator_exec('lake', 'OPTIMIZE main.vt');

query IT
SELECT id, v::VARCHAR FROM lake.main.vt ORDER BY id;
----
2	NULL
3	NULL
4	{'replaced': true}
6	{'nested': {'deep': [1, 2]}}
9	{'a': 1, 'b': x}

# Re-attach durability: the variant table reads back on a fresh catalog handle.
statement ok
DETACH lake;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/varcatalog' AS lake2 (TYPE fabricator, PROVIDER 'delta', column_mapping 'none', native_read true, native_write true);

query IT
SELECT id, v::VARCHAR FROM lake2.main.vt ORDER BY id;
----
2	NULL
3	NULL
4	{'replaced': true}
6	{'nested': {'deep': [1, 2]}}
9	{'a': 1, 'b': x}

# ---- the codec paths handle variant now (no native-flag requirement for CREATE/INSERT/SELECT) ----
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/varplain' AS plain (TYPE fabricator, PROVIDER 'delta', column_mapping 'none');

statement ok
CREATE TABLE plain.main.vt (id INTEGER, v VARIANT);

# Cross-codec reads: the codec reader reassembles ANY spec layout — including the SHREDDED files
# DuckDB's native writer produces by default (typed_value columns merged with residual bytes via
# Apache.Arrow.Operations) — so a codec-only catalog reads the natively-written table exactly.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/varcatalog' AS codecread (TYPE fabricator, PROVIDER 'delta', column_mapping 'none');

query IT
SELECT id, v::VARCHAR FROM codecread.main.vt ORDER BY id;
----
2	NULL
3	NULL
4	{'replaced': true}
6	{'nested': {'deep': [1, 2]}}
9	{'a': 1, 'b': x}

# ---- pure codec path (no native flags): engineered-wood WRITES the annotated variant group too ----
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/varcodec' AS codecrw (TYPE fabricator, PROVIDER 'delta', column_mapping 'none');

statement ok
CREATE TABLE codecrw.main.cvt (id INTEGER, v VARIANT);

statement ok
INSERT INTO codecrw.main.cvt VALUES (1, {'a': 1}::VARIANT), (2, NULL), (3, 'txt'::VARIANT);

query ITI
SELECT id, v::VARCHAR, v IS NULL FROM codecrw.main.cvt ORDER BY id;
----
1	{'a': 1}	false
2	NULL	true
3	txt	false

# DV DELETE works on the codec path (bitmap only, no data rewrite).
statement ok
DELETE FROM codecrw.main.cvt WHERE id = 3;

query I
SELECT count(*) FROM codecrw.main.cvt;
----
2

# Codec REWRITES work too (EW master's codec is variant-native; the transport converts at its
# boundary) — the fork-era "not supported yet" gate is gone: UPDATE on the pure-codec catalog
# (merge-on-read under the DV default) carries the variant value through the rewrite.
statement ok
UPDATE codecrw.main.cvt SET id = 9 WHERE id = 1;

query IT
SELECT id, v::VARCHAR FROM codecrw.main.cvt ORDER BY id;
----
2	NULL
9	{'a': 1}

# SET of the variant VALUE itself on the codec path.
statement ok
UPDATE codecrw.main.cvt SET v = {'via': 'codec'}::VARIANT WHERE id = 9;

query T
SELECT v::VARCHAR FROM codecrw.main.cvt WHERE id = 9;
----
{'via': codec}

# ... and codec OPTIMIZE (bin-pack) preserves variant through the compaction rewrite.
statement ok
SELECT fabricator_exec('codecrw', 'OPTIMIZE main.cvt');

query IT
SELECT id, v::VARCHAR FROM codecrw.main.cvt ORDER BY id;
----
2	NULL
9	{'via': codec}

# ---- codec SHREDDING: a uniform column shreds on write (typed_value columns = the data-skipping form
# spec readers exploit); an extra field rides the residual and merges back exactly on read.
statement ok
CREATE TABLE codecrw.main.shred AS SELECT * FROM (VALUES
  (1, {'a': 10, 'b': 'x'}::VARIANT),
  (2, {'a': 20, 'b': 'y'}::VARIANT),
  (3, NULL::VARIANT),
  (4, {'a': 40, 'b': 'z', 'extra': [1, 2]}::VARIANT)) t(id, v);

query ITI
SELECT id, v::VARCHAR, v IS NULL FROM codecrw.main.shred ORDER BY id;
----
1	{'a': 10, 'b': x}	false
2	{'a': 20, 'b': y}	false
3	NULL	true
4	{'a': 40, 'b': z, 'extra': [1, 2]}	false

# The file really is shredded (typed_value columns present in the parquet).
query I
SELECT count(*) FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/varcodec/shred/*.parquet') WHERE name = 'typed_value';
----
3

# DuckDB's own variant decode (read_parquet) agrees with the codec's shredded layout.
query IT
SELECT id, v::VARCHAR FROM read_parquet('${FABRICATOR_DELTA_WRITE_DIR}/varcodec/shred/*.parquet') ORDER BY id;
----
1	{'a': 10, 'b': x}
2	{'a': 20, 'b': y}
3	NULL
4	{'a': 40, 'b': z, 'extra': [1, 2]}

# change_data_feed cannot combine with variant (CDC files are codec-written).
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/varcdf' AS cdf (TYPE fabricator, PROVIDER 'delta', column_mapping 'none', native_read true, native_write true, change_data_feed true);

statement error
CREATE TABLE cdf.main.vt (id INTEGER, v VARIANT);
----
cannot be combined with change_data_feed

# ---- column mapping (the catalog DEFAULT, id mode): variant + mapping work together ----
# The variant column gets a physical col-<guid> name + delta.columnMapping.id; the parquet stores the
# annotated variant group under the physical name WITH its field_id; RENAME COLUMN is metadata-only.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/varmapped' AS mapped (TYPE fabricator, PROVIDER 'delta', native_read true, native_write true);

statement ok
CREATE TABLE mapped.main.mv (id INTEGER, v VARIANT);

statement ok
INSERT INTO mapped.main.mv VALUES (1, {'a': 1}::VARIANT), (2, NULL), (3, [7, 8]::VARIANT);

query IT
SELECT id, v::VARCHAR FROM mapped.main.mv ORDER BY id;
----
1	{'a': 1}
2	NULL
3	[7, 8]

statement ok
ALTER TABLE mapped.main.mv RENAME COLUMN v TO payload;

query T
SELECT payload::VARCHAR FROM mapped.main.mv WHERE id = 3;
----
[7, 8]

# UPDATE of the variant value AFTER the rename (the mapped rewrite path, physical-name resolution).
statement ok
UPDATE mapped.main.mv SET payload = {'upd': 9}::VARIANT WHERE id = 1;

query T
SELECT payload::VARCHAR FROM mapped.main.mv WHERE id = 1;
----
{'upd': 9}

# ---- nested variant is rejected up front: DuckDB's parquet writer cannot write a non-root VARIANT
# ("requires a transform, but is not a root column") — a nested-variant table would be unusable.
statement error
CREATE TABLE mapped.main.sv (id INTEGER, s STRUCT(tag VARCHAR, v VARIANT));
----
TOP-LEVEL column

statement error
CREATE TABLE mapped.main.lv (id INTEGER, l VARIANT[]);
----
TOP-LEVEL column
