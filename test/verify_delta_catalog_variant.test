# name: test/verify_delta_catalog_variant.test
# description: VARIANT columns on the Delta catalog (docs/variant-support.md). VARIANT crosses the C++<->C#
#              Arrow boundary as the ew.variant_transport single-blob transport (metadata||value) via the Arrow
#              type extension registered at load; EW (clast master) models variant as the canonical
#              arrow.parquet.variant internally and converts at its host boundary (VariantTransport, selected
#              by DeltaTableOptions.VariantTransportBlob). BOTH byte paths work: the native seams (DuckDB's
#              parquet writer/reader, annotated + shredding) AND the pure EW codec — incl. codec REWRITES
#              (UPDATE / OPTIMIZE), which the fork gated. The _delta_log declares the variantType
#              reader+writer feature (reader v3 / writer v7); delta-kernel reads the result (validated).
#              Set FABRICATOR_DELTA_WRITE_DIR to a WRITABLE base path. Local FS.
# group: [fabricator]

require fabricator

require parquet

require json

require-env FABRICATOR_DELTA_WRITE_DIR

# ---- catalog with the native paths on: variant is fully supported ----
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/varcatalog' AS lake (TYPE fabricator, PROVIDER 'delta', column_mapping 'none', native_read true, native_write true);

statement ok
CREATE TABLE lake.main.vt (id INTEGER, v VARIANT);

# INSERT: object, NULL, array, string, number — the full shape range crosses the boundary.
statement ok
INSERT INTO lake.main.vt VALUES
  (1, {'a': 1, 'b': 'x'}::VARIANT),
  (2, NULL),
  (3, [1, 2, 3]::VARIANT),
  (4, 'plain text'::VARIANT),
  (5, 42::VARIANT);

# The column comes back as a real VARIANT (bind schema from the tagged transport field).
query I
SELECT DISTINCT typeof(v) FROM lake.main.vt WHERE v IS NOT NULL;
----
VARIANT

query IT
SELECT id, v::VARCHAR FROM lake.main.vt ORDER BY id;
----
1	{'a': 1, 'b': x}
2	NULL
3	[1, 2, 3]
4	plain text
5	42

# NULL semantics survive the crossing exactly (a NULL variant is a NULL row, not an empty value).
query I
SELECT id FROM lake.main.vt WHERE v IS NULL;
----
2

# variant member access works above the scan (struct-style dot access on VARIANT).
query I
SELECT (v).a::INTEGER FROM lake.main.vt WHERE id = 1;
----
1

# CTAS with a variant column (schema adopted from the SELECT).
statement ok
CREATE TABLE lake.main.vt2 AS SELECT id, v FROM lake.main.vt WHERE id IN (1, 3);

query IT
SELECT id, v::VARCHAR FROM lake.main.vt2 ORDER BY id;
----
1	{'a': 1, 'b': x}
3	[1, 2, 3]

# Appending INSERT into the existing variant table (second data file).
statement ok
INSERT INTO lake.main.vt VALUES (6, {'nested': {'deep': [1, 2]}}::VARIANT);

query T
SELECT v::VARCHAR FROM lake.main.vt WHERE id = 6;
----
{'nested': {'deep': [1, 2]}}

# ---- feature declaration: the variantType reader+writer feature rides commit 0 ----
query I
SELECT count(*) FROM lake.delta.snapshots('vt');
----
3

# ---- DML: with BOTH native seams (read_parquet decodes + COPY encodes) the full DML surface works ----
statement ok
DELETE FROM lake.main.vt WHERE id = 5;

query IT
SELECT id, v::VARCHAR FROM lake.main.vt ORDER BY id;
----
1	{'a': 1, 'b': x}
2	NULL
3	[1, 2, 3]
4	plain text
6	{'nested': {'deep': [1, 2]}}

# UPDATE of a NON-variant column on a variant table: the variant column passes through the rewrite
# (merge-on-read post-image under the DV default) with its annotation intact.
statement ok
UPDATE lake.main.vt SET id = 9 WHERE id = 1;

query IT
SELECT id, v::VARCHAR FROM lake.main.vt WHERE id = 9;
----
9	{'a': 1, 'b': x}

# UPDATE of the variant VALUE itself (the SET value crosses as the transport blob and is substituted).
statement ok
UPDATE lake.main.vt SET v = {'replaced': true}::VARIANT WHERE id = 4;

query IT
SELECT id, v::VARCHAR FROM lake.main.vt WHERE id = 4;
----
4	{'replaced': true}

# UPDATE variant to NULL and back.
statement ok
UPDATE lake.main.vt SET v = NULL WHERE id = 3;

query I
SELECT count(*) FROM lake.main.vt WHERE v IS NULL;
----
2

# OPTIMIZE (compaction): the read half decodes through read_parquet, the write half through COPY —
# the annotation survives the bin-pack; deleted/updated state is preserved.
statement ok
SELECT fabricator_exec('lake', 'OPTIMIZE main.vt');

query IT
SELECT id, v::VARCHAR FROM lake.main.vt ORDER BY id;
----
2	NULL
3	NULL
4	{'replaced': true}
6	{'nested': {'deep': [1, 2]}}
9	{'a': 1, 'b': x}

# Re-attach durability: the variant table reads back on a fresh catalog handle.
statement ok
DETACH lake;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/varcatalog' AS lake2 (TYPE fabricator, PROVIDER 'delta', column_mapping 'none', native_read true, native_write true);

query IT
SELECT id, v::VARCHAR FROM lake2.main.vt ORDER BY id;
----
2	NULL
3	NULL
4	{'replaced': true}
6	{'nested': {'deep': [1, 2]}}
9	{'a': 1, 'b': x}

# ---- the codec paths handle variant now (no native-flag requirement for CREATE/INSERT/SELECT) ----
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/varplain' AS plain (TYPE fabricator, PROVIDER 'delta', column_mapping 'none');

statement ok
CREATE TABLE plain.main.vt (id INTEGER, v VARIANT);

# Cross-codec reads: the codec reader reassembles ANY spec layout — including the SHREDDED files
# DuckDB's native writer produces by default (typed_value columns merged with residual bytes via
# Apache.Arrow.Operations) — so a codec-only catalog reads the natively-written table exactly.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/varcatalog' AS codecread (TYPE fabricator, PROVIDER 'delta', column_mapping 'none');

query IT
SELECT id, v::VARCHAR FROM codecread.main.vt ORDER BY id;
----
2	NULL
3	NULL
4	{'replaced': true}
6	{'nested': {'deep': [1, 2]}}
9	{'a': 1, 'b': x}

# ---- pure codec path (no native flags): engineered-wood WRITES the annotated variant group too ----
# PROVIDER 'engineeredwooddelta': these sections assert the EW CODEC's shredded parquet layout (typed_value
# column counts). DuckDB's writer shreds differently, so the shape assertions only mean anything here.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/varcodec' AS codecrw
  (TYPE fabricator, PROVIDER 'engineeredwooddelta', column_mapping 'none');

statement ok
CREATE TABLE codecrw.main.cvt (id INTEGER, v VARIANT);

statement ok
INSERT INTO codecrw.main.cvt VALUES (1, {'a': 1}::VARIANT), (2, NULL), (3, 'txt'::VARIANT);

query ITI
SELECT id, v::VARCHAR, v IS NULL FROM codecrw.main.cvt ORDER BY id;
----
1	{'a': 1}	false
2	NULL	true
3	txt	false

# DV DELETE works on the codec path (bitmap only, no data rewrite).
statement ok
DELETE FROM codecrw.main.cvt WHERE id = 3;

query I
SELECT count(*) FROM codecrw.main.cvt;
----
2

# Codec REWRITES work too (EW master's codec is variant-native; the transport converts at its
# boundary) — the fork-era "not supported yet" gate is gone: UPDATE on the pure-codec catalog
# (merge-on-read under the DV default) carries the variant value through the rewrite.
statement ok
UPDATE codecrw.main.cvt SET id = 9 WHERE id = 1;

query IT
SELECT id, v::VARCHAR FROM codecrw.main.cvt ORDER BY id;
----
2	NULL
9	{'a': 1}

# SET of the variant VALUE itself on the codec path.
statement ok
UPDATE codecrw.main.cvt SET v = {'via': 'codec'}::VARIANT WHERE id = 9;

query T
SELECT v::VARCHAR FROM codecrw.main.cvt WHERE id = 9;
----
{'via': codec}

# ... and codec OPTIMIZE (bin-pack) preserves variant through the compaction rewrite.
statement ok
SELECT fabricator_exec('codecrw', 'OPTIMIZE main.cvt');

query IT
SELECT id, v::VARCHAR FROM codecrw.main.cvt ORDER BY id;
----
2	NULL
9	{'via': codec}

# ---- codec SHREDDING: a uniform column shreds on write (typed_value columns = the data-skipping form
# spec readers exploit); an extra field rides the residual and merges back exactly on read.
statement ok
CREATE TABLE codecrw.main.shred AS SELECT * FROM (VALUES
  (1, {'a': 10, 'b': 'x'}::VARIANT),
  (2, {'a': 20, 'b': 'y'}::VARIANT),
  (3, NULL::VARIANT),
  (4, {'a': 40, 'b': 'z', 'extra': [1, 2]}::VARIANT)) t(id, v);

query ITI
SELECT id, v::VARCHAR, v IS NULL FROM codecrw.main.shred ORDER BY id;
----
1	{'a': 10, 'b': x}	false
2	{'a': 20, 'b': y}	false
3	NULL	true
4	{'a': 40, 'b': z, 'extra': [1, 2]}	false

# ⚠⚠ THE CODEC NO LONGER SHREDS, AND THAT IS A REAL LOSS RATHER THAN A CHANGED EXPECTATION — it is
# recorded here instead of being quietly dropped. Shredding on this path was a SIDE EFFECT of the
# ew.variant_transport blob transport: decoding the blobs produced VariantValues, and the conversion handed
# them to EW's `VariantShredding.TryShred` on the way past. DuckDB 2.0 made the transport unnecessary (it
# registers arrow.parquet.variant itself), so the canonical array now goes to EW untouched — and EW does
# NOT shred on its own: `TryShred` is public and nothing inside engineered-wood calls it.
# ⚠ Re-adding it is NOT a one-liner, measured: shredding the canonical storage array produced files that
# DuckDB's own read_parquet rejects with *"Data corruption detected, read of length_in_bytes (1) would
# exceed buffer capacity"*, while the unshredded write round-trips exactly (the rows above).
# ⚠ Since 2026-11-05 the DEFAULT engine shreds again, legally (next section); the codec still writes
# unshredded files, which a shredding table accepts too.
query I
SELECT count(*) FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/varcodec/shred/*.parquet') WHERE name = 'typed_value';
----
0

# ---- the DEFAULT ENGINE SHREDS (2026-11-05): a table CREATED with a VARIANT column enables variant shredding
# (delta.enableVariantShredding + the variantShredding reader/writer feature), so DuckDB's COPY may write its
# typed_value columns. Opt out per catalog (ATTACH variant_shredding false) or per table
# (WITH (variant_shredding = false)); every write to an opted-out table stays unshredded, since the protocol
# forbids a shredded file there. Both catalogs below run the same writes: CTAS, INSERT, UPDATE (the
# post-image), OPTIMIZE (the compaction rewrite), a partitioned INSERT and a SORTED BY table.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/varnativeshred' AS nshred
  (TYPE fabricator, PROVIDER 'delta', column_mapping 'none', native_read true, native_write true);

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/varnativeshredoff' AS nshredoff
  (TYPE fabricator, PROVIDER 'delta', column_mapping 'none', native_read true, native_write true, variant_shredding false);

foreach cat nshred nshredoff

statement ok
CREATE TABLE ${cat}.main.shrednative AS SELECT * FROM (VALUES
  (1, {'a': 10, 'b': 'x'}::VARIANT),
  (2, {'a': 20, 'b': 'y'}::VARIANT),
  (3, NULL::VARIANT),
  (4, {'a': 40, 'b': 'z', 'extra': [1, 2]}::VARIANT)) t(id, v);

statement ok
INSERT INTO ${cat}.main.shrednative VALUES (5, {'a': 50, 'b': 'w'}::VARIANT);

statement ok
UPDATE ${cat}.main.shrednative SET v = {'a': 11, 'b': 'u'}::VARIANT WHERE id = 1;

statement ok
SELECT fabricator_exec('${cat}', 'OPTIMIZE main.shrednative');

statement ok
CREATE TABLE ${cat}.main.shredpart (id INTEGER, p VARCHAR, v VARIANT) PARTITIONED BY (p);

statement ok
INSERT INTO ${cat}.main.shredpart SELECT i, CASE WHEN i % 2 = 0 THEN 'x' ELSE 'y' END, {'a': i}::VARIANT FROM range(100) r(i);

statement ok
CREATE TABLE ${cat}.main.shredsorted SORTED BY (id) AS SELECT i AS id, {'a': i}::VARIANT AS v FROM range(100) r(i);

statement ok
INSERT INTO ${cat}.main.shredsorted SELECT i, {'a': i}::VARIANT FROM range(100, 200) r(i);

# A SORTED BY table: the clustered rewrite declines a table with a variant column and bin-packs it instead
# (logged), so this compaction goes through the same COPY as above, not RunCopySql — whose option cannot be
# reached by a variant today and is a guard for the day the clustered rewrite takes one.
statement ok
SELECT fabricator_exec('${cat}', 'OPTIMIZE main.shredsorted');

query I
SELECT count(*) FROM ${cat}.delta.snapshots('main.shredsorted') WHERE operation = 'OPTIMIZE';
----
1

query ITI
SELECT id, v::VARCHAR, v IS NULL FROM ${cat}.main.shrednative ORDER BY id;
----
1	{'a': 11, 'b': u}	false
2	{'a': 20, 'b': y}	false
3	NULL	true
4	{'a': 40, 'b': z, 'extra': [1, 2]}	false
5	{'a': 50, 'b': w}	false

query II
SELECT count(*), sum(CAST(v.a AS INTEGER)) FROM ${cat}.main.shredpart;
----
100	4950

endloop

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/varnativeshredmap' AS nshredmap
  (TYPE fabricator, PROVIDER 'delta', native_read true, native_write true);

statement ok
CREATE TABLE nshredmap.main.mapped AS SELECT i AS id, {'a': i, 'b': 'x' || i}::VARIANT AS "Payload" FROM range(100) r(i);

statement ok
CREATE TABLE nshredmap.main.mappedoff WITH (variant_shredding = false) AS
  SELECT i AS id, {'a': i, 'b': 'x' || i}::VARIANT AS "Payload" FROM range(100) r(i);

query II
SELECT count(*), sum(CAST(("Payload").a AS INTEGER)) FROM nshredmap.main.mapped;
----
100	4950

# Every FILE of the default catalog's tables is shredded — the post-image, the compaction output and both
# partitions included (each count is the number of files WITHOUT a typed_value column) ...
query IIII
SELECT
  (SELECT count(*) FROM (SELECT file_name FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/varnativeshred/shrednative/*.parquet') GROUP BY 1 HAVING count(*) FILTER (WHERE name = 'typed_value') = 0)),
  (SELECT count(*) FROM (SELECT file_name FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/varnativeshred/shredsorted/*.parquet') GROUP BY 1 HAVING count(*) FILTER (WHERE name = 'typed_value') = 0)),
  (SELECT count(*) FROM (SELECT file_name FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/varnativeshred/shredpart/**/*.parquet') GROUP BY 1 HAVING count(*) FILTER (WHERE name = 'typed_value') = 0)),
  (SELECT count(*) FROM (SELECT file_name FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/varnativeshredmap/mapped/*.parquet') GROUP BY 1 HAVING count(*) FILTER (WHERE name = 'typed_value') = 0));
----
0	0	0	0

# ... and those files exist, so the zeros above are not an empty glob: CTAS, INSERT, the UPDATE post-image and
# the compaction output (OPTIMIZE leaves the removed files on disk until VACUUM).
query I
SELECT count(DISTINCT file_name) >= 4 FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/varnativeshred/shrednative/*.parquet');
----
true

# ... while no file of an opted-out table is (ATTACH option and WITH key).
query IIII
SELECT
  (SELECT count(*) FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/varnativeshredoff/shrednative/*.parquet') WHERE name = 'typed_value'),
  (SELECT count(*) FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/varnativeshredoff/shredsorted/*.parquet') WHERE name = 'typed_value'),
  (SELECT count(*) FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/varnativeshredoff/shredpart/**/*.parquet') WHERE name = 'typed_value'),
  (SELECT count(*) FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/varnativeshredmap/mappedoff/*.parquet') WHERE name = 'typed_value');
----
0	0	0	0

# The declaration: the property on a shredding table, an explicit false on an opted-out one, and nothing on a
# table without a variant column (the feature would raise the reader requirement for nothing).
statement ok
CREATE TABLE nshred.main.novariant AS SELECT 1 AS id;

query TTT
SELECT
  (SELECT value FROM nshred.delta.tblproperties('main.shrednative') WHERE property = 'delta.enableVariantShredding'),
  (SELECT value FROM nshredoff.delta.tblproperties('main.shrednative') WHERE property = 'delta.enableVariantShredding'),
  (SELECT coalesce(max(value), 'absent') FROM nshred.delta.tblproperties('main.novariant') WHERE property = 'delta.enableVariantShredding');
----
true	false	absent

# ... and the reader/writer feature in the protocol, only where the property is true.
query III
SELECT
  (SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/varnativeshred/shrednative/_delta_log/00000000000000000000.json') WHERE content LIKE '%"variantShredding"%'),
  (SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/varnativeshredoff/shrednative/_delta_log/00000000000000000000.json') WHERE content LIKE '%"variantShredding"%'),
  (SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/varnativeshred/novariant/_delta_log/00000000000000000000.json') WHERE content LIKE '%"variantShredding"%');
----
1	0	0

# The switch is a CREATE flag: an existing table cannot change it (enabling needs a protocol upgrade).
statement error
ALTER TABLE nshred.main.shrednative SET (variant_shredding = false);
----
enables a table FEATURE

statement error
SELECT * FROM nshred.delta.set_tblproperties('main.shrednative', '{"delta.enableVariantShredding": "false"}');
----
enables a table FEATURE

statement error
CREATE TABLE nshred.main.rawprop WITH ("delta.enableVariantShredding" = 'true') AS SELECT {'a': 1}::VARIANT AS v;
----
variant_shredding

# The codec engine reads the shredded default-engine files exactly (it reassembles typed_value + value).
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/varnativeshred' AS nshredcodec (TYPE fabricator, PROVIDER 'engineeredwooddelta', column_mapping 'none');

query ITI
SELECT id, v::VARCHAR, v IS NULL FROM nshredcodec.main.shrednative ORDER BY id;
----
1	{'a': 11, 'b': u}	false
2	{'a': 20, 'b': y}	false
3	NULL	true
4	{'a': 40, 'b': z, 'extra': [1, 2]}	false
5	{'a': 50, 'b': w}	false

# ⚠ A DuckDB 2.0 defect, pinned so it announces its own fix: SHREDDING lowercases the column name and then misses
# a column whose name has upper-case letters, so on an OPTED-OUT table under column_mapping 'none' such a column is
# STILL SHREDDED, which the protocol forbids there. (Under column mapping the physical name is col-<guid>,
# lower-case; on a shredding table shredding is allowed anyway.) When this row fails with false, DuckDB fixed it.
statement ok
CREATE TABLE nshredoff.main.uppername AS SELECT i AS id, {'a': i}::VARIANT AS "Payload" FROM range(100) r(i);

query I
SELECT count(*) > 0 FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/varnativeshredoff/uppername/*.parquet') WHERE name = 'typed_value';
----
true

# The control for the opted-out zeros: DuckDB shreds the same data when nothing asks it not to.
statement ok
COPY (SELECT {'a': i, 'b': 'x' || i}::VARIANT AS v FROM range(100) r(i)) TO '${FABRICATOR_DELTA_WRITE_DIR}/shred_control.parquet' (FORMAT parquet);

query I
SELECT count(*) > 0 FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/shred_control.parquet') WHERE name = 'typed_value';
----
true

# DuckDB's own variant decode (read_parquet) agrees with the codec's shredded layout.
query IT
SELECT id, v::VARCHAR FROM read_parquet('${FABRICATOR_DELTA_WRITE_DIR}/varcodec/shred/*.parquet') ORDER BY id;
----
1	{'a': 10, 'b': x}
2	{'a': 20, 'b': y}
3	NULL
4	{'a': 40, 'b': z, 'extra': [1, 2]}

# change_data_feed cannot combine with variant (CDC files are codec-written).
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/varcdf' AS cdf (TYPE fabricator, PROVIDER 'delta', column_mapping 'none', native_read true, native_write true, change_data_feed true);

statement error
CREATE TABLE cdf.main.vt (id INTEGER, v VARIANT);
----
cannot be combined with change_data_feed

# ---- column mapping (the catalog DEFAULT, id mode): variant + mapping work together ----
# The variant column gets a physical col-<guid> name + delta.columnMapping.id; the parquet stores the
# annotated variant group under the physical name WITH its field_id; RENAME COLUMN is metadata-only.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/varmapped' AS mapped (TYPE fabricator, PROVIDER 'delta', native_read true, native_write true);

statement ok
CREATE TABLE mapped.main.mv (id INTEGER, v VARIANT);

statement ok
INSERT INTO mapped.main.mv VALUES (1, {'a': 1}::VARIANT), (2, NULL), (3, [7, 8]::VARIANT);

query IT
SELECT id, v::VARCHAR FROM mapped.main.mv ORDER BY id;
----
1	{'a': 1}
2	NULL
3	[7, 8]

statement ok
ALTER TABLE mapped.main.mv RENAME COLUMN v TO payload;

query T
SELECT payload::VARCHAR FROM mapped.main.mv WHERE id = 3;
----
[7, 8]

# UPDATE of the variant value AFTER the rename (the mapped rewrite path, physical-name resolution).
statement ok
UPDATE mapped.main.mv SET payload = {'upd': 9}::VARIANT WHERE id = 1;

query T
SELECT payload::VARCHAR FROM mapped.main.mv WHERE id = 1;
----
{'upd': 9}

# ---- nested variant is rejected up front: DuckDB's parquet writer cannot write a non-root VARIANT
# ("requires a transform, but is not a root column") — a nested-variant table would be unusable.
statement error
CREATE TABLE mapped.main.sv (id INTEGER, s STRUCT(tag VARCHAR, v VARIANT));
----
TOP-LEVEL column

statement error
CREATE TABLE mapped.main.lv (id INTEGER, l VARIANT[]);
----
TOP-LEVEL column

# ---- ALTER TABLE ADD COLUMN of a VARIANT: the transport marker is what makes it a Delta `variant` ----
# Worth pinning because we get this for free and by a route that is easy to lose. The ALTER path crosses the
# new column as a single-field Arrow schema, so the ONLY thing distinguishing a variant from an ordinary blob
# is the ew.variant_transport field-metadata marker (the transport is a LEAF binary — the storage type cannot
# carry the distinction). SchemaConverter.FromArrowField checks that marker BEFORE the storage type, so the
# metadata commit records `variant`. Without the marker the column would be Delta `binary` FOREVER — a
# metadata commit is not revisable — and the failure would surface far away, as an insert that cannot convert
# VARIANT to BLOB. NOTE duckdb_columns() reports BLOB for a variant column on either path: that is the
# storage type, and the scan resolves the marker at bind, so it is not a signal about this.
# Own catalog, so the section does not depend on which earlier ones are still attached.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/varaddcat' AS addcat (TYPE fabricator, PROVIDER 'delta', column_mapping 'none', native_read true, native_write true);

statement ok
CREATE TABLE addcat.main.addv (id INTEGER);

statement ok
INSERT INTO addcat.main.addv VALUES (1);

statement ok
ALTER TABLE addcat.main.addv ADD COLUMN v VARIANT;

# The pre-existing row reads NULL for the added column (schema evolution), the new one carries a real variant.
statement ok
INSERT INTO addcat.main.addv VALUES (2, {'a': 9, 'b': 'y'}::VARIANT);

query II
SELECT id, CAST((v).a AS VARCHAR) FROM addcat.main.addv ORDER BY id;
----
1	NULL
2	9

# Typed member access proves the column is a VARIANT rather than a blob that merely round-trips: a blob
# cannot be extracted from ("Cannot extract field 'a' from expression ... not a struct, union, map, or json").
query I
SELECT CAST((v).b AS VARCHAR) FROM addcat.main.addv WHERE id = 2;
----
y

# ... and the value survives a re-ATTACH, i.e. the DELTA SCHEMA says variant — not just this session's binding.
statement ok
DETACH addcat;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/varaddcat' AS addcat2 (TYPE fabricator, PROVIDER 'delta', column_mapping 'none', native_read true, native_write true);

query I
SELECT CAST((v).a AS VARCHAR) FROM addcat2.main.addv WHERE id = 2;
----
9
