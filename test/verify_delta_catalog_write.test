# name: test/verify_delta_catalog_write.test
# description: The Delta folder-as-catalog provider WRITE path — CREATE TABLE / INSERT / CTAS / COPY stream
#              straight to engineered-wood through the host FileSystem (the streaming bulk path, like the
#              SQL/DAX backends), superseding the global fabricator_delta_write collector. createTable/replace =>
#              Overwrite, plain INSERT => Append; one Delta commit per statement. Set FABRICATOR_DELTA_WRITE_DIR
#              to a WRITABLE base path. Local FS (OneLake auto-discovery is blocked by a DuckDB-azure glob bug).
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

# ENGINE-PARAMETERIZED: this suite runs TWICE, once per Delta engine, because its subject — write /
# transaction / update / delete semantics — must be IDENTICAL whichever engine moves the bytes.
# ${DELTA_PROVIDER} is 'delta' (DuckDB reads+writes the parquet, EW owns the log) on one leg and
# 'engineeredwooddelta' (pure EW codec) on the other; scripts/run-suites.sh drives both. ATTACHes that
# pin native_read/native_write explicitly are NOT parameterized — those sections are about the native
# path specifically and stay on it in both legs.
require-env DELTA_PROVIDER

# ATTACH a fresh (empty) Delta catalog root — no tables discovered yet.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogw' AS lake (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}');

# CREATE TABLE — writes an empty Delta table (commit 0, schema only).
statement ok
CREATE TABLE lake.main.t (id INTEGER, name VARCHAR);

query T
SELECT table_name FROM duckdb_tables() WHERE database_name = 'lake' ORDER BY table_name;
----
t

# A freshly created table is empty.
query I
SELECT count(*) FROM lake.main.t;
----
0

# INSERT streams an Append commit.
statement ok
INSERT INTO lake.main.t SELECT i, 'a' || i FROM range(1, 4) AS r(i);

query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
1	a1
2	a2
3	a3

# A second INSERT appends (two commits, rows accumulate).
statement ok
INSERT INTO lake.main.t VALUES (4, 'a4');

query I
SELECT count(*) FROM lake.main.t;
----
4

# CTAS — create_table => Overwrite (the table becomes exactly the query result).
statement ok
CREATE TABLE lake.main.squares AS SELECT i AS n, i * i AS sq FROM range(1, 5) AS r(i);

query II
SELECT n, sq FROM lake.main.squares ORDER BY n;
----
1	1
2	4
3	9
4	16

# Filter pushdown + aggregate over the written table.
query I
SELECT sum(sq) FROM lake.main.squares WHERE n >= 3;
----
25

# DROP TABLE recursively deletes the table's folder (its _delta_log + data files).
statement ok
DROP TABLE lake.main.squares;

query T
SELECT table_name FROM duckdb_tables() WHERE database_name = 'lake' ORDER BY table_name;
----
t

# The dropped table is gone — re-discovery no longer finds it.
statement error
SELECT * FROM lake.main.squares;
----

statement ok
DETACH lake;

# Re-ATTACH proves the commits are durable + standard Delta (re-discovered from _delta_log).
# `squares` was dropped, so only `t` remains.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogw' AS lake2 (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}');

query T
SELECT table_name FROM duckdb_tables() WHERE database_name = 'lake2' ORDER BY table_name;
----
t

query I
SELECT count(*) FROM lake2.main.t;
----
4

statement ok
DETACH lake2;

# ── A plain CREATE over an EXISTING table must be REFUSED ────────────────────────────────────────
# Regression gate. Nothing upstream of us enforces this for an attached catalog — DuckDB's binder
# leaves the conflict to the catalog — so before FabricatorSchemaEntry::CreateTable handled
# ERROR_ON_CONFLICT, a plain create reached the provider as an ordinary create and Delta's
# OpenOrCreateAsync just OPENED the existing table. Both shapes below then SUCCEEDED while doing
# nothing: a CTAS wrote no rows and kept the old data (so a user re-running it believing it had
# replaced the data silently kept the stale rows), and a plain CREATE had its DECLARED SCHEMA
# ignored. Exit 0, no warning, no log line. The four cases are asserted together because the fix is
# one conflict-action check: getting it wrong in the other direction breaks OR REPLACE / IF NOT
# EXISTS, which are the shapes users reach for once the plain one errors.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogw' AS lake3 (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}');

# `t` exists on storage and has NOT been read through this attach — the entry is not materialized,
# so the check must consult the DISCOVERED name list, not just the cached entries.
statement error
CREATE TABLE lake3.main.t AS SELECT * FROM range(99) v(id);
----
Table with name "t" already exists!

# The refusal is a REFUSAL, not a partial write: the old data is untouched.
query I
SELECT count(*) FROM lake3.main.t;
----
4

# Same for a plain CREATE naming a completely different schema (the shape whose old behaviour
# silently discarded the declared columns).
statement error
CREATE TABLE lake3.main.t (a INTEGER, b VARCHAR);
----
Table with name "t" already exists!

query T
SELECT string_agg(column_name, ',' ORDER BY column_index) FROM duckdb_columns()
WHERE database_name = 'lake3' AND table_name = 't';
----
id,name

# IF NOT EXISTS still no-ops silently (IGNORE_ON_CONFLICT is forwarded to the provider).
statement ok
CREATE TABLE IF NOT EXISTS lake3.main.t AS SELECT * FROM range(3) v(id);

query I
SELECT count(*) FROM lake3.main.t;
----
4

# OR REPLACE still replaces (REPLACE_ON_CONFLICT drops first).
statement ok
CREATE OR REPLACE TABLE lake3.main.t AS SELECT * FROM range(6) v(id);

query I
SELECT count(*) FROM lake3.main.t;
----
6

# A create of a name that genuinely does not exist is unaffected — the positive control, without
# which every assertion above would pass on a CreateTable that refuses everything.
statement ok
CREATE TABLE lake3.main.freshly AS SELECT * FROM range(7) v(id);

query I
SELECT count(*) FROM lake3.main.freshly;
----
7

statement ok
DETACH lake3;

# ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# A PARALLEL WRITE SINK STILL WRITES EVERY ROW ONCE. docs/scan-concurrency.md §7c.
#
# Since the sink declares ParallelSink() true (for a plan carrying no explicit ordering), several DuckDB tasks
# call push_batch on ONE bulk session at the same time. What that can break is not a type or a name but the
# BOOKKEEPING: a batch enqueued twice, or dropped, or a partially-owned Arrow array double-freed.
#
# ⚠ THE SOURCE MUST BE A FABRICATOR TABLE, and that is what makes the section mean anything: `range()` is a
# SINGLE-THREADED source (docs/scan-concurrency.md §6), so a CTAS straight off it gets ONE source task and
# therefore one sink task however many threads are configured — the concurrency this section exists to
# exercise would never occur. `pw_src` is built from range on purpose (it is a plain load) and then READ
# through the catalog, where the scan declares NumberOfThreads().
#
# ⚠ AND IT MUST BE BIG ENOUGH TO SPAN SEVERAL MORSELS. At 2048 rows per chunk, the handful of rows the rest of
# this suite writes is a single chunk — one push, no concurrency. 40000 rows is ~20.

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/catalogpw' AS pw (TYPE fabricator, PROVIDER '${DELTA_PROVIDER}');

statement ok
CREATE TABLE pw.main.pw_src AS SELECT i AS id, 'v' || (i % 977) AS s FROM range(40000) t(i);

statement ok
CREATE TABLE pw.main.pw_ctas AS SELECT id, s FROM pw.main.pw_src;

# Exact count AND a checksum over both columns: a lost or duplicated batch moves the count, a mis-paired one
# moves the checksum while the count survives.
query III
SELECT count(*), sum(id), sum(hash(s)) % 1000000007 FROM pw.main.pw_ctas;
----
40000	799980000	934842135

# The CTAS's own answer must equal the source's, which is the comparison that does not depend on the literals
# above staying correct if the fixture ever changes.
query I
SELECT (SELECT count(*) FROM pw.main.pw_ctas) = (SELECT count(*) FROM pw.main.pw_src)
   AND (SELECT sum(id) FROM pw.main.pw_ctas) = (SELECT sum(id) FROM pw.main.pw_src);
----
true

# The INSERT operator is a separate sink class with its own ParallelSink() — appending the same rows must
# double every aggregate exactly.
statement ok
INSERT INTO pw.main.pw_ctas SELECT id, s FROM pw.main.pw_src;

query II
SELECT count(*), sum(id) FROM pw.main.pw_ctas;
----
80000	1599960000

# ⚠ NOT COVERED HERE, said plainly: INSERT ... RETURNING, which is the one write shape deliberately kept
# SERIAL (the OUTPUT rows would come back in an arbitrary order and the accumulating producer is shared).
# It is a SQL Server surface — the Delta provider has no OUTPUT INSERTED — so its coverage lives in the
# service tier, and nothing about it CHANGED: FabricatorInsertTarget::parallel is false whenever
# op.return_chunk is set. There is also no way to write it here: `FROM (INSERT ... RETURNING ...)` is a
# Parser Error in DuckDB, so a multi-morsel RETURNING cannot be aggregated in one statement at all.

statement ok
DETACH pw;
