# name: test/verify_delta_catalog_identity.test
# description: Delta-native IDENTITY columns via the DuckDB generated-column marker (`id BIGINT AS (0)`, the
#              v53 identity marker shared with the SQL Server provider). The Delta provider attaches
#              delta.identity.* field metadata (start 1, step 1, GENERATED ALWAYS) at CREATE; engineered-wood
#              declares the identityColumns writer feature, generates values on every write
#              (IdentityColumnWriter.ProcessBatch — the NULLs the INSERT stream carries are replaced), and
#              bumps delta.identity.highWaterMark in the SAME commit, so values continue across statements,
#              re-attaches, and OCC retries (a retried append regenerates from the fresh snapshot's mark).
#              Works on the codec path AND under native_write (identity tables fall back from streaming to
#              the collect path, which still writes native parquet via the IDataFileWriter seam).
#              Set FABRICATOR_DELTA_WRITE_DIR to a WRITABLE base path. Local FS.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/idcatalog' AS lake (TYPE fabricator, PROVIDER 'delta', column_mapping 'none', native_write true);

statement ok
CREATE TABLE lake.main.idt (id BIGINT AS (0), v VARCHAR);

# The engine assigns 1, 2, 3 (start 1, step 1) — the omitted column's NULLs are replaced.
statement ok
INSERT INTO lake.main.idt (v) VALUES ('a'), ('b'), ('c');

query IT
SELECT id, v FROM lake.main.idt ORDER BY id;
----
1	a
2	b
3	c

# A second INSERT continues from the committed high-water mark.
statement ok
INSERT INTO lake.main.idt (v) VALUES ('d'), ('e');

query IT
SELECT id, v FROM lake.main.idt ORDER BY id;
----
1	a
2	b
3	c
4	d
5	e

# An explicit NULL is likewise engine-assigned (GENERATED ALWAYS — allowExplicitInsert=false).
statement ok
INSERT INTO lake.main.idt VALUES (NULL, 'f');

query I
SELECT id FROM lake.main.idt WHERE v = 'f';
----
6

# Values are unique across all inserts.
query II
SELECT count(*), count(DISTINCT id) FROM lake.main.idt;
----
6	6

# The high-water mark survives a re-attach (it lives in the table's schema metadata).
statement ok
DETACH lake;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/idcatalog' AS lake2 (TYPE fabricator, PROVIDER 'delta', column_mapping 'none', native_write true);

statement ok
INSERT INTO lake2.main.idt (v) VALUES ('g');

query I
SELECT id FROM lake2.main.idt WHERE v = 'g';
----
7

# A table WITHOUT the marker is unaffected (plain nullable BIGINT).
statement ok
CREATE TABLE lake2.main.plain (id BIGINT, v VARCHAR);

statement ok
INSERT INTO lake2.main.plain (v) VALUES ('x');

query I
SELECT count(*) FROM lake2.main.plain WHERE id IS NULL;
----
1

# Identity also works on the pure codec path (no native flags).
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/idcodec' AS codec (TYPE fabricator, PROVIDER 'delta', column_mapping 'none');

statement ok
CREATE TABLE codec.main.idt (id BIGINT AS (0), v VARCHAR);

statement ok
INSERT INTO codec.main.idt (v) VALUES ('a'), ('b');

query IT
SELECT id, v FROM codec.main.idt ORDER BY id;
----
1	a
2	b
