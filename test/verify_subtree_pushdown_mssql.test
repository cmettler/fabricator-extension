# ═══ §3  What stays local, and why ════════════════════════════════════════════════════════════════════

# A SQL Server UDF named like a built-in. A catalog function crosses as its schema and name under our own Substrait
# extension, never by its bare name, so dbo.abs is called as [dbo].[abs] — the differential below would see ABS
# (v + 1000 against |v|), and §3b checks the T-SQL sent.
query II
SELECT rp.dbo.abs(-5), abs(-5);
----
995	5

query II
EXPLAIN SELECT l.region, r.s FROM loc l JOIN (SELECT region, sum(rp.dbo.abs(v)) AS s FROM rp.dbo.st_big GROUP BY region) r USING (region);
----
physical_plan	<REGEX>:.*Fabricator Query.*

query I
SELECT (SELECT count(*) FROM ((SELECT l.region, r.s FROM loc l JOIN (SELECT region, sum(rp.dbo.abs(v)) AS s FROM rp.dbo.st_big GROUP BY region) r USING (region))
  EXCEPT ALL (SELECT l.region, r.s FROM loc l JOIN (SELECT region, sum(v + 1000) AS s FROM lb GROUP BY region) r USING (region))))
 + (SELECT count(*) FROM ((SELECT l.region, r.s FROM loc l JOIN (SELECT region, sum(v + 1000) AS s FROM lb GROUP BY region) r USING (region))
  EXCEPT ALL (SELECT l.region, r.s FROM loc l JOIN (SELECT region, sum(rp.dbo.abs(v)) AS s FROM rp.dbo.st_big GROUP BY region) r USING (region))));
----
0

# A statement that WRITES this catalog keeps its reads on the catalog's own scans: the write and the reads beside it
# are routed together (the pinned connection, the same-catalog read+write mark), which a pushed subtree would bypass.
query II
EXPLAIN INSERT INTO rp.dbo.st_out SELECT l.region, r.s FROM loc l JOIN (SELECT region, sum(v) AS s FROM rp.dbo.st_big GROUP BY region) r USING (region);
----
physical_plan	<!REGEX>:.*Fabricator Query.*

statement ok
INSERT INTO rp.dbo.st_out SELECT l.region, r.s FROM loc l JOIN (SELECT region, sum(v) AS s FROM rp.dbo.st_big GROUP BY region) r USING (region);

query I
SELECT (SELECT count(*) FROM (FROM rp.dbo.st_out EXCEPT ALL SELECT l.region, r.s FROM loc l JOIN (SELECT region, sum(v) AS s FROM lb GROUP BY region) r USING (region)))
 + (SELECT count(*) FROM (SELECT l.region, r.s FROM loc l JOIN (SELECT region, sum(v) AS s FROM lb GROUP BY region) r USING (region) EXCEPT ALL FROM rp.dbo.st_out));
----
0

# ═══ §3b  The decisions in duckdb_logs: where each condition ended up, and why something stayed local ═══════

statement ok
CALL enable_logging(['Fabricator.Remote'], storage := 'memory');

# P11 — the WHERE on the group key must reach the server query. Replaced before DuckDB's optimizers, the condition stayed
# outside it: the whole table aggregated on the server, measured 0.73 s against 0.08 s for the scan with the condition.
statement ok
SELECT l.w, r.region, r.s FROM loc l JOIN (SELECT region, sum(v) AS s FROM rp.dbo.st_big GROUP BY region) r USING (region) WHERE r.region = 'A';

query I
SELECT count(*) FROM duckdb_logs WHERE message LIKE 'remote subtree (after the optimizers): %WHERE%';
----
1

query I
SELECT count(*) FROM duckdb_logs WHERE message LIKE 'remote subtree (before the optimizers): %';
----
0

query I
SELECT count(*) FROM duckdb_logs
WHERE message = 'local subtree (before the optimizers): a filter above it reads its columns; left for the pass after the optimizers';
----
1

statement ok
CALL truncate_duckdb_logs();

# N3 — a function the server would answer with its own clock, time zone or generator keeps the part local
statement ok
SELECT l.region, r.s FROM loc l JOIN (SELECT region, sum(CASE WHEN random() < 2 THEN v END) AS s FROM rp.dbo.st_big GROUP BY region) r USING (region);

query I
SELECT count(*) > 0 FROM duckdb_logs WHERE message LIKE 'local subtree (%): AGGREGATE stays local because it calls %(), whose value is not fixed by its arguments';
----
true

statement ok
CALL truncate_duckdb_logs();

# P12 — a SQL Server UDF is called by its schema and name, and dbo.abs as [dbo].[abs], not as the built-in ABS
statement ok
SELECT l.region, r.s FROM loc l JOIN (SELECT region, sum(rp.dbo.abs(v)) AS s FROM rp.dbo.st_big GROUP BY region) r USING (region);

query I
SELECT count(*) FROM duckdb_logs WHERE message LIKE 'remote subtree (before the optimizers): %SUM(%[dbo].[abs]([t0].[v])%';
----
1

statement ok
CALL truncate_duckdb_logs();

# N2 — a function the provider implements itself (C#) does not exist on the server: the provider refuses it
statement ok
SELECT l.region, r.s FROM loc l JOIN (SELECT region, sum(rp.dbo.cf_add(v, 1)) AS s FROM rp.dbo.st_big GROUP BY region) r USING (region);

query I
SELECT count(*) FROM duckdb_logs WHERE message LIKE 'local subtree (before the optimizers): %dbo.cf_add() is not a function of the server';
----
1

statement ok
CALL truncate_duckdb_logs();

# … and the same for a whole statement (the remote optimizer's route)
query II
EXPLAIN SELECT region, max(v) FROM rp.dbo.st_big WHERE random() < 2 GROUP BY region;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

query I
SELECT count(*) > 0 FROM duckdb_logs WHERE message LIKE 'local: it calls %(), whose value is not fixed by its arguments';
