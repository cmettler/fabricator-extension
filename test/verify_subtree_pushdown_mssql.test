SELECT (SELECT count(*) FROM ((WITH r AS (SELECT region, sum(v) AS s FROM rp.dbo.st_big GROUP BY region) SELECT l.region, r.s FROM loc l JOIN r USING (region)) EXCEPT ALL (WITH r AS (SELECT region, sum(v) AS s FROM lb GROUP BY region) SELECT l.region, r.s FROM loc l JOIN r USING (region)))) + (SELECT count(*) FROM ((WITH r AS (SELECT region, sum(v) AS s FROM lb GROUP BY region) SELECT l.region, r.s FROM loc l JOIN r USING (region)) EXCEPT ALL (WITH r AS (SELECT region, sum(v) AS s FROM rp.dbo.st_big GROUP BY region) SELECT l.region, r.s FROM loc l JOIN r USING (region))));
----
0

query I
SELECT count(*) FROM (WITH r AS (SELECT region, sum(v) AS s FROM lb GROUP BY region) SELECT l.region, r.s FROM loc l JOIN r USING (region));
