physical_plan	<REGEX>:.*Fabricator Query.*

query I
SELECT (SELECT count(*) FROM ((SELECT l.region, r.s FROM loc l JOIN (SELECT region, sum(v) AS s FROM rp.dbo.st_big GROUP BY region) r USING (region))
  EXCEPT ALL (SELECT l.region, r.s FROM loc l JOIN (SELECT region, sum(v) AS s FROM (FROM lb UNION ALL SELECT 99999, 'A', 1000) GROUP BY region) r USING (region))))
 + (SELECT count(*) FROM ((SELECT l.region, r.s FROM loc l JOIN (SELECT region, sum(v) AS s FROM (FROM lb UNION ALL SELECT 99999, 'A', 1000) GROUP BY region) r USING (region))
  EXCEPT ALL (SELECT l.region, r.s FROM loc l JOIN (SELECT region, sum(v) AS s FROM rp.dbo.st_big GROUP BY region) r USING (region))));
----
0

statement ok
ROLLBACK;

query I
SELECT count(*) FROM rp.dbo.st_big WHERE id = 99999;
