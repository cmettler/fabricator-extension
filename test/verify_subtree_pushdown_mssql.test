true

statement ok
CALL disable_logging();

# ═══ §4  Statements the subtree pushdown reaches beyond the remote optimizer ═════════════════════════════

# A CTE read by the whole statement: the remote optimizer declines it (its plan has a CTE relation), the subtree
# pushdown sends the CTE's body
query II
EXPLAIN WITH r AS (SELECT region, sum(v) AS s FROM rp.dbo.st_big GROUP BY region) SELECT * FROM r;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query I
SELECT (SELECT count(*) FROM ((WITH r AS (SELECT region, sum(v) AS s FROM rp.dbo.st_big GROUP BY region) SELECT * FROM r)
  EXCEPT ALL (SELECT region, sum(v) AS s FROM lb GROUP BY region)))
 + (SELECT count(*) FROM ((SELECT region, sum(v) AS s FROM lb GROUP BY region)
  EXCEPT ALL (WITH r AS (SELECT region, sum(v) AS s FROM rp.dbo.st_big GROUP BY region) SELECT * FROM r)));
----
0

# A whole statement whose result names a column twice: the remote optimizer declines it (it re-wraps a pushed query
# as SELECT * FROM …, and one binding cannot hold two columns of one name); the subtree pushdown replaces the plan's
# ROOT, which keeps DuckDB's own names
query II
EXPLAIN SELECT b.region, d.region, count(*) FROM rp.dbo.st_big b JOIN rp.dbo.st_dim d ON b.region = d.region GROUP BY 1, 2;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query I
SELECT (SELECT count(*) FROM ((SELECT b.region, d.region, count(*) FROM rp.dbo.st_big b JOIN rp.dbo.st_dim d ON b.region = d.region GROUP BY 1, 2)
  EXCEPT ALL (SELECT b.region, d.region, count(*) FROM lb b JOIN ld d ON b.region = d.region GROUP BY 1, 2)))
 + (SELECT count(*) FROM ((SELECT b.region, d.region, count(*) FROM lb b JOIN ld d ON b.region = d.region GROUP BY 1, 2)
  EXCEPT ALL (SELECT b.region, d.region, count(*) FROM rp.dbo.st_big b JOIN rp.dbo.st_dim d ON b.region = d.region GROUP BY 1, 2)));
----
0

query I
SELECT count(*) FROM (SELECT b.region, d.region, count(*) FROM lb b JOIN ld d ON b.region = d.region GROUP BY 1, 2);
----
4

# ⚠ Above, EXPLAIN and the differential wrap the statement, so the subtree is a CHILD there; only a statement at the
# top level reaches the root replacement, and its routing shows on the server alone: the pushed query (the join
# written by the translation) must have run once more
statement ok
SET VARIABLE runs_before = (SELECT n FROM fabricator_query('rp', 'SELECT CAST(COALESCE(SUM(qs.execution_count), 0) AS BIGINT) AS n FROM sys.dm_exec_query_stats qs CROSS APPLY sys.dm_exec_sql_text(qs.sql_handle) t WHERE CHARINDEX(N''[dbo].[st_dim] AS [t1]'', t.text) > 0 AND CHARINDEX(N''dm_exec_query_stats'', t.text) = 0'));

statement ok
SELECT b.region, d.region, count(*) FROM rp.dbo.st_big b JOIN rp.dbo.st_dim d ON b.region = d.region GROUP BY 1, 2;

query I
SELECT (SELECT n FROM fabricator_query('rp', 'SELECT CAST(COALESCE(SUM(qs.execution_count), 0) AS BIGINT) AS n FROM sys.dm_exec_query_stats qs CROSS APPLY sys.dm_exec_sql_text(qs.sql_handle) t WHERE CHARINDEX(N''[dbo].[st_dim] AS [t1]'', t.text) > 0 AND CHARINDEX(N''dm_exec_query_stats'', t.text) = 0')) > getvariable('runs_before');
----
true

# A prepared statement: DuckDB plans each EXECUTE with its values, so two executions get two server queries
statement ok
PREPARE p AS SELECT l.w, r.s FROM loc l JOIN (SELECT region, sum(v) AS s FROM rp.dbo.st_big WHERE v > $1 GROUP BY region) r USING (region) ORDER BY 1, 2;

query II
EXECUTE p(50);
----
1	16210
2	17037
3	16402
4	17092
7	16190

query II
EXECUTE p(95);
----
1	1648
2	1762
3	1744
4	1861
7	1844

query II
SELECT l.w, r.s FROM loc l JOIN (SELECT region, sum(v) AS s FROM lb WHERE v > 95 GROUP BY region) r USING (region) ORDER BY 1, 2;
----
1	1648
2	1762
3	1744
4	1861
7	1844

# Inside a transaction that has written the table: the pushed query runs on the transaction's own connection and sees
# the uncommitted row (A's sum grows by 1000)
statement ok
BEGIN;

statement ok
INSERT INTO rp.dbo.st_big VALUES (99999, 'A', 1000);

query II
EXPLAIN SELECT l.region, r.s FROM loc l JOIN (SELECT region, sum(v) AS s FROM rp.dbo.st_big GROUP BY region) r USING (region);
