query I
SELECT (SELECT count(*) FROM ((SELECT l.w, r.label, r.c FROM loc l JOIN (SELECT d.region, d.label, count(*) AS c, sum(b.v) AS s FROM rp.dbo.st_big b JOIN rp.dbo.st_dim d ON b.region = d.region GROUP BY d.region, d.label) r ON r.region = l.region) EXCEPT ALL (SELECT l.w, r.label, r.c FROM loc l JOIN (SELECT d.region, d.label, count(*) AS c, sum(b.v) AS s FROM lb b JOIN ld d ON b.region = d.region GROUP BY d.region, d.label) r ON r.region = l.region))) + (SELECT count(*) FROM ((SELECT l.w, r.label, r.c FROM loc l JOIN (SELECT d.region, d.label, count(*) AS c, sum(b.v) AS s FROM lb b JOIN ld d ON b.region = d.region GROUP BY d.region, d.label) r ON r.region = l.region) EXCEPT ALL (SELECT l.w, r.label, r.c FROM loc l JOIN (SELECT d.region, d.label, count(*) AS c, sum(b.v) AS s FROM rp.dbo.st_big b JOIN rp.dbo.st_dim d ON b.region = d.region GROUP BY d.region, d.label) r ON r.region = l.region)));
----
0

query I
SELECT count(*) FROM (SELECT l.w, r.label, r.c FROM loc l JOIN (SELECT d.region, d.label, count(*) AS c, sum(b.v) AS s FROM lb b JOIN ld d ON b.region = d.region GROUP BY d.region, d.label) r ON r.region = l.region);
