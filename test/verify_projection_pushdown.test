# name: test/verify_projection_pushdown.test
# description: Verify projection pushdown emits SELECT <subset> (not SELECT *) to SQL Server
# group: [fabricator]

require fabricator

require-env MSSQL_TESTDB_DSN

# This suite tests the SCAN's own pushdown, so it pins the scan path: with the remote pushdown on
# (the default) DuckDB hands shapes like ORDER BY ... LIMIT to the provider as one query, and the
# proofs below would test that path instead (or pass on its text). Pushed queries have their own
# suite, verify_remote_select_mssql.
statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS db (TYPE fabricator, remote_pushdown 'false');

# The proofs read sys.dm_exec_query_stats, which outlives a run: clear it, so only statements of this
# run can satisfy (or contradict) them.
statement ok
SELECT fabricator_exec('db', 'DBCC FREEPROCCACHE WITH NO_INFOMSGS');

# Control: a shape the remote pushdown would take stays a table scan here.
query II
EXPLAIN SELECT id, name FROM db.dbo.TestSimplePK ORDER BY id LIMIT 1;
----
physical_plan	<REGEX>:.*Fabricator Scan.*

query II
EXPLAIN SELECT id, name FROM db.dbo.TestSimplePK ORDER BY id LIMIT 1;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

# A projected scan: ask for id + name only (NOT value / created_at). Correctness:
query IT
SELECT id, name FROM db.dbo.TestSimplePK ORDER BY id LIMIT 1;
----
1	First Record

# Proof the projection reached SQL Server: the plan cache must contain a recent
# statement that scans TestSimplePK selecting [name] but NOT [value]/[created_at].
# (CHARINDEX, not LIKE, so the [] brackets are matched literally.)
query I
SELECT proj_ok FROM fabricator_query('db',
  'SELECT CAST(CASE WHEN EXISTS (
     SELECT 1 FROM sys.dm_exec_query_stats qs
     CROSS APPLY sys.dm_exec_sql_text(qs.sql_handle) st
     WHERE CHARINDEX(''FROM [dbo].[TestSimplePK]'', st.text) > 0
       AND CHARINDEX(''[name]'', st.text) > 0
       AND CHARINDEX(''[value]'', st.text) = 0
       AND CHARINDEX(''[created_at]'', st.text) = 0
       AND CHARINDEX(''dm_exec'', st.text) = 0
   ) THEN 1 ELSE 0 END AS INT) AS proj_ok');
----
1

statement ok
DETACH db;
