# name: test/verify_delta_autocommit_pin.test
# description: AUTOCOMMIT snapshot pinning on the CODEC read path (native_read off = the default). A statement
#              that references one Delta table SEVERAL times (self-join, UNION ALL, a correlated re-scan,
#              INSERT INTO t ... FROM t JOIN t) must read ONE version for all of them. It did not: the version
#              pin was consulted only inside an explicit transaction, because it had been written inside the
#              explicit-only read-set block (a gate that exists for the buffered-DML capability boundary and
#              has nothing to do with reads), so each reference opened at LATEST independently and two of them
#              could straddle a concurrent commit. The fix seeds the pin from the FIRST scan's own schema open
#              (zero extra IO — that open already read the latest version) and drops the IsExplicit gate on
#              READING the pin.
#
#              WHAT IS ASSERTED, and why this shape: the seeding branch runs at most ONCE per (txn, table)
#              because ScanTable consults the pin before either read path is called, so the number of
#              "delta % pin" log lines IS the sharing property -- exactly one however many times the
#              statement names the table. Unfixed, the count is 0 (no pin at all in autocommit); with the pin
#              seeded but not consulted, it is one PER scan call (4 for a self-join: a bind probe + an
#              execution per reference). So == 1 distinguishes the fix from both failure modes.
#
#              ⚠ THE PATTERN IS DELIBERATELY WIDE ('delta % pin'), matching whichever site seeded --
#              "codec" / "native" / "probe". It used to name 'delta codec pin', which was the SITE standing
#              in for the property; once the bind-time schema probe stopped running a full scan it became the
#              seeding site for both engines and the narrow pattern asserted the implementation rather than
#              the behaviour. The wide pattern still separates all three outcomes (0 / 1 / 4), so nothing is
#              given up. What the pin lines can no longer witness is WHICH ENGINE served the scan -- sections
#              8 and 11 assert that directly on the reader's own line instead.
#              The remaining half -- that reading AT a pinned version yields that version's data -- is NOT
#              re-proven here: it is the same GetSchemaAt/StreamAt machinery the explicit-transaction snapshot
#              sections of verify_delta_catalog_transactions already cover. A concurrent commit cannot be
#              scheduled BETWEEN two scans of one statement from sqllogictest, so an end-to-end racer for that
#              interleaving would be flaky rather than load-bearing; it is deliberately not attempted.
#              Set FABRICATOR_DELTA_WRITE_DIR (writable). Local FS, no service dependency.
# group: [fabricator]

require fabricator

# §8 attaches a native_read/native_write catalog, whose CTAS writes and whose scan reads go through
# read_parquet / COPY (FORMAT parquet). Declared at the TOP like every other suite that needs it — a `require`
# further down is not the proven placement, and an undeclared dependency passes on a developer box (parquet is
# statically linked into the test binaries) while failing on a bare runner.
require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

# A plain codec catalog: native_read OFF, which is the default and the path that never pinned in autocommit.
# PROVIDER 'engineeredwooddelta': this suite is ABOUT the codec read path's pin, so it names the pure-EW
# engine rather than relying on a default. Under 'delta' the native reader pins via ResolveVersionAsOf and
# the 'delta codec pin' line these assertions count is never emitted.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/apin' AS lake
  (TYPE fabricator, PROVIDER 'engineeredwooddelta', READ_ONLY false);

# One table per case, so each case's pin lines can be counted independently (duckdb_logs accumulates for the
# whole session, and every autocommit statement is its own transaction => its own pin).
statement ok
CREATE TABLE lake.main.one AS SELECT i AS id, i * 2 AS v FROM range(6) tbl(i);

statement ok
CREATE TABLE lake.main.selfj AS SELECT i AS id, i * 2 AS v FROM range(6) tbl(i);

statement ok
CREATE TABLE lake.main.three AS SELECT i AS id, i * 2 AS v FROM range(6) tbl(i);

statement ok
CREATE TABLE lake.main.unio AS SELECT i AS id, i * 2 AS v FROM range(6) tbl(i);

statement ok
CREATE TABLE lake.main.corr AS SELECT i AS id, i * 2 AS v FROM range(6) tbl(i);

statement ok
CREATE TABLE lake.main.instgt AS SELECT i AS id, i * 2 AS v FROM range(6) tbl(i);

statement ok
CALL enable_logging(level := 'debug', storage := 'memory');

# ---------------------------------------------------------------------------------------------------------
# 1. A single reference still pins exactly once (the baseline: seeding happens, and only once even though the
#    statement makes TWO ScanCodec calls -- the bind-time schema probe and the execution).
# ---------------------------------------------------------------------------------------------------------
query I
SELECT sum(v) FROM lake.main.one;
----
30

query I
SELECT count(*) FROM duckdb_logs
WHERE type = 'Fabricator.Delta' AND message LIKE 'delta % pin %/one -> v%';
----
1

# ---------------------------------------------------------------------------------------------------------
# 2. THE CASE THAT MOTIVATES THIS: a SELF-JOIN names the table twice (4 ScanCodec calls) and must pin ONCE,
#    i.e. both sides read the same version. Unfixed this count is 0; seeded-but-not-shared it is 4.
# ---------------------------------------------------------------------------------------------------------
query I
SELECT sum(a.v) FROM lake.main.selfj a JOIN lake.main.selfj b ON a.id = b.id;
----
30

query I
SELECT count(*) FROM duckdb_logs
WHERE type = 'Fabricator.Delta' AND message LIKE 'delta % pin %/selfj -> v%';
----
1

# ---------------------------------------------------------------------------------------------------------
# 3. Three references, still one pin -- the property is per (transaction, table), not per reference.
# ---------------------------------------------------------------------------------------------------------
query I
SELECT sum(a.v) FROM lake.main.three a
  JOIN lake.main.three b ON a.id = b.id
  JOIN lake.main.three c ON a.id = c.id;
----
30

query I
SELECT count(*) FROM duckdb_logs
WHERE type = 'Fabricator.Delta' AND message LIKE 'delta % pin %/three -> v%';
----
1

# ---------------------------------------------------------------------------------------------------------
# 4. UNION ALL of the same table -- the same hazard without a join.
# ---------------------------------------------------------------------------------------------------------
query I
SELECT sum(v) FROM (SELECT v FROM lake.main.unio UNION ALL SELECT v FROM lake.main.unio) u;
----
60

query I
SELECT count(*) FROM duckdb_logs
WHERE type = 'Fabricator.Delta' AND message LIKE 'delta % pin %/unio -> v%';
----
1

# ---------------------------------------------------------------------------------------------------------
# 5. A correlated subquery re-scanning the same table.
# ---------------------------------------------------------------------------------------------------------
# v is 0,2,4,6,8,10; the min over the OTHER rows is 0 for every row except id=0 (whose min is 2), so all but
# the first row qualify.
query I
SELECT count(*) FROM lake.main.corr a
WHERE a.v > (SELECT min(b.v) FROM lake.main.corr b WHERE b.id <> a.id);
----
5

query I
SELECT count(*) FROM duckdb_logs
WHERE type = 'Fabricator.Delta' AND message LIKE 'delta % pin %/corr -> v%';
----
1

# ---------------------------------------------------------------------------------------------------------
# 6. INSERT INTO t SELECT ... FROM t JOIN t -- the write form of the same hazard: the two read references must
#    agree, and the pin must not disturb the write (the rows land, and a re-read sees them).
# ---------------------------------------------------------------------------------------------------------
statement ok
INSERT INTO lake.main.instgt SELECT a.id + 100, a.v FROM lake.main.instgt a JOIN lake.main.instgt b ON a.id = b.id;

query I
SELECT count(*) FROM duckdb_logs
WHERE type = 'Fabricator.Delta' AND message LIKE 'delta % pin %/instgt -> v%';
----
1

query II
SELECT count(*), sum(v) FROM lake.main.instgt;
----
12	60

# The next statement is a new transaction, so it pins afresh AND sees the inserted rows (the pin must not
# make a later statement read stale data).
query I
SELECT count(*) FROM lake.main.instgt WHERE id >= 100;
----
6

# ---------------------------------------------------------------------------------------------------------
# 7. The pin does not change what a statement READS: DML and a following read still compose normally, and an
#    explicit AT overrides the pin (committed history, not the transaction's cut).
# ---------------------------------------------------------------------------------------------------------
statement ok
DELETE FROM lake.main.one WHERE id < 2;

query II
SELECT count(*), sum(v) FROM lake.main.one;
----
4	28

# v0 is the CTAS's CREATE commit (empty) and v1 its data write, so v1 is the pre-DELETE state: AT reads
# committed history and is not redirected to the transaction's pinned cut.
query I
SELECT count(*) FROM lake.main.one AT (VERSION => 1);
----
6

query I
SELECT count(*) FROM lake.main.one AT (VERSION => 0);
----
0

# ---------------------------------------------------------------------------------------------------------
# 8. native_read is UNTOUCHED: it already pinned in autocommit through ResolveVersionAsOf, so it must emit NO
#    "delta codec pin" lines (that message is the codec path's, and a native catalog never reaches it).
# ---------------------------------------------------------------------------------------------------------
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/apin_native' AS nlake
  (TYPE fabricator, PROVIDER 'delta', READ_ONLY false, native_read true, native_write true);

statement ok
CREATE TABLE nlake.main.nat AS SELECT i AS id, i * 2 AS v FROM range(6) tbl(i);

query I
SELECT sum(a.v) FROM nlake.main.nat a JOIN nlake.main.nat b ON a.id = b.id;
----
30

query I
SELECT count(*) FROM duckdb_logs
WHERE type = 'Fabricator.Delta' AND message LIKE 'delta codec pin %/nat -> v%';
----
0

# ⚠ THAT ZERO NEEDS A POSITIVE CONTROL, and it did not have one. Since the bind-time schema probe seeds the
# pin (it opens at latest anyway), the pin exists before either read path runs, so ScanCodec's seeding branch
# is unreachable here whether or not this catalog is native — the zero above would hold even for a catalog
# that had been wrongly routed through the codec reader. Assert the engine DIRECTLY instead, on the reader's
# own line, which no pin refactor can make vacuous.
query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type = 'Fabricator.Delta.Native' AND message LIKE 'delta native scan %/nat:%';
----
true

# ---------------------------------------------------------------------------------------------------------
# 9. AT x THE SHARED PIN. Dropping the IsExplicit gate made non-AT references SHARE one version; an explicit
#    `AT (VERSION => n)` reference must stay INDEPENDENT of that, in BOTH directions:
#      * it must not CONSUME the pin (else time travel would silently return the pinned version), and
#      * it must not SEED the pin (else the inverse of the original bug: one time-travelled reference would
#        drag every other reference in the statement back to that old version).
#    Both hold by construction rather than by luck. Codec: ScanTable handles spec.At in a branch that RETURNS
#    before either the pin read or ScanCodec's seeding. Native: an explicit precedence chain, AT first
#    ("explicit AT > per-transaction pinned version > latest"), with PinVersion reachable only in the final
#    else.
#
#    WHAT MUTATION TESTING ACTUALLY SHOWED about this section, recorded so its strength is not overstated:
#      * the SEED direction is UNFALSIFIABLE on the codec path, not merely untested. Making the AT branch
#        seed the pin changes NOTHING observable, because by the time it runs the pin already exists -- the
#        explicit-transaction read-set block sits ABOVE it (~1141) and in autocommit another reference's bind
#        probe seeds first -- so PinVersion's GetOrAdd is a no-op. Tried it in both orders, including an
#        AT-first transaction. The property holds twice over; there is no assertion that could witness it.
#      * the CONSUME direction for a BARE reference was already covered before this section existed: the
#        `AT (VERSION => 1)` assertion in section 1 catches an AT scan that falls through to the pinned read
#        (bypassing the early return fails THERE first).
#    So what sections 9-10 genuinely add is (a) the SHAPES -- AT under a join, AT on both sides at different
#    versions, AT in the middle of a transaction -- which would catch a regression that honours AT for a bare
#    SELECT but not beneath a join, and (b) section 10, the only coverage of the native precedence CHAIN,
#    where a reordering is a one-line mistake and is caught nowhere else (verified: reordering it fails 10
#    while 1-9 all still pass).
# ---------------------------------------------------------------------------------------------------------
statement ok
CREATE TABLE lake.main.atmix AS SELECT 1 AS id;

statement ok
INSERT INTO lake.main.atmix VALUES (2);

statement ok
INSERT INTO lake.main.atmix VALUES (3);

# v0 = the CTAS's empty CREATE, v1 = its data write (1 row), then one row per INSERT.
query I
SELECT count(*) FROM lake.delta.snapshots('atmix');
----
4

# AT first, then latest: the AT reference must NOT seed the pin, so the second reference still reads latest.
query II
SELECT (SELECT count(*) FROM lake.main.atmix AT (VERSION => 1)) AS at_v1,
       (SELECT count(*) FROM lake.main.atmix) AS latest;
----
1	3

# Order reversed: the pin now EXISTS when the AT reference runs, and must not override it.
query II
SELECT (SELECT count(*) FROM lake.main.atmix) AS latest,
       (SELECT count(*) FROM lake.main.atmix AT (VERSION => 1)) AS at_v1;
----
3	1

# A self-join with AT on ONE side is two different table states BY REQUEST -- v1 holds {1}, latest {1,2,3}.
query I
SELECT a.id FROM lake.main.atmix AS a AT (VERSION => 1) JOIN lake.main.atmix AS b ON a.id = b.id;
----
1

# AT on BOTH sides at DIFFERENT versions: neither is collapsed into the other (v2 = {1,2}, v3 = {1,2,3}).
query I
SELECT a.id FROM lake.main.atmix AS a AT (VERSION => 2) JOIN lake.main.atmix AS b AT (VERSION => 3) ON a.id = b.id
ORDER BY a.id;
----
1
2

# Inside an EXPLICIT transaction the pin is instant-resolved at the first scan; an AT reference in the middle
# must leave it intact, so the third read still sees the transaction's cut rather than the travelled version.
statement ok
BEGIN;

query I
SELECT count(*) FROM lake.main.atmix;
----
3

query I
SELECT count(*) FROM lake.main.atmix AT (VERSION => 1);
----
1

query I
SELECT count(*) FROM lake.main.atmix;
----
3

statement ok
COMMIT;

# ---------------------------------------------------------------------------------------------------------
# 10. The same interaction on the NATIVE read path, whose AT precedence is a chain rather than an early
#     return -- a reordering of those branches would not be caught by section 9.
# ---------------------------------------------------------------------------------------------------------
statement ok
CREATE TABLE nlake.main.natmix AS SELECT 1 AS id;

statement ok
INSERT INTO nlake.main.natmix VALUES (2);

statement ok
INSERT INTO nlake.main.natmix VALUES (3);

query II
SELECT (SELECT count(*) FROM nlake.main.natmix AT (VERSION => 1)) AS at_v1,
       (SELECT count(*) FROM nlake.main.natmix) AS latest;
----
1	3

query II
SELECT (SELECT count(*) FROM nlake.main.natmix) AS latest,
       (SELECT count(*) FROM nlake.main.natmix AT (VERSION => 1)) AS at_v1;
----
3	1

query I
SELECT a.id FROM nlake.main.natmix AS a AT (VERSION => 1) JOIN nlake.main.natmix AS b ON a.id = b.id;
----
1

query I
SELECT a.id FROM nlake.main.natmix AS a AT (VERSION => 2) JOIN nlake.main.natmix AS b AT (VERSION => 3) ON a.id = b.id
ORDER BY a.id;
----
1
2

# ---------------------------------------------------------------------------------------------------------
# 11. The NATIVE path's pin is SHARED too, and now costs nothing. It used to resolve through
#     ResolveVersionAsOf -- a WHOLE extra DeltaTable open (its own _delta_log LIST plus a timestamp->version
#     scan of the commit timestamps), which was this path's measured "+1 snapshot construction per statement"
#     against the codec. It now consults an existing pin first and otherwise seeds from the schema/listing
#     open it was already doing, exactly as ScanCodec does. Same assertion shape as sections 1-2: the branch
#     runs at most ONCE per (txn, table), so the line COUNT is the sharing property. Its own table and a
#     SINGLE statement, because every autocommit statement is its own transaction and therefore its own pin
#     -- a total over several statements would be brittle rather than meaningful.
# ---------------------------------------------------------------------------------------------------------
statement ok
CREATE TABLE nlake.main.npin AS SELECT i AS id, i * 2 AS v FROM range(6) tbl(i);

query I
SELECT sum(a.v) FROM nlake.main.npin a JOIN nlake.main.npin b ON a.id = b.id;
----
30

# ONE line for a self-join (two references, four ScanNative calls). Per-reference resolution would give more;
# no pin at all would give zero and lose the consistent cut this exists to provide.
query I
SELECT count(*) FROM duckdb_logs
WHERE type = 'Fabricator.Delta' AND message LIKE 'delta % pin %/npin -> v%';
----
1

# And the codec's message is NOT emitted here. ⚠ Since the bind probe seeds the pin, that zero no longer
# discriminates on its own (see the note in section 8) — it is kept because a codec pin appearing here would
# still be a real regression, and paired with the direct engine control below.
query I
SELECT count(*) FROM duckdb_logs
WHERE type = 'Fabricator.Delta' AND message LIKE 'delta codec pin %/npin -> v%';
----
0

query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type = 'Fabricator.Delta.Native' AND message LIKE 'delta native scan %/npin:%';
----
true

# The retired resolver logged unconditionally in BOTH its success and catch branches, so the absence of its
# message is proof the extra open is gone rather than merely quiet. Covers every table in this suite.
query I
SELECT count(*) FROM duckdb_logs
WHERE type = 'Fabricator.Delta' AND message LIKE 'delta snapshot pin:%as-of%';
----
0

# ---------------------------------------------------------------------------------------------------------
# 12. THE PINS SURVIVE A MUTATING ENTRY POINT MID-TRANSACTION — the releases' asymmetry, gated for the first
#     time. Every mutating catalog entry (CREATE OR REPLACE, DROP, OPTIMIZE, VACUUM, ...) drops the
#     transaction's held OPEN TABLES (InvalidateReadCache) but must KEEP its snapshot PINS: the pin is the
#     transaction's repeatable-read contract, and a transaction that mutated something must still re-read an
#     unrelated table at the version it first read.
#
#     WHY THIS IS ASSERTABLE ONLY SINCE THE 4b PIN UNIFICATION: the pin used to be DOUBLE-STORED —
#     PendingAppends.PinnedVersion on the transaction buffer shadowed the scope's pins on every path a
#     sequential suite reaches, so a mutant that collapsed the two releases SURVIVED the whole tier
#     (slice 1b's recorded surviving mutant). With ONE pin store, dropping the pins alongside the tables
#     makes the re-read RE-SEED (a second 'delta % pin' line for the table); keeping them leaves the count at
#     one. The VALUE cannot discriminate sequentially (no concurrent writer, so a re-pin lands on the same
#     version) — the line count is the property, exactly as in sections 1-6.
# ---------------------------------------------------------------------------------------------------------
statement ok
CREATE TABLE lake.main.pinkeep AS SELECT i AS id, i * 2 AS v FROM range(6) tbl(i);

statement ok
CREATE TABLE lake.main.pinvictim AS SELECT 1 AS x;

statement ok
BEGIN;

query I
SELECT sum(v) FROM lake.main.pinkeep;
----
30

# A mutating entry point mid-transaction: DROP of an UNRELATED table (immediate by design; it calls
# InvalidateReadCache, which drops the transaction's open tables — and, under the mutant, its pins).
statement ok
DROP TABLE lake.main.pinvictim;

# The re-read must be served from the SURVIVING pin: no second resolution, no second pin line.
query I
SELECT sum(v) FROM lake.main.pinkeep;
----
30

statement ok
COMMIT;

query I
SELECT count(*) FROM duckdb_logs
WHERE type = 'Fabricator.Delta' AND message LIKE 'delta % pin %/pinkeep -> v%';
----
1

statement ok
DETACH nlake;

statement ok
DETACH lake;
