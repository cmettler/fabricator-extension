# name: test/verify_delta_rs_maintenance.test
# description: delta-rs provider maintenance ops (engineered-wood has none) via a small command dialect on
#              mssql_net_exec('<catalog>', '<cmd>'): OPTIMIZE [ZORDER (...)], VACUUM [RETAIN n HOURS] [DRY RUN],
#              CHECKPOINT. Pure C# (ExecuteNonQuery) — no ABI/C++ change. Requires the delta-rs native libs
#              published (publish-managed.ps1 -IncludeDeltaRs). Local FS.
# group: [mssql_net]

require mssql_net

require-env ARROWNET_DELTA_WRITE_DIR

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/drm' AS lake (TYPE arrownet, PROVIDER 'deltars');

# Several small writes create several small files (a bin-pack candidate).
statement ok
CREATE TABLE lake.main.t AS SELECT * FROM (VALUES (1,'a'),(2,'b'),(3,'c')) v(id,name);

statement ok
INSERT INTO lake.main.t VALUES (4,'d');

statement ok
INSERT INTO lake.main.t VALUES (5,'e');

# OPTIMIZE (bin-pack) — commits a new OPTIMIZE version.
query I
SELECT mssql_net_exec('lake', 'OPTIMIZE main.t');
----
0

# CHECKPOINT (log compaction; no new data version).
query I
SELECT mssql_net_exec('lake', 'CHECKPOINT main.t');
----
0

# VACUUM DRY RUN (safe: lists, deletes nothing).
query I
SELECT mssql_net_exec('lake', 'VACUUM main.t RETAIN 168 HOURS DRY RUN');
----
0

# Data survives every maintenance op.
query I
SELECT count(*) FROM lake.main.t;
----
5

# OPTIMIZE is recorded in the commit history.
query T
SELECT operation FROM arrownet_delta_snapshots('lake', 'main.t') WHERE operation = 'OPTIMIZE';
----
OPTIMIZE

# Z-order clustering (headline delta-rs feature) via the dialect.
query I
SELECT mssql_net_exec('lake', 'OPTIMIZE main.t ZORDER (id)');
----
0

# An unknown maintenance verb errors cleanly.
statement error
SELECT mssql_net_exec('lake', 'FROBNICATE main.t');
----
FROBNICATE

statement ok
DETACH lake;
