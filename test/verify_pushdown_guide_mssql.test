# name: test/verify_pushdown_guide_mssql.test
# description: Every example of docs/sql-server-pushdown.md, by its id (S1, D2, …): where it runs — the EXPLAIN marker
#              the guide names — and what it answers. A change of routing fails here first, and then the guide is
#              wrong too: update both together. Needs MSSQL_TESTDB_DSN.
# group: [fabricator]

require fabricator

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS mssql (TYPE fabricator);

# ═══ Setup (the guide's "Example tables") ══════════════════════════════════════════════════════════════

statement ok
SELECT fabricator_exec('mssql', 'DROP TABLE IF EXISTS dbo.pg_sales; DROP TABLE IF EXISTS dbo.pg_regions; DROP TABLE IF EXISTS dbo.pg_sales_eu; DROP TABLE IF EXISTS dbo.pg_totals; DROP TABLE IF EXISTS dbo.pg_clicks;');

statement ok
SELECT fabricator_exec('mssql', 'CREATE TABLE dbo.pg_clicks (id INT PRIMARY KEY, region VARCHAR(2) NOT NULL);
INSERT INTO dbo.pg_clicks SELECT value, CHOOSE(value % 3 + 1, ''EU'', ''US'', ''AP'') FROM GENERATE_SERIES(1, 3000);');

statement ok
SELECT fabricator_exec('mssql', 'CREATE TABLE dbo.pg_regions (region VARCHAR(2) PRIMARY KEY, name NVARCHAR(30));
CREATE TABLE dbo.pg_sales (id INT PRIMARY KEY, region VARCHAR(2), amount DECIMAL(10,2), sold DATE, note NVARCHAR(50));
CREATE TABLE dbo.pg_sales_eu (id INT, amount DECIMAL(10,2), loaded DATETIME2 DEFAULT SYSDATETIME());
INSERT INTO dbo.pg_regions VALUES (''EU'', N''Europe''), (''US'', N''Americas'');
INSERT INTO dbo.pg_sales VALUES (1,''EU'',10,''2026-01-05'',N''first''),(2,''US'',20,''2026-02-01'',NULL),(3,''EU'',30,''2026-02-07'',N''Größe''),(4,''US'',5,''2025-12-30'',N''late'');', refresh_cache := true);

statement ok
SELECT fabricator_exec('mssql', 'CREATE OR ALTER FUNCTION dbo.pg_net(@a DECIMAL(10,2)) RETURNS DECIMAL(10,2) AS BEGIN RETURN @a * 0.8 END');

statement ok
SELECT fabricator_exec('mssql', 'CREATE OR ALTER FUNCTION dbo.pg_region_sales(@r VARCHAR(2)) RETURNS TABLE AS RETURN (SELECT id, amount FROM dbo.pg_sales WHERE region = @r)', refresh_cache := true);

# ═══ S — SELECT ════════════════════════════════════════════════════════════════════════════════════════

# S1: a join with an aggregate runs as one T-SQL statement
query II
EXPLAIN SELECT r.name, count(*) AS n, sum(s.amount) AS total FROM mssql.dbo.pg_sales s JOIN mssql.dbo.pg_regions r USING (region) GROUP BY r.name ORDER BY total DESC;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query TII
SELECT r.name, count(*) AS n, sum(s.amount) AS total FROM mssql.dbo.pg_sales s JOIN mssql.dbo.pg_regions r USING (region) GROUP BY r.name ORDER BY total DESC;
----
Europe	2	40.00
Americas	2	25.00

# S2: a plain scan keeps the table scan; its filter still goes to the server
query II
EXPLAIN SELECT id, amount FROM mssql.dbo.pg_sales WHERE amount > 15;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

query II
EXPLAIN SELECT id, amount FROM mssql.dbo.pg_sales WHERE amount > 15;
----
physical_plan	<REGEX>:.*Fabricator Scan.*

# S3: a function with no exact T-SQL (regular expressions) keeps the whole query local
query II
EXPLAIN SELECT id FROM mssql.dbo.pg_sales WHERE regexp_matches(note, 'i.s') GROUP BY id;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

query I
SELECT id FROM mssql.dbo.pg_sales WHERE regexp_matches(note, 'i.s') GROUP BY id;
----
1

# S4: a join with a local table: the remote table is scanned, the join runs in DuckDB
statement ok
CREATE TEMP TABLE targets AS SELECT 'EU' AS region, 25 AS target;

query II
EXPLAIN SELECT t.region, sum(s.amount) - t.target AS gap FROM mssql.dbo.pg_sales s JOIN targets t USING (region) GROUP BY t.region, t.target;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

query TI
SELECT t.region, sum(s.amount) - t.target AS gap FROM mssql.dbo.pg_sales s JOIN targets t USING (region) GROUP BY t.region, t.target;
----
EU	15.00

# S5: the aggregate in a subquery reads the server alone: that part runs as one query, the join with the local table in
# DuckDB
query II
EXPLAIN SELECT t.region, s.total - t.target AS gap FROM targets t JOIN (SELECT region, sum(amount) AS total FROM mssql.dbo.pg_sales GROUP BY region) s USING (region);
----
physical_plan	<REGEX>:.*Fabricator Query.*

query TI
SELECT t.region, s.total - t.target AS gap FROM targets t JOIN (SELECT region, sum(amount) AS total FROM mssql.dbo.pg_sales GROUP BY region) s USING (region);
----
EU	15.00

# S6: a scalar subquery over the catalog
query II
EXPLAIN SELECT region, target - (SELECT max(amount) FROM mssql.dbo.pg_sales) AS below_max FROM targets;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query TI
SELECT region, target - (SELECT max(amount) FROM mssql.dbo.pg_sales) AS below_max FROM targets;
----
EU	-5.00

# S7: a WHERE on a column of the part goes into the server query (taken after DuckDB moved the condition down)
query II
EXPLAIN SELECT t.region, s.total FROM targets t JOIN (SELECT region, sum(amount) AS total FROM mssql.dbo.pg_sales GROUP BY region) s USING (region) WHERE s.region = 'EU';
----
physical_plan	<REGEX>:.*Fabricator Query.*

query TI
SELECT t.region, s.total FROM targets t JOIN (SELECT region, sum(amount) AS total FROM mssql.dbo.pg_sales GROUP BY region) s USING (region) WHERE s.region = 'EU';
----
EU	40.00

# S8: a SQL Server UDF is called on the server, by its schema and name
query II
EXPLAIN SELECT region, sum(mssql.dbo.pg_net(amount)) AS net FROM mssql.dbo.pg_sales GROUP BY region ORDER BY 1;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query TT
SELECT region, sum(mssql.dbo.pg_net(amount)) AS net FROM mssql.dbo.pg_sales GROUP BY region ORDER BY 1;
----
EU	32.00
US	20.00

# S9: a LATERAL subquery with a LIMIT per row — DuckDB turns it into a CTE and joins, which the server gets inlined
query II
EXPLAIN SELECT r.name, x.amount FROM mssql.dbo.pg_regions r, LATERAL (SELECT s.amount FROM mssql.dbo.pg_sales s WHERE s.region = r.region AND s.amount >= 10 ORDER BY s.amount DESC LIMIT 1) x ORDER BY 1;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query TT
SELECT r.name, x.amount FROM mssql.dbo.pg_regions r, LATERAL (SELECT s.amount FROM mssql.dbo.pg_sales s WHERE s.region = r.region AND s.amount >= 10 ORDER BY s.amount DESC LIMIT 1) x ORDER BY 1;
----
Americas	20.00
Europe	30.00

# S10: a table-valued function with constant arguments, joined with a table of the catalog: one statement
query II
EXPLAIN SELECT r.name, s.id, s.amount FROM mssql.dbo.pg_region_sales('EU') s CROSS JOIN mssql.dbo.pg_regions r WHERE r.region = 'EU' ORDER BY 2;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query TIT
SELECT r.name, s.id, s.amount FROM mssql.dbo.pg_region_sales('EU') s CROSS JOIN mssql.dbo.pg_regions r WHERE r.region = 'EU' ORDER BY 2;
----
Europe	1	10.00
Europe	3	30.00

# S11: the same function called per row of a local table: one CROSS APPLY per chunk of distinct arguments
query II
EXPLAIN SELECT t.region, s.id FROM targets t, mssql.dbo.pg_region_sales(t.region) s;
----
physical_plan	<REGEX>:.*Fabricator Lateral Batched.*

query TI
SELECT t.region, s.id FROM targets t, mssql.dbo.pg_region_sales(t.region) s ORDER BY 2;
----
EU	1
EU	3

# S12: the same function called per row of a table OF THE CATALOG: one statement, FROM … CROSS APPLY [dbo].[f](…)
query II
EXPLAIN SELECT r.name, s.id FROM mssql.dbo.pg_regions r, mssql.dbo.pg_region_sales(r.region) s;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query TI
SELECT r.name, s.id FROM mssql.dbo.pg_regions r, mssql.dbo.pg_region_sales(r.region) s ORDER BY 2;
----
Europe	1
Americas	2
Europe	3
Americas	4

# S13: a count that reads no column runs on the server; reading the row id keeps the scan
query II
EXPLAIN SELECT count(*) FROM mssql.dbo.pg_sales;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query I
SELECT count(*) FROM mssql.dbo.pg_sales;
----
4

query II
EXPLAIN SELECT count(rowid) FROM mssql.dbo.pg_sales;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

# S14: ||, trim, left / right and a date cast of a timestamp are pushed; a negative count stays local
query II
EXPLAIN SELECT id, region || '-' || note AS label, trim(note) AS t, left(note, 3) AS l FROM mssql.dbo.pg_sales ORDER BY id LIMIT 3;
----
physical_plan	<REGEX>:.*Fabricator Query.*

query IIII
SELECT id, region || '-' || note AS label, trim(note) AS t, left(note, 3) AS l FROM mssql.dbo.pg_sales ORDER BY id LIMIT 3;
----
1	EU-first	first	fir
2	NULL	NULL	NULL
3	EU-Größe	Größe	Grö

query II
EXPLAIN SELECT count(*) FROM mssql.dbo.pg_sales_eu WHERE CAST(loaded AS DATE) = DATE '2026-01-05';
----
physical_plan	<REGEX>:.*Fabricator Query.*

query II
EXPLAIN SELECT id, left(note, -1) FROM mssql.dbo.pg_sales ORDER BY id LIMIT 3;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

# J1: a table joined with local data: the join's keys reach the scan's WHERE as a runtime filter (EXPLAIN does not
# show it — the filter is made at execution — the statement in Fabricator.Sql does)
statement ok
CALL enable_logging(['Fabricator.Sql'], storage := 'memory', level := 'debug');

query TI
SELECT t.region, count(*) FROM targets t JOIN mssql.dbo.pg_clicks c ON c.region = t.region GROUP BY t.region;
----
EU	1000

query I
SELECT count(*) > 0 FROM duckdb_logs WHERE type = 'Fabricator.Sql' AND message LIKE '%FROM [dbo].[pg_clicks] WHERE [region] = @p0%';
----
true

statement ok
CALL truncate_duckdb_logs();

# J2: a part computed per local key (here a Top-2 per region) runs on the server for those keys only
query TI
SELECT t.region, c.id FROM targets t,
       LATERAL (SELECT id FROM mssql.dbo.pg_clicks c WHERE c.region = t.region ORDER BY id DESC LIMIT 2) c ORDER BY 2;
----
EU	2997
EU	3000

query I
SELECT count(*) FROM duckdb_logs WHERE type = 'Fabricator.Sql' AND contains(message, ') AS [q] WHERE [c')
  AND contains(message, 'OPTION (RECOMPILE)');
----
1

statement ok
CALL truncate_duckdb_logs();

# the switch for parts of statements: S5 runs locally again, same answer
statement ok
SET fabricator_subtree_pushdown = false;

query II
EXPLAIN SELECT t.region, s.total - t.target AS gap FROM targets t JOIN (SELECT region, sum(amount) AS total FROM mssql.dbo.pg_sales GROUP BY region) s USING (region);
----
physical_plan	<!REGEX>:.*Fabricator Query.*

query TI
SELECT t.region, s.total - t.target AS gap FROM targets t JOIN (SELECT region, sum(amount) AS total FROM mssql.dbo.pg_sales GROUP BY region) s USING (region);
----
EU	15.00

statement ok
SET fabricator_subtree_pushdown = true;

# ═══ I / C — INSERT … SELECT and CREATE TABLE … AS ═════════════════════════════════════════════════════

# I1: INSERT … SELECT within the catalog: one INSERT … SELECT on the server
query II
EXPLAIN INSERT INTO mssql.dbo.pg_sales_eu (id, amount) SELECT id, amount FROM mssql.dbo.pg_sales WHERE region = 'EU';
----
physical_plan	<REGEX>:.*FABRICATOR_REMOTE_DML.*

query I
INSERT INTO mssql.dbo.pg_sales_eu (id, amount) SELECT id, amount FROM mssql.dbo.pg_sales WHERE region = 'EU';
----
2

# the server applied the default of the column the statement did not name
query I
SELECT count(*) FROM mssql.dbo.pg_sales_eu WHERE loaded IS NOT NULL;
----
2

# I2: INSERT … VALUES: the regular insert (bulk copy)
query II
EXPLAIN INSERT INTO mssql.dbo.pg_sales_eu (id, amount) VALUES (99, 1);
----
physical_plan	<REGEX>:.*Mssql Net Insert.*

# C1: CREATE TABLE … AS over an aggregate: table created as usual, filled on the server
query II
EXPLAIN CREATE TABLE mssql.dbo.pg_totals AS SELECT region, sum(amount) AS total FROM mssql.dbo.pg_sales GROUP BY region;
----
physical_plan	<REGEX>:.*Fabricator Remote Ctas.*

query I
CREATE TABLE mssql.dbo.pg_totals AS SELECT region, sum(amount) AS total FROM mssql.dbo.pg_sales GROUP BY region;
----
2

# C2: CREATE TABLE … AS over a plain scan: the rows stream through DuckDB into a bulk copy
query II
EXPLAIN CREATE TABLE mssql.dbo.pg_totals2 AS SELECT * FROM mssql.dbo.pg_sales;
----
physical_plan	<REGEX>:.*Mssql Net Create Table As.*

# ═══ D / U — DELETE and UPDATE ═════════════════════════════════════════════════════════════════════════

# D1: a predicate on exact types: one DELETE on the server
query II
EXPLAIN DELETE FROM mssql.dbo.pg_sales WHERE sold < DATE '2026-01-01';
----
physical_plan	<REGEX>:.*FABRICATOR_REMOTE_DML.*

# D2: a string comparison, compared exactly as DuckDB does (case- and trailing-space-sensitive): one DELETE
query II
EXPLAIN DELETE FROM mssql.dbo.pg_sales WHERE region = 'US';
----
physical_plan	<REGEX>:.*FABRICATOR_REMOTE_DML.*

# D3: a subquery over another table of the catalog: one DELETE … WHERE EXISTS
query II
EXPLAIN DELETE FROM mssql.dbo.pg_sales WHERE region IN (SELECT region FROM mssql.dbo.pg_regions WHERE name = 'Americas');
----
physical_plan	<REGEX>:.*FABRICATOR_REMOTE_DML.*

# D4: a function with no exact T-SQL: scan, then delete by key
query II
EXPLAIN DELETE FROM mssql.dbo.pg_sales WHERE regexp_matches(note, '^l');
----
physical_plan	<REGEX>:.*Mssql Net Delete.*

# U1: DECIMAL arithmetic in SET: one UPDATE on the server
query II
EXPLAIN UPDATE mssql.dbo.pg_sales SET amount = amount * 2 WHERE id = 1;
----
physical_plan	<REGEX>:.*FABRICATOR_REMOTE_DML.*

# U2: UPDATE … FROM another table: scan, then update by key (a target row the join matched twice would be updated
# with whichever match SQL Server takes)
query II
EXPLAIN UPDATE mssql.dbo.pg_sales SET note = r.name FROM mssql.dbo.pg_regions r WHERE pg_sales.region = r.region;
----
physical_plan	<REGEX>:.*Mssql Net Update.*

# U3: with remote_pushdown off, a predicate on exact types is still one statement — the plan-less shortcut
statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS mssql_np (TYPE fabricator, remote_pushdown 'false');

query II
EXPLAIN UPDATE mssql_np.dbo.pg_sales SET amount = 12.50 WHERE id = 1;
----
physical_plan	<REGEX>:.*Fabricator Update Where.*

statement ok
DETACH mssql_np;

# the guide's DELETE / UPDATE examples answer as DuckDB would
query I
UPDATE mssql.dbo.pg_sales SET amount = amount * 2 WHERE id = 1;
----
1

query I
SELECT amount FROM mssql.dbo.pg_sales WHERE id = 1;
----
20.00

# R1: INSERT … RETURNING
query I
INSERT INTO mssql.dbo.pg_sales_eu (id, amount) VALUES (7, 7) RETURNING id;
----
7

# R2: DELETE … RETURNING — the deleted rows come from the DELETE itself (T-SQL OUTPUT DELETED.*)
query II
EXPLAIN DELETE FROM mssql.dbo.pg_sales WHERE id = 4 RETURNING id;
----
physical_plan	<REGEX>:.*Mssql Net Delete.*

query IT
DELETE FROM mssql.dbo.pg_sales WHERE id = 4 RETURNING id, note;
----
4	late

# R3: UPDATE … RETURNING returns the NEW values
query IT
UPDATE mssql.dbo.pg_sales SET amount = 1 WHERE id = 2 RETURNING id, amount;
----
2	1.00

# R4: the data-modifying CTE that moves rows (DuckDB 2.0) — ONE server statement, DELETE … OUTPUT DELETED.* INTO
statement ok
SELECT fabricator_exec('mssql', 'DROP TABLE IF EXISTS dbo.pg_archive; CREATE TABLE dbo.pg_archive (id INT PRIMARY KEY, region VARCHAR(2), amount DECIMAL(10,2), sold DATE, note NVARCHAR(50));', refresh_cache := true);

query II
EXPLAIN WITH moved AS MATERIALIZED (DELETE FROM mssql.dbo.pg_sales WHERE sold < DATE '2026-02-01' RETURNING *)
INSERT INTO mssql.dbo.pg_archive SELECT * FROM moved;
----
physical_plan	<REGEX>:.*FABRICATOR_REMOTE_DML.*

query I
WITH moved AS MATERIALIZED (DELETE FROM mssql.dbo.pg_sales WHERE sold < DATE '2026-02-01' RETURNING *)
INSERT INTO mssql.dbo.pg_archive SELECT * FROM moved;
----
1

query II
SELECT (SELECT count(*) FROM mssql.dbo.pg_sales), (SELECT string_agg(id::VARCHAR, ',') FROM mssql.dbo.pg_archive);
----
2	1

# M1: MERGE as one statement — several WHEN clauses, first true one wins
query II
EXPLAIN MERGE INTO mssql.dbo.pg_sales AS t USING (SELECT id, amount FROM mssql.dbo.pg_sales_eu) AS src ON t.id = src.id
WHEN MATCHED AND src.amount > 100 THEN DELETE WHEN MATCHED THEN UPDATE SET amount = src.amount
WHEN NOT MATCHED THEN INSERT (id, region, amount) VALUES (src.id, 'EU', src.amount);
----
physical_plan	<REGEX>:.*FABRICATOR_REMOTE_DML.*

# M2: with RETURNING it runs in DuckDB (merge by key)
query II
EXPLAIN MERGE INTO mssql.dbo.pg_sales AS t USING (SELECT id, amount FROM mssql.dbo.pg_sales_eu) AS src ON t.id = src.id
WHEN MATCHED THEN UPDATE SET amount = src.amount RETURNING merge_action, id;
----
physical_plan	<!REGEX>:.*FABRICATOR_REMOTE_DML.*

# ═══ L — why it ran where it ran (duckdb_logs) ══════════════════════════════════════════════════════════

statement ok
CALL enable_logging(['Fabricator.Remote', 'Fabricator.Dml', 'Fabricator.Sql'], storage := 'memory');

# L1: a statement that stays local says why
statement ok
SELECT id FROM mssql.dbo.pg_sales WHERE regexp_matches(note, 'i.s') GROUP BY id;

query I
SELECT count(*) FROM duckdb_logs WHERE type = 'Fabricator.Remote'
  AND message LIKE 'local: no Substrait translation: Could not find function "regexp_matches"%';
----
1

statement ok
CALL truncate_duckdb_logs();

# L2: a part of a statement that reads only the server and still stays local: cf_add is a function the provider
# implements in C#, not one of the server
statement ok
SELECT t.region, s.n FROM (VALUES ('EU')) t(region) JOIN (SELECT region, sum(mssql.dbo.cf_add(id, 1)) AS n FROM mssql.dbo.pg_sales GROUP BY region) s USING (region);

query I
SELECT count(*) FROM duckdb_logs WHERE type = 'Fabricator.Remote'
  AND message LIKE 'local subtree (before the optimizers): %dbo.cf_add() is not a function of the server';
----
1

statement ok
CALL truncate_duckdb_logs();

# L3: a DELETE that takes the key path names the condition that has no exact T-SQL
statement ok
EXPLAIN DELETE FROM mssql.dbo.pg_sales WHERE regexp_matches(note, '^l');

query I
SELECT count(*) FROM duckdb_logs WHERE type = 'Fabricator.Dml'
  AND message = 'rowid path: the predicate does not render exactly: ((note >= ''l'') AND (note < ''m'')) (BOUND_CONJUNCTION)';
----
1

statement ok
CALL truncate_duckdb_logs();

# L4: what was pushed, and the T-SQL SQL Server received
statement ok
SELECT r.name, count(*) AS n FROM mssql.dbo.pg_sales s JOIN mssql.dbo.pg_regions r USING (region) GROUP BY r.name;

query I
SELECT count(*) FROM duckdb_logs WHERE type = 'Fabricator.Remote' AND message LIKE 'remote: SELECT %GROUP BY%';
----
1

# the statement as sent (whitespace collapsed, cut after 400 characters — the Fabricator.Remote line has it whole)
query I
SELECT count(*) FROM duckdb_logs WHERE type = 'Fabricator.Sql' AND message LIKE 'query [%]: SELECT CONVERT(nvarchar(max), %';
----
1

statement ok
CALL disable_logging();

# ═══ Switches ══════════════════════════════════════════════════════════════════════════════════════════

statement ok
SET fabricator_dml_pushdown = false;

query II
EXPLAIN INSERT INTO mssql.dbo.pg_sales_eu (id, amount) SELECT id, amount FROM mssql.dbo.pg_sales WHERE region = 'EU';
----
physical_plan	<!REGEX>:.*FABRICATOR_REMOTE_DML.*

query II
EXPLAIN DELETE FROM mssql.dbo.pg_sales WHERE sold < DATE '2026-01-01';
----
physical_plan	<!REGEX>:.*Fabricator Delete Where.*

statement ok
RESET fabricator_dml_pushdown;

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS mssql_off (TYPE fabricator, remote_pushdown 'false');

query II
EXPLAIN SELECT r.name, count(*) AS n FROM mssql_off.dbo.pg_sales s JOIN mssql_off.dbo.pg_regions r USING (region) GROUP BY r.name;
----
physical_plan	<!REGEX>:.*Fabricator Query.*

statement ok
DETACH mssql_off;

# ═══ Cleanup ═══════════════════════════════════════════════════════════════════════════════════════════

statement ok
SELECT fabricator_exec('mssql', 'DROP TABLE IF EXISTS dbo.pg_sales; DROP TABLE IF EXISTS dbo.pg_regions; DROP TABLE IF EXISTS dbo.pg_sales_eu; DROP TABLE IF EXISTS dbo.pg_totals; DROP TABLE IF EXISTS dbo.pg_archive; DROP FUNCTION IF EXISTS dbo.pg_net; DROP FUNCTION IF EXISTS dbo.pg_region_sales; DROP TABLE IF EXISTS dbo.pg_clicks;');
