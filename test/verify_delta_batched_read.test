# ============================================================================
# 12. TOPN PUSHDOWN — THE PUSHED ORDER BY IS RENDERED TOO (2026-08-16). Until this, `TryPushTopN` sent
#     `top` and `order_by` as a PAIR and this reader used NEITHER: it declined the limit whenever an
#     order came with it, because a limit applied without its order is an arbitrary subset that the TopN
#     DuckDB keeps above the scan cannot repair — it re-sorts whatever arrives, and the rows it needed
#     are simply gone. Now the order is rendered into the generated SQL, which is executed BY DuckDB, so
#     the comparator picking the top-n IS that kept TopN's comparator.
#     TWO capabilities had to be declared before any of this could fire (DeltaCatalog.CapabilitiesJson),
#     and each is pinned by its own leg below:
#       - `is_binary_collation` — string keys were refused OUTRIGHT (§12d);
#       - `null_order_expressible` — without it the SQL-Server-shaped NullOrderCompatible gate rejects
#         ASC + NULLS LAST, which is DuckDB's DEFAULT, so `ORDER BY x LIMIT n` on a NULLABLE column —
#         the shape people actually write — never pushed at all (§12a). Delta CTAS columns are nullable
#         (verified in the metaData schemaString), so this is the ordinary case, not a corner.
#     ⚠ THE ROW ASSERTIONS ARE THE LOAD-BEARING HALF, unlike §10/§11 where the answer is form-independent
#     and only the routing could regress. Here a pushdown that renders the limit and drops or mis-renders
#     the order returns the WRONG ROWS, not slow ones. So every leg pins exact ORDERED values over a
#     MULTI-FILE table, where a per-file or per-branch cap under the wrong order provably loses the true
#     top-n — on a single-file table it could not.
#     ⚠ `topn` carries actual NULLs, which `route_plain` does not: null PLACEMENT is unobservable in the
#     rows of a table that has none, so §12b would pin nothing against that fixture.
#     ⚠ THE PER-FILE LOOP LEG IS VERIFIED BY PROBE, NOT PINNED, and saying so is the honest form: at this
#     suite's thresholds no TopN shape reaches the loop (it is reached by a rowid-only projection or a
#     per-file predicate, and a predicate suppresses `top` at the host — §11d). It cannot regress on its
#     own, because the loop appends the SAME `topSuffix` string, built once, that the batch legs assert.
# ============================================================================

statement ok
CREATE TABLE b.main.topn AS
  SELECT CASE WHEN i % 10 = 0 THEN NULL ELSE i END::BIGINT AS id, ('t' || i)::VARCHAR AS s FROM range(50) r(i);

statement ok
INSERT INTO b.main.topn
  SELECT CASE WHEN i % 10 = 0 THEN NULL ELSE i END::BIGINT, ('t' || i)::VARCHAR FROM range(50, 100) r(i);

statement ok
INSERT INTO b.main.topn
  SELECT CASE WHEN i % 10 = 0 THEN NULL ELSE i END::BIGINT, ('t' || i)::VARCHAR FROM range(100, 150) r(i);

# 12a. THE HEADLINE SHAPE: a bare `ORDER BY id LIMIT n` on a nullable column. Before the
#      `null_order_expressible` capability the host declined this outright (`top=-`), so the reader never
#      saw it; now it arrives AND is rendered with the RESOLVED placement, not the parsed one — there is
#      no modifier in the SQL text to copy.
query I
SELECT id FROM b.main.topn ORDER BY id LIMIT 5;
----
1
2
3
4
5

query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type LIKE 'Fabricator.Delta%' AND message LIKE '%delta native scan%'
  AND message LIKE '%topn%' AND message LIKE '%top=5%'
  AND message LIKE '%sort=[ORDER BY "id" ASC NULLS LAST]%';
----
true

query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type LIKE 'Fabricator.Delta%' AND message LIKE '%delta native batch%'
  AND message LIKE '%topn%' AND message LIKE '%schema = map%'
  AND message LIKE '%ORDER BY "id" ASC NULLS LAST LIMIT 5%';
----
true

# 12b. NULL PLACEMENT IS RENDERED, not left to the inner statement's own default. The inner query runs on
#      its OWN connection, where `default_null_order` would resolve ASC to NULLS LAST — so dropping the
#      rendering returns ids 1..5 here instead of the NULLs the outer TopN asked for, and the kept TopN
#      cannot recover rows that never arrived. `id IS NULL` is what makes that visible in one column.
query I
SELECT id IS NULL FROM b.main.topn ORDER BY id ASC NULLS FIRST LIMIT 5;
----
true
true
true
true
true

query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type LIKE 'Fabricator.Delta%' AND message LIKE '%delta native batch%'
  AND message LIKE '%topn%' AND message LIKE '%ORDER BY "id" ASC NULLS FIRST LIMIT 5%';
----
true

# 12c. DESC, and a multi-key order in the same statement — every key must be rendered, since the provider
#      ordering by a PREFIX of the keys would trim on a coarser order than DuckDB's.
query II
SELECT id, s FROM b.main.topn ORDER BY id DESC, s ASC LIMIT 3;
----
149	t149
148	t148
147	t147

query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type LIKE 'Fabricator.Delta%' AND message LIKE '%delta native batch%'
  AND message LIKE '%topn%'
  AND message LIKE '%ORDER BY "id" DESC NULLS LAST, "s" ASC NULLS LAST LIMIT 3%';
----
true

# 12d. A STRING key — refused outright before `is_binary_collation` was declared. It is safe here for a
#      stronger reason than the flag's SQL-Server-shaped name suggests: the sort runs inside DuckDB, so
#      there is no second engine whose collation could disagree.
query I
SELECT s FROM b.main.topn ORDER BY s DESC LIMIT 4;
----
