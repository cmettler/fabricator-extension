query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type LIKE 'Fabricator.Delta%' AND message LIKE '%delta native file%'
  AND message LIKE '%route_plain%' AND message LIKE '%LIMIT 9%';
----
true

query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type LIKE 'Fabricator.Delta%' AND message LIKE '%delta native scan%'
  AND message LIKE '%route_plain%' AND message LIKE '%rowid=True%' AND message LIKE '%top=9%';
