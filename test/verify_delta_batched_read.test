# 11d. NEGATIVE: a filter suppresses the pushed limit (the host-side arrow_ingest gate, pinned end to
#      end). The positive witness: the scan ran WITH the filter and top=- (the host never emitted it).
query I
SELECT count(*) FROM (SELECT id FROM b.main.route_plain WHERE id > 5 LIMIT 4) t;
