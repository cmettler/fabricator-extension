query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type LIKE 'Fabricator.Delta%' AND message LIKE '%delta native scan%'
  AND message LIKE '%route_plain%' AND message LIKE '%where=["id">5]%' AND message LIKE '%top=-%';
