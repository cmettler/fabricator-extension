# name: test/verify_delta_batched_read.test
# description: The BATCHED native Delta read (DeltaNativeReader.BatchPlan) — the files of a scan collapse
#              into ONE query instead of one host query per file, which is worth
#              ~1.5-1.9 ms of overhead per file (200 files x 100 rows: 0.464 s -> 0.090 s). This suite is run with
#              FABRICATOR_DELTA_BATCH_MIN_FILES=1 by scripts/run-suites.sh so even a one-file scan takes the batched
#              path — at the shipped default (2) most of it would silently test the per-file loop instead. Pins the
#              answers the batch must reproduce (schema evolution, name-mode column mapping incl. a RENAMEd NESTED
#              field, a pushed struct-member predicate, COUNT(*)) AND that every gated shape still works: deletion
#              vectors, the transient rowid / DML, partition columns, row-tracking virtual columns, id-mode mapping.
#              §10 pins WHICH of the three batched forms a scan takes — the only thing a suite can assert there,
#              since all forms are correct and a row assertion would pass either way. It matters because the
#              plain (`schema` map) form declares its schema and opens NO parquet footer, the UNION form (mixed
#              tables: the plain branch UNION ALL per-DV-file branches) opens exactly D, and the full
#              (`union_by_name`) form opens one per file TWICE: 0.5 s vs 34 s on a live 89-file Fabric table.
#              Set FABRICATOR_DELTA_WRITE_DIR. Local FS.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

# ============================================================================
# 1. MANY FILES, ONE QUERY — the equivalence the whole feature rests on.
#    Six separate INSERTs => six data files, all deletion-vector-free => all batched.
# ============================================================================

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/br' AS b (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE b.main.many AS SELECT i::BIGINT AS id, (i % 7)::INTEGER AS k, ('v' || i)::VARCHAR AS s FROM range(100) r(i);

statement ok
INSERT INTO b.main.many SELECT i::BIGINT, (i % 7)::INTEGER, ('v' || i)::VARCHAR FROM range(100, 200) r(i);

statement ok
INSERT INTO b.main.many SELECT i::BIGINT, (i % 7)::INTEGER, ('v' || i)::VARCHAR FROM range(200, 300) r(i);

statement ok
INSERT INTO b.main.many SELECT i::BIGINT, (i % 7)::INTEGER, ('v' || i)::VARCHAR FROM range(300, 400) r(i);

statement ok
INSERT INTO b.main.many SELECT i::BIGINT, (i % 7)::INTEGER, ('v' || i)::VARCHAR FROM range(400, 500) r(i);

statement ok
INSERT INTO b.main.many SELECT i::BIGINT, (i % 7)::INTEGER, ('v' || i)::VARCHAR FROM range(500, 600) r(i);

# Six files, so this really is the multi-file shape and not a one-file scan wearing its clothes.
query I
SELECT count(*) FROM glob('${FABRICATOR_DELTA_WRITE_DIR}/br/many/*.parquet');
----
6

query IIII
SELECT count(*), sum(id), sum(k), count(DISTINCT s) FROM b.main.many;
----
600	179700	1795	600

# Every row exactly once — a batch that read a file twice, or dropped one, shows up here and nowhere else.
query I
SELECT count(*) FROM (SELECT id FROM b.main.many GROUP BY id HAVING count(*) <> 1);
----
0

# The zero-column shape (COUNT(*)) takes its own branch: no schema map at all, since no column is read.
query I
SELECT count(*) FROM b.main.many;
----
600

# A pushed filter binds LOGICAL names above the batch (the map's 'name' has already renamed them).
query II
SELECT count(*), sum(id) FROM b.main.many WHERE k = 3 AND id > 100;
----
72	25164

query IT
SELECT id, s FROM b.main.many WHERE id IN (0, 250, 599) ORDER BY id;
----
0	v0
250	v250
599	v599

# ============================================================================
# 2. SCHEMA EVOLUTION ACROSS VINTAGES — `schema`'s default_value IS the backfill,
#    which is what makes the per-file footer probe unnecessary.
# ============================================================================

statement ok
ALTER TABLE b.main.many ADD COLUMN extra BIGINT;

statement ok
INSERT INTO b.main.many SELECT i::BIGINT, 1, 'new', (i * 10)::BIGINT FROM range(600, 620) r(i);

# The five pre-ALTER files have no `extra` column at all; they must read as NULL, not fail to bind.
query III
SELECT count(*), count(extra), sum(extra) FROM b.main.many;
----
620	20	121900

query I
SELECT count(*) FROM b.main.many WHERE extra IS NULL;
----
600

# ============================================================================
# 3. NAME-MODE COLUMN MAPPING WITH A NESTED STRUCT, INCLUDING A RENAMED MEMBER.
#    This is the case the batch gets right only because it rebuilds the struct with
#    LOGICAL member names in SQL: `schema` renames the TOP level only, so without the
#    rebuild a pushed struct-member predicate cannot bind (Binder Error: Could not find
#    key "..." in struct) and the advertised interior is physical.
#    Safe in NAME mode precisely because a rename changes the logical name and never the
#    physical one, so old and new files agree — id mode is gated off instead (section 7).
# ============================================================================

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/brnm' AS nm (TYPE fabricator, PROVIDER 'delta', column_mapping 'name');

statement ok
CREATE TABLE nm.main.nested AS SELECT 1 AS id, {'a': 10, 'b': 11} AS s;

statement ok
INSERT INTO nm.main.nested VALUES (2, {'a': 20, 'b': 21});

statement ok
INSERT INTO nm.main.nested VALUES (3, {'a': 30, 'b': 31});

# The parquet really does store physical names — otherwise this section proves nothing about mapping.
query I
SELECT count(*) FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/brnm/nested/*.parquet') WHERE name IN ('id', 's', 'a', 'b');
----
0

query III
SELECT id, (s).a, (s).b FROM nm.main.nested ORDER BY id;
----
1	10	11
2	20	21
3	30	31

# A pushed struct-member predicate over the batch: it binds the rebuilt LOGICAL interior.
query I
SELECT id FROM nm.main.nested WHERE (s).b = 21;
----
2

query I
SELECT count(*) FROM nm.main.nested WHERE (s).b IS NULL;
----
0

# RENAME the nested member, then append — old and new files now disagree on the LOGICAL name while agreeing
# on the physical one. Every row must still read under the new name.
statement ok
ALTER TABLE nm.main.nested RENAME COLUMN s.b TO renamed;

statement ok
INSERT INTO nm.main.nested VALUES (4, {'a': 40, 'renamed': 41});

query III
SELECT id, (s).a, (s).renamed FROM nm.main.nested ORDER BY id;
----
1	10	11
2	20	21
3	30	31
4	40	41

query I
SELECT id FROM nm.main.nested WHERE (s).renamed = 31;
----
3

# ============================================================================
# 4. DELETION VECTORS — batched. A mixed table takes the UNION form (2026-08-16): the plain
#    branch over the clean files UNION ALL one branch per DV file, small vectors inline, large
#    ones anti-joined against ONE shared bound (fn, pos) input through a MATERIALIZED CTE. The
#    rowid/full form still crosses every vector as one bound input too. If either input were
#    lost, or scanned twice (it is single-use), the deleted rows would come back, so this is
#    the section that catches the resurrection whichever form routes.
# ============================================================================

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/brdv' AS dv (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE dv.main.t AS SELECT i::BIGINT AS id FROM range(100) r(i);

statement ok
INSERT INTO dv.main.t SELECT i::BIGINT FROM range(100, 200) r(i);

statement ok
INSERT INTO dv.main.t SELECT i::BIGINT FROM range(200, 300) r(i);

# Deletes only inside the FIRST file, so the scan is genuinely mixed: one DV file + two clean ones.
statement ok
DELETE FROM dv.main.t WHERE id < 10;

query II
SELECT count(*), sum(id) FROM dv.main.t;
----
290	44805

query I
SELECT count(*) FROM dv.main.t WHERE id < 10;
----
0

query I
SELECT min(id) FROM dv.main.t;
----
10

# A second delete, this time spanning files, so more than one file leaves the batch.
statement ok
DELETE FROM dv.main.t WHERE id % 50 = 0;

query II
SELECT count(*), sum(id) FROM dv.main.t;
----
285	44055

query I
SELECT count(*) FROM dv.main.t WHERE id % 50 = 0;
----
0

# ============================================================================
# 5. THE TRANSIENT ROWID AND DML — gated off the batch (it needs file_row_number, which
#    a name-keyed `schema` map refuses). Asserted because a gate that silently made DML
#    wrong would otherwise look exactly like a gate that works.
# ============================================================================

statement ok
UPDATE dv.main.t SET id = id + 100000 WHERE id = 11;

query I
SELECT count(*) FROM dv.main.t WHERE id = 100011;
----
1

query I
SELECT count(*) FROM dv.main.t WHERE id = 11;
----
0

statement ok
DELETE FROM dv.main.t WHERE id = 100011;

query II
SELECT count(*), sum(id) FROM dv.main.t;
----
284	44044

# ============================================================================
# 6. PARTITION COLUMNS — batched. The partition value is absent from the data files, so it rides the
#    bound per-file input and is CAST in SQL. This was gated off the batch until 2026-08-07: a bound
#    input carrying a column DuckDB's projection PRUNES makes the scan ask for a NON-PREFIX column set,
#    which SEGFAULTS upstream (test/repro/duckdb_arrow_scan_nonprefix.c). The fix is structural — the
#    global ordinal is emitted ONLY when the rowid expression reads it — so every bound column is read
#    and the bug is unreachable by construction.
#    ⚠ The FILTERED query below is the regression gate: an unfiltered partitioned scan reads every
#    bound column anyway and passed even while the bug was live. It only crashed once a pushed filter
#    let DuckDB prune the ordinal. A partition test without a WHERE tests nothing about this.
# ============================================================================

statement ok
CREATE TABLE b.main.parts (id BIGINT, p VARCHAR) PARTITIONED BY (p);

statement ok
INSERT INTO b.main.parts SELECT i::BIGINT, 'p' || (i % 3) FROM range(30) r(i);

statement ok
INSERT INTO b.main.parts SELECT i::BIGINT, 'p' || (i % 3) FROM range(30, 60) r(i);

query II
SELECT count(*), sum(id) FROM b.main.parts;
----
60	1770

query TI
SELECT p, count(*) FROM b.main.parts GROUP BY p ORDER BY p;
----
p0	20
p1	20
p2	20

# THE REGRESSION SHAPE: a pushed filter on the partition column. With the ordinal still bound but
# unread, this segfaulted the process.
query II
SELECT count(*), sum(id) FROM b.main.parts WHERE p = 'p1';
----
20	590

# Same hazard with the filter on a DATA column instead, so the pruning does not depend on which
# column the predicate names.
query II
SELECT count(*), sum(id) FROM b.main.parts WHERE id > 40;
----
19	950

query I
SELECT count(*) FROM b.main.parts WHERE id > 40 AND p = 'p2';
----
7

# Partition values must survive projection in every combination — id alone, p alone, and both.
query I
SELECT count(DISTINCT p) FROM b.main.parts;
----
3

# The rowid path reads the ordinal, so this is the OTHER side of the same switch: DML over a
# partitioned table exercises the input WITH the ordinal emitted.
statement ok
UPDATE b.main.parts SET id = id + 1000 WHERE id = 5;

query I
SELECT count(*) FROM b.main.parts WHERE id = 1005;
----
1

statement ok
DELETE FROM b.main.parts WHERE id = 1005;

query III
SELECT count(*), sum(id), count(DISTINCT p) FROM b.main.parts;
----
59	1765	3

# ============================================================================
# 6b. ROW-TRACKING VIRTUAL COLUMNS — batched since 2026-08-07. They were gated on a reason that had gone
#     STALE: it was entirely about the field-id `schema` map (a materialized __delta_row_id is not
#     column-mapped, so it has no field id to key by), and this form abandoned that map for
#     `union_by_name` long before. Under name resolution the materialized column is just another column,
#     and baseRowId / defaultRowCommitVersion are per-FILE constants that ride the metadata input like
#     file_ord — so COALESCE(materialized, baseRowId + file_row_number) is expressible in one query.
#     ⚠ The mixed case below is the one that matters: an UPDATE writes a post-image file that
#     MATERIALIZES ids, so the scan spans files that store the column and files that do not.
#     union_by_name NULL-fills the latter, which is exactly the COALESCE's fallthrough — a test on a
#     table where every file agrees would pass without exercising that at all.
# ============================================================================

query II
SELECT count(*), count(DISTINCT __delta_row_id) FROM b.main.many;
----
620	620

query I
SELECT count(*) FROM b.main.many WHERE __delta_row_id IS NULL;
----
0

statement ok
CREATE TABLE b.main.trk AS SELECT i::BIGINT AS id FROM range(100) r(i);

statement ok
INSERT INTO b.main.trk SELECT i::BIGINT FROM range(100, 200) r(i);

# Derived-only so far: every file carries baseRowId, none stores the materialized column.
query IIII
SELECT count(*), count(DISTINCT __delta_row_id), min(__delta_row_id), max(__delta_row_id) FROM b.main.trk;
----
200	200	0	199

# Two appends => two commit versions, and the version column reads its own per-file constant.
query I
SELECT count(DISTINCT __delta_row_commit_version) FROM b.main.trk;
----
2

# NOW the mixed case: the post-image file materializes the ids of the rows it rewrites.
statement ok
UPDATE b.main.trk SET id = id + 10000 WHERE id % 37 = 0;

query III
SELECT count(*), count(DISTINCT __delta_row_id), count(*) FILTER (WHERE __delta_row_id IS NULL) FROM b.main.trk;
----
200	200	0

# The whole point of materializing: a rewritten row KEEPS its original stable id. Six rows moved
# (i % 37 = 0 over 0..199), and their ids must still fall in the original 0..199 range rather than
# being re-derived from the new file's position.
query II
SELECT count(*), max(__delta_row_id) FROM b.main.trk WHERE id >= 10000;
----
6	185

query II
SELECT min(__delta_row_id), max(__delta_row_id) FROM b.main.trk;
----
0	199

# ============================================================================
# 7. ID-MODE COLUMN MAPPING — gated off the batch, and this section is a POSITIVE CONTROL
#    only: it cannot kill the gate and does not pretend to. The batch resolves columns by
#    NAME while id mode's contract is that the reader matches by FIELD ID, so a legacy
#    engineered-wood file (LOGICAL names under its field ids) or any external writer that
#    names differently would silently read NULL. But MEASURED: our own writers keep the
#    physical name byte-identical across renames in id mode too, so no table this suite can
#    build exhibits the divergence — a mutant with the gate removed passes everything here.
#    The gate is a contract gate. Retired upstream by duckdb/duckdb#24407 (nested `schema`
#    definitions), which targets main.
# ============================================================================

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/brid' AS im (TYPE fabricator, PROVIDER 'delta', column_mapping 'id');

statement ok
CREATE TABLE im.main.t AS SELECT 1 AS id, {'a': 10, 'b': 11} AS s;

statement ok
INSERT INTO im.main.t VALUES (2, {'a': 20, 'b': 21});

statement ok
ALTER TABLE im.main.t RENAME COLUMN s.b TO renamed;

statement ok
INSERT INTO im.main.t VALUES (3, {'a': 30, 'renamed': 31});

# The value under the renamed member must survive in EVERY vintage (the per-file loop resolves each file's
# field ids to its own stored names, which is what id mode asks of a reader).
query III
SELECT id, (s).a, (s).renamed FROM im.main.t ORDER BY id;
----
1	10	11
2	20	21
3	30	31

# Flat id-mode columns are unaffected by that hazard and read across vintages as usual.
statement ok
ALTER TABLE im.main.t RENAME COLUMN id TO ident;

statement ok
INSERT INTO im.main.t VALUES (4, {'a': 40, 'renamed': 41});

query II
SELECT count(*), sum(ident) FROM im.main.t;
----
4	10

# ============================================================================
# 8. THE TRANSIENT ROWID IS A VALUE, NOT A POSITION — multi-row-group files, several threads.
#    rowid = (file ordinal << 40) | file_row_number. The halves have DIFFERENT granularity: the ordinal
#    is per FILE (it rides the bound input and is JOINed on `filename`, never zipped positionally),
#    while file_row_number is the row's physical position inside its own parquet file, which DuckDB
#    derives from the footer's row-group offsets. Neither depends on the order rows are EMITTED — and
#    DuckDB guarantees no such order — so the mapping must not move with the thread count.
#    Pinned because the whole rowid DML path rests on it and a regression would be silent: rows would
#    still come back, just addressed wrongly.
#    ⚠ Do NOT pin a literal checksum here. The rowid is TRANSIENT by design: the file ordinal follows
#    listing order over UUID-named files, so it legitimately differs between two creations of the same
#    logical table (measured — two distinct checksums across three runs). The invariant is
#    thread-count invariance WITHIN one database, which is what this compares.
# ============================================================================

statement ok
SET delta_write_options='{"row_group_size":2048}';

statement ok
CREATE TABLE b.main.rg AS SELECT i::BIGINT AS id, ('v'||i)::VARCHAR AS s FROM range(20000) r(i);

statement ok
INSERT INTO b.main.rg SELECT i::BIGINT, ('v'||i)::VARCHAR FROM range(20000, 40000) r(i);

statement ok
SET threads=1;

query II
SELECT count(*), count(DISTINCT rowid) FROM b.main.rg;
----
40000	40000

# Capture the id -> rowid mapping single-threaded. The checksum is over the PAIR: counting distinct
# rowids alone would pass even with every one attached to the wrong row.
statement ok
CREATE TEMP TABLE ck AS SELECT sum(hash(id::VARCHAR||':'||rowid::VARCHAR)) AS c FROM b.main.rg;

statement ok
SET threads=8;

query I
SELECT (SELECT c FROM ck) = (SELECT sum(hash(id::VARCHAR||':'||rowid::VARCHAR)) FROM b.main.rg);
----
true

statement ok
SET threads=4;

query I
SELECT (SELECT c FROM ck) = (SELECT sum(hash(id::VARCHAR||':'||rowid::VARCHAR)) FROM b.main.rg);
----
true

# And DML addressed by that rowid must hit exactly the predicate's rows, under threads.
statement ok
UPDATE b.main.rg SET s = 'HIT' WHERE id % 4999 = 0;

query I
SELECT count(*) FROM b.main.rg WHERE (s = 'HIT') <> (id % 4999 = 0);
----
0

statement ok
DELETE FROM b.main.rg WHERE s = 'HIT';

query II
SELECT count(*), count(*) FILTER (WHERE s <> 'v'||id) FROM b.main.rg;
----
39991	0

statement ok
RESET delta_write_options;

# ============================================================================
# 9. NO BOUND-INPUT VIEW IS LEFT BEHIND. Every Arrow input we hand the host is registered by
#    duckdb_arrow_scan as a CATALOG-level (NOT temporary) view, so it outlives the connection AND the
#    stream that owns its storage — a stale one is a view pointing at freed memory, not just clutter.
#    BoundInput gives each a unique name and drops it after use; nothing else enforces that, which is
#    why this section exists. Covers the scan-side inputs (deletion vectors, per-file metadata), the
#    native-write COPY source, and the SORTED BY sort input — the last being the only site whose drop
#    is deferred to stream Dispose rather than a finally.
# ============================================================================

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/brv' AS lv (TYPE fabricator, PROVIDER 'delta');

# POSITIVE CONTROL FIRST: prove the pattern below can actually match. A LIKE/ESCAPE that quietly
# matches nothing would make every assertion here pass for the wrong reason.
statement ok
CREATE VIEW __fab_control AS SELECT 1;

query I
SELECT count(*) FROM duckdb_views() WHERE view_name LIKE '\_\_fab%' ESCAPE '\';
----
1

statement ok
DROP VIEW __fab_control;

statement ok
CREATE TABLE lv.main.t AS SELECT i::BIGINT AS id, ('v'||i)::VARCHAR AS s FROM range(500) r(i);

statement ok
INSERT INTO lv.main.t SELECT i::BIGINT, ('v'||i)::VARCHAR FROM range(500, 1000) r(i);

# A deletion vector, so a scan binds the DV input.
statement ok
DELETE FROM lv.main.t WHERE id % 100 = 0;

query I
SELECT count(*) FROM lv.main.t;
----
990

# A pushed filter (HostBatchFilter binds its own input on some paths).
query I
SELECT count(*) FROM lv.main.t WHERE id > 400 AND s <> 'x';
----
594

# A rowid scan, so the per-file metadata input is bound with the file ordinal.
statement ok
UPDATE lv.main.t SET s = 'u' WHERE id = 7;

# A SORTED BY write — the sort input's drop is deferred to Dispose, so it is the one that would leak
# if the wrapper were removed.
statement ok
CREATE TABLE lv.main.srt AS SELECT i::BIGINT AS id FROM range(200) r(i);

statement ok
ALTER TABLE lv.main.srt SET SORTED BY (id);

statement ok
INSERT INTO lv.main.srt SELECT i::BIGINT FROM range(200, 400) r(i);

query I
SELECT count(*) FROM lv.main.srt;
----
400

# After all of that, the catalog must hold none of ours.
query I
SELECT count(*) FROM duckdb_views() WHERE view_name LIKE '\_\_fab%' ESCAPE '\';
----
0

# ============================================================================
# 10. WHICH FORM IS CHOSEN — the ROUTING, which is the only thing a suite can pin here.
#     Both forms are CORRECT, so an assertion on rows passes either way and a mutant that reverses the
#     preference survives it. The observable is the generated SQL itself, through the Debug line
#     `delta native batch: <sql>`: `schema = map` is the plain form, `union_by_name` is the full one.
#     Same shape as verify_delta_rename's engine assertion (read the artefact, not the answer).
#
#     WHY IT MATTERS: the full form pays TWO O(files) parquet-FOOTER sweeps before it reads a row —
#     PresentNames (`parquet_schema([every file])`) to build its SQL, then the bind-time `LIMIT 0` schema
#     probe. MEASURED on 89 remote files, each variant in its own process: 20.50 s + 20.66 s against
#     0.49 s for the plain form's probe (42x), because a DECLARED `schema` map needs no footer at all.
#     The plain form used to be unreachable on exactly the shape it wins most — a plain projection over
#     DV-free files with no rowid — because the full form was tried first and SUCCEEDS there.
# ============================================================================

statement ok
CREATE TABLE b.main.route_plain AS SELECT i::BIGINT AS id, ('r' || i)::VARCHAR AS s FROM range(50) r(i);

statement ok
INSERT INTO b.main.route_plain SELECT i::BIGINT, ('r' || i)::VARCHAR FROM range(50, 100) r(i);

statement ok
INSERT INTO b.main.route_plain SELECT i::BIGINT, ('r' || i)::VARCHAR FROM range(100, 150) r(i);

# A DV-carrying table: three files, then a DELETE touching rows of ONE of them. The plain form can serve
# the two clean files only, so this is the MIXED case — since 2026-08-16 it takes the UNION form: the
# plain `schema = map` branch over the clean files UNION ALL one per-file branch per DV file, each branch
# keeping its prunable DV bound. One query, no `union_by_name`, no O(N) footer sweep.
statement ok
CREATE TABLE b.main.route_dv AS SELECT i::BIGINT AS id, ('r' || i)::VARCHAR AS s FROM range(50) r(i);

statement ok
INSERT INTO b.main.route_dv SELECT i::BIGINT, ('r' || i)::VARCHAR FROM range(50, 100) r(i);

statement ok
INSERT INTO b.main.route_dv SELECT i::BIGINT, ('r' || i)::VARCHAR FROM range(100, 150) r(i);

statement ok
DELETE FROM b.main.route_dv WHERE id IN (10, 11, 12);

# A partitioned table for 10c — two files, three partitions, never DMLd, so the only thing that can send
# it to one form or the other is whether the projection names the partition column.
statement ok
CREATE TABLE b.main.rparts (id BIGINT, p VARCHAR) PARTITIONED BY (p);

statement ok
INSERT INTO b.main.rparts SELECT i::BIGINT, 'p' || (i % 3) FROM range(30) r(i);

statement ok
INSERT INTO b.main.rparts SELECT i::BIGINT, 'p' || (i % 3) FROM range(30, 60) r(i);

statement ok
CALL enable_logging(level := 'debug', storage := 'memory');

# 10a. A plain projection over DV-free files with no rowid — the shape the plain form is FOR.
query II
SELECT count(*), sum(id) FROM b.main.route_plain;
----
150	11175

query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type LIKE 'Fabricator.Delta%' AND message LIKE '%delta native batch%'
  AND message LIKE '%route_plain%' AND message LIKE '%schema = map%';
----
true

# And it must NOT have taken the full form. Without this the assertion above would pass equally if the
# scan had emitted BOTH (it emits one line per scan, but a future plan that batched twice would not fail).
query I
SELECT count(*) FROM duckdb_logs
WHERE type LIKE 'Fabricator.Delta%' AND message LIKE '%delta native batch%'
  AND message LIKE '%route_plain%' AND message LIKE '%union_by_name%';
----
0

# 10b. THE MIXED (DV) CASE TAKES THE UNION FORM (2026-08-16): `schema = map` for the clean files plus
#      ` UNION ALL ` per-DV-file branches, in ONE query, keeping every branch's prunable DV bound where
#      the full form forfeits it. ⚠ LOCAL ROOTS ONLY (this suite is local FS, so the union fires here);
#      on a remote root the union is gated to pushed-bare-LIMIT scans, because per-file EXECUTION opens
#      through a host query measured 120-212 ms each SERIAL against the full form's ~29 ms — a 120.4 s vs
#      17.7 s full-scan A/B on the OneLake frag fixture, while the identical SQL runs RAW in 6.3 s. The
#      anomaly is the extension's execution path, not the form; TryUnionForm's remarks carry the record.
query II
SELECT count(*), sum(id) FROM b.main.route_dv;
----
147	11142

query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type LIKE 'Fabricator.Delta%' AND message LIKE '%delta native batch%'
  AND message LIKE '%route_dv%' AND message LIKE '%schema = map%' AND message LIKE '% UNION ALL %';
----
true

# ...and NOT the full form. This is the assertion the reversed-preference mutant dies at — a plan that
# still sent one deletion vector's whole scan to `union_by_name` would pass every row assertion above.
query I
SELECT count(*) FROM duckdb_logs
WHERE type LIKE 'Fabricator.Delta%' AND message LIKE '%delta native batch%'
  AND message LIKE '%route_dv%' AND message LIKE '%union_by_name%';
----
0

# The DV branch keeps its PRUNABLE BOUND — the thing the full form structurally forfeits (one WHERE
# cannot carry a per-file range; one branch can). The 10,11,12 delete leaves no leading/trailing dense
# run, so make one: delete a PREFIX of the first file, and the branch must carry file_row_number >= …
# alongside the exact exclusion. Only the generated SQL can witness this — the rows are identical
# either way, which is the whole reason DvRangeCondition's own doc says "read the plan, do not re-time".
statement ok
DELETE FROM b.main.route_dv WHERE id < 8;

query II
SELECT count(*), sum(id) FROM b.main.route_dv;
----
139	11114

query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type LIKE 'Fabricator.Delta%' AND message LIKE '%delta native batch%'
  AND message LIKE '%route_dv%' AND message LIKE '% UNION ALL %'
  AND message LIKE '%file_row_number >= 8%';
----
true

# That second DELETE made the vector 11 positions (0..7 + 10,11,12), past the DvLiteralMax inline
# boundary — so the branch anti-joins the shared bound (fn, pos) input through the MATERIALIZED
# __fab_d CTE, sliced by its own filename LITERAL (no filename => true needed: a branch knows its file).
query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type LIKE 'Fabricator.Delta%' AND message LIKE '%delta native batch%'
  AND message LIKE '%route_dv%' AND message LIKE '%__fab_d AS MATERIALIZED%'
  AND message LIKE '%d.fn = %' AND message LIKE '%d.pos = file_row_number%';
----
true

# The bound input's view was dropped after the drain — the union form registers a catalog-level
# (non-temporary) view exactly like the full form, so a leak here would outlive the connection.
query I
SELECT count(*) FROM duckdb_views() WHERE view_name LIKE '\_\_fab%' ESCAPE '\';
----
0

# THE FULL FORM'S OWN POSITIVE CONTROL: it must still be reachable, or every plain/union assertion
# above would pass equally if the batch had silently become plain-or-nothing. A projected ROWID is a
# shape neither the plain nor the union form serves (file_row_number under a name-keyed map), so it
# routes to `union_by_name` — on this very table, so the pattern filters stay honest.
query III
SELECT count(*), max(id), min(rowid) >= 0 FROM b.main.route_dv;
----
139	149	true

query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type LIKE 'Fabricator.Delta%' AND message LIKE '%delta native batch%'
  AND message LIKE '%route_dv%' AND message LIKE '%union_by_name%';
----
true

# TWO bound-DV files, DIFFERENT dead positions — the shape that kills a branch anti-joining the shared
# (fn, pos) input WITHOUT its filename slice: an unsliced branch excludes the OTHER file's positions
# too, so file 1's live ids 10..15 (file 2's dead positions) and file 2's live ids 50..57 (file 1's
# dead positions) would vanish. Only exact values catch that; the routing assertions cannot.
# ⚠ Its OWN 4-file table (2 clean survive), NOT route_dv — a third DV file there would leave one clean
# file and re-route the scan to the full form at the shipped MIN_FILES default of 2, making everything
# after it assert the wrong form. This suite runs at BOTH thresholds; 2 clean files union under both.
# ⚠ Named rdvx, not route_dv2: the §10b/§11 log patterns match '%route_dv%' by substring.
statement ok
CREATE TABLE b.main.rdvx AS SELECT i::BIGINT AS id FROM range(50) r(i);

statement ok
INSERT INTO b.main.rdvx SELECT i::BIGINT FROM range(50, 100) r(i);

statement ok
INSERT INTO b.main.rdvx SELECT i::BIGINT FROM range(100, 150) r(i);

statement ok
INSERT INTO b.main.rdvx SELECT i::BIGINT FROM range(150, 200) r(i);

statement ok
DELETE FROM b.main.rdvx WHERE id < 8;

statement ok
DELETE FROM b.main.rdvx WHERE id BETWEEN 60 AND 65;

query II
SELECT count(*), sum(id) FROM b.main.rdvx;
----
186	19497

# The rows an unsliced branch would wrongly exclude, plus the union routing as the positive control
# that this section exercised the mechanism it claims to.
query I
SELECT count(*) FROM b.main.rdvx WHERE id IN (10, 11, 12, 13, 14, 15, 50, 51, 52, 53);
