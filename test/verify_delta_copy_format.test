# name: test/verify_delta_copy_format.test
# description: COPY … TO '<path>/<table>' (FORMAT delta, …) — path-targeted Delta write with NO ATTACH.
#              Opens a transient engineered-wood Delta catalog at the parent dir and streams through the
#              standard bulk machinery: CREATE / append (parked + flushed by the COPY's own commit) /
#              REPLACE / SCHEMA_MODE / PARTITION_COLUMNS / PARTITION_OVERWRITE / provider option passthrough.
#              The official duckdb-delta extension has no COPY at all — this surface is ours alone.
# group: [fabricator]

require fabricator

require-env FABRICATOR_DELTA_WRITE_DIR

# ----------------------------------------------------------------------------
# 1. CREATE (default): COPY to a fresh path creates the table
# ----------------------------------------------------------------------------

statement ok
COPY (SELECT i::INT AS id, 'v' || i AS val FROM range(1,4) t(i))
  TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/t1' (FORMAT delta);

query II
SELECT id, val FROM fabricator_delta_scan('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/t1') ORDER BY id;
----
1	v1
2	v2
3	v3

# COPY onto an existing target OVERWRITES (create-or-replace — the Delta provider's CREATE_TABLE=true is an
# Overwrite write, matching plain COPY-to-file semantics; same behavior as the catalog COPY on delta)
statement ok
COPY (SELECT i::INT AS id, 'v' || i AS val FROM range(1,4) t(i))
  TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/t1' (FORMAT delta);

query I
SELECT count(*) FROM fabricator_delta_scan('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/t1');
----
3

# ----------------------------------------------------------------------------
# 2. APPEND (CREATE_TABLE false) — parked by the provider, flushed by the COPY's own commit
# ----------------------------------------------------------------------------

statement ok
COPY (SELECT i::INT AS id, 'v' || i AS val FROM range(4,6) t(i))
  TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/t1' (FORMAT delta, CREATE_TABLE false);

query II
SELECT count(*), sum(id) FROM fabricator_delta_scan('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/t1');
----
5	15

# CREATE_TABLE false on a MISSING target = create-if-not-exists + append (Spark mode=append semantics;
# engineered-wood's append path OpenOrCreates commit-0). So the idempotent-append form needs no existence
# check. PARTITION_COLUMNS applies whenever the write actually CREATES the table — incl. this implicit
# create (pinned in the MODE section below).
statement ok
COPY (SELECT 1::INT AS id, 'a' AS val)
  TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/appendfresh' (FORMAT delta, CREATE_TABLE false);

statement ok
COPY (SELECT 2::INT AS id, 'b' AS val)
  TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/appendfresh' (FORMAT delta, CREATE_TABLE false);

query II
SELECT count(*), sum(id) FROM fabricator_delta_scan('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/appendfresh');
----
2	3

# ----------------------------------------------------------------------------
# 3. REPLACE — drop+recreate semantics, adopts the new schema
# ----------------------------------------------------------------------------

statement ok
COPY (SELECT 99::INT AS id, 'only' AS val, true AS flag)
  TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/t1' (FORMAT delta, REPLACE true);

query III
SELECT id, val, flag FROM fabricator_delta_scan('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/t1');
----
99	only	true

# ----------------------------------------------------------------------------
# 4. PARTITION_COLUMNS (create-time Hive partitioning) + PARTITION_OVERWRITE (dynamic)
# ----------------------------------------------------------------------------

statement ok
COPY (SELECT i::INT AS id, CASE WHEN i%2=0 THEN 'EU' ELSE 'US' END AS region FROM range(1,7) t(i))
  TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/pt' (FORMAT delta, PARTITION_COLUMNS 'region');

query II
SELECT region, count(*) FROM fabricator_delta_scan('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/pt')
GROUP BY region ORDER BY region;
----
EU	3
US	3

# dynamic partition overwrite: only the partitions PRESENT IN THE INPUT are replaced
statement ok
COPY (SELECT 100::INT AS id, 'US' AS region)
  TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/pt' (FORMAT delta, CREATE_TABLE false, PARTITION_OVERWRITE true);

query III
SELECT region, count(*), sum(id) FROM fabricator_delta_scan('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/pt')
GROUP BY region ORDER BY region;
----
EU	3	12
US	1	100

# PARTITION_OVERWRITE requires the append shape (same guard as the catalog COPY)
statement error
COPY (SELECT 1::INT AS id, 'US' AS region)
  TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/pt' (FORMAT delta, PARTITION_OVERWRITE true);
----
PARTITION_OVERWRITE requires CREATE_TABLE false

# ----------------------------------------------------------------------------
# 5. SCHEMA_MODE 'merge' (append + union new columns) and 'overwrite' (adopt source schema)
# ----------------------------------------------------------------------------

statement ok
COPY (SELECT 7::INT AS id, 'EU' AS region, 3.5 AS score)
  TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/pt' (FORMAT delta, CREATE_TABLE false, SCHEMA_MODE 'merge');

query II
SELECT count(*), count(score) FROM fabricator_delta_scan('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/pt');
----
5	1

statement ok
COPY (SELECT 'fresh' AS name)
  TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/t1' (FORMAT delta, CREATE_TABLE false, SCHEMA_MODE 'overwrite');

query I
SELECT name FROM fabricator_delta_scan('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/t1');
----
fresh

# ----------------------------------------------------------------------------
# 6. Provider option passthrough: a plain protocol-1.0 table (deletion vectors off, no column mapping —
#    the SQL-Server-/legacy-reader-friendly shape) vs the defaults (DV on, name mapping)
# ----------------------------------------------------------------------------

statement ok
COPY (SELECT 1::INT AS id) TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/plain'
  (FORMAT delta, DELETION_VECTORS false, COLUMN_MAPPING 'none');

# no reader-v3 / mapping metadata in commit 0
query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/plain/_delta_log/00000000000000000000.json')
WHERE content LIKE '%deletionVectors%' OR content LIKE '%columnMapping%';
----
0

# default shape declares both
query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/t1/_delta_log/00000000000000000000.json')
WHERE content LIKE '%deletionVectors%' AND content LIKE '%columnMapping%';
----
1

# ----------------------------------------------------------------------------
# 7. The written table is a normal Delta table — ATTACH the root and read it as a catalog
# ----------------------------------------------------------------------------

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt' AS cfl (TYPE fabricator, PROVIDER 'delta');

query I
SELECT count(*) FROM cfl.main.pt;
----
5

statement ok
DETACH cfl;

# ----------------------------------------------------------------------------
# 8. Target validation: FORMAT delta takes a PATH, not a 3-part name
# ----------------------------------------------------------------------------

statement error
COPY (SELECT 1) TO 'not_a_path' (FORMAT delta);
----
target must be a path

# ----------------------------------------------------------------------------
# 9. MODE — the Spark/delta-rs write-disposition vocabulary (the documented surface; the
#    CREATE_TABLE/REPLACE flags above stay as the legacy spelling). Every mode creates a missing target.
# ----------------------------------------------------------------------------

# MODE 'append': create if missing …
statement ok
COPY (SELECT 1::INT AS id) TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/m1' (FORMAT delta, MODE 'append');

# … append if exists
statement ok
COPY (SELECT 2::INT AS id) TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/m1' (FORMAT delta, MODE 'append');

query II
SELECT count(*), sum(id) FROM fabricator_delta_scan('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/m1');
----
2	3

# MODE 'error' (Spark's default save mode): fails on an existing target …
statement error
COPY (SELECT 3::INT AS id) TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/m1' (FORMAT delta, MODE 'error');
----
already exists

# … creates a missing one ('errorifexists' is the Spark-spelled alias)
statement ok
COPY (SELECT 1::INT AS id) TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/m2' (FORMAT delta, MODE 'errorifexists');

# MODE 'ignore': silent no-op on an existing target
statement ok
COPY (SELECT 99::INT AS id) TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/m1' (FORMAT delta, MODE 'ignore');

query II
SELECT count(*), sum(id) FROM fabricator_delta_scan('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/m1');
----
2	3

# MODE 'overwrite': full replace
statement ok
COPY (SELECT 7::INT AS id) TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/m1' (FORMAT delta, MODE 'overwrite');

query I
SELECT id FROM fabricator_delta_scan('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/m1');
----
7

# MODE 'overwrite_partitions': dynamic partition overwrite (= CREATE_TABLE false + PARTITION_OVERWRITE)
statement ok
COPY (SELECT 200::INT AS id, 'EU' AS region, NULL::DOUBLE AS score)
  TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/pt' (FORMAT delta, MODE 'overwrite_partitions');

query III
SELECT region, count(*), sum(id) FROM fabricator_delta_scan('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/pt')
GROUP BY region ORDER BY region;
----
EU	1	200
US	1	100

# overwrite_partitions on a MISSING target WITHOUT partition columns is rejected UP FRONT (the implicit
# append-create would be unpartitioned and only then fail the partitioned-target guard, leaving an empty
# commit-0 behind)
statement error
COPY (SELECT 1::INT AS id, 'US' AS region)
  TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/nopo' (FORMAT delta, MODE 'overwrite_partitions');
----
supply PARTITION_COLUMNS

# … and nothing was left on storage
query I
SELECT count(*) FROM glob('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/nopo/**');
----
0

# WITH partition columns the missing target is created PARTITIONED and the first run is a plain append —
# the idempotent first-run shape; a re-run then dynamically swaps the input's partitions
statement ok
COPY (SELECT i::INT AS id, CASE WHEN i%2=0 THEN 'EU' ELSE 'US' END AS region FROM range(1,5) t(i))
  TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/po1' (FORMAT delta, MODE 'overwrite_partitions', PARTITION_COLUMNS 'region');

statement ok
COPY (SELECT 100::INT AS id, 'US' AS region)
  TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/po1' (FORMAT delta, MODE 'overwrite_partitions', PARTITION_COLUMNS 'region');

query III
SELECT region, count(*), sum(id) FROM fabricator_delta_scan('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/po1')
GROUP BY region ORDER BY region;
----
EU	2	6
US	1	100

# PARTITION_COLUMNS is allowed with every mode, applied only when the write CREATES the table:
# MODE 'append' on a missing target creates it PARTITIONED — Hive layout on disk (COLUMN_MAPPING 'none'
# here so the partition dir carries the LOGICAL name; under the default name-mapping the dir is the
# physical col-<guid> per the Spark convention, equally partitioned) …
statement ok
COPY (SELECT 1::INT AS id, 'EU' AS region)
  TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/ap1'
  (FORMAT delta, MODE 'append', PARTITION_COLUMNS 'region', COLUMN_MAPPING 'none');

query I
SELECT count(*) FROM glob('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/ap1/region=EU/*.parquet');
----
1

# … and on an existing table it is tolerated + ignored (the table keeps its declared partitioning)
statement ok
COPY (SELECT 2::INT AS id, 'US' AS region)
  TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/ap1'
  (FORMAT delta, MODE 'append', PARTITION_COLUMNS 'id', COLUMN_MAPPING 'none');

query I
SELECT count(*) FROM glob('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/ap1/region=US/*.parquet');
----
1

# MODE 'error_if_not_exists' — strict append: fails on a MISSING target …
statement error
COPY (SELECT 1::INT AS id) TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/noexist' (FORMAT delta, MODE 'error_if_not_exists');
----
does not exist

# … appends to an existing one
statement ok
COPY (SELECT 8::INT AS id) TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/m1' (FORMAT delta, MODE 'error_if_not_exists');

query II
SELECT count(*), sum(id) FROM fabricator_delta_scan('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/m1');
----
2	15

# MODE + a legacy flag = one vocabulary per statement
statement error
COPY (SELECT 1) TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/m3' (FORMAT delta, MODE 'append', CREATE_TABLE false);
----
cannot be combined

# unknown mode
statement error
COPY (SELECT 1) TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/m3' (FORMAT delta, MODE 'upsert');
----
unknown MODE

# ----------------------------------------------------------------------------
# 10. REPARTITION-on-overwrite — MODE 'overwrite' + PARTITION_COLUMNS on an EXISTING table changes the
#     partitioning: the new metaData.partitionColumns commits ATOMICALLY with the removal of every active
#     file (the only protocol-legal way to repartition — Spark's overwriteSchema + new partitionBy).
#     kernel-validated (delta_scan reads the repartitioned table).
# ----------------------------------------------------------------------------

statement ok
COPY (SELECT 1::INT AS id, 'EU' AS region)
  TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/rp' (FORMAT delta, COLUMN_MAPPING 'none');

# unpartitioned -> partitioned by region
statement ok
COPY (SELECT i::INT AS id, CASE WHEN i%2=0 THEN 'EU' ELSE 'US' END AS region FROM range(1,5) t(i))
  TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/rp' (FORMAT delta, MODE 'overwrite', PARTITION_COLUMNS 'region');

query II
SELECT region, count(*) FROM fabricator_delta_scan('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/rp')
GROUP BY region ORDER BY region;
----
EU	2
US	2

query I
SELECT count(*) FROM glob('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/rp/region=EU/*.parquet');
----
1

# repartitioned -> a DIFFERENT partition column
statement ok
COPY (SELECT 9::INT AS id, 'X' AS region)
  TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/rp' (FORMAT delta, MODE 'overwrite', PARTITION_COLUMNS 'id');

query II
SELECT id, region FROM fabricator_delta_scan('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/rp');
----
9	X

query I
SELECT count(*) FROM glob('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/rp/id=9/*.parquet');
----
1

# overwrite WITHOUT PARTITION_COLUMNS keeps the table's current partitioning (absence = no opinion)
statement ok
COPY (SELECT 5::INT AS id, 'EU' AS region)
  TO '${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/rp' (FORMAT delta, MODE 'overwrite');

query I
SELECT count(*) FROM glob('${FABRICATOR_DELTA_WRITE_DIR}/copyfmt/rp/id=5/*.parquet');
----
1
