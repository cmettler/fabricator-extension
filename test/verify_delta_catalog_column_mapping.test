# name: test/verify_delta_catalog_column_mapping.test
# description: The `column_mapping 'id'|'name'|'none'` ATTACH option (DEFAULT = 'id'). Tables CREATED in the catalog
#              enable Delta column mapping so a later RENAME COLUMN is a metadata-only commit (no rewrite). id mode
#              maps columns by the parquet field_id (the native reader resolves field_id -> physical name via
#              parquet_schema, so it reads EW-created + external-Spark layouts and survives a RENAME); name mode maps
#              by physicalName (col-<guid>). native_write id mode streams with FIELD_IDS stamped. Verifies: create +
#              insert + read (default reader + native_read + native_write), RENAME across mixed-vintage files, the
#              parquet carries field_ids, and 'none' opts out. Set FABRICATOR_DELTA_WRITE_DIR. Local FS.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

# ================= name mode (explicit) =================
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/cmname' AS nm (TYPE fabricator, PROVIDER 'delta', column_mapping 'name');

statement ok
CREATE TABLE nm.main.t AS SELECT i AS id, 'v' || i AS v FROM range(1, 4) AS r(i);

statement ok
INSERT INTO nm.main.t VALUES (4, 'v4');

# Read round-trips with LOGICAL names (the reader maps physical col-<guid> → id/v).
query IT
SELECT id, v FROM nm.main.t ORDER BY id;
----
1	v1
2	v2
3	v3
4	v4

# The data files use PHYSICAL names (col-<guid>) — the logical names id/v are ABSENT from the parquet schema.
query I
SELECT count(*) FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/cmname/t/*.parquet') WHERE name IN ('id', 'v');
----
0

query I
SELECT count(DISTINCT name) FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/cmname/t/*.parquet') WHERE name LIKE 'col-%';
----
2

statement ok
DETACH nm;

# ================= id mode (explicit) =================
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/cmid' AS im (TYPE fabricator, PROVIDER 'delta', column_mapping 'id');

statement ok
CREATE TABLE im.main.t AS SELECT i AS id, 'v' || i AS val FROM range(1, 4) AS r(i);

statement ok
INSERT INTO im.main.t VALUES (4, 'v4');

query IT
SELECT id, val FROM im.main.t ORDER BY id;
----
1	v1
2	v2
3	v3
4	v4

# The commit declares id mode.
query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/cmid/t/_delta_log/00000000000000000000.json')
WHERE replace(content, chr(92)||'u0022', '"') LIKE '%"delta.columnMapping.mode":"id"%';
----
1

# Per the Delta spec, id-mode data files ALSO use PHYSICAL col-<guid> names (the logical names are absent) —
# this is what makes them readable by Spark / delta-kernel.
query I
SELECT count(*) FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/cmid/t/*.parquet') WHERE name IN ('id', 'val');
----
0

# ... AND carry field_ids (the id-mode identity readers resolve by).
query I
SELECT count(DISTINCT field_id) FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/cmid/t/*.parquet') WHERE field_id IS NOT NULL;
----
2

# RENAME COLUMN — metadata-only (field keeps its columnMapping.id); old files stored 'val', new files store 'label'.
statement ok
ALTER TABLE im.main.t RENAME COLUMN val TO label;

statement ok
INSERT INTO im.main.t VALUES (5, 'v5');

# All rows read under the NEW logical name across mixed-vintage files (EW reader maps by field_id).
query IT
SELECT id, label FROM im.main.t ORDER BY id;
----
1	v1
2	v2
3	v3
4	v4
5	v5

statement ok
DETACH im;

# The NATIVE reader (parquet field_id -> physical-name resolver) reads the mixed-vintage files under 'label'.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/cmid' AS im2 (TYPE fabricator, PROVIDER 'delta', native_read true);

query IT
SELECT id, label FROM im2.main.t ORDER BY id;
----
1	v1
2	v2
3	v3
4	v4
5	v5

statement ok
DETACH im2;

# ================= default = NAME mode (no option) → RENAME works out of the box AND the table stays
# readable by the Fabric T-SQL endpoint (which rejects id-mode tables: UnsupportedColumnMappingMode) ====
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/cmdefault' AS d (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE d.main.t AS SELECT i AS a, i * 10 AS b FROM range(1, 4) AS r(i);

# The default catalog declares NAME mode (so RENAME is metadata-only + the endpoint reads it).
query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/cmdefault/t/_delta_log/00000000000000000000.json')
WHERE replace(content, chr(92)||'u0022', '"') LIKE '%"delta.columnMapping.mode":"name"%';
----
1

statement ok
ALTER TABLE d.main.t RENAME COLUMN b TO doubled;

query II
SELECT a, doubled FROM d.main.t ORDER BY a;
----
1	10
2	20
3	30

# ADD + DROP COLUMN are metadata-only too (fresh column id on ADD; readers reconcile old files on DROP).
statement ok
ALTER TABLE d.main.t ADD COLUMN note VARCHAR;

statement ok
INSERT INTO d.main.t VALUES (4, 40, 'n4');

query IIT
SELECT a, doubled, note FROM d.main.t ORDER BY a;
----
1	10	NULL
2	20	NULL
3	30	NULL
4	40	n4

statement ok
ALTER TABLE d.main.t DROP COLUMN doubled;

query IT
SELECT a, note FROM d.main.t ORDER BY a;
----
1	NULL
2	NULL
3	NULL
4	n4

# OPTIMIZE (compaction) preserves the column-mapping identity: the compacted file keeps the physical names +
# field_ids, so the data reads back unchanged (incl. across the earlier RENAME/ADD/DROP).
statement ok
INSERT INTO d.main.t VALUES (5, 'n5');

statement ok
SELECT fabricator_exec('d', 'OPTIMIZE main.t');

statement ok
SELECT fabricator_exec('d', 'VACUUM main.t RETAIN 0 HOURS');

query IT
SELECT a, note FROM d.main.t ORDER BY a;
----
1	NULL
2	NULL
3	NULL
4	n4
5	n5

statement ok
DETACH d;

# ================= id mode + native_write (streaming, FIELD_IDS stamped) =================
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/cmidnw' AS nw (TYPE fabricator, PROVIDER 'delta', column_mapping 'id', native_write true);

statement ok
CREATE TABLE nw.main.t AS SELECT i AS id, 'v' || i AS val FROM range(1, 6) AS r(i);

statement ok
INSERT INTO nw.main.t VALUES (6, 'v6');

query IT
SELECT id, val FROM nw.main.t ORDER BY id;
----
1	v1
2	v2
3	v3
4	v4
5	v5
6	v6

# The native-written parquet carries field_ids (DuckDB COPY FIELD_IDS), so the id-mode reader maps it.
query I
SELECT count(DISTINCT field_id) FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/cmidnw/t/*.parquet') WHERE field_id IS NOT NULL;
----
2

statement ok
DETACH nw;

# ================= partitioned + mapping (the NAME default): STREAMS via COPY PARTITION_BY (physical names) ========
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/cmpart' AS pt (TYPE fabricator, PROVIDER 'delta', native_write true);

statement ok
CREATE TABLE pt.main.sales PARTITIONED BY (region) AS
  SELECT * FROM (VALUES (1,'US',10),(2,'EU',20),(3,'US',30),(4,'APAC',40)) AS t(id,region,amt);

statement ok
INSERT INTO pt.main.sales VALUES (5,'EU',50);

query TII
SELECT region, count(*), sum(amt) FROM pt.main.sales GROUP BY region ORDER BY region;
----
APAC	1	40
EU	2	70
US	2	40

# Partition-pruning predicate works (partitionValues keyed physical, dual-resolved by the pruner).
query II
SELECT id, amt FROM pt.main.sales WHERE region = 'EU' ORDER BY id;
----
2	20
5	50

# The Hive dirs use PHYSICAL partition-column names (Delta spec: partitionValues track the physical name;
# paths are opaque to readers — Spark reads this table, validated live).
query I
SELECT count(*) > 0 FROM glob('${FABRICATOR_DELTA_WRITE_DIR}/cmpart/sales/col-*=US/*.parquet');
----
true

# RENAME the PARTITION column — metadata-only; partitionColumns updates to the new logical name while the
# committed partitionValues (physical keys) stay valid, so old data reads under the new name.
statement ok
ALTER TABLE pt.main.sales RENAME COLUMN region TO zone;

statement ok
INSERT INTO pt.main.sales VALUES (6,'EU',60);

query TII
SELECT zone, count(*), sum(amt) FROM pt.main.sales GROUP BY zone ORDER BY zone;
----
APAC	1	40
EU	3	130
US	2	40

statement ok
DETACH pt;

# Re-attach: durable across sessions.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/cmpart' AS pt2 (TYPE fabricator, PROVIDER 'delta');

query IT
SELECT id, zone FROM pt2.main.sales WHERE zone = 'US' ORDER BY id;
----
1	US
3	US

statement ok
DETACH pt2;

# ================= NESTED columns under mapping (the NAME default): native_write only ==============================
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/cmnested' AS ns (TYPE fabricator, PROVIDER 'delta', native_write true);

statement ok
CREATE TABLE ns.main.t AS
  SELECT 1 AS id, {'a': 10, 'b': 'x'} AS s UNION ALL SELECT 2, {'a': 20, 'b': 'y'};

statement ok
INSERT INTO ns.main.t VALUES (3, {'a': 30, 'b': 'z'});

# Nested reads via the default reader: whole struct, member projection, member predicate.
query II
SELECT id, s.a FROM ns.main.t WHERE s.a > 15 ORDER BY id;
----
2	20
3	30

# The parquet stores PHYSICAL names + field_ids at EVERY level (nested children too — the recursive FIELD_IDS
# via __duckdb_field_id; the logical names are absent) — the layout Spark/delta-kernel resolve.
query I
SELECT count(*) FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/cmnested/t/*.parquet')
WHERE name IN ('id', 's', 'a', 'b');
----
0

query I
SELECT count(DISTINCT field_id) FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/cmnested/t/*.parquet')
WHERE field_id IS NOT NULL;
----
4

# RENAME of the struct column is metadata-only; old data reads under the new name (nested children map by
# their stable physicalName/id through the recursive rename).
statement ok
ALTER TABLE ns.main.t RENAME COLUMN s TO payload;

query II
SELECT id, payload.a FROM ns.main.t ORDER BY id;
----
1	10
2	20
3	30

statement ok
DETACH ns;

# The NATIVE reader renames nested children back to logical too.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/cmnested' AS ns2 (TYPE fabricator, PROVIDER 'delta', native_read true);

query IT
SELECT id, payload.b FROM ns2.main.t ORDER BY id;
----
1	x
2	y
3	z

statement ok
DETACH ns2;

# Struct-in-LIST maps too: the list column + the element-struct's fields all carry physical names + field_ids
# (the recursive FIELD_IDS 'element' form), and read back under logical names.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/cmlist' AS ls (TYPE fabricator, PROVIDER 'delta', native_write true);

statement ok
CREATE TABLE ls.main.t AS SELECT 1 AS id, [{'x': 1}, {'x': 2}] AS items;

query II
SELECT id, items[2].x FROM ls.main.t;
----
1	2

query I
SELECT count(DISTINCT field_id) FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/cmlist/t/*.parquet')
WHERE field_id IS NOT NULL;
----
3

statement ok
DETACH ls;

# DELETE on a nested mapped table works (DV mode; the CDC capture takes struct rows), and the CDF feed
# surfaces nested members under LOGICAL names (recursive rename over the inferred + cdc change rows).
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/cmnestcdf' AS nc (TYPE fabricator, PROVIDER 'delta', change_data_feed true, native_write true);

statement ok
CREATE TABLE nc.main.t AS SELECT 1 AS id, {'a': 10, 'b': 'x'} AS s;

statement ok
INSERT INTO nc.main.t VALUES (2, {'a': 20, 'b': 'y'});

statement ok
DELETE FROM nc.main.t WHERE id = 1;

query II
SELECT id, s.a FROM nc.main.t;
----
2	20

query TIIT
SELECT _change_type, id, s.a, s.b FROM nc.delta.changes('main.t', starting_version := 1, ending_version := 3)
ORDER BY _commit_version, _change_type, id;
----
insert	1	10	x
insert	2	20	y
delete	1	10	x

statement ok
DETACH nc;

# WITHOUT native_write the EW-codec collect path also writes nested mapping tables in the spec layout
# (ColumnMappingRecursive.ToPhysical: physical names + field ids at every level — the old top-level-only
# gate is lifted). STRUCT SET UPDATE works on the mapped table too (the copy-on-write rewrite renames the
# source batches to logical for the substitution, then back to physical for the rewrite).
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/cmnestedew' AS ne (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE ne.main.t AS SELECT * FROM (VALUES (1, {'a': 10, 'b': 'x'}), (2, {'a': 20, 'b': 'y'})) v(id, s);

# Nested struct children are stored under physical col-<guid> names (spec) — no logical child names in the file.
query I
SELECT count(*) FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/cmnestedew/t/*.parquet') WHERE name IN ('a', 'b');
----
0

query I
SELECT count(*) FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/cmnestedew/t/*.parquet') WHERE name LIKE 'col-%';
----
4

# STRUCT SET on the MAPPED table: updated row changed, pass-through row keeps its values.
statement ok
UPDATE ne.main.t SET s = {'a': 99, 'b': 'upd'} WHERE id = 2;

query III
SELECT id, s.a, s.b FROM ne.main.t ORDER BY id;
----
1	10	x
2	99	upd

# ...and across a column RENAME (metadata-only under mapping).
statement ok
ALTER TABLE ne.main.t RENAME COLUMN s TO payload;

statement ok
UPDATE ne.main.t SET payload = {'a': 77, 'b': 'r'} WHERE id = 1;

query III
SELECT id, payload.a, payload.b FROM ne.main.t ORDER BY id;
----
1	77	r
2	99	upd

statement ok
DETACH ne;

# ================= 'none' opts out (plain table; logical == physical name, no protocol bump) =================
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/cmnone' AS pn (TYPE fabricator, PROVIDER 'delta', column_mapping 'none');

statement ok
CREATE TABLE pn.main.t AS SELECT 1 AS id, 'a' AS v;

# Plain table: the logical names ARE the parquet column names (no col-<guid>).
query I
SELECT count(*) FROM parquet_schema('${FABRICATOR_DELTA_WRITE_DIR}/cmnone/t/*.parquet') WHERE name IN ('id', 'v');
----
2

statement ok
DETACH pn;

# ================= STRUCT UPDATE (unmapped tables; mapped struct-SET is gated) =================
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/cmsupd' AS su (TYPE fabricator, PROVIDER 'delta', column_mapping 'none');

statement ok
CREATE TABLE su.main.t AS SELECT 1 AS id, {'a': 10, 'b': 'x'} AS s UNION ALL SELECT 2, {'a': 20, 'b': 'y'};

# Struct SET value round-trips (merge-on-read post-image under the DV default).
statement ok
UPDATE su.main.t SET s = {'a': 99, 'b': 'q'} WHERE id = 2;

query IIT
SELECT id, s.a, s.b FROM su.main.t ORDER BY id;
----
1	10	x
2	99	q

# Setting the whole struct NULL works (the all-null post-image page was a writer bug: a 0-value page declared a
# delta encoding whose header is mandatory — now PLAIN, standard-readable).
statement ok
UPDATE su.main.t SET s = NULL WHERE id = 1;

query II
SELECT id, s IS NULL FROM su.main.t ORDER BY id;
----
1	true
2	false

statement ok
DETACH su;

# On a MAPPED table (the default) struct SET works too (recursive physical rename + field ids on the
# rewrite); scalar SET on a nested table keeps working alongside.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/cmsupdm' AS sm (TYPE fabricator, PROVIDER 'delta', native_write true);

statement ok
CREATE TABLE sm.main.t AS SELECT 1 AS id, {'a': 10} AS s;

statement ok
UPDATE sm.main.t SET s = {'a': 2} WHERE id = 1;

query II
SELECT id, s.a FROM sm.main.t;
----
1	2

statement ok
UPDATE sm.main.t SET id = 7 WHERE id = 1;

query II
SELECT id, s.a FROM sm.main.t;
----
7	2

statement ok
DETACH sm;

# ================= unknown mode → clean error at ATTACH =================
statement error
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/cmbad' AS bad (TYPE fabricator, PROVIDER 'delta', column_mapping 'bogus');
----
unknown mode
