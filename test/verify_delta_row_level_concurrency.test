# name: test/verify_delta_row_level_concurrency.test
# description: ROW-LEVEL CONCURRENCY (v1+v2, Databricks-style and beyond — OSS Spark/delta-rs/kernel
#              are all file-level; Databricks itself still conflicts with compaction): concurrent DML
#              touching the SAME FILE composes when the touched ROWS are disjoint (the COMMIT rebase
#              re-unions the deletion vectors), and v2 REMAPS rows ACROSS a concurrent rewrite
#              (OPTIMIZE / copy-on-write) by STABLE ROW ID with the row's commit version as the
#              concurrent-modification discriminator (EW's Layer 3 (B) RemapRowLevelDeletesAsync —
#              shared by the autocommit AND the buffered surface, the latter via
#              RebaseDvDmlActionsAsync). The SAME row modified by both writers is a row-level
#              conflict. Applies under write_serializable (the default; read checks are replaced by
#              the row-level write validation); `serializable` keeps the strict file-level checks.
#              DV + row-tracking tables (the defaults). Set FABRICATOR_DELTA_WRITE_DIR.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

# Row-level concurrency is a WRITE_SERIALIZABLE-only relaxation, so this suite must DECLARE that level:
# since 2026-08-01 the catalog default is 'serializable', under which the strict file-level checks apply
# (§6 below pins exactly that contrast). Before the flip this line relied on the default being the loose one.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/rowlevel' AS rl (TYPE fabricator, PROVIDER 'delta', isolation_level 'write_serializable');

# ONE file with rows 1..10 (single INSERT ⇒ single parquet) — every scenario below targets THIS file.
statement ok
CREATE TABLE rl.main.t AS SELECT r AS id, 'v' || r AS s FROM range(1, 11) t(r);

# ---- 1. concurrent DELETEs, SAME file, DIFFERENT rows → both land (was: delete/delete abort) ----

statement ok con1
BEGIN;

statement ok con1
DELETE FROM rl.main.t WHERE id = 2;

# the racer's autocommit DV delete swaps the SAME file's deletion vector under con1
statement ok con2
DELETE FROM rl.main.t WHERE id = 4;

statement ok con1
COMMIT;

query II
SELECT count(*), sum(id) FROM rl.main.t;
----
8	49

# ---- 2. the SAME row deleted by both → row-level conflict ----

statement ok con1
BEGIN;

statement ok con1
DELETE FROM rl.main.t WHERE id = 6;

statement ok con2
DELETE FROM rl.main.t WHERE id = 6;

statement error con1
COMMIT;
----
row level

# con2's delete won; con1 rolled back — id 6 deleted exactly once
query II
SELECT count(*), sum(id) FROM rl.main.t;
----
7	43

# ---- 3. buffered UPDATE vs concurrent DELETE, same file, disjoint rows → both land;
#         the UPDATE's row keeps its stable row-tracking id (post-image rebased) ----

statement ok con1
BEGIN;

statement ok con1
UPDATE rl.main.t SET s = 'updated' WHERE id = 8;

statement ok con2
DELETE FROM rl.main.t WHERE id = 9;

statement ok con1
COMMIT;

query IT
SELECT id, s FROM rl.main.t WHERE id IN (8, 9);
----
8	updated

query II
SELECT count(*), sum(id) FROM rl.main.t;
----
6	34

# ---- 4. UPDATE vs UPDATE of the SAME row → row-level conflict ----

statement ok con1
BEGIN;

statement ok con1
UPDATE rl.main.t SET s = 'A' WHERE id = 10;

statement ok con2
UPDATE rl.main.t SET s = 'B' WHERE id = 10;

statement error con1
COMMIT;
----
row level

# the first committer's value survives; no lost update
query T
SELECT s FROM rl.main.t WHERE id = 10;
----
B

# ---- 5. A concurrent OPTIMIZE (file rewritten away) under a BUFFERED transaction COMPOSES: the
#         rebase relocates the buffered delete's rows by STABLE ROW ID onto the compacted file
#         (RemapRowLevelDeletesAsync — the same Layer 3 (B) machinery the autocommit path uses) and
#         the COMMIT lands, no retry — beyond Databricks, which still conflicts with compaction. ----

statement ok con1
BEGIN;

# unpushable predicate (whole-table read); matches id=1 only
statement ok con1
DELETE FROM rl.main.t WHERE id % 11 = 1;

query I con2
SELECT fabricator_exec('rl', 'OPTIMIZE main.t');
----
0

statement ok con1
COMMIT;

# both landed: the OPTIMIZE compacted AND the buffered delete removed id=1 through the rewrite
query II
SELECT count(*), sum(id) FROM rl.main.t;
----
5	33

query I
SELECT count(*) FROM rl.main.t WHERE id = 1;
----
0

# ---- 6. `serializable` keeps the STRICT file-level behavior (disjoint rows still conflict) ----

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/rowlevel' AS rlser (TYPE fabricator, PROVIDER 'delta', isolation_level 'serializable');

statement ok con1
BEGIN;

statement ok con1
DELETE FROM rlser.main.t WHERE id = 3;

statement ok con2
DELETE FROM rl.main.t WHERE id = 5;

statement error con1
COMMIT;
----
transaction conflict

# only the racer's delete applied
query II
SELECT count(*), sum(id) FROM rl.main.t;
----
4	28

statement ok
DETACH rlser;

# ---- 7. three-writer pile-up: two racers land during the buffered txn, all three compose ----

statement ok
CREATE TABLE rl.main.p AS SELECT r AS id FROM range(1, 21) t(r);

statement ok con1
BEGIN;

statement ok con1
DELETE FROM rl.main.p WHERE id = 10;

statement ok con2
DELETE FROM rl.main.p WHERE id = 11;

statement ok con2
DELETE FROM rl.main.p WHERE id = 12;

statement ok con1
COMMIT;

query II
SELECT count(*), sum(id) FROM rl.main.p;
----
17	177

# ---- 8. Buffered UPDATE THROUGH a concurrent OPTIMIZE composes: the update's DV half remaps onto
#         the compacted file, the post-image add is untouched — the updated value lands, no retry. ----

statement ok
CREATE TABLE rl.main.q AS SELECT r AS id, 'a' || r AS v FROM range(1, 7) t(r);

statement ok
INSERT INTO rl.main.q SELECT r, 'a' || r FROM range(7, 11) t(r);

statement ok con1
BEGIN;

statement ok con1
UPDATE rl.main.q SET v = 'x' WHERE id = 3;

query I con2
SELECT fabricator_exec('rl', 'OPTIMIZE main.q');
----
0

statement ok con1
COMMIT;

query IT
SELECT id, v FROM rl.main.q WHERE id IN (2, 3, 4) ORDER BY id;
----
2	a2
3	x
4	a4

query I
SELECT count(*) FROM rl.main.q;
----
10

# ---- 9. same row THROUGH a rewrite: the racer compacts AND deletes the row → the remap finds the
#         row's stable id gone (DV-hidden on the compacted file) → the precise row-level conflict;
#         clean abort, deleted-exactly-once. ----

statement ok con1
BEGIN;

statement ok con1
DELETE FROM rl.main.q WHERE id = 5;

query I con2
SELECT fabricator_exec('rl', 'OPTIMIZE main.q');
----
0

statement ok con2
DELETE FROM rl.main.q WHERE id = 5;

statement error con1
COMMIT;
----
row level

# deleted exactly once (by the racer)
query I
SELECT count(*) FROM rl.main.q;
----
9

statement ok
DETACH rl;

# ---- 10. SERIALIZABLE + a concurrent COMPACTION: the row-level delete must still LAND. A compaction's
#      removes and adds are dataChange=false — contents unchanged, already read-exempt at BOTH levels — so
#      relocating rows across it by stable row id admits no interleaving `serializable` forbids. This
#      ABORTED before the 2026-07-30 engineered-wood bump: our own patch gated row-level reconciliation on
#      one bool (`isolationLevel != Serializable`), which took the remap-across-rewrite down together with
#      the deletion-vector union it was meant to disable. Upstream's KeepOnlyDataPreservingResolutions
#      narrows the RESOLUTION instead (dropping only paths a concurrent commit removed with
#      dataChange=true), which keeps the compaction case. Nothing covered this, on either side. ----
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/rowlevel_ser' AS rs
  (TYPE fabricator, PROVIDER 'delta', isolation_level 'serializable');

# THREE files, so the compaction has real work: a single small file is a no-op and would make this pass
# vacuously (the way the first probe of this scenario did).
statement ok
CREATE TABLE rs.main.t AS SELECT r AS id FROM range(1, 5) t(r);

statement ok
INSERT INTO rs.main.t SELECT r FROM range(5, 9) t(r);

statement ok
INSERT INTO rs.main.t SELECT r FROM range(9, 13) t(r);

statement ok con1
BEGIN;

statement ok con1
DELETE FROM rs.main.t WHERE id = 1;

# The racer compacts the table under the open transaction (dataChange=false removes + adds).
statement ok con2
SELECT fabricator_exec('rs', 'OPTIMIZE main.t');

# The compaction really committed — asserted, because a no-op OPTIMIZE would leave nothing to rebase
# across and the COMMIT below would then prove nothing.
query T con2
SELECT operation FROM fabricator_delta_snapshots('rs', 't') WHERE version = 4;
----
OPTIMIZE

# The row-level delete rebases onto the compacted file and lands. Pre-bump this raised
# "Concurrent commit 4 already removed '<uuid>.parquet', which this transaction also removes."
statement ok con1
COMMIT;

query I con1
SELECT count(*) FROM rs.main.t;
----
11

# ...and id=1 specifically is the row that went.
query I con1
SELECT count(*) FROM rs.main.t WHERE id = 1;
----
0

statement ok
DETACH rs;


# ---- NOT COVERED HERE, deliberately: the AUTOCOMMIT path's row-level retry ----
# `DeltaCatalog.ExecuteDelete` passes rowLevelRetry to the DV delete, and that flag only changes behaviour
# when THAT statement's own commit hits a concurrent DV change. sqllogictest runs con1/con2 SEQUENTIALLY, so
# a bare autocommit DELETE here can never race — there is no window between its scan and its commit for
# another connection to act in. Every scenario above therefore drives the BUFFERED path (con1 BEGIN pins a
# snapshot, con2 commits, con1's flush sees the change), which is a different code path.
#
# This is why nothing caught that the autocommit path read the CATALOG flag while the buffered path read the
# TABLE property — the combination `delta.isolationLevel = Serializable` + ATTACH write_serializable was
# strict inside BEGIN..COMMIT and relaxed for a bare DELETE on the same table. Both now route through
# EffectiveSerializable (2026-08-01), but the fix is covered by REVIEW, not by this suite: exercising it
# needs true concurrency (scratchpad/iso_race.sh's separate processes), not two connections in one process.
