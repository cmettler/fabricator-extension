# name: test/verify_delta_row_level_concurrency.test
# description: ROW-LEVEL CONCURRENCY (v1+v2, Databricks-style and beyond — OSS Spark/delta-rs/kernel
#              are all file-level; Databricks itself still conflicts with compaction): concurrent DML
#              touching the SAME FILE composes when the touched ROWS are disjoint (the COMMIT rebase
#              re-unions the deletion vectors), and v2 REMAPS rows ACROSS a concurrent rewrite
#              (OPTIMIZE / copy-on-write) by STABLE ROW ID with the row's commit version as the
#              concurrent-modification discriminator (RemapRowsAcrossRewriteAsync). The SAME row
#              modified by both writers is a row-level conflict. Applies under write_serializable (the
#              default; read checks are replaced by the row-level write validation); `serializable`
#              keeps the strict file-level checks. DV + row-tracking tables (the defaults).
#              Set FABRICATOR_DELTA_WRITE_DIR.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/rowlevel' AS rl (TYPE fabricator, PROVIDER 'delta');

# ONE file with rows 1..10 (single INSERT ⇒ single parquet) — every scenario below targets THIS file.
statement ok
CREATE TABLE rl.main.t AS SELECT r AS id, 'v' || r AS s FROM range(1, 11) t(r);

# ---- 1. concurrent DELETEs, SAME file, DIFFERENT rows → both land (was: delete/delete abort) ----

statement ok con1
BEGIN;

statement ok con1
DELETE FROM rl.main.t WHERE id = 2;

# the racer's autocommit DV delete swaps the SAME file's deletion vector under con1
statement ok con2
DELETE FROM rl.main.t WHERE id = 4;

statement ok con1
COMMIT;

query II
SELECT count(*), sum(id) FROM rl.main.t;
----
8	49

# ---- 2. the SAME row deleted by both → row-level conflict ----

statement ok con1
BEGIN;

statement ok con1
DELETE FROM rl.main.t WHERE id = 6;

statement ok con2
DELETE FROM rl.main.t WHERE id = 6;

statement error con1
COMMIT;
----
row-level conflict

# con2's delete won; con1 rolled back — id 6 deleted exactly once
query II
SELECT count(*), sum(id) FROM rl.main.t;
----
7	43

# ---- 3. buffered UPDATE vs concurrent DELETE, same file, disjoint rows → both land;
#         the UPDATE's row keeps its stable row-tracking id (post-image rebased) ----

statement ok con1
BEGIN;

statement ok con1
UPDATE rl.main.t SET s = 'updated' WHERE id = 8;

statement ok con2
DELETE FROM rl.main.t WHERE id = 9;

statement ok con1
COMMIT;

query IT
SELECT id, s FROM rl.main.t WHERE id IN (8, 9);
----
8	updated

query II
SELECT count(*), sum(id) FROM rl.main.t;
----
6	34

# ---- 4. UPDATE vs UPDATE of the SAME row → row-level conflict ----

statement ok con1
BEGIN;

statement ok con1
UPDATE rl.main.t SET s = 'A' WHERE id = 10;

statement ok con2
UPDATE rl.main.t SET s = 'B' WHERE id = 10;

statement error con1
COMMIT;
----
row-level conflict

# the first committer's value survives; no lost update
query T
SELECT s FROM rl.main.t WHERE id = 10;
----
B

# ---- 5. v2: a concurrent OPTIMIZE (file rewritten away) now COMPOSES — the DELETE's rows are
#         REMAPPED onto the compacted file by STABLE ROW ID (beyond Databricks, which still conflicts
#         with compaction). The unpushable WHERE also makes this a whole-table read — read checks are
#         replaced by the row-level write validation under write_serializable. ----

statement ok con1
BEGIN;

# unpushable predicate (whole-table read); matches id=1 only
statement ok con1
DELETE FROM rl.main.t WHERE id % 11 = 1;

query I con2
SELECT fabricator_exec('rl', 'OPTIMIZE main.t');
----
0

statement ok con1
COMMIT;

# the delete landed on the COMPACTED file (id 1 gone; everything else intact)
query II
SELECT count(*), sum(id) FROM rl.main.t;
----
5	33

query I
SELECT count(*) FROM rl.main.t WHERE id = 1;
----
0

# ---- 6. `serializable` keeps the STRICT file-level behavior (disjoint rows still conflict) ----

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/rowlevel' AS rlser (TYPE fabricator, PROVIDER 'delta', isolation_level 'serializable');

statement ok con1
BEGIN;

statement ok con1
DELETE FROM rlser.main.t WHERE id = 3;

statement ok con2
DELETE FROM rl.main.t WHERE id = 5;

statement error con1
COMMIT;
----
transaction conflict

# only the racer's delete applied
query II
SELECT count(*), sum(id) FROM rl.main.t;
----
4	28

statement ok
DETACH rlser;

# ---- 7. three-writer pile-up: two racers land during the buffered txn, all three compose ----

statement ok
CREATE TABLE rl.main.p AS SELECT r AS id FROM range(1, 21) t(r);

statement ok con1
BEGIN;

statement ok con1
DELETE FROM rl.main.p WHERE id = 10;

statement ok con2
DELETE FROM rl.main.p WHERE id = 11;

statement ok con2
DELETE FROM rl.main.p WHERE id = 12;

statement ok con1
COMMIT;

query II
SELECT count(*), sum(id) FROM rl.main.p;
----
17	177

# ---- 8. v2: buffered UPDATE + concurrent OPTIMIZE compose (pre-image remapped, post-image kept) ----

statement ok
CREATE TABLE rl.main.q AS SELECT r AS id, 'a' || r AS v FROM range(1, 7) t(r);

statement ok
INSERT INTO rl.main.q SELECT r, 'a' || r FROM range(7, 11) t(r);

statement ok con1
BEGIN;

statement ok con1
UPDATE rl.main.q SET v = 'x' WHERE id = 3;

query I con2
SELECT fabricator_exec('rl', 'OPTIMIZE main.q');
----
0

statement ok con1
COMMIT;

query IT
SELECT id, v FROM rl.main.q WHERE id IN (2, 3, 4) ORDER BY id;
----
2	a2
3	x
4	a4

query I
SELECT count(*) FROM rl.main.q;
----
10

# ---- 9. same row THROUGH a rewrite: the racer compacts AND deletes the row → row-level conflict
#         (the stable id is gone from the post-rewrite state) ----

statement ok con1
BEGIN;

statement ok con1
DELETE FROM rl.main.q WHERE id = 5;

query I con2
SELECT fabricator_exec('rl', 'OPTIMIZE main.q');
----
0

statement ok con2
DELETE FROM rl.main.q WHERE id = 5;

statement error con1
COMMIT;
----
row-level conflict

# deleted exactly once (by the racer)
query I
SELECT count(*) FROM rl.main.q;
----
9

statement ok
DETACH rl;
