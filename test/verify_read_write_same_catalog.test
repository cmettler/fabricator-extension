# name: test/verify_read_write_same_catalog.test
# description: reading and writing the SAME attached catalog in one statement (INSERT INTO t SELECT ... FROM t) — the MARS outstanding-result-set collision (error 595)
# group: [fabricator]

require fabricator

require-env MSSQL_TESTDB_DSN

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# WHAT THIS PINS
#
# A statement that both READS and WRITES one attached catalog puts an open scan reader and a
# SqlBulkCopy on the SAME pinned connection: the bulk session pins the connection at operator init,
# BEFORE the scan starts streaming, so with MARS on the scan then reuses it. SQL Server refuses that
# combination:
#
#   595: Bulk Insert with another outstanding result set should be run with XACT_ABORT on.
#
# ⚠ IT IS SIZE-DEPENDENT, WHICH IS WHY IT WENT UNNOTICED. Below roughly one buffered result the scan
# DRAINS before the bulk begins and nothing collides. MEASURED on box SQL Server 2025 with a
# (INTEGER, VARCHAR) row: 500 / 1k / 2k / 5k / 10k / 20k rows all PASS; 30k / 50k / 75k / 100k all
# FAIL. So a test at "a few rows" asserts nothing about this — the seed size below is load-bearing
# and must stay above the threshold.
#
# ⚠ NOT an isolation or locking problem, and the obvious guesses are MEASURED WRONG:
#   - READ_COMMITTED_SNAPSHOT ON at the database level changes NOTHING — 595 fires identically.
#     Snapshot isolation fixes readers BLOCKING writers; nothing here ever blocks. A lock conflict
#     would surface as a wait or a 1205 deadlock, never as this.
#   - It is a MARS protocol restriction about ERROR SEMANTICS: with a result set still outstanding,
#     a mid-flight bulk failure leaves a transaction state SQL Server will not reason about.
#
# ⚠ The engines DIVERGE here, and the irony is worth keeping: on a NO-MARS engine (Fabric /
# Synapse) this shape WORKS, because scans there are routed to a fresh POOLED connection and so
# never collide — measured 200000/200000 on Fabric Warehouse at the same 100k seed. MARS is not what
# saves us; the routing we only do BECAUSE Fabric lacks MARS is what is correct.
# See docs/transactions.md §5.1.
# ─────────────────────────────────────────────────────────────────────────────────────────────────

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS db (TYPE fabricator);

# Positive control: this suite is meaningless unless MARS is actually on, since the whole collision
# requires the scan to share the pinned connection. On the docker box engine it must be true.
query I
SELECT value FROM fabricator_server_info('db') WHERE property = 'supports_mars';
----
true

# ── §1  AUTOCOMMIT — INSERT INTO t SELECT ... FROM t above the threshold ─────────────────────────
# Not transaction-specific: the bulk session pins the connection at operator init even in
# autocommit, so the scan lands on it just the same.

statement ok
DROP TABLE IF EXISTS db.dbo.rw_auto;

statement ok
CREATE TABLE db.dbo.rw_auto (id INTEGER, pad VARCHAR);

statement ok
INSERT INTO db.dbo.rw_auto SELECT r, 'seed' FROM range(0, 30000) t(r);

statement ok
INSERT INTO db.dbo.rw_auto SELECT id + 9000000, 'copy' FROM db.dbo.rw_auto;

query I
SELECT count(*) FROM db.dbo.rw_auto;
----
60000

# The copy must be exactly one generation — never the scan re-reading its own inserts.
query II
SELECT pad, count(*) FROM db.dbo.rw_auto GROUP BY pad ORDER BY pad;
----
copy	30000
seed	30000

statement ok
DROP TABLE db.dbo.rw_auto;

# ── §2  EXPLICIT TRANSACTION — same shape inside BEGIN/COMMIT ────────────────────────────────────

statement ok
DROP TABLE IF EXISTS db.dbo.rw_txn;

statement ok
CREATE TABLE db.dbo.rw_txn (id INTEGER, pad VARCHAR);

statement ok
INSERT INTO db.dbo.rw_txn SELECT r, 'seed' FROM range(0, 30000) t(r);

statement ok
BEGIN;

statement ok
INSERT INTO db.dbo.rw_txn SELECT id + 9000000, 'copy' FROM db.dbo.rw_txn;

statement ok
COMMIT;

query I
SELECT count(*) FROM db.dbo.rw_txn;
----
60000

statement ok
DROP TABLE db.dbo.rw_txn;

# ── §3  READ-YOUR-WRITES is preserved (MARS engines have it today; must not regress) ─────────────
# A scan inside a write transaction sees that transaction's own uncommitted rows. This is what a
# materialise-the-scan fix must PRESERVE on box — and what it is meant to RESTORE on no-MARS
# engines, where the pooled-scan routing gives it up (measured on Fabric: this returns 3, not 4).

statement ok
DROP TABLE IF EXISTS db.dbo.rw_ryw;

statement ok
CREATE TABLE db.dbo.rw_ryw (id INTEGER, tag VARCHAR);

statement ok
INSERT INTO db.dbo.rw_ryw VALUES (1,'seed'),(2,'seed'),(3,'seed');

statement ok
BEGIN;

statement ok
INSERT INTO db.dbo.rw_ryw VALUES (4,'intxn');

query I
SELECT count(*) FROM db.dbo.rw_ryw;
----
4

statement ok
COMMIT;

query I
SELECT count(*) FROM db.dbo.rw_ryw;
----
4

statement ok
DROP TABLE db.dbo.rw_ryw;

# ── §4  Small-table control — the shape that ALWAYS worked ───────────────────────────────────────
# Load-bearing: without it, §1/§2 going green could equally mean self-insert had stopped working
# altogether rather than that the collision was fixed.

statement ok
DROP TABLE IF EXISTS db.dbo.rw_small;

statement ok
CREATE TABLE db.dbo.rw_small (id INTEGER, pad VARCHAR);

statement ok
INSERT INTO db.dbo.rw_small SELECT r, 'seed' FROM range(0, 100) t(r);

statement ok
INSERT INTO db.dbo.rw_small SELECT id + 9000000, 'copy' FROM db.dbo.rw_small;

query I
SELECT count(*) FROM db.dbo.rw_small;
----
200

statement ok
DROP TABLE db.dbo.rw_small;

statement ok
DETACH db;

# ── §5  mssql_materialize=false — the opt-out keeps the scan STREAMING ───────────────────────────
# Instead of buffering, the marked scan is routed to a POOLED connection at SNAPSHOT isolation, so it
# shares no connection with the pinned writer. Same correct answer, no buffer, no read-your-writes.
#
# ⚠ REQUIRES ALLOW_SNAPSHOT_ISOLATION on the database — provisioned on TestDB by docker/provision.ps1.
# The snapshot is NOT optional: falling back to READ COMMITTED was MEASURED to HANG (unbounded lock
# wait, no error), so the code sets it unconditionally and refuses up front when the database says no.
#
# ⚠ THE NEGATIVE CASE IS NOT COVERED HERE and that is a real gap, not an oversight. It needs a database
# WITHOUT snapshot isolation; ArrowTest is exactly that, but this tier publishes no DSN for it, and
# toggling the setting off mid-suite would leave the rig broken for later runs if the suite aborted.
# Verified by hand instead: the scan fails at scan_table (before any work) with a message naming
# mssql_materialize and both remedies — see EnsureSnapshotIsolationAllowed.
#
# NOTE: end with SET mssql_materialize=true, not RESET — RESET does not fire an extension option's
# set-callback, so it would leak materialize=false into every later .test file in the same process.

statement ok
SET mssql_materialize=false;

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS nomat (TYPE fabricator);

statement ok
DROP TABLE IF EXISTS nomat.dbo.rw_stream;

statement ok
CREATE TABLE nomat.dbo.rw_stream (id INTEGER, pad VARCHAR);

statement ok
INSERT INTO nomat.dbo.rw_stream SELECT r, 'seed' FROM range(0, 30000) t(r);

statement ok
INSERT INTO nomat.dbo.rw_stream SELECT id + 9000000, 'copy' FROM nomat.dbo.rw_stream;

query I
SELECT count(*) FROM nomat.dbo.rw_stream;
----
60000

query II
SELECT pad, count(*) FROM nomat.dbo.rw_stream GROUP BY pad ORDER BY pad;
----
copy	30000
seed	30000

statement ok
DROP TABLE nomat.dbo.rw_stream;

statement ok
DETACH nomat;

statement ok
SET mssql_materialize=true;

# ── §6  the same opt-out as a PER-CATALOG ATTACH option, with no SET in force ────────────────────
# Load-bearing: it proves the option is per-catalog rather than process-global. Without the second
# catalog below, `materialize false` could be leaking into every attach and this would still pass.

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS attnomat (TYPE fabricator, materialize false);

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS attdefault (TYPE fabricator);

statement ok
DROP TABLE IF EXISTS attnomat.dbo.rw_att;

statement ok
CREATE TABLE attnomat.dbo.rw_att (id INTEGER, pad VARCHAR);

statement ok
INSERT INTO attnomat.dbo.rw_att SELECT r, 'seed' FROM range(0, 30000) t(r);

statement ok
INSERT INTO attnomat.dbo.rw_att SELECT id + 9000000, 'copy' FROM attnomat.dbo.rw_att;

query I
SELECT count(*) FROM attnomat.dbo.rw_att;
----
60000

statement ok
DROP TABLE attnomat.dbo.rw_att;

# The OTHER catalog took no option, so it still materialises — and therefore still has
# read-your-writes. This is the assertion that makes §6 about scoping rather than about the value.

statement ok
DROP TABLE IF EXISTS attdefault.dbo.rw_att2;

statement ok
CREATE TABLE attdefault.dbo.rw_att2 (id INTEGER, tag VARCHAR);

statement ok
INSERT INTO attdefault.dbo.rw_att2 VALUES (1,'seed');

statement ok
BEGIN;

statement ok
INSERT INTO attdefault.dbo.rw_att2 VALUES (2,'intxn');

query I
SELECT count(*) FROM attdefault.dbo.rw_att2;
----
2

statement ok
COMMIT;

statement ok
DROP TABLE attdefault.dbo.rw_att2;

statement ok
DETACH attnomat;

statement ok
DETACH attdefault;

# ── §7  mssql_mars=false: a scan that would DEADLOCK against its own transaction is REFUSED ───────
# With MARS off a data scan cannot share the transaction's pinned connection, so it takes a POOLED one.
# Reading a table this same transaction has written then waits on locks only that transaction can release —
# and it cannot, because it is blocked waiting for this very scan. SQL Server's deadlock monitor cannot see
# it (one session waits, the other sits idle) and mssql_command_timeout defaults to 0 = infinite, so the
# symptom was an UNBOUNDED HANG with no error. See docs/known-limitations.md 1.15.
#
# ⚠ THE POSITIVE CONTROLS ARE THE LOAD-BEARING HALF. A suite that only asserted the refusal would pass
# equally if reading inside a write transaction had stopped working altogether, or if the refusal fired on
# every table. Both controls below deny that: an UNTOUCHED table still reads (so the check is precise, not
# blanket), and the whole shape works with MARS on (so nothing about it is broken in the shipped default).
#
# ⚠ mssql_mars is resolved ONCE per catalog at its first connection, so it must be SET before the ATTACH
# and the catalog must be a fresh one. Restore with SET (not RESET — RESET does not fire the set-callback,
# so it would leak mars=false into every later .test file in this process).

statement ok
SET mssql_mars='false';

# ⚠ BOUND THE FAILURE MODE. If the refusal below ever regresses, the statement does not fail — it HANGS,
# unbounded (mssql_command_timeout defaults to 0 = infinite), which would stall the whole service tier
# instead of failing it. A finite timeout turns a regression into a loud error. Restored to 0 at the end.
statement ok
SET mssql_command_timeout=30;

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS nomars (TYPE fabricator);

statement ok
DROP TABLE IF EXISTS nomars.dbo.rw_lock_w;

statement ok
DROP TABLE IF EXISTS nomars.dbo.rw_lock_u;

statement ok
CREATE TABLE nomars.dbo.rw_lock_w (id INTEGER, tag VARCHAR);

statement ok
CREATE TABLE nomars.dbo.rw_lock_u (id INTEGER);

statement ok
INSERT INTO nomars.dbo.rw_lock_w VALUES (1,'seed'),(2,'seed');

statement ok
INSERT INTO nomars.dbo.rw_lock_u VALUES (7),(8),(9);

statement ok
BEGIN;

statement ok
INSERT INTO nomars.dbo.rw_lock_w VALUES (3,'intxn');

# POSITIVE CONTROL: a table this transaction has NOT written still reads. Without this the refusal below
# could pass by refusing every scan in a write transaction.
query I
SELECT count(*) FROM nomars.dbo.rw_lock_u;
----
3

# The refusal: named table, named setting, and it arrives at once instead of hanging forever.
statement error
SELECT count(*) FROM nomars.dbo.rw_lock_w;
----
cannot read

statement ok
ROLLBACK;

# An uncommitted ALTER is refused for a DIFFERENT reason and must stay refused even where row versioning is
# on: Sch-M blocks a reader's Sch-S at EVERY isolation level, because row versioning does not version
# METADATA. ⚠ The blocking query here is the bind-time SCHEMA PROBE (`WHERE 1 = 0`) — it reads no rows, so
# it is exempt from the data-write case, and exempting it from this one too was measured to reproduce the
# original hang.
statement ok
BEGIN;

statement ok
ALTER TABLE nomars.dbo.rw_lock_u ADD COLUMN extra INTEGER;

statement error
SELECT count(*) FROM nomars.dbo.rw_lock_u;
----
uncommitted schema change

statement ok
ROLLBACK;

statement ok
DROP TABLE nomars.dbo.rw_lock_w;

statement ok
DROP TABLE nomars.dbo.rw_lock_u;

statement ok
DETACH nomars;

statement ok
SET mssql_mars='auto';

statement ok
SET mssql_command_timeout=0;

# POSITIVE CONTROL for the whole section: with MARS on (the shipped default on box) the SAME shape works —
# the scan shares the pinned connection, so there is nothing to refuse and read-your-writes holds.
statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS marson (TYPE fabricator);

statement ok
DROP TABLE IF EXISTS marson.dbo.rw_lock_ok;

statement ok
CREATE TABLE marson.dbo.rw_lock_ok (id INTEGER);

statement ok
INSERT INTO marson.dbo.rw_lock_ok VALUES (1),(2);

statement ok
BEGIN;

statement ok
INSERT INTO marson.dbo.rw_lock_ok VALUES (3);

query I
SELECT count(*) FROM marson.dbo.rw_lock_ok;
----
3

statement ok
COMMIT;

statement ok
DROP TABLE marson.dbo.rw_lock_ok;

statement ok
DETACH marson;
