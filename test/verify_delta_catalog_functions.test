# name: test/verify_delta_catalog_functions.test
# description: CATALOG-BOUND CUSTOM FUNCTIONS ON THE DELTA CATALOG — the hosting mechanism, not any particular
#              function. Until this landed, all seven of DeltaCatalog's function ABI members were
#              `throw NoFunctions()` and the FUNCTIONS metadata kind fell through to a 1-column empty fallback,
#              so the Delta provider could declare macros but not functions. docs/fabric-api-functions.md §2.
#
#              WHY IT IS WORTH A SUITE OF ITS OWN. The functions this unlocks (the Fabric REST API set) cannot be
#              tested without a live tenant, so without this file the HOSTING would only ever be exercised by
#              code that also needs credentials — meaning a regression in the hosting would look like a Fabric
#              outage. Everything here is hermetic: one local Delta root, no service, no network.
#
#              WHAT IS ASSERTED, and the failure mode each catches:
#                (§1) the declaration reaches DuckDB as a FUNCTION of the right type, in every discovered schema
#                     (the kind-6 stream is built IN MEMORY here — this provider has no SQL engine to assemble a
#                     discovery query with, which is exactly why FunctionsMetadata exists);
#                (§2) it EXECUTES over the ABI and returns catalog context — the property the catalog-bound form
#                     exists for, and the one a global function or a macro cannot provide;
#                (§3) the bare name does NOT resolve — the single assertion separating catalog-bound from global.
#                     Without it, a regression that registered these globally would pass every other section;
#                (§4) NEGATIVE CONTROL: the Fabric REST functions are ABSENT on a non-OneLake root. They are
#                     registered only when the root is OneLake, because off Fabric they have no workspace, no
#                     item and no REST credential — advertising them would put functions in the catalog that can
#                     only fail. A regression that registered them unconditionally is invisible without this;
#                (§5) macros and functions COEXIST (they ride different metadata kinds and different host
#                     registration paths, so one silently displacing the other is a real shape of bug);
#                (§6) survives a cache refresh, like the macros do.
# group: [fabricator]

require fabricator

require-env FABRICATOR_DELTA_WRITE_DIR

# An EMPTY root is enough: a declaration binds into the schemas the catalog discovers, and needs no table.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}' AS lake (TYPE fabricator, PROVIDER 'delta');

# ---- 1. the declaration arrived as a real table FUNCTION (not a macro) in the discovered schema ----

query IIII
SELECT function_name, function_type, schema_name, database_name
FROM duckdb_functions()
WHERE database_name = 'lake' AND function_name = 'fab_delta_info'
ORDER BY function_name;
----
fab_delta_info	table	main	lake

# ---- 2. it executes over the ABI and reports THIS catalog's context ----
#
# ZERO ARGUMENTS is the load-bearing part, not a convenience: it is the shape a function that infers everything
# from its ATTACH needs, and it only works because an empty parameter schema is never marshaled as an Arrow batch
# (Apache.Arrow can neither export nor import a zero-field schema — it throws ArgumentNullException on 'fields').
# The host therefore passes NO args stream for an argument-less function, and the C# side exports the empty
# parameter schema through ArrowSchemaExport. Break either half and this function silently DISAPPEARS from the
# catalog, because the host treats a failed schema fetch as "the function is stale" and erases it.

query I
SELECT count(*) >= 4 FROM lake.main.fab_delta_info();
----
true

# The root it reports is the ATTACH root after normalization (forward slashes, no trailing slash) — compared via
# a normalizing expression rather than pasted, because the harness supplies a native path.
query I
SELECT value = replace(rtrim('${FABRICATOR_DELTA_WRITE_DIR}', '/'), '\', '/')
FROM lake.main.fab_delta_info() WHERE property = 'root';
----
true

# PROVIDER 'delta' selects the native (DuckDB parquet) engine on both legs, and this root is not OneLake — so the
# function is reading real catalog state, not echoing constants.
query II
SELECT property, value FROM lake.main.fab_delta_info()
WHERE property IN ('native_read', 'native_write', 'onelake') ORDER BY property;
----
native_read	true
native_write	true
onelake	false

# ---- 3. the bare name must NOT resolve — this is what makes it catalog-BOUND ----

statement error
SELECT * FROM fab_delta_info();
----
<REGEX>:.*fab_delta_info.*

# ---- 4. NEGATIVE CONTROL: the Fabric REST functions are absent on a non-OneLake root ----
#
# They are registered only for a OneLake root (DeltaCatalog.BuildFunctionSet). This root is local, so none of
# them may appear — and the count form is deliberate: it fails loudly if ANY of them leaks in, whereas probing
# one name by hand would miss the others. That generality is doing real work: the set is ~51 functions across
# shortcuts, jobs, semantic models, git, deployment pipelines, variable libraries, sessions and platform reads,
# and this one assertion guards every one of them against being registered where it cannot possibly work.
#
# ⚠ KEYED ON THE SCHEMA, NOT ON A NAME PREFIX. This used to read `function_name LIKE 'fabric\_%'`, which was
# correct while the functions were named fabric_*; once they moved into the `fabric` SCHEMA and dropped the
# prefix, that pattern matched NOTHING WHETHER OR NOT THE SET WAS REGISTERED — a tripwire that looks armed and
# is not. Do not reintroduce a name-prefix form here.
query I
SELECT count(*) FROM duckdb_functions()
WHERE database_name = 'lake' AND schema_name = 'fabric';
----
0

# And the SCHEMA itself must not be advertised. This is the sharper assertion of the two, because the schema
# declaration IS the gate: the host silently DROPS a declared function whose schema it did not register, so if
# CatalogSchemaNames ever stopped gating on IsOneLake, the functions above would appear here.
query I
SELECT count(*) FROM information_schema.schemata
WHERE catalog_name = 'lake' AND schema_name = 'fabric';
----
0

# ---- 5. macros and functions coexist (different metadata kinds, different registration paths) ----

query II
SELECT
  (SELECT count(*) FROM duckdb_functions()
     WHERE database_name = 'lake' AND function_type IN ('macro', 'table_macro')) >= 3,
  (SELECT count(*) FROM duckdb_functions()
     WHERE database_name = 'lake' AND function_name = 'fab_delta_info') = 1;
----
true	true

# A macro still expands correctly with functions registered alongside it.
query R
SELECT lake.main.fab_pct(25, 200);
----
12.5

# ---- 6. NAMED parameters — how an OPTIONAL argument is expressed ----
#
# DuckDB positional table arguments have no defaults, so without named parameters a function with N optional
# knobs forces every caller to write fn(NULL, NULL, …) — which is exactly why the Fabric functions used to
# ship an `_ex` sibling each. A parameter tagged `fabricator.named` in the parameter schema becomes a DuckDB
# named parameter instead; the host splits on that tag and the binding still reads args BY POSITION
# (Parameters ++ NamedParameters in declared order), with an omitted argument arriving as NULL.
#
# The zero-argument call above (§2) already proves the omitted case, since `property` is named-and-absent
# there. These pin the supplied case, both spellings, and the rejection.

query II
SELECT * FROM lake.main.fab_delta_info(property => 'native_read');
----
native_read	true

# `:=` and `=>` are both DuckDB named-argument spellings; a provider function must accept either.
query I
SELECT value FROM lake.main.fab_delta_info(property := 'onelake');
----
false

# Filtering happened in the FUNCTION, not above it: an unknown property yields no rows rather than all of them
# (i.e. the argument really crossed the ABI).
query I
SELECT count(*) FROM lake.main.fab_delta_info(property := 'no_such_property');
----
0

# A misspelled named parameter must be a clean BINDER error listing candidates — not silently ignored, which
# would run the unfiltered query and look like it worked.
statement error
SELECT * FROM lake.main.fab_delta_info(nope := 'x');
----
<REGEX>:.*Invalid named parameter.*nope.*

# The named parameter must NOT be callable positionally: it is not in the positional signature at all.
statement error
SELECT * FROM lake.main.fab_delta_info('root');
----
<REGEX>:.*

# ---- 7. a cache refresh re-discovers the function (re-runs the same declaration path) ----

statement ok
SELECT fabricator_refresh_cache('lake');

query I
SELECT value = replace(rtrim('${FABRICATOR_DELTA_WRITE_DIR}', '/'), '\', '/')
FROM lake.main.fab_delta_info() WHERE property = 'root';
----
true

statement ok
DETACH lake;

# ---- 8. the `delta` FUNCTION NAMESPACE — declared on EVERY Delta attach (local included) --------------------
# The delta.* functions replaced the C++-registered fabricator_delta_* fronts (metadata kinds 8-11/13-14,
# deleted at ABI v70). Three properties pinned, each a distinct failure shape:
#   (a) the schema is ADVERTISED — the host drops a declared function whose schema it did not register, so a
#       regression in CatalogSchemaNames makes all six functions vanish with NO error (measured for `fabric`:
#       the ATTACH succeeds and the call fails as "Table Function ... does not exist");
#   (b) all six functions are declared IN it, as table functions;
#   (c) DDL into it is REFUSED — a CREATE TABLE there would make a real delta/ folder that the NEXT attach
#       discovers as a data schema, silently un-separating the namespace.

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/fnroot2' AS dns (TYPE fabricator, PROVIDER 'delta');

query I
SELECT count(*) FROM duckdb_schemas() WHERE database_name = 'dns' AND schema_name = 'delta';
----
1

query II
SELECT function_name, function_type FROM duckdb_functions()
WHERE database_name = 'dns' AND schema_name = 'delta'
ORDER BY function_name;
----
changes	table
get_transaction_version	table
set_tblproperties	table
set_transaction_version	table
snapshots	table
tblproperties	table

# One of them actually EXECUTES against this catalog (the empty root discovers no tables, so an unknown table
# is the honest probe — the function is reachable and resolves the reference, then reports absence).
statement error
SELECT * FROM dns.delta.snapshots('main.nosuch');
----

statement error
CREATE TABLE dns.delta.t (x INTEGER);
----
<REGEX>:.*FUNCTION namespace.*

statement ok
DETACH dns;
