# name: test/verify_delta_catalog_compaction_rowtracking.test
# description: `materialize_row_tracking true` — OPTIMIZE (compaction) mixes rows from several source files into
#              one compacted file, so a single baseRowId / defaultRowCommitVersion cannot represent them.
#              Compaction therefore MATERIALIZES each row's ORIGINAL stable id (__delta_row_id) AND commit version
#              (__delta_row_commit_version), so a spec reader (Spark) preserves both across OPTIMIZE. This is the
#              write-shape check (the compacted parquet carries the original per-source ids + distinct versions);
#              the end-to-end row-id readback is validated on Fabric Spark. Set ARROWNET_DELTA_WRITE_DIR. Local FS.
# group: [mssql_net]

require mssql_net

require parquet

require-env ARROWNET_DELTA_WRITE_DIR

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/compactrt' AS lake (TYPE arrownet, PROVIDER 'delta', column_mapping 'none', materialize_row_tracking true);

# Three separately-written small files → three distinct (baseRowId, defaultRowCommitVersion) source ranges.
# CTAS (id=10) → base_row_id 0; each INSERT bumps the high-water mark → base_row_id 1, then 2. Each is written
# at its own commit version.
statement ok
CREATE TABLE lake.main.t AS SELECT 10 AS id;

statement ok
INSERT INTO lake.main.t VALUES (20);

statement ok
INSERT INTO lake.main.t VALUES (30);

query I
SELECT count(*) FROM glob('${ARROWNET_DELTA_WRITE_DIR}/compactrt/t/*.parquet');
----
3

# OPTIMIZE consolidates the three tiny files into one (they're far under the target file size).
statement ok
SELECT mssql_net_exec('lake', 'OPTIMIZE main.t');

# VACUUM the superseded originals away so ONLY the compacted file remains — the read below then reflects it.
statement ok
SELECT mssql_net_exec('lake', 'VACUUM main.t RETAIN 0 HOURS');

# Data is unchanged and complete after compaction.
query I
SELECT id FROM lake.main.t ORDER BY id;
----
10
20
30

# The compacted file preserves each row's ORIGINAL materialized __delta_row_id (0,1,2 = the per-source
# baseRowId + position), NOT a fresh high-water-mark range — so Spark reads the row id preserved across OPTIMIZE.
query II
SELECT id, "__delta_row_id"
FROM read_parquet('${ARROWNET_DELTA_WRITE_DIR}/compactrt/t/*.parquet', union_by_name=true)
ORDER BY id;
----
10	0
20	1
30	2

# The compacted file also materializes __delta_row_commit_version PER ROW: three files written at three distinct
# commits → three distinct versions carried through (a single defaultRowCommitVersion on the compacted add could
# not represent them). The versions increase with write order (CTAS < INSERT#1 < INSERT#2 == id order).
query I
SELECT count(DISTINCT "__delta_row_commit_version")
FROM read_parquet('${ARROWNET_DELTA_WRITE_DIR}/compactrt/t/*.parquet', union_by_name=true);
----
3

query I
SELECT
  (SELECT "__delta_row_commit_version" FROM read_parquet('${ARROWNET_DELTA_WRITE_DIR}/compactrt/t/*.parquet', union_by_name=true) WHERE id = 10)
  < (SELECT "__delta_row_commit_version" FROM read_parquet('${ARROWNET_DELTA_WRITE_DIR}/compactrt/t/*.parquet', union_by_name=true) WHERE id = 30);
----
true

# Durability: detach + re-attach reads the compacted table correctly.
statement ok
DETACH lake;

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/compactrt' AS lake2 (TYPE arrownet, PROVIDER 'delta', column_mapping 'none', materialize_row_tracking true);

query I
SELECT id FROM lake2.main.t ORDER BY id;
----
10
20
30

statement ok
DETACH lake2;
