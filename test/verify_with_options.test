# name: test/verify_with_options.test
# description: CREATE TABLE [AS] ... WITH (key='value', ...) options on the Delta provider (ABI v67 —
#              docs/create-table-with-options.md slice A). Three key kinds: per-statement WRITE TUNING
#              (parquet_compression / parquet_row_group_size / parquet_bloom_filter_columns — DuckLake-parity
#              names; WITH > delta_write_options > ATTACH defaults), per-table CREATE-FLAG OVERRIDES
#              (deletion_vectors / column_mapping / row_tracking / change_data_feed / in_commit_timestamps —
#              e.g. the protocol-1.0 recipe without a dedicated ATTACH), and delta.*/fabricator.* TABLE
#              PROPERTIES stamped in the CREATE commit itself (well-known keys re-cased to spec spelling —
#              DuckDB's parser lowercases every WITH key). Unknown keys are REJECTED, never ignored.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optlake' AS lake (TYPE fabricator, PROVIDER 'delta', native_read true, native_write true);

# ==== 1. write tuning (CTAS, native streaming COPY) ====

statement ok
CREATE OR REPLACE TABLE lake.main.tuned
  WITH (parquet_compression='zstd', parquet_row_group_size=5000)
AS SELECT i, 'v' || i AS s FROM range(20000) t(i);

query I
SELECT count(*) FROM lake.main.tuned;
----
20000

query I
SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlake/tuned/*.parquet')
WHERE compression <> '';
----
ZSTD

query I
SELECT count(DISTINCT row_group_id) FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlake/tuned/*.parquet');
----
4

# precedence: WITH beats the delta_write_options session setting; the setting still applies when no WITH
statement ok
SET delta_write_options = '{"compression":"gzip"}';

statement ok
CREATE OR REPLACE TABLE lake.main.tuned2 WITH (parquet_compression='zstd') AS SELECT 1 AS id;

query I
SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlake/tuned2/*.parquet')
WHERE compression <> '';
----
ZSTD

statement ok
CREATE OR REPLACE TABLE lake.main.tuned3 AS SELECT 1 AS id;

query I
SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlake/tuned3/*.parquet')
WHERE compression <> '';
----
GZIP

statement ok
SET delta_write_options = '';

# ==== 2. per-table create-flag overrides ====

# the protocol-1.0 recipe (SQL Server / PolyBase readable) on a DV-DEFAULT catalog: WITH opts this one
# table out — plain minReader 1, no deletionVectors feature, no column mapping
statement ok
CREATE OR REPLACE TABLE lake.main.plainrec
  WITH (deletion_vectors=false, column_mapping='none')
AS SELECT i AS id FROM range(5) t(i);

query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/optlake/plainrec/_delta_log/*.json')
WHERE content LIKE '%deletionVectors%' OR content LIKE '%columnMapping%';
----
0

query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/optlake/plainrec/_delta_log/*.json')
WHERE content LIKE '%"minReaderVersion":1%';
----
1

# a DEFAULT-created sibling in the same catalog keeps the catalog defaults (DV + mapping)
statement ok
CREATE OR REPLACE TABLE lake.main.defaults AS SELECT 1 AS id;

query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/optlake/defaults/_delta_log/*.json')
WHERE content LIKE '%delta.enableDeletionVectors%';
----
1

# the reverse override: a DV-OFF catalog, one table opts IN
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optlake2' AS lake2 (TYPE fabricator, PROVIDER 'delta', deletion_vectors false, column_mapping 'none');

statement ok
CREATE OR REPLACE TABLE lake2.main.dvon WITH (deletion_vectors=true) AS SELECT 1 AS id;

query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/optlake2/dvon/_delta_log/*.json')
WHERE content LIKE '%delta.enableDeletionVectors%';
----
1

# flags also work on an EMPTY CREATE (DDL path, no AS)
statement ok
CREATE TABLE lake.main.plainrec2 (id INTEGER, s VARCHAR) WITH (deletion_vectors=false, column_mapping='none');

statement ok
INSERT INTO lake.main.plainrec2 VALUES (1, 'a'), (2, 'b');

query II
SELECT id, s FROM lake.main.plainrec2 ORDER BY id;
----
1	a
2	b

query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/optlake/plainrec2/_delta_log/*.json')
WHERE content LIKE '%deletionVectors%' OR content LIKE '%columnMapping%';
----
0

# ==== 3. delta.*/fabricator.* properties stamped at CREATE (one commit, no set_tblproperties two-step) ====

statement ok
CREATE OR REPLACE TABLE lake.main.proptest
  WITH ("delta.isolationLevel"='Serializable', "fabricator.mytag"='hello')
AS SELECT 1 AS id;

# the well-known key is re-cased to its spec spelling (DuckDB's parser lowercases WITH keys)
query II
SELECT property, value FROM lake.delta.tblproperties('main.proptest')
WHERE property IN ('delta.isolationLevel', 'fabricator.mytag') ORDER BY 1;
----
delta.isolationLevel	Serializable
fabricator.mytag	hello

# stamped in commit-0 itself (the CREATE), not a follow-up property commit
query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/optlake/proptest/_delta_log/00000000000000000000.json')
WHERE content LIKE '%delta.isolationLevel%';
----
1

# ==== 4. buffered (explicit-transaction) CREATE/CTAS parks the options; the flush applies them ====

statement ok
BEGIN;

statement ok
CREATE TABLE lake.main.txnopt
  WITH (deletion_vectors=false, column_mapping='none', "delta.isolationLevel"='Serializable')
AS SELECT i AS id FROM range(7) t(i);

# read-your-writes from the buffer (nothing on storage yet)
query I
SELECT count(*) FROM lake.main.txnopt;
----
7

statement ok
COMMIT;

query I
SELECT count(*) FROM lake.main.txnopt;
----
7

query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/optlake/txnopt/_delta_log/*.json')
WHERE content LIKE '%deletionVectors%' OR content LIKE '%columnMapping%';
----
0

query II
SELECT property, value FROM lake.delta.tblproperties('main.txnopt')
WHERE property = 'delta.isolationLevel' ORDER BY 1;
----
delta.isolationLevel	Serializable

# ROLLBACK discards a buffered options-carrying CTAS entirely
statement ok
BEGIN;

statement ok
CREATE TABLE lake.main.txngone WITH (deletion_vectors=false) AS SELECT 1 AS id;

statement ok
ROLLBACK;

statement error
SELECT count(*) FROM lake.main.txngone;
----

# ==== 5. guards — a WITH option is never silently ignored ====

statement error
CREATE OR REPLACE TABLE lake.main.bad WITH (nonsense='x') AS SELECT 1 AS id;
----
unknown CREATE TABLE WITH option 'nonsense'

# write tuning has no write to apply to on an empty CREATE
statement error
CREATE TABLE lake.main.bad2 (id INTEGER) WITH (parquet_compression='zstd');
----
apply to the statement's write

# feature-enabling property spellings point at the explicit keys
statement error
CREATE OR REPLACE TABLE lake.main.bad3 WITH ("delta.enableChangeDataFeed"='true') AS SELECT 1 AS id;
----
use the explicit WITH keys

statement error
CREATE OR REPLACE TABLE lake.main.bad4 WITH (location='s3://elsewhere/t') AS SELECT 1 AS id;
----
path IS its identity

statement error
CREATE OR REPLACE TABLE lake.main.bad5 WITH (partitioned_by='id') AS SELECT 1 AS id;
----
use the native clause

statement error
CREATE OR REPLACE TABLE lake.main.bad6 WITH (table_type='ICEBERG') AS SELECT 1 AS id;
----
ICEBERG has no writer

statement error
CREATE OR REPLACE TABLE lake.main.bad7 WITH (deletion_vectors='maybe') AS SELECT 1 AS id;
----
expected a boolean

statement error
CREATE OR REPLACE TABLE lake.main.bad8 WITH (parquet_row_group_size='lots') AS SELECT 1 AS id;
----
expected a positive integer

# non-constant option values are rejected at bind (host-side)
statement error
CREATE OR REPLACE TABLE lake.main.bad9 WITH (parquet_compression=lower('ZSTD')) AS SELECT 1 AS id;
----
must be a constant value

statement error
CREATE OR REPLACE TABLE lake.main.bad10 WITH (deletion_vectors=NULL) AS SELECT 1 AS id;
----
must not be NULL

# table_type='DELTA' / format='parquet' are validated no-ops (the Iceberg-style DDL shape)
statement ok
CREATE OR REPLACE TABLE lake.main.iceshape
  WITH (table_type='DELTA', format='parquet')
AS SELECT 1 AS id;

query I
SELECT count(*) FROM lake.main.iceshape;
----
1

# ==== cleanup ====

statement ok
DROP TABLE lake.main.tuned;

statement ok
DROP TABLE lake.main.tuned2;

statement ok
DROP TABLE lake.main.tuned3;

statement ok
DROP TABLE lake.main.plainrec;

statement ok
DROP TABLE lake.main.plainrec2;

statement ok
DROP TABLE lake.main.defaults;

statement ok
DROP TABLE lake.main.proptest;

statement ok
DROP TABLE lake.main.txnopt;

statement ok
DROP TABLE lake.main.iceshape;

statement ok
DROP TABLE lake2.main.dvon;

statement ok
DETACH lake;

statement ok
DETACH lake2;

# ---- WRITE TUNING MUST REACH THE FILES A *TRANSACTION* WRITES, NOT ONLY THE BULK PATH ----
# ⚠ It did not. Every open of an engineered-wood table in the Bridge passed NO write spec except the one
# in the eager-write helper, so the (DuckDB txn, table) pair's HELD table — which writes the CDF change
# files and any batches the flush parks — fell back to snappy / 122880 rows / no bloom filters while the
# same table's CTAS files honoured the setting. MEASURED before the fix: data ZSTD, change files SNAPPY,
# in one table. A user setting zstd for storage cost silently got snappy on everything a transaction wrote.
# The CODEC engine is required, not incidental: under native_write DuckDB's COPY writes the data files, so
# engineered-wood's ParquetWriteOptions never apply and this assertion would pass for the wrong reason.
statement ok
SET delta_write_options = '{"compression":"zstd"}';

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optspec' AS lake9
  (TYPE fabricator, PROVIDER 'engineeredwooddelta', change_data_feed true);

statement ok
CREATE TABLE lake9.main.t AS SELECT i AS id, i * 2 AS a FROM range(1, 2001) AS r(i);

# POSITIVE CONTROL: the bulk path always honoured the setting. If this ever reads SNAPPY the test below
# proves nothing, because both halves would simply be following the same (wrong) default.
query I
SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optspec/t/*.parquet')
WHERE compression <> '';
----
ZSTD

statement ok
BEGIN;

statement ok
UPDATE lake9.main.t SET a = a + 1 WHERE id <= 100;

statement ok
COMMIT;

# THE ASSERTION: the change files the HELD table wrote carry the configured codec too.
query I
SELECT DISTINCT compression
FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optspec/t/_change_data/*.parquet')
WHERE compression <> '';
----
ZSTD

# The feed itself is still correct — a write-options change must not alter what the UPDATE recorded.
query II
SELECT _change_type, count(*) FROM lake9.delta.changes('main.t', starting_version := 2)
WHERE _change_type LIKE 'update_%' GROUP BY 1 ORDER BY 1;
----
update_postimage	100
update_preimage	100

statement ok
DETACH lake9;

# ---- …AND THE SAME HELD TABLE ON THE **NATIVE** ENGINE ----
# ⚠ THE SECTION ABOVE COULD NOT CATCH THIS, AND SAYS SO IN ITS OWN COMMENT: it needs the CODEC engine,
# because under native_write DuckDB's COPY writes the bytes and engineered-wood's ParquetWriteOptions never
# apply. So the held table's NATIVE half was asserted NOWHERE, and it was broken — the spec reached
# DeltaWriter.Options (the EW half) while NativeParquetDataFileWriter was still constructed without it.
# MEASURED before the fix: codec ZSTD, native SNAPPY, same statements. Fixing "half the writers" is
# invisible to a gate pinned on the half that works.
#
# ⚠ THE TABLE MUST HAVE AN IDENTITY COLUMN. The eager-write buffer writes almost everything at STATEMENT
# time, where a different (already correct) code path applies the spec. The one branch that still RETAINS
# batches until COMMIT — and so writes them through the HELD table — is identity/iceberg or a pending
# ALTER. Without the identity column this section passes with the bug fully present.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optspecnat' AS lake9n
  (TYPE fabricator, PROVIDER 'delta', native_read true, native_write true);

statement ok
CREATE TABLE lake9n.main.ident (id BIGINT AS (0), v BIGINT);

statement ok
BEGIN;

statement ok
INSERT INTO lake9n.main.ident (v) SELECT i FROM range(2000) t(i);

statement ok
COMMIT;

query I
SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optspecnat/ident/*.parquet')
WHERE compression <> '';
----
ZSTD

# The rows are all there — a write-options change must not alter what the transaction wrote.
query I
SELECT count(*) FROM lake9n.main.ident;
----
2000

statement ok
RESET delta_write_options;

statement ok
DETACH lake9n;

# ============================================================================
# THE REWRITE PATHS HONOUR THE WRITE SPEC — the merge-on-read UPDATE's post-image file and OPTIMIZE's
# compaction output. Both are written by DeltaReader, which is STATIC, while ResolveWriteSpec lives on the
# catalog INSTANCE — so for a long time they silently used engineered-wood's defaults and a table
# accumulated MIXED compression. OPTIMIZE is the one that stings: it rewrites the MAJORITY of a table's
# bytes, so it actively undid the setting it was configured for.
# ⚠ Pinned on the NATIVE engine deliberately. Under native_write the file is written by DuckDB's COPY, not
# by engineered-wood, so threading the spec into the EW open was necessary and NOT sufficient — the spec
# also has to reach NativeParquetDataFileWriter's COPY options. A codec-only gate would have passed while
# the shipped default path was still wrong.
# ============================================================================

statement ok
SET delta_write_options='{"compression":"zstd"}';

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optrw' AS rw (TYPE fabricator, PROVIDER 'delta', native_read true, native_write true);

statement ok
CREATE TABLE rw.main.t AS SELECT i::BIGINT AS id, ('v'||i)::VARCHAR AS s FROM range(2000) r(i);

# Control: the statement's own write already honoured the setting before any of this.
query I
SELECT count(*) FROM (SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optrw/t/*.parquet')) WHERE compression <> 'ZSTD';
----
0

# The merge-on-read UPDATE writes a post-image file.
statement ok
UPDATE rw.main.t SET s='u' WHERE id % 500 = 0;

query I
SELECT count(*) FROM (SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optrw/t/*.parquet')) WHERE compression <> 'ZSTD';
----
0

statement ok
INSERT INTO rw.main.t SELECT i::BIGINT, ('v'||i)::VARCHAR FROM range(2000,3000) r(i);

statement ok
INSERT INTO rw.main.t SELECT i::BIGINT, ('v'||i)::VARCHAR FROM range(3000,4000) r(i);

# OPTIMIZE compacts them into a new file.
statement ok
SELECT fabricator_exec('rw', 'OPTIMIZE main.t');

query I
SELECT count(*) FROM (SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optrw/t/*.parquet')) WHERE compression <> 'ZSTD';
----
0

# POSITIVE CONTROL: the assertions above are only meaningful if that query can see files at all and would
# report a non-ZSTD one. Both halves, so a broken path expression cannot make them pass vacuously.
query I
SELECT count(*) > 0 FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optrw/t/*.parquet');
----
true

query I
SELECT count(*) FROM (SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optrw/t/*.parquet')) WHERE compression <> 'SNAPPY';
----
1

statement ok
RESET delta_write_options;

statement ok
DETACH rw;

# ============================================================================
# FURTHER PARQUET WRITE OPTIONS (2026-08-07): parquet_row_group_size_bytes, parquet_version,
# parquet_dictionary_size_limit — and the two that are REFUSED.
# ⚠ parquet_row_groups_per_file / parquet_file_size_bytes are refused on EVERY engine, and that is a
# CORRECTNESS refusal rather than a missing feature. MEASURED: DuckDB's COPY treats the target as a
# DIRECTORY under either option and writes <name>.parquet/data_0.parquet into it, while the Delta log
# records <name>.parquet as the data file — the commit SUCCEEDS and the table is silently corrupt. This
# section is what stops them being "enabled" later without teaching the writer to register every file.
# ============================================================================

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optmore' AS mo (TYPE fabricator, PROVIDER 'delta', native_read true, native_write true);

statement ok
CREATE TABLE mo.main.v1 WITH (parquet_version='V1') AS SELECT i::BIGINT AS id FROM range(1000) r(i);

query I
SELECT count(*) FROM mo.main.v1;
----
1000

statement ok
CREATE TABLE mo.main.dict WITH (parquet_dictionary_size_limit=8) AS SELECT (i%5000)::BIGINT AS id FROM range(5000) r(i);

query I
SELECT count(*) FROM mo.main.dict;
----
5000

# ONE data file per table — the property the refusals below protect.
query I
SELECT count(*) FROM glob('${FABRICATOR_DELTA_WRITE_DIR}/optmore/dict/*.parquet');
----
1

statement error
CREATE TABLE mo.main.rot WITH (parquet_file_size_bytes=32768) AS SELECT i::BIGINT AS id FROM range(1000) r(i);
----
is not supported

statement error
CREATE TABLE mo.main.rot2 WITH (parquet_row_groups_per_file=1) AS SELECT i::BIGINT AS id FROM range(1000) r(i);
----
is not supported

# ...including on a PARTITIONED table, where our side would have coped (that write already targets a
# directory and registers one `add` per file) — DuckDB refuses the combination itself.
statement ok
CREATE TABLE mo.main.rotp (id BIGINT, p VARCHAR) PARTITIONED BY (p);

statement error
SET delta_write_options='{"file_size_bytes":65536}';
INSERT INTO mo.main.rotp SELECT i::BIGINT, 'p'||(i%3) FROM range(1000) r(i);
----
is not supported

statement ok
RESET delta_write_options;

# The codec engine takes the SHARED knobs (row_group_size_bytes -> RowGroupMaxBytes,
# parquet_version -> DataPageVersion) and refuses the native-only one rather than dropping it.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optmorec' AS moc (TYPE fabricator, PROVIDER 'engineeredwooddelta');

statement ok
CREATE TABLE moc.main.shared WITH (parquet_row_group_size_bytes=65536, parquet_version='V1') AS SELECT i::BIGINT AS id FROM range(1000) r(i);

query I
SELECT count(*) FROM moc.main.shared;
----
1000

statement error
CREATE TABLE moc.main.bad WITH (parquet_dictionary_size_limit=8) AS SELECT 1 AS id;
----
only supported with native_write

statement ok
DETACH moc;

statement ok
DETACH mo;

# ============================================================================
# 8. PERSISTED PARQUET TUNING — the fabricator.parquet.* table properties.
#
#    Before this, a WITH was PER-STATEMENT: `CREATE TABLE t WITH (parquet_compression='zstd') AS …` wrote
#    ZSTD and a later plain `INSERT INTO t` wrote SNAPPY, so a table accumulated MIXED compression and an
#    incrementally-built dbt model was mostly snappy whatever it was configured for. OPTIMIZE was the worst
#    case: it rewrites the MAJORITY of a table's bytes, so it actively undid the setting it was configured for.
#
#    ⚠ PIN THE ENGINE: this section runs on `lake` (native_write). A codec-only gate would pass while the
#    SHIPPED DEFAULT path stayed broken — the same trap that hid the rewrite-path gap.
# ============================================================================

# `lake` was detached by section 3; re-attach it with the SAME options (native_read/native_write).
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optlake' AS lake (TYPE fabricator, PROVIDER 'delta', native_read true, native_write true);

statement ok
CREATE OR REPLACE TABLE lake.main.persist WITH (parquet_compression='zstd') AS SELECT i::BIGINT AS id FROM range(2000) r(i);

query II
SELECT property, value FROM lake.delta.tblproperties('main.persist')
WHERE property LIKE 'fabricator.parquet.%' ORDER BY property;
----
fabricator.parquet.compression	zstd

# The whole point: a PLAIN INSERT, naming no options at all, follows the table's declaration. Asserted as
# "zero non-ZSTD chunks" rather than "some ZSTD exists" — the latter passes on the CTAS's own files while
# the INSERT writes snappy beside them, which is precisely the bug.
statement ok
INSERT INTO lake.main.persist SELECT i::BIGINT FROM range(2000, 4000) r(i);

query I
SELECT count(*) FROM (SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlake/persist/*.parquet')) WHERE compression <> 'ZSTD';
----
0

# ...and so does the merge-on-read UPDATE's post-image file.
statement ok
UPDATE lake.main.persist SET id = id + 1000000 WHERE id % 97 = 0;

query I
SELECT count(*) FROM (SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlake/persist/*.parquet')) WHERE compression <> 'ZSTD';
----
0

# ...and OPTIMIZE's compaction output, the site that stings most.
statement ok
SELECT fabricator_exec('lake', 'OPTIMIZE main.persist');

query I
SELECT count(*) FROM (SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlake/persist/*.parquet')) WHERE compression <> 'ZSTD';
----
0

# POSITIVE CONTROL for every "zero non-ZSTD" assertion above: the files exist and really are ZSTD. Without
# this, a wrong glob path would satisfy all four by matching nothing.
query I
SELECT count(*) FROM (SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlake/persist/*.parquet')) WHERE compression = 'ZSTD';
----
1

query I
SELECT count(*) FROM lake.main.persist;
----
4000

# ---- 8b. PRECEDENCE: the table property OUTRANKS the session setting ----
# Deliberate, not incidental: the property is a property OF THE TABLE, so a stray `SET delta_write_options`
# in someone's session must not silently change a table's storage format.

statement ok
SET delta_write_options='{"compression":"gzip"}';

statement ok
INSERT INTO lake.main.persist SELECT i::BIGINT FROM range(4000, 4500) r(i);

query I
SELECT count(*) FROM (SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlake/persist/*.parquet')) WHERE compression = 'GZIP';
----
0

# The setting is NOT inert — it governs a table that declares nothing. (Without this the assertion above
# would pass equally if `delta_write_options` had simply stopped working.)
statement ok
CREATE OR REPLACE TABLE lake.main.nodecl AS SELECT i::BIGINT AS id FROM range(1000) r(i);

query I
SELECT count(*) FROM (SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlake/nodecl/*.parquet')) WHERE compression = 'GZIP';
----
1

statement ok
RESET delta_write_options;

# ---- 8c. A CREATE OR REPLACE INHERITS the declaration ----
# ⚠ Measured, and the opposite ("a replace redefines the table, inherit nothing") is worse in exactly the way
# this feature exists to fix: a REPLACE does NOT re-create the Delta table (the log continues and the metaData
# commit copies the configuration forward), so the table still DECLARES zstd afterwards. Inheriting nothing
# would write the replace's files at the engine default INTO a zstd-declared table, and the next plain INSERT
# would flip back — mixed compression from ONE statement.
#
# ⚠ The corollary is a real limitation: a REPLACE cannot CHANGE the declaration (its WITH applies to that
# statement's write only), because create-time configuration is applied at v0. Not specific to these keys —
# equally true of every create flag and of the delta.* properties. set_tblproperties is what changes it.

statement ok
CREATE OR REPLACE TABLE lake.main.persist AS SELECT i::BIGINT AS id FROM range(100) r(i);

query II
SELECT property, value FROM lake.delta.tblproperties('main.persist')
WHERE property LIKE 'fabricator.parquet.%' ORDER BY property;
----
fabricator.parquet.compression	zstd

statement ok
INSERT INTO lake.main.persist SELECT i::BIGINT FROM range(100, 200) r(i);

query I
SELECT count(*) FROM (SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlake/persist/*.parquet')) WHERE compression <> 'ZSTD';
----
0

# ---- 8d. EVERY declared key persists, including a native-only one ----

statement ok
CREATE OR REPLACE TABLE lake.main.allkeys WITH (parquet_compression='zstd', parquet_row_group_size=4096, parquet_version='V2', parquet_dictionary_size_limit=512) AS SELECT i::BIGINT AS id FROM range(100) r(i);

query II
SELECT property, value FROM lake.delta.tblproperties('main.allkeys')
WHERE property LIKE 'fabricator.parquet.%' ORDER BY property;
----
fabricator.parquet.compression	zstd
fabricator.parquet.dictionary_size_limit	512
fabricator.parquet.row_group_size	4096
fabricator.parquet.version	V2

# ---- 8e. THE IGNORE/REFUSE SPLIT — the one deliberate departure from "never silently ignore" ----
# A WITH/SET option is an ACTIVE REQUEST in THIS statement ("write it this way, now"), so an engine that
# cannot honour it must FAIL. A persisted property is a DECLARATION ABOUT THE TABLE, read later by a writer
# that may legitimately be a DIFFERENT ENGINE — failing there would make the table UNWRITABLE by the codec
# engine merely because someone once set a native-only knob. So: apply what fits, ignore the rest.

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optlake' AS lakec (TYPE fabricator, PROVIDER 'engineeredwooddelta');

# The codec engine writes into a table declaring the native-only dictionary_size_limit: IGNORED, not refused.
statement ok
INSERT INTO lakec.main.allkeys SELECT i::BIGINT FROM range(100, 200) r(i);

query I
SELECT count(*) FROM lakec.main.allkeys;
----
200

# ...and the keys it CAN honour are still honoured on that same write — so "ignored" means the one key, not
# the whole declaration. Both engines wrote files here, and none is snappy.
query I
SELECT count(*) FROM (SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlake/allkeys/*.parquet')) WHERE compression <> 'ZSTD';
----
0

# THE CONTRAST, on the same engine and the same key: as a STATEMENT option it is REFUSED.
statement error
CREATE OR REPLACE TABLE lakec.main.stmt WITH (parquet_dictionary_size_limit=512) AS SELECT 1 AS id;
----
only supported with native_write

statement ok
DETACH lakec;

# ---- 8f. A MALFORMED persisted value is REFUSED, unlike a merely unhonourable one ----
# set_tblproperties writes arbitrary fabricator.* keys, so someone will hand-set garbage. Ignoring a
# well-formed option this engine cannot honour is correct; swallowing an UNPARSEABLE one is not.

statement ok
SELECT count(*) FROM lake.delta.set_tblproperties('main.allkeys', '{"fabricator.parquet.row_group_size":"lots"}');

statement error
INSERT INTO lake.main.allkeys SELECT 999::BIGINT;
----
is not a positive whole number

# The error names the offending KEY — the value may have been set long ago from another session, so "some
# property is wrong" would leave the user grepping their table.
statement error
INSERT INTO lake.main.allkeys SELECT 999::BIGINT;
----
fabricator.parquet.row_group_size

# ...and it is recoverable from SQL, which is what makes refusing acceptable rather than a trap.
statement ok
SELECT count(*) FROM lake.delta.set_tblproperties('main.allkeys', '{"fabricator.parquet.row_group_size":"4096"}');

statement ok
INSERT INTO lake.main.allkeys SELECT 999::BIGINT;

query I
SELECT count(*) FROM lake.main.allkeys;
----
201

# ---- 8g. ⚠ PERSISTING row_group_size_bytes MAKES EVERY LATER NATIVE WRITE NEED preserve_insertion_order ----
# Found by writing this suite, and it is the one persisted key with a session prerequisite. DuckDB's binder
# refuses ROW_GROUP_SIZE_BYTES while preserving insertion order — which is fine for a per-statement option
# (the user sets the flag in the same breath) and becomes a PROPERTY OF THE TABLE once persisted: a plain
# INSERT that names nothing now fails until the session opts out. We deliberately do NOT set the flag on our
# own COPY connection — it would silently break SORTED BY writes — so DuckDB's error surfaces, which is the
# right outcome but is worth pinning so a future change cannot quietly start swallowing it.

statement ok
SET preserve_insertion_order=false;

statement ok
CREATE OR REPLACE TABLE lake.main.rgb WITH (parquet_row_group_size_bytes=1048576) AS SELECT i::BIGINT AS id FROM range(100) r(i);

statement ok
RESET preserve_insertion_order;

query II
SELECT property, value FROM lake.delta.tblproperties('main.rgb')
WHERE property LIKE 'fabricator.parquet.%' ORDER BY property;
----
fabricator.parquet.row_group_size_bytes	1048576

# The trap itself: a plain INSERT naming no options inherits the declaration and hits DuckDB's binder.
statement error
INSERT INTO lake.main.rgb SELECT 999::BIGINT;
----
preserve_insertion_order

# ...and the documented escape works.
statement ok
SET preserve_insertion_order=false;

statement ok
INSERT INTO lake.main.rgb SELECT 999::BIGINT;

statement ok
RESET preserve_insertion_order;

query I
SELECT count(*) FROM lake.main.rgb;
----
101

# The CODEC engine has no such constraint — it maps the key to RowGroupMaxBytes with no DuckDB binder
# involved — so the same declaration is written without any session flag.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optlake' AS lakec2 (TYPE fabricator, PROVIDER 'engineeredwooddelta');

statement ok
INSERT INTO lakec2.main.rgb SELECT 1000::BIGINT;

query I
SELECT count(*) FROM lakec2.main.rgb;
----
102

statement ok
DETACH lakec2;

# ============================================================================
# 9. compression_level + bloom_filter_false_positive_ratio — the last two unexposed parquet knobs, and
#    both are TWO-ENGINE.
#
#    ⚠ Every assertion here reads the FILE, not the option. A "the statement succeeded" test would pass
#    for an option that never reached either writer, which is exactly how parquet_bloom_filter_columns
#    managed to do nothing on the default table shape for months (see §9c).
# ============================================================================

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optlvl' AS lv (TYPE fabricator, PROVIDER 'delta');

# ---- 9a. compression_level — the oracle is BYTES WRITTEN ----
# Deliberately not "the metadata says 19": parquet records the CODEC, never the level, so the only way to
# see the level is to compress the same data twice and compare. Same source, same codec, level 1 vs 19.

statement ok
CREATE OR REPLACE TABLE lv.main.lo WITH (parquet_compression='zstd', parquet_compression_level=1) AS SELECT (i%977)::BIGINT AS id, repeat('abcdefgh', 20) AS s FROM range(400000) r(i);

statement ok
CREATE OR REPLACE TABLE lv.main.hi WITH (parquet_compression='zstd', parquet_compression_level=19) AS SELECT (i%977)::BIGINT AS id, repeat('abcdefgh', 20) AS s FROM range(400000) r(i);

query I
SELECT CASE WHEN (SELECT sum(total_compressed_size) FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlvl/hi/*.parquet'))
             < (SELECT sum(total_compressed_size) FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlvl/lo/*.parquet'))
       THEN 1 ELSE 0 END;
----
1

# Both are really ZSTD — so the size difference is the LEVEL and not a silently different codec.
query I
SELECT count(*) FROM (
  SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlvl/lo/*.parquet')
  UNION SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlvl/hi/*.parquet')
) WHERE compression <> 'ZSTD';
----
0

# It persists like the rest of the tuning.
query II
SELECT property, value FROM lv.delta.tblproperties('main.hi')
WHERE property = 'fabricator.parquet.compression_level';
----
fabricator.parquet.compression_level	19

# The valid range belongs to the CODEC (zstd 1-22, gzip 1-9), so the engine validates it rather than us
# duplicating the table — but it must be an ERROR, not a silent clamp.
statement error
CREATE OR REPLACE TABLE lv.main.bad WITH (parquet_compression='zstd', parquet_compression_level=99) AS SELECT 1 AS id;
----
<REGEX>:.*(ompression|evel).*

# ---- 9b. bloom_filter_false_positive_ratio — the oracle is BLOOM FILTER BYTES ----
# ⚠ The cardinality is chosen so DuckDB actually WRITES a filter: it abandons dictionary encoding AND
# bloom filters past dictionary_size_limit distinct values, so a high-cardinality column would give two
# filter-less files and a vacuously equal comparison.

statement ok
CREATE OR REPLACE TABLE lv.main.b1 WITH (parquet_bloom_filter_false_positive_ratio=0.3) AS SELECT (i%500)::BIGINT AS id FROM range(200000) r(i);

statement ok
CREATE OR REPLACE TABLE lv.main.b2 WITH (parquet_bloom_filter_false_positive_ratio=0.000001) AS SELECT (i%500)::BIGINT AS id FROM range(200000) r(i);

# POSITIVE CONTROL first: a filter exists at all. Without it, "b2 > b1" could be NULL > NULL. Asserted as
# "at least one" rather than an exact count — the file/row-group split is not what this section is about.
query I
SELECT CASE WHEN count(*) > 0 THEN 1 ELSE 0 END
FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlvl/b1/*.parquet') WHERE bloom_filter_offset IS NOT NULL;
----
1

query I
SELECT CASE WHEN (SELECT sum(bloom_filter_length) FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlvl/b2/*.parquet'))
             > (SELECT sum(bloom_filter_length) FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlvl/b1/*.parquet'))
       THEN 1 ELSE 0 END;
----
1

query II
SELECT property, value FROM lv.delta.tblproperties('main.b1')
WHERE property = 'fabricator.parquet.bloom_filter_false_positive_ratio';
----
fabricator.parquet.bloom_filter_false_positive_ratio	0.3

# A rate must be a probability. BOTH ends are refused rather than clamped: 0 asks for a filter with no
# false positives (impossible) and 1 for one that matches everything (useless, and still costs bytes).
statement error
CREATE OR REPLACE TABLE lv.main.bad WITH (parquet_bloom_filter_false_positive_ratio=0) AS SELECT 1 AS id;
----
between 0 and 1

statement error
CREATE OR REPLACE TABLE lv.main.bad WITH (parquet_bloom_filter_false_positive_ratio=1) AS SELECT 1 AS id;
----
between 0 and 1

# ---- 9c. ⚠ parquet_bloom_filter_columns UNDER COLUMN MAPPING — was a SILENT NO-OP, now refused ----
# engineered-wood matches the list against the PARQUET path, and on a column-mapped table that path is the
# PHYSICAL name (`col-<uuid>`), never the logical one. MEASURED before the guard: 0 of 10 column chunks got
# a filter with mapping on, 10 of 10 with it off. Column mapping is the DEFAULT, so the option did nothing
# on the shape almost everyone has — and nothing caught it because no suite asserted a filter was written.

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optlvlc' AS lvc (TYPE fabricator, PROVIDER 'engineeredwooddelta');

statement error
CREATE OR REPLACE TABLE lvc.main.mapped WITH (parquet_bloom_filter_columns='id') AS SELECT (i%500)::BIGINT AS id FROM range(20000) r(i);
----
column mapping

# THE POSITIVE CONTROL, and it is what makes the refusal a guard rather than a blanket ban: with mapping
# off the option works, and the filter is really in the file.
statement ok
CREATE OR REPLACE TABLE lvc.main.nomap WITH (column_mapping='none', parquet_bloom_filter_columns='id') AS SELECT (i%500)::BIGINT AS id FROM range(20000) r(i);

query I
SELECT CASE WHEN count(*) FILTER (WHERE bloom_filter_offset IS NOT NULL) = count(*) AND count(*) > 0
       THEN 1 ELSE 0 END
FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlvlc/nomap/*.parquet');
----
1

# ...and the columns really are stored under their LOGICAL names there, which is the mechanism the guard
# is about rather than an incidental difference.
query T
SELECT DISTINCT path_in_schema FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlvlc/nomap/*.parquet');
----
id

statement ok
DETACH lvc;

# ---- 9d. Both options reach the CODEC engine too ----
# ⚠ The bloom DEFAULTS DIFFER between the engines (DuckDB 0.01, engineered-wood 0.05), so an unset option
# does NOT make the two write equivalent files. Each keeps its own default; only an explicit value aligns
# them. Pinned here so any doc claiming equivalence has to reckon with it.

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optlvlc2' AS lvc2 (TYPE fabricator, PROVIDER 'engineeredwooddelta');

statement ok
CREATE OR REPLACE TABLE lvc2.main.lo WITH (parquet_compression='zstd', parquet_compression_level=1) AS SELECT (i%977)::BIGINT AS id, repeat('abcdefgh', 20) AS s FROM range(300000) r(i);

statement ok
CREATE OR REPLACE TABLE lvc2.main.hi WITH (parquet_compression='zstd', parquet_compression_level=19) AS SELECT (i%977)::BIGINT AS id, repeat('abcdefgh', 20) AS s FROM range(300000) r(i);

query I
SELECT CASE WHEN (SELECT sum(total_compressed_size) FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlvlc2/hi/*.parquet'))
             < (SELECT sum(total_compressed_size) FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlvlc2/lo/*.parquet'))
       THEN 1 ELSE 0 END;
----
1

statement ok
DETACH lvc2;

statement ok
DETACH lv;
