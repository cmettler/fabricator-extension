# name: test/verify_with_options.test
# description: CREATE TABLE [AS] ... WITH (key='value', ...) options on the Delta provider (ABI v67 —
#              docs/create-table-with-options.md slice A). Three key kinds: per-statement WRITE TUNING
#              (parquet_compression / parquet_row_group_size / parquet_bloom_filter_columns — DuckLake-parity
#              names; WITH > delta_write_options > ATTACH defaults), per-table CREATE-FLAG OVERRIDES
#              (deletion_vectors / column_mapping / row_tracking / change_data_feed / in_commit_timestamps —
#              e.g. the protocol-1.0 recipe without a dedicated ATTACH), and delta.*/fabricator.* TABLE
#              PROPERTIES stamped in the CREATE commit itself (well-known keys re-cased to spec spelling —
#              DuckDB's parser lowercases every WITH key). Unknown keys are REJECTED, never ignored.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optlake' AS lake (TYPE fabricator, PROVIDER 'delta', native_read true, native_write true);

# ==== 1. write tuning (CTAS, native streaming COPY) ====

statement ok
CREATE OR REPLACE TABLE lake.main.tuned
  WITH (parquet_compression='zstd', parquet_row_group_size=5000)
AS SELECT i, 'v' || i AS s FROM range(20000) t(i);

query I
SELECT count(*) FROM lake.main.tuned;
----
20000

query I
SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlake/tuned/*.parquet')
WHERE compression <> '';
----
ZSTD

query I
SELECT count(DISTINCT row_group_id) FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlake/tuned/*.parquet');
----
4

# precedence: WITH beats the delta_write_options session setting; the setting still applies when no WITH
statement ok
SET delta_write_options = '{"compression":"gzip"}';

statement ok
CREATE OR REPLACE TABLE lake.main.tuned2 WITH (parquet_compression='zstd') AS SELECT 1 AS id;

query I
SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlake/tuned2/*.parquet')
WHERE compression <> '';
----
ZSTD

statement ok
CREATE OR REPLACE TABLE lake.main.tuned3 AS SELECT 1 AS id;

query I
SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optlake/tuned3/*.parquet')
WHERE compression <> '';
----
GZIP

statement ok
SET delta_write_options = '';

# ==== 2. per-table create-flag overrides ====

# the protocol-1.0 recipe (SQL Server / PolyBase readable) on a DV-DEFAULT catalog: WITH opts this one
# table out — plain minReader 1, no deletionVectors feature, no column mapping
statement ok
CREATE OR REPLACE TABLE lake.main.plainrec
  WITH (deletion_vectors=false, column_mapping='none')
AS SELECT i AS id FROM range(5) t(i);

query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/optlake/plainrec/_delta_log/*.json')
WHERE content LIKE '%deletionVectors%' OR content LIKE '%columnMapping%';
----
0

query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/optlake/plainrec/_delta_log/*.json')
WHERE content LIKE '%"minReaderVersion":1%';
----
1

# a DEFAULT-created sibling in the same catalog keeps the catalog defaults (DV + mapping)
statement ok
CREATE OR REPLACE TABLE lake.main.defaults AS SELECT 1 AS id;

query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/optlake/defaults/_delta_log/*.json')
WHERE content LIKE '%delta.enableDeletionVectors%';
----
1

# the reverse override: a DV-OFF catalog, one table opts IN
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optlake2' AS lake2 (TYPE fabricator, PROVIDER 'delta', deletion_vectors false, column_mapping 'none');

statement ok
CREATE OR REPLACE TABLE lake2.main.dvon WITH (deletion_vectors=true) AS SELECT 1 AS id;

query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/optlake2/dvon/_delta_log/*.json')
WHERE content LIKE '%delta.enableDeletionVectors%';
----
1

# flags also work on an EMPTY CREATE (DDL path, no AS)
statement ok
CREATE TABLE lake.main.plainrec2 (id INTEGER, s VARCHAR) WITH (deletion_vectors=false, column_mapping='none');

statement ok
INSERT INTO lake.main.plainrec2 VALUES (1, 'a'), (2, 'b');

query II
SELECT id, s FROM lake.main.plainrec2 ORDER BY id;
----
1	a
2	b

query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/optlake/plainrec2/_delta_log/*.json')
WHERE content LIKE '%deletionVectors%' OR content LIKE '%columnMapping%';
----
0

# ==== 3. delta.*/fabricator.* properties stamped at CREATE (one commit, no set_tblproperties two-step) ====

statement ok
CREATE OR REPLACE TABLE lake.main.proptest
  WITH ("delta.isolationLevel"='Serializable', "fabricator.mytag"='hello')
AS SELECT 1 AS id;

# the well-known key is re-cased to its spec spelling (DuckDB's parser lowercases WITH keys)
query II
SELECT property, value FROM fabricator_delta_tblproperties('lake', 'main.proptest')
WHERE property IN ('delta.isolationLevel', 'fabricator.mytag') ORDER BY 1;
----
delta.isolationLevel	Serializable
fabricator.mytag	hello

# stamped in commit-0 itself (the CREATE), not a follow-up property commit
query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/optlake/proptest/_delta_log/00000000000000000000.json')
WHERE content LIKE '%delta.isolationLevel%';
----
1

# ==== 4. buffered (explicit-transaction) CREATE/CTAS parks the options; the flush applies them ====

statement ok
BEGIN;

statement ok
CREATE TABLE lake.main.txnopt
  WITH (deletion_vectors=false, column_mapping='none', "delta.isolationLevel"='Serializable')
AS SELECT i AS id FROM range(7) t(i);

# read-your-writes from the buffer (nothing on storage yet)
query I
SELECT count(*) FROM lake.main.txnopt;
----
7

statement ok
COMMIT;

query I
SELECT count(*) FROM lake.main.txnopt;
----
7

query I
SELECT count(*) FROM read_text('${FABRICATOR_DELTA_WRITE_DIR}/optlake/txnopt/_delta_log/*.json')
WHERE content LIKE '%deletionVectors%' OR content LIKE '%columnMapping%';
----
0

query II
SELECT property, value FROM fabricator_delta_tblproperties('lake', 'main.txnopt')
WHERE property = 'delta.isolationLevel' ORDER BY 1;
----
delta.isolationLevel	Serializable

# ROLLBACK discards a buffered options-carrying CTAS entirely
statement ok
BEGIN;

statement ok
CREATE TABLE lake.main.txngone WITH (deletion_vectors=false) AS SELECT 1 AS id;

statement ok
ROLLBACK;

statement error
SELECT count(*) FROM lake.main.txngone;
----

# ==== 5. guards — a WITH option is never silently ignored ====

statement error
CREATE OR REPLACE TABLE lake.main.bad WITH (nonsense='x') AS SELECT 1 AS id;
----
unknown CREATE TABLE WITH option 'nonsense'

# write tuning has no write to apply to on an empty CREATE
statement error
CREATE TABLE lake.main.bad2 (id INTEGER) WITH (parquet_compression='zstd');
----
apply to the statement's write

# feature-enabling property spellings point at the explicit keys
statement error
CREATE OR REPLACE TABLE lake.main.bad3 WITH ("delta.enableChangeDataFeed"='true') AS SELECT 1 AS id;
----
use the explicit WITH keys

statement error
CREATE OR REPLACE TABLE lake.main.bad4 WITH (location='s3://elsewhere/t') AS SELECT 1 AS id;
----
path IS its identity

statement error
CREATE OR REPLACE TABLE lake.main.bad5 WITH (partitioned_by='id') AS SELECT 1 AS id;
----
use the native clause

statement error
CREATE OR REPLACE TABLE lake.main.bad6 WITH (table_type='ICEBERG') AS SELECT 1 AS id;
----
ICEBERG has no writer

statement error
CREATE OR REPLACE TABLE lake.main.bad7 WITH (deletion_vectors='maybe') AS SELECT 1 AS id;
----
expected a boolean

statement error
CREATE OR REPLACE TABLE lake.main.bad8 WITH (parquet_row_group_size='lots') AS SELECT 1 AS id;
----
expected a positive integer

# non-constant option values are rejected at bind (host-side)
statement error
CREATE OR REPLACE TABLE lake.main.bad9 WITH (parquet_compression=lower('ZSTD')) AS SELECT 1 AS id;
----
must be a constant value

statement error
CREATE OR REPLACE TABLE lake.main.bad10 WITH (deletion_vectors=NULL) AS SELECT 1 AS id;
----
must not be NULL

# table_type='DELTA' / format='parquet' are validated no-ops (the Iceberg-style DDL shape)
statement ok
CREATE OR REPLACE TABLE lake.main.iceshape
  WITH (table_type='DELTA', format='parquet')
AS SELECT 1 AS id;

query I
SELECT count(*) FROM lake.main.iceshape;
----
1

# ==== cleanup ====

statement ok
DROP TABLE lake.main.tuned;

statement ok
DROP TABLE lake.main.tuned2;

statement ok
DROP TABLE lake.main.tuned3;

statement ok
DROP TABLE lake.main.plainrec;

statement ok
DROP TABLE lake.main.plainrec2;

statement ok
DROP TABLE lake.main.defaults;

statement ok
DROP TABLE lake.main.proptest;

statement ok
DROP TABLE lake.main.txnopt;

statement ok
DROP TABLE lake.main.iceshape;

statement ok
DROP TABLE lake2.main.dvon;

statement ok
DETACH lake;

statement ok
DETACH lake2;

# ---- WRITE TUNING MUST REACH THE FILES A *TRANSACTION* WRITES, NOT ONLY THE BULK PATH ----
# ⚠ It did not. Every open of an engineered-wood table in the Bridge passed NO write spec except the one
# in the eager-write helper, so the (DuckDB txn, table) pair's HELD table — which writes the CDF change
# files and any batches the flush parks — fell back to snappy / 122880 rows / no bloom filters while the
# same table's CTAS files honoured the setting. MEASURED before the fix: data ZSTD, change files SNAPPY,
# in one table. A user setting zstd for storage cost silently got snappy on everything a transaction wrote.
# The CODEC engine is required, not incidental: under native_write DuckDB's COPY writes the data files, so
# engineered-wood's ParquetWriteOptions never apply and this assertion would pass for the wrong reason.
statement ok
SET delta_write_options = '{"compression":"zstd"}';

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optspec' AS lake9
  (TYPE fabricator, PROVIDER 'engineeredwooddelta', change_data_feed true);

statement ok
CREATE TABLE lake9.main.t AS SELECT i AS id, i * 2 AS a FROM range(1, 2001) AS r(i);

# POSITIVE CONTROL: the bulk path always honoured the setting. If this ever reads SNAPPY the test below
# proves nothing, because both halves would simply be following the same (wrong) default.
query I
SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optspec/t/*.parquet')
WHERE compression <> '';
----
ZSTD

statement ok
BEGIN;

statement ok
UPDATE lake9.main.t SET a = a + 1 WHERE id <= 100;

statement ok
COMMIT;

# THE ASSERTION: the change files the HELD table wrote carry the configured codec too.
query I
SELECT DISTINCT compression
FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optspec/t/_change_data/*.parquet')
WHERE compression <> '';
----
ZSTD

# The feed itself is still correct — a write-options change must not alter what the UPDATE recorded.
query II
SELECT _change_type, count(*) FROM fabricator_delta_changes('lake9', 'main.t', 2)
WHERE _change_type LIKE 'update_%' GROUP BY 1 ORDER BY 1;
----
update_postimage	100
update_preimage	100

statement ok
RESET delta_write_options;

statement ok
DETACH lake9;

# ============================================================================
# THE REWRITE PATHS HONOUR THE WRITE SPEC — the merge-on-read UPDATE's post-image file and OPTIMIZE's
# compaction output. Both are written by DeltaReader, which is STATIC, while ResolveWriteSpec lives on the
# catalog INSTANCE — so for a long time they silently used engineered-wood's defaults and a table
# accumulated MIXED compression. OPTIMIZE is the one that stings: it rewrites the MAJORITY of a table's
# bytes, so it actively undid the setting it was configured for.
# ⚠ Pinned on the NATIVE engine deliberately. Under native_write the file is written by DuckDB's COPY, not
# by engineered-wood, so threading the spec into the EW open was necessary and NOT sufficient — the spec
# also has to reach NativeParquetDataFileWriter's COPY options. A codec-only gate would have passed while
# the shipped default path was still wrong.
# ============================================================================

statement ok
SET delta_write_options='{"compression":"zstd"}';

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optrw' AS rw (TYPE fabricator, PROVIDER 'delta', native_read true, native_write true);

statement ok
CREATE TABLE rw.main.t AS SELECT i::BIGINT AS id, ('v'||i)::VARCHAR AS s FROM range(2000) r(i);

# Control: the statement's own write already honoured the setting before any of this.
query I
SELECT count(*) FROM (SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optrw/t/*.parquet')) WHERE compression <> 'ZSTD';
----
0

# The merge-on-read UPDATE writes a post-image file.
statement ok
UPDATE rw.main.t SET s='u' WHERE id % 500 = 0;

query I
SELECT count(*) FROM (SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optrw/t/*.parquet')) WHERE compression <> 'ZSTD';
----
0

statement ok
INSERT INTO rw.main.t SELECT i::BIGINT, ('v'||i)::VARCHAR FROM range(2000,3000) r(i);

statement ok
INSERT INTO rw.main.t SELECT i::BIGINT, ('v'||i)::VARCHAR FROM range(3000,4000) r(i);

# OPTIMIZE compacts them into a new file.
statement ok
SELECT fabricator_exec('rw', 'OPTIMIZE main.t');

query I
SELECT count(*) FROM (SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optrw/t/*.parquet')) WHERE compression <> 'ZSTD';
----
0

# POSITIVE CONTROL: the assertions above are only meaningful if that query can see files at all and would
# report a non-ZSTD one. Both halves, so a broken path expression cannot make them pass vacuously.
query I
SELECT count(*) > 0 FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optrw/t/*.parquet');
----
true

query I
SELECT count(*) FROM (SELECT DISTINCT compression FROM parquet_metadata('${FABRICATOR_DELTA_WRITE_DIR}/optrw/t/*.parquet')) WHERE compression <> 'SNAPPY';
----
1

statement ok
RESET delta_write_options;

statement ok
DETACH rw;

# ============================================================================
# FURTHER PARQUET WRITE OPTIONS (2026-08-07): parquet_row_group_size_bytes, parquet_version,
# parquet_dictionary_size_limit — and the two that are REFUSED.
# ⚠ parquet_row_groups_per_file / parquet_file_size_bytes are refused on EVERY engine, and that is a
# CORRECTNESS refusal rather than a missing feature. MEASURED: DuckDB's COPY treats the target as a
# DIRECTORY under either option and writes <name>.parquet/data_0.parquet into it, while the Delta log
# records <name>.parquet as the data file — the commit SUCCEEDS and the table is silently corrupt. This
# section is what stops them being "enabled" later without teaching the writer to register every file.
# ============================================================================

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optmore' AS mo (TYPE fabricator, PROVIDER 'delta', native_read true, native_write true);

statement ok
CREATE TABLE mo.main.v1 WITH (parquet_version='V1') AS SELECT i::BIGINT AS id FROM range(1000) r(i);

query I
SELECT count(*) FROM mo.main.v1;
----
1000

statement ok
CREATE TABLE mo.main.dict WITH (parquet_dictionary_size_limit=8) AS SELECT (i%5000)::BIGINT AS id FROM range(5000) r(i);

query I
SELECT count(*) FROM mo.main.dict;
----
5000

# ONE data file per table — the property the refusals below protect.
query I
SELECT count(*) FROM glob('${FABRICATOR_DELTA_WRITE_DIR}/optmore/dict/*.parquet');
----
1

statement error
CREATE TABLE mo.main.rot WITH (parquet_file_size_bytes=32768) AS SELECT i::BIGINT AS id FROM range(1000) r(i);
----
is not supported

statement error
CREATE TABLE mo.main.rot2 WITH (parquet_row_groups_per_file=1) AS SELECT i::BIGINT AS id FROM range(1000) r(i);
----
is not supported

# ...including on a PARTITIONED table, where our side would have coped (that write already targets a
# directory and registers one `add` per file) — DuckDB refuses the combination itself.
statement ok
CREATE TABLE mo.main.rotp (id BIGINT, p VARCHAR) PARTITIONED BY (p);

statement error
SET delta_write_options='{"file_size_bytes":65536}';
INSERT INTO mo.main.rotp SELECT i::BIGINT, 'p'||(i%3) FROM range(1000) r(i);
----
is not supported

statement ok
RESET delta_write_options;

# The codec engine takes the SHARED knobs (row_group_size_bytes -> RowGroupMaxBytes,
# parquet_version -> DataPageVersion) and refuses the native-only one rather than dropping it.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/optmorec' AS moc (TYPE fabricator, PROVIDER 'engineeredwooddelta');

statement ok
CREATE TABLE moc.main.shared WITH (parquet_row_group_size_bytes=65536, parquet_version='V1') AS SELECT i::BIGINT AS id FROM range(1000) r(i);

query I
SELECT count(*) FROM moc.main.shared;
----
1000

statement error
CREATE TABLE moc.main.bad WITH (parquet_dictionary_size_limit=8) AS SELECT 1 AS id;
----
only supported with native_write

statement ok
DETACH moc;

statement ok
DETACH mo;
