# name: test/verify_delta_catalog_partition_overwrite.test
# description: The `PARTITION_OVERWRITE` COPY option — DYNAMIC partition overwrite (Spark
#              partitionOverwriteMode=dynamic): the partitions PRESENT IN THE INPUT are atomically replaced in ONE
#              Delta commit (their active files removed + the new files added — a log-level swap, no physical
#              delete, so time travel keeps working); untouched partitions are unaffected. Append-shaped only
#              (CREATE_TABLE false required) + requires a partitioned target. Unlike the static
#              delta_write_options replace_where, the target set is derived from the data. Set
#              FABRICATOR_DELTA_WRITE_DIR to a WRITABLE base path. Local FS.
# group: [fabricator]

require fabricator

require-env FABRICATOR_DELTA_WRITE_DIR

# ================= collect path (EW codec writer) =================
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/pow' AS lake (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE lake.main.sales PARTITIONED BY (region) AS
  SELECT * FROM (VALUES (1,'US',10),(2,'US',20),(3,'EU',30),(4,'EU',40),(5,'APAC',50)) AS t(id,region,amt);

# The COPY touches US + EU (not APAC) → those two partitions are REPLACED, APAC is untouched.
statement ok
COPY (SELECT * FROM (VALUES (6,'US',600),(7,'EU',700),(8,'EU',800)) AS t(id,region,amt))
TO 'lake.main.sales' (FORMAT mssql, CREATE_TABLE false, PARTITION_OVERWRITE true);

query TII
SELECT region, count(*), sum(amt) FROM lake.main.sales GROUP BY region ORDER BY region;
----
APAC	1	50
EU	2	1500
US	1	600

# ONE commit for the whole swap (v0 CREATE, v1 initial CTAS, v2 the partition overwrite).
query I
SELECT count(*) FROM fabricator_delta_snapshots('lake', 'main.sales');
----
3

# Time travel still sees the pre-overwrite data (log-level swap — nothing physically deleted).
query TII
SELECT region, count(*), sum(amt) FROM lake.main.sales AT (VERSION => 1) GROUP BY region ORDER BY region;
----
APAC	1	50
EU	2	70
US	2	30

# A second dynamic overwrite touching only APAC leaves US/EU as-is.
statement ok
COPY (SELECT * FROM (VALUES (9,'APAC',900)) AS t(id,region,amt))
TO 'lake.main.sales' (FORMAT mssql, CREATE_TABLE false, PARTITION_OVERWRITE true);

query TII
SELECT region, count(*), sum(amt) FROM lake.main.sales GROUP BY region ORDER BY region;
----
APAC	1	900
EU	2	1500
US	1	600

# ---- guardrails ----
# Default COPY (CREATE_TABLE true) + PARTITION_OVERWRITE → rejected at bind (a full replace contradicts it).
statement error
COPY (SELECT 1 AS id, 'US' AS region, 1 AS amt) TO 'lake.main.sales' (FORMAT mssql, PARTITION_OVERWRITE true);
----
requires CREATE_TABLE false

# Unpartitioned target → clean provider error.
statement ok
CREATE TABLE lake.main.flat AS SELECT 1 AS id, 'x' AS v;

statement error
COPY (SELECT 2 AS id, 'y' AS v) TO 'lake.main.flat' (FORMAT mssql, CREATE_TABLE false, PARTITION_OVERWRITE true);
----
requires a partitioned table

# Combining with the static replace_where setting → clean error (one target-set source, not two).
statement ok
SET delta_write_options='{"replace_where":{"region":"EU"}}';

statement error
COPY (SELECT 1 AS id, 'EU' AS region, 1 AS amt) TO 'lake.main.sales' (FORMAT mssql, CREATE_TABLE false, PARTITION_OVERWRITE true);
----
cannot be combined

statement ok
SET delta_write_options='';

statement ok
DETACH lake;

# ================= CDF over a dynamic partition overwrite =================
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/powcdf' AS cdf (TYPE fabricator, PROVIDER 'delta', change_data_feed true);

statement ok
CREATE TABLE cdf.main.sales PARTITIONED BY (region) AS
  SELECT * FROM (VALUES (1,'US',10),(2,'EU',20),(3,'EU',30),(4,'APAC',40)) AS t(id,region,amt);

# v2: replace EU. The feed infers the swap: the removed files' LIVE rows → delete, the added files → insert —
# with the PARTITION COLUMN re-added from the action's partitionValues (data files exclude it).
statement ok
COPY (SELECT * FROM (VALUES (5,'EU',500)) AS t(id,region,amt))
TO 'cdf.main.sales' (FORMAT mssql, CREATE_TABLE false, PARTITION_OVERWRITE true);

query TITI
SELECT _change_type, id, region, amt FROM fabricator_delta_changes('cdf', 'main.sales', 2, 2)
ORDER BY _change_type, id;
----
delete	2	EU	20
delete	3	EU	30
insert	5	EU	500

# DV edge: id=4 is DV-deleted (v3 — reported as a delete THERE), then APAC gains id=7 (v4) and is overwritten
# (v5). The v5 feed must NOT re-report id=4 (already dead when the partition was swapped).
statement ok
DELETE FROM cdf.main.sales WHERE id = 4;

statement ok
INSERT INTO cdf.main.sales VALUES (7,'APAC',70);

statement ok
COPY (SELECT * FROM (VALUES (8,'APAC',800)) AS t(id,region,amt))
TO 'cdf.main.sales' (FORMAT mssql, CREATE_TABLE false, PARTITION_OVERWRITE true);

query TITI
SELECT _change_type, id, region, amt FROM fabricator_delta_changes('cdf', 'main.sales', 5, 5)
ORDER BY _change_type, id;
----
delete	7	APAC	70
insert	8	APAC	800

statement ok
DETACH cdf;

# ================= streaming path (native_write) =================
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/pownw' AS nw (TYPE fabricator, PROVIDER 'delta', native_write true);

statement ok
CREATE TABLE nw.main.sales PARTITIONED BY (region) AS
  SELECT * FROM (VALUES (1,'US',10),(2,'EU',20),(3,'APAC',30)) AS t(id,region,amt);

statement ok
COPY (SELECT * FROM (VALUES (4,'US',400),(5,'US',500)) AS t(id,region,amt))
TO 'nw.main.sales' (FORMAT mssql, CREATE_TABLE false, PARTITION_OVERWRITE true);

query TII
SELECT region, count(*), sum(amt) FROM nw.main.sales GROUP BY region ORDER BY region;
----
APAC	1	30
EU	1	20
US	2	900

# Durable across re-attach.
statement ok
DETACH nw;

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/pownw' AS nw2 (TYPE fabricator, PROVIDER 'delta');

query TII
SELECT region, count(*), sum(amt) FROM nw2.main.sales GROUP BY region ORDER BY region;
----
APAC	1	30
EU	1	20
US	2	900

statement ok
DETACH nw2;
