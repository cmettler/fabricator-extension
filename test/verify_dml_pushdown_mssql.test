# name: test/verify_dml_pushdown_mssql.test
# description: A DELETE or UPDATE whose WHOLE predicate (and, for UPDATE, every SET value) renders exactly runs as
#              ONE SQL Server statement — no scan, no rowid (ABI v93/v94; FabricatorCatalog's plan-less
#              PlanDelete/PlanUpdate + FabricatorPhysicalDmlWhere).
#              Everything else keeps the rowid path. Needs MSSQL_TESTDB_DSN.
#
#              ⚠⚠ THE LOAD-BEARING SECTION IS §2, AND IT IS A DIFFERENTIAL. A scan's pushed filter may be a
#              SUPERSET because DuckDB re-applies it above the scan; a DELETE has no such net, so a predicate
#              rendered weaker than the user's deletes rows nobody named — with exit 0 and a plausible count.
#              So the same DELETE sequence runs on two identical tables, one with the shortcut and one with
#              `fabricator_dml_pushdown = false` (the rowid path, i.e. the reference oracle), and every count
#              and the final contents must agree. The sequence covers the exact-type allow-list (INTEGER,
#              DECIMAL, BIT, DATE), NULL semantics (`<>` must not delete a NULL), IS NULL, BETWEEN, IN and OR.
#
#              ⚠ §1's routing rows are what keep §2 from passing VACUOUSLY: without them a build in which the
#              shortcut never fires would agree with the oracle perfectly. EXPLAIN title-cases operator names
#              on DuckDB 2.0 (see verify_lateral), hence `Fabricator Delete Where` / `Mssql Net Delete`.
# group: [fabricator]

require fabricator

require-env MSSQL_TESTDB_DSN

# ⚠ remote_pushdown OFF: with it on, the remote optimizer takes a DELETE / UPDATE first and runs it as one translated
# statement (verify_remote_dml_mssql). This suite gates the plan-less shortcut, which is what a catalog without remote
# pushdown — and every statement the translation declines — still gets.
statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS db (TYPE fabricator, remote_pushdown 'false');

# ═══ §0  Setup ═════════════════════════════════════════════════════════════════════════════════════════
# Two identical tables, created SERVER-SIDE so their types are SQL Server's own (BIT, DECIMAL(10,2), DATE).
# id 1..40; n = NULL when id % 7 = 0, else id % 5; flag = id % 2; amount = id * 1.25; d = 2026-01-01 + id days;
# v = 'v' || (id % 3). dp_heap has NO primary key and no unique index (§4).

statement ok
SELECT fabricator_exec('db', 'DROP TABLE IF EXISTS dbo.dp_on; DROP TABLE IF EXISTS dbo.dp_off; DROP TABLE IF EXISTS dbo.dp_heap;
CREATE TABLE dbo.dp_on (id INT PRIMARY KEY, n INT NULL, flag BIT, amount DECIMAL(10,2), d DATE, v VARCHAR(20));
INSERT INTO dbo.dp_on SELECT value, CASE WHEN value % 7 = 0 THEN NULL ELSE value % 5 END, value % 2, value * 1.25,
  DATEADD(day, value, ''2026-01-01''), ''v'' + CAST(value % 3 AS VARCHAR) FROM GENERATE_SERIES(1, 40);
SELECT * INTO dbo.dp_off FROM dbo.dp_on; ALTER TABLE dbo.dp_off ADD PRIMARY KEY (id);
CREATE TABLE dbo.dp_heap (id INT, n INT); INSERT INTO dbo.dp_heap VALUES (1, 1), (2, 2), (3, 3);');

statement ok
SELECT fabricator_refresh_cache('db');

# ═══ §1  Routing — the shortcut fires exactly where it should ═════════════════════════════════════════

# Exact types: the shortcut, with the predicate it sent.
query II
EXPLAIN DELETE FROM db.dbo.dp_on WHERE id > 35 AND n <> 2;
----
physical_plan	<REGEX>:.*Fabricator Delete Where.*

# A VARCHAR comparison is NOT exact on SQL Server (collation, trailing spaces) — the rowid path, and the
# shortcut operator is ABSENT rather than merely bypassed.
query II
EXPLAIN DELETE FROM db.dbo.dp_on WHERE v = 'v1';
----
physical_plan	<REGEX>:.*Mssql Net Delete.*

query II
EXPLAIN DELETE FROM db.dbo.dp_on WHERE v = 'v1';
----
physical_plan	<!REGEX>:.*Fabricator Delete Where.*

# ONE inexact conjunct sends the WHOLE statement to the rowid path — never a dropped conjunct.
query II
EXPLAIN DELETE FROM db.dbo.dp_on WHERE id > 5 AND v = 'v1';
----
physical_plan	<!REGEX>:.*Fabricator Delete Where.*

# An AND NESTED in an OR is where a dropped conjunct would hide: a top-level AND arrives as separate filter
# expressions (each refused on its own), so only this shape reaches the serializer's conjunction code.
query II
EXPLAIN DELETE FROM db.dbo.dp_on WHERE (id > 25 AND v = 'v2') OR id = 15;
----
physical_plan	<!REGEX>:.*Fabricator Delete Where.*

# A subquery (a join under the DELETE) keeps the rowid path.
query II
EXPLAIN DELETE FROM db.dbo.dp_on WHERE id IN (SELECT 1 UNION ALL SELECT 2);
----
physical_plan	<!REGEX>:.*Fabricator Delete Where.*

# The kill switch.
statement ok
SET fabricator_dml_pushdown = false;

query II
EXPLAIN DELETE FROM db.dbo.dp_on WHERE id > 35;
----
physical_plan	<!REGEX>:.*Fabricator Delete Where.*

statement ok
SET fabricator_dml_pushdown = true;

# ═══ §2  The differential — same DELETEs, shortcut vs rowid path, identical counts and contents ════════

query I
DELETE FROM db.dbo.dp_on WHERE id > 35;
----
5

# `<>` on a nullable column: id 7 (n NULL) must SURVIVE, in both engines' semantics.
query I
DELETE FROM db.dbo.dp_on WHERE n <> 2 AND id < 10;
----
7

query I
DELETE FROM db.dbo.dp_on WHERE n IS NULL;
----
5

query I
DELETE FROM db.dbo.dp_on WHERE flag = true AND amount >= 30.00;
----
5

query I
DELETE FROM db.dbo.dp_on WHERE d BETWEEN DATE '2026-01-12' AND DATE '2026-01-15';
----
3

query I
DELETE FROM db.dbo.dp_on WHERE id IN (11, 12, 13) OR n = 4;
----
3

# Not exact (VARCHAR) — the rowid path inside the same sequence, so both kinds compose.
query I
DELETE FROM db.dbo.dp_on WHERE v = 'v1' AND id < 20;
----
2

# The nested shape (see §1): rendered with its inexact conjunct DROPPED it would delete 4 rows, not 3.
query I
DELETE FROM db.dbo.dp_on WHERE (id > 25 AND v = 'v2') OR id = 15;
----
3

statement ok
SET fabricator_dml_pushdown = false;

query I
DELETE FROM db.dbo.dp_off WHERE id > 35;
----
5

query I
DELETE FROM db.dbo.dp_off WHERE n <> 2 AND id < 10;
----
7

query I
DELETE FROM db.dbo.dp_off WHERE n IS NULL;
----
5

query I
DELETE FROM db.dbo.dp_off WHERE flag = true AND amount >= 30.00;
----
5

query I
DELETE FROM db.dbo.dp_off WHERE d BETWEEN DATE '2026-01-12' AND DATE '2026-01-15';
----
3

query I
DELETE FROM db.dbo.dp_off WHERE id IN (11, 12, 13) OR n = 4;
----
3

query I
DELETE FROM db.dbo.dp_off WHERE v = 'v1' AND id < 20;
----
2

# The nested shape (see §1): rendered with its inexact conjunct DROPPED it would delete 4 rows, not 3.
query I
DELETE FROM db.dbo.dp_off WHERE (id > 25 AND v = 'v2') OR id = 15;
----
3

statement ok
SET fabricator_dml_pushdown = true;

# Identical contents, both directions.
query I
SELECT count(*) FROM (SELECT * FROM db.dbo.dp_on EXCEPT SELECT * FROM db.dbo.dp_off);
----
0

query I
SELECT count(*) FROM (SELECT * FROM db.dbo.dp_off EXCEPT SELECT * FROM db.dbo.dp_on);
----
0

query III
SELECT count(*), sum(id), sum(amount) FROM db.dbo.dp_on;
----
7	132	165.00

# And on the SERVER, not only through our scan.
query I
SELECT * FROM fabricator_query('db', 'SELECT count(*) AS c FROM dbo.dp_on');
----
7

# ═══ §3  Transactions — the statement runs on the transaction's own connection ═════════════════════════

statement ok
BEGIN;

query I
DELETE FROM db.dbo.dp_on WHERE id <= 15;
----
1

# Read-your-writes inside the transaction.
query I
SELECT count(*) FROM db.dbo.dp_on;
----
6

statement ok
ROLLBACK;

query I
SELECT count(*) FROM db.dbo.dp_on;
----
7

statement ok
BEGIN;

query I
DELETE FROM db.dbo.dp_on WHERE id <= 15;
----
1

statement ok
COMMIT;

query I
SELECT * FROM fabricator_query('db', 'SELECT count(*) AS c FROM dbo.dp_on');
----
6

# ═══ §4  A table with NO primary key — deletable now, where the rowid path refuses ═══════════════════════
# The rowid path needs a key for row identity and refuses at plan time. The shortcut needs none.

statement ok
SET fabricator_dml_pushdown = false;

statement error
DELETE FROM db.dbo.dp_heap WHERE id = 1;
----
primary key

statement ok
SET fabricator_dml_pushdown = true;

query I
DELETE FROM db.dbo.dp_heap WHERE id = 1;
----
1

query I
SELECT count(*) FROM db.dbo.dp_heap;
----
2

# ...while a predicate that is not exact still gets the refusal, unchanged.
statement error
DELETE FROM db.dbo.dp_heap WHERE CAST(n AS VARCHAR) = '2';
----
primary key

# RETURNING keeps the rowid path — the shortcut returns only a count — and returns the deleted rows from the DELETE's
# own OUTPUT (ABI v98; verify_returning_mssql). Rolled back, so the tables stay as the later sections expect them.
query II
EXPLAIN DELETE FROM db.dbo.dp_on WHERE id = 20 RETURNING id;
----
physical_plan	<REGEX>:.*Mssql Net Delete.*

statement ok
BEGIN;

query I
DELETE FROM db.dbo.dp_on WHERE id = 20 RETURNING id;
----
20

statement ok
ROLLBACK;

# ═══ §5  UPDATE setup (ABI v94) ═════════════════════════════════════════════════════════════════════════
# The same discipline for UPDATE: the SET values must render exactly too. Two identical tables again, with one
# column per admitted type and every arithmetic operand type SQL Server produces (SMALLINT, tinyint as
# UTINYINT, INTEGER, BIGINT). id 1..40; n = NULL when id % 7 = 0, else id % 5; s = id; b = id % 200;
# flag = id % 2; amount = id * 1.25; d = 2026-01-01 + id days; v = 'v' || (id % 3); big = id * 100.

statement ok
SELECT fabricator_exec('db', 'DROP TABLE IF EXISTS dbo.du_on; DROP TABLE IF EXISTS dbo.du_off;');

statement ok
SELECT fabricator_exec('db', 'CREATE TABLE dbo.du_on (id INT PRIMARY KEY, n INT NULL, s SMALLINT, b TINYINT, flag BIT,
  amount DECIMAL(10,2), d DATE, v VARCHAR(20), big BIGINT);
INSERT INTO dbo.du_on SELECT value, CASE WHEN value % 7 = 0 THEN NULL ELSE value % 5 END, value, value % 200,
  value % 2, value * 1.25, DATEADD(day, value, ''2026-01-01''), ''v'' + CAST(value % 3 AS VARCHAR), CAST(value AS BIGINT) * 100
  FROM GENERATE_SERIES(1, 40);
SELECT * INTO dbo.du_off FROM dbo.du_on; ALTER TABLE dbo.du_off ADD PRIMARY KEY (id);');

statement ok
SELECT fabricator_refresh_cache('db');

# ═══ §6  UPDATE routing ═════════════════════════════════════════════════════════════════════════════════

# Integer arithmetic over a column, a VARCHAR constant, an exact predicate: the shortcut.
query II
EXPLAIN UPDATE db.dbo.du_on SET n = n + 1, v = 'z' WHERE id > 30;
----
physical_plan	<REGEX>:.*Fabricator Update Where.*

# DECIMAL arithmetic: the binder wraps it in a CAST, and decimal precision rules differ between the engines.
query II
EXPLAIN UPDATE db.dbo.du_on SET amount = amount + 1 WHERE id = 1;
----
physical_plan	<!REGEX>:.*Fabricator Update Where.*

# A function in a SET value.
query II
EXPLAIN UPDATE db.dbo.du_on SET v = upper(v) WHERE id = 1;
----
physical_plan	<!REGEX>:.*Fabricator Update Where.*

# Division: DuckDB's `/` is FLOAT division (and casts back), T-SQL's integer `/` truncates — never the same.
query II
EXPLAIN UPDATE db.dbo.du_on SET n = n / 2 WHERE id = 1;
----
physical_plan	<!REGEX>:.*Fabricator Update Where.*

# A VARCHAR predicate, exactly as for DELETE.
query II
EXPLAIN UPDATE db.dbo.du_on SET n = 0 WHERE v = 'v1';
----
physical_plan	<!REGEX>:.*Fabricator Update Where.*

# UPDATE … FROM (a join under the UPDATE).
query II
EXPLAIN UPDATE db.dbo.du_on AS t SET n = 0 FROM (SELECT 1 AS k) x WHERE t.id = x.k;
----
physical_plan	<!REGEX>:.*Fabricator Update Where.*

statement ok
SET fabricator_dml_pushdown = false;

query II
EXPLAIN UPDATE db.dbo.du_on SET n = n + 1 WHERE id > 30;
----
physical_plan	<!REGEX>:.*Fabricator Update Where.*

statement ok
SET fabricator_dml_pushdown = true;

# ═══ §7  The UPDATE differential — shortcut vs rowid path ═════════════════════════════════════════════════
# The counts are DuckDB's own answers for the same sequence on a native table, so they are an oracle for the
# rowid path as much as for the shortcut. Statements 8 and 9 take the rowid path inside the sequence.

query I
UPDATE db.dbo.du_on SET n = n + 1 WHERE id > 30;
----
10

query I
UPDATE db.dbo.du_on SET v = 'x', flag = false WHERE n IS NULL;
----
5

query I
UPDATE db.dbo.du_on SET s = s * 2 - 1 WHERE id BETWEEN 5 AND 9;
----
5

query I
UPDATE db.dbo.du_on SET big = big * 1000 + id WHERE flag = true;
----
17

query I
UPDATE db.dbo.du_on SET amount = 9.99, d = DATE '2030-01-01' WHERE id IN (1, 2, 3);
----
3

query I
UPDATE db.dbo.du_on SET n = id WHERE id < 4 OR id = 40;
----
4

query I
UPDATE db.dbo.du_on SET n = NULL WHERE id = 20;
----
1

query I
UPDATE db.dbo.du_on SET amount = amount + 1 WHERE id = 10;
----
1

query I
UPDATE db.dbo.du_on SET n = 0 WHERE v = 'v1' AND id < 15;
----
4

query I
UPDATE db.dbo.du_on SET b = b + 1 WHERE id = 7;
----
1

# The SET column is also the predicate's column: both engines read the PRE-update value.
query I
UPDATE db.dbo.du_on SET n = n + 10 WHERE n > 2;
----
15

statement ok
SET fabricator_dml_pushdown = false;

query I
UPDATE db.dbo.du_off SET n = n + 1 WHERE id > 30;
----
10

query I
UPDATE db.dbo.du_off SET v = 'x', flag = false WHERE n IS NULL;
----
5

query I
UPDATE db.dbo.du_off SET s = s * 2 - 1 WHERE id BETWEEN 5 AND 9;
----
5

query I
UPDATE db.dbo.du_off SET big = big * 1000 + id WHERE flag = true;
----
17

query I
UPDATE db.dbo.du_off SET amount = 9.99, d = DATE '2030-01-01' WHERE id IN (1, 2, 3);
----
3

query I
UPDATE db.dbo.du_off SET n = id WHERE id < 4 OR id = 40;
----
4

query I
UPDATE db.dbo.du_off SET n = NULL WHERE id = 20;
----
1

query I
UPDATE db.dbo.du_off SET amount = amount + 1 WHERE id = 10;
----
1

query I
UPDATE db.dbo.du_off SET n = 0 WHERE v = 'v1' AND id < 15;
----
4

query I
UPDATE db.dbo.du_off SET b = b + 1 WHERE id = 7;
----
1

query I
UPDATE db.dbo.du_off SET n = n + 10 WHERE n > 2;
----
15

statement ok
SET fabricator_dml_pushdown = true;

query I
SELECT count(*) FROM (SELECT * FROM db.dbo.du_on EXCEPT SELECT * FROM db.dbo.du_off);
----
0

query I
SELECT count(*) FROM (SELECT * FROM db.dbo.du_off EXCEPT SELECT * FROM db.dbo.du_on);
----
0

# And against the native-table reference, column by column — so a defect both paths shared would show too.
query IIIIIIIII
SELECT count(*), sum(id), sum(n), sum(s), sum(b), sum(CAST(flag AS INTEGER)), sum(amount), max(d), sum(big)
FROM db.dbo.du_on;
----
40	820	260	850	821	17	1048.47	2030-01-01	33748637

# ═══ §8  A failing shortcut statement changes nothing ══════════════════════════════════════════════════════
# 40 * 1000 overflows SMALLINT. SQL Server aborts the whole statement (8115), so no row moves, exactly as the
# rowid path fails before writing anything.

statement error
UPDATE db.dbo.du_on SET s = s * 1000 WHERE id >= 30;
----
Arithmetic overflow

query I
SELECT sum(s) FROM db.dbo.du_on;
----
850

# ═══ §9  UPDATE in a transaction ═══════════════════════════════════════════════════════════════════════════

statement ok
BEGIN;

query I
UPDATE db.dbo.du_on SET n = -1 WHERE id = 5;
----
1

query I
SELECT n FROM db.dbo.du_on WHERE id = 5;
----
-1

statement ok
ROLLBACK;

query I
SELECT n FROM db.dbo.du_on WHERE id = 5;
----
0

statement ok
BEGIN;

query I
UPDATE db.dbo.du_on SET n = n + 100 WHERE id = 5;
----
1

statement ok
COMMIT;

query I
SELECT * FROM fabricator_query('db', 'SELECT n FROM dbo.du_on WHERE id = 5');
----
100

# ═══ §10  UPDATE on a table with NO primary key, and RETURNING ═════════════════════════════════════════════

statement ok
SET fabricator_dml_pushdown = false;

statement error
UPDATE db.dbo.dp_heap SET n = 9 WHERE id = 2;
----
primary key

statement ok
SET fabricator_dml_pushdown = true;

query I
UPDATE db.dbo.dp_heap SET n = 9 WHERE id = 2;
----
1

query I
SELECT n FROM db.dbo.dp_heap WHERE id = 2;
----
9

# RETURNING keeps the rowid path and returns the new values from the UPDATE's own OUTPUT (ABI v98); rolled back
query II
EXPLAIN UPDATE db.dbo.du_on SET n = 1 WHERE id = 1 RETURNING id;
----
physical_plan	<REGEX>:.*Mssql Net Update.*

statement ok
BEGIN;

query II
UPDATE db.dbo.du_on SET n = 1 WHERE id = 1 RETURNING id, n;
----
1	1

statement ok
ROLLBACK;

# ═══ §11  Timestamps on the ROWID path — bound as the column's own type ═════════════════════════════════════
# SqlClient infers legacy `datetime` (≈3.33 ms) for a .NET DateTime. Against a datetime2 column that ROUNDED a
# written value and made a keyed DELETE/UPDATE match nothing — silently. Pinning datetime2 everywhere breaks the
# mirror case: a legacy `datetime` stores .127 as .1266667, so a datetime2 key compares unequal. The binding
# therefore follows each column's declared type (SqlServerCatalog.DateTimeBindings). Every statement here runs
# with the shortcut OFF, because TIMESTAMP is not on its exact-type list and these are the paths at risk.

statement ok
SET fabricator_dml_pushdown = false;

statement ok
SELECT fabricator_exec('db', 'DROP TABLE IF EXISTS dbo.ts_u; DROP TABLE IF EXISTS dbo.ts_k; DROP TABLE IF EXISTS dbo.ts_l; DROP TABLE IF EXISTS dbo.ts_r;');

statement ok
SELECT fabricator_exec('db', 'CREATE TABLE dbo.ts_u (id INT PRIMARY KEY, ts DATETIME2(7), old DATETIME);
INSERT INTO dbo.ts_u VALUES (1, ''2026-01-01'', ''2026-01-01'');
CREATE TABLE dbo.ts_k (ts DATETIME2(7) PRIMARY KEY, v INT);
INSERT INTO dbo.ts_k VALUES (''2026-01-01 12:00:00.123456'', 1), (''2026-01-01 12:00:00.124456'', 2), (''2026-01-01 12:00:00.125456'', 3);
CREATE TABLE dbo.ts_l (ts DATETIME PRIMARY KEY, v INT);
INSERT INTO dbo.ts_l VALUES (''2026-01-01 12:00:00.123'', 1), (''2026-01-01 12:00:00.127'', 2), (''2026-01-01 23:59:59.997'', 3);
CREATE TABLE dbo.ts_r (id INT IDENTITY PRIMARY KEY, ts DATETIME2(7));');

statement ok
SELECT fabricator_refresh_cache('db');

# A SET value: exact into datetime2; into a legacy datetime the SERVER rounds it, as any write into that type does.
query I
UPDATE db.dbo.ts_u SET ts = TIMESTAMP '2026-01-01 12:00:00.123456', old = TIMESTAMP '2026-01-01 12:00:00.123456' WHERE id = 1;
----
1

query II
SELECT * FROM fabricator_query('db', 'SELECT CONVERT(varchar(30), ts, 121) AS u, CONVERT(varchar(30), old, 121) AS o FROM dbo.ts_u');
----
2026-01-01 12:00:00.1234560	2026-01-01 12:00:00.123

# A datetime2 KEY: the rowid DELETE and UPDATE must find their row. Rounded, both matched nothing and reported 0.
query I
DELETE FROM db.dbo.ts_k WHERE v = 2;
----
1

query I
UPDATE db.dbo.ts_k SET v = 30 WHERE v = 3;
----
1

query II
SELECT * FROM fabricator_query('db', 'SELECT CONVERT(varchar(30), ts, 121) AS k, v FROM dbo.ts_k ORDER BY v');
----
2026-01-01 12:00:00.1234560	1
2026-01-01 12:00:00.1254560	30

# A legacy datetime KEY — the mirror case, which a blanket datetime2 binding breaks.
query I
DELETE FROM db.dbo.ts_l WHERE v = 2;
----
1

query I
UPDATE db.dbo.ts_l SET v = 30 WHERE v = 3;
----
1

query II
SELECT * FROM fabricator_query('db', 'SELECT CONVERT(varchar(30), ts, 121) AS l, v FROM dbo.ts_l ORDER BY v');
----
2026-01-01 12:00:00.123	1
2026-01-01 23:59:59.997	30

# INSERT … RETURNING binds its values the same way, and echoes what was stored.
query I
INSERT INTO db.dbo.ts_r (ts) VALUES (TIMESTAMP '2026-01-01 12:00:00.123456') RETURNING strftime(ts, '%H:%M:%S.%f');
----
12:00:00.123456

query I
SELECT * FROM fabricator_query('db', 'SELECT CONVERT(varchar(30), ts, 121) AS r FROM dbo.ts_r');
----
2026-01-01 12:00:00.1234560

statement ok
SET fabricator_dml_pushdown = true;

# ═══ §12  Cleanup ═══════════════════════════════════════════════════════════════════════════════════════

statement ok
SELECT fabricator_exec('db', 'DROP TABLE dbo.dp_on; DROP TABLE dbo.dp_off; DROP TABLE dbo.dp_heap; DROP TABLE dbo.du_on; DROP TABLE dbo.du_off;
DROP TABLE dbo.ts_u; DROP TABLE dbo.ts_k; DROP TABLE dbo.ts_l; DROP TABLE dbo.ts_r;');
