# name: test/verify_hidden_rowid.test
# description: The hidden_rowid ATTACH option. A table created WITHOUT any key (no PRIMARY KEY, no UNIQUE, no
#              IDENTITY marker) gets a BIGINT IDENTITY column [__fabricator_rowid] that DuckDB never sees: it is
#              left out of every reported schema (whatever the option) and becomes the table's VIRTUAL rowid, so
#              UPDATE/DELETE work on keyless tables — including set-based ones with a join or a subquery, which
#              the predicate shortcut cannot take. HIDDEN, not merely added, because a client inserting
#              positionally (INSERT INTO t VALUES (...) with no column list — DuckLake does this on its metadata
#              tables) fails on any extra visible column. See docs/ducklake-catalog.md.
# group: [fabricator]

require fabricator

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS db (TYPE fabricator, hidden_rowid true);

statement ok
DROP TABLE IF EXISTS db.dbo.fabricator_hr_t;

statement ok
DROP TABLE IF EXISTS db.dbo.fabricator_hr_pk;

statement ok
DROP TABLE IF EXISTS db.dbo.fabricator_hr_uq;

statement ok
DROP TABLE IF EXISTS db.dbo.fabricator_hr_gen;

statement ok
DROP TABLE IF EXISTS db.dbo.fabricator_hr_ctas;

statement ok
DROP TABLE IF EXISTS db.dbo.fabricator_hr_plain;

# --- 1. a keyless table: DuckDB sees only its own columns, the server has the identity column ---
statement ok
CREATE TABLE db.dbo.fabricator_hr_t (a INTEGER, b VARCHAR);

query T
SELECT column_name FROM duckdb_columns() WHERE database_name = 'db' AND table_name = 'fabricator_hr_t'
ORDER BY column_index;
----
a
b

query TT
SELECT name, is_identity FROM fabricator_query('db',
  'SELECT c.name, CAST(c.is_identity AS INT) AS is_identity FROM sys.columns c
   WHERE c.object_id = OBJECT_ID(''dbo.fabricator_hr_t'') ORDER BY c.column_id');
----
a	0
b	0
__fabricator_rowid	1

# --- 2. the positional INSERT a visible extra column would break ---
statement ok
INSERT INTO db.dbo.fabricator_hr_t VALUES (1, 'x'), (2, 'y'), (3, 'z');

query IT
SELECT * FROM db.dbo.fabricator_hr_t ORDER BY a;
----
1	x
2	y
3	z

# The rowid IS the identity column: BIGINT, engine-assigned in insert order.
query TII
SELECT any_value(typeof(rowid)), min(rowid), max(rowid) FROM db.dbo.fabricator_hr_t;
----
BIGINT	1	3

# --- 3. set-based DML the exact predicate renderer refuses, so it must take the rowid path ---
statement ok
UPDATE db.dbo.fabricator_hr_t SET b = v.nb FROM (VALUES (1, 'X'), (3, 'Z')) v(k, nb)
WHERE fabricator_hr_t.a = v.k;

query IT
SELECT * FROM db.dbo.fabricator_hr_t ORDER BY a;
----
1	X
2	y
3	Z

statement ok
UPDATE db.dbo.fabricator_hr_t SET b = (SELECT max(x) FROM (VALUES ('m'), ('n')) w(x)) WHERE a = 2;

query IT
SELECT * FROM db.dbo.fabricator_hr_t ORDER BY a;
----
1	X
2	n
3	Z

statement ok
DELETE FROM db.dbo.fabricator_hr_t
WHERE NOT EXISTS (SELECT 1 FROM (VALUES (1), (3)) w(k) WHERE w.k = fabricator_hr_t.a);

query IT
SELECT * FROM db.dbo.fabricator_hr_t ORDER BY a;
----
1	X
3	Z

# --- 4. RETURNING reads OUTPUT INSERTED.*, which must not leak the hidden column ---
query IT
INSERT INTO db.dbo.fabricator_hr_t VALUES (7, 'r') RETURNING *;
----
7	r

# --- 5. ALTER keeps it hidden: a positional INSERT of the new width still binds ---
statement ok
ALTER TABLE db.dbo.fabricator_hr_t ADD COLUMN c INTEGER;

# RETURNING again, now with the hidden column in the MIDDLE of OUTPUT INSERTED.* (a, b, rowid, c): before the
# ALTER it is last, where a positional read of the first N columns would pass anyway.
query ITI
INSERT INTO db.dbo.fabricator_hr_t VALUES (8, 's', 80) RETURNING *;
----
8	s	80

query ITI
SELECT * FROM db.dbo.fabricator_hr_t ORDER BY a;
----
1	X	NULL
3	Z	NULL
7	r	NULL
8	s	80

# --- 6. a table WITH a key gets none: the key is the rowid, as without the option ---
statement ok
CREATE TABLE db.dbo.fabricator_hr_pk (a INTEGER PRIMARY KEY, b VARCHAR);

statement ok
CREATE TABLE db.dbo.fabricator_hr_uq (a INTEGER NOT NULL UNIQUE, b VARCHAR);

statement ok
CREATE TABLE db.dbo.fabricator_hr_gen (id BIGINT AS (0), b VARCHAR);

query T
SELECT count(*) FROM fabricator_query('db',
  'SELECT c.name FROM sys.columns c WHERE c.name = ''__fabricator_rowid'' AND c.object_id IN
   (OBJECT_ID(''dbo.fabricator_hr_pk''), OBJECT_ID(''dbo.fabricator_hr_uq''), OBJECT_ID(''dbo.fabricator_hr_gen''))');
----
0

# --- 7. CTAS gets it too ---
statement ok
CREATE TABLE db.dbo.fabricator_hr_ctas AS SELECT i AS a, 'v' || i AS b FROM range(1, 6) r(i);

query T
SELECT column_name FROM duckdb_columns() WHERE database_name = 'db' AND table_name = 'fabricator_hr_ctas'
ORDER BY column_index;
----
a
b

statement ok
UPDATE db.dbo.fabricator_hr_ctas SET b = 'odd' FROM (VALUES (1), (3), (5)) v(k) WHERE fabricator_hr_ctas.a = v.k;

query T
SELECT string_agg(b, ',' ORDER BY a) FROM db.dbo.fabricator_hr_ctas;
----
odd,v2,odd,v4,odd

# --- 8. a catalog attached WITHOUT the option: hides it all the same, and uses it as the rowid ---
statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS plain (TYPE fabricator);

query T
SELECT column_name FROM duckdb_columns() WHERE database_name = 'plain' AND table_name = 'fabricator_hr_t'
ORDER BY column_index;
----
a
b
c

statement ok
DELETE FROM plain.dbo.fabricator_hr_t WHERE a IN (SELECT 7 UNION ALL SELECT 8);

query I
SELECT count(*) FROM plain.dbo.fabricator_hr_t;
----
2

# ... but does not CREATE it: a keyless table there still has no row identity.
statement ok
CREATE TABLE plain.dbo.fabricator_hr_plain (a INTEGER, b VARCHAR);

statement ok
INSERT INTO plain.dbo.fabricator_hr_plain VALUES (1, 'x');

statement error
UPDATE plain.dbo.fabricator_hr_plain SET b = v.nb FROM (VALUES (1, 'X')) v(k, nb)
WHERE fabricator_hr_plain.a = v.k;
----
requires a table with a primary key or unique index

# --- cleanup ---
statement ok
DROP TABLE db.dbo.fabricator_hr_t;

statement ok
DROP TABLE db.dbo.fabricator_hr_pk;

statement ok
DROP TABLE db.dbo.fabricator_hr_uq;

statement ok
DROP TABLE db.dbo.fabricator_hr_gen;

statement ok
DROP TABLE db.dbo.fabricator_hr_ctas;

statement ok
DROP TABLE plain.dbo.fabricator_hr_plain;
