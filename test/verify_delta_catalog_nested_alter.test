# name: test/verify_delta_catalog_nested_alter.test
# description: Nested STRUCT-field schema evolution on the Delta catalog — DuckDB's field DDL
#              (`ALTER TABLE t ADD/DROP/RENAME COLUMN s.f ...`) maps to metadata-only Delta commits
#              (engineered-wood AddField/RenameField/DropField). Old data files lack an ADDed member —
#              the read path reconciles it to a typed NULL child (recursive schema-evolution backfill,
#              any nesting depth). RENAME/DROP of a nested field require column mapping (the field keeps
#              its column id + physical name; a plain table would need a full rewrite) — same rule as
#              top-level. native_read handles evolved tables too: every file's parquet schema nodes are
#              footer-probed (paths + field ids), and a column/member the file predates is emitted as
#              CAST(NULL AS <type>) in the per-file query (top-level or inside the struct rebuild) — so
#              mixed-vintage files read coherently through DuckDB's own parquet reader in both mapping
#              modes. Set FABRICATOR_DELTA_WRITE_DIR to a WRITABLE base path. Local FS.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

# ---- ADD a nested field (default catalog = name column mapping) ----
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested' AS w (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE w.main.t AS
SELECT i AS id, {'a': i * 10, 'n': {'x': i}} AS s FROM range(1, 4) AS r(i);

statement ok
ALTER TABLE w.main.t ADD COLUMN s.b VARCHAR;

# old rows backfill NULL for the new member
query III
SELECT id, (s).a, (s).b FROM w.main.t ORDER BY id;
----
1	10	NULL
2	20	NULL
3	30	NULL

# new rows carry the full evolved struct; mixed-vintage files read coherently
statement ok
INSERT INTO w.main.t VALUES (4, {'a': 40, 'n': {'x': 4}, 'b': 'four'});

query III
SELECT id, (s).a, (s).b FROM w.main.t ORDER BY id;
----
1	10	NULL
2	20	NULL
3	30	NULL
4	40	four

# predicates on the evolved member
query I
SELECT count(*) FROM w.main.t WHERE (s).b IS NULL;
----
3

query I
SELECT id FROM w.main.t WHERE (s).b = 'four';
----
4

# ---- two-level nesting ----
statement ok
ALTER TABLE w.main.t ADD COLUMN s.n.y INT;

query III
SELECT id, (s).n.x, (s).n.y FROM w.main.t WHERE id IN (1, 4) ORDER BY id;
----
1	1	NULL
4	4	NULL

statement ok
INSERT INTO w.main.t VALUES (5, {'a': 50, 'n': {'x': 5, 'y': 55}, 'b': 'five'});

query II
SELECT (s).n.y, (s).b FROM w.main.t WHERE id = 5;
----
55	five

# ---- RENAME a nested field (metadata-only; mapping keeps the physical identity) ----
statement ok
ALTER TABLE w.main.t RENAME COLUMN s.a TO alpha;

query II
SELECT id, (s).alpha FROM w.main.t WHERE id IN (1, 5) ORDER BY id;
----
1	10
5	50

# ---- DROP a nested field ----
statement ok
ALTER TABLE w.main.t DROP COLUMN s.b;

query I
SELECT count(*) FROM w.main.t WHERE (s).alpha > 0;
----
5

statement error
SELECT (s).b FROM w.main.t;
----

# ---- DML on the evolved table (the reconciled read feeds the DV/rewrite paths) ----
statement ok
DELETE FROM w.main.t WHERE (s).n.x = 2;

statement ok
UPDATE w.main.t SET id = id + 100 WHERE (s).n.y = 55;

query II
SELECT count(*), max(id) FROM w.main.t;
----
4	105

# ---- durability across re-attach ----
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested' AS w2 (TYPE fabricator, PROVIDER 'delta');

query II
SELECT count(*), count((s).n.y) FROM w2.main.t;
----
4	1

# ---- native_read over the evolved mixed-vintage table (per-file presence probe: files predating an
#      added column/member read it as a typed NULL through DuckDB's own parquet reader) ----
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nested' AS nr (TYPE fabricator, PROVIDER 'delta', native_read true);

query II
SELECT count(*), count((s).n.y) FROM nr.main.t;
----
4	1

query II
SELECT id, (s).alpha FROM nr.main.t WHERE (s).n.y IS NOT NULL ORDER BY id;
----
105	50

# a member predicate over old files (backfilled NULLs) is exact
query I
SELECT count(*) FROM nr.main.t WHERE (s).n.y IS NULL;
----
3

# ---- native_read + TOP-LEVEL add on an unmapped table (the presence probe covers both modes/levels) ----
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/toplevel' AS tw (TYPE fabricator, PROVIDER 'delta', column_mapping 'none');

statement ok
CREATE TABLE tw.main.t AS SELECT 1 AS id, {'a': 10} AS s;

statement ok
ALTER TABLE tw.main.t ADD COLUMN extra VARCHAR;

statement ok
ALTER TABLE tw.main.t ADD COLUMN s.b INT;

statement ok
INSERT INTO tw.main.t VALUES (2, {'a': 20, 'b': 22}, 'x');

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/toplevel' AS tn (TYPE fabricator, PROVIDER 'delta', column_mapping 'none', native_read true);

query IIII
SELECT id, (s).a, (s).b, extra FROM tn.main.t ORDER BY id;
----
1	10	NULL	NULL
2	20	22	x

# ---- guards ----
# unmapped table: ADD works (backfill), RENAME/DROP of a nested field are cleanly rejected
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/plainnested' AS p (TYPE fabricator, PROVIDER 'delta', column_mapping 'none');

statement ok
CREATE TABLE p.main.t AS SELECT 1 AS id, {'a': 10} AS s;

statement ok
ALTER TABLE p.main.t ADD COLUMN s.b VARCHAR;

query II
SELECT (s).a, (s).b FROM p.main.t;
----
10	NULL

statement error
ALTER TABLE p.main.t RENAME COLUMN s.a TO alpha;
----
requires column mapping

statement error
ALTER TABLE p.main.t DROP COLUMN s.a;
----
requires column mapping

# a nested add must be nullable-compatible: adding to a non-struct errors cleanly
statement error
ALTER TABLE p.main.t ADD COLUMN id.sub INT;
----
is not a STRUCT column

# unknown path segment
statement error
ALTER TABLE p.main.t ADD COLUMN nope.sub INT;
----

# duplicate member
statement error
ALTER TABLE p.main.t ADD COLUMN s.a INT;
----
already exists

# struct-typed field additions work on BOTH plain and MAPPING tables — under mapping the whole
# new subtree gets column ids + physical names recursively (the create-time assigner)
statement ok
ALTER TABLE w.main.t ADD COLUMN s.deep STRUCT(q INT);

statement ok
INSERT INTO w.main.t VALUES (200, {'alpha': 2000, 'n': {'x': 20, 'y': 21}, 'deep': {'q': 9}});

query II
SELECT (s).deep.q, count(*) OVER () FROM w.main.t WHERE id = 200;
----
9	1

# old rows read the whole new subtree as NULL
query I
SELECT count(*) FROM w.main.t WHERE (s).deep IS NULL OR (s).deep.q IS NULL;
----
4

statement ok
ALTER TABLE p.main.t ADD COLUMN s.deep STRUCT(q INT);

statement ok
INSERT INTO p.main.t VALUES (2, {'a': 20, 'b': 'x', 'deep': {'q': 7}});

query III
SELECT id, (s).deep.q, (s).b FROM p.main.t ORDER BY id;
----
1	NULL	NULL
2	7	x

# a struct-typed TOP-LEVEL add on a MAPPING table also assigns ids recursively (this previously
# committed spec-violating metadata — descendants without column ids)
statement ok
ALTER TABLE w.main.t ADD COLUMN extra2 STRUCT(m VARCHAR, k INT);

statement ok
INSERT INTO w.main.t VALUES (201, {'alpha': 2010, 'n': {'x': 21, 'y': 22}, 'deep': {'q': 10}}, {'m': 'hello', 'k': 42});

query II
SELECT (extra2).m, (extra2).k FROM w.main.t WHERE id = 201;
----
hello	42

query I
SELECT count(*) FROM w.main.t WHERE extra2 IS NULL;
----
5

# ============================================================================
# The `path` carrier is IDENTIFIERS, and it is an ARRAY for a reason: a field name may contain DOTS, so a
# joined string could not say whether "a.b" is one segment or two. That predates ABI v74 and survives it.
#
# What v74 changed is who escapes them. The hand-rolled builder this replaced handled `"` and `\` and
# nothing else, so a control character in a segment produced invalid JSON and the ALTER died inside the
# managed parser naming a byte position. Both properties are pinned together here because they fail the
# same way — a path that arrives as the wrong segments addresses the wrong field, or none.
#
# ⚠ The struct keeps a plain `keep` field throughout, and that is load-bearing rather than decoration:
# dropping the only member the OLD files share leaves the read reconcile with no overlap at all, which is
# the documented "fully disjoint children" cast error — a pre-existing limitation this section would
# otherwise trip over while appearing to be about escaping.
# ============================================================================

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/nestedescape' AS esc (TYPE fabricator, PROVIDER 'delta');

statement ok
CREATE TABLE esc.main.t (id INTEGER, "s.dotted" STRUCT("in	ner" INTEGER, keep INTEGER));

statement ok
INSERT INTO esc.main.t VALUES (1, {'in	ner': 10, 'keep': 1});

# ADD a field inside a struct whose OWN name contains a dot, beside a sibling whose name contains a tab.
statement ok
ALTER TABLE esc.main.t ADD COLUMN "s.dotted"."new	field" VARCHAR;

statement ok
INSERT INTO esc.main.t VALUES (2, {'in	ner': 20, 'keep': 2, 'new	field': 'v'});

query IIII
SELECT id, ("s.dotted")."in	ner", ("s.dotted").keep, ("s.dotted")."new	field" FROM esc.main.t ORDER BY id;
----
1	10	1	NULL
2	20	2	v

# RENAME carries the path AND a new name; the path must still resolve after the add above.
statement ok
ALTER TABLE esc.main.t RENAME COLUMN "s.dotted"."new	field" TO "re named";

query II
SELECT id, ("s.dotted")."re named" FROM esc.main.t ORDER BY id;
----
1	NULL
2	v

# The negative control: a path whose LAST segment differs from the real one by a single byte — space for
# tab — must not resolve. Without it, a mangled path that happened to be accepted would pass too.
statement error
ALTER TABLE esc.main.t DROP COLUMN "s.dotted"."in ner";
----
in ner

statement ok
ALTER TABLE esc.main.t DROP COLUMN "s.dotted"."in	ner";

query III
SELECT id, ("s.dotted").keep, ("s.dotted")."re named" FROM esc.main.t ORDER BY id;
----
1	1	NULL
2	2	v

statement ok
DETACH esc;
