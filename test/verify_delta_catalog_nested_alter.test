# name: test/verify_delta_catalog_nested_alter.test
# description: Nested STRUCT-field schema evolution on the Delta catalog — DuckDB's field DDL
#              (`ALTER TABLE t ADD/DROP/RENAME COLUMN s.f ...`) maps to metadata-only Delta commits
#              (engineered-wood AddField/RenameField/DropField). Old data files lack an ADDed member —
#              the read path reconciles it to a typed NULL child (recursive schema-evolution backfill,
#              any nesting depth). RENAME/DROP of a nested field require column mapping (the field keeps
#              its column id + physical name; a plain table would need a full rewrite) — same rule as
#              top-level. native_read handles evolved tables too: every file's parquet schema nodes are
#              footer-probed (paths + field ids), and a column/member the file predates is emitted as
#              CAST(NULL AS <type>) in the per-file query (top-level or inside the struct rebuild) — so
#              mixed-vintage files read coherently through DuckDB's own parquet reader in both mapping
#              modes. Set ARROWNET_DELTA_WRITE_DIR to a WRITABLE base path. Local FS.
# group: [mssql_net]

require mssql_net

require parquet

require-env ARROWNET_DELTA_WRITE_DIR

# ---- ADD a nested field (default catalog = name column mapping) ----
statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/nested' AS w (TYPE arrownet, PROVIDER 'delta');

statement ok
CREATE TABLE w.main.t AS
SELECT i AS id, {'a': i * 10, 'n': {'x': i}} AS s FROM range(1, 4) AS r(i);

statement ok
ALTER TABLE w.main.t ADD COLUMN s.b VARCHAR;

# old rows backfill NULL for the new member
query III
SELECT id, (s).a, (s).b FROM w.main.t ORDER BY id;
----
1	10	NULL
2	20	NULL
3	30	NULL

# new rows carry the full evolved struct; mixed-vintage files read coherently
statement ok
INSERT INTO w.main.t VALUES (4, {'a': 40, 'n': {'x': 4}, 'b': 'four'});

query III
SELECT id, (s).a, (s).b FROM w.main.t ORDER BY id;
----
1	10	NULL
2	20	NULL
3	30	NULL
4	40	four

# predicates on the evolved member
query I
SELECT count(*) FROM w.main.t WHERE (s).b IS NULL;
----
3

query I
SELECT id FROM w.main.t WHERE (s).b = 'four';
----
4

# ---- two-level nesting ----
statement ok
ALTER TABLE w.main.t ADD COLUMN s.n.y INT;

query III
SELECT id, (s).n.x, (s).n.y FROM w.main.t WHERE id IN (1, 4) ORDER BY id;
----
1	1	NULL
4	4	NULL

statement ok
INSERT INTO w.main.t VALUES (5, {'a': 50, 'n': {'x': 5, 'y': 55}, 'b': 'five'});

query II
SELECT (s).n.y, (s).b FROM w.main.t WHERE id = 5;
----
55	five

# ---- RENAME a nested field (metadata-only; mapping keeps the physical identity) ----
statement ok
ALTER TABLE w.main.t RENAME COLUMN s.a TO alpha;

query II
SELECT id, (s).alpha FROM w.main.t WHERE id IN (1, 5) ORDER BY id;
----
1	10
5	50

# ---- DROP a nested field ----
statement ok
ALTER TABLE w.main.t DROP COLUMN s.b;

query I
SELECT count(*) FROM w.main.t WHERE (s).alpha > 0;
----
5

statement error
SELECT (s).b FROM w.main.t;
----

# ---- DML on the evolved table (the reconciled read feeds the DV/rewrite paths) ----
statement ok
DELETE FROM w.main.t WHERE (s).n.x = 2;

statement ok
UPDATE w.main.t SET id = id + 100 WHERE (s).n.y = 55;

query II
SELECT count(*), max(id) FROM w.main.t;
----
4	105

# ---- durability across re-attach ----
statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/nested' AS w2 (TYPE arrownet, PROVIDER 'delta');

query II
SELECT count(*), count((s).n.y) FROM w2.main.t;
----
4	1

# ---- native_read over the evolved mixed-vintage table (per-file presence probe: files predating an
#      added column/member read it as a typed NULL through DuckDB's own parquet reader) ----
statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/nested' AS nr (TYPE arrownet, PROVIDER 'delta', native_read true);

query II
SELECT count(*), count((s).n.y) FROM nr.main.t;
----
4	1

query II
SELECT id, (s).alpha FROM nr.main.t WHERE (s).n.y IS NOT NULL ORDER BY id;
----
105	50

# a member predicate over old files (backfilled NULLs) is exact
query I
SELECT count(*) FROM nr.main.t WHERE (s).n.y IS NULL;
----
3

# ---- native_read + TOP-LEVEL add on an unmapped table (the presence probe covers both modes/levels) ----
statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/toplevel' AS tw (TYPE arrownet, PROVIDER 'delta', column_mapping 'none');

statement ok
CREATE TABLE tw.main.t AS SELECT 1 AS id, {'a': 10} AS s;

statement ok
ALTER TABLE tw.main.t ADD COLUMN extra VARCHAR;

statement ok
ALTER TABLE tw.main.t ADD COLUMN s.b INT;

statement ok
INSERT INTO tw.main.t VALUES (2, {'a': 20, 'b': 22}, 'x');

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/toplevel' AS tn (TYPE arrownet, PROVIDER 'delta', column_mapping 'none', native_read true);

query IIII
SELECT id, (s).a, (s).b, extra FROM tn.main.t ORDER BY id;
----
1	10	NULL	NULL
2	20	22	x

# ---- guards ----
# unmapped table: ADD works (backfill), RENAME/DROP of a nested field are cleanly rejected
statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/plainnested' AS p (TYPE arrownet, PROVIDER 'delta', column_mapping 'none');

statement ok
CREATE TABLE p.main.t AS SELECT 1 AS id, {'a': 10} AS s;

statement ok
ALTER TABLE p.main.t ADD COLUMN s.b VARCHAR;

query II
SELECT (s).a, (s).b FROM p.main.t;
----
10	NULL

statement error
ALTER TABLE p.main.t RENAME COLUMN s.a TO alpha;
----
requires column mapping

statement error
ALTER TABLE p.main.t DROP COLUMN s.a;
----
requires column mapping

# a nested add must be nullable-compatible: adding to a non-struct errors cleanly
statement error
ALTER TABLE p.main.t ADD COLUMN id.sub INT;
----
is not a STRUCT column

# unknown path segment
statement error
ALTER TABLE p.main.t ADD COLUMN nope.sub INT;
----

# duplicate member
statement error
ALTER TABLE p.main.t ADD COLUMN s.a INT;
----
already exists

# struct-typed field additions are rejected on a MAPPING table (descendants would need ids)
statement error
ALTER TABLE w.main.t ADD COLUMN s.deep STRUCT(q INT);
----
not supported

# ...but allowed on a plain table
statement ok
ALTER TABLE p.main.t ADD COLUMN s.deep STRUCT(q INT);

statement ok
INSERT INTO p.main.t VALUES (2, {'a': 20, 'b': 'x', 'deep': {'q': 7}});

query III
SELECT id, (s).deep.q, (s).b FROM p.main.t ORDER BY id;
----
1	NULL	NULL
2	7	x
