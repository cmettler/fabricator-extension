# name: test/verify_functions.test
# description: fabricator_functions(catalog) discovers SQL Server routines (scalar/table UDFs, procs)
# group: [mssql]

require fabricator

require-env MSSQL_TESTDB_DSN

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS fdb (TYPE fabricator);

# A scalar UDF and an inline table-valued UDF to discover.
statement ok
SELECT fabricator_exec('fdb', 'CREATE OR ALTER FUNCTION dbo.vf_add(@a INT, @b INT) RETURNS INT AS BEGIN RETURN @a + @b END');

statement ok
SELECT fabricator_exec('fdb', 'CREATE OR ALTER FUNCTION dbo.tvf_one(@n INT) RETURNS TABLE AS RETURN (SELECT @n AS value)');

# Discovery: kind + param_count for both (ordered by name).
query TTI
SELECT name, kind, param_count FROM fabricator_functions('fdb')
WHERE schema_name = 'dbo' AND name IN ('vf_add', 'tvf_one') ORDER BY name;
----
tvf_one	table	1
vf_add	scalar	2

# Scalar return type is surfaced.
query T
SELECT return_type FROM fabricator_functions('fdb') WHERE schema_name = 'dbo' AND name = 'vf_add';
----
int

statement ok
SELECT fabricator_exec('fdb', 'DROP FUNCTION IF EXISTS dbo.vf_add');

statement ok
SELECT fabricator_exec('fdb', 'DROP FUNCTION IF EXISTS dbo.tvf_one');

# ── The fabric_* set is NOT advertised on a non-Fabric SQL Server ────────────────────────────────
# The catalog-bound Fabric REST functions are registered only when the attach targets Fabric (host
# *.fabric.microsoft.com), mirroring the Delta catalog's IsOneLake gate: off Fabric they have no
# workspace, no item and no REST endpoint, so advertising them would put functions in the catalog
# that can only fail. See docs/fabric-api-functions.md §9h.
#
# The cf_* count on the next assertion is the POSITIVE CONTROL and is the point of it: a zero for
# the Fabric set proves "not advertised" only if some custom function IS advertised through the
# same path. Without it this section would pass just as happily against a catalog that registered
# nothing at all.
query I
SELECT count(*) > 0 FROM duckdb_functions()
WHERE database_name = 'fdb' AND function_name LIKE 'cf\_%' ESCAPE '\';
----
true

# ⚠ KEYED ON THE SCHEMA, NOT ON A NAME PREFIX. This read `function_name LIKE 'fabric\_%'` while the
# functions were named fabric_*; once they moved into the `fabric` SCHEMA and dropped the prefix,
# that pattern matched NOTHING whether or not the set was registered — vacuously green. The schema
# is also the truer assertion: SqlServerBackend.SchemasMetadata only unions the synthetic name in on
# a Fabric endpoint, and without it the host drops every declared function silently.
query I
SELECT count(*) FROM duckdb_functions()
WHERE database_name = 'fdb' AND schema_name = 'fabric';
----
0

# ── THE PER-ROW `_each` FORM IS DECLARED BY THE PROVIDER, NOT INVENTED BY THE HOST ───────────────
# The host used to synthesise `<name>_each` for EVERY table-kind function of EVERY provider. That made
# a SQL-Server semantic (CROSS APPLY / per-row EXEC) the host's business, and produced entries that
# could only fail wherever there is nothing to apply per row — 30 dead siblings on a Fabric attach,
# all advertised in duckdb_functions(). SqlServerBackend's discovery SQL now emits them itself.
statement ok
SELECT fabricator_exec('fdb', 'CREATE OR ALTER FUNCTION dbo.tf_each_probe(@n INT) RETURNS TABLE AS RETURN (SELECT @n AS v)');

statement ok
SELECT fabricator_refresh_cache('fdb');

# Declared as an ordinary in-out function alongside the routine itself.
query TT
SELECT name, kind FROM fabricator_functions('fdb') WHERE name LIKE 'tf_each_probe%' ORDER BY name;
----
tf_each_probe	table
tf_each_probe_each	inout

# …and it still APPLIES the routine once per input row.
query II
SELECT n, v FROM fdb.dbo.tf_each_probe_each((SELECT * FROM (VALUES (7),(9)) t(n))) ORDER BY n;
----
7	7
9	9

# NO DEAD SIBLINGS. A C#-authored custom table function has nothing to apply per input row, so it must
# get no `_each` at all. The cf_* count above is the positive control for this one: those functions ARE
# registered, so a zero here means "not synthesised" rather than "nothing loaded".
query I
SELECT count(*) FROM duckdb_functions()
WHERE database_name = 'fdb' AND function_name LIKE 'cf%\_each' ESCAPE '\';
----
0

statement ok
SELECT fabricator_exec('fdb', 'DROP FUNCTION IF EXISTS dbo.tf_each_probe');

statement ok
DETACH fdb;

# ── Provider-declared catalog-bound VIEWS reach a SECOND provider ───────────────────────────────
# verify_views_catalog.test carries the mechanism, hermetically, on the Delta provider. What is
# asserted HERE is the one thing that suite structurally cannot: that a different backend's
# declarations arrive too — SqlServerBackend.GetViews, into a DISCOVERED schema (dbo) rather than
# through Delta's `__all__` sentinel expansion.
#
# ⚠ The catalog-bound MACRO beside it (cm_pct) is gated NOWHERE, which is how this gap arose in the
# first place: a declaration surface that only ever ships on one provider looks covered.
#
# ⚠ The section above DETACHes, so this re-attaches. That is not bookkeeping: without a live catalog
# every assertion below would pass or fail for a reason that has nothing to do with views — the
# bare-name refusal at the end most of all, which would then merely be asserting that nothing is
# attached.
statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS fdb (TYPE fabricator);

query II
SELECT schema_name, view_name FROM duckdb_views() WHERE database_name = 'fdb' ORDER BY view_name;
----
dbo	cv_info

query II
SELECT provider, kind FROM fdb.dbo.cv_info;
----
fabricator	sqlserver

# It is a VIEW to every catalog surface, not a table — which is what a tool enumerating the catalog
# reads, and the reason a view is worth more than a zero-argument SQL-generating function.
query I
SELECT table_type FROM information_schema.tables WHERE table_catalog = 'fdb' AND table_name = 'cv_info';
----
VIEW

# ⚠ NOT callable under its bare name: the assertion that separates catalog-bound from anything
# registered globally. Without it a regression that put these in the system catalog would pass
# everything above.
statement error
SELECT * FROM cv_info;
----
does not exist

# ============================================================================
# CATALOG-BOUND ROW-MAPPED (correlated LATERAL) functions — `kind='lateral'`, resolved through
# SqlServerCatalog.LateralBind. The declaration surface for the SECOND provider, gated for the same
# reason as the views above: the host machinery is proved hermetically by verify_lateral, and this is
# the only place that proves a CATALOG's declarations arrive and resolve.
#
# The spelling is what makes the kind worth having: `FROM t, db.dbo.cf_lat_split(t.txt, ',')` — a
# table-in-out cannot be written that way at all, because its input is a declared {TABLE} parameter and
# so must be a relation the caller can name.
# ============================================================================

query I
SELECT count(*) FROM duckdb_functions()
WHERE database_name = 'fdb' AND function_name = 'cf_lat_split' AND function_type = 'table';
----
1

statement ok
CREATE TEMP TABLE lat_src AS SELECT * FROM (VALUES (1, 'a,b,c'), (2, 'x'), (3, NULL)) v(id, txt);

# Fan-out, with the correlated column stamped per emitted fragment — and a NULL row contributing nothing.
query III
SELECT s.id, p.part, p.idx FROM lat_src s, fdb.dbo.cf_lat_split(s.txt, ',') p ORDER BY ALL;
----
1	a	0
1	b	1
1	c	2
2	x	0

# The literal shape binds the same declaration.
query II
SELECT part, idx FROM fdb.dbo.cf_lat_split('p,q', ',') ORDER BY ALL;
----
p	0
q	1

# Both execution paths agree — the reference oracle, on the catalog path this time.
statement ok
SET fabricator_batched_lateral = false;

query III
SELECT s.id, p.part, p.idx FROM lat_src s, fdb.dbo.cf_lat_split(s.txt, ',') p ORDER BY ALL;
----
1	a	0
1	b	1
1	c	2
2	x	0

statement ok
SET fabricator_batched_lateral = true;

# ⚠ NOT callable under its bare name. Without this the assertions above would pass equally if the
# function had been registered globally, which is a different feature with a different scope.
statement error
SELECT * FROM cf_lat_split('a,b', ',');
----
does not exist
