# name: test/verify_ducklake_mssql.test
# description: DuckLake with its metadata in SQL Server, seen from two catalogs at once. Two ATTACHes of the
#   same metadata are independent catalogs, the way two processes are: each takes its own table list at
#   ATTACH. DuckLake creates helper tables lazily (ducklake_inlined_data_<t>_<v> per schema version,
#   ducklake_inlined_delete_<id> on the first delete of a flushed row) and asks for them by name. A catalog
#   that answered "does not exist" for a name missing from its ATTACH-time list made the second catalog read
#   deleted rows as live and updated rows twice, with no error (docs/ducklake-catalog.md §11.8).
# group: [fabricator]

require fabricator

require ducklake

require parquet

require-env MSSQL_TESTDB_DSN

require-env FABRICATOR_DELTA_WRITE_DIR

# The metadata lives in its own schema of TestDB. It is dropped first, so every helper table below is
# created AFTER the second ATTACH on every run; on a leftover schema the test would pass without
# exercising anything.
statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS db (TYPE fabricator);

statement ok
SELECT fabricator_exec('db', 'DECLARE @s nvarchar(max) = N''''; SELECT @s += N''DROP TABLE [dl_mssql].'' + QUOTENAME(name) + N'';'' FROM sys.tables WHERE schema_id = SCHEMA_ID(''dl_mssql''); EXEC(@s); IF SCHEMA_ID(''dl_mssql'') IS NOT NULL DROP SCHEMA dl_mssql;');

statement ok
DETACH db;

statement ok
ATTACH 'ducklake:fabricator:${MSSQL_TESTDB_DSN}' AS lk1 (DATA_PATH '{FABRICATOR_DELTA_WRITE_DIR}/dl/', METADATA_SCHEMA 'dl_mssql', META_HIDDEN_ROWID true, DATA_INLINING_ROW_LIMIT 1000);

statement ok
CREATE TABLE lk1.t (id INTEGER, v VARCHAR);

statement ok
ATTACH 'ducklake:fabricator:${MSSQL_TESTDB_DSN}' AS lk2 (DATA_PATH '{FABRICATOR_DELTA_WRITE_DIR}/dl/', METADATA_SCHEMA 'dl_mssql', META_HIDDEN_ROWID true, DATA_INLINING_ROW_LIMIT 1000);

# ============================================================================
# 1. Inlined rows written through lk1. (The first inlined-data table is created with the table, before lk2
#    attached, so this section passes even with a stale list; sections 2 and 3 are the ones that do not.)
# ============================================================================

statement ok
INSERT INTO lk1.t SELECT i, 'b' FROM range(10) r(i);

query II
SELECT count(*), sum(id) FROM lk2.t;
----
10	45

# ============================================================================
# 2. A schema change through lk1 gives the table a new inlined-data table (one per schema version).
# ============================================================================

statement ok
ALTER TABLE lk1.t ADD COLUMN w INTEGER;

statement ok
INSERT INTO lk1.t VALUES (20, 'n', 5);

query IIII
SELECT count(*), sum(id), max(w), count(w) FROM lk2.t;
----
11	65	5	1

# ============================================================================
# 3. Flush, then delete and update a flushed row through lk1. The delete creates
#    ducklake_inlined_delete_<id>, which lk2 has never listed. This is the shape that read 11 rows.
# ============================================================================

statement ok
CALL ducklake_flush_inlined_data('lk1', table_name => 't');

query I
SELECT count(*) FROM lk2.t;
----
11

statement ok
DELETE FROM lk1.t WHERE id = 1;

statement ok
UPDATE lk1.t SET v = 'u' WHERE id = 2;

# Positive control: the helper table really exists on the server now, and the lk1 side is right.
query I
SELECT count(*) FROM lk1.t;
----
10

query IIII
SELECT count(*), count(DISTINCT id), sum(id), string_agg(v, ',' ORDER BY id) FILTER (id IN (2, 3)) FROM lk2.t;
----
10	10	64	u,b

# ============================================================================
# 4. Writes through lk2, which still has an old table list, land correctly for lk1.
# ============================================================================

statement ok
DELETE FROM lk2.t WHERE id = 3;

statement ok
UPDATE lk2.t SET v = 'x' WHERE id = 4;

query IIII
SELECT count(*), count(DISTINCT id), sum(id), string_agg(v, ',' ORDER BY id) FILTER (id IN (4, 5)) FROM lk1.t;
----
9	9	61	x,b

statement ok
DETACH lk2;

statement ok
DETACH lk1;
