# name: test/verify_delta_catalog_native_read.test
# description: Delta folder-catalog `native_read true` (docs/multifile-delta.md slice 1e) — a plain SELECT reads
#              the data files through DuckDB's NATIVE parquet reader (Host.Query over the exact active file set)
#              instead of engineered-wood's C# reader. Opt-in, read-only: rowid DML, time travel, and DV tables
#              transparently fall back to the C# reader (verified here to stay correct). Byte-source switch only —
#              writes/DDL/DML are unchanged. Set ARROWNET_DELTA_WRITE_DIR (writable). Local FS.
# group: [mssql_net]

require mssql_net

require parquet

require-env ARROWNET_DELTA_WRITE_DIR

statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/catnative' AS lake (TYPE arrownet, PROVIDER 'delta', native_read true);

# CREATE + INSERT use the ordinary C# bulk write path (native_read only affects reads).
statement ok
CREATE TABLE lake.main.t AS SELECT i AS id, 'v' || i AS name, i * 1.5 AS amt FROM range(1, 6) AS r(i);

# Plain SELECT now sourced by DuckDB's native parquet reader (read_parquet over the active files).
query ITR
SELECT id, name, amt FROM lake.main.t ORDER BY id;
----
1	v1	1.5
2	v2	3.0
3	v3	4.5
4	v4	6.0
5	v5	7.5

# Projection (DuckDB projects above the native scan).
query I
SELECT id FROM lake.main.t ORDER BY id;
----
1
2
3
4
5

# Filter (DuckDB re-applies above the scan).
query IT
SELECT id, name FROM lake.main.t WHERE id > 3 ORDER BY id;
----
4	v4
5	v5

# Aggregate over the native scan.
query IR
SELECT count(*), sum(amt) FROM lake.main.t;
----
5	22.5

# A second append (more files) — native read spans all active files.
statement ok
INSERT INTO lake.main.t VALUES (6, 'v6', 9.0);

query I
SELECT count(*) FROM lake.main.t;
----
6

# ---- DML still works on a native_read catalog (rowid scan falls back to the C# reader) ----
statement ok
DELETE FROM lake.main.t WHERE id = 2;

query I
SELECT count(*) FROM lake.main.t;
----
5

statement ok
UPDATE lake.main.t SET name = 'X' WHERE id = 4;

query T
SELECT name FROM lake.main.t WHERE id = 4;
----
X

# After a copy-on-write DELETE/UPDATE the table is still plain (no DV) — native read stays correct.
query IT
SELECT id, name FROM lake.main.t ORDER BY id;
----
1	v1
3	v3
4	X
5	v5
6	v6

# ---- A DV table on a native_read catalog falls back to the C# reader (still correct) ----
statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/catnativedv' AS dvlake (TYPE arrownet, PROVIDER 'delta', native_read true, deletion_vectors true);

statement ok
CREATE TABLE dvlake.main.d AS SELECT i AS id FROM range(1, 8) AS r(i);

statement ok
DELETE FROM dvlake.main.d WHERE id IN (2, 4, 6);

# The scan sees a DV → native path declines → C# reader honors the DV.
query I
SELECT id FROM dvlake.main.d ORDER BY id;
----
1
3
5
7

query II
SELECT count(id), sum(id) FROM dvlake.main.d;
----
4	16

# ---- Time travel via the native reader (AT VERSION resolves the snapshot; read_parquet reads those files) ----
statement ok
ATTACH '${ARROWNET_DELTA_WRITE_DIR}/catnativett' AS ttlake (TYPE arrownet, PROVIDER 'delta', native_read true);

# Empty CREATE = commit v0; each INSERT is its own commit (v1, v2, v3).
statement ok
CREATE TABLE ttlake.main.t (id INTEGER);

statement ok
INSERT INTO ttlake.main.t VALUES (1);

statement ok
INSERT INTO ttlake.main.t VALUES (2);

statement ok
INSERT INTO ttlake.main.t VALUES (3);

# Latest = all three rows.
query I
SELECT count(*) FROM ttlake.main.t;
----
3

# AT (VERSION => 0) = the empty CREATE commit (0 rows).
query I
SELECT count(*) FROM ttlake.main.t AT (VERSION => 0);
----
0

# AT (VERSION => 1) = only the first insert.
query I
SELECT id FROM ttlake.main.t AT (VERSION => 1) ORDER BY id;
----
1

# AT (VERSION => 2) = the first two inserts.
query I
SELECT count(*) FROM ttlake.main.t AT (VERSION => 2);
----
2

# ---- Snapshot pinning: an explicit transaction reads a consistent, pinned version across statements ----
statement ok
BEGIN TRANSACTION;

query I
SELECT count(*) FROM ttlake.main.t;
----
3

# A second scan in the SAME transaction reads the same pinned version.
query I
SELECT sum(id) FROM ttlake.main.t;
----
6

statement ok
COMMIT;
