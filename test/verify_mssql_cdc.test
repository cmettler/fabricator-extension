# name: test/verify_mssql_cdc.test
# description: the db.cdc.* surface over SQL Server change data capture — slices 1-3 (inspect, set up, read)
# group: [fabricator]
#
# Slices 1-3 of docs/mssql-cdc.md: the ServerProfile.SupportsCdc gate, the appended `cdc` schema, the four
# read-only functions (§1-§8), the four setup functions and the ABI v81 flag they exercise (§10-§14), and
# THE READER, cdc.changes (§15-§21), slice 4 - the generated capture-instance name, the ownership marker
# and enable := true (§22-§25) - slice 5, _capture_instance and the in-window DDL check (§26-§27) - and
# slice 7, the two-instance boundary read as ONE stream (§28) - and slice 8, the initial-snapshot leg
# and the handoff it hands back (§29).
#
# ⚠ SERVICE TIER — it needs a real SQL Server, and unlike the rest of that tier it also needs SQL SERVER
#   AGENT (docker-compose sets MSSQL_AGENT_ENABLED=true). §8's agent assertion is the ONLY thing in either
#   CI tier that would notice a revert of that compose change.
#
# ⚠ IT ENABLES AND DISABLES CDC ON TestDB. Section 9's teardown is load-bearing, not tidiness: a
#   CDC-enabled table left behind keeps the capture job scanning between runs, and §3's "max_position() IS NULL"
#   would then fail on the NEXT run for a reason that has nothing to do with the code. The idempotent
#   pre-teardown in §0 is what recovers from a run that died before reaching §9.
#
# ⚠ WHAT THIS SUITE DOES *NOT* COVER, said rather than implied. Every item is a degrade-to-unknown fallback
#   that this rig cannot reach:
#     * the Azure SQL Database branch of health()'s agent probe (edition 5 — CDC works, no agent, and
#       sys.dm_server_services does not exist). Needs a live Azure SQL Database; §0.1 of the design note
#       records it as unmeasured.
#     * health()'s "no VIEW SERVER STATE" answer — the rig authenticates as `sa`. Same structural blindness
#       as the SqlClient Entra finding: a least-privilege reader is exercised nowhere here.
#     * a capture instance whose NAME collides with some table's `schema.table` spelling (min_position's
#       "matches both kinds" refusal). Arrangeable in principle, and it needs a capture instance deliberately
#       misnamed; the two-instance refusal in §7 covers the case that actually happens.
#     * a malformed LSN or timestamp from the server (ParseHex / ParseTimestampMicros returning null) —
#       SQL Server's CONVERT always renders these well-formed.
#     * THE READER'S DECLARED NULLABILITY. cdc.changes takes each source column's nullability from the
#       SOURCE table, because the change table reports a NOT NULL primary key as nullable (§1.2) — and
#       MEASURED 2026-08-24 that DuckDB DROPS the declaration in every direction reachable from SQL:
#       DESCRIBE over the function, a CTAS from it, and duckdb_columns() over that table all report every
#       column nullable, including _change_type, which is declared NOT NULL. §16 records it; nothing here
#       can assert it, and §16's DESCRIBE section says so rather than implying it does.
#     * A CAPTURED COLUMN'S TYPE CHANGING BETWEEN BIND AND EXECUTE. The reader refuses loudly rather than
#       converting — SQL Server's capture job propagates an ALTER COLUMN to the change table
#       ASYNCHRONOUSLY (§15.6, MEASURED) — but producing the race needs the job to act inside one
#       statement's lifetime, which no suite can arrange. §15.13's one open number is that window's width.

require fabricator

require-env MSSQL_TESTDB_DSN

require-env MSSQL_BINCOLL_DSN

# ═══ §0  Recover from a previous crashed run ═══════════════════════════════════════════════════════════
# sp_cdc_disable_db drops EVERY capture instance in the database, so this one statement is a complete
# teardown. ⚠ Nothing here may name a cdc.* object: a batch that references a nonexistent object fails at
# COMPILE, so an `IF ... cdc.change_tables` guard would break precisely in the case it exists to handle.

# ⚠ THE TEARDOWN MUST RUN BEFORE THE ATTACH, and getting that wrong is how this section first passed while
# asserting nothing: catalog discovery happens AT attach, so a `c0` attached first reports the objects a
# previous run left behind whatever the teardown then does. Hence a raw connection string here —
# fabricator_exec accepts one, so it needs no catalog to exist yet.
#
# ⚠⚠ THE RETRY IS NOT DEFENSIVE PADDING — sp_cdc_disable_db CONTENDS FOR THE SINGLE PER-DATABASE LOG-SCAN
# SESSION and fails hard when the capture job holds it. OBSERVED ONCE in this suite:
#   22896 sp_cdc_disable_db caught an exception ... 22831 ... 'sys.sp_repldone NULL, NULL, 0, 0, 1, 0, 0'
#   ... 22912 'sp_repldone failed'
# That is the same contention docs/mssql-cdc.md §10.2 records for sp_cdc_scan (sp_replcmds), on an operation
# the design note did not anticipate. ⚠ Could NOT be forced deterministically (0 failures in 5 iterations
# that enabled, inserted, waited 7 s for the job to be actively scanning, then disabled), so this is
# insurance against a rare race rather than a fix for a reproducible one.
#
# ⚠ And the obvious alternative — stop the capture job first, which is what §10.2 recommends — DOES NOT WORK
# HERE. MEASURED: when the job is not yet running, sp_cdc_stop_job's refusal is raised by the SQL Server
# Agent proxy, T-SQL BEGIN TRY/END CATCH does NOT catch it, and it escapes through fabricator_exec as
# `22022 SqlException`. So it cannot be made tolerant, and the suite enables capture immediately before —
# exactly the window where the job has not started. The retry needs no such guard.
statement ok
SELECT fabricator_exec('${MSSQL_TESTDB_DSN}', 'DECLARE @t int = 0; WHILE @t < 10 BEGIN SET @t = @t + 1; BEGIN TRY IF EXISTS (SELECT 1 FROM sys.databases WHERE database_id = DB_ID() AND is_cdc_enabled = 1) EXEC sys.sp_cdc_disable_db; BREAK; END TRY BEGIN CATCH IF @t >= 10 THROW; WAITFOR DELAY ''00:00:01''; END CATCH END');

statement ok
SELECT fabricator_exec('${MSSQL_TESTDB_DSN}', 'IF OBJECT_ID(''dbo.cdc_probe'') IS NOT NULL DROP TABLE dbo.cdc_probe;');

statement ok
SELECT fabricator_exec('${MSSQL_TESTDB_DSN}', 'IF OBJECT_ID(''dbo.cdc_setup'') IS NOT NULL DROP TABLE dbo.cdc_setup;');

statement ok
SELECT fabricator_exec('${MSSQL_TESTDB_DSN}', 'IF OBJECT_ID(''dbo.cdc_zz_noidx'') IS NOT NULL DROP TABLE dbo.cdc_zz_noidx;');

statement ok
SELECT fabricator_exec('${MSSQL_TESTDB_DSN}', 'IF OBJECT_ID(''dbo.cdc_snap'') IS NOT NULL DROP TABLE dbo.cdc_snap; IF OBJECT_ID(''dbo.cdc_seed'') IS NOT NULL DROP TABLE dbo.cdc_seed; IF OBJECT_ID(''dbo.cdc_void'') IS NOT NULL DROP TABLE dbo.cdc_void; IF OBJECT_ID(''dbo.cdc_img'') IS NOT NULL DROP TABLE dbo.cdc_img; IF OBJECT_ID(''dbo.cdc_when'') IS NOT NULL DROP TABLE dbo.cdc_when; IF OBJECT_ID(''dbo.cdc_rs'') IS NOT NULL DROP TABLE dbo.cdc_rs; IF OBJECT_ID(''dbo.cdc_rsx'') IS NOT NULL DROP TABLE dbo.cdc_rsx; IF OBJECT_ID(''dbo.cdc_lg'') IS NOT NULL DROP TABLE dbo.cdc_lg; IF OBJECT_ID(''dbo.cdc_fn'') IS NOT NULL DROP TABLE dbo.cdc_fn; IF OBJECT_ID(''dbo.cdc_nk'') IS NOT NULL DROP TABLE dbo.cdc_nk;');

statement ok
SELECT fabricator_exec('${MSSQL_TESTDB_DSN}', 'IF OBJECT_ID(''dbo.cdc_gen'') IS NOT NULL DROP TABLE dbo.cdc_gen; IF OBJECT_ID(''dbo.cdc_own'') IS NOT NULL DROP TABLE dbo.cdc_own; IF OBJECT_ID(''dbo.cdc_auto'') IS NOT NULL DROP TABLE dbo.cdc_auto; IF OBJECT_ID(''dbo.cdc_ddl'') IS NOT NULL DROP TABLE dbo.cdc_ddl; IF OBJECT_ID(''dbo.gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg'') IS NOT NULL DROP TABLE dbo.gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg;');

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS c0 (TYPE fabricator);

# ═══ §1  The gate is a CAPABILITY, and it is observable ════════════════════════════════════════════════
# supports_cdc is derived from the profile, never probed. It is surfaced through fabricator_server_info
# because that is the ONLY thing a user on a warehouse engine can read — there the functions below do not
# exist at all, which is what makes it impossible to issue a CDC statement on such an engine.

query II
SELECT property, value FROM fabricator_server_info('c0') WHERE property IN ('is_warehouse', 'supports_cdc') ORDER BY property;
----
is_warehouse	false
supports_cdc	true

# ═══ §2  With CDC NOT enabled the `cdc` schema is APPENDED, so the surface is reachable ════════════════
# This is the case the append exists for. The host silently DROPS a declared function whose schema it never
# registered, so without the append the enable functions of slice 2 would be unreachable exactly when they
# are needed — no error, just missing.

query I
SELECT count(*) FROM duckdb_schemas() WHERE database_name = 'c0' AND schema_name = 'cdc';
----
1

# ⚠ POSITIVE CONTROL for the assertion above: the schema really is SYNTHETIC here — SQL Server has no `cdc`
# schema yet, so nothing was discovered under it. Without this row, "the schema is present" would pass
# equally on a build that never appends anything, against a server that happened to have CDC on.
query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'c0' AND schema_name = 'cdc';
----
0

# ⚠ Filtered to OUR four names on purpose. Once CDC is enabled, SQL Server's own per-instance TVFs also live
# in this schema — and this provider declares a `<routine>_each` sibling for every discovered TVF that takes
# parameters, so each capture instance contributes FOUR entries
# (fn_cdc_get_{all,net}_changes_<inst>{,_each}). An unfiltered count would therefore be a function of how
# many tables happen to be captured, which is not what this section is about.
query II
SELECT function_name, function_type FROM duckdb_functions() WHERE database_name = 'c0' AND schema_name = 'cdc' AND function_name IN ('max_position', 'min_position', 'tables', 'health') ORDER BY function_name;
----
health	table
max_position	scalar
min_position	scalar
tables	table

# ═══ §2b  The filters: `cdc` is appended OUTSIDE schema_filter, and function_filter still governs ══════
# The design states both and nothing asserted either. The split matters because deleting the whole CDC
# surface when someone narrowed which TABLES they wanted would be a surprising coupling — function_filter is
# the option that exists for functions, and it is deliberately still honoured here.

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS cf (TYPE fabricator, schema_filter 'nothing_matches_this');

query I
SELECT count(*) FROM duckdb_schemas() WHERE database_name = 'cf' AND schema_name = 'cdc';
----
1

# …and the functions are reachable through it, so the append is not a bare name.
query I
SELECT cf.cdc.max_position() IS NULL;
----
true

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS ff (TYPE fabricator, function_filter 'nothing_matches_this');

# The schema survives (it is not function-scoped)…
query I
SELECT count(*) FROM duckdb_schemas() WHERE database_name = 'ff' AND schema_name = 'cdc';
----
1

# …while the FUNCTIONS are filtered out, which is the half a caller can control.
query I
SELECT count(*) FROM duckdb_functions() WHERE database_name = 'ff' AND schema_name = 'cdc';
----
0

statement ok
DETACH cf;

statement ok
DETACH ff;

# ═══ §3  NULL is a STATE, not a failure — and the raw engine function RAISES here ══════════════════════

query I
SELECT c0.cdc.max_position() IS NULL;
----
true

query I
SELECT count(*) FROM c0.cdc.tables();
----
0

query II
SELECT property, value FROM c0.cdc.health() WHERE property IN ('cdc_enabled', 'captured_instances') ORDER BY property;
----
captured_instances	0
cdc_enabled	false

# ⚠⚠ THE POSITIVE CONTROL THAT MAKES §3 MEAN SOMETHING, and the mutant that kills the whole section: the
# underlying function does NOT return NULL with CDC disabled, it raises 208 naming `cdc.lsn_time_mapping` —
# an object the caller never mentioned. Remove the is_cdc_enabled guard from CdcMaxLsn and the three
# assertions above become this error. Without this row they would be equally true of a server that simply
# answers NULL, i.e. they would assert nothing about our guard.
statement error
SELECT * FROM fabricator_query('${MSSQL_TESTDB_DSN}', 'SELECT sys.fn_cdc_get_max_lsn() AS l');
----
Invalid object name 'cdc.lsn_time_mapping'

# The refusal that can ONLY be tested before CDC is enabled: "this database has no CDC" and "this table is
# not captured" have different remedies, so the message must not conflate them.
statement error
SELECT c0.cdc.min_position('dbo.cdc_probe');
----
change data capture is not enabled on database

# ═══ §4  Enable CDC and capture a table ═══════════════════════════════════════════════════════════════

statement ok
SELECT fabricator_exec('c0', 'CREATE TABLE dbo.cdc_probe(id INT NOT NULL PRIMARY KEY, v NVARCHAR(20) NULL);');

statement ok
SELECT fabricator_exec('c0', 'EXEC sys.sp_cdc_enable_db;');

statement ok
SELECT fabricator_exec('c0', 'EXEC sys.sp_cdc_enable_table @source_schema=N''dbo'', @source_name=N''cdc_probe'', @role_name=NULL;');

# A FRESH attach, because enabling capture is a DDL that creates objects and this catalog's discovery ran
# before it. (Making the enable path invalidate the cache itself is slice 2's job — it is what stops a user
# having to know that enabling capture creates a schema and two table functions.)
statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS c1 (TYPE fabricator);

# The `cdc` schema is now REAL, and the append must not advertise a DUPLICATE — the host's ensure_schema
# treats one as a collision rather than a merge.
query I
SELECT count(*) FROM duckdb_schemas() WHERE database_name = 'c1' AND schema_name = 'cdc';
----
1

# …and it now holds SQL Server's own metadata tables plus the change table: the discriminator against §2's
# synthetic case. A floor rather than an exact count, so a future engine adding a metadata table does not
# fail a suite that is not about that.
query I
SELECT count(*) >= 6 FROM duckdb_tables() WHERE database_name = 'c1' AND schema_name = 'cdc';
----
true

# ═══ §5  cdc.tables() reports the capture INSTANCE and its captured columns ════════════════════════════
# One row per capture instance, not per table — a table may have two (§2.2). captured_column_list is how a
# caller sees which columns are captured, and the column set is fixed at enable time.

query IIII
SELECT source_schema, source_table, capture_instance, captured_column_list FROM c1.cdc.tables();
----
dbo	cdc_probe	dbo_cdc_probe	[id], [v]

# ⚠ THE TYPED COLUMNS ARE THE POINT OF READING THE RESULT AS STRINGS AND RE-TYPING IT, and create_date is
# the one that would fail SILENTLY: a TimestampArray.Builder built without the declared field defaults to
# MILLISECOND while the column declares MICROSECOND, and every timestamp then reads as January 1970. That
# defect shipped across 15 hand-rolled sites once because nobody looked at the times.
query II
SELECT octet_length(start_lsn), create_date > TIMESTAMP '2020-01-01' FROM c1.cdc.tables();
----
10	true

# end_lsn is NULL even once a newer instance supersedes this one (§2.2) — which is why the instance boundary
# has to be DERIVED from the newer instance's start_lsn. Pinned so a later change cannot quietly rely on it.
query I
SELECT end_lsn IS NULL FROM c1.cdc.tables();
----
true

# ═══ §6  min_position resolves BOTH spellings ══════════════════════════════════════════════════════════
# ⚠⚠ NOTHING HERE MAY DEPEND ON THE FLOOR'S VALUE, and the first version of this section did — it compared
# two calls with `IS NOT DISTINCT FROM` and FAILED 1 run in 14. The cause is the function's own behaviour,
# not ours: for an instance enabled in a database whose capture job is already running,
# fn_cdc_get_min_lsn is NULL until the job scans, and TWO CALLS IN ONE STATEMENT CAN STRADDLE THE
# NULL→value TRANSITION (measured: `min_position(x) IS NOT DISTINCT FROM min_position(x)` returned FALSE).
# A `WAITFOR DELAY` would only lengthen the window, not close it.
#
# So the resolution is proved by the ERROR BEHAVIOUR instead, which is deterministic at every instant, and
# §7 completes the proof: the table name succeeds here with one instance, ERRORS naming both once a second
# exists, and the instance name keeps working throughout. That triple pins both spellings and the
# table→instances mapping without ever reading a floor.

# Resolves, does not error — and if it has a value at all, that value is a 10-byte LSN. ONE call, so no
# transition can be straddled; coalesce makes the not-yet-established state pass rather than flake.
query I
SELECT coalesce(octet_length(c1.cdc.min_position('dbo.cdc_probe')), 10) = 10;
----
true

query I
SELECT coalesce(octet_length(c1.cdc.min_position('dbo_cdc_probe')), 10) = 10;
----
true

statement error
SELECT c1.cdc.min_position('dbo.nope');
----
is not a captured table or capture instance

# ═══ §7  Two capture instances: the fixture, and what resolution owes them ═════════════════════════
# A second instance is how a schema change is absorbed, and both capture the SAME change concurrently, so
# reading both double-counts. Their retention floors can also differ — MEASURED (0x…2C00000C980040 vs
# 0x…2D00000E900043 on one table) — so answering for either one would be a wrong answer, not a shortcut.

statement ok
SELECT fabricator_exec('c1', 'ALTER TABLE dbo.cdc_probe ADD extra INT NULL;');

statement ok
SELECT fabricator_exec('c1', 'EXEC sys.sp_cdc_enable_table @source_schema=N''dbo'', @source_name=N''cdc_probe'', @role_name=NULL, @capture_instance=N''dbo_cdc_probe_v2'';');

query I
SELECT count(*) FROM c1.cdc.tables();
----
2

# The newer instance captures the added column; the older one does not. This is what makes the boundary a
# correctness question rather than bookkeeping.
query II
SELECT capture_instance, captured_column_list FROM c1.cdc.tables() ORDER BY capture_instance;
----
dbo_cdc_probe	[id], [v]
dbo_cdc_probe_v2	[id], [v], [extra]

# ⚠ SINCE SLICE 7 THIS ANSWERS rather than refusing, and the answer is the OLDER instance's floor — the start
# of the range cdc.changes now reads as one stream across the boundary (§28). While the reader refused the
# same source, "the floor of what?" genuinely had no answer; now it does, and a caller who follows the
# retention error's own advice with the string they passed to cdc.changes gets a position rather than a
# lecture.
query I
SELECT coalesce(octet_length(c1.cdc.min_position('dbo.cdc_probe')), 10) = 10;
----
true

# ⚠ THE OTHER HALF OF §6's PROOF: naming the instance resolves the same way the table name does. Between the
# two, the table→instances mapping and the instance-name path are both pinned, with no floor VALUE read —
# §1.6a MEASURED that two calls in one statement can straddle the transient-NULL transition, so no assertion
# here may depend on what the floor is.
query I
SELECT coalesce(octet_length(c1.cdc.min_position('dbo_cdc_probe_v2')), 10) = 10;
----
true

# ═══ §8  health() answers what a silent pipeline needs ═════════════════════════════════════════════════

query II
SELECT property, value FROM c1.cdc.health() WHERE property IN ('supports_cdc', 'cdc_enabled', 'captured_instances') ORDER BY property;
----
captured_instances	2
cdc_enabled	true
supports_cdc	true

# The full row set, pinned by COUNT and ORDER. The README documents these 12 by name, and an unasserted doc
# claim is a gap — a row added or removed without updating both should fail here rather than quietly drift.
query I
SELECT count(*) FROM c1.cdc.health();
----
12

# ⚠⚠ THE ONLY ASSERTION IN EITHER CI TIER THAT WOULD NOTICE A REVERT OF `MSSQL_AGENT_ENABLED=true` in
# docker/docker-compose.yml. sp_cdc_enable_db and sp_cdc_enable_table both SUCCEED with the agent stopped —
# printing only an informational notice — so "capture is enabled" and "capture is happening" are independent
# states and the enable path reports success for both. Everything else in this suite passes with the agent
# off, which is exactly the vacuous-pass hole this row closes.
query I
SELECT value FROM c1.cdc.health() WHERE property = 'agent_status';
----
Running

# The capture job's polling interval decides how long an un-forced capture takes (~5 s on this rig). Read as
# "present" rather than as a literal, because it is rig configuration rather than our behaviour.
query I
SELECT value IS NOT NULL FROM c1.cdc.health() WHERE property = 'capture_polling_interval_seconds';
----
true

# ⚠ The row is `max_lsn_age_seconds`, deliberately NOT `capture_lag_seconds`: it is the AGE of the newest
# CAPTURED transaction, so on an idle database it grows without bound while capture is perfectly current.
# Pinned by NAME so the misleading spelling cannot come back.
query I
SELECT count(*) FROM c1.cdc.health() WHERE property = 'capture_lag_seconds';
----
0

query I
SELECT count(*) FROM c1.cdc.health() WHERE property = 'max_lsn_age_seconds';
----
1

# A catalog on a database with NO CDC, for §14's refusal. It must be a DIFFERENT DATABASE rather than another
# alias on this one: §4 enabled CDC here, so an alias would see it enabled and the refusal could not fire.
# ⚠ Reuses the BinCollTest DSN rather than hand-building one from a password variable: sqllogictest only
# substitutes ${VARS} the file DECLARES via require-env, so an undeclared one is passed through literally and
# surfaces as `18456 Login failed` — an authentication error for what is really a missing declaration.
statement ok
ATTACH '${MSSQL_BINCOLL_DSN}' AS c0_nocdc (TYPE fabricator);

# ═══ §10  SETUP (slice 2): enable_database / enable, and the ABI v81 flag they exist to exercise ═══════
# ⚠ These four sections are the ONLY coverage of tablefn_execute's schema_may_change out-param. Nothing else
#   in either tier sets it, so if they go the flag is untested.

query TTT
SELECT target, changed, detail LIKE '%capture%' FROM c1.cdc.enable_database();
----
TestDB	false	true

# Idempotent: it was already enabled by §4's fabricator_exec, so `changed` is false and the call SUCCEEDS.
# ⚠ `changed` is deliberately separate from success — an idempotent call that found the work already done
# must not look like a failure (the same distinction the plugin uninstaller draws between removed and purged).

statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.cdc_setup'') IS NOT NULL DROP TABLE dbo.cdc_setup;');

statement ok
SELECT fabricator_exec('c1', 'CREATE TABLE dbo.cdc_setup(id INT NOT NULL PRIMARY KEY, v NVARCHAR(20) NULL);');

# ⚠ AN EXPLICIT capture_instance HERE, deliberately: §11 and §17 name the objects this call creates
# (cdc.dbo_cdc_setup_CT, fn_cdc_get_all_changes_dbo_cdc_setup, min_position('dbo_cdc_setup')), and a DEFAULT
# enable now generates an OPAQUE name (fab_<16 hex>) that no assertion can spell. The generated default has
# its own coverage in §22-§25; what §10-§13 are about is the ABI v81 catalog rebuild, which naming does not
# touch.
query TT
SELECT target, changed FROM c1.cdc.enable('dbo.cdc_setup', capture_instance := 'dbo_cdc_setup');
----
dbo.cdc_setup (dbo_cdc_setup)	true

# ═══ §11  ⚠⚠ THE POINT OF ABI v81: the objects that call created are reachable in the SAME session ═════
# Without the flag this fails with `Catalog Error: Table with name dbo_cdc_setup_CT does not exist!` —
# MEASURED before the flag existed. And it is not a cosmetic "un-enumerated" problem: with no ATTACH object
# filter, a name missing from the catalog's discovered list is treated as GENUINELY ABSENT
# (fabricator_schema_entry.cpp's lookup gate), so there is no by-name fallback to save it.
#
# ⚠ NOTE WHAT IS *NOT* NEEDED HERE: no fabricator_refresh_cache, no re-ATTACH. That absence IS the assertion.
# The mutants are (a) SchemaMayChange => false and (b) moving the DDL out of the eager part of Execute() into
# the iterator body — (b) is the subtle one, because the DDL still happens and only the flag is lost.

query I
SELECT count(*) FROM c1.cdc.dbo_cdc_setup_CT;
----
0

# The per-instance TVFs the enable created are registered too — the half that has no by-name fallback at all.
query I
SELECT count(*) FROM duckdb_functions() WHERE database_name = 'c1' AND schema_name = 'cdc' AND function_name = 'fn_cdc_get_all_changes_dbo_cdc_setup';
----
1

# ═══ §12  A NAMED enable is idempotent per capture INSTANCE ═══════════════════════════════════════════
# ⚠⚠ THAT IS THE *NAMED* HALF ONLY, and the distinction is a correctness one (§23 has the other half). With
# an explicit capture_instance the guard keys on the INSTANCE, because refusing a table's legitimate SECOND
# instance would break the way a schema change is absorbed (§2.2). With NO capture_instance it keys on the
# TABLE — a default enable that silently added a second instance would make cdc.changes ambiguous for that
# table, which the reader refuses rather than resolving.

query TT
SELECT target, changed FROM c1.cdc.enable('dbo.cdc_setup', capture_instance := 'dbo_cdc_setup');
----
dbo.cdc_setup (dbo_cdc_setup)	false

# …while a DIFFERENT instance name on the same table is accepted. This is the positive control for the
# assertion above: without it, "changed = false" would pass equally on a build that refused every re-enable.
query TT
SELECT target, changed FROM c1.cdc.enable('dbo.cdc_setup', capture_instance := 'dbo_cdc_setup_v2');
----
dbo.cdc_setup (dbo_cdc_setup_v2)	true

query I
SELECT count(*) FROM c1.cdc.tables() WHERE source_table = 'cdc_setup';
----
2

# ═══ §13  disable, and the flag works in the DESTRUCTIVE direction too ═══════════════════════════════

query TT
SELECT target, changed FROM c1.cdc.disable('dbo.cdc_setup', capture_instance := 'dbo_cdc_setup_v2');
----
dbo.cdc_setup (dbo_cdc_setup_v2)	true

query I
SELECT count(*) FROM c1.cdc.tables() WHERE source_table = 'cdc_setup';
----
1

# ⚠ The v81 flag must fire on a DROP as well, or a dropped change table lingers in the catalog and a scan of
# it fails against the server instead of being absent. Nothing else in this suite covers that direction.
statement error
SELECT count(*) FROM c1.cdc.dbo_cdc_setup_v2_CT;
----
does not exist

# Disabling something that is not captured is not an error — it reports changed = false, so a teardown script
# can run unconditionally.
query TT
SELECT target, changed FROM c1.cdc.disable('dbo.nope');
----
dbo.nope (all)	false

# ═══ §14  capture_now(), and what about it is gateable ═══════════════════════════════════════════════
# ⚠⚠ ITS SUCCESS PATH IS DELIBERATELY NOT ASSERTED, and the suite says so rather than implying coverage:
# sp_cdc_scan contends with the capture job for the database's single log-scan session, so a bare assertion
# would be flaky (~1 failure in 57 attempts, MEASURED) — and stopping the job first is not an option here,
# because sp_cdc_stop_job's refusal when the job is not yet running is raised by the Agent proxy, is NOT
# catchable in T-SQL, and escapes through fabricator_exec as 22022. The translated 22903 message is therefore
# also ungated: producing it requires winning a race against a live job on demand.
#
# ⚠ The NAME is gated here too, incidentally but usefully: it shipped as cdc.scan() for one day and the first
# person to read the function list took it for the READER. The `function_name IN (...)` assertion below is what
# would fail if it ever drifted back, and the reasoning is on CdcCaptureNowFunction.
#
# What IS deterministic is the refusal on a database with no CDC, which is our own guard.
statement error
SELECT * FROM c0_nocdc.cdc.capture_now();
----
change data capture is not enabled on this database

# And that all four setup functions exist as TABLE functions. ⚠ Not `has_side_effects` — that column is NULL
# for a table function (it is a scalar-volatility concept), so asserting it would assert nothing. The reason
# these are table functions rather than scalars is that they REPORT: a scalar would have to be VOLATILE to
# avoid being constant-folded and would still be the wrong shape for a result the caller reads.
query TT
SELECT function_name, function_type FROM duckdb_functions() WHERE database_name = 'c1' AND schema_name = 'cdc' AND function_name IN ('enable', 'enable_database', 'disable', 'capture_now') ORDER BY function_name;
----
capture_now	table
disable	table
enable	table
enable_database	table

# ═══ §15  THE READER (slice 3) — cdc.changes over one capture instance ════════════════════════════════
# docs/mssql-cdc.md §15. It reads SQL Server's generated TVF, never the change table: `is_ms_shipped` splits
# the schema (the seven metadata tables, the four placeholders AND the change table are 1; the per-instance
# TVFs are the only 0s), and the TVF VALIDATES its window where a direct table read silently returns
# whatever survived.

statement ok
SELECT fabricator_exec('c1', 'INSERT INTO dbo.cdc_setup VALUES (1, N''a''), (2, N''b''), (3, N''c'');');

statement ok
SELECT fabricator_exec('c1', 'UPDATE dbo.cdc_setup SET v = N''B'' WHERE id = 2;');

statement ok
SELECT fabricator_exec('c1', 'DELETE FROM dbo.cdc_setup WHERE id = 3;');

# ⚠⚠ CAPTURE IS ASYNCHRONOUS, so the suite WAITS rather than forcing a scan. cdc.capture_now() contends with
# the capture job for the database's single log-scan session (~1 failure in 57, MEASURED) and §14 records why
# stopping the job first is not available here — so forcing would make this section flaky in exactly the way
# the wait does not. ~5 s on this rig (§8's polling interval), bounded at 60.
#
# ⚠ It waits for BOTH the rows AND the watermark. A row in the change table is not readable until
# fn_cdc_get_max_lsn() covers it, because that watermark is this reader's default window END — waiting only
# for COUNT would leave a race whose symptom is a SHORT READ, i.e. a wrong answer rather than a failure.
#
# ⚠ The UPDATE writes TWO change rows (op 3 before-image + op 4 after-image) while the reader returns ONE, so
# the change table reaches 6 where cdc.changes() reports 5. That asymmetry IS the 'after' mode.
statement ok
SELECT fabricator_exec('c1', 'DECLARE @i int = 0; WHILE @i < 60 AND NOT EXISTS (SELECT 1 FROM cdc.dbo_cdc_setup_CT HAVING COUNT(*) >= 6 AND MAX(__$start_lsn) <= sys.fn_cdc_get_max_lsn()) BEGIN WAITFOR DELAY ''00:00:01''; SET @i = @i + 1; END');

# The whole point of the feature, in one assertion. ⚠ `_change_type` deliberately reuses the DELTA
# change-feed spellings, so a consumer that already handles a Delta CDF handles this unchanged — which is
# also why op 3 and op 4 are two rows rather than one wide before/after row.
#
# ⚠ THE DELETE ROW CARRIES THE DELETED VALUES (v = 'c', not NULL). Worth pinning: a consumer building a
# tombstone needs the key, and a reader emitting NULLs there would look plausible.
query TIT
SELECT _change_type, id, v FROM c1.cdc.changes('dbo.cdc_setup') ORDER BY _position;
----
insert	1	a
insert	2	b
insert	3	c
update_postimage	2	B
delete	3	c

# The 21-byte resume position of §2.4 — start_lsn(10) ‖ seqval(10) ‖ operation(1) — whose lexicographic order
# IS the change order, which is what makes the ORDER BY above correct and the consumer's cursor ONE column.
query II
SELECT DISTINCT octet_length(_position), octet_length(_commit_lsn) FROM c1.cdc.changes('dbo.cdc_setup');
----
21	10

# ⚠ THE ENCODING ITSELF, pinned rather than described. An UPDATE pair shares a seqval and differs only in the
# operation, which is why the position is a 3-tuple and not (start_lsn, seqval) — so the last byte carrying
# the operation code is load-bearing, and this is the assertion that would fail if it were dropped or moved.
query I
SELECT DISTINCT _position = _commit_lsn || _seq_val || '\x04'::BLOB FROM c1.cdc.changes('dbo.cdc_setup') WHERE _change_type = 'update_postimage';
----
true

# ═══ §16  The DECLARED schema — captured types from a DESCRIBE of the read itself ═════════════════════
# The types come from CommandBehavior.SchemaOnly over the very statement the reader runs, through the same
# SqlArrowMapping.ToArrowField the read itself uses — so bind and execute cannot disagree through a
# hand-written type table. `id INTEGER` and `v VARCHAR` are the SOURCE column types arriving unchanged.

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM c1.cdc.changes('dbo.cdc_setup'));
----
_change_type	VARCHAR
_position	BLOB
_commit_lsn	BLOB
_seq_val	BLOB
_operation	INTEGER
_capture_instance	VARCHAR
id	INTEGER
v	VARCHAR

# ⚠⚠ WHAT THIS SECTION CANNOT ASSERT, said rather than implied: the reader declares each source column's
# nullability from the SOURCE table (§1.2 — `id INT NOT NULL PRIMARY KEY` is MEASURED NULLABLE in the change
# table, so taking it from there would report every column as optional). MEASURED 2026-08-24 that DuckDB
# DROPS the declaration in every direction reachable from SQL: DESCRIBE over the function, a CTAS from it and
# duckdb_columns() over that table ALL report `YES`/true for every column, including _change_type, which is
# declared NOT NULL. So the honest declaration costs nothing (it rides the same round trip that resolves the
# capture instance) and no assertion can see it. It becomes load-bearing when images := 'both' arrives, where
# an op-3 before-image can carry NULL for an unrecorded MAX column and the claim has to be relaxed.

# ═══ §17  The CURSOR — exclusive, and both bound lengths are legal ════════════════════════════════════
# §3.4's documented idiom stores cdc.max_position() (a 10-byte LSN) while a row carries a 21-byte _position,
# so both have to be accepted. The 10-byte form is exclusive AT LSN GRANULARITY, which is right because the
# previous window ended at that LSN INCLUSIVE.
#
# ⚠⚠ THREE SPELLINGS, AND ONLY TWO OF THEM BIND — MEASURED 2026-08-24, and this CORRECTS the idiom §3.4
# prints. An inline scalar subquery is refused as a table-function argument (§11 item 6, already known) AND
# refused as an EXECUTE argument (NEW — §3.4 shipped that half as "NOT measured"). What DOES work is a
# scalar FUNCTION CALL as an EXECUTE argument, and — better, because it reads the cursor out of a TABLE —
# SET VARIABLE plus getvariable(), which is a function call rather than a subquery at the call site.

statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_setup', starting_position := (SELECT min(_position) FROM c1.cdc.changes('dbo.cdc_setup')));
----
Table function cannot contain subqueries

statement ok
PREPARE cdc_win AS SELECT count(*) AS n FROM c1.cdc.changes('dbo.cdc_setup', starting_position := ?);

statement error
EXECUTE cdc_win((SELECT min(_position) FROM c1.cdc.changes('dbo.cdc_setup')));
----
Only scalar parameters, named parameters or NULL supported for EXECUTE

# ⚠⚠ THE 21-BYTE PATH, and the ONLY spelling that can express it from pure SQL. The three inserts share ONE
# start_lsn, so resuming after the FIRST of them must leave the other two — which a 10-byte LSN cursor
# cannot say. That is the entire reason the position is 21 bytes rather than 10.
statement ok
SET VARIABLE cdc_cur = (SELECT min(_position) FROM c1.cdc.changes('dbo.cdc_setup'));

query I
SELECT octet_length(getvariable('cdc_cur'));
----
21

query TI
SELECT _change_type, id FROM c1.cdc.changes('dbo.cdc_setup', starting_position := getvariable('cdc_cur')) ORDER BY _position;
----
insert	2
insert	3
update_postimage	2
delete	3

# ⚠ AN EXHAUSTED WINDOW IS NOT AN ERROR, and this is the assertion that says so. A polling consumer whose
# cursor sits at the window end reaches it on every quiet tick; the TVF itself answers an inverted window
# with the unattributable 313 of §18, so declining to call it is what keeps that error off a normal path.
# ⚠ A scalar function call IS legal as an EXECUTE argument where a subquery is not — MEASURED just above.
query I
EXECUTE cdc_win(c1.cdc.max_position());
----
0

# ⚠ THE POSITIVE CONTROL for the row above: the SAME prepared statement with a 10-byte cursor at the
# retention floor returns every change. Without it, "0" would pass equally on a build where the reader had
# stopped returning rows at all.
query I
EXECUTE cdc_win(c1.cdc.min_position('dbo_cdc_setup'));
----
5

# ⚠⚠ AN INVERTED WINDOW IS EMPTY, NOT AN ERROR — and this needs an EXPLICIT ending_position below the cursor,
# which is the ONLY shape that reaches that branch. Getting it wrong is recorded on the code: the branch was
# first written up as the ordinary "consumer has caught up" case, and a SURVIVING MUTANT showed that a
# caught-up consumer produces from == to (the watermark), whose rows the exclusive predicate removes in SQL.
# Without the short-circuit this is the unattributable 313 again, on a caller who merely asked for a window
# with nothing in it.
statement ok
PREPARE cdc_inverted AS SELECT count(*) AS n FROM c1.cdc.changes('dbo.cdc_setup', starting_position := ?, ending_position := ?);

query I
EXECUTE cdc_inverted(c1.cdc.max_position(), c1.cdc.min_position('dbo_cdc_setup'));
----
0

# ═══ §18  The PRE-CHECK (§2.1) — the highest-value code in this feature ═══════════════════════════════
# ⚠⚠ WHAT IT REPLACES. MEASURED, three ways, all IDENTICAL: a from_lsn below the retention floor, a to_lsn
# above the capture watermark, and an inverted window ALL raise
#   Msg 313: An insufficient number of arguments were supplied for the procedure or function
#            cdc.fn_cdc_get_all_changes_ ... .
# with three arguments supplied — and the " ... " is the LITERAL name of a placeholder function SQL Server
# calls deliberately to force that error (§15.3). So the message is the same for every capture instance and
# every cause, and can never be attributed. A pipeline that has LOST DATA is told to look at its call site.

# The one that matters: a cursor below the floor means changes have been purged, and reading anyway would
# SILENTLY SKIP them. ⚠ The message must name the LOSS, not the bound.
statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_setup', starting_position := '\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00'::BLOB);
----
BELOW the retention floor

statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_setup', starting_position := '\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00'::BLOB);
----
WOULD HAVE SILENTLY SKIPPED

statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_setup', ending_position := '\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF'::BLOB);
----
above the capture watermark

# A bound of the wrong LENGTH is refused at BIND — the earliest point the value exists, since these are
# constant arguments, so a typo costs no server round trip.
statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_setup', starting_position := '\x01\x02'::BLOB);
----
it must be either a 10-byte log sequence number

# ═══ §19  Refusals that are decisions, not gaps ══════════════════════════════════════════════════════

# ⚠ THIS WAS A REFUSAL UNTIL SLICE 7 and is now a read: two capture instances on one table BOTH capture every
# change in their overlap window (§2.2, MEASURED), so the reader splits the window at the boundary instead of
# picking one. dbo.cdc_probe has had two since §7, and the ALTER that motivated the second one is BELOW the
# boundary, so the DEFAULT on_schema_change reads it — the absorption rule, on a fixture built for the old
# refusal. §28 is where the boundary itself is pinned; this row only proves the refusal is gone.
query I
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_probe');
----
0

# …and the shape is the union of both instances: `extra` exists only in dbo_cdc_probe_v2 and is NULL-filled
# for anything the older one answers.
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM c1.cdc.changes('dbo.cdc_probe')) WHERE column_name = 'extra';
----
1

# …and naming one instance still reads THAT ONE alone, which is the escape for everything the union cannot
# represent.
#
# ⚠ on_schema_change := 'ignore' is REQUIRED here and the reason is instructive: §7 ran
# `ALTER TABLE dbo.cdc_probe ADD extra INT NULL` while dbo_cdc_probe was capturing, so a DDL sits INSIDE
# this instance's window and the DEFAULT check (§27) refuses it. That is the check working — the added
# column really is absent from what this instance captures — and it is why the row needs the opt-out rather
# than a different table.
query I
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_probe', capture_instance := 'dbo_cdc_probe', on_schema_change := 'ignore');
----
0

statement error
SELECT count(*) FROM c1.cdc.changes('dbo.no_such_table');
----
is not a captured table or capture instance

# ⚠ `images := 'both'` is IMPLEMENTED since slice 9 (§30), and this assertion moved with it rather than
# being deleted: it used to pin the "not built yet" refusal, and it now pins the mode being live on a
# DIFFERENT fixture from §30's — the extra row is the op-3 partner of this table's one update.
query II
SELECT (SELECT count(*) FROM c1.cdc.changes('dbo.cdc_setup')) AS after_rows,
       (SELECT count(*) FROM c1.cdc.changes('dbo.cdc_setup', images := 'both')) AS both_rows;
----
5	6

# ⚠ 'net' is a value this reader will NEVER have (§1.7d — the collapse is lossy, unresumable, and
# reproducible in one line of DuckDB with a MEASURED-identical outcome), and it is refused as an unknown
# value rather than named in the message, so nothing advertises a mode we decided against.
statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_setup', images := 'net');
----
is not a value

# ═══ §20  _commit_timestamp is an OPT-IN, and that is forced ═════════════════════════════════════════
# ⚠⚠ MEASURED (§11 item 2): DuckDB does NOT eliminate an unused LEFT JOIN — not even against a PRIMARY KEY —
# so "emit cdc.lsn_time_mapping always and let projection pushdown prune it" would make EVERY caller pay a
# second scan for a column most never select. It is the only output column needing that join, and it is
# metadata rather than an ordering key (datetime, ~3.33 ms), so omitting it by default loses nothing
# structural.

query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM c1.cdc.changes('dbo.cdc_setup')) WHERE column_name = '_commit_timestamp';
----
0

query II
SELECT count(*), count(_commit_timestamp) FROM c1.cdc.changes('dbo.cdc_setup', commit_timestamp := true);
----
5	5

# ═══ §21  cdc.changes is a TABLE function, and cdc.tables() no longer invents an index ════════════════

query TT
SELECT function_name, function_type FROM duckdb_functions() WHERE database_name = 'c1' AND schema_name = 'cdc' AND function_name = 'changes';
----
changes	table

# ⚠⚠ A SHIPPED DEFECT FOUND WHILE BUILDING THE READER (docs §15.14), fixed here. MEASURED through the exact
# table-variable path SqlServerCdcCatalog uses: the ALL-TABLES form of sp_cdc_help_change_data_capture LEAKS
# the PREVIOUS row's index_column_list onto a row whose index_name is NULL, so a capture instance with no
# index was reported as having one. Called for that single table the proc answers NULL correctly, which is
# what attributes it to the proc rather than to us.
statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.cdc_zz_noidx'') IS NOT NULL DROP TABLE dbo.cdc_zz_noidx; CREATE TABLE dbo.cdc_zz_noidx(a INT NULL, b NVARCHAR(10) NULL);');

statement ok
SELECT target, changed FROM c1.cdc.enable('dbo.cdc_zz_noidx');

# ⚠ THE INDEXED ROW BESIDE IT IS THE POSITIVE CONTROL, and it is also what makes the mutant DIE: the leak
# copies the PREVIOUS row's value, so an index-less instance emitted first would read NULL even unfixed. The
# table is named to sort last for that reason. The index NAME is auto-generated, so it is asserted as
# present rather than by value.
query TTT
SELECT source_table, index_name IS NOT NULL, index_column_list FROM c1.cdc.tables() WHERE source_table IN ('cdc_setup', 'cdc_zz_noidx') ORDER BY source_table;
----
cdc_setup	true	[id]
cdc_zz_noidx	false	NULL

# ═══ §22  The capture-instance name is GENERATED and HIDDEN (slice 4) ════════════════════════════════
# docs §15.4. A default cdc.enable no longer takes SQL Server's <schema>_<table>; it takes fab_<16 hex of a
# hash of schema.table> — 20 characters, whatever the table is called.

statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.cdc_gen'') IS NOT NULL DROP TABLE dbo.cdc_gen; CREATE TABLE dbo.cdc_gen(id INT NOT NULL PRIMARY KEY, v NVARCHAR(20) NULL);');

query TT
SELECT changed, target LIKE 'dbo.cdc_gen (fab_%)' FROM c1.cdc.enable('dbo.cdc_gen');
----
true	true

query IT
SELECT length(capture_instance), regexp_matches(capture_instance, '^fab_[0-9a-f]{16}$') FROM c1.cdc.tables() WHERE source_table = 'cdc_gen';
----
20	true

# The name is DETERMINISTIC — disable and re-enable the same table and it comes back identical.
# ⚠ WHAT THIS DOES *NOT* COVER, said rather than implied: the reason the generator is SHA-256 rather than
# string.GetHashCode() is that .NET randomizes string hash codes PER PROCESS. Within one process GetHashCode
# is stable, so this assertion would pass on that build too; catching it needs two processes, which
# sqllogictest does not give. What it does catch is a generator that is not a function of the name at all —
# a GUID, a timestamp, a counter.
statement ok
SET VARIABLE cdc_gen_name = (SELECT capture_instance FROM c1.cdc.tables() WHERE source_table = 'cdc_gen');

statement ok
SELECT changed FROM c1.cdc.disable('dbo.cdc_gen');

statement ok
SELECT changed FROM c1.cdc.enable('dbo.cdc_gen');

query I
SELECT capture_instance = getvariable('cdc_gen_name') FROM c1.cdc.tables() WHERE source_table = 'cdc_gen';
----
true

# ⚠⚠ THE DEFECT THIS REMOVES, and it is the reason the generated name is a fix rather than a preference.
# MEASURED: sp_cdc_enable_table's own default is <schema>_<table>, the limit is exactly 100 characters, and
# a 100-character table in dbo therefore produces a 104-character name and
#   Msg 22927 ... exceeds the length limit of 100 characters
# — so cdc.enable failed naming a capture instance the user never chose, and the only escape was the very
# knob this hides. The same table enables fine with a generated name.
statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg'') IS NOT NULL DROP TABLE dbo.gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg; CREATE TABLE dbo.gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg(id INT NOT NULL PRIMARY KEY);');

query I
SELECT changed FROM c1.cdc.enable('dbo.gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg');
----
true

# ⚠ THE POSITIVE CONTROL that the table really is at the limit — without it the row above would pass on any
# table at all, and the defect it stands for is specifically about LENGTH.
query II
SELECT length(source_table), length(capture_instance) FROM c1.cdc.tables() WHERE source_table LIKE 'gggg%';
----
100	20

# ═══ §23  A DEFAULT enable keys on the TABLE — because the reader refuses an ambiguous one ════════════
# ⚠⚠ THIS IS THE CORRECTNESS HALF OF §12. A bare cdc.enable that silently added a table's SECOND capture
# instance would make cdc.changes('<that table>') AMBIGUOUS, and the reader refuses rather than picking one
# (§2.2: both instances capture every change in the overlap window, so either answer is wrong). So the
# default enable's question is "is this table captured?", not "does this name exist?".

query TT
SELECT changed, target LIKE 'dbo.cdc_gen (fab_%)' FROM c1.cdc.enable('dbo.cdc_gen');
----
false	true

query I
SELECT count(*) FROM c1.cdc.tables() WHERE source_table = 'cdc_gen';
----
1

# …and a DIFFERENT SPELLING of the same table is still that one instance. The generated name is derived from
# the string as typed — deliberately, because normalising case would collide two genuinely different tables
# on a case-SENSITIVE collation — so this row is what proves idempotence keys on the TABLE, not on the name.
query TT
SELECT changed, target LIKE 'DBO.CDC_GEN (fab_%)' FROM c1.cdc.enable('DBO.CDC_GEN');
----
false	true

query I
SELECT count(*) FROM c1.cdc.tables() WHERE source_table = 'cdc_gen';
----
1

# ⚠ THE POSITIVE CONTROL: an EXPLICIT capture_instance still creates the second, which is how a schema change
# is absorbed. Without it, "changed = false" above would pass equally on a build that refused every enable.
query TT
SELECT target, changed FROM c1.cdc.enable('dbo.cdc_gen', capture_instance := 'cdc_gen_v2');
----
dbo.cdc_gen (cdc_gen_v2)	true

# ⚠ SINCE SLICE 7 the reader no longer REFUSES that table — it splits the window at the boundary and reads
# both instances as one stream (§28). That does not weaken the table-keyed default, it STRENGTHENS it: a bare
# enable that silently added a second instance used to make cdc.changes('<that table>') fail LOUDLY, and
# would now silently change its declared shape and the provenance of its rows instead. The loud symptom was
# the one worth keeping.
# ⚠ Asserted through DESCRIBE, which BINDS without executing. cdc_gen_v2 is seconds old, and the boundary a
# two-instance READ splits on is the newer instance's retention floor — §1.6a MEASURED that this is
# transiently NULL, so an execute here would intermittently answer "not established yet" instead. That
# refusal is deliberate: substituting cdc.change_tables.start_lsn would be right only until the cleanup job
# has run, after which it would send the newer leg a range that instance no longer holds — a SHORT read.
query I
SELECT count(*) > 0 FROM (DESCRIBE SELECT * FROM c1.cdc.changes('dbo.cdc_gen'));
----
true

statement ok
SELECT target, changed FROM c1.cdc.disable('dbo.cdc_gen', capture_instance := 'cdc_gen_v2');

# ═══ §24  The OWNERSHIP MARKER — presence answers "ours?", value is provenance ════════════════════════
# docs §15.5. An extended property named fabricator_source on the instance's fn_cdc_get_all_changes_*
# function, written in the SAME TRANSACTION as the enable. MEASURED that the transaction is load-bearing: in
# autocommit WITHOUT one, the enable SURVIVES a failed marker write and we would own an instance we cannot
# recognise; with one, the enable is rolled back.
#
# ⚠ It is NOT the resolution: a table rename is allowed and CDC follows it via source_object_id while this
# text goes stale (MEASURED, §15.6). Resolve by table; read this for "may we manage it?", which is what
# slice 8's resync will need.

query TT
SELECT source_table, fabricator_source FROM c1.cdc.tables() WHERE source_table = 'cdc_gen';
----
cdc_gen	dbo.cdc_gen

# ⚠ THE COLUMN COUNT, for the same reason §8 counts health()'s rows: the README lists these 14 by name, and
# an unasserted doc claim is a gap. FOUR of them — supports_net_changes, has_drop_pending, role_name,
# filegroup_name — are pinned NOWHERE else in this suite, so without this row a silent removal would reach
# users with nothing failing here.
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM c1.cdc.tables());
----
14

# ⚠⚠ THE NULL CASE IS THE LOAD-BEARING ONE. An instance created OUTSIDE this extension has no marker, and
# without this row "the marker is set" would pass equally on a build that returned a constant. There is
# deliberately no fallback that treats an unmarked instance as ours — that would silently adopt a DBA's
# capture instance, which slice 8 would then be entitled to drop and re-create.
statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.cdc_own'') IS NOT NULL DROP TABLE dbo.cdc_own; CREATE TABLE dbo.cdc_own(id INT NOT NULL PRIMARY KEY); EXEC sys.sp_cdc_enable_table @source_schema=N''dbo'', @source_name=N''cdc_own'', @role_name=NULL;');

query TT
SELECT source_table, fabricator_source IS NULL FROM c1.cdc.tables() WHERE source_table = 'cdc_own';
----
cdc_own	true

# ═══ §25  enable := true — the DDL is at EXECUTE, so BIND stays side-effect-free ══════════════════════
# docs §15.7. Deriving the declared schema from the SOURCE table is what makes this affordable: earlier
# analysis had concluded the enable must run at BIND (the schema comes from the change table, which does not
# exist yet), which would make EXPLAIN, DESCRIBE and CREATE VIEW perform DDL.

statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.cdc_auto'') IS NOT NULL DROP TABLE dbo.cdc_auto; CREATE TABLE dbo.cdc_auto(id INT NOT NULL PRIMARY KEY, v NVARCHAR(20) NULL); INSERT INTO dbo.cdc_auto VALUES (1, N''before'');');

# Without the flag, the refusal names the option rather than leaving the caller to find it.
statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_auto');
----
pass enable := true to capture it on first read

# ⚠⚠ THE ASSERTION THIS SECTION EXISTS FOR: a DESCRIBE resolves the whole output schema from the SOURCE and
# captures NOTHING. The columns are the source's, arriving through the same expression shape the real
# statement uses — so the deferred declaration cannot drift from what the TVF will return.
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM c1.cdc.changes('dbo.cdc_auto', enable := true));
----
_change_type	VARCHAR
_position	BLOB
_commit_lsn	BLOB
_seq_val	BLOB
_operation	INTEGER
_capture_instance	VARCHAR
id	INTEGER
v	VARCHAR

query I
SELECT count(*) FROM c1.cdc.tables() WHERE source_table = 'cdc_auto';
----
0

# EXECUTE creates it — with the generated name and the marker, because it goes through the same enable.
# ⚠ AND THE FIRST READ IS ZERO ROWS, NOT AN ERROR. For an instance we did NOT just create, a NULL retention
# floor is genuinely unknowable and says so; for one created microseconds ago, start_lsn is now and
# "nothing is readable yet" is a FACT rather than a guess.
query I
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_auto', enable := true);
----
0

query TT
SELECT count(*), max(fabricator_source) FROM c1.cdc.tables() WHERE source_table = 'cdc_auto';
----
1	dbo.cdc_auto

# ⚠ IT DOES NOT BACKFILL, and that has to be asserted rather than discovered. Capture starts at the enable's
# start_lsn, so the row inserted BEFORE it is invisible — an initial snapshot leg is a later slice (§15.12
# item 8). This is the assertion a user who expected a full table would fail on.
statement ok
SELECT fabricator_exec('c1', 'INSERT INTO dbo.cdc_auto VALUES (2, N''after'');');

# The same wait as §15, with the change table named through the instance the enable generated — which is why
# it is built here rather than written as a literal.
statement ok
SELECT fabricator_exec('c1', 'DECLARE @i int = 0; WHILE @i < 60 AND NOT EXISTS (SELECT 1 FROM cdc.' || (SELECT capture_instance FROM c1.cdc.tables() WHERE source_table = 'cdc_auto') || '_CT HAVING COUNT(*) >= 1 AND MAX(__$start_lsn) <= sys.fn_cdc_get_max_lsn()) BEGIN WAITFOR DELAY ''00:00:01''; SET @i = @i + 1; END');

# The second read on an already-captured table: enable := true is a no-op and the changes arrive. Only the
# post-enable row is here — id 1 predates capture.
query TIT
SELECT _change_type, id, v FROM c1.cdc.changes('dbo.cdc_auto', enable := true) ORDER BY _position;
----
insert	2	after

query I
SELECT count(*) FROM c1.cdc.tables() WHERE source_table = 'cdc_auto';
----
1

# ═══ §26  _capture_instance is on every row (slice 5) ════════════════════════════════════════════════
# docs §15.8. It is emitted ALWAYS rather than behind a flag, and adding it NOW is the point: an output
# column added later breaks every `INSERT INTO staging SELECT * FROM cdc.changes(...)` in existence, and the
# reader is two days old.
#
# ⚠ WHAT IT IS FOR is slice 7, not this slice. When a read spans a capture-instance BOUNDARY, a NULL in a
# column that did not exist in the older instance is indistinguishable from a genuine NULL — unless the row
# says which instance produced it. With ONE instance it is constant, which is exactly why the alignment and
# NULL-fill machinery §15.12 put in this slice was DEFERRED to the one where it can be decided.

# ⚠ Its POSITION in the declared schema is pinned by §16, not repeated here — one expectation block for the
# column list, so the two cannot drift.
query TI
SELECT DISTINCT _capture_instance, count(*) OVER () FROM c1.cdc.changes('dbo.cdc_setup');
----
dbo_cdc_setup	5

# ═══ §27  on_schema_change — a DDL inside the window is LOUD by default ═══════════════════════════════
# docs §15.11. MEASURED that all three DDL kinds land in cdc.ddl_history with an ddl_lsn directly comparable
# to the window bounds, and that required_column_update is 1 for exactly the type change.
#
# ⚠⚠ THE CASE IT EXISTS FOR IS THE SILENT ONE: a column ADDED after capture began is NOT captured, so the
# read simply OMITS it and a pipeline loses a field with nothing failing. A DROP leaves the column reading
# NULL; an ALTER COLUMN <type> is propagated to the change table ASYNCHRONOUSLY, so the type declared at bind
# may already be stale.

statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.cdc_ddl'') IS NOT NULL DROP TABLE dbo.cdc_ddl; CREATE TABLE dbo.cdc_ddl(id INT NOT NULL PRIMARY KEY, v NVARCHAR(20) NULL);');

statement ok
SELECT target, changed FROM c1.cdc.enable('dbo.cdc_ddl');

statement ok
SELECT fabricator_exec('c1', 'INSERT INTO dbo.cdc_ddl VALUES (1, N''one'');');

statement ok
SELECT fabricator_exec('c1', 'DECLARE @i int = 0; WHILE @i < 60 AND NOT EXISTS (SELECT 1 FROM cdc.' || (SELECT capture_instance FROM c1.cdc.tables() WHERE source_table = 'cdc_ddl') || '_CT HAVING COUNT(*) >= 1 AND MAX(__$start_lsn) <= sys.fn_cdc_get_max_lsn()) BEGIN WAITFOR DELAY ''00:00:01''; SET @i = @i + 1; END');

# ⚠⚠ THE POSITIVE CONTROL, AND IT IS THE LOAD-BEARING HALF OF THIS SECTION. With no DDL in the window the
# DEFAULT mode reads normally — without this row, "the check refuses" would pass equally on a build that
# refused every read, or on one where cdc.ddl_history simply could not be queried.
query TI
SELECT _change_type, id FROM c1.cdc.changes('dbo.cdc_ddl');
----
insert	1

# Now put a DDL inside the window and read again.
# ⚠ TWO calls, not one batch: T-SQL compiles a batch up front, so an INSERT naming a column the SAME batch
# just added fails with `207: Invalid column name`. Nothing to do with CDC — it is what a `GO` is for.
statement ok
SELECT fabricator_exec('c1', 'ALTER TABLE dbo.cdc_ddl ADD extra INT NULL;');

statement ok
SELECT fabricator_exec('c1', 'INSERT INTO dbo.cdc_ddl (id, v, extra) VALUES (2, N''two'', 9);');

statement ok
SELECT fabricator_exec('c1', 'DECLARE @i int = 0; WHILE @i < 60 AND NOT EXISTS (SELECT 1 FROM cdc.' || (SELECT capture_instance FROM c1.cdc.tables() WHERE source_table = 'cdc_ddl') || '_CT HAVING COUNT(*) >= 2 AND MAX(__$start_lsn) <= sys.fn_cdc_get_max_lsn()) BEGIN WAITFOR DELAY ''00:00:01''; SET @i = @i + 1; END');

statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_ddl');
----
schema change

# The message names the STATEMENT, not just that something happened — the remedy depends on which DDL it
# was, and a caller cannot look it up without the text.
statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_ddl');
----
ALTER TABLE dbo.cdc_ddl ADD extra INT NULL

# 'ignore' reads anyway. ⚠ The added column is ABSENT from the result — that is not a bug, it is precisely
# what the refusal was warning about: sp_cdc_enable_table fixed the captured set when the instance was
# created, so `extra` is not in the change table and no read of this instance can produce it.
query TIT
SELECT _change_type, id, v FROM c1.cdc.changes('dbo.cdc_ddl', on_schema_change := 'ignore') ORDER BY _position;
----
insert	1	one
insert	2	two

query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM c1.cdc.changes('dbo.cdc_ddl', on_schema_change := 'ignore')) WHERE column_name = 'extra';
----
0

# ⚠ AND THE WINDOW IS WHAT MATTERS, NOT THE TABLE'S HISTORY: a read that STARTS after the DDL is clean
# again, because the shape it declares describes all of what it returns. Without this row the check would be
# indistinguishable from "this table is poisoned forever".
statement ok
SET VARIABLE cdc_ddl_end = (SELECT c1.cdc.max_position());

statement ok
PREPARE cdc_after_ddl AS SELECT count(*) AS n FROM c1.cdc.changes('dbo.cdc_ddl', starting_position := ?);

query I
EXECUTE cdc_after_ddl(getvariable('cdc_ddl_end'));
----
0

# ⚠ `'resync'` is IMPLEMENTED since slice 8b and is exercised in §32, on its own fixture. It is deliberately
# NOT exercised here: `dbo.cdc_ddl` IS stale (its `extra` column was added and never dropped), so a resync
# would re-capture and re-baseline it in the middle of a section about the in-window DDL check — and this
# section's remaining assertions are about that check, not about repairing it.
#
# ⚠⚠ THE ASSERTION THAT USED TO STAND HERE WAS WRONG AND PASSED ANYWAY, which is why it is gone rather than
# adjusted. It claimed `cdc_ddl`'s captured set matched its source (it does not) and asserted the row count
# beside an instance count in ONE statement — where the row count coincided at 2 either way, and DuckDB is
# free to evaluate the second scalar subquery BEFORE the first, so the instance count could be read before
# the resync's DDL ran. Two subqueries in one statement do not pin an order; §32 splits them.

# ⚠ EVERY on_schema_change mode is implemented now, so what used to be a "designed but not built" refusal
# here is an assertion instead — and `dbo.cdc_ddl` is the right table for it, because its `extra` column was
# ADDED and never dropped, so it is genuinely stale. 'fill' projects that column and looks it up from the
# live source; the section's own subject (the in-window DDL check) is unaffected, because a column-set DDL
# is exactly what 'fill' absorbs.
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM c1.cdc.changes('dbo.cdc_ddl', on_schema_change := 'fill'))
WHERE column_name = 'extra';
----
1

# An unknown value is still refused, naming the five that exist rather than the caller's spelling.
statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_ddl', on_schema_change := 'nonsense');
----
is not a value

# ═══ §28  THE TWO-INSTANCE BOUNDARY — one stream across it (slice 7) ══════════════════════════════════
# docs §19. A second capture instance is how a schema change is absorbed, and §2.2 MEASURED that BOTH
# instances capture every change in their overlap window — so a reader must pick ONE per LSN range and switch
# at a boundary SQL Server records NOWHERE (cdc.change_tables.end_lsn is NULL for both, re-confirmed
# 2026-08-25). The boundary is DERIVED as the newer instance's retention floor, which is also what keeps it
# correct under cleanup: that floor RISES as the cleanup job purges, and the purged range is exactly the range
# the newer instance can no longer answer for — while the older one still covers it.

statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.cdc_span'') IS NOT NULL DROP TABLE dbo.cdc_span; CREATE TABLE dbo.cdc_span(id INT NOT NULL PRIMARY KEY, v NVARCHAR(20) NULL, amt DECIMAL(9,2) NULL);');

statement ok
SELECT target, changed FROM c1.cdc.enable('dbo.cdc_span', capture_instance := 'span_v1');

statement ok
SELECT fabricator_exec('c1', 'INSERT INTO dbo.cdc_span (id, v, amt) VALUES (1, N''one'', 1.50), (2, N''two'', 2.50);');

# ⚠ Wait for the WATERMARK as well as the rows: a row is not readable until fn_cdc_get_max_lsn() covers it, so
# waiting only for COUNT leaves a race whose symptom is a SHORT READ — a wrong answer rather than a failure.
statement ok
SELECT fabricator_exec('c1', 'DECLARE @i int = 0; WHILE @i < 60 AND NOT EXISTS (SELECT 1 FROM cdc.span_v1_CT HAVING COUNT(*) >= 2 AND MAX(__$start_lsn) <= sys.fn_cdc_get_max_lsn()) BEGIN WAITFOR DELAY ''00:00:01''; SET @i = @i + 1; END');

# The two DDLs the second instance exists for — one ADD and one DROP, so alignment is exercised in BOTH
# directions: `region` ends up in the newer instance only, `v` in the older only.
statement ok
SELECT fabricator_exec('c1', 'ALTER TABLE dbo.cdc_span ADD region VARCHAR(10) NULL;');

statement ok
SELECT fabricator_exec('c1', 'ALTER TABLE dbo.cdc_span DROP COLUMN v;');

statement ok
SELECT target, changed FROM c1.cdc.enable('dbo.cdc_span', capture_instance := 'span_v2');

statement ok
SELECT fabricator_exec('c1', 'INSERT INTO dbo.cdc_span (id, amt, region) VALUES (3, 3.50, ''eu''); UPDATE dbo.cdc_span SET amt = 9.99 WHERE id = 1;');

# ⚠⚠ THE FLOOR WAIT IS LOAD-BEARING AND IT IS NOT THE SAME AS THE ROW WAIT. §1.6a MEASURED that
# fn_cdc_get_min_lsn is transiently NULL for an instance enabled in an already-capturing database — and that
# floor IS the boundary this section splits on, so without this wait the first read below intermittently gets
# "the boundary … is not established yet" instead of rows. The CT wants 3 rows: the insert, and the update's
# pre- AND post-image (the TVF returns only the post-image under images := 'after', the change table holds
# both).
statement ok
SELECT fabricator_exec('c1', 'DECLARE @i int = 0; WHILE @i < 60 AND (sys.fn_cdc_get_min_lsn(''span_v2'') IS NULL OR NOT EXISTS (SELECT 1 FROM cdc.span_v2_CT HAVING COUNT(*) >= 3 AND MAX(__$start_lsn) <= sys.fn_cdc_get_max_lsn())) BEGIN WAITFOR DELAY ''00:00:01''; SET @i = @i + 1; END');

# ⚠⚠ THE DECLARED SHAPE: the NEWER instance's captured columns first, then the columns only the OLDER one
# has. The newer set is the table's CURRENT shape and the one a consumer keeps seeing once the older instance
# is gone, so `SELECT *` is stable in the direction that matters; a dropped column is history and is appended.
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM c1.cdc.changes('dbo.cdc_span'));
----
_change_type	VARCHAR
_position	BLOB
_commit_lsn	BLOB
_seq_val	BLOB
_operation	INTEGER
_capture_instance	VARCHAR
id	INTEGER
amt	DECIMAL(9,2)
region	VARCHAR
v	VARCHAR

# ⚠⚠ AND THE DEFAULT MODE READS IT — no on_schema_change opt-out anywhere in this section until the last
# rows. Two DDLs sit inside this window and §27's check refuses a window containing one, but they are BELOW
# the boundary, which is where a DDL is ABSORBED: the second capture instance exists BECAUSE of them, the
# union carries both shapes, and _capture_instance tells the two eras apart. A DDL AFTER the newest instance
# is a different thing entirely, and it is asserted at the end of this section.
query TTIT
SELECT _change_type, _capture_instance, id, coalesce(v, '<not captured>') FROM c1.cdc.changes('dbo.cdc_span') ORDER BY _position;
----
insert	span_v1	1	one
insert	span_v1	2	two
insert	span_v2	3	<not captured>
update_postimage	span_v2	1	<not captured>

# ⚠⚠ THE DISCRIMINATING ASSERTION, AND A ROW COUNT IS NOT ONE. MEASURED: the OLDER instance never stops
# capturing, so reading IT alone returns every row — the same four — just without `region`; the newer alone
# returns two, without `v`. Only the union can produce `v = 'one'` (captured by span_v1 only) and
# `region = 'eu'` (captured by span_v2 only) in ONE result, so this is the row that a build reading either
# instance alone cannot pass.
query TT
SELECT max(v), max(region) FROM c1.cdc.changes('dbo.cdc_span');
----
two	eu

# ⚠ AND NOTHING IS COUNTED TWICE. Both instances capture every change in the overlap window (§2.2), so a
# reader that let both legs see one LSN returns it twice — a failure completely invisible to the shape
# assertions above.
query II
SELECT count(*), count(DISTINCT _position) FROM c1.cdc.changes('dbo.cdc_span');
----
4	4

# The positive control for both: each instance ALONE. ⚠ The older one returns the SAME ROW COUNT as the
# union, which is exactly why the assertion above is on values rather than on a count.
# ⚠ on_schema_change := 'ignore' is required here and it is the check working: a SINGLE-instance read has no
# boundary, so nothing absorbs the two DDLs and they sit inside its window.
query II
SELECT (SELECT count(*) FROM c1.cdc.changes('dbo.cdc_span', capture_instance := 'span_v1', on_schema_change := 'ignore')),
       (SELECT count(*) FROM c1.cdc.changes('dbo.cdc_span', capture_instance := 'span_v2', on_schema_change := 'ignore'));
----
4	2

# ⚠⚠ THE NULL IS DECIDABLE, WHICH IS THE WHOLE REASON _capture_instance SHIPPED IN SLICE 5 BEFORE IT DECIDED
# ANYTHING. `region` is NULL on both span_v1 rows because that instance never captured the column, and NULL on
# ONE span_v2 row because the value really is NULL. Same NULL, two different meanings, and the instance column
# is what separates them — without it §7's "refuse" would still be the only honest answer.
query TI
SELECT _capture_instance, count(*) FROM c1.cdc.changes('dbo.cdc_span') WHERE region IS NULL GROUP BY 1 ORDER BY 1;
----
span_v1	2
span_v2	1

# min_position on the TABLE name answers again — it was a refusal until this slice, because "the floor of
# what?" had no answer while cdc.changes refused the same source. The union's readable range starts at the
# OLDER instance's floor.
# ⚠ Safe from §1.6a's transient NULL only because it runs AFTER the reads above: a read that resolved the
# split proves the newer floor is established, and a floor never goes back to NULL.
query I
SELECT c1.cdc.min_position('dbo.cdc_span') = c1.cdc.min_position('span_v1');
----
true

# ⚠⚠ THE DEGENERATE WINDOWS, and they are what the CLAMPED TVF arguments exist for. The statement is composed
# once at BIND while the window is resolved at EXECUTE, so both legs are always in it — and a leg with nothing
# to read must still be handed a LEGAL window, because the TVF answers an inverted one with the
# unattributable 313 (§2.1). Below the boundary the newer leg is handed (split, split) and its rows are
# removed by `<= @win_to`; at or above it the older leg is handed a one-LSN window and `< @split` removes
# everything it returns. MEASURED both directions.
statement ok
SET VARIABLE span_first = (SELECT min(_position) FROM c1.cdc.changes('dbo.cdc_span'));

query TI
SELECT _capture_instance, count(*) FROM c1.cdc.changes('dbo.cdc_span', ending_position := getvariable('span_first')) GROUP BY 1 ORDER BY 1;
----
span_v1	1

statement ok
SET VARIABLE span_boundary = (SELECT c1.cdc.min_position('span_v2'));

query TI
SELECT _capture_instance, count(*) FROM c1.cdc.changes('dbo.cdc_span', starting_position := getvariable('span_boundary')) GROUP BY 1 ORDER BY 1;
----
span_v2	2

# ⚠⚠ A DDL AFTER THE NEWEST INSTANCE IS *NOT* ABSORBED — nobody re-captured for it — so the check fires
# again. This is the discriminating half of the absorption rule: without it, "the absorbed DDLs do not
# refuse" would be equally satisfied by a build that had simply stopped checking on two-instance reads.
statement ok
SELECT fabricator_exec('c1', 'ALTER TABLE dbo.cdc_span ADD later_col INT NULL;');

# ⚠ Waiting for the ddl_history ROW, not for a row count: cdc.ddl_history is populated by the capture job
# ASYNCHRONOUSLY too (MEASURED — an ADD was still absent from it seconds after the DML that followed it had
# been captured), so a read taken too early finds nothing and the section would pass for the wrong reason.
# The wait doubles as the watermark guarantee: the job cannot have recorded the DDL without scanning past it.
statement ok
SELECT fabricator_exec('c1', 'DECLARE @i int = 0; WHILE @i < 60 AND NOT EXISTS (SELECT 1 FROM cdc.ddl_history d JOIN cdc.change_tables ct ON ct.source_object_id = d.source_object_id WHERE ct.capture_instance = ''span_v2'' AND d.ddl_command LIKE ''%later_col%'') BEGIN WAITFOR DELAY ''00:00:01''; SET @i = @i + 1; END');

statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_span');
----
later_col

# ⚠ And the message says which side of the boundary it is talking about, because on a two-instance read the
# obvious reading of "a schema change landed inside this window" is the one that produced the second
# instance — which is precisely the one NOT being reported.
statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_span');
----
these landed after it

# 'ignore' reads it anyway, and the count is unchanged — an ALTER adds no rows. The absorbed DDLs stay
# absorbed under 'ignore' too; the mode governs the check, not the boundary.
query I
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_span', on_schema_change := 'ignore');
----
4

# ⚠ commit_timestamp composes with the boundary, and nothing else in this suite exercises the pair. The
# LEFT JOIN onto cdc.lsn_time_mapping is emitted PER LEG with its own alias, because a join inside a
# UNION ALL belongs to one branch — there is nothing shared to hoist. Counting the column as well as the
# rows is what makes this an assertion rather than a smoke test: a join that missed would leave the
# timestamp NULL while the row count stayed right.
query TII
SELECT _capture_instance, count(*), count(_commit_timestamp) FROM c1.cdc.changes('dbo.cdc_span', commit_timestamp := true, on_schema_change := 'ignore') GROUP BY 1 ORDER BY 1;
----
span_v1	2	2
span_v2	2	2

# ⚠⚠ A GENUINE TYPE CONFLICT IS REFUSED AT BIND, AND IT IS THE ONLY WAY TWO INSTANCES OF ONE TABLE CAN
# DISAGREE ON A COLUMN'S TYPE. MEASURED 2026-08-25: an ALTER COLUMN <type> is propagated by the capture job to
# BOTH change tables (~2 s on the rig), so they CONVERGE — which is also why the WidenArrowType helper §15.8
# recommended turned out to have no reachable case at all. A column DROPPED and RE-ADDED with a different type
# is the exception: the older instance keeps the old type forever. Left to SQL Server the union coerces by
# precedence (MEASURED: varchar ∪ int describes as int) and dies mid-scan on the first unconvertible VALUE —
# so it is silent for exactly as long as the historical text happens to look like the new type.
statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.cdc_conf'') IS NOT NULL DROP TABLE dbo.cdc_conf; CREATE TABLE dbo.cdc_conf(id INT NOT NULL PRIMARY KEY, note VARCHAR(20) NULL);');

statement ok
SELECT target, changed FROM c1.cdc.enable('dbo.cdc_conf', capture_instance := 'conf_v1');

statement ok
SELECT fabricator_exec('c1', 'ALTER TABLE dbo.cdc_conf DROP COLUMN note;');

statement ok
SELECT fabricator_exec('c1', 'ALTER TABLE dbo.cdc_conf ADD note INT NULL;');

statement ok
SELECT target, changed FROM c1.cdc.enable('dbo.cdc_conf', capture_instance := 'conf_v2');

# ⚠⚠ THE FLOOR WAIT GOES *BEFORE* THE REFUSAL, and mutation-testing is what showed why. The refusal fires
# at BIND, so it does not need the floor — but a build WITHOUT it gets as far as EXECUTE, where conf_v2's
# transiently NULL floor (§1.6a) raises a completely unrelated error. The assertion still failed, for the
# wrong reason. With the wait in front, a build that stops refusing succeeds and the row fails with "Query
# unexpectedly succeeded", which is the outcome that names the defect.
statement ok
SELECT fabricator_exec('c1', 'DECLARE @i int = 0; WHILE @i < 60 AND sys.fn_cdc_get_min_lsn(''conf_v2'') IS NULL BEGIN WAITFOR DELAY ''00:00:01''; SET @i = @i + 1; END');

statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_conf');
----
captured as varchar by 'conf_v1' and as int by 'conf_v2'

# …and naming one instance still reads it. The positive control for the refusal: without it, the error above
# would pass equally on a build that had refused every read of this table.
query I
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_conf', capture_instance := 'conf_v2');
----
0

# ═══ §29  THE INITIAL-SNAPSHOT LEG — include := 'snapshot' / 'snapshot+changes' (slice 8) ══════════════
# docs §20, built from §5's two-connection protocol. A change stream can only say what CHANGED, so a consumer
# starting from an empty sink needs the state that was already there AND a position to join the stream at with
# no gap and no overlap. Connection A takes a SHARED table lock (writers frozen, readers unaffected) and reads
# the handoff position; connection B pins a SNAPSHOT view inside that window; A commits, and B then reads the
# whole table at leisure from a view fixed at the instant the lock was held.

statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.cdc_snap'') IS NOT NULL DROP TABLE dbo.cdc_snap; CREATE TABLE dbo.cdc_snap(id INT NOT NULL PRIMARY KEY, v NVARCHAR(20) NULL, amt DECIMAL(9,2) NULL);');

statement ok
SELECT fabricator_exec('c1', 'INSERT INTO dbo.cdc_snap (id, v, amt) VALUES (1, N''one'', 1.50), (2, N''two'', 2.50), (3, N''three'', 3.50);');

statement ok
SELECT target, changed FROM c1.cdc.enable('dbo.cdc_snap', capture_instance := 'snap_v1');

# ⚠ The FLOOR wait, and it is the one §1.6a's finding demands rather than the row wait §28 needs. This
# instance is enabled in an already-capturing database, so fn_cdc_get_min_lsn is transiently NULL for up to a
# polling interval — and a NULL floor is a REFUSAL, not a low bound, so without this the first read here
# intermittently reports "the retention floor ... is not established yet". There is nothing to wait for in the
# change table: these rows were inserted BEFORE the enable, so CDC never captured them. That is the point —
# the snapshot is how a consumer gets them at all.
statement ok
SELECT fabricator_exec('c1', 'DECLARE @i int = 0; WHILE @i < 60 AND sys.fn_cdc_get_min_lsn(''snap_v1'') IS NULL BEGIN WAITFOR DELAY ''00:00:01''; SET @i = @i + 1; END');

# ⚠⚠ THE DECLARED SHAPE IS THE CHANGE READ'S, COLUMN FOR COLUMN — that is what "one stream" MEANS, and it is
# not free: MEASURED 2026-08-25, the obvious spellings of the snapshot's metadata literals describe
# DIFFERENTLY (a CASE over a constant operation folds to varchar(6) where the real list gives varchar(16),
# and binary + binary gives varbinary(21) rather than binary(21)), so both are re-stated with an explicit
# CONVERT. Without them the arrival check refuses every snapshot — loudly, but every one.
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM c1.cdc.changes('dbo.cdc_snap', include := 'snapshot'));
----
_change_type	VARCHAR
_position	BLOB
_commit_lsn	BLOB
_seq_val	BLOB
_operation	INTEGER
_capture_instance	VARCHAR
id	INTEGER
v	VARCHAR
amt	DECIMAL(9,2)

# ⚠ THE BASELINE ROWS, and every metadata column is individually true rather than convenient. `insert` reuses
# the Delta change-feed spelling §3.3 chose so a consumer that already handles a Delta CDF handles this one
# unchanged — and Delta's own answer to "how do you spell the baseline" is `insert` too. _commit_lsn and
# _seq_val are NULL because a snapshot row is STATE, not an event: it has no commit and no sequence within
# one.
query TIIITT
SELECT _change_type, _operation, _commit_lsn IS NULL, _seq_val IS NULL, id, v
  FROM c1.cdc.changes('dbo.cdc_snap', include := 'snapshot') ORDER BY id;
----
insert	2	true	true	1	one
insert	2	true	true	2	two
insert	2	true	true	3	three

# ⚠⚠ _capture_instance IS THE DISCRIMINATOR, and it is NULL here for a reason rather than by omission: this
# row came from the SOURCE table, not from a capture instance. A change row's value is a parameter that is
# never null, so `_capture_instance IS NULL` is exactly "this is a baseline row" — one rule, no new column,
# and it re-uses the column slice 5 shipped to make provenance readable.
query II
SELECT count(*), count(_capture_instance) FROM c1.cdc.changes('dbo.cdc_snap', include := 'snapshot');
----
3	0

# ⚠ ONE handoff for the whole leg. It is not a per-row position — there is no change row behind it — it is
# the single instant the whole snapshot is as of.
query II
SELECT count(DISTINCT _position), max(octet_length(_position)) FROM c1.cdc.changes('dbo.cdc_snap', include := 'snapshot');
----
1	21

# On a quiet table the two halves are the baseline and nothing: the changes leg's window is empty because
# nothing has committed since the pin. That is the ORDINARY case, not a dead end.
query III
SELECT count(*), count(*) FILTER (_capture_instance IS NULL), count(*) FILTER (_capture_instance IS NOT NULL)
  FROM c1.cdc.changes('dbo.cdc_snap', include := 'snapshot+changes');
----
3	3	0

# ═══ §29a  The handoff is a real cursor: resume from it and get exactly what came after ════════════════

statement ok
SET VARIABLE cdc_snap_h = (SELECT DISTINCT _position FROM c1.cdc.changes('dbo.cdc_snap', include := 'snapshot'));

statement ok
SELECT fabricator_exec('c1', 'INSERT INTO dbo.cdc_snap (id, v, amt) VALUES (4, N''four'', 4.50); UPDATE dbo.cdc_snap SET v = N''ONE'' WHERE id = 1; DELETE FROM dbo.cdc_snap WHERE id = 2;');

statement ok
SELECT fabricator_exec('c1', 'DECLARE @i int = 0; WHILE @i < 60 AND NOT EXISTS (SELECT 1 FROM cdc.snap_v1_CT HAVING COUNT(*) >= 4 AND MAX(__$start_lsn) <= sys.fn_cdc_get_max_lsn()) BEGIN WAITFOR DELAY ''00:00:01''; SET @i = @i + 1; END');

# ⚠⚠ THE LOAD-BEARING ASSERTION OF THE WHOLE SLICE. The snapshot said what the table WAS; resuming from the
# position its rows carried delivers exactly what happened after, with none of the three rows the snapshot
# already carried replayed. Gap and overlap are both visible here: a handoff that were too LOW would replay
# the original inserts, one too HIGH would drop one of these three.
query TIT
SELECT _change_type, id, coalesce(v, '<null>') FROM c1.cdc.changes('dbo.cdc_snap', starting_position := getvariable('cdc_snap_h')) ORDER BY _position;
----
insert	4	four
update_postimage	1	ONE
delete	2	two

# And a snapshot taken NOW is the table as it now is, with nothing after it — the same shape as before the
# mutations, which is what makes the pair meaningful rather than a single lucky read.
query III
SELECT count(*), count(*) FILTER (_capture_instance IS NULL), count(*) FILTER (_capture_instance IS NOT NULL)
  FROM c1.cdc.changes('dbo.cdc_snap', include := 'snapshot+changes');
----
3	3	0

# ═══ §29b  The 0xFF padding, and the duplicate it prevents ════════════════════════════════════════════
# ⚠⚠ The handoff LSN is the capture WATERMARK, so every change AT it is already in the snapshot. Our cursor
# predicate is `lsn > cur OR (lsn = cur AND (seq > cur_seq OR (seq = cur_seq AND op > cur_op)))`, so the
# 21-byte position has to make both tails unsatisfiable — padding the LSN with 0xFF rather than with zeros.

statement ok
SET VARIABLE cdc_snap_h2 = (SELECT DISTINCT _position FROM c1.cdc.changes('dbo.cdc_snap', include := 'snapshot'));

# It really is the watermark with eleven 0xFF bytes after it, not some other value that happens to work.
query I
SELECT getvariable('cdc_snap_h2') = (c1.cdc.max_position() || '\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF'::BLOB);
----
true

# Nothing at or below it is delivered again.
query I
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_snap', starting_position := getvariable('cdc_snap_h2'));
----
0

# ⚠⚠ AND THE CONTROL THAT MAKES THAT MEAN SOMETHING — without it, "0 rows" would pass equally on a build
# whose resume had stopped working altogether. The SAME LSN padded with ZEROS admits every row at the
# watermark, which is exactly one row here: the DELETE, the last transaction the capture job recorded. That
# is the duplicate the padding exists to prevent, and it is a row the snapshot has ALREADY accounted for.
statement ok
SET VARIABLE cdc_snap_z = (SELECT c1.cdc.max_position() || '\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00'::BLOB);

query TI
SELECT _change_type, id FROM c1.cdc.changes('dbo.cdc_snap', starting_position := getvariable('cdc_snap_z'));
----
delete	2

# ═══ §29c  A snapshot IS the starting point, so a cursor beside it is refused ══════════════════════════
# Neither reading is what anybody wants: a snapshot of the CURRENT table paired with an OLD cursor delivers
# every change between them twice, and one paired with a cursor AHEAD of it silently loses what lies between.

statement error
SELECT 1 FROM c1.cdc.changes('dbo.cdc_snap', include := 'snapshot', starting_position := getvariable('cdc_snap_h2'));
----
cannot be combined with starting_position

statement error
SELECT 1 FROM c1.cdc.changes('dbo.cdc_snap', include := 'snapshot+changes', starting_position := getvariable('cdc_snap_h2'));
----
cannot be combined with starting_position

# ⚠ ending_position is refused for a DIFFERENT reason and only for the snapshot alone: a snapshot is the table
# as of one instant, not a window, so there is no upper bound to apply.
statement error
SELECT 1 FROM c1.cdc.changes('dbo.cdc_snap', include := 'snapshot', ending_position := c1.cdc.max_position());
----
cannot be combined with ending_position

# …and the control: with the changes half present it IS accepted, because there it bounds that half.
query I
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_snap', include := 'snapshot+changes', ending_position := c1.cdc.max_position());
----
3

statement error
SELECT 1 FROM c1.cdc.changes('dbo.cdc_snap', include := 'bogus');
----
include := 'bogus' is not a value

# Case-insensitive, like every other vocabulary in this surface.
query I
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_snap', include := 'SNAPSHOT');
----
3

# ═══ §29d  A captured column dropped from the source is REFUSED, not NULL-filled ═══════════════════════
# ⚠ The case is real rather than defensive: §28's cdc_span had `v` DROPPED, and a DROP COLUMN leaves the
# change table's column in place reading NULL. So the declaration — which is the CAPTURED set — names a
# column SELECT cannot resolve on the source. NULL-filling it is not available either: §19.3 MEASURED that a
# bare NULL takes its type from the OTHER branch of a union, and the snapshot statement has no other branch,
# so it would describe as int and fail the arrival check anyway.

statement error
SELECT 1 FROM c1.cdc.changes('dbo.cdc_span', include := 'snapshot');
----
captured column 'v' no longer exists on the source table

# ⚠ THE CONTROL, and it is what keeps the refusal narrow: the same table still reads its CHANGES. Without
# this row the error above would pass equally on a build that had refused every read of cdc_span.
query I
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_span', on_schema_change := 'ignore');
----
4

# ⚠⚠ AND PUTTING THE COLUMN BACK MAKES THE SAME TABLE SNAPSHOTTABLE — the same fixture, one DDL apart, which
# is what shows the refusal is about the SOURCE rather than about two-instance tables. It also exercises the
# UNION path's snapshot statement, which is a different composition from the one-instance path: the columns
# are the ALIGNED set of both instances. Note `v` now has VALUES here where the change stream reports it as
# not captured — the snapshot reads the SOURCE, and that is the whole point of it.
statement ok
SELECT fabricator_exec('c1', 'ALTER TABLE dbo.cdc_span ADD v NVARCHAR(20) NULL;');

statement ok
SELECT fabricator_exec('c1', 'UPDATE dbo.cdc_span SET v = N''back'';');

query TIIT
SELECT _change_type, id, amt, coalesce(region, '<null>') FROM c1.cdc.changes('dbo.cdc_span', include := 'snapshot') ORDER BY id;
----
insert	1	9.99	<null>
insert	2	2.50	<null>
insert	3	3.50	eu

# ═══ §29e  A transaction that has written the source cannot snapshot it ═══════════════════════════════
# ⚠⚠ UNCONDITIONAL, unlike the pooled-scan hazard next door — the three escapes that make THAT one safe do
# not apply. The protocol MUST take its lock on a connection of its own, because the lock's whole point is to
# be released by a COMMIT whose timing we control, and committing the caller's transaction is not ours to do.
# A lock REQUEST is not a read either, so row versioning does not exempt it. The request would wait on locks
# only this transaction can release, which never returns — a hang rather than an error, which is why it is
# refused up front.

# ⚠⚠ THE COMMAND TIMEOUT IS PART OF THE TEST, not setup noise. Without the guard this read does not
# FAIL, it HANGS: mssql_command_timeout defaults to 0 (infinite), so the lock request waits forever for a
# lock only this transaction can release. A suite that hangs on regression is worse than no suite, so this
# section bounds the wait — a build that loses the guard then fails here in ten seconds with a timeout
# instead of stalling the tier. (MEASURED: the mutant with the guard removed ran past ten minutes.)
statement ok
SET mssql_command_timeout = 10;

statement ok
BEGIN;

statement ok
INSERT INTO c1.dbo.cdc_snap VALUES (9, 'nine', 9.5);

statement error
SELECT 1 FROM c1.cdc.changes('dbo.cdc_snap', include := 'snapshot');
----
this transaction has uncommitted writes to it

statement ok
ROLLBACK;

statement ok
RESET mssql_command_timeout;

# ⚠ The refusal is at EXECUTE, and it has to be: bind must stay side-effect-free, and whether a transaction
# holds locks is not a property of the statement. So the ROLLBACK above is what makes this read work again —
# and the row it inserted is gone, which is the control proving the rollback really happened.
query I
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_snap', include := 'snapshot');
----
3

# ═══ §29f  enable := true + snapshot — capture a table and read its contents in ONE statement ══════════
# The shape the two features exist for together: a table nobody has captured becomes a captured table AND
# hands back everything already in it, with a position to keep going from.

statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.cdc_seed'') IS NOT NULL DROP TABLE dbo.cdc_seed; CREATE TABLE dbo.cdc_seed(id INT NOT NULL PRIMARY KEY, v NVARCHAR(20) NULL);');

statement ok
SELECT fabricator_exec('c1', 'INSERT INTO dbo.cdc_seed (id, v) VALUES (1, N''x''), (2, N''y'');');

# ⚠ BIND STAYS SIDE-EFFECT-FREE, and a snapshot leg does not change that: DESCRIBE resolves the whole shape
# and captures NOTHING. Without this row the section below could not distinguish "enable ran at execute" from
# "enable ran at bind and execute found it already captured".
statement ok
DESCRIBE SELECT * FROM c1.cdc.changes('dbo.cdc_seed', enable := true, include := 'snapshot+changes');

query I
SELECT count(*) FROM c1.cdc.tables() WHERE source_table = 'cdc_seed';
----
0

query TIT
SELECT _change_type, id, v FROM c1.cdc.changes('dbo.cdc_seed', enable := true, include := 'snapshot+changes') ORDER BY id;
----
insert	1	x
insert	2	y

query I
SELECT count(*) FROM c1.cdc.tables() WHERE source_table = 'cdc_seed';
----
1

# ⚠ It exercised the handoff CLAMP, which no row can show: the handoff is the DATABASE-wide capture watermark
# while the instance created microseconds earlier starts ABOVE it, so the changes half's lower bound is the
# instance's own floor rather than the handoff. Refusing there — which is what a plain starting_position
# below the floor does — would have refused exactly this shape.

# ═══ §29g  An EMPTY table snapshots to nothing — and therefore hands back no cursor ════════════════════
# ⚠⚠ The one sharp edge of `include := 'snapshot'` ALONE, and it is worth pinning because the documented
# idiom takes the handoff OUT OF THE ROWS. No rows means no handoff, so `SET VARIABLE cur = (SELECT DISTINCT
# _position FROM …)` yields NULL, and `starting_position := NULL` is "absent" rather than an error — the next
# read then starts at the RETENTION FLOOR and replays the table's whole captured history. Redundant rather
# than wrong (the table was empty at the pin, so the replay nets to nothing), but it is the §3.4 trap wearing
# a new hat. `include := 'snapshot+changes'` does not have it: there the handoff never leaves the reader.

statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.cdc_void'') IS NOT NULL DROP TABLE dbo.cdc_void; CREATE TABLE dbo.cdc_void(id INT NOT NULL PRIMARY KEY);');

statement ok
SELECT target, changed FROM c1.cdc.enable('dbo.cdc_void', capture_instance := 'void_v1');

statement ok
SELECT fabricator_exec('c1', 'DECLARE @i int = 0; WHILE @i < 60 AND sys.fn_cdc_get_min_lsn(''void_v1'') IS NULL BEGIN WAITFOR DELAY ''00:00:01''; SET @i = @i + 1; END');

# ⚠ It also exercises the lock on an EMPTY table, which nothing else here does: "there is nothing to read"
# could plausibly have let the optimiser drop the scan and the TABLOCK with it. It does not (measured
# separately: the lock is granted and a writer is blocked), and this read completing is the observable half.
query I
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_void', include := 'snapshot');
----
0

# The handoff is NULL, which is the trap stated as an assertion rather than as prose.
query I
SELECT (SELECT DISTINCT _position FROM c1.cdc.changes('dbo.cdc_void', include := 'snapshot')) IS NULL;
----
true

# …and 'snapshot+changes' over the same empty table is simply empty, with no cursor for the caller to get
# wrong. That is the form to reach for.
query I
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_void', include := 'snapshot+changes');
----
0

# ═══ §29h  The change read never joins the transaction — user-raised, and it was NOT already true ══════
# ⚠⚠ `cdc.changes` was pooled in the COMMON case and pinned inside an explicit transaction that had written
# the source (rule 3, MARS) or under mssql_read_isolation (rule 2, where it was also DRAINED). MEASURED from
# the route log before the fix: the identical statement logged `route=pooled` in autocommit and
# `route=pin (MARS)` inside such a transaction.
#
# It buys NOTHING: the capture job populates a change table ASYNCHRONOUSLY from COMMITTED log records, so a
# change this transaction just made is not in it yet on ANY connection. What it cost is real — a long
# STREAMING change reader on the transaction's WRITE connection is the 595 hazard, and the read_isolation
# route buffered a whole change window into memory. So the reader opts out.
#
# ⚠ Only the change READ opts out. The WINDOW resolution deliberately keeps the pin, because a capture
# instance enabled in THIS transaction IS visible to it and the window has to see it.

statement ok
SET enable_logging = true;

statement ok
SET logging_level = 'DEBUG';

statement ok
BEGIN;

statement ok
INSERT INTO c1.dbo.cdc_snap VALUES (7, 'seven', 7.5);

query I
SELECT count(*) > 0 FROM c1.cdc.changes('dbo.cdc_snap');
----
true

statement ok
COMMIT;

# The change read declined the pin.
query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE message LIKE 'query [pooled%reader opts out%' AND message LIKE '%__$operation%';
----
true

# ⚠⚠ THE POSITIVE CONTROL, and without it the row above is vacuous: in autocommit there is no pin to
# decline, so "the read was pooled" would pass on a build where the opt-out did nothing. This asserts the
# transaction really did have a pinned connection at that moment — the window resolution used it.
query I
SELECT count(*) > 0 FROM duckdb_logs WHERE message LIKE 'query [pinned%';
----
true

# …and the change read is not among the pinned ones. `__$operation` is the change read's fingerprint: it is
# the first thing its SELECT list mentions, well inside the 400-char log truncation.
query I
SELECT count(*) FROM duckdb_logs
WHERE message LIKE 'query [pinned%' AND message LIKE '%__$operation%';
----
0

statement ok
SET enable_logging = false;

# ═══ §30  images := 'both' — the BEFORE image, and the mask that makes it readable (slice 9) ════════════
# docs §1.5/§1.7. The default reads after-images only, which DODGES the MAX-column trap; 'both' is the only
# way to see what a row held before an update, and it carries the trap with it. ⚠ The fixture is TEN columns
# on purpose — a mask wider than one byte is where the obvious decoding rule stops being right (§30c).

statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.cdc_img'') IS NOT NULL DROP TABLE dbo.cdc_img; CREATE TABLE dbo.cdc_img(id INT NOT NULL PRIMARY KEY, c2 INT NULL, c3 INT NULL, c4 INT NULL, c5 INT NULL, c6 INT NULL, c7 INT NULL, c8 INT NULL, notes VARCHAR(MAX) NULL, tag VARCHAR(20) NULL);');

statement ok
SELECT target, changed FROM c1.cdc.enable('dbo.cdc_img', capture_instance := 'img_v1');

statement ok
SELECT fabricator_exec('c1', 'DECLARE @i int = 0; WHILE @i < 60 AND sys.fn_cdc_get_min_lsn(''img_v1'') IS NULL BEGIN WAITFOR DELAY ''00:00:01''; SET @i = @i + 1; END');

# ⚠ The UPDATE deliberately does NOT touch `notes`, which is the whole point: `notes` is a VARCHAR(MAX), and
# SQL Server does not record an untouched MAX column in an update's BEFORE image (§1.5).
statement ok
SELECT fabricator_exec('c1', 'INSERT INTO dbo.cdc_img (id, c2, c3, c4, c5, c6, c7, c8, notes, tag) VALUES (1, 1, 1, 1, 1, 1, 1, 1, ''first'', ''a''); UPDATE dbo.cdc_img SET c2 = 99 WHERE id = 1; UPDATE dbo.cdc_img SET notes = ''changed'' WHERE id = 1;');

statement ok
SELECT fabricator_exec('c1', 'DECLARE @i int = 0; WHILE @i < 60 AND ((SELECT COUNT(*) FROM cdc.img_v1_CT) < 5 OR sys.fn_cdc_get_max_lsn() IS NULL OR sys.fn_cdc_get_max_lsn() < (SELECT MAX(__$start_lsn) FROM cdc.img_v1_CT)) BEGIN WAITFOR DELAY ''00:00:01''; SET @i = @i + 1; END');

# ⚠⚠ THE ROW COUNTS ARE THE MODE, and they are asserted side by side so neither can pass alone. `all` gives
# one row per change and `all update old` adds the op-3 partner of every update — MEASURED 5 vs 7 on the
# probe rig, 3 vs 5 here (three changes, two of them updates).
query II
SELECT (SELECT count(*) FROM c1.cdc.changes('dbo.cdc_img')) AS after_rows,
       (SELECT count(*) FROM c1.cdc.changes('dbo.cdc_img', images := 'both')) AS both_rows;
----
3	5

# The extra rows are exactly the preimages, and they use the Delta change-feed spelling §3.3 chose.
query II
SELECT _change_type, count(*) FROM c1.cdc.changes('dbo.cdc_img', images := 'both')
GROUP BY _change_type ORDER BY _change_type;
----
insert	1
update_postimage	2
update_preimage	2

# ⚠ THE DEFAULT SHAPE IS UNCHANGED, and this is the assertion that keeps a new metadata column from becoming
# a breaking change for every existing caller: `_update_mask` must not exist unless it was asked for.
statement error
SELECT _update_mask FROM c1.cdc.changes('dbo.cdc_img');
----
_update_mask

query I
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_img', images := 'both') WHERE _update_mask IS NOT NULL;
----
5

# ⚠ `_changed_columns` rides with the mask and nowhere else — it is DERIVED from it, so a build that emitted
# one without the other would be reporting a decode of something it does not have.
statement error
SELECT _changed_columns FROM c1.cdc.changes('dbo.cdc_img');
----
_changed_columns

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM c1.cdc.changes('dbo.cdc_img', images := 'both'))
WHERE column_name = '_changed_columns';
----
_changed_columns	VARCHAR[]

# ⚠ NEVER NULL IN A CHANGE ROW — MEASURED, and it corrects the plausible story. An insert and a delete have
# no "columns changed" to report, so declaring the mask nullable looked obviously right; SQL Server reports
# ALL columns for them instead (0x03FF here — ten bits). The count above is the assertion.

# ═══ §30a  THE MAX-COLUMN TRAP, and the mask is what makes it decidable ════════════════════════════════
# ⚠⚠ MEASURED, and the measurement points the OPPOSITE way to the obvious guess: it is the BEFORE image that
# loses the value and the AFTER image that keeps it. The UPDATE above touched only `c2`, and `notes` held
# 'first' on both sides of it — yet the preimage reads NULL.

query III
SELECT _change_type, coalesce(notes, '<unrecorded>') AS notes, c2
FROM c1.cdc.changes('dbo.cdc_img', images := 'both')
WHERE _operation IN (3, 4) ORDER BY _position;
----
update_preimage	<unrecorded>	1
update_postimage	first	99
update_preimage	first	99
update_postimage	changed	99

# ⚠⚠ THE SECOND PAIR IS THE CONTROL, and without it the first row proves nothing — a build that had simply
# stopped returning `notes` at all would satisfy the NULL just as well. That UPDATE *did* touch `notes`, so
# its preimage carries the genuine prior value ('first', which the first update left untouched). Same
# column, same table, same mode; the only difference is whether the statement touched it.

# ⚠⚠ AND THIS IS WHY NO PLACEHOLDER IS SUBSTITUTED. A placeholder is a value, so it would be
# indistinguishable from a row that genuinely holds it — inventing data to signal missing data. The mask
# says which columns the update actually recorded, so "NULL and bit clear" (not recorded) and "NULL and bit
# set" (genuinely NULL) are two different, readable answers.
query III
SELECT _change_type,
       get_bit(_update_mask::BIT, (8 * octet_length(_update_mask) - 9)::INTEGER) AS notes_recorded,
       get_bit(_update_mask::BIT, (8 * octet_length(_update_mask) - 2)::INTEGER) AS c2_recorded
FROM c1.cdc.changes('dbo.cdc_img', images := 'both')
WHERE _operation IN (3, 4) ORDER BY _position;
----
update_preimage	0	1
update_postimage	0	1
update_preimage	1	0
update_postimage	1	0

# ⚠⚠ …AND `_changed_columns` IS THE SAME ANSWER WITHOUT THE ARITHMETIC, which is the point of shipping it.
# A consumer reading a NULL in a MAX column asks one question — "was this recorded?" — and this answers it
# by NAME, with no ordinal to look up, no bit index to get right and no byte order to get wrong.
query II
SELECT _change_type, list_contains(_changed_columns, 'notes') AS notes_recorded
FROM c1.cdc.changes('dbo.cdc_img', images := 'both')
WHERE _operation IN (3, 4) ORDER BY _position;
----
update_preimage	false
update_postimage	false
update_preimage	true
update_postimage	true

# The whole list, so the assertion above cannot pass on a build that returns a list of everything: an UPDATE
# reports ONLY what it touched, while an insert and a delete report every captured column (SQL Server's own
# answer — an insert does set them all).
query TT
SELECT _change_type, _changed_columns FROM c1.cdc.changes('dbo.cdc_img', images := 'both') ORDER BY _position;
----
insert	[id, c2, c3, c4, c5, c6, c7, c8, notes, tag]
update_preimage	[c2]
update_postimage	[c2]
update_preimage	[notes]
update_postimage	[notes]

# ⚠ `notes` is column_ordinal 9 and `c2` is 2 — from cdc.captured_columns, never counted by hand.
query II
SELECT cc.column_name, cc.column_ordinal FROM c1.cdc.captured_columns cc
JOIN c1.cdc.change_tables ct ON ct.object_id = cc.object_id
WHERE ct.capture_instance = 'img_v1' AND cc.column_name IN ('notes', 'c2')
ORDER BY cc.column_ordinal;
----
c2	2
notes	9

# ═══ §30b  The snapshot leg carries the mask column too — as NULL, which is a fact rather than a filler ══
# ⚠⚠ THE LOAD-BEARING ASSERTION FOR THE SNAPSHOT LIST'S EXPLICIT CONVERT. A baseline row has no update, so
# it has no mask; but a BARE `NULL` there describes as `int` where the change read gives `varbinary(128)`,
# the two legs' declared schemas then DIFFER, and the arrival check refuses EVERY snapshot. Slice 8 measured
# that trap twice for _change_type and _position; this is the third instance of it.
# ⚠ NULL rather than an all-bits-set mask, deliberately: all-bits-set would read as "this update changed
# every column", which is a claim about an event that never happened.
# ⚠ `_changed_columns` is NULL there too, and NOT an empty list: "this update changed nothing" and "this row
# is not an update" are different claims, and an empty list would assert the first about a baseline row.
query IIII
SELECT _change_type, _capture_instance IS NULL AS is_baseline, _update_mask IS NULL AS no_mask,
       _changed_columns IS NULL AS no_list
FROM c1.cdc.changes('dbo.cdc_img', include := 'snapshot', images := 'both');
----
insert	true	true	true

# ═══ §30c  ⚠⚠ THE MULTI-BYTE MASK — where the documented per-byte rule stops being right ═══════════════
# §1.4 records "bit index = column_ordinal - 1, little-endian within each byte", which is true and says
# NOTHING about byte order. MEASURED on this ten-column table: `c2` (ordinal 2) sets 0x0002 and `notes`
# (ordinal 9) sets 0x0100 — so ordinals 1-8 live in the LAST byte, not the first. The mask is a big-endian
# bit string over the WHOLE varbinary, and the natural `floor((ord-1)/8)` byte index is the wrong end.
query II
SELECT hex(_update_mask) AS mask, octet_length(_update_mask) AS bytes
FROM c1.cdc.changes('dbo.cdc_img', images := 'both')
WHERE _operation = 4 ORDER BY _position;
----
0002	2
0100	2

# ⚠⚠ THE DISCRIMINATOR: the naive per-byte formula and the correct whole-mask one DISAGREE, and the naive
# one reports the column that WAS touched as untouched. A consumer decoding that way silently mis-reads
# every table with more than eight captured columns — which is why the recipe is gated rather than only
# written down.
query III
SELECT hex(_update_mask) AS mask,
       get_bit(_update_mask::BIT, (8 * octet_length(_update_mask) - 9)::INTEGER) AS correct_notes,
       get_bit(_update_mask::BIT, (8 * ((9 - 1) // 8) + 7 - ((9 - 1) % 8))::INTEGER) AS naive_notes
FROM c1.cdc.changes('dbo.cdc_img', images := 'both')
WHERE _operation = 4 ORDER BY _position;
----
0002	0	0
0100	1	0

# ⚠⚠ AND `_changed_columns` AGREES WITH THE CORRECT COLUMN, NOT THE NAIVE ONE — which is what makes shipping
# it worth more than documenting the recipe. `0x0100` is ordinal 9, in the SECOND byte from the front and
# the FIRST from the end; a decoder indexing from the front reports it as untouched, and this row is what
# would catch that.
query TT
SELECT hex(_update_mask) AS mask, _changed_columns
FROM c1.cdc.changes('dbo.cdc_img', images := 'both')
WHERE _operation = 4 ORDER BY _position;
----
0002	[c2]
0100	[notes]

# ═══ §30d  images refusals — a value that is not a mode, and the one that never will be ════════════════
statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_img', images := 'all');
----
is not a value

# ⚠ 'net' is refused as an unknown value and is deliberately NOT named in the message (§1.7d): naming it
# would advertise a mode this reader has decided not to have, and the collapse is one line of DuckDB.
statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_img', images := 'net');
----
is not a value

# Case-insensitive, like every other option on this surface.
query I
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_img', images := 'BOTH');
----
5

# ═══ §31  TIMESTAMP BOUNDS — a window named in wall-clock time (slice 9) ═══════════════════════════════
# docs §1.6: sys.fn_cdc_map_time_to_lsn resolves an instant against cdc.lsn_time_mapping server-side, so the
# reader offers the bound without inventing anything. ⚠⚠ BOTH ARE INCLUSIVE, and that is deliberately NOT
# what a _position means: a position is a RESUME TOKEN naming a row already read, so it is exclusive, while a
# timestamp is an instant the caller has read nothing of. Treating the two alike would silently drop whatever
# committed exactly at the named instant.

statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.cdc_when'') IS NOT NULL DROP TABLE dbo.cdc_when; CREATE TABLE dbo.cdc_when(id INT NOT NULL PRIMARY KEY, v INT NULL);');

statement ok
SELECT target, changed FROM c1.cdc.enable('dbo.cdc_when', capture_instance := 'when_v1');

statement ok
SELECT fabricator_exec('c1', 'DECLARE @i int = 0; WHILE @i < 60 AND sys.fn_cdc_get_min_lsn(''when_v1'') IS NULL BEGIN WAITFOR DELAY ''00:00:01''; SET @i = @i + 1; END');

# ⚠ TWO batches separated by a real delay, and the delay is the fixture rather than padding: the bound is
# resolved against cdc.lsn_time_mapping, whose tran_end_time is a `datetime` with ~3.33 ms resolution, so two
# transactions in the same tick are indistinguishable BY DESIGN (§1.6). One second is far outside that.
statement ok
SELECT fabricator_exec('c1', 'INSERT INTO dbo.cdc_when (id, v) VALUES (1, 10), (2, 20);');

statement ok
SELECT fabricator_exec('c1', 'WAITFOR DELAY ''00:00:02''; INSERT INTO dbo.cdc_when (id, v) VALUES (3, 30);');

statement ok
SELECT fabricator_exec('c1', 'DECLARE @i int = 0; WHILE @i < 60 AND ((SELECT COUNT(*) FROM cdc.when_v1_CT) < 3 OR sys.fn_cdc_get_max_lsn() IS NULL OR sys.fn_cdc_get_max_lsn() < (SELECT MAX(__$start_lsn) FROM cdc.when_v1_CT)) BEGIN WAITFOR DELAY ''00:00:01''; SET @i = @i + 1; END');

# The control: with no bound at all, everything.
query I
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_when');
----
3

# ⚠ A bound naming an instant NOTHING has been captured at is an EMPTY window, not an error — in both
# directions. "What committed at or after next century" and "what committed before this server existed" both
# have the answer "nothing", and raising there would make a legitimate poll something a caller has to
# special-case. It is NOT the same as a below-the-floor bound, which IS refused (§31b): that one means the
# rows existed and were purged.
query II
SELECT (SELECT count(*) FROM c1.cdc.changes('dbo.cdc_when', starting_timestamp := TIMESTAMP '2099-01-01 00:00:00')) AS since_future,
       (SELECT count(*) FROM c1.cdc.changes('dbo.cdc_when', ending_timestamp := TIMESTAMP '1990-01-01 00:00:00')) AS until_prehistory;
----
0	0

# …and an upper bound comfortably in the future is every row, which is the positive control for the pair
# above: without it, two zeroes would pass equally on a build where the bound resolved to an empty window
# ALWAYS.
#
# ⚠⚠ `+ INTERVAL 1 DAY`, and NOT a bare `now()`, because a bare `now()` makes this assertion depend on the
# CLOCK OFFSET BETWEEN THE TWO MACHINES. MEASURED: a DuckDB session on Europe/Berlin reports
# now()::TIMESTAMP = 12:07:46 while the SQL Server host's SYSDATETIME() is 10:07:46 — two hours apart — and
# the bound is compared against tran_end_time, which is the SERVER's clock. Here that made the assertion
# pass for the wrong reason (the session happens to be EAST of the server, so its "now" is in the server's
# future); a session WEST of the server would have failed it. A day of slack is larger than any offset, so
# the assertion tests the bound rather than the rig's geography.
query I
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_when', ending_timestamp := now()::TIMESTAMP + INTERVAL 1 DAY);
----
3

# ═══ §31a  ⚠⚠ THE LOWER BOUND IS INCLUSIVE — asserted by handing a row's own commit time back ═══════════
# The sharpest available shape, and it is self-referential on purpose: take the commit timestamp of the row
# the second batch produced and pass it back as starting_timestamp. INCLUSIVE means that row comes back.
# 'smallest greater than OR EQUAL' is what makes it 1; 'smallest greater than' would make it 0, so this
# assertion is the operator.
statement ok
SET VARIABLE cdc_when_t2 = (SELECT _commit_timestamp FROM c1.cdc.changes('dbo.cdc_when', commit_timestamp := true) WHERE id = 3);

query I
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_when', starting_timestamp := getvariable('cdc_when_t2'));
----
1

query I
SELECT id FROM c1.cdc.changes('dbo.cdc_when', starting_timestamp := getvariable('cdc_when_t2'));
----
3

# …and the first batch's own commit time takes everything, which is the control that keeps the 1 above from
# passing on a build where any timestamp bound returned the last row.
statement ok
SET VARIABLE cdc_when_t1 = (SELECT min(_commit_timestamp) FROM c1.cdc.changes('dbo.cdc_when', commit_timestamp := true));

query I
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_when', starting_timestamp := getvariable('cdc_when_t1'));
----
3

# ⚠ The upper bound is inclusive too, and asserted the same way: bounding AT the first batch's instant keeps
# its two rows and excludes the third.
query I
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_when', ending_timestamp := getvariable('cdc_when_t1'));
----
2

# ═══ §31b  Refusals — one bound per side, and a snapshot has no lower bound to name ════════════════════
# ⚠ Per SIDE, not per call: a cursor lower bound with a wall-clock upper bound is a perfectly good window and
# is deliberately allowed. Only two bounds on the SAME side are a question rather than a combination.
statement ok
SET VARIABLE cdc_when_pos = (SELECT _position FROM c1.cdc.changes('dbo.cdc_when') WHERE id = 1);

query I
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_when', starting_position := getvariable('cdc_when_pos'), ending_timestamp := now()::TIMESTAMP + INTERVAL 1 DAY);
----
2

statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_when', starting_position := getvariable('cdc_when_pos'), starting_timestamp := getvariable('cdc_when_t1'));
----
two lower bounds

statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_when', ending_position := getvariable('cdc_when_pos'), ending_timestamp := getvariable('cdc_when_t1'));
----
two upper bounds

statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_when', include := 'snapshot+changes', starting_timestamp := getvariable('cdc_when_t1'));
----
a snapshot IS the starting point

statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_when', include := 'snapshot', ending_timestamp := now()::TIMESTAMP + INTERVAL 1 DAY);
----
not a window

# ⚠⚠ BELOW THE RETENTION FLOOR IS REFUSED, and the message names BOTH causes because this read cannot tell
# them apart: fn_cdc_map_time_to_lsn resolves against the DATABASE-wide cdc.lsn_time_mapping while the floor
# belongs to the INSTANCE, so an old timestamp on a recently captured table maps below the floor with nothing
# having been lost. Refusing is the safe half of that uncertainty — if changes WERE purged, reading on
# returns a short answer with nothing failing.
statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_when', starting_timestamp := TIMESTAMP '2020-01-01 00:00:00');
----
BELOW the retention floor


# ═══ §32  on_schema_change := 'resync' — re-capture and re-baseline (slice 8b) ═════════════════════════
# docs §22, and §15.9/§15.11 for why it is a POLICY rather than a mode. When a capture instance no longer
# describes its source — a column was ADDED, so it is not captured and the read silently omits it — 'resync'
# creates a fresh instance and answers with a BASELINE of the whole table in the new shape, plus a handoff to
# resume the stream from. ⚠ The trigger is a METADATA comparison decided at BIND, not the in-window DDL check
# the other two modes use: a resync changes the DECLARED output schema, and widening one mid-execute is what
# the arrival check correctly refuses.

statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.cdc_rs'') IS NOT NULL DROP TABLE dbo.cdc_rs; CREATE TABLE dbo.cdc_rs(id INT NOT NULL PRIMARY KEY, v INT NULL);');

# ⚠ A DEFAULT enable, so the instance carries the generated name AND the ownership marker — both are
# preconditions of a resync, and §32c asserts what happens without the second.
statement ok
SELECT target, changed FROM c1.cdc.enable('dbo.cdc_rs');

statement ok
SELECT fabricator_exec('c1', 'INSERT INTO dbo.cdc_rs (id, v) VALUES (1, 10), (2, 20); UPDATE dbo.cdc_rs SET v = 99 WHERE id = 1;');

statement ok
SELECT fabricator_exec('c1', 'DECLARE @inst sysname = (SELECT TOP 1 ct.capture_instance FROM cdc.change_tables ct JOIN sys.tables t ON t.object_id = ct.source_object_id WHERE t.name = ''cdc_rs''); DECLARE @i int = 0; WHILE @i < 60 AND sys.fn_cdc_get_min_lsn(@inst) IS NULL BEGIN WAITFOR DELAY ''00:00:01''; SET @i = @i + 1; END');

# The drift: a column the capture instance will never capture. ⚠ Its own statement — an ALTER and a
# reference to the column it adds cannot share a batch (SQL Server compiles the whole batch first).
statement ok
SELECT fabricator_exec('c1', 'ALTER TABLE dbo.cdc_rs ADD region VARCHAR(10) NULL;');

statement ok
SELECT fabricator_exec('c1', 'UPDATE dbo.cdc_rs SET region = ''eu'';');

# ⚠⚠ THE DECLARED SHAPE IS THE SOURCE'S CURRENT ONE, and that is the whole reason the decision is made at
# BIND. The default read cannot see `region` at all — it is not captured — so the two shapes differing IS the
# feature. Asserted as a pair so neither can pass alone.
query II
SELECT (SELECT count(*) FROM (DESCRIBE SELECT * FROM c1.cdc.changes('dbo.cdc_rs', on_schema_change := 'ignore')) WHERE column_name = 'region') AS ignore_sees,
       (SELECT count(*) FROM (DESCRIBE SELECT * FROM c1.cdc.changes('dbo.cdc_rs', on_schema_change := 'resync')) WHERE column_name = 'region') AS resync_sees;
----
0	1

# ⚠⚠ AND THE DESCRIBE ABOVE CAPTURED NOTHING. A resync performs DDL, so bind staying side-effect-free is not
# hygiene — it is what keeps an EXPLAIN, a DESCRIBE or a CREATE VIEW from re-capturing a table. Same split
# `enable := true` uses (§25).
query I
SELECT count(*) FROM c1.cdc.tables() WHERE source_table = 'cdc_rs';
----
1

# ⚠ A LOWER BOUND IS REFUSED, and it is refused BEFORE any DDL happens. A cursor says "continue from what I
# have read" and a resync answers with a fresh baseline instead, so honouring the cursor and re-baselining
# are two different reads — only the caller can choose which they meant.
statement ok
SET VARIABLE cdc_rs_pos = (SELECT _position FROM c1.cdc.changes('dbo.cdc_rs', on_schema_change := 'ignore') WHERE id = 2);

statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_rs', on_schema_change := 'resync', starting_position := getvariable('cdc_rs_pos'));
----
cannot be combined with a lower bound

statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_rs', on_schema_change := 'resync', starting_timestamp := TIMESTAMP '2026-01-01 00:00:00');
----
cannot be combined with a lower bound

# …and still no DDL, which is what makes the two refusals above safe to write in this order.
query I
SELECT count(*) FROM c1.cdc.tables() WHERE source_table = 'cdc_rs';
----
1

# ═══ §32a  The resync itself — a baseline in the NEW shape ═════════════════════════════════════════════
# ⚠⚠ IT FORCES THE SNAPSHOT LEG even though the caller asked for `changes`. A new capture instance starts
# capturing NOW, so its changes alone would silently begin at the resync instant and LOSE everything before
# it — a short read with nothing failing. Re-baselining IS the repair, and `region` is populated on every
# row because the snapshot reads the SOURCE.
query IIIII
SELECT _change_type, _capture_instance IS NULL AS baseline, id, v, region
FROM c1.cdc.changes('dbo.cdc_rs', on_schema_change := 'resync') ORDER BY id;
----
insert	true	1	99	eu
insert	true	2	20	eu

# ⚠ TWO instances now, and BOTH are ours — the new one carries the marker, so a later resync of it would be
# permitted by the same rule that permitted this one (were there room, which §32c shows there is not).
query I
SELECT count(*) FROM c1.cdc.tables() WHERE source_table = 'cdc_rs' AND fabricator_source IS NOT NULL;
----
2

# ⚠⚠ THE SECOND NAME IS THE FIRST PLUS `_b`, asserted as a RELATIONSHIP rather than as a literal. Two
# canonical names per table and a resync takes whichever is free (§17.3's deferred question, answered here);
# hard-coding the hash would pin the DIGEST, which §17.3 explicitly says may change without migration.
query I
SELECT max(capture_instance) = min(capture_instance) || '_b'
FROM c1.cdc.tables() WHERE source_table = 'cdc_rs';
----
true

# ═══ §32b  Resuming after a resync — the handoff joins the NEW instance's stream ════════════════════════
# ⚠ This is the assertion that makes the whole slice worth having: the baseline is only useful if the stream
# continues from it with no gap and no duplicate. The handoff comes out of the rows, exactly as the
# documented idiom says, and the resumed read names the NEW instance.

statement ok
SET VARIABLE cdc_rs_new = (SELECT max(capture_instance) FROM c1.cdc.tables() WHERE source_table = 'cdc_rs');

statement ok
SET VARIABLE cdc_rs_h = (SELECT DISTINCT _position FROM c1.cdc.changes('dbo.cdc_rs', capture_instance := getvariable('cdc_rs_new'), include := 'snapshot'));

statement ok
SELECT fabricator_exec('c1', 'INSERT INTO dbo.cdc_rs (id, v, region) VALUES (7, 70, ''us'');');

statement ok
SELECT fabricator_exec('c1', 'DECLARE @ct sysname = (SELECT TOP 1 QUOTENAME(''cdc'') + ''.'' + QUOTENAME(ct.capture_instance + ''_CT'') FROM cdc.change_tables ct JOIN sys.tables t ON t.object_id = ct.source_object_id WHERE t.name = ''cdc_rs'' ORDER BY ct.start_lsn DESC); DECLARE @sql nvarchar(max) = N''DECLARE @i int = 0; WHILE @i < 60 AND ((SELECT COUNT(*) FROM '' + @ct + N'') < 1 OR sys.fn_cdc_get_max_lsn() IS NULL OR sys.fn_cdc_get_max_lsn() < (SELECT MAX(__$start_lsn) FROM '' + @ct + N'')) BEGIN WAITFOR DELAY ''''00:00:01''''; SET @i = @i + 1; END''; EXEC sys.sp_executesql @sql;');

# Exactly the change that came AFTER the baseline, in the new shape. Not the two rows the baseline already
# carried (no duplicate), and not nothing (no gap).
query IIII
SELECT _change_type, id, v, region
FROM c1.cdc.changes('dbo.cdc_rs', capture_instance := getvariable('cdc_rs_new'),
                    starting_position := getvariable('cdc_rs_h'));
----
insert	7	70	us

# ═══ §32c  The refusals — a policy that destroys history is not a SELECT's to make ═════════════════════
# ⚠⚠ THE ONE REFUSAL THAT IS A DECISION RATHER THAN A LIMIT. SQL Server caps a table at TWO capture
# instances (§2.2), so a second resync can only proceed by DISABLING the older one — destroying whatever
# history nobody has read yet. Whether that is acceptable depends on where every consumer's cursor is, which
# this read cannot know, so it names the operator action instead of making an irreversible choice.
statement ok
SELECT fabricator_exec('c1', 'ALTER TABLE dbo.cdc_rs ADD extra INT NULL;');

statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_rs', on_schema_change := 'resync');
----
already has two capture instances

# …and the same table still reads fine across BOTH instances under the other two modes, which is what makes
# the refusal a redirection rather than a dead end.
query I
SELECT count(*) > 0 FROM c1.cdc.changes('dbo.cdc_rs', on_schema_change := 'ignore');
----
true

# ⚠⚠ AN INSTANCE WE DID NOT CREATE IS REFUSED (§15.9). Creating a capture instance and taking a full-table
# snapshot is a heavy, privileged act; doing it implicitly on a configuration a DBA chose is not ours to
# decide. `fabricator_source` is the marker and UNMARKED means not ours, full stop — there is deliberately no
# fallback that adopts one, because adopting one is exactly what this refusal exists to prevent.
statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.cdc_rsx'') IS NOT NULL DROP TABLE dbo.cdc_rsx; CREATE TABLE dbo.cdc_rsx(id INT NOT NULL PRIMARY KEY, v INT NULL);');

statement ok
SELECT fabricator_exec('c1', 'EXEC sys.sp_cdc_enable_table @source_schema = ''dbo'', @source_name = ''cdc_rsx'', @role_name = NULL, @capture_instance = ''rsx_dba'';');

statement ok
SELECT fabricator_exec('c1', 'ALTER TABLE dbo.cdc_rsx ADD region VARCHAR(10) NULL;');

# The control first: it really is unmarked, so the refusal below is about ownership and not about something
# else having gone wrong.
query I
SELECT fabricator_source IS NULL FROM c1.cdc.tables() WHERE source_table = 'cdc_rsx';
----
true

statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_rsx', on_schema_change := 'resync');
----
was not created by this extension

# ⚠ NOTHING STALE ⇒ NOTHING HAPPENS, and 'resync' is not 'ignore': the in-window DDL check still runs, so a
# drift it cannot repair (a type change, a drop) is still refused rather than swallowed. Here the captured
# set matches the source, so the read is ordinary and NO instance is created — which is the assertion, since
# a build that resynced unconditionally would pass the row count and fail this.
# ⚠ TWO STATEMENTS, NOT two scalar subqueries in one: DuckDB may evaluate the second before the first, so a
# single statement could read the instance count BEFORE the read that would have changed it — and then pass
# on a build that resyncs unconditionally. The order is the assertion, so it has to be written as one.
query I
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_when', on_schema_change := 'resync');
----
3

query I
SELECT count(*) FROM c1.cdc.tables() WHERE source_table = 'cdc_when';
----
1

# ⚠ 'fill' is implemented (§35) and it is a NO-OP here, because dbo.cdc_when's captured set still matches
# its source — there is nothing to project. That is the assertion, not an accident: these modes only act on
# a table that has actually drifted.
query I
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_when', on_schema_change := 'fill');
----
3

# An unknown value is refused, naming the five modes that exist rather than the caller's spelling.
statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_when', on_schema_change := 'nonsense');
----
is not a value



# ═══ §32d  retire_previous_instance — the operator action §32c's refusal names ═══════════════════════════
# ⚠⚠ THIS SECTION ONLY MEANS ANYTHING BECAUSE §32c RAN FIRST. That refusal names an action a caller then has
# to perform by copying an instance name out of an error message into cdc.disable; this is that action as one
# call, and the assertion that matters is not "it disabled something" but that THE READ §32c REFUSED NOW
# SUCCEEDS. A helper that destroyed the wrong instance would pass every count assertion here and fail that.
#
# ⚠ "OLDER" is asserted against the name §32b captured, NOT against a literal and NOT by sorting names. The
#   generated names are a digest plus a `_b` discriminator and a resync takes whichever the survivor is not
#   using, so `fab_<h>` is the NEWER one whenever the previous resync went the other way — ordering by name
#   would be wrong half the time and right often enough to look correct.
query I
SELECT changed FROM c1.cdc.retire_previous_instance('dbo.cdc_rs');
----
true

# The SURVIVOR is the one §32b resumed from — so the instance destroyed was the older one.
query I
SELECT capture_instance = getvariable('cdc_rs_new') FROM c1.cdc.tables() WHERE source_table = 'cdc_rs';
----
true

# ⚠ Idempotent, and a REPORTED no-op rather than an error: the point of the call is "leave this table with
#   one instance", and a table already in that state is a success. Erroring would make the obvious
#   retire-then-resync sequence fail whenever it had nothing to do.
query I
SELECT changed FROM c1.cdc.retire_previous_instance('dbo.cdc_rs');
----
false

# ⚠⚠ THE PAYOFF ASSERTION. §32c added `extra` and asserted the resync was REFUSED for want of a free slot.
#   The drift is still there and the slot is now free, so the identical statement must succeed — which is
#   what ties this helper to the thing it exists for. A build that retired the NEWER instance would also
#   answer here, which is why the survivor assertion above is separate and specific.
query I
SELECT count(*) >= 0 FROM c1.cdc.changes('dbo.cdc_rs', on_schema_change := 'resync');
----
true

query I
SELECT count(*) FROM c1.cdc.tables() WHERE source_table = 'cdc_rs';
----
2

# ⚠⚠ AN INSTANCE WE DID NOT CREATE IS NOT OURS TO DESTROY — the same line resync draws (§32c), and the check
#   is on the OLDER instance alone, since that is the one being destroyed. `dbo.cdc_rsx` already carries one
#   DBA-created instance from §32c; a second makes the table eligible by COUNT, so the refusal below is about
#   ownership and nothing else.
statement ok
SELECT fabricator_exec('c1', 'EXEC sys.sp_cdc_enable_table @source_schema = ''dbo'', @source_name = ''cdc_rsx'', @role_name = NULL, @capture_instance = ''rsx_dba2'';');

# The control: two instances, so a count-based guard would have let this through.
query I
SELECT count(*) FROM c1.cdc.tables() WHERE source_table = 'cdc_rsx';
----
2

statement error
SELECT changed FROM c1.cdc.retire_previous_instance('dbo.cdc_rsx');
----
not created by this extension

# …and it really did refuse rather than half-acting: both instances are still there.
query I
SELECT count(*) FROM c1.cdc.tables() WHERE source_table = 'cdc_rsx';
----
2

# ⚠ A table nobody captures is a reported no-op too, not an error — the same reasoning as the one-instance
#   case, and it keeps the function safe to call defensively before a resync.
query I
SELECT changed FROM c1.cdc.retire_previous_instance('dbo.cdc_none');
----
false

# ═══ §33  inc_position / dec_position — LSN ±1, and the wrap SQL Server does silently ══════════════════
# docs §25. sys.fn_cdc_increment_lsn / decrement_lsn, computed in C# because a scalar runs per BATCH and a
# round trip there would put a server call on every chunk of every query that uses one.

# ⚠⚠ THE AGREEMENT IS THE ASSERTION: ours beside SQL Server's own, in one statement, across a plain step, a
# byte carry, a multi-byte carry and a borrow. Without this the C# arithmetic is just a plausible story
# about big-endian bytes.
query TTTT
WITH ours(lbl, inc, dec) AS (
  SELECT lbl, hex(c1.cdc.inc_position(p)), hex(c1.cdc.dec_position(p)) FROM (VALUES
    ('a_plain',       '\x00\x00\x00\x2C\x00\x00\x0C\xC0\x00\x40'::BLOB),
    ('b_byte_carry',  '\x00\x00\x00\x2C\x00\x00\x0C\xC0\x00\xFF'::BLOB),
    ('c_multi_carry', '\x00\x00\x00\x2C\x00\x00\x0C\xFF\xFF\xFF'::BLOB),
    ('d_borrow',      '\x00\x00\x00\x2C\x00\x00\x0D\x00\x00\x00'::BLOB)) t(lbl, p)),
srv AS (SELECT * FROM fabricator_query('c1', '
  SELECT lbl, CONVERT(varchar(30), sys.fn_cdc_increment_lsn(p), 2) AS sinc,
              CONVERT(varchar(30), sys.fn_cdc_decrement_lsn(p), 2) AS sdec
  FROM (VALUES (''a_plain'',       0x0000002C00000CC00040),
               (''b_byte_carry'',  0x0000002C00000CC000FF),
               (''c_multi_carry'', 0x0000002C00000CFFFFFF),
               (''d_borrow'',      0x0000002C00000D000000)) v(lbl, p)'))
SELECT ours.lbl, ours.inc, CAST(ours.inc = srv.sinc AS VARCHAR) AS inc_matches_server,
       CAST(ours.dec = srv.sdec AS VARCHAR) AS dec_matches_server
FROM ours JOIN srv ON srv.lbl = ours.lbl ORDER BY ours.lbl;
----
a_plain	0000002C00000CC00041	true	true
b_byte_carry	0000002C00000CC00100	true	true
c_multi_carry	0000002C00000D000000	true	true
d_borrow	0000002C00000D000001	true	true

# NULL in, NULL out — matching the SQL functions and this surface's "an absent bound is a state" convention.
query II
SELECT c1.cdc.inc_position(NULL) IS NULL, c1.cdc.dec_position(NULL) IS NULL;
----
true	true

# ⚠⚠ THE WRAPS ARE REFUSED, and this is the whole reason these are not one-line pass-throughs. MEASURED:
# fn_cdc_decrement_lsn(0) answers 0xFF…FF and fn_cdc_increment_lsn(0xFF…FF) answers 0 — the OPPOSITE END of
# the range. As a window bound that is not a neighbouring position, and the zero LSN is additionally what
# fn_cdc_get_min_lsn answers for a capture instance that does not exist (§19), so it would surface as an
# entirely unrelated diagnostic three steps later.
statement error
SELECT c1.cdc.dec_position('\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00'::BLOB);
----
LOWEST representable

statement error
SELECT c1.cdc.inc_position('\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF'::BLOB);
----
HIGHEST representable

# ⚠⚠ A 21-BYTE _position IS REFUSED, and it is the sharp edge of the pair: stepping the LSN of a row's
# position moves PAST the other rows at that same LSN, so using the result as a lower bound would skip them
# SILENTLY. starting_position is already exclusive at full granularity, so it is also unnecessary.
statement error
SELECT c1.cdc.inc_position(c1.cdc.max_position() || '\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00'::BLOB);
----
21-byte _position is not accepted

# ⚠ CONSISTENT, not VOLATILE — so a call over constant arguments FOLDS at plan time, which is what makes it
# usable as a table-function argument at all (those must be constant). This is the assertion for that: the
# call sits in an argument position and binds.
query I
SELECT count(*) >= 0 FROM c1.cdc.changes('dbo.cdc_when',
  starting_position := c1.cdc.dec_position(c1.cdc.max_position()));
----
true

# ═══ §34  ddl_history() / lsn_time_mapping() — the CDC log, resolved and bounded ════════════════════════
# docs §26. Both tables are already reachable through the ATTACH; these add the three things a raw read
# makes a caller do by hand — resolving ids to names, bounding by an LSN window with the READER's
# exclusivity, and reading WITH (NOLOCK) so a diagnostic neither blocks the capture job nor waits on it.

statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.cdc_lg'') IS NOT NULL DROP TABLE dbo.cdc_lg; CREATE TABLE dbo.cdc_lg(id INT NOT NULL PRIMARY KEY, v INT NULL);');

statement ok
SELECT target, changed FROM c1.cdc.enable('dbo.cdc_lg', capture_instance := 'lg_v1');

statement ok
SELECT fabricator_exec('c1', 'DECLARE @i int = 0; WHILE @i < 60 AND sys.fn_cdc_get_min_lsn(''lg_v1'') IS NULL BEGIN WAITFOR DELAY ''00:00:01''; SET @i = @i + 1; END');

statement ok
SELECT fabricator_exec('c1', 'ALTER TABLE dbo.cdc_lg ADD extra INT NULL;');

statement ok
SELECT fabricator_exec('c1', 'ALTER TABLE dbo.cdc_lg ALTER COLUMN v BIGINT;');

statement ok
SELECT fabricator_exec('c1', 'DECLARE @i int = 0; WHILE @i < 60 AND (SELECT COUNT(*) FROM cdc.ddl_history h JOIN cdc.change_tables ct ON ct.object_id = h.object_id WHERE ct.capture_instance = ''lg_v1'') < 2 BEGIN WAITFOR DELAY ''00:00:01''; SET @i = @i + 1; END');

# ⚠ The raw table carries only object ids; these are resolved. And required_column_update discriminates
# exactly the ALTER COLUMN <type> — the ONE kind the capture job propagates to the change table (§18.3) —
# from an ADD, which it does not. Both rows are asserted so neither value can pass by being constant.
query TTTT
SELECT source_schema, source_table, CAST(required_column_update AS VARCHAR), ddl_command
FROM c1.cdc.ddl_history(source := 'dbo.cdc_lg') ORDER BY ddl_lsn;
----
dbo	cdc_lg	false	ALTER TABLE dbo.cdc_lg ADD extra INT NULL
dbo	cdc_lg	true	ALTER TABLE dbo.cdc_lg ALTER COLUMN v BIGINT

# ⚠ The bound is the READER'S — starting_position EXCLUSIVE — so the same cursor answers "which DDLs are in
# the window I am about to read". Nothing is above the current watermark, which is the bounded control.
query II
SELECT (SELECT count(*) FROM c1.cdc.ddl_history(source := 'dbo.cdc_lg')) AS unbounded,
       (SELECT count(*) FROM c1.cdc.ddl_history(source := 'dbo.cdc_lg',
                                                starting_position := c1.cdc.max_position())) AS after_now;
----
2	0

# The source filter matches a capture INSTANCE name as well as a schema.table, like every other source
# argument on this surface.
query I
SELECT count(*) FROM c1.cdc.ddl_history(source := 'lg_v1');
----
2

# lsn_time_mapping: the LSN <-> time bridge, one row per captured transaction, DATABASE-wide.
query III
SELECT count(*) > 0 AS has_rows, count(*) = count(start_lsn) AS every_row_has_an_lsn,
       count(tran_end_time) > 0 AS has_times
FROM c1.cdc.lsn_time_mapping();
----
true	true	true

# ⚠ Bounded the same way. `> max_position()` is empty by construction — nothing is captured above the
# watermark — and the unbounded count beside it is what stops that passing on an always-empty function.
query II
SELECT (SELECT count(*) > 0 FROM c1.cdc.lsn_time_mapping()) AS unbounded_has_rows,
       (SELECT count(*) FROM c1.cdc.lsn_time_mapping(starting_position := c1.cdc.max_position()))
         AS above_watermark;
----
true	0

# ═══ §35  on_schema_change := 'null' / 'fill' — projecting a column that was never captured ═════════════
# docs §27, and §15.9 for why these were scheduled last. Both answer the ADDED-column drift instead of
# refusing it: 'null' reports the column as NULL, 'fill' looks it up from the LIVE source by key.

statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.cdc_fn'') IS NOT NULL DROP TABLE dbo.cdc_fn; CREATE TABLE dbo.cdc_fn(id INT NOT NULL PRIMARY KEY, v INT NULL);');

statement ok
SELECT target, changed FROM c1.cdc.enable('dbo.cdc_fn', capture_instance := 'fn_v1');

statement ok
SELECT fabricator_exec('c1', 'DECLARE @i int = 0; WHILE @i < 60 AND sys.fn_cdc_get_min_lsn(''fn_v1'') IS NULL BEGIN WAITFOR DELAY ''00:00:01''; SET @i = @i + 1; END');

statement ok
SELECT fabricator_exec('c1', 'INSERT INTO dbo.cdc_fn (id, v) VALUES (1, 10), (2, 20); UPDATE dbo.cdc_fn SET v = 99 WHERE id = 1; DELETE FROM dbo.cdc_fn WHERE id = 2;');

statement ok
SELECT fabricator_exec('c1', 'ALTER TABLE dbo.cdc_fn ADD region VARCHAR(10) NULL;');

statement ok
SELECT fabricator_exec('c1', 'UPDATE dbo.cdc_fn SET region = ''eu'';');

statement ok
SELECT fabricator_exec('c1', 'DECLARE @i int = 0; WHILE @i < 60 AND ((SELECT COUNT(*) FROM cdc.fn_v1_CT) < 4 OR sys.fn_cdc_get_max_lsn() IS NULL OR sys.fn_cdc_get_max_lsn() < (SELECT MAX(__$start_lsn) FROM cdc.fn_v1_CT)) BEGIN WAITFOR DELAY ''00:00:01''; SET @i = @i + 1; END');

# ⚠⚠ THE THREE SHAPES SIDE BY SIDE, which is what makes each one mean something. Under 'ignore' the column
# is ABSENT — it was never captured, so the read simply omits it and a pipeline loses a field with nothing
# failing, which is the failure this whole option exists for.
query III
SELECT (SELECT count(*) FROM (DESCRIBE SELECT * FROM c1.cdc.changes('dbo.cdc_fn', on_schema_change := 'ignore')) WHERE column_name = 'region') AS ignore_has,
       (SELECT count(*) FROM (DESCRIBE SELECT * FROM c1.cdc.changes('dbo.cdc_fn', on_schema_change := 'null')) WHERE column_name = 'region') AS null_has,
       (SELECT count(*) FROM (DESCRIBE SELECT * FROM c1.cdc.changes('dbo.cdc_fn', on_schema_change := 'fill')) WHERE column_name = 'region') AS fill_has;
----
0	1	1

# ⚠⚠ THE TYPE IS THE SOURCE COLUMN'S, and that is the measurement the whole implementation rests on: a bare
# NULL describes as `int`, so the declared and arrived schemas would differ and the arrival check would
# refuse every row. It comes from a TOP 0 scalar subquery over the source, which carries the column's exact
# type without a SQL type name being written down anywhere.
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM c1.cdc.changes('dbo.cdc_fn', on_schema_change := 'null'))
WHERE column_name = 'region';
----
region	VARCHAR

query TTTT
SELECT _change_type, id, v, coalesce(region, '<null>') FROM c1.cdc.changes('dbo.cdc_fn', on_schema_change := 'null') ORDER BY _position;
----
insert	1	10	<null>
insert	2	20	<null>
update_postimage	1	99	<null>
delete	2	20	<null>

# ⚠⚠ 'fill' AND ITS COST IN ONE RESULT. Row id=1 still exists on the source, so `region` fills with 'eu' —
# INCLUDING on its `insert` row, where the column did not exist yet and its value at that instant was
# nothing at all. That is §15.9's TORN ROW, and it is asserted rather than described because a reader of the
# docs deserves to see it. Row id=2 was DELETED, so there is no source row to look up and it fills NULL:
# honest, and not a gap.
query TTTT
SELECT _change_type, id, v, coalesce(region, '<null>') FROM c1.cdc.changes('dbo.cdc_fn', on_schema_change := 'fill') ORDER BY _position;
----
insert	1	10	eu
insert	2	20	<null>
update_postimage	1	99	eu
delete	2	20	<null>

# ⚠ A column-set DDL inside the window is ABSORBED by these two modes — without that they would project the
# column and then refuse to return it, which is exactly what happened the first time they ran. A window
# containing this ADD is refused under the default and read under 'null'.
statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_fn');
----
schema change

# ⚠⚠ 'fill' NEEDS A CAPTURED KEY, and §15.9 predicted this would bite exactly the tables that most need
# help: no primary key and no unique index is a legitimate configuration, and then there is nothing to
# correlate a change row back to its source row with. 'null' still works there, which is what the refusal
# points at.
statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.cdc_nk'') IS NOT NULL DROP TABLE dbo.cdc_nk; CREATE TABLE dbo.cdc_nk(id INT NULL, v INT NULL);');

statement ok
SELECT target, changed FROM c1.cdc.enable('dbo.cdc_nk', capture_instance := 'nk_v1');

statement ok
SELECT fabricator_exec('c1', 'ALTER TABLE dbo.cdc_nk ADD region VARCHAR(10) NULL;');

statement error
SELECT count(*) FROM c1.cdc.changes('dbo.cdc_nk', on_schema_change := 'fill');
----
no primary key and no unique index

# …and the control: the same table under 'null' binds, because 'null' needs no key at all.
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM c1.cdc.changes('dbo.cdc_nk', on_schema_change := 'null'))
WHERE column_name = 'region';
----
1

# Nothing stale ⇒ nothing projected: the modes are no-ops on a table whose captured set still matches its
# source, which is the assertion that stops them being unconditional. Asserted as an EQUALITY against the
# ignore shape rather than as a literal count, so it cannot drift with the fixture's column list.
query I
SELECT (SELECT count(*) FROM (DESCRIBE SELECT * FROM c1.cdc.changes('dbo.cdc_when', on_schema_change := 'null')))
     = (SELECT count(*) FROM (DESCRIBE SELECT * FROM c1.cdc.changes('dbo.cdc_when', on_schema_change := 'ignore')));
----
true

# ═══ §9  Teardown — leave NO CDC-enabled table behind ══════════════════════════════════════════════════
# Load-bearing: the capture job keeps scanning a CDC-enabled database between runs, and the next run's §3
# would then find max_position() non-NULL and fail for a reason unrelated to the code.

# Same retry as §0, same reason.
statement ok
SELECT fabricator_exec('c1', 'DECLARE @t int = 0; WHILE @t < 10 BEGIN SET @t = @t + 1; BEGIN TRY IF EXISTS (SELECT 1 FROM sys.databases WHERE database_id = DB_ID() AND is_cdc_enabled = 1) EXEC sys.sp_cdc_disable_db; BREAK; END TRY BEGIN CATCH IF @t >= 10 THROW; WAITFOR DELAY ''00:00:01''; END CATCH END');

statement ok
SELECT fabricator_exec('c1', 'DROP TABLE dbo.cdc_probe;');

statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.cdc_setup'') IS NOT NULL DROP TABLE dbo.cdc_setup;');

statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.cdc_zz_noidx'') IS NOT NULL DROP TABLE dbo.cdc_zz_noidx;');

statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.cdc_span'') IS NOT NULL DROP TABLE dbo.cdc_span; IF OBJECT_ID(''dbo.cdc_conf'') IS NOT NULL DROP TABLE dbo.cdc_conf; IF OBJECT_ID(''dbo.cdc_snap'') IS NOT NULL DROP TABLE dbo.cdc_snap; IF OBJECT_ID(''dbo.cdc_seed'') IS NOT NULL DROP TABLE dbo.cdc_seed; IF OBJECT_ID(''dbo.cdc_void'') IS NOT NULL DROP TABLE dbo.cdc_void; IF OBJECT_ID(''dbo.cdc_img'') IS NOT NULL DROP TABLE dbo.cdc_img; IF OBJECT_ID(''dbo.cdc_when'') IS NOT NULL DROP TABLE dbo.cdc_when; IF OBJECT_ID(''dbo.cdc_rs'') IS NOT NULL DROP TABLE dbo.cdc_rs; IF OBJECT_ID(''dbo.cdc_rsx'') IS NOT NULL DROP TABLE dbo.cdc_rsx; IF OBJECT_ID(''dbo.cdc_lg'') IS NOT NULL DROP TABLE dbo.cdc_lg; IF OBJECT_ID(''dbo.cdc_fn'') IS NOT NULL DROP TABLE dbo.cdc_fn; IF OBJECT_ID(''dbo.cdc_nk'') IS NOT NULL DROP TABLE dbo.cdc_nk;');

statement ok
SELECT fabricator_exec('c1', 'IF OBJECT_ID(''dbo.cdc_gen'') IS NOT NULL DROP TABLE dbo.cdc_gen; IF OBJECT_ID(''dbo.cdc_own'') IS NOT NULL DROP TABLE dbo.cdc_own; IF OBJECT_ID(''dbo.cdc_auto'') IS NOT NULL DROP TABLE dbo.cdc_auto; IF OBJECT_ID(''dbo.cdc_ddl'') IS NOT NULL DROP TABLE dbo.cdc_ddl; IF OBJECT_ID(''dbo.gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg'') IS NOT NULL DROP TABLE dbo.gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg;');

# Back to §3's state, which is also the cheapest possible check that the teardown really disabled it.
query I
SELECT c1.cdc.max_position() IS NULL;
----
true

query I
SELECT count(*) FROM c1.cdc.tables();
----
0
