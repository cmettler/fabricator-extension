# name: test/verify_delta_catalog_overwrite_merge.test
# description: Delta write options — atomic partition overwrite (replace_where) + schema evolution.
#   * replace_where {partcol:val}: an INSERT becomes an ATOMIC partition overwrite (one commit) — engineered-wood
#     OverwritePartitionsAsync removes the matching partition's files + adds the new data. Keys must be partition
#     columns; input must fall within them.
#   * CREATE OR REPLACE is a TRUE replace: the table adopts EXACTLY the new SELECT's schema (a dropped column is
#     gone, not lingering NULL; a new column appears) — engineered-wood SetSchemaAsync emits a fresh metaData.
#   * COPY SCHEMA_MODE 'merge': append + UNION new source columns (old rows NULL). COPY bypasses DuckDB's INSERT
#     binder, so wider source schemas reach the provider (a plain INSERT of wider data can't — binder-blocked).
#   * COPY SCHEMA_MODE 'overwrite': replace data + adopt the incoming source schema (drop/add columns).
#   Set FABRICATOR_DELTA_WRITE_DIR to a WRITABLE base path. Local FS. (Decimals avoided — a separate provider bug.)
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/owm' AS lake (TYPE fabricator, PROVIDER 'delta', column_mapping 'none');

# ================= replace_where: atomic partition overwrite =================
statement ok
CREATE TABLE lake.main.sales PARTITIONED BY (region) AS
  SELECT * FROM (VALUES (1,'US',10),(2,'US',20),(3,'EU',30),(4,'EU',40)) AS t(id,region,amt);

statement ok
SET delta_write_options='{"replace_where":{"region":"EU"}}';

statement ok
INSERT INTO lake.main.sales SELECT * FROM (VALUES (5,'EU',500),(6,'EU',600),(7,'EU',700)) AS t(id,region,amt);

statement ok
SET delta_write_options='';

query TII
SELECT region, count(*), sum(amt) FROM lake.main.sales GROUP BY region ORDER BY region;
----
EU	3	1800
US	2	30

# One commit for the swap (v0 CREATE, v1 initial, v2 partition overwrite).
query I
SELECT count(*) FROM fabricator_delta_snapshots('lake', 'main.sales');
----
3

# replace_where on a non-partition column errors.
statement ok
SET delta_write_options='{"replace_where":{"amt":"10"}}';

statement error
INSERT INTO lake.main.sales SELECT * FROM (VALUES (9,'US',10)) AS t(id,region,amt);
----

statement ok
SET delta_write_options='';

# ================= CREATE OR REPLACE = TRUE replace (adopt the new schema) =================
statement ok
CREATE TABLE lake.main.rep AS SELECT * FROM (VALUES (1,'x',100),(2,'y',200)) AS t(id,val,extra);

# Narrower SELECT: the dropped column is GONE (not a lingering NULL).
statement ok
CREATE OR REPLACE TABLE lake.main.rep AS SELECT * FROM (VALUES (9,'z')) AS t(id,val);

query IT
SELECT * FROM lake.main.rep ORDER BY id;
----
9	z

# The dropped column is absent from the schema (exactly 2 columns now).
query I
SELECT count(*) FROM (DESCRIBE lake.main.rep);
----
2

# Wider CREATE OR REPLACE: the new column appears (also a true replace).
statement ok
CREATE OR REPLACE TABLE lake.main.rep AS SELECT * FROM (VALUES (5,'p',1,2),(6,'q',3,4)) AS t(id,val,a,b);

query ITII
SELECT id, val, a, b FROM lake.main.rep ORDER BY id;
----
5	p	1	2
6	q	3	4

# ================= COPY SCHEMA_MODE 'merge' (append + union) =================
statement ok
CREATE TABLE lake.main.mrg AS SELECT * FROM (VALUES (1,'a')) AS t(id,val);

statement ok
COPY (SELECT * FROM (VALUES (2,'b',7),(3,'c',8)) AS t(id,val,extra)) TO 'lake.main.mrg'
  (FORMAT mssql, CREATE_TABLE false, SCHEMA_MODE 'merge');

query ITI
SELECT id, val, extra FROM lake.main.mrg ORDER BY id;
----
1	a	NULL
2	b	7
3	c	8

# ================= COPY SCHEMA_MODE 'overwrite' (replace data + adopt source schema) =================
statement ok
CREATE TABLE lake.main.ow AS SELECT * FROM (VALUES (1,'a',100),(2,'b',200)) AS t(id,val,old);

statement ok
COPY (SELECT * FROM (VALUES (9,'z',777)) AS t(id,val,newcol)) TO 'lake.main.ow'
  (FORMAT mssql, SCHEMA_MODE 'overwrite');

# Data replaced; schema adopted (old dropped, newcol added).
query ITI
SELECT id, val, newcol FROM lake.main.ow ORDER BY id;
----
9	z	777

query I
SELECT count(*) FROM (DESCRIBE lake.main.ow);
----
3

statement ok
DETACH lake;
