# name: test/verify_ducklake_delta_sync.test
# description: ducklake_delta_sync writes a Delta log next to a DuckLake table's data files, so a Delta-only
#              reader reads the SAME Parquet files DuckLake wrote. Each section reads the result back through
#              BOTH of our Delta readers (fabricator_delta_scan and a PROVIDER 'delta' catalog) and compares it
#              with DuckLake itself — values AND row ids, since DuckLake's row_id_start is the Delta baseRowId.
#              The lake's metadata is a DuckDB file here; the sync reads it through DuckDB, so the backend does
#              not matter. See docs/ducklake-catalog.md §11. Set FABRICATOR_DELTA_WRITE_DIR. Local FS.
# group: [fabricator]

require fabricator

require ducklake

require parquet

require json

require icu

require httpfs

require-env FABRICATOR_DELTA_WRITE_DIR

statement ok
ATTACH 'ducklake:{FABRICATOR_DELTA_WRITE_DIR}/meta.ducklake' AS lake (DATA_PATH '{FABRICATOR_DELTA_WRITE_DIR}/dl/', DATA_INLINING_ROW_LIMIT 0);

# ============================================================================
# 1. THE FIRST SYNC IS ONE COMMIT AT THE CURRENT SNAPSHOT — with deletion vectors for both delete forms (a
#    delete into a file, then a second delete into the SAME file, which makes DuckLake REPLACE the delete
#    file rather than add one) and an UPDATE (a new file carrying the original row id).
# ============================================================================

statement ok
CREATE TABLE lake.t (id INTEGER, v VARCHAR);

statement ok
INSERT INTO lake.t SELECT i, 'v' || i FROM range(1000) r(i);

statement ok
INSERT INTO lake.t SELECT i, 'w' || i FROM range(1000, 1500) r(i);

statement ok
DELETE FROM lake.t WHERE id IN (3, 7);

statement ok
DELETE FROM lake.t WHERE id BETWEEN 100 AND 199;

statement ok
UPDATE lake.t SET v = 'u' WHERE id = 1200;

query TTIIII
SELECT schema_name, table_name, delta_version, files_added, files_removed, deletion_vectors FROM ducklake_delta_sync('lake');
----
main	t	0	3	0	2

query IIII
SELECT count(*), sum(id), count(*) FILTER (WHERE v = 'u'), count(DISTINCT v) FROM fabricator_delta_scan('{FABRICATOR_DELTA_WRITE_DIR}/dl/main/t');
----
1398	1109290	1	1398

query IIII
SELECT count(*), sum(id), count(*) FILTER (WHERE v = 'u'), count(DISTINCT v) FROM lake.t;
----
1398	1109290	1	1398

# The protocol and configuration the mirror declares, and that the timestamp default needs no feature here.
query I
SELECT content LIKE '%"readerFeatures":["columnMapping","deletionVectors"]%'
   AND content LIKE '%"writerFeatures":["columnMapping","deletionVectors","domainMetadata","rowTracking"]%'
   AND content LIKE '%"delta.columnMapping.mode":"name"%'
   AND content LIKE '%"delta.rowTracking.materializedRowIdColumnName":"_ducklake_internal_row_id"%'
   AND content LIKE '%"txn":{"appId":"ducklake"%'
FROM read_text('{FABRICATOR_DELTA_WRITE_DIR}/dl/main/t/_delta_log/00000000000000000000.json');
----
true

# A sync with nothing new commits nothing.
query I
SELECT count(*) FROM ducklake_delta_sync('lake');
----
0

# ============================================================================
# 2. ROW IDS: DuckLake's rowid IS the Delta row id, for every row — the updated row 1200 lives in a file whose
#    baseRowId is 1500 and gets its id from the materialized _ducklake_internal_row_id column.
# ============================================================================

statement ok
ATTACH '{FABRICATOR_DELTA_WRITE_DIR}/dl' AS d (TYPE fabricator, PROVIDER 'delta', schemas true);

query I
SELECT count(*) FROM (
  (SELECT id, v, rowid AS r FROM lake.t EXCEPT ALL SELECT id, v, __delta_row_id FROM d.main.t)
  UNION ALL
  (SELECT id, v, __delta_row_id FROM d.main.t EXCEPT ALL SELECT id, v, rowid FROM lake.t));
----
0

query II
SELECT id, __delta_row_id FROM d.main.t WHERE id IN (0, 1200, 1499) ORDER BY id;
----
0	0
1200	1200
1499	1499

statement ok
DETACH d;

# ============================================================================
# 3. INCREMENTAL: ONE DELTA VERSION PER DUCKLAKE SNAPSHOT — an insert, a delete into a file that already has a
#    vector (the vector GROWS: remove + re-add), ADD COLUMN, and INT -> BIGINT, which writes typeWidening.
# ============================================================================

statement ok
INSERT INTO lake.t SELECT i, 'x' || i FROM range(2000, 2300) r(i);

statement ok
DELETE FROM lake.t WHERE id BETWEEN 500 AND 509;

statement ok
ALTER TABLE lake.t ADD COLUMN n DOUBLE;

statement ok
ALTER TABLE lake.t ALTER COLUMN id SET DATA TYPE BIGINT;

statement ok
INSERT INTO lake.t VALUES (5000000000, 'big', 2.5);

query IIIIII
SELECT count(*), min(delta_version), max(delta_version), sum(files_added), sum(files_removed), sum(deletion_vectors)
FROM ducklake_delta_sync('lake', table_name := 'main.t');
----
5	1	5	2	1	1

query I
SELECT content LIKE '%"typeWidening"%' AND content LIKE '%typeChanges%'
FROM read_text('{FABRICATOR_DELTA_WRITE_DIR}/dl/main/t/_delta_log/00000000000000000004.json');
----
true

statement ok
ATTACH '{FABRICATOR_DELTA_WRITE_DIR}/dl' AS d (TYPE fabricator, PROVIDER 'delta', schemas true);

query IIII
SELECT count(*), sum(id), sum(n), typeof(any_value(id)) FROM d.main.t;
----
1689	5001749095	2.5	BIGINT

query IIII
SELECT count(*), sum(id), sum(n), typeof(any_value(id)) FROM lake.t;
----
1689	5001749095	2.5	BIGINT

query I
SELECT count(*) FROM (
  (SELECT id, v, n, rowid AS r FROM lake.t EXCEPT ALL SELECT id, v, n, __delta_row_id FROM d.main.t)
  UNION ALL
  (SELECT id, v, n, __delta_row_id FROM d.main.t EXCEPT ALL SELECT id, v, n, rowid FROM lake.t));
----
0

statement ok
DETACH d;

# ============================================================================
# 4. CHECKPOINTS, AND DUCKLAKE'S OWN CHECKPOINT. A Delta checkpoint is Parquet in the table folder, which
#    DuckLake's orphan cleanup deletes unless the GLOBAL auto_compact is false; so the sync writes one only
#    then. With it false and the schema's true, a DuckLake CHECKPOINT still compacts and leaves ours alone.
# ============================================================================

statement ok
CALL lake.set_option('auto_compact', false);

statement ok
CALL lake.set_option('auto_compact', true, schema => 'main');

statement ok
CALL lake.set_option('delete_older_than', '0 seconds');

statement ok
INSERT INTO lake.t VALUES (6001, 'c', 0);

statement ok
INSERT INTO lake.t VALUES (6002, 'c', 0);

statement ok
INSERT INTO lake.t VALUES (6003, 'c', 0);

statement ok
INSERT INTO lake.t VALUES (6004, 'c', 0);

statement ok
INSERT INTO lake.t VALUES (6005, 'c', 0);

query II
SELECT max(delta_version), bool_or(checkpoint) FROM ducklake_delta_sync('lake', table_name := 'main.t');
----
10	true

statement ok
CHECKPOINT lake;

query I
SELECT count(*) FROM glob('{FABRICATOR_DELTA_WRITE_DIR}/dl/main/t/_delta_log/*.checkpoint.parquet');
----
1

# DuckLake compacted (files replaced) — and may already have deleted the old ones, so only a sync makes the
# Delta log readable again (the cleanup ordering, docs/ducklake-catalog.md §11.4).
query I
SELECT sum(files_removed) > 0 FROM ducklake_delta_sync('lake', table_name := 'main.t');
----
true

statement ok
ATTACH '{FABRICATOR_DELTA_WRITE_DIR}/dl' AS d (TYPE fabricator, PROVIDER 'delta', schemas true);

query I
SELECT count(*) FROM (
  (SELECT id, v, n, rowid AS r FROM lake.t EXCEPT ALL SELECT id, v, n, __delta_row_id FROM d.main.t)
  UNION ALL
  (SELECT id, v, n, __delta_row_id FROM d.main.t EXCEPT ALL SELECT id, v, n, rowid FROM lake.t));
----
0

query I
SELECT count(*) FROM d.main.t;
----
1694

statement ok
DETACH d;

# ============================================================================
# 5. WHAT DELTA CANNOT EXPRESS IS REFUSED, NOT MIRRORED WRONG.
# ============================================================================

# A rename with no file written since is fine: the physical name stays the old one.
statement ok
CREATE TABLE lake.r1 (a INTEGER, b VARCHAR);

statement ok
INSERT INTO lake.r1 VALUES (1, 'x'), (2, 'y');

statement ok
ALTER TABLE lake.r1 RENAME COLUMN b TO b2;

query I
SELECT count(*) FROM ducklake_delta_sync('lake', table_name := 'main.r1');
----
1

query IT
SELECT a, b2 FROM fabricator_delta_scan('{FABRICATOR_DELTA_WRITE_DIR}/dl/main/r1') ORDER BY a;
----
1	x
2	y

# ... a file under the new name beside the old ones is not, in 'name' mapping.
statement ok
INSERT INTO lake.r1 VALUES (3, 'z');

statement error
SELECT * FROM ducklake_delta_sync('lake', table_name := 'main.r1');
----
was renamed and live data files use both names ('b', 'b2')

# The same history in 'id' mapping mirrors fine.
statement ok
CREATE TABLE lake.r4 (a INTEGER, b VARCHAR);

statement ok
INSERT INTO lake.r4 VALUES (1, 'x');

statement ok
ALTER TABLE lake.r4 RENAME COLUMN b TO b2;

statement ok
INSERT INTO lake.r4 VALUES (2, 'y');

query I
SELECT count(*) FROM ducklake_delta_sync('lake', table_name := 'main.r4', column_mapping := 'id');
----
1

query IT
SELECT a, b2 FROM fabricator_delta_scan('{FABRICATOR_DELTA_WRITE_DIR}/dl/main/r4') ORDER BY a;
----
1	x
2	y

# Dropping a column and re-adding one under its name: the old values would come back.
statement ok
CREATE TABLE lake.r2 (a INTEGER, b VARCHAR);

statement ok
INSERT INTO lake.r2 VALUES (1, 'old');

statement ok
ALTER TABLE lake.r2 DROP COLUMN b;

statement ok
ALTER TABLE lake.r2 ADD COLUMN b VARCHAR;

statement error
SELECT * FROM ducklake_delta_sync('lake', table_name := 'main.r2');
----
reuses the name of a dropped column whose values are still in live data files

# A default for rows of older files: Delta would read NULL there.
statement ok
CREATE TABLE lake.r3 (a INTEGER);

statement ok
INSERT INTO lake.r3 VALUES (1);

statement ok
ALTER TABLE lake.r3 ADD COLUMN d INTEGER DEFAULT 42;

statement error
SELECT * FROM ducklake_delta_sync('lake', table_name := 'main.r3');
----
was added with a default (42)

# A type Delta has no form for.
statement ok
CREATE TABLE lake.r5 (a INTEGER, t TIME);

statement ok
INSERT INTO lake.r5 VALUES (1, TIME '01:02:03');

statement error
SELECT * FROM ducklake_delta_sync('lake', table_name := 'main.r5');
----
column 't' has type time

# ============================================================================
# 6. TIMESTAMPS DEFAULT TO 'utc' — Fabric's SQL endpoint refuses timestamp_ntz (docs/ducklake-catalog.md
#    §11.6) — so the value is declared a Delta timestamp, no timestampNtz feature, and reads back as the same
#    wall clock in UTC. 'ntz' keeps the spec's type.
# ============================================================================

statement ok
CREATE TABLE lake.ts1 (id INTEGER, ts TIMESTAMP);

statement ok
INSERT INTO lake.ts1 VALUES (1, TIMESTAMP '2024-05-06 07:08:09');

statement ok
CREATE TABLE lake.ts2 (id INTEGER, ts TIMESTAMP);

statement ok
INSERT INTO lake.ts2 VALUES (1, TIMESTAMP '2024-05-06 07:08:09');

query I
SELECT count(*) FROM ducklake_delta_sync('lake', table_name := 'main.ts1');
----
1

query I
SELECT count(*) FROM ducklake_delta_sync('lake', table_name := 'main.ts2', timestamp_mapping := 'ntz');
----
1

query II
SELECT content LIKE '%"fabricator.ducklake.timestampMapping":"utc"%', content LIKE '%timestampNtz%'
FROM read_text('{FABRICATOR_DELTA_WRITE_DIR}/dl/main/ts1/_delta_log/00000000000000000000.json');
----
true	false

query II
SELECT content LIKE '%"fabricator.ducklake.timestampMapping":"ntz"%', content LIKE '%timestampNtz%'
FROM read_text('{FABRICATOR_DELTA_WRITE_DIR}/dl/main/ts2/_delta_log/00000000000000000000.json');
----
true	true

statement ok
SET TimeZone = 'UTC';

query T
SELECT strftime(ts, '%Y-%m-%d %H:%M:%S') FROM fabricator_delta_scan('{FABRICATOR_DELTA_WRITE_DIR}/dl/main/ts1');
----
2024-05-06 07:08:09

statement error
SELECT * FROM ducklake_delta_sync('lake', timestamp_mapping := 'local');
----
timestamp_mapping must be 'ntz' or 'utc'

# ============================================================================
# 8. NO COORDINATOR: SEVERAL SYNCS AT ONCE. Each one reads the log, computes the next version and creates it
#    put-if-absent; the losers re-read and continue from the winner. Afterwards every DuckLake snapshot is in
#    the log EXACTLY ONCE and in ascending order, and the data equals the lake's.
# ============================================================================

statement ok
CREATE TABLE lake.race (id INTEGER, v VARCHAR);

statement ok
INSERT INTO lake.race SELECT i, 'a' FROM range(100) r(i);

query I
SELECT count(*) FROM ducklake_delta_sync('lake', table_name := 'main.race');
----
1

loop i 0 12

statement ok
INSERT INTO lake.race VALUES (1000 + ${i}, 'b');

endloop

statement ok
DELETE FROM lake.race WHERE id < 10;

concurrentloop k 0 6

statement ok
SELECT * FROM ducklake_delta_sync('lake', table_name := 'main.race');

endloop

# one version per snapshot, none twice, ascending with the version number
query III
WITH commits AS (
  SELECT regexp_extract(filename, '(\d+)\.json$', 1)::BIGINT AS version,
         regexp_extract(content, '"ducklakeSnapshot":"(\d+)"', 1)::BIGINT AS snapshot
  FROM read_text('{FABRICATOR_DELTA_WRITE_DIR}/dl/main/race/_delta_log/*.json'))
SELECT count(*), count(DISTINCT snapshot),
       bool_and(snapshot > coalesce(prev, -1))
FROM (SELECT version, snapshot, lag(snapshot) OVER (ORDER BY version) AS prev FROM commits);
----
14	14	true

query II
SELECT count(*), sum(id) FROM fabricator_delta_scan('{FABRICATOR_DELTA_WRITE_DIR}/dl/main/race');
----
102	16971

query II
SELECT count(*), sum(id) FROM lake.race;
----
102	16971

# ============================================================================
# 8b. THE SAME RACE OVER MANY SNAPSHOTS, WITH DELETES BETWEEN THEM. Two defects (found 2026-10-31 from a red
#     Windows CI run of §8). (1) A sync counted EVERY lost race against its retry budget of 32, although each loss
#     means another sync made progress: 6 syncs over 76 snapshots failed "version N already exists" 3 of 3 runs.
#     Now only a loss WITHOUT progress counts. (2) After its own commit a sync re-read the log, by then holding
#     other syncs' commits, and diffed its next, OLDER snapshot against it: across a delete that reads as deleted
#     rows coming back ("deletes cannot shrink", not retried — the CI failure). It skips snapshots already
#     recorded now. ⚠ (2) is timing: it happens 1-2 times a run here, but the stale commit almost always loses
#     the next race, so this section kills mutant (1) every run and mutant (2) only occasionally.
# ============================================================================

statement ok
CREATE TABLE lake.race2 (id INTEGER, v VARCHAR);

statement ok
INSERT INTO lake.race2 SELECT i, 'a' FROM range(100) r(i);

query I
SELECT count(*) FROM ducklake_delta_sync('lake', table_name := 'main.race2');
----
1

loop i 0 4

statement ok
INSERT INTO lake.race2 VALUES (1000 + ${i}, 'b');

endloop

statement ok
DELETE FROM lake.race2 WHERE id < 10;

loop i 0 70

statement ok
INSERT INTO lake.race2 VALUES (2000 + ${i}, 'c');

endloop

statement ok
DELETE FROM lake.race2 WHERE id >= 10 AND id < 20;

concurrentloop k 0 6

statement ok
SELECT * FROM ducklake_delta_sync('lake', table_name := 'main.race2');

endloop

query III
WITH commits AS (
  SELECT regexp_extract(filename, '(\d+)\.json$', 1)::BIGINT AS version,
         regexp_extract(content, '"ducklakeSnapshot":"(\d+)"', 1)::BIGINT AS snapshot
  FROM read_text('{FABRICATOR_DELTA_WRITE_DIR}/dl/main/race2/_delta_log/*.json'))
SELECT count(*), count(DISTINCT snapshot),
       bool_and(snapshot > coalesce(prev, -1))
FROM (SELECT version, snapshot, lag(snapshot) OVER (ORDER BY version) AS prev FROM commits);
----
77	77	true

query II
SELECT count(*), sum(id) FROM fabricator_delta_scan('{FABRICATOR_DELTA_WRITE_DIR}/dl/main/race2');
----
154	151181

query II
SELECT count(*), sum(id) FROM lake.race2;
----
154	151181

# ============================================================================
# 9. A REMOTE PATH NEEDS A CONDITIONAL COMMIT. Through the host filesystem an object store only checks for the
#    file before writing it, so two syncs could both "win" a version. Without a credential from an attached
#    Delta catalog covering the path, the sync refuses — before any IO, so this needs no endpoint.
#    ⚠ Without the refusal the sync goes to the (unreachable) bucket and fails with an HTTP error, which this
#    runner turns into a SKIP rather than a failure. scripts/run-suites.sh fails on any skip, so the tier
#    catches that mutant; a bare unittest run shows it only as "skipped".
# ============================================================================

statement ok
ATTACH 'ducklake:{FABRICATOR_DELTA_WRITE_DIR}/meta2.ducklake' AS lake2 (DATA_PATH 's3://fabricator-nowhere/dl/');

statement ok
CREATE TABLE lake2.t (id INTEGER);

statement error
SELECT * FROM ducklake_delta_sync('lake2');
----
no credential for a conditional commit was found

# ============================================================================
# 7. NOT A LAKE.
# ============================================================================

statement error
SELECT * FROM ducklake_delta_sync('nope');
----
is not an attached DuckLake catalog

# ============================================================================
# 10. ONLY COMPLETE SNAPSHOTS ARE MIRRORED. With DuckLake's default inlining, small inserts live in the
#     metadata database and in no Parquet file, so a Delta version taken while they are there would silently
#     lack them. Such a snapshot is skipped; the next flush carries its rows. (This lake keeps the default
#     inlining; every section above attaches with DATA_INLINING_ROW_LIMIT 0.)
# ============================================================================

statement ok
ATTACH 'ducklake:{FABRICATOR_DELTA_WRITE_DIR}/meta3.ducklake' AS lake3 (DATA_PATH '{FABRICATOR_DELTA_WRITE_DIR}/dl3/');

statement ok
CREATE TABLE lake3.t (id INTEGER, v VARCHAR);

statement ok
INSERT INTO lake3.t SELECT i, 'b' FROM range(2000) r(i);

statement ok
INSERT INTO lake3.t VALUES (5000, 'x'), (5001, 'y'), (5002, 'z');

# the first sync takes the newest COMPLETE snapshot: the one before the inlined insert
query III
SELECT ducklake_snapshot, delta_version, files_added FROM ducklake_delta_sync('lake3', table_name := 't');
----
2	0	1

query II
SELECT count(*), max(id) FROM fabricator_delta_scan('{FABRICATOR_DELTA_WRITE_DIR}/dl3/main/t');
----
2000	1999

statement ok
CALL ducklake_flush_inlined_data('lake3');

query III
SELECT ducklake_snapshot, delta_version, files_added FROM ducklake_delta_sync('lake3', table_name := 't');
----
3	1	1

query II
SELECT count(*), max(id) FROM fabricator_delta_scan('{FABRICATOR_DELTA_WRITE_DIR}/dl3/main/t');
----
2003	5002

# an inlined-only change writes nothing
statement ok
INSERT INTO lake3.t VALUES (6000, 'q');

query I
SELECT count(*) FROM ducklake_delta_sync('lake3', table_name := 't');
----
0

# an inlined DELETE of a flushed row is fine: it is mirrored as a deletion vector right away
statement ok
CALL ducklake_flush_inlined_data('lake3');

statement ok
DELETE FROM lake3.t WHERE id = 5000;

# The insert of 6000 (snapshot 5) was skipped while its row was inlined. The flush (6) moved the row into a file
# stamped with ITS OWN snapshot, so snapshot 5 is complete now and gets its own version; the flush itself changes
# nothing, and the delete (7) is the third version. History stays per snapshot.
query III
SELECT ducklake_snapshot, delta_version, deletion_vectors FROM ducklake_delta_sync('lake3', table_name := 't') ORDER BY delta_version;
----
5	2	0
7	3	1

query II
SELECT count(*), sum(id) FROM fabricator_delta_scan('{FABRICATOR_DELTA_WRITE_DIR}/dl3/main/t');
----
2003	2015003

# ============================================================================
# 11. column_mapping := 'none' + deletion_vectors := false: reader version 1, for readers without column
#     mapping or deletion vectors (SQL Server's DELTA reader; the end-to-end read is in
#     verify_mssql_s3_polybase §6d). A live delete waits for a rewrite; a rename with live old files is refused.
# ============================================================================

statement ok
CREATE TABLE lake3.p (id INTEGER, v VARCHAR);

statement ok
INSERT INTO lake3.p SELECT i, 'b' FROM range(1000) r(i);

query II
SELECT delta_version, deletion_vectors FROM ducklake_delta_sync('lake3', table_name := 'p', column_mapping := 'none', deletion_vectors := false);
----
0	0

query II
SELECT protocol.minReaderVersion, protocol.writerFeatures FROM read_json('{FABRICATOR_DELTA_WRITE_DIR}/dl3/main/p/_delta_log/00000000000000000000.json') WHERE protocol IS NOT NULL;
----
1	[domainMetadata, rowTracking]

statement ok
DELETE FROM lake3.p WHERE id < 5;

# the choice is persisted: no options needed on later syncs, and the delete waits
query I
SELECT count(*) FROM ducklake_delta_sync('lake3', table_name := 'p');
----
0

query I
SELECT count(*) FROM fabricator_delta_scan('{FABRICATOR_DELTA_WRITE_DIR}/dl3/main/p');
----
1000

statement ok
CALL ducklake_rewrite_data_files('lake3', 'p', delete_threshold => 0);

query IIII
SELECT delta_version, files_added, files_removed, deletion_vectors FROM ducklake_delta_sync('lake3', table_name := 'p');
----
1	1	1	0

query II
SELECT count(*), min(id) FROM fabricator_delta_scan('{FABRICATOR_DELTA_WRITE_DIR}/dl3/main/p');
----
995	5

statement ok
ALTER TABLE lake3.p RENAME COLUMN v TO w;

statement error
SELECT * FROM ducklake_delta_sync('lake3', table_name := 'p');
----
was renamed from 'v' and live data files still use the old name

statement error
SELECT * FROM ducklake_delta_sync('lake3', table_name := 'p', column_mapping := 'x');
----
column_mapping must be 'name', 'id' or 'none'

statement ok
DETACH lake3;

# ============================================================================
# 12. STATISTICS — timestamps (to milliseconds, a minimum rounded down and a maximum up) and fields inside structs
#     reach the Delta stats; nothing inside a list does.
# ============================================================================

statement ok
ATTACH 'ducklake:{FABRICATOR_DELTA_WRITE_DIR}/meta4.ducklake' AS lake4 (DATA_PATH '{FABRICATOR_DELTA_WRITE_DIR}/dl4/', DATA_INLINING_ROW_LIMIT 0);

statement ok
CREATE TABLE lake4.st (id INTEGER, ts TIMESTAMP, tz TIMESTAMPTZ, s STRUCT(x INTEGER, y VARCHAR), l INTEGER[]);

statement ok
INSERT INTO lake4.st VALUES
  (1, TIMESTAMP '2024-01-01 12:34:56.123456', TIMESTAMPTZ '2024-01-01 12:34:56.123456+01', {'x': 5, 'y': NULL}, [1]),
  (2, TIMESTAMP '2024-01-01 12:34:56.123900', TIMESTAMPTZ '2024-01-01 12:34:56.123900+01', {'x': 9, 'y': 'q'}, [2]);

statement ok
CREATE TABLE lake4.st2 AS SELECT * FROM lake4.st;

statement ok
SELECT * FROM ducklake_delta_sync('lake4', table_name := 'main.st');

statement ok
SELECT * FROM ducklake_delta_sync('lake4', table_name := 'main.st2', timestamp_mapping := 'ntz');

query TTTTIIIT
SELECT json_extract_string(add.stats, '$.minValues.ts'), json_extract_string(add.stats, '$.maxValues.ts'),
       json_extract_string(add.stats, '$.minValues.tz'), json_extract_string(add.stats, '$.maxValues.tz'),
       json_extract(add.stats, '$.minValues.s.x')::INT, json_extract(add.stats, '$.maxValues.s.x')::INT,
       json_extract(add.stats, '$.nullCount.s.y')::INT, json_extract(add.stats, '$.minValues.l') IS NULL
FROM read_json('{FABRICATOR_DELTA_WRITE_DIR}/dl4/main/st/_delta_log/00000000000000000000.json') WHERE add IS NOT NULL;
----
2024-01-01T12:34:56.123Z	2024-01-01T12:34:56.124Z	2024-01-01T11:34:56.123Z	2024-01-01T11:34:56.124Z	5	9	1	true

# timestamp_ntz has no zone
query TT
SELECT json_extract_string(add.stats, '$.minValues.ts'), json_extract_string(add.stats, '$.minValues.tz')
FROM read_json('{FABRICATOR_DELTA_WRITE_DIR}/dl4/main/st2/_delta_log/00000000000000000000.json') WHERE add IS NOT NULL;
----
2024-01-01T12:34:56.123	2024-01-01T11:34:56.123Z

# filters right at the sub-millisecond edges still find their rows (a bound on the wrong side would prune the file)
query II
SELECT (SELECT count(*) FROM fabricator_delta_scan('{FABRICATOR_DELTA_WRITE_DIR}/dl4/main/st') WHERE ts < TIMESTAMP '2024-01-01 12:34:56.1235'),
       (SELECT count(*) FROM fabricator_delta_scan('{FABRICATOR_DELTA_WRITE_DIR}/dl4/main/st') WHERE ts > TIMESTAMP '2024-01-01 12:34:56.1238');
----
1	1

query II
SELECT (SELECT count(*) FROM fabricator_delta_scan('{FABRICATOR_DELTA_WRITE_DIR}/dl4/main/st') WHERE s.x = 9),
       (SELECT count(*) FROM fabricator_delta_scan('{FABRICATOR_DELTA_WRITE_DIR}/dl4/main/st') WHERE s.x > 9);
----
1	0

statement ok
DETACH lake4;

# ============================================================================
# 13. PARTITIONING — an IDENTITY key of DuckLake's partitioning becomes a Delta partition column (partitionValues
#     from DuckLake's metadata, keyed by the physical name; the column stays in the file too); a transform such as
#     year(ts) is not declared — as `ts` it would REPLACE the column's values — and works through the statistics
#     instead. The path layout (hive_file_pattern) does not matter. Fixed at the first sync.
# ============================================================================

statement ok
ATTACH 'ducklake:{FABRICATOR_DELTA_WRITE_DIR}/meta5.ducklake' AS lake5 (DATA_PATH '{FABRICATOR_DELTA_WRITE_DIR}/dl5/', DATA_INLINING_ROW_LIMIT 0);

statement ok
CREATE TABLE lake5.p (id INTEGER, region VARCHAR, d DATE, ts TIMESTAMP);

statement ok
ALTER TABLE lake5.p SET PARTITIONED BY (region, d, year(ts));

statement ok
INSERT INTO lake5.p VALUES (1, 'eu', DATE '2024-01-01', TIMESTAMP '2024-05-01'), (2, 'us', DATE '2024-01-02', TIMESTAMP '2025-05-01'),
  (3, NULL, NULL, TIMESTAMP '2025-06-01'), (4, 'eu', DATE '2024-01-01', TIMESTAMP '2025-07-01');

statement ok
SELECT * FROM ducklake_delta_sync('lake5', table_name := 'main.p');

query T
SELECT metaData.partitionColumns FROM read_json('{FABRICATOR_DELTA_WRITE_DIR}/dl5/main/p/_delta_log/00000000000000000000.json') WHERE metaData IS NOT NULL;
----
[region, d]

# one add per DuckLake file, each with its values (NULL for NULL); partition columns get no statistics
query TTII
SELECT add.partitionValues.region, add.partitionValues.d, json_extract(add.stats, '$.numRecords')::INT,
       (json_extract(add.stats, '$.minValues.region') IS NULL AND json_extract(add.stats, '$.minValues.id') IS NOT NULL)::INT
FROM read_json('{FABRICATOR_DELTA_WRITE_DIR}/dl5/main/p/_delta_log/00000000000000000000.json') WHERE add IS NOT NULL
ORDER BY 1 NULLS LAST, 2;
----
eu	2024-01-01	1	1
eu	2024-01-01	1	1
us	2024-01-02	1	1
NULL	NULL	1	1

statement ok
UPDATE lake5.p SET region = 'us' WHERE id = 1;

statement ok
SELECT * FROM ducklake_delta_sync('lake5', table_name := 'main.p');

query ITT
SELECT id, region, d FROM fabricator_delta_scan('{FABRICATOR_DELTA_WRITE_DIR}/dl5/main/p') ORDER BY id;
----
1	us	2024-01-01
2	us	2024-01-02
3	NULL	NULL
4	eu	2024-01-01

statement ok
ATTACH '{FABRICATOR_DELTA_WRITE_DIR}/dl5' AS d5 (TYPE fabricator, PROVIDER 'delta', schemas true);

query ITT
SELECT id, region, d FROM d5.main.p ORDER BY id;
----
1	us	2024-01-01
2	us	2024-01-02
3	NULL	NULL
4	eu	2024-01-01

query II
SELECT (SELECT count(*) FROM d5.main.p WHERE region = 'us'), (SELECT count(*) FROM d5.main.p WHERE region IS NULL);
----
2	1

statement ok
DETACH d5;

# id column mapping: the keys are col-<id>, and our native reader found no value when the file holds the partition
# column too (it looked the value up by the file's name for the column) — read NULL before the fix
statement ok
CREATE TABLE lake5.pid (id INTEGER, k INTEGER);

statement ok
ALTER TABLE lake5.pid SET PARTITIONED BY (k);

statement ok
INSERT INTO lake5.pid VALUES (1, 10), (2, 20);

statement ok
