# ============================================================================
# 14. CHANGE DATA FEED (change_data_feed := true) — a commit's change rows come from DuckLake's own change feed
#     (ducklake_table_changes) and go to _change_data files with physical names and field ids, one per partition.
#     A commit of only inserts needs none; a compaction (merge, rewrite) is not a change: dataChange = false.
# ============================================================================

statement ok
CREATE TABLE lake5.c (id INTEGER, k INTEGER, s STRUCT(a INTEGER, b VARCHAR), l STRUCT(q INTEGER)[]);

statement ok
ALTER TABLE lake5.c SET PARTITIONED BY (k);

statement ok
INSERT INTO lake5.c VALUES (1, 10, {'a': 1, 'b': 'x'}, [{'q': 1}]), (2, 20, NULL, NULL), (3, 20, {'a': 3, 'b': 'z'}, []);

statement ok
SELECT * FROM ducklake_delta_sync('lake5', table_name := 'main.c', column_mapping := 'id', change_data_feed := true);

statement ok
UPDATE lake5.c SET k = 20, s = {'a': 9, 'b': 'w'} WHERE id = 1;

statement ok
DELETE FROM lake5.c WHERE id = 2;

statement ok
INSERT INTO lake5.c VALUES (4, 10, NULL, [{'q': 4}]);

statement ok
SELECT * FROM ducklake_delta_sync('lake5', table_name := 'main.c');

statement ok
ATTACH '{FABRICATOR_DELTA_WRITE_DIR}/dl5' AS d5 (TYPE fabricator, PROVIDER 'delta', schemas true);

query TIIIIT
SELECT _change_type, _commit_version, id, k, s.a, l FROM d5.delta.changes('main.c', starting_version := 0, ending_version := 9)
ORDER BY _commit_version, id, _change_type;
----
insert	0	1	10	1	[{'q': 1}]
insert	0	2	20	NULL	NULL
insert	0	3	20	3	[]
update_postimage	1	1	20	9	[{'q': 1}]
update_preimage	1	1	10	1	[{'q': 1}]
delete	2	2	20	NULL	NULL
insert	3	4	10	NULL	[{'q': 4}]

# the update moved its row across partitions: one cdc file per partition, each with its partitionValues; the pure
# insert commit (v3) has none
query IT
SELECT parse_filename(filename, true)[-1:]::INT AS v, cdc.partitionValues."col-2"
FROM read_json('{FABRICATOR_DELTA_WRITE_DIR}/dl5/main/c/_delta_log/0000000000000000000*.json', filename := true)
WHERE cdc IS NOT NULL ORDER BY 1, 2;
----
1	10
1	20
2	20

# the cdc files carry the physical names and field ids, struct members included
query TI
SELECT DISTINCT name, field_id FROM parquet_schema('{FABRICATOR_DELTA_WRITE_DIR}/dl5/main/c/_change_data/*.parquet')
WHERE name LIKE 'col-%' OR name = '_change_type' ORDER BY field_id NULLS LAST;
----
col-1	1
col-2	2
col-3	3
col-4	4
col-5	5
col-6	6
col-8	8
_change_type	NULL

statement ok
DETACH d5;

statement ok
SELECT 'rewrite', * FROM ducklake_rewrite_data_files('lake5', 'c', delete_threshold => 0);

statement ok
SELECT * FROM ducklake_delta_sync('lake5', table_name := 'main.c');

# the rewrite's commit: files only rearranged, no row changed
query IIT
SELECT count(*) FILTER (WHERE add IS NOT NULL OR remove IS NOT NULL), count(*) FILTER (WHERE add.dataChange OR remove.dataChange),
       (SELECT content LIKE '%"cdc"%' FROM read_text('{FABRICATOR_DELTA_WRITE_DIR}/dl5/main/c/_delta_log/00000000000000000004.json'))
FROM read_json('{FABRICATOR_DELTA_WRITE_DIR}/dl5/main/c/_delta_log/00000000000000000004.json');
----
2	0	false

statement ok
ATTACH '{FABRICATOR_DELTA_WRITE_DIR}/dl5' AS d5 (TYPE fabricator, PROVIDER 'delta', schemas true);

query I
SELECT count(*) FROM d5.delta.changes('main.c', starting_version := 4, ending_version := 4);
----
0

query IIT
SELECT id, k, s.b FROM d5.main.c ORDER BY id;
----
1	20	w
3	20	z
4	10	NULL

statement ok
DETACH d5;

# switched on later: the feed starts at the commit that switched it on
statement ok
