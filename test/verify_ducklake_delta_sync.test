query TT
SELECT parse_filename(parse_dirpath(parse_dirpath(filename))), metaData.partitionColumns
FROM read_json('{FABRICATOR_DELTA_WRITE_DIR}/dl5/main/p*/_delta_log/00000000000000000000.json', filename := true)
WHERE metaData IS NOT NULL ORDER BY 1;
