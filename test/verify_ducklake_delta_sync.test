query T
SELECT list_sort(list(add.partitionValues."col-2")) FROM read_json('{FABRICATOR_DELTA_WRITE_DIR}/dl5/main/pid/_delta_log/00000000000000000000.json')
WHERE add IS NOT NULL;
----
[10, 20]

statement ok
ATTACH '{FABRICATOR_DELTA_WRITE_DIR}/dl5' AS d5 (TYPE fabricator, PROVIDER 'delta', schemas true);

query II
SELECT id, k FROM d5.main.pid ORDER BY id;
----
1	10
2	20

# pruned to one file, which the native reader reads on its per-file path — the one that had the wrong lookup
query II
SELECT id, k FROM d5.main.pid WHERE k = 20;
----
2	20

statement ok
DETACH d5;

# a transform alone is not declared; hive_file_pattern := false is declared like the default; an empty string (NULL
# in Delta) keeps a key undeclared; partitioning := false declares nothing
statement ok
