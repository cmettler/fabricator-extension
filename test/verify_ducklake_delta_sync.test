query II
SELECT count(*), count(*) = (SELECT count(*) FROM foreign_log) FROM glob('{FABRICATOR_DELTA_WRITE_DIR}/dl7/main/f/_delta_log/*.json')
WHERE file IN (SELECT file FROM foreign_log);
----
2	true

statement ok
DETACH lake7;
