# name: test/verify_delta_mfr_scan.test
# description: fabricator_delta_mfr_scan(path) — Delta native read via DuckDB's MultiFileReader (docs/multifile-delta.md
#              Phase A slice 1a). A clone of parquet_scan whose MultiFileReader gets the EXACT active data files from
#              engineered-wood (delta_list_files → a SimpleMultiFileList); DuckDB's native parquet reader then reads
#              them (cached over onelake:// for OneLake). This is the C++ MultiFileReader foundation for DV /
#              partition / dynamic-filter pushdown (later slices). Must match the C# reader row-for-row. Plain tables.
#              Fixture: test/fixtures/delta_simple (delta-rs, 10 rows id/name/amount). Set FABRICATOR_DELTA_DIR.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_DIR

# Full scan through the MultiFileReader — correct rows/types (schema derived from the parquet files).
query III
SELECT id, name, amount FROM fabricator_delta_mfr_scan('${FABRICATOR_DELTA_DIR}') ORDER BY id;
----
1	row_1	1.5
2	row_2	3.0
3	row_3	4.5
4	row_4	6.0
5	row_5	7.5
6	row_6	9.0
7	row_7	10.5
8	row_8	12.0
9	row_9	13.5
10	row_10	15.0

# Agrees with the C# reader (count + sum).
query II
SELECT count(*), sum(id) FROM fabricator_delta_mfr_scan('${FABRICATOR_DELTA_DIR}');
----
10	55

query II
SELECT count(*), sum(id) FROM fabricator_delta_scan('${FABRICATOR_DELTA_DIR}');
----
10	55

# Projection + filter applied by DuckDB above the MultiFileReader scan.
query I
SELECT count(*) FROM fabricator_delta_mfr_scan('${FABRICATOR_DELTA_DIR}') WHERE id > 7;
----
3

query I
SELECT sum(amount) FROM fabricator_delta_mfr_scan('${FABRICATOR_DELTA_DIR}') WHERE name = 'row_2';
----
3.0
