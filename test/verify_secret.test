# name: test/verify_secret.test
# description: secret -> connection string assembled in C# (build_connection_string ABI)
# group: [mssql]

require fabricator

require-env MSSQL_TEST_PASS

statement ok
CREATE SECRET s_main (TYPE mssql, host 'localhost', port 1433, database 'TestDB',
  user 'sa', password '${MSSQL_TEST_PASS}', use_encrypt true);

# Secret exists and the password is redacted in duckdb_secrets().
query I
SELECT count(*) FROM duckdb_secrets() WHERE type = 'mssql' AND name = 's_main';
----
1

query I
SELECT secret_string NOT LIKE '%' || '${MSSQL_TEST_PASS}' || '%' FROM duckdb_secrets() WHERE name = 's_main';
----
true

# ATTACH using the secret (connstr built in C# from the secret fields) + scan.
statement ok
ATTACH '' AS sdb (TYPE fabricator, SECRET s_main);

query I
SELECT x FROM fabricator_query('sdb', 'SELECT 7 AS x');
----
7

# The query/exec functions also accept the secret name directly.
query I
SELECT x FROM fabricator_query('s_main', 'SELECT 8 AS x');
----
8

statement ok
DETACH sdb;

statement ok
DROP SECRET s_main;

# Missing required field: the secret is now accepted at CREATE (the field declaration is provider-declared
# and validation moved into the managed build_connection_string — docs/provider-extensibility.md §2), and
# the error surfaces when the secret is USED to build a connection.
statement ok
CREATE SECRET s_bad (TYPE mssql, user 'sa', password 'x');

statement error
SELECT x FROM fabricator_query('s_bad', 'SELECT 1 AS x');
----
missing required field 'host'

statement ok
DROP SECRET s_bad;
