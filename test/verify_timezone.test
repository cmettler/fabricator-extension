# name: test/verify_timezone.test
# description: under a non-UTC session TimeZone, a TIMESTAMPTZ preserves its instant and a naive TIMESTAMP is unshifted (warehouse-support §3.1)
# group: [mssql_net]
#
# Requires the icu extension (statically embedded, extension_config.cmake) for the TimeZone setting.
# Validates the recommended naive<->naive semantic: we do NOT reinterpret a stored naive datetime2 as
# session-local. A TIMESTAMPTZ is an instant — stored as UTC (datetimeoffset where it exists, else UTC
# datetime2 on Fabric) and re-displayed in the session zone.

require mssql_net

require icu

require-env MSSQL_TESTDB_DSN

statement ok
SET TimeZone='America/New_York';

statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS db (TYPE mssql_net);

statement ok
DROP TABLE IF EXISTS db.dbo.tz_probe;

# 12:00 -04 (EDT) == 16:00 UTC. The naive value has no zone.
statement ok
CREATE TABLE db.dbo.tz_probe AS SELECT TIMESTAMPTZ '2024-07-01 12:00:00-04:00' AS tstz, TIMESTAMP '2024-07-01 12:00:00' AS tsnaive;

# tz instant -> datetimeoffset (box has it); naive -> datetime2.
query TT
SELECT CAST(DATA_TYPE AS VARCHAR(32)), CAST(COLUMN_NAME AS VARCHAR(32)) FROM mssql_net_query('db',
  'SELECT DATA_TYPE, COLUMN_NAME FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = ''tz_probe'' ORDER BY ORDINAL_POSITION');
----
datetimeoffset	tstz
datetime2	tsnaive

# The instant round-trips (re-displayed in the NY session zone); the naive value is NOT shifted by the
# session zone (naive<->naive).
query TT
SELECT tstz::VARCHAR, tsnaive::VARCHAR FROM db.dbo.tz_probe;
----
2024-07-01 12:00:00-04	2024-07-01 12:00:00

# Proof the stored datetimeoffset is the correct UTC instant (16:00Z), not the session-local wall clock.
query T
SELECT raw FROM mssql_net_query('db',
  'SELECT CAST(CONVERT(VARCHAR(40), SWITCHOFFSET(tstz, 0), 126) AS VARCHAR(40)) AS raw FROM dbo.tz_probe');
----
2024-07-01T16:00:00+00:00

statement ok
DROP TABLE db.dbo.tz_probe;

statement ok
DETACH db;
