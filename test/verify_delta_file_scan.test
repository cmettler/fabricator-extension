# name: test/verify_delta_file_scan.test
# description: The FILE SCAN (ABI v101 table_file_plan, src/fabricator/fabricator_file_scan.cpp): a Delta table read by
#              DuckDB's own parquet reader over the files the provider lists, instead of the provider's scan. It
#              REPLACES the scan, so every data section is a differential: the same query with
#              `fabricator_file_scan = false` (the provider's scan, the oracle) and `= true`, compared with EXCEPT ALL
#              both ways. Routing is asserted through EXPLAIN (`Fabricator File Scan` vs `Fabricator Scan`), in both
#              directions, so a section cannot pass because the switch did nothing.
#              Covered: deletion vectors, schema evolution (a column and a struct member added later), column
#              mapping 'name' and 'none', partition columns incl. a NULL partition, row tracking columns, the row id
#              (DELETE / UPDATE through the file scan), timestamps under a non-UTC session zone, an inlined CTE (a plan
#              copy), COUNT(*) from metadata, column mapping 'id' (by field id, partition keys), and the decline of
#              an explicit transaction.
# group: [fabricator]

require fabricator

require ducklake

require parquet

require icu

require json

require-env FABRICATOR_DELTA_WRITE_DIR

statement ok
SET TimeZone = 'America/New_York';

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/fscan' AS l (TYPE fabricator, PROVIDER 'delta', deletion_vectors true);

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/fscan_none' AS n (TYPE fabricator, PROVIDER 'delta', column_mapping 'none');

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/fscan_id' AS i (TYPE fabricator, PROVIDER 'delta', column_mapping 'id');

# ============================================================================
# 1. ROUTING, both directions
# ============================================================================
statement ok
CREATE TABLE l.main.t (id INTEGER, s VARCHAR, d DOUBLE, st STRUCT(a INTEGER));

statement ok
INSERT INTO l.main.t SELECT r, 'v' || (r % 7), r * 1.5, {'a': r} FROM range(3000) x(r);

statement ok
INSERT INTO l.main.t SELECT r, 'w', 0.5, {'a': -r} FROM range(3000, 3500) x(r);

statement ok
SET fabricator_file_scan = true;

query II
EXPLAIN SELECT count(*) FROM l.main.t WHERE id > 5;
----
physical_plan	<REGEX>:.*Fabricator File Scan.*

statement ok
SET fabricator_file_scan = false;

query II
EXPLAIN SELECT count(*) FROM l.main.t WHERE id > 5;
----
physical_plan	<!REGEX>:.*Fabricator File Scan.*

# ============================================================================
# 2. DELETION VECTORS, SCHEMA EVOLUTION, ROW TRACKING — differential
# ============================================================================
statement ok
DELETE FROM l.main.t WHERE id % 97 = 3;

statement ok
ALTER TABLE l.main.t ADD COLUMN extra INTEGER;

statement ok
ALTER TABLE l.main.t ADD COLUMN st.b VARCHAR;

statement ok
INSERT INTO l.main.t VALUES (9001, 'x', 1.0, {'a': 1, 'b': 'bb'}, 42);

statement ok
CREATE TEMP TABLE ref1 AS SELECT id, s, d, st, extra, __delta_row_id, __delta_row_commit_version, rowid FROM l.main.t;

statement ok
CREATE TEMP TABLE ref1f AS SELECT s, count(*) AS c, sum(id) AS si, sum((st).a) AS sa, count((st).b) AS cb
FROM l.main.t WHERE id BETWEEN 100 AND 3200 GROUP BY s;

statement ok
SET fabricator_file_scan = true;

query I
SELECT count(*) FROM ((SELECT id, s, d, st, extra, __delta_row_id, __delta_row_commit_version, rowid FROM l.main.t)
                      EXCEPT ALL (SELECT * FROM ref1));
----
0

query I
SELECT count(*) FROM ((SELECT * FROM ref1)
                      EXCEPT ALL (SELECT id, s, d, st, extra, __delta_row_id, __delta_row_commit_version, rowid FROM l.main.t));
----
0

query I
SELECT count(*) FROM ((SELECT s, count(*) AS c, sum(id) AS si, sum((st).a) AS sa, count((st).b) AS cb
                       FROM l.main.t WHERE id BETWEEN 100 AND 3200 GROUP BY s) EXCEPT ALL (SELECT * FROM ref1f));
----
0

# the positive control that ref1 is not empty and the deletes are in it
query II
SELECT count(*), count(extra) FROM ref1;
----
3464	1

# ============================================================================
# 3. DML THROUGH THE FILE SCAN: the row id it computes must address the same rows the provider resolves
# ============================================================================
statement ok
UPDATE l.main.t SET s = 'upd' WHERE id % 50 = 7;

statement ok
DELETE FROM l.main.t WHERE id BETWEEN 2000 AND 2099;

statement ok
SET fabricator_file_scan = false;

query III
SELECT count(*), count(*) FILTER (WHERE s = 'upd'), sum(id) FILTER (WHERE s = 'upd') FROM l.main.t;
----
3365	67	114069

query I
SELECT count(*) FROM l.main.t WHERE id BETWEEN 2000 AND 2099;
----
0

# ============================================================================
# 4. COLUMN MAPPING 'none' + PARTITIONS (incl. a NULL partition) + TIMESTAMPS — differential
# ============================================================================
statement ok
CREATE TABLE n.main.p (id INTEGER, region VARCHAR, day DATE, t TIMESTAMPTZ, nt TIMESTAMP) PARTITIONED BY (region, day);

statement ok
INSERT INTO n.main.p SELECT r, CASE WHEN r % 4 = 0 THEN NULL ELSE 'r' || (r % 3) END,
                            DATE '2024-03-09' + (r % 2)::INTEGER,
                            TIMESTAMPTZ '2024-03-10 06:30:00+00' + to_minutes(r::BIGINT),
                            TIMESTAMP '2024-03-10 01:00:00' + to_minutes(r::BIGINT)
                     FROM range(600) x(r);

statement ok
UPDATE n.main.p SET region = 'moved' WHERE id < 20;

statement ok
CREATE TEMP TABLE ref2 AS SELECT region, day, count(*) AS c, sum(id) AS si, min(t) AS mt, max(nt) AS xn
FROM n.main.p WHERE t >= TIMESTAMPTZ '2024-03-10 07:00:00+00' GROUP BY ALL;

statement ok
SET fabricator_file_scan = true;

query II
EXPLAIN SELECT count(*) FROM n.main.p WHERE region = 'r1';
----
physical_plan	<REGEX>:.*Fabricator File Scan.*

query I
SELECT count(*) FROM ((SELECT region, day, count(*) AS c, sum(id) AS si, min(t) AS mt, max(nt) AS xn
                       FROM n.main.p WHERE t >= TIMESTAMPTZ '2024-03-10 07:00:00+00' GROUP BY ALL)
                      EXCEPT ALL (SELECT * FROM ref2));
----
0

query I
SELECT count(*) FROM ref2 WHERE region IS NULL;
----
1

query II
SELECT count(*), sum(id) FROM n.main.p WHERE region = 'moved';
----
20	190

# ============================================================================
# 5. A PLAN COPY: an inlined CTE referenced twice is copied by serialize/deserialize
# ============================================================================
query II
EXPLAIN WITH x AS (SELECT * FROM n.main.p) SELECT a.id, b.id FROM x a JOIN x b ON a.id = b.id + 1 ORDER BY 1 LIMIT 2;
----
physical_plan	<REGEX>:.*Fabricator File Scan.*Fabricator File Scan.*

query II
WITH x AS (SELECT * FROM n.main.p WHERE id > 100) SELECT a.id, b.id FROM x a JOIN x b ON a.id = b.id + 1 ORDER BY 1 LIMIT 2;
----
102	101
103	102

# ============================================================================
# 6. COUNT(*) from metadata, not a scan (the parquet reader's own count would include deleted rows)
# ============================================================================
query II
EXPLAIN SELECT count(*) FROM l.main.t;
----
physical_plan	<!REGEX>:.*Fabricator File Scan.*

query I
SELECT count(*) FROM l.main.t;
----
3365

# ============================================================================
# 7. DECLINED: an explicit transaction — the provider's scan, same answers
# ============================================================================
statement ok
BEGIN;

query II
EXPLAIN SELECT count(*) FROM l.main.t WHERE id > 5;
----
physical_plan	<!REGEX>:.*Fabricator File Scan.*

query I
SELECT count(*) FROM l.main.t WHERE s = 'upd';
----
67

statement ok
COMMIT;

# ============================================================================
# 8. COLUMN MAPPING 'id': the parts are matched by field id (a renamed column, an added struct member), partition
#    values are found under their PHYSICAL key — differential, on one table
# ============================================================================
statement ok
CREATE TABLE i.main.m (id INTEGER, s VARCHAR, st STRUCT(a INTEGER, b VARCHAR), k VARCHAR) PARTITIONED BY (k);

statement ok
INSERT INTO i.main.m SELECT r, 'v' || (r % 5), {'a': r, 'b': 'x' || r}, 'k' || (r % 3) FROM range(3000) x(r);

statement ok
ALTER TABLE i.main.m RENAME COLUMN s TO s2;

statement ok
ALTER TABLE i.main.m ADD COLUMN st.c DOUBLE;

statement ok
INSERT INTO i.main.m VALUES (9001, 'new', {'a': 1, 'b': 'y', 'c': 2.5}, 'k9');

statement ok
SET fabricator_file_scan = false;

statement ok
CREATE TEMP TABLE ref3 AS SELECT id, s2, st, k, __delta_row_id, rowid FROM i.main.m;

statement ok
SET fabricator_file_scan = true;

query II
EXPLAIN SELECT count(*) FROM i.main.m WHERE id > 5;
----
physical_plan	<REGEX>:.*Fabricator File Scan.*

query I
SELECT count(*) FROM ((SELECT id, s2, st, k, __delta_row_id, rowid FROM i.main.m) EXCEPT ALL (SELECT * FROM ref3));
----
0

query I
SELECT count(*) FROM ((SELECT * FROM ref3) EXCEPT ALL (SELECT id, s2, st, k, __delta_row_id, rowid FROM i.main.m));
----
0

# a partition filter with a struct member filter: every k must come from the log under the physical key
query I
SELECT count(*) FROM i.main.m WHERE (st).b LIKE 'x1%' AND k = 'k1';
----
373

query II
SELECT count(*), count(k) FROM ref3;
----
3001	3001

# ============================================================================
# 9. STRUCTS INSIDE LISTS AND MAPS under column mapping 'name': their members are stored under physical names too
#    (the plan's "element" / "key" / "value" members) — differential, on one table
# ============================================================================
statement ok
CREATE TABLE l.main.lm (id INTEGER, ls STRUCT(a INTEGER, b VARCHAR)[], mp MAP(VARCHAR, STRUCT(x INTEGER)), nl INTEGER[][]);

statement ok
INSERT INTO l.main.lm SELECT r, [{'a': r, 'b': 'x' || r}, {'a': -r, 'b': NULL}], MAP {'k' || (r % 3): {'x': r}}, [[r, r + 1], [r * 2]] FROM range(500) x(r);

statement ok
INSERT INTO l.main.lm VALUES (9001, NULL, NULL, NULL), (9002, [], MAP {}, [[]]);

statement ok
DELETE FROM l.main.lm WHERE id % 50 = 7;

statement ok
SET fabricator_file_scan = false;

statement ok
CREATE TEMP TABLE ref4 AS SELECT id, to_json(ls) AS ls, to_json(mp) AS mp, to_json(nl) AS nl FROM l.main.lm;

statement ok
SET fabricator_file_scan = true;

query II
EXPLAIN SELECT count(*) FROM l.main.lm WHERE id > 5;
----
physical_plan	<REGEX>:.*Fabricator File Scan.*

query I
SELECT count(*) FROM ((SELECT id, to_json(ls), to_json(mp), to_json(nl) FROM l.main.lm) EXCEPT ALL (SELECT * FROM ref4));
----
0

query I
SELECT count(*) FROM ((SELECT * FROM ref4) EXCEPT ALL (SELECT id, to_json(ls), to_json(mp), to_json(nl) FROM l.main.lm));
----
0

query III
SELECT count(*), sum(ls[1].a), sum(mp['k1'].x) FROM l.main.lm;
----
492	122430	40822

# ============================================================================
# 10. A FILE'S NAIVE TIMESTAMP UNDER A UTC-ADJUSTED COLUMN reads as its UTC instant, filters included, in a zone
#     off UTC. A DuckLake 'utc' mirror writes naive TIMESTAMP files under a Delta `timestamp` column. The mapper
#     would cast them (and convert pushed filters) in the session zone, a silent shift; the scan declares the
#     file's column as the table's kind instead. epoch_us is zone-free: 2024-07-01 12:00Z = 1719835200000000.
# ============================================================================
statement ok
SET TimeZone = 'Asia/Kathmandu';

statement ok
ATTACH 'ducklake:{FABRICATOR_DELTA_WRITE_DIR}/m10.ducklake' AS lake10 (DATA_PATH '{FABRICATOR_DELTA_WRITE_DIR}/dl10/', DATA_INLINING_ROW_LIMIT 0);

statement ok
CREATE TABLE lake10.tz (id INTEGER, ts TIMESTAMP);

statement ok
INSERT INTO lake10.tz SELECT r, TIMESTAMP '2024-07-01 12:00:00' + INTERVAL (r) HOUR FROM range(5) x(r);

statement ok
INSERT INTO lake10.tz SELECT r, TIMESTAMP '2025-01-01 00:00:00' + INTERVAL (r) HOUR FROM range(5, 10) x(r);

statement ok
SELECT * FROM ducklake_delta_sync('lake10');

statement ok
ATTACH '{FABRICATOR_DELTA_WRITE_DIR}/dl10' AS d10 (TYPE fabricator, PROVIDER 'delta', schemas true);

query II
EXPLAIN SELECT id FROM d10.main.tz WHERE ts = TIMESTAMPTZ '2024-07-01 14:00:00+00';
----
physical_plan	<REGEX>:.*Fabricator File Scan.*

query II
SELECT min(epoch_us(ts)), max(epoch_us(ts)) FROM d10.main.tz WHERE id < 5;
----
1719835200000000	1719849600000000

query T
SELECT list(id ORDER BY id) FROM d10.main.tz WHERE ts = TIMESTAMPTZ '2024-07-01 14:00:00+00';
----
[2]

query T
SELECT list(id ORDER BY id) FROM d10.main.tz WHERE ts < TIMESTAMPTZ '2024-07-01 13:30:00+00';
----
[0, 1]

query T
SELECT list(id ORDER BY id) FROM d10.main.tz WHERE ts >= TIMESTAMPTZ '2025-01-01 07:00:00+00';
----
[7, 8, 9]

statement ok
SET TimeZone = 'UTC';

# ============================================================================
# 11. PARTS THE FILTER RULES OUT ARE NEVER OPENED. At scan start the provider names the parts that may hold a match
#     (partition values and the log's statistics); DuckDB's own pre-open skip knows only hive and file-name constants.
#     The y partition's data file is overwritten with garbage: a read that opens it fails (the control), a read whose
#     filter rules it out succeeds — by partition value, by statistics, and when no part can match.
# ============================================================================
statement ok
ATTACH '{FABRICATOR_DELTA_WRITE_DIR}/fs11' AS l11 (TYPE fabricator, PROVIDER 'delta', READ_ONLY false);

statement ok
CREATE TABLE l11.main.p (id INTEGER, k VARCHAR) PARTITIONED BY (k);

statement ok
INSERT INTO l11.main.p SELECT r, 'x' FROM range(0, 100) t(r);

statement ok
INSERT INTO l11.main.p SELECT r, 'y' FROM range(100, 200) t(r);

query I
SELECT sum(fabricator_host_exec('COPY (SELECT 1 AS garbage) TO ''{FABRICATOR_DELTA_WRITE_DIR}/fs11/p/' || add.path || ''' (FORMAT csv)'))
FROM read_json('{FABRICATOR_DELTA_WRITE_DIR}/fs11/p/_delta_log/*.json') WHERE add IS NOT NULL AND contains(to_json(add.partitionValues), '"y"');
----
1

statement ok
SET fabricator_file_scan = true;

statement error
SELECT sum(id) FROM l11.main.p;
----
Invalid Input Error

query I
SELECT sum(id) FROM l11.main.p WHERE k = 'x';
----
4950

query I
SELECT sum(id) FROM l11.main.p WHERE id < 50;
----
1225

query I
SELECT sum(id) FROM l11.main.p WHERE id > 1000;
----
NULL

statement ok
DETACH l11;

# ============================================================================
# 12. LATE MATERIALIZATION. A Top-N or LIMIT over a wide row reads the narrow columns first and fetches the rest only
#     for the rows it keeps, joining the two scans on (filename, file_row_number). Not file_index: that is a file's
#     position in the scan's list, and the list depends on the scan's filters (§11), which the second scan carries
#     differently (optional, without the dynamic ones). Several files, a deletion vector, and a pruned partitioned
#     table; the answers are the provider scan's.
# ============================================================================
statement ok
ATTACH '{FABRICATOR_DELTA_WRITE_DIR}/fs12' AS l12 (TYPE fabricator, PROVIDER 'delta', READ_ONLY false);

statement ok
CREATE TABLE l12.main.w (id INTEGER, b DOUBLE, s VARCHAR, t VARCHAR);

statement ok
INSERT INTO l12.main.w SELECT r, (r * 37) % 1000, 's' || r, repeat('t', 20) || r FROM range(0, 1000) t(r);

statement ok
INSERT INTO l12.main.w SELECT r, (r * 37) % 1000 + 0.5, 's' || r, repeat('t', 20) || r FROM range(1000, 2000) t(r);

statement ok
INSERT INTO l12.main.w SELECT r, (r * 37) % 1000 + 0.25, 's' || r, repeat('t', 20) || r FROM range(2000, 3000) t(r);

statement ok
DELETE FROM l12.main.w WHERE id IN (0, 1000, 27);

statement ok
SET fabricator_file_scan = true;

query II
EXPLAIN SELECT * FROM l12.main.w ORDER BY b LIMIT 4;
----
physical_plan	<REGEX>:(?s).*Join.*Fabricator File Scan.*Fabricator File Scan.*

query IRTT
SELECT * FROM l12.main.w ORDER BY b, id LIMIT 4;
----
2000	0.25	s2000	tttttttttttttttttttt2000
973	1.0	s973	tttttttttttttttttttt973
2973	1.25	s2973	tttttttttttttttttttt2973
1973	1.5	s1973	tttttttttttttttttttt1973

# the same Top-N through the provider's scan
statement ok
CREATE TEMP TABLE w_on AS SELECT * FROM l12.main.w ORDER BY b DESC, id LIMIT 7;

statement ok
SET fabricator_file_scan = false;

statement ok
CREATE TEMP TABLE w_off AS SELECT * FROM l12.main.w ORDER BY b DESC, id LIMIT 7;

query I
SELECT count(*) FROM (SELECT * FROM w_on EXCEPT ALL SELECT * FROM w_off UNION ALL (SELECT * FROM w_off EXCEPT ALL SELECT * FROM w_on));
----
0

statement ok
SET fabricator_file_scan = true;

# a LIMIT without ORDER BY: any 5 live rows, each a real row of the table
query I
SELECT count(*) FROM (SELECT * FROM l12.main.w LIMIT 5) l JOIN (SELECT * FROM l12.main.w) r USING (id, b, s, t);
----
5

# a pruned partitioned table: the filter rules a part out in the first scan and (as an optional filter) in the second
statement ok
CREATE TABLE l12.main.p (id INTEGER, k VARCHAR, b DOUBLE, s VARCHAR) PARTITIONED BY (k);

statement ok
INSERT INTO l12.main.p SELECT r, CASE WHEN r % 3 = 0 THEN 'x' WHEN r % 3 = 1 THEN 'y' ELSE 'z' END, r * 1.5, 's' || r FROM range(0, 300) t(r);

query ITRT
SELECT * FROM l12.main.p WHERE k <> 'x' ORDER BY b DESC LIMIT 3;
----
299	z	448.5	s299
298	y	447.0	s298
296	z	444.0	s296

query ITRT
SELECT * FROM l12.main.p WHERE k = 'z' ORDER BY b LIMIT 2;
----
2	z	3.0	s2
5	z	7.5	s5

statement ok
DETACH l12;

# ============================================================================
# 13. STRUCT FIELD PUSHDOWN, ONLY WHERE DuckDB 2.0.0 READS IT RIGHT. `s.a` is a scan column, so a join filter on it
#     reaches the parquet reader. DuckDB 2.0.0 raises an INTERNAL error for a path THROUGH a member some file lacks
#     that is itself a struct (docs/duckdb-upstream-issues.md §17), so a struct column with a struct member keeps the
#     whole column. Join filters are read off the profile: the probe scan's rows.
# ============================================================================
statement ok
SET fabricator_file_scan = true;

statement ok
ATTACH '{FABRICATOR_DELTA_WRITE_DIR}/fs13' AS l13 (TYPE fabricator, PROVIDER 'delta', READ_ONLY false);

statement ok
CREATE TABLE l13.main.big AS SELECT {'a': i, 'b': md5(i::VARCHAR)} AS s, {'n': {'x': i % 13}, 'y': i} AS t, i % 7 AS g
FROM range(1, 400001) r(i);

statement ok
CREATE TABLE l13.main.dim AS SELECT i * 199 AS k FROM range(1, 2001) r(i);

query II
EXPLAIN SELECT count(*) FROM l13.main.big b JOIN l13.main.dim d ON b.s.a = d.k;
----
physical_plan	<REGEX>:(?s).*Fabricator File Scan.*Projections: s\.a.*

statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_output = '{FABRICATOR_DELTA_WRITE_DIR}/fs13_s.json';

query II
SELECT count(*), sum(b.g) FROM l13.main.big b JOIN l13.main.dim d ON b.s.a = d.k;
----
2000	6002

statement ok
SET profiling_output = '{FABRICATOR_DELTA_WRITE_DIR}/fs13_t.json';

query II
SELECT count(*), sum(b.g) FROM l13.main.big b JOIN l13.main.dim d ON b.t.y = d.k;
----
2000	6002

statement ok
SET enable_profiling = 'no_output';

# the probe scan hands the join only rows matching its filter (about 2000 of 400000)
query II
SELECT count(*), max(CAST(r AS BIGINT)) < 10000
FROM (SELECT unnest(regexp_extract_all(content, '(?s)"Function": "FABRICATOR_FILE_SCAN".*?"intermediate_rows": (\d+)', 1)) AS r
      FROM read_text('{FABRICATOR_DELTA_WRITE_DIR}/fs13_s.json'));
----
2	true

# `t` has a struct member: no pushdown, the whole column, every row
query I
SELECT max(CAST(r AS BIGINT))
FROM (SELECT unnest(regexp_extract_all(content, '(?s)"Function": "FABRICATOR_FILE_SCAN".*?"intermediate_rows": (\d+)', 1)) AS r
      FROM read_text('{FABRICATOR_DELTA_WRITE_DIR}/fs13_t.json'));
----
400000

# a struct that gained a struct member: the old file lacks it, and projection, WHERE and join all read it right
statement ok
CREATE TABLE l13.main.e (id INTEGER, s STRUCT(a INTEGER));

statement ok
INSERT INTO l13.main.e VALUES (1, {'a': 10});

statement ok
ALTER TABLE l13.main.e ADD COLUMN s.deep STRUCT(q INTEGER);

statement ok
INSERT INTO l13.main.e VALUES (2, {'a': 20, 'deep': {'q': 7}});

query II
SELECT id, s.deep.q FROM l13.main.e ORDER BY id;
----
1	NULL
2	7

query I
SELECT id FROM l13.main.e WHERE s.deep.q = 7;
----
2

query I
SELECT e.id FROM l13.main.e e JOIN (SELECT 7 AS q) k ON e.s.deep.q = k.q;
----
2

# a struct that gained a scalar member: pushed down, and the old file's missing member reads as NULL
statement ok
CREATE TABLE l13.main.f (id INTEGER, s STRUCT(a INTEGER));

statement ok
INSERT INTO l13.main.f VALUES (1, {'a': 10});

statement ok
ALTER TABLE l13.main.f ADD COLUMN s.b INTEGER;

statement ok
INSERT INTO l13.main.f VALUES (2, {'a': 20, 'b': 5});

query II
EXPLAIN SELECT id FROM l13.main.f WHERE s.b = 5;
----
physical_plan	<REGEX>:(?s).*Fabricator File Scan.*s\.b.*

query II
SELECT id, s.b FROM l13.main.f ORDER BY id;
----
1	NULL
2	5

query I
SELECT id FROM l13.main.f WHERE s.b = 5;
----
2

query I
SELECT f.id FROM l13.main.f f JOIN (SELECT 5 AS b) k ON f.s.b = k.b;
----
2

statement ok
DETACH l13;
