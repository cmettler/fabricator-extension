# name: test/verify_delta_row_tracking_virtual.test
# description: Delta `native_read` — the STABLE row-tracking id + commit version as provider VIRTUAL columns
#              (__delta_row_id / __delta_row_commit_version, the Delta materialized-column names): queryable
#              by name, excluded from SELECT *, advertised only for row-tracking tables on native_read
#              catalogs (FABRICATOR_META_VIRTUAL_COLUMNS). Per row: COALESCE(materialized column, baseRowId +
#              file position) / defaultRowCommitVersion — so a buffered (explicit-txn) UPDATE preserves the
#              id and bumps the version (post-images bake materialized ids), OPTIMIZE preserves both
#              (compaction materializes), a DV DELETE removes the row's id. baseRowId is assigned in COMMIT
#              order, so id values are deterministic (unlike file ordinals). The autocommit copy-on-write
#              UPDATE (mapped tables take CoW, not merge-on-read) loses row tracking on the rewritten file —
#              the documented deferred P5-rewrite gap — which reads as NULL (honest, pinned below).
#              Set FABRICATOR_DELTA_WRITE_DIR (writable). Local FS.
# group: [fabricator]

require fabricator

require parquet

require-env FABRICATOR_DELTA_WRITE_DIR

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/rtvirt' AS lake (TYPE fabricator, PROVIDER 'delta', native_read true, native_write true, row_tracking true);

# v0 CREATE + v1 WRITE (ids 0..4), v2 WRITE (ids 5..9) — ids follow commit order
statement ok
CREATE TABLE lake.main.rt AS SELECT r AS id, 'v' || r AS s FROM range(5) t(r);

statement ok
INSERT INTO lake.main.rt SELECT r, 'v' || r FROM range(5, 10) t(r);

# ---- stable ids + per-row commit versions ----

query III
SELECT id, __delta_row_id, __delta_row_commit_version FROM lake.main.rt ORDER BY __delta_row_id;
----
0	0	1
1	1	1
2	2	1
3	3	1
4	4	1
5	5	2
6	6	2
7	7	2
8	8	2
9	9	2

# virtual columns are NOT part of SELECT *
query IT
SELECT * FROM lake.main.rt ORDER BY id LIMIT 1;
----
0	v0

# filter by stable id (exact-mode erased filter on a virtual column — applied by the scan)
query I
SELECT id FROM lake.main.rt WHERE __delta_row_id = 7;
----
7

# the transient rowid still works alongside
query I
SELECT count(DISTINCT rowid) FROM lake.main.rt;
----
10

# ---- buffered (explicit-txn) UPDATE preserves the stable id, bumps the commit version ----

statement ok
BEGIN;

statement ok
UPDATE lake.main.rt SET s = 'upd' WHERE id = 2;

statement ok
COMMIT;

query ITII
SELECT id, s, __delta_row_id, __delta_row_commit_version FROM lake.main.rt WHERE id IN (1, 2, 3) ORDER BY id;
----
1	v1	1	1
2	upd	2	3
3	v3	3	1

# ---- DV DELETE removes the row's id; survivors keep theirs ----

statement ok
DELETE FROM lake.main.rt WHERE id = 6;

query I
SELECT count(*) FROM lake.main.rt WHERE __delta_row_id = 6;
----
0

query I
SELECT count(*) FROM lake.main.rt WHERE __delta_row_id IN (5, 7);
----
2

# ---- OPTIMIZE (compaction) preserves ids + versions via materialized columns ----

query I
SELECT fabricator_exec('lake', 'OPTIMIZE main.rt');
----
0

query III
SELECT id, __delta_row_id, __delta_row_commit_version FROM lake.main.rt WHERE id IN (0, 2, 9) ORDER BY id;
----
0	0	1
2	2	3
9	9	2

# buffered UPDATE of the COMPACTED file (post-OPTIMIZE): the read-back resolves the original id from
# the source's MATERIALIZED column (the compacted file's baseRowId is fresh — ordinal arithmetic would
# bake the wrong id; the closed follow-up gap)
statement ok
BEGIN;

statement ok
UPDATE lake.main.rt SET s = 'opt' WHERE id = 4;

statement ok
COMMIT;

query II
SELECT __delta_row_id, s FROM lake.main.rt WHERE id = 4;
----
4	opt

# ---- explicit transaction: PENDING (uncommitted) rows have no baseRowId yet => NULL; real after COMMIT ----

statement ok
BEGIN;

statement ok
INSERT INTO lake.main.rt SELECT r, 'v' || r FROM range(20, 23) t(r);

query II
SELECT id, __delta_row_id IS NULL FROM lake.main.rt WHERE id >= 20 ORDER BY id;
----
20	true
21	true
22	true

statement ok
COMMIT;

query I
SELECT count(*) FROM lake.main.rt WHERE id >= 20 AND __delta_row_id IS NOT NULL;
----
3

# ---- autocommit UPDATE on the (default) column-mapped table: MERGE-ON-READ since the mapping-gate
#      lift — the stable id is preserved (materialized on the post-image) and the version bumps,
#      identical to the buffered path ----

statement ok
UPDATE lake.main.rt SET s = 'mor' WHERE id = 9;

query II
SELECT __delta_row_id, __delta_row_commit_version FROM lake.main.rt WHERE id = 9;
----
9	8

# ---- PARTITIONED merge-on-read (slice 2): the id survives an UPDATE — including a SET of the
#      PARTITION column, which moves the row to its new partition's file with identity intact ----

statement ok
CREATE TABLE lake.main.pt (id BIGINT, region VARCHAR, s VARCHAR) PARTITIONED BY (region);

statement ok
INSERT INTO lake.main.pt SELECT r, CASE WHEN r % 2 = 0 THEN 'US' ELSE 'EU' END, 'v' || r FROM range(6) t(r);

query I
SELECT count(*) FROM lake.main.pt WHERE __delta_row_id IS NOT NULL;
----
6

statement ok
UPDATE lake.main.pt SET s = 'mor' WHERE id = 2;

query II
SELECT id, __delta_row_id IS NOT NULL FROM lake.main.pt WHERE id = 2;
----
2	true

statement ok
UPDATE lake.main.pt SET region = 'APAC' WHERE id = 3;

query ITI
SELECT id, region, count(*) OVER () FROM lake.main.pt WHERE __delta_row_id IS NOT NULL AND id = 3;
----
3	APAC	1

query I
SELECT count(*) FROM lake.main.pt WHERE region = 'APAC';
----
1

# buffered partitioned UPDATE with materialize (gate lifted with the partition-split id carry)
statement ok
BEGIN;

statement ok
UPDATE lake.main.pt SET s = 'txn' WHERE id = 4;

statement ok
COMMIT;

query II
SELECT id, __delta_row_id IS NOT NULL FROM lake.main.pt WHERE id = 4;
----
4	true

# ---- CDF merge-on-read (slice 3): the id survives an UPDATE on a Change-Data-Feed table, and the
#      feed reads EXACTLY pre+post images (the commit is cdc-only — the DV re-add and the post-image
#      add never double-count as inserts) ----

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/rtvirt3' AS lake4 (TYPE fabricator, PROVIDER 'delta', native_read true, native_write true, row_tracking true, change_data_feed true);

statement ok
CREATE TABLE lake4.main.cd AS SELECT r AS id, 'v' || r AS s FROM range(4) t(r);

query I
SELECT count(*) FROM lake4.main.cd WHERE __delta_row_id IS NOT NULL;
----
4

statement ok
UPDATE lake4.main.cd SET s = 'mor' WHERE id = 1;

query II
SELECT id, __delta_row_id FROM lake4.main.cd WHERE id = 1;
----
1	1

query TIT
SELECT _change_type, id, s FROM fabricator_delta_changes('lake4', 'main.cd', 2) ORDER BY _change_type;
----
update_postimage	1	mor
update_preimage	1	v1

query TI
SELECT _change_type, count(*) FROM fabricator_delta_changes('lake4', 'main.cd', 0) GROUP BY _change_type ORDER BY _change_type;
----
insert	4
update_postimage	1
update_preimage	1

# ---- CDF × PARTITIONED merge-on-read (slice 4): the last gate — ids preserved, and the feed's
#      partition column comes from the cdc action's partitionValues (cdc files exclude it from the
#      bytes, the data-file convention; a partition-key SET shows old/new partitions in pre/post).
#      The only shapes still falling to copy-on-write (row tracking lost) are type-widened and
#      IcebergCompat tables — neither creatable by this provider. ----

statement ok
CREATE TABLE lake4.main.cdp (id BIGINT, region VARCHAR, s VARCHAR) PARTITIONED BY (region);

statement ok
INSERT INTO lake4.main.cdp SELECT r, CASE WHEN r % 2 = 0 THEN 'US' ELSE 'EU' END, 'v' || r FROM range(4) t(r);

statement ok
UPDATE lake4.main.cdp SET s = 'mor' WHERE id = 1;

query II
SELECT id, __delta_row_id FROM lake4.main.cdp WHERE id = 1;
----
1	2

query TTIT
SELECT _change_type, region, id, s FROM fabricator_delta_changes('lake4', 'main.cdp', 2) ORDER BY _change_type;
----
update_postimage	EU	1	mor
update_preimage	EU	1	v1

# partition-key SET: the feed shows the move (pre in the old partition, post in the new)
statement ok
UPDATE lake4.main.cdp SET region = 'APAC' WHERE id = 3;

query TTI
SELECT _change_type, region, id FROM fabricator_delta_changes('lake4', 'main.cdp', 3) ORDER BY _change_type;
----
update_postimage	APAC	3
update_preimage	EU	3

query II
SELECT id, __delta_row_id IS NOT NULL FROM lake4.main.cdp WHERE id = 3;
----
3	true

# buffered txn on partitioned CDF (guard lifted): one fused commit, exact feed
statement ok
BEGIN;

statement ok
INSERT INTO lake4.main.cdp VALUES (20, 'US', 'v20');

statement ok
UPDATE lake4.main.cdp SET s = 'txn' WHERE id = 2;

statement ok
DELETE FROM lake4.main.cdp WHERE id = 0;

statement ok
COMMIT;

query TTIT
SELECT _change_type, region, id, s FROM fabricator_delta_changes('lake4', 'main.cdp', 4) ORDER BY _change_type, id;
----
delete	US	0	v0
insert	US	20	v20
update_postimage	US	2	txn
update_preimage	US	2	v2

statement ok
DETACH lake4;

# ---- COPY-ON-WRITE preservation (the closed P5 gap): a DV-OFF row-tracking table (the PolyBase /
#      protocol-1.0 recipe — e.g. synced to Fabric via a shortcut) keeps stable ids through CoW
#      UPDATE/DELETE: the rewrite materializes each survivor's ORIGINAL id + commit version (source
#      materialized value where the file was itself rewritten before, else baseRowId + position). ----

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/rtvirtcow' AS lake5 (TYPE fabricator, PROVIDER 'delta', native_read true, native_write true, deletion_vectors false, column_mapping 'none', row_tracking true);

statement ok
CREATE TABLE lake5.main.cw (id BIGINT, s VARCHAR);

statement ok
INSERT INTO lake5.main.cw SELECT r, 'v' || r FROM range(6) t(r);

# CoW UPDATE (native rewriter): the updated row keeps its id, version bumps; others untouched
statement ok
UPDATE lake5.main.cw SET s = 'upd' WHERE id = 2;

query IIII rowsort
SELECT id, __delta_row_id, __delta_row_commit_version, s = 'upd' FROM lake5.main.cw;
----
0	0	1	false
1	1	1	false
2	2	2	true
3	3	1	false
4	4	1	false
5	5	1	false

# CoW DELETE: survivors keep ids + versions
statement ok
DELETE FROM lake5.main.cw WHERE id = 4;

query III rowsort
SELECT id, __delta_row_id, __delta_row_commit_version FROM lake5.main.cw;
----
0	0	1
1	1	1
2	2	2
3	3	1
5	5	1

# chained: updating the ALREADY-rewritten file (materialized source values carry through)
statement ok
UPDATE lake5.main.cw SET s = 'up2' WHERE id = 3;

query III rowsort
SELECT id, __delta_row_id, __delta_row_commit_version FROM lake5.main.cw;
----
0	0	1
1	1	1
2	2	2
3	3	4
5	5	1

statement ok
DETACH lake5;

# same shapes through the EW codec writer/reader (no native_write)
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/rtvirtcow2' AS lake6 (TYPE fabricator, PROVIDER 'delta', native_read true, deletion_vectors false, column_mapping 'none', row_tracking true);

statement ok
CREATE TABLE lake6.main.cw (id BIGINT, s VARCHAR);

statement ok
INSERT INTO lake6.main.cw SELECT r, 'v' || r FROM range(6) t(r);

statement ok
UPDATE lake6.main.cw SET s = 'upd' WHERE id = 2;

statement ok
DELETE FROM lake6.main.cw WHERE id = 4;

query III rowsort
SELECT id, __delta_row_id, __delta_row_commit_version FROM lake6.main.cw;
----
0	0	1
1	1	1
2	2	2
3	3	1
5	5	1

statement ok
DETACH lake6;

# ---- gating ----

# a table WITHOUT row tracking: the names simply don't exist
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/rtvirt2' AS lake2 (TYPE fabricator, PROVIDER 'delta', native_read true, deletion_vectors false, row_tracking false);

statement ok
CREATE TABLE lake2.main.nt AS SELECT 1 AS a;

statement error
SELECT __delta_row_id FROM lake2.main.nt;
----
not found

# a NON-native (codec) catalog does not advertise the virtual columns even on a row-tracking table
# PROVIDER 'engineeredwooddelta': the point of this section is that a catalog WITHOUT the native reader does
# not bind __delta_row_id at all. Under 'delta' the native reader binds them, which is correct behaviour and
# would make this negative pin fail.
statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/rtvirt' AS lake3
  (TYPE fabricator, PROVIDER 'engineeredwooddelta', READ_ONLY true);

statement error
SELECT __delta_row_id FROM lake3.main.rt;
----
not found

# the same table's DATA still reads fine on the codec catalog
query I
SELECT count(*) FROM lake3.main.rt;
----
12

statement ok
DETACH lake3;

statement ok
DETACH lake2;

statement ok
DETACH lake;

# ---- STABLE-ID FAST PATH: file skipping + zone-map-prunable per-file conditions for filters on the
#      row-tracking virtual columns. Derived files (plain appends) prune from the LOG alone
#      ([baseRowId, baseRowId+numRecords) for the id; the per-file CONSTANT defaultRowCommitVersion for
#      the version) and the id constraint rewrites to a file_row_number predicate (parquet row-group
#      skipping); materialized files (rewrites) push the constraint onto the PHYSICAL column
#      ((pred OR IS NULL) — single-column, zone-map prunable). Use cases: point lookups, dedup DELETEs
#      without a unique key, version-based incremental extracts. ----

statement ok
ATTACH '${FABRICATOR_DELTA_WRITE_DIR}/rtfast' AS lakef (TYPE fabricator, PROVIDER 'delta', native_read true, native_write true, row_tracking true);

# three derived files: ids 0-4 (v1), 5-9 (v2), 10-14 (v3)
statement ok
CREATE TABLE lakef.main.ft AS SELECT r AS id, 'v' || r AS s FROM range(5) t(r);

statement ok
INSERT INTO lakef.main.ft SELECT r, 'v' || r FROM range(5, 10) t(r);

statement ok
INSERT INTO lakef.main.ft SELECT r, 'v' || r FROM range(10, 15) t(r);

statement ok
CALL enable_logging(level := 'debug', storage := 'memory');

# point lookup: only the middle file can hold id 7 — the other two are SKIPPED from the log
query ITI
SELECT id, s, __delta_row_id FROM lakef.main.ft WHERE __delta_row_id = 7;
----
7	v7	7

query I
SELECT count(*) >= 2 FROM duckdb_logs
WHERE type = 'Fabricator.Delta.Native' AND message LIKE '%rowtracking skip%';
----
true

# and the surviving file's condition took the row-group-skippable file_row_number form (id 7 - base 5 = 2)
query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type = 'Fabricator.Delta.Native' AND message LIKE '%file_row_number IN (2)%';
----
true

# IN across two files: the middle file is skipped
query II
SELECT id, __delta_row_id FROM lakef.main.ft WHERE __delta_row_id IN (2, 12) ORDER BY id;
----
2	2
12	12

# range: only the last file qualifies
query I
SELECT count(*) FROM lakef.main.ft WHERE __delta_row_id >= 12;
----
3

query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type = 'Fabricator.Delta.Native' AND message LIKE '%file_row_number >= 2%';
----
true

# version filter (the incremental-extract pattern): derived files match/skip WHOLE (per-file constant)
query I
SELECT count(*) FROM lakef.main.ft WHERE __delta_row_commit_version = 3;
----
5

query I
SELECT count(*) FROM lakef.main.ft WHERE __delta_row_commit_version >= 2;
----
10

statement ok
CALL disable_logging();

# ---- materialized files (post-OPTIMIZE): the constraint pushes onto the PHYSICAL column ----

query I
SELECT fabricator_exec('lakef', 'OPTIMIZE main.ft');
----
0

statement ok
CALL enable_logging(level := 'debug', storage := 'memory');

# the compacted file carries materialized ORIGINAL ids — lookup stays exact
query ITI
SELECT id, s, __delta_row_id FROM lakef.main.ft WHERE __delta_row_id = 7;
----
7	v7	7

# the per-file condition is the zone-map-prunable physical-column form (OR IS NULL keeps
# derived-fallback rows visible)
query I
SELECT count(*) > 0 FROM duckdb_logs
WHERE type = 'Fabricator.Delta.Native' AND message LIKE '%OR "__delta_row_id" IS NULL%';
----
true

statement ok
CALL disable_logging();

# mixed table: a fresh derived file after the compaction — lookups on both kinds stay exact.
# NOTE the compaction's new add consumed FRESH baseRowId space (15 rows -> HWM 30, the materialized
# column preserving the original ids 0-14), so the post-OPTIMIZE INSERT's rows get stable ids 30-34.
statement ok
INSERT INTO lakef.main.ft SELECT r, 'v' || r FROM range(15, 20) t(r);

query II
SELECT id, __delta_row_id FROM lakef.main.ft WHERE __delta_row_id IN (7, 32) ORDER BY id;
----
7	7
17	32

# ---- DML through the fast path: DELETE by stable id ----

query I
DELETE FROM lakef.main.ft WHERE __delta_row_id IN (0, 14);
----
2

query II
SELECT count(*), sum(id) FROM lakef.main.ft;
----
18	176

# the deleted ids are gone; their neighbors remain
query I
SELECT count(*) FROM lakef.main.ft WHERE __delta_row_id IN (0, 1, 13, 14);
----
2

# ---- dedup DELETE without a unique key: keep min(__delta_row_id) per duplicate group ----

statement ok
CREATE TABLE lakef.main.dup AS SELECT r % 3 AS k, 'x' AS v FROM range(9) t(r);

query I
DELETE FROM lakef.main.dup
WHERE __delta_row_id NOT IN (SELECT min(__delta_row_id) FROM lakef.main.dup GROUP BY k, v);
----
6

# exactly one row per group survives — the FIRST-inserted one (ids 0,1,2)
query ITI
SELECT k, v, __delta_row_id FROM lakef.main.dup ORDER BY k;
----
0	x	0
1	x	1
2	x	2

statement ok
DETACH lakef;
