# name: test/verify_mssql_s3_polybase.test
# description: The FULL CIRCLE — our Delta provider writes a table to MinIO (s3://), and SQL Server 2025
#              reads it back over its NATIVE S3 data virtualization (no PolyBase package needed on 17.x),
#              driven through our mssql provider: OPENROWSET(FORMAT='DELTA') + CREATE EXTERNAL TABLE, both
#              provisioned via fabricator_exec and read via fabricator_query / a normal catalog scan. The
#              SQL-side DELTA reader supports Delta protocol 1.0 ONLY, so the interop table is written
#              with deletion_vectors false + column_mapping 'none' (plain minReader-1); a DV-default
#              table is pinned as NOT readable. Requires the docker/docker-compose.yml stack (MinIO with
#              the self-signed TLS cert SQL Server trusts via /var/opt/mssql/security/ca-certificates).
# group: [fabricator]

require fabricator

require httpfs

# §5c writes with `native_write true`, whose data files are produced by a host `COPY ... (FORMAT parquet)`
# on a fresh connection — so this suite needs the parquet COPY function in the catalog. Declaring it here is
# load-bearing on a BARE machine: without the directive nothing loads parquet, and the copy-function lookup
# falls back to autoload-from-DISK, which finds nothing ("Copy Function with name \"parquet\" is not in the
# catalog"). A developer box passes either way because it has parquet installed under ~/.duckdb — reproduce
# the bare case with an empty USERPROFILE (see CLAUDE.md).
require parquet

require-env MSSQL_TESTDB_DSN

require-env FABRICATOR_S3_ENDPOINT

require-env FABRICATOR_S3_SQL_ENDPOINT

# The test rig's MinIO serves a SELF-SIGNED cert (SQL Server trusts it via its CA mount; DuckDB's
# curl-based httpfs verifies against the system store) — disable verification GLOBALLY (the transaction
# flush runs on its own connection, which must inherit it).
# (Production alternative: SET ca_cert_file = '<path to docker/certs/public.crt>'.)
statement ok
SET GLOBAL enable_curl_server_cert_verification = false;

statement ok
CREATE SECRET minio_s3 (TYPE s3, KEY_ID 'miniouser', SECRET 'miniosecret123',
                        ENDPOINT '${FABRICATOR_S3_ENDPOINT}', URL_STYLE 'path', REGION 'us-east-1',
                        USE_SSL true);

# ---- 1. our Delta provider writes the interop table (PLAIN delta: protocol 1.0-readable) ----
# Attach WITH the secret so the COMMIT rename routes through S3CommitFileSystem (SDK conditional PUT) —
# CREATE OR REPLACE over an EXISTING table then works (plain httpfs never does put-if-absent, so its
# DROP-then-recreate leaves version 0 -> "version 0 already exists"; the secret path is re-runnable).
# The secret changes only the commit filesystem, not the table protocol — the interop tables stay
# protocol-1.0 plain (deletion_vectors false, column_mapping none) so SQL Server's DELTA reader reads them.
statement ok
ATTACH 's3://fabricator/polybase' AS plake (TYPE fabricator, PROVIDER 'delta', READ_ONLY false,
                                          deletion_vectors false, column_mapping 'none', SECRET minio_s3);

statement ok
CREATE OR REPLACE TABLE plake.main.trips AS
SELECT i AS id, CAST(i * 100 AS BIGINT) AS amount, 'city' || (i % 3) AS city,
       CAST(i AS DOUBLE) / 4 AS score, DATE '2026-01-01' + i::INT AS d
FROM range(1, 9) r(i);

query IITR
SELECT id, amount, city, score FROM plake.main.trips ORDER BY id LIMIT 3;
----
1	100	city1	0.25
2	200	city2	0.5
3	300	city0	0.75

# ---- 2. SQL Server side: self-provision the S3 credential/data source/file format ----
statement ok
ATTACH '${MSSQL_TESTDB_DSN}' AS sqldb (TYPE fabricator);

statement ok
SELECT fabricator_exec('sqldb',
  'IF NOT EXISTS (SELECT 1 FROM sys.symmetric_keys WHERE name = ''##MS_DatabaseMasterKey##'')
     CREATE MASTER KEY ENCRYPTION BY PASSWORD = ''Arrow_Net_123!MK''');

statement ok
SELECT fabricator_exec('sqldb',
  'IF NOT EXISTS (SELECT 1 FROM sys.database_scoped_credentials WHERE name = ''s3_dc'')
     CREATE DATABASE SCOPED CREDENTIAL s3_dc WITH IDENTITY = ''S3 Access Key'',
       SECRET = ''miniouser:miniosecret123''');

statement ok
SELECT fabricator_exec('sqldb',
  'IF NOT EXISTS (SELECT 1 FROM sys.external_data_sources WHERE name = ''s3_ds'')
     CREATE EXTERNAL DATA SOURCE s3_ds WITH (LOCATION = ''s3://${FABRICATOR_S3_SQL_ENDPOINT}/'',
       CREDENTIAL = s3_dc)');

statement ok
SELECT fabricator_exec('sqldb',
  'IF NOT EXISTS (SELECT 1 FROM sys.external_file_formats WHERE name = ''DeltaFileFormat'')
     CREATE EXTERNAL FILE FORMAT DeltaFileFormat WITH (FORMAT_TYPE = DELTA)');

# ---- 3. OPENROWSET(FORMAT='DELTA'): SQL Server reads what our provider wrote ----
query IIT
SELECT id, amount, city FROM fabricator_query('sqldb',
  'SELECT id, amount, city FROM OPENROWSET(BULK ''/fabricator/polybase/trips'', FORMAT = ''DELTA'',
     DATA_SOURCE = ''s3_ds'') AS r ORDER BY id')
ORDER BY id;
----
1	100	city1
2	200	city2
3	300	city0
4	400	city1
5	500	city2
6	600	city0
7	700	city1
8	800	city2

query II
SELECT cnt, total FROM fabricator_query('sqldb',
  'SELECT COUNT(*) AS cnt, SUM(amount) AS total FROM OPENROWSET(BULK ''/fabricator/polybase/trips'',
     FORMAT = ''DELTA'', DATA_SOURCE = ''s3_ds'') AS r');
----
8	3600

# ---- 4. CREATE EXTERNAL TABLE + read it through the ATTACHed catalog as a normal table scan ----
statement ok
SELECT fabricator_exec('sqldb',
  'IF OBJECT_ID(''dbo.s3_delta_trips'') IS NOT NULL DROP EXTERNAL TABLE dbo.s3_delta_trips');

statement ok
SELECT fabricator_exec('sqldb',
  'CREATE EXTERNAL TABLE dbo.s3_delta_trips (id INT, amount BIGINT, city VARCHAR(20),
     score FLOAT, d DATE)
   WITH (LOCATION = ''/fabricator/polybase/trips'', DATA_SOURCE = s3_ds,
         FILE_FORMAT = DeltaFileFormat)');

statement ok
SELECT fabricator_refresh_cache('sqldb');

# Our provider scanning a SQL Server EXTERNAL table whose data lives in MinIO, written by our Delta
# provider — DuckDB -> fabricator -> SQL Server -> S3 delta reader -> MinIO.
query IIT
SELECT id, amount, city FROM sqldb.dbo.s3_delta_trips ORDER BY id LIMIT 4;
----
1	100	city1
2	200	city2
3	300	city0
4	400	city1

query I
SELECT count(*) FROM sqldb.dbo.s3_delta_trips;
----
8

# ---- 4b. copy-on-write DML keeps the table SQL-Server-readable (plain remove+add, protocol 1.0) ----
statement ok
DELETE FROM plake.main.trips WHERE id IN (2, 7);

statement ok
UPDATE plake.main.trips SET city = 'rewritten' WHERE id = 5;

query IIT
SELECT id, amount, city FROM fabricator_query('sqldb',
  'SELECT id, amount, city FROM OPENROWSET(BULK ''/fabricator/polybase/trips'', FORMAT = ''DELTA'',
     DATA_SOURCE = ''s3_ds'') AS r ORDER BY id')
ORDER BY id;
----
1	100	city1
3	300	city0
4	400	city1
5	500	rewritten
6	600	city0
8	800	city2

# ---- 5. negative pin: a DV-DEFAULT table is NOT readable by SQL Server's 1.0 reader ----
#
# ⚠ This section proves the OUTCOME, not the CAUSE, and the comment here used to claim the cause ("reader
# v3"). It is wrong: a DV-default attach also turns COLUMN MAPPING on, and the mapping check fires first,
# so what this actually observes is 19725 — the same error §6 below attributes to mapping. Measured
# separately (on ADLS and S3 alike): mapping on => 19725; deletion vectors DECLARED but never materialized
# => reads FINE; a DV MATERIALIZED by a DELETE => 19726. The `statement error` below carries no expected
# text, so it cannot tell those apart and passes either way.
#
# The isolated pins live in test/verify_mssql_adls_polybase.test §5, which varies one flag at a time and
# also shows that CREATE OR REPLACE does NOT clear a materialized DV (only a real DROP does). Left as-is
# here rather than re-pointed: tightening a CI-tier assertion needs its own measurement on THIS backend.
statement ok
ATTACH 's3://fabricator/polybase-dv' AS dvlake (TYPE fabricator, PROVIDER 'delta', READ_ONLY false);

statement ok
CREATE OR REPLACE TABLE dvlake.main.dvt AS SELECT 1 AS i;

statement error
SELECT * FROM fabricator_query('sqldb',
  'SELECT * FROM OPENROWSET(BULK ''/fabricator/polybase-dv/dvt'', FORMAT = ''DELTA'',
     DATA_SOURCE = ''s3_ds'') AS r');
----

statement ok
DETACH dvlake;

# ...and a NAME-mapped table is rejected too — with a SPECIFIC error (SQL Server's reader recognizes
# the columnMapping feature and refuses it: "19725: Column mapping is not enabled").
statement ok
ATTACH 's3://fabricator/polybase-cm' AS cmlake (TYPE fabricator, PROVIDER 'delta', READ_ONLY false,
                                              deletion_vectors false, column_mapping 'name');

statement ok
CREATE OR REPLACE TABLE cmlake.main.cmt AS SELECT 1 AS i, 'x' AS v;

statement error
SELECT * FROM fabricator_query('sqldb',
  'SELECT * FROM OPENROWSET(BULK ''/fabricator/polybase-cm/cmt'', FORMAT = ''DELTA'',
     DATA_SOURCE = ''s3_ds'') AS r');
----
Column mapping

statement ok
DETACH cmlake;

# ---- 5b. IDENTITY is a WRITER-only feature (writer v7, reader stays 1) — SQL Server READS it ----
statement ok
ATTACH 's3://fabricator/polybase-id' AS idlake (TYPE fabricator, PROVIDER 'delta', READ_ONLY false,
                                              deletion_vectors false, column_mapping 'none');

statement ok
DROP TABLE IF EXISTS idlake.main.ids;

statement ok
CREATE TABLE idlake.main.ids (id BIGINT AS (0), name VARCHAR);

statement ok
INSERT INTO idlake.main.ids (name) VALUES ('a'), ('b'), ('c');

query IT
SELECT id, name FROM fabricator_query('sqldb',
  'SELECT id, name FROM OPENROWSET(BULK ''/fabricator/polybase-id/ids'', FORMAT = ''DELTA'',
     DATA_SOURCE = ''s3_ds'') AS r ORDER BY id')
ORDER BY id;
----
1	a
2	b
3	c

statement ok
DROP TABLE idlake.main.ids;

statement ok
DETACH idlake;

# ---- 5c. Change Data Feed is a WRITER-only feature too — SQL Server reads the CURRENT state ----
statement ok
ATTACH 's3://fabricator/polybase-cdf' AS cdflake (TYPE fabricator, PROVIDER 'delta', READ_ONLY false,
                                                change_data_feed true, deletion_vectors false,
                                                column_mapping 'none');

statement ok
DROP TABLE IF EXISTS cdflake.main.f;

statement ok
CREATE TABLE cdflake.main.f (id INTEGER, name VARCHAR);

statement ok
INSERT INTO cdflake.main.f VALUES (1, 'a'), (2, 'b'), (3, 'c');

statement ok
DELETE FROM cdflake.main.f WHERE id = 2;

statement ok
UPDATE cdflake.main.f SET name = 'upd' WHERE id = 3;

query IT
SELECT id, name FROM fabricator_query('sqldb',
  'SELECT id, name FROM OPENROWSET(BULK ''/fabricator/polybase-cdf/f'', FORMAT = ''DELTA'',
     DATA_SOURCE = ''s3_ds'') AS r ORDER BY id')
ORDER BY id;
----
1	a
3	upd

statement ok
DROP TABLE cdflake.main.f;

statement ok
DETACH cdflake;

# ---- 5c. ROW TRACKING stays SQL-Server-readable (writer-only, minReader stays 1) — including after
#      OPTIMIZE materializes the physical __delta_row_id column into the compacted file (an extra
#      parquet column not in the Delta schema; the reader ignores it). Live-probed 2026-07-13. ----

statement ok
ATTACH 's3://fabricator/polybase-rt' AS rtlake (TYPE fabricator, PROVIDER 'delta', READ_ONLY false,
                                              native_read true, native_write true,
                                              deletion_vectors false, column_mapping 'none',
                                              row_tracking true);

statement ok
CREATE OR REPLACE TABLE rtlake.main.f AS SELECT r AS id, 'v' || r AS name FROM range(6) t(r);

statement ok
INSERT INTO rtlake.main.f SELECT r, 'v' || r FROM range(6, 12) t(r);

query III
SELECT cnt, mn, mx FROM fabricator_query('sqldb',
  'SELECT count(*) AS cnt, min(id) AS mn, max(id) AS mx FROM OPENROWSET(BULK ''/fabricator/polybase-rt/f'',
     FORMAT = ''DELTA'', DATA_SOURCE = ''s3_ds'') AS r');
----
12	0	11

statement ok
SELECT fabricator_exec('rtlake', 'OPTIMIZE main.f');

query III
SELECT cnt, mn, mx FROM fabricator_query('sqldb',
  'SELECT count(*) AS cnt, min(id) AS mn, max(id) AS mx FROM OPENROWSET(BULK ''/fabricator/polybase-rt/f'',
     FORMAT = ''DELTA'', DATA_SOURCE = ''s3_ds'') AS r');
----
12	0	11

# CoW UPDATE (DV off => copy-on-write) now PRESERVES the stable row id — the rewrite materializes
# __delta_row_id + __delta_row_commit_version into the new file; the PolyBase reader ignores both
# extra columns and reads the post-update state exactly.
statement ok
UPDATE rtlake.main.f SET name = 'upd' WHERE id = 5;

# re-run-safe (the persistent bucket's HWM keeps growing): rows 4 and 5 were inserted consecutively,
# so a PRESERVED id keeps the +1 relationship — a re-id would jump to a fresh HWM value.
query I
SELECT (SELECT __delta_row_id FROM rtlake.main.f WHERE id = 5)
     - (SELECT __delta_row_id FROM rtlake.main.f WHERE id = 4);
----
1

query IT
SELECT id, name FROM fabricator_query('sqldb',
  'SELECT id, name FROM OPENROWSET(BULK ''/fabricator/polybase-rt/f'', FORMAT = ''DELTA'',
     DATA_SOURCE = ''s3_ds'') AS r WHERE id IN (4, 5, 6) ORDER BY id')
ORDER BY id;
----
4	v4
5	upd
6	v6

statement ok
DETACH rtlake;

# ---- 6. INSERT INTO an external table routes to STORAGE (slice C) — a capability SQL Server lacks ----
# The catalog detects the target (sys.external_tables → s3:// data source + DELTA/PARQUET format) and
# writes DIRECTLY to the location: a Delta append (one commit, transient delta catalog) or one new parquet
# file. The DuckDB s3 secret's ENDPOINT is authoritative (SQL's LOCATION host is ITS network view — the
# FABRICATOR_S3_ENDPOINT vs FABRICATOR_S3_SQL_ENDPOINT split). SQL Server serves the reads as usual.

# a fresh interop table with types matching the external declaration exactly
statement ok
CREATE OR REPLACE TABLE plake.main.ins AS
SELECT CAST(i AS BIGINT) AS id, 'seed' || i AS name FROM range(1, 3) r(i);

statement ok
SELECT fabricator_exec('sqldb',
  'IF OBJECT_ID(''dbo.s3_delta_ins'') IS NOT NULL DROP EXTERNAL TABLE dbo.s3_delta_ins');

statement ok
SELECT fabricator_exec('sqldb',
  'CREATE EXTERNAL TABLE dbo.s3_delta_ins (id BIGINT, name VARCHAR(20))
   WITH (LOCATION = ''/fabricator/polybase/ins'', DATA_SOURCE = s3_ds, FILE_FORMAT = DeltaFileFormat)');

statement ok
SELECT fabricator_refresh_cache('sqldb');

# the INSERT goes through the ATTACHed SQL catalog — and lands in the Delta table on MinIO
statement ok
INSERT INTO sqldb.dbo.s3_delta_ins VALUES (100, 'newrow');

# SQL Server reads the appended row through the SAME external table (CREATE OR REPLACE reset the delta
# state this run, so counts are exact)
query IT
SELECT id, name FROM fabricator_query('sqldb',
  'SELECT id, name FROM OPENROWSET(BULK ''/fabricator/polybase/ins'', FORMAT = ''DELTA'',
     DATA_SOURCE = ''s3_ds'') AS r ORDER BY id')
ORDER BY id;
----
1	seed1
2	seed2
100	newrow

# ... and through the catalog's normal table scan of the external table
query I
SELECT count(*) FROM sqldb.dbo.s3_delta_ins;
----
3

# our own delta view of the location agrees (the append kept the table protocol-1.0 plain)
query I
SELECT count(*) FROM plake.main.ins;
----
3

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# INSERT ... SELECT from the SAME catalog — the shape whose scan the host MARKS
#
# Everything above inserts VALUES, which has no scan, so none of it exercises the sink mark at all.
# Here the source is a regular table in the SAME SQL Server catalog, so FabricatorCatalog::
# MarkSinkOnOwnScans names the sink on that scan and the PROVIDER decides whether to drain it. The
# answer here is NO: an external table's INSERT routes to STORAGE, so no SqlBulkCopy ever runs on the
# pinned connection and there is nothing for an open reader to collide with.
#
# ⚠ WHAT THIS SECTION CAN AND CANNOT ASSERT. It pins the RESULT of the shape — which was uncovered
# until now — not the streaming. Whether the scan was drained is invisible from SQL; it is visible as
# the `mssql scan: drained to memory` mark under FABRICATOR_LOG_LEVEL=Debug, and measured in
# docs/transactions.md. The DANGEROUS direction needs no assertion here and already has one:
# if the provider ever streamed a scan whose sink really does bulk-load,
# verify_read_write_same_catalog fails with error 595 at its 30k+ row sections.

statement ok
SELECT fabricator_exec('sqldb',
  'IF OBJECT_ID(''dbo.s3_ins_src'') IS NOT NULL DROP TABLE dbo.s3_ins_src');

statement ok
SELECT fabricator_exec('sqldb',
  'CREATE TABLE dbo.s3_ins_src (id BIGINT, name VARCHAR(20))');

statement ok
SELECT fabricator_exec('sqldb',
  'INSERT INTO dbo.s3_ins_src VALUES (200, ''fromsel''), (201, ''fromsel'')');

statement ok
SELECT fabricator_refresh_cache('sqldb');

statement ok
INSERT INTO sqldb.dbo.s3_delta_ins SELECT id, name FROM sqldb.dbo.s3_ins_src;

# the rows really crossed: SQL Server's own external-table read sees them
query IT
SELECT id, name FROM sqldb.dbo.s3_delta_ins WHERE id >= 200 ORDER BY id;
----
200	fromsel
201	fromsel

# and our Delta view of the same location agrees — 3 from the VALUES sections + 2 here
query I
SELECT count(*) FROM plake.main.ins;
----
5

statement ok
SELECT fabricator_exec('sqldb', 'DROP TABLE dbo.s3_ins_src');

# guard: the storage write is its own Delta commit — it cannot join an explicit DuckDB transaction
statement ok
BEGIN;

statement error
INSERT INTO sqldb.dbo.s3_delta_ins VALUES (101, 'txnrow');
----
cannot roll back with an explicit

statement ok
ROLLBACK;

# guard: INSERT ... RETURNING has no OUTPUT INSERTED rows on the storage path
statement error
INSERT INTO sqldb.dbo.s3_delta_ins VALUES (102, 'retrow') RETURNING id;
----
not supported on external table

# ---- 6b. PARQUET-format external table: INSERT = one new parquet file in the folder ----
statement ok
COPY (SELECT CAST(1 AS BIGINT) AS id, 'pqseed' AS name) TO 's3://fabricator/polybase/pq/seed.parquet' (FORMAT parquet);

statement ok
SELECT fabricator_exec('sqldb',
  'IF NOT EXISTS (SELECT 1 FROM sys.external_file_formats WHERE name = ''ParquetFileFormat'')
     CREATE EXTERNAL FILE FORMAT ParquetFileFormat WITH (FORMAT_TYPE = PARQUET)');

statement ok
SELECT fabricator_exec('sqldb',
  'IF OBJECT_ID(''dbo.s3_pq_ins'') IS NOT NULL DROP EXTERNAL TABLE dbo.s3_pq_ins');

statement ok
SELECT fabricator_exec('sqldb',
  'CREATE EXTERNAL TABLE dbo.s3_pq_ins (id BIGINT, name VARCHAR(20))
   WITH (LOCATION = ''/fabricator/polybase/pq'', DATA_SOURCE = s3_ds, FILE_FORMAT = ParquetFileFormat)');

statement ok
SELECT fabricator_refresh_cache('sqldb');

statement ok
INSERT INTO sqldb.dbo.s3_pq_ins VALUES (200, 'pqnew');

# the new file is visible through the external table (folder LOCATION reads all files; uuid-named INSERT
# files ACCUMULATE across test re-runs on the persistent bucket -> tolerant pins)
query I
SELECT count(*) >= 2 FROM sqldb.dbo.s3_pq_ins;
----
true

query I
SELECT count(*) >= 1 FROM sqldb.dbo.s3_pq_ins WHERE id = 200 AND name = 'pqnew';
----
true

query I
SELECT count(*) >= 1 FROM sqldb.dbo.s3_pq_ins WHERE name = 'pqseed';
----
true

# ---- 6c. DROP TABLE on a detected external table routes to DROP EXTERNAL TABLE (metadata-only) ----
statement ok
DROP TABLE sqldb.dbo.s3_delta_ins;

query I
SELECT count(*) FROM fabricator_query('sqldb',
  'SELECT CAST(name AS VARCHAR(50)) AS name FROM sys.external_tables WHERE name = ''s3_delta_ins''');
----
0

# the delta data itself STAYS on storage (metadata-only drop) — 3 from the VALUES sections
# plus the 2 the INSERT ... SELECT section added
query I
SELECT count(*) FROM plake.main.ins;
----
5

statement ok
DROP TABLE sqldb.dbo.s3_pq_ins;

# ---- 6d. identity-keyed UPDATE/DELETE (slice D): a Delta IDENTITY column bridges the rowid domains ----
# The external table has no PK/UNIQUE/IDENTITY SQL-side, but its Delta target's engine-assigned identity
# column is a real, PolyBase-readable data column with standard stats — it becomes the entry's rowid. The
# scan (through SQL Server) produces identity values; the DML resolves them back to transient rowids on
# the Delta side with a PRUNED scan and runs the delta provider's own rowid DELETE/UPDATE (CoW here —
# the table stays protocol-1.0 SQL-readable). Identity values are snapshot-independent, so the two sides
# never need to agree on a version.

# DROP + CREATE as SEPARATE statements (not CREATE OR REPLACE): an EMPTY CREATE OR REPLACE over an
# existing S3 table takes the DropTable+create-v0 path, whose post-delete _delta_log listing is stale
# within the one statement -> "version 0 already exists" (a pre-existing S3 limitation; a CTAS
# CREATE OR REPLACE is unaffected — it Overwrites the existing table). Separate statements settle the view.
statement ok
DROP TABLE IF EXISTS plake.main.iddml;

statement ok
CREATE TABLE plake.main.iddml (id BIGINT AS (0), name VARCHAR, val INTEGER);

statement ok
INSERT INTO plake.main.iddml (name, val) VALUES ('a', 1), ('b', 2), ('c', 3), ('d', 4);

statement ok
SELECT fabricator_exec('sqldb',
  'IF OBJECT_ID(''dbo.s3_iddml'') IS NOT NULL DROP EXTERNAL TABLE dbo.s3_iddml');

statement ok
SELECT fabricator_exec('sqldb',
  'CREATE EXTERNAL TABLE dbo.s3_iddml (id BIGINT, name VARCHAR(20), val INT)
   WITH (LOCATION = ''/fabricator/polybase/iddml'', DATA_SOURCE = s3_ds, FILE_FORMAT = DeltaFileFormat)');

statement ok
SELECT fabricator_refresh_cache('sqldb');

# UPDATE through the ATTACHed SQL catalog — scanned via SQL Server, applied on the Delta side
statement ok
UPDATE sqldb.dbo.s3_iddml SET val = 99 WHERE name = 'b';

# DELETE through the catalog
statement ok
DELETE FROM sqldb.dbo.s3_iddml WHERE val = 3;

# SQL Server reads the post-DML state through the external table (CoW kept it protocol-1.0)
query ITI
SELECT id, name, val FROM fabricator_query('sqldb',
  'SELECT id, name, val FROM OPENROWSET(BULK ''/fabricator/polybase/iddml'', FORMAT = ''DELTA'',
     DATA_SOURCE = ''s3_ds'') AS r ORDER BY id')
ORDER BY id;
----
1	a	1
2	b	99
4	d	4

# our own delta view agrees; the engine-assigned ids are UNCHANGED by the UPDATE
query ITI
SELECT id, name, val FROM plake.main.iddml ORDER BY id;
----
1	a	1
2	b	99
4	d	4

# multi-row UPDATE with an expression (arithmetic over the scanned values)
statement ok
UPDATE sqldb.dbo.s3_iddml SET val = val + 10 WHERE val < 50;

query ITI
SELECT id, name, val FROM sqldb.dbo.s3_iddml ORDER BY id;
----
1	a	11
2	b	99
4	d	14

# guard: SET of the engine-assigned identity column is rejected
statement error
UPDATE sqldb.dbo.s3_iddml SET id = 100 WHERE name = 'a';
----
identity column

# guard: storage-side DML cannot join an explicit transaction
statement ok
BEGIN;

statement error
DELETE FROM sqldb.dbo.s3_iddml WHERE name = 'a';
----
cannot roll back with an explicit

statement ok
ROLLBACK;

# a DELETE whose ids match nothing (concurrently-deleted semantics) affects zero rows, no error
statement ok
DELETE FROM sqldb.dbo.s3_iddml WHERE val = 12345;

query I
SELECT count(*) FROM sqldb.dbo.s3_iddml;
----
3

statement ok
DROP TABLE sqldb.dbo.s3_iddml;

# ---- 6e. the CETAS-analog DDL (slice B): CREATE TABLE ... WITH (location=..., table_type='DELTA') ----
# One statement: the data is written CLIENT-SIDE as a protocol-1.0 Delta table on MinIO (something SQL
# Server could never write), then the EXTERNAL TABLE is provisioned over it — the whole §2-§4 manual flow
# as DDL. data_source names the pre-provisioned EXTERNAL DATA SOURCE (no secret material crosses).

# per-run cleanup: drop leftover external objects + the delta folders (the CREATE is create-or-error)
statement ok
SELECT fabricator_refresh_cache('plake');

statement ok
SELECT fabricator_exec('sqldb',
  'IF OBJECT_ID(''dbo.cetas_full'') IS NOT NULL DROP EXTERNAL TABLE dbo.cetas_full');

statement ok
SELECT fabricator_exec('sqldb',
  'IF OBJECT_ID(''dbo.cetas_id'') IS NOT NULL DROP EXTERNAL TABLE dbo.cetas_id');

statement ok
DROP TABLE IF EXISTS plake.main.cetas_full;

statement ok
DROP TABLE IF EXISTS plake.main.cetas_id;

# THE DDL: client-side Delta write + auto-provisioned file format + external table, one statement
statement ok
CREATE TABLE sqldb.dbo.cetas_full
  WITH (location='s3://${FABRICATOR_S3_SQL_ENDPOINT}/fabricator/polybase/cetas_full',
        table_type='DELTA', data_source='s3_ds')
AS SELECT CAST(i AS BIGINT) AS id, 'c' || i AS name FROM range(1, 4) r(i);

statement ok
SELECT fabricator_refresh_cache('sqldb');

# SQL Server serves the reads (catalog scan + OPENROWSET)
query IT
SELECT id, name FROM sqldb.dbo.cetas_full ORDER BY id;
----
1	c1
2	c2
3	c3

query IT
SELECT id, name FROM fabricator_query('sqldb',
  'SELECT id, name FROM OPENROWSET(BULK ''/fabricator/polybase/cetas_full'', FORMAT = ''DELTA'',
     DATA_SOURCE = ''s3_ds'') AS r ORDER BY id')
ORDER BY id;
----
1	c1
2	c2
3	c3

# slice C composes: INSERT through the catalog appends on storage
statement ok
INSERT INTO sqldb.dbo.cetas_full VALUES (100, 'ins');

query I
SELECT count(*) FROM sqldb.dbo.cetas_full;
----
4

# guard: the client-side write is create-or-ERROR — a second table over the SAME (existing) location fails
statement error
CREATE TABLE sqldb.dbo.cetas_dup
  WITH (location='s3://${FABRICATOR_S3_SQL_ENDPOINT}/fabricator/polybase/cetas_full',
        table_type='DELTA', data_source='s3_ds')
AS SELECT 1 AS id;
----
already exists

# guard: no explicit transaction around a storage-writing CREATE
statement ok
BEGIN;

statement error
CREATE TABLE sqldb.dbo.cetas_txn
  WITH (location='s3://${FABRICATOR_S3_SQL_ENDPOINT}/fabricator/polybase/cetas_txn',
        table_type='DELTA', data_source='s3_ds')
AS SELECT 1 AS id;
----
cannot roll back with an explicit

statement ok
ROLLBACK;

# ---- 6f. the FULL CIRCLE: empty CREATE + IDENTITY marker -> INSERT (C) -> UPDATE/DELETE (D) ----
# The identity marker (`id BIGINT AS (0)`) rides into the Delta create (engine-assigned ids; the external
# declaration is plain BIGINT), so the table is DML-capable from birth — created, written, updated and
# deleted entirely through the SQL catalog, with every byte on MinIO and SQL Server serving the reads.

statement ok
CREATE TABLE sqldb.dbo.cetas_id (id BIGINT AS (0), name VARCHAR)
  WITH (location='s3://${FABRICATOR_S3_SQL_ENDPOINT}/fabricator/polybase/cetas_id',
        table_type='DELTA', data_source='s3_ds');

statement ok
SELECT fabricator_refresh_cache('sqldb');

statement ok
INSERT INTO sqldb.dbo.cetas_id (name) VALUES ('a'), ('b'), ('c');

query IT
SELECT id, name FROM sqldb.dbo.cetas_id ORDER BY id;
----
1	a
2	b
3	c

statement ok
UPDATE sqldb.dbo.cetas_id SET name = 'bee' WHERE id = 2;

statement ok
DELETE FROM sqldb.dbo.cetas_id WHERE name = 'c';

query IT
SELECT id, name FROM fabricator_query('sqldb',
  'SELECT id, name FROM OPENROWSET(BULK ''/fabricator/polybase/cetas_id'', FORMAT = ''DELTA'',
     DATA_SOURCE = ''s3_ds'') AS r ORDER BY id')
ORDER BY id;
----
1	a
2	bee

statement ok
DROP TABLE sqldb.dbo.cetas_full;

statement ok
DROP TABLE sqldb.dbo.cetas_id;

